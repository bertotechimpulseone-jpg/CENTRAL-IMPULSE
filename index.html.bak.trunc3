  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  const hoje = new Date().toISOString().split('T')[0];
  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:580px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:38px;height:38px;border-radius:9px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:18px">💬</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">Novo contato com cliente</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'relacModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px;display:flex;flex-direction:column;gap:12px">' +
        '<div><div class="info-label" style="margin-bottom:5px">Cliente *</div><select id="rlCliente" class="login-input" style="background:var(--surface-2)">' +
          '<option value="">— Selecione —</option>' +
          sortAlfa(clients, 'name').map(c => '<option value="' + c._dbId + '" ' + (presetCliId===c._dbId?'selected':'') + '>' + c.name + '</option>').join('') +
        '</select></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Tipo de contato *</div><div style="display:flex;gap:6px;flex-wrap:wrap">' +
          tipos.map((t,i) => '<label style="display:flex;align-items:center;gap:4px;padding:7px 11px;background:var(--surface-2);border-radius:7px;cursor:pointer;font-size:12px;border:1px solid var(--border)"><input type="radio" name="rlTipo" value="' + t.v + '" ' + (i===0?'checked':'') + ' /> ' + t.i + ' ' + t.l + '</label>').join('') +
        '</div></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Data do contato *</div><input id="rlData" class="login-input" type="date" value="' + hoje + '" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Responsável</div><input id="rlResp" class="login-input" value="' + (_currentProfile?.name||'') + '" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Resumo / Anotação *</div><textarea id="rlResumo" class="login-input" rows="3" placeholder="O que foi tratado, decisões, próximos passos..." style="background:var(--surface-2);resize:vertical;min-height:80px"></textarea></div>' +
        '<div style="display:grid;grid-template-columns:2fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Próxima ação</div><input id="rlProxAcao" class="login-input" placeholder="Ex: Enviar criativos" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Quando</div><input id="rlProxData" class="login-input" type="date" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Observações internas (não vai pro cliente)</div><textarea id="rlObs" class="login-input" rows="2" style="background:var(--surface-2);resize:vertical;min-height:50px"></textarea></div>' +
      '</div>' +
      '<div style="padding:16px 24px 22px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid var(--border)">' +
        '<button class="btn" onclick="document.getElementById(\'relacModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" onclick="salvarRelacionamento()">💾 Salvar contato</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function salvarRelacionamento(){
  const client_id = document.getElementById('rlCliente').value;
  if(!client_id){ toast('Selecione o cliente','info'); return; }
  const tipoEl = document.querySelector('input[name="rlTipo"]:checked');
  const tipo = tipoEl ? tipoEl.value : 'whatsapp';
  let data_contato = document.getElementById('rlData').value;
  if(!data_contato){
    // Forca data de hoje se input ficou vazio por algum motivo
    data_contato = new Date().toISOString().slice(0,10);
    console.warn('[salvarRelacionamento] rlData vazio, usando hoje:', data_contato);
  }
  const responsavel_nome = document.getElementById('rlResp').value.trim() || null;
  const resumo = document.getElementById('rlResumo').value.trim();
  if(!resumo){ toast('Escreva um resumo','info'); return; }
  const proxima_acao = document.getElementById('rlProxAcao').value.trim() || null;
  const proxima_data = document.getElementById('rlProxData').value || null;
  const observacoes_internas = document.getElementById('rlObs').value.trim() || null;

  const payload = {client_id, tipo, data_contato, responsavel_nome, resumo, proxima_acao, proxima_data, observacoes_internas};
  if(_currentProfile && _currentProfile.id) payload.profile_id = _currentProfile.id;

  if(_supa){
    const { data, error } = await _supa.from('client_relationships').insert(payload).select().single();
    if(error){ toast('Erro: '+error.message,'info'); return; }
    _relacionamentos.unshift(data);
  } else {
    _relacionamentos.unshift(Object.assign({}, payload, {id:'tmp-'+Date.now()}));
  }
  document.getElementById('relacModal').remove();
  toast('✓ Contato registrado','success');
  if(currentPage === 'relacionamento') renderRelacionamento(document.getElementById('content'));
}

async function excluirRelacionamento(id){
  if(!(await confirmDelete('registro'))) return;
  if(_supa) await _supa.from('client_relationships').delete().eq('id', id);
  _relacionamentos = _relacionamentos.filter(r => r.id !== id);
  toast('Registro excluído','success');
  if(currentPage === 'relacionamento') renderRelacionamento(document.getElementById('content'));
}

// ============ PAGAMENTOS ============
if(typeof _pagFiltroMes === 'undefined') var _pagFiltroMes = '';

// Cache de profiles que nao estao em team[] (cadastrados recentemente)
let _profilesExtras = {};

async function buscarProfileNoBanco(profileId){
  if(!profileId) return null;
  // Primeiro tenta no team
  const noTeam = (team||[]).find(tm => tm._dbId === profileId);
  if(noTeam) return noTeam;
  // Depois no cache
  if(_profilesExtras[profileId]) return _profilesExtras[profileId];
  // Senao busca no banco
  if(!_supa) return null;
  try {
    const r = await _supa.from('profiles').select('id, full_name, email, position, avatar_color, initials').eq('id', profileId).maybeSingle();
    if(r.data){
      const p = {
        _dbId: r.data.id,
        name: r.data.full_name || (r.data.email||'').split('@')[0] || '(sem nome)',
        email: r.data.email,
        role: r.data.position || '',
        color: r.data.avatar_color || '#888',
        init: r.data.initials || ((r.data.full_name||'?')[0]||'?').toUpperCase()
      };
      _profilesExtras[profileId] = p;
      return p;
    }
  } catch(e){ console.warn('[buscarProfileNoBanco]', e); }
  return null;
}

// Carrega TODOS os profiles que aparecem em pagamentos mas nao estao no team
async function carregarProfilesPagamentos(){
  if(!_supa) return;
  const idsUsados = new Set();
  (_colaboradorPagamentos||[]).forEach(p => { if(p.profile_id) idsUsados.add(p.profile_id); });
  const faltando = [...idsUsados].filter(id => !(team||[]).some(tm => tm._dbId === id) && !_profilesExtras[id]);
  if(faltando.length === 0) return;
  console.log('[carregarProfilesPagamentos] buscando', faltando.length, 'profiles extras');
  try {
    const r = await _supa.from('profiles').select('id, full_name, email, position, avatar_color, initials').in('id', faltando);
    if(r.data){
      r.data.forEach(p => {
        _profilesExtras[p.id] = {
          _dbId: p.id,
          name: p.full_name || (p.email||'').split('@')[0] || '(sem nome)',
          email: p.email,
          role: p.position || '',
          color: p.avatar_color || '#888',
          init: p.initials || ((p.full_name||'?')[0]||'?').toUpperCase()
        };
      });
      console.log('[carregarProfilesPagamentos] ✓ carregados:', r.data.length);
    }
  } catch(e){ console.warn('[carregarProfilesPagamentos]', e); }
}

// Helper unificado pra achar colab por _dbId (team + cache extras)
function getColabPorId(profileId){
  if(!profileId) return null;
  const noTeam = (team||[]).find(tm => tm._dbId === profileId);
  if(noTeam) return noTeam;
  return _profilesExtras[profileId] || null;
}






// === DESBLOQUEIO BASE DE CALCULO ===
async function precifDestrancarBase(){
  console.log('[precifDestrancarBase] tentando desbloquear...');
  if(typeof pedirSenhaRestrita !== 'function'){
    toast('Sistema de senha nao carregado','info');
    return;
  }
  const ok = await pedirSenhaRestrita('Pra ver e editar a base de cálculo DRE preciso da senha de administrador.');
  if(!ok){ toast('Cancelado','info'); return; }
  if(!window._desbloqueios) window._desbloqueios = {};
  window._desbloqueios.precifBase = true;
  toast('🔓 Base de cálculo desbloqueada','success');
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifDestrancarBase = precifDestrancarBase;

// === SISTEMA DE SENHA PRA ACOES RESTRITAS ===
const _SENHA_RESTRITA = 'abundancia';
// Cache de desbloqueio nesta sessao (nao precisa pedir senha de novo)
window._desbloqueios = window._desbloqueios || {};

function pedirSenhaRestrita(motivo){
  return new Promise((resolve) => {
    let modal = document.getElementById('senhaRestritaModal');
    if(modal) modal.remove();
    modal = document.createElement('div');
    modal.id = 'senhaRestritaModal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:18px';
    modal.onclick = (e) => { if(e.target===modal){ modal.remove(); resolve(false); } };
    modal.innerHTML =
      '<div style="background:var(--surface);border-radius:14px;max-width:420px;width:100%;padding:24px;box-shadow:0 24px 60px rgba(0,0,0,.5);border-top:4px solid var(--accent)">' +
        '<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">' +
          '<div style="width:44px;height:44px;border-radius:50%;background:rgba(99,102,241,.15);display:grid;place-items:center;font-size:22px">🔒</div>' +
          '<div><div style="font-size:16px;font-weight:700">Ação restrita</div></div>' +
        '</div>' +
        '<div style="font-size:13px;color:var(--text-2);margin-bottom:14px;line-height:1.55">' + (motivo || 'Digite a senha pra continuar.') + '</div>' +
        '<input type="password" id="srInput" placeholder="senha" autocomplete="off" style="background:var(--surface-2);border:2px solid var(--border);font-family:inherit;font-size:14px;padding:11px 14px;border-radius:9px;width:100%;outline:none" />' +
        '<div id="srErro" style="display:none;color:var(--danger);font-size:11.5px;margin-top:6px;font-weight:600">❌ Senha incorreta</div>' +
        '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">' +
          '<button class="btn" id="srCancel" type="button">Cancelar</button>' +
          '<button class="btn btn-primary" id="srOk" type="button">Desbloquear</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(modal);
    const inp = document.getElementById('srInput');
    const btnOk = document.getElementById('srOk');
    const btnCancel = document.getElementById('srCancel');
    const erro = document.getElementById('srErro');
    setTimeout(() => inp && inp.focus(), 50);
    const cancelar = () => { modal.remove(); resolve(false); };
    const tentar = () => {
      const val = (inp.value || '').trim().toLowerCase();
      if(val === _SENHA_RESTRITA){
        modal.remove();
        resolve(true);
      } else {
        if(erro) erro.style.display = 'block';
        inp.value = '';
        inp.focus();
      }
    };
    btnCancel.onclick = cancelar;
    btnOk.onclick = tentar;
    inp.addEventListener('keydown', (e) => {
      if(e.key === 'Enter'){ e.preventDefault(); tentar(); }
      if(e.key === 'Escape'){ cancelar(); }
    });
  });
}
window.pedirSenhaRestrita = pedirSenhaRestrita;
// === /SENHA ===

// ============ PRECIFICACAO ============
let _precifConfig = null;
let _precifProdutos = [];
// Estado em memoria pra montar orcamento dinamicamente
// _precifSel: { prodId: {faixa:'m'|'g'|'gg', desconto:0} }
let _precifSel = {};
// _precifCustom: lista de servicos custom adicionados pelo usuario
let _precifCustom = [];

async function loadPrecificacao(){
  if(!_supa) return;
  try {
    // Config (singleton)
    const cfg = await _supa.from('precificacao_config').select('*').limit(1).maybeSingle();
    if(cfg.error){
      if(cfg.error.code === '42P01'){ console.warn('[loadPrecificacao] tabela nao existe, rode SQL 51'); _precifConfig = null; _precifProdutos = []; return; }
      console.warn('[loadPrecificacao config]', cfg.error);
    }
    _precifConfig = cfg.data || null;
    // Produtos
    const prod = await _supa.from('precificacao_produtos').select('*').order('ordem',{ascending:true});
    if(!prod.error && prod.data) _precifProdutos = prod.data;
    console.log('[loadPrecificacao] config:', !!_precifConfig, 'produtos:', _precifProdutos.length);
  } catch(e){ console.warn('[loadPrecificacao]', e); }
}

// Arredonda valor pra preco comercial elegante
// < 100: multiplos de 10  |  100-499: termina em 9 (159, 209, 309)  |  500+: termina em 90
function _precifArredonda90(valor){
  if(!valor || valor < 1) return 0;
  if(valor < 100){
    return Math.max(10, Math.round(valor / 10) * 10);
  }
  if(valor < 500){
    // Termina em 9 — granular o suficiente pra diferenciar M, G, GG em valores baixos
    return Math.ceil(valor / 10) * 10 - 1;
  }
  return Math.ceil(valor / 100) * 100 - 10;
}
window._precifArredonda90 = _precifArredonda90;

function _precifFmt(v){
  if(v == null || isNaN(v)) return '—';
  return 'R$ ' + parseFloat(v).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
}

function renderPrecificacao(){
  try {
    if(!isAdmin()){
      return '<div class="card" style="text-align:center;padding:50px 20px"><div style="font-size:42px;margin-bottom:12px">🔒</div><div style="font-size:15px;font-weight:600">Acesso restrito à precificação</div><div class="text-sm text-mu" style="margin-top:6px">Apenas sócios e administradores autorizados.</div></div>';
    }
    if(!_precifConfig && !_precifProdutos.length){
      // Tabelas talvez nao existam ainda — banner
      setTimeout(() => loadPrecificacao().then(() => {
        if(_precifConfig || _precifProdutos.length){
          if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
        }
      }), 100);
      return '<div class="card" style="border-left:4px solid #f59e0b;background:rgba(245,158,11,.08);padding:18px"><div style="font-weight:700;color:#92400e;margin-bottom:8px">⚠ Tabelas de precificação não criadas</div>' +
        '<div class="text-sm">Rode o SQL <code style="background:var(--surface-2);padding:2px 6px;border-radius:4px">sql/51-precificacao.sql</code> no Supabase pra criar as tabelas com os 16 produtos padrão. Depois recarregue (Ctrl+Shift+R).</div></div>';
    }

    const cfg = _precifConfig || {pessoas_custo:25000, custo_fixo_variavel:8000, clientes:20, horas_trabalhadas:364, margem_m:70, margem_g:100, margem_gg:200, margem_negociacao:10};
    const total = (parseFloat(cfg.pessoas_custo)||0) + (parseFloat(cfg.custo_fixo_variavel)||0);
    const valorHora = cfg.horas_trabalhadas > 0 ? (total / cfg.horas_trabalhadas) : 0;

    let html = '<div class="page-head" style="border-top:none;padding-top:8px">' +
      '<div><div class="page-title" style="font-size:17px">💲 Precificação · Base DRE</div><div class="page-sub">Cálculo automático com edição manual quando precisar</div></div>' +
      '<div style="display:flex;gap:8px"><button class="btn" onclick="precifAddProduto()">+ Produto</button></div></div>';

    // === PARAMETROS GERAIS — escondido por padrao (cadeado) ===
    const baseDestrancada = !!window._desbloqueios.precifBase;
    if(baseDestrancada){
      html += '<div class="card" style="margin-bottom:16px;background:linear-gradient(135deg, rgba(99,102,241,.04), rgba(139,92,246,.04))">' +
        '<div class="card-header"><div class="card-title">⚙️ Base de cálculo</div>' +
          '<div style="display:flex;gap:8px;align-items:center"><span class="text-xs text-3">Mude qualquer campo · salva automaticamente</span>' +
          '<button class="btn btn-sm" onclick="window._desbloqueios.precifBase=false;renderComercial(document.getElementById(\'content\'))" title="Travar de novo" style="font-size:11px">🔒</button></div>' +
        '</div>' +
        '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px">' +
          _precifCard('Pessoas custo', cfg.pessoas_custo, 'pessoas_custo', true, '#6366f1') +
          _precifCard('Custo fixo + variável', cfg.custo_fixo_variavel, 'custo_fixo_variavel', true, '#8b5cf6') +
          _precifCard('Total mensal', total, null, false, '#0ea5e9') +
          _precifCard('Clientes ativos', cfg.clientes, 'clientes', false, '#22c55e', true) +
          _precifCard('Horas trabalhadas / mês', cfg.horas_trabalhadas, 'horas_trabalhadas', false, '#f59e0b', true) +
          _precifCardDestaque('Valor hora Impulse', valorHora, '#ef4444') +
        '</div></div>';
    } else {
      // Estado bloqueado: NAO mostra valor hora — admin precisa desbloquear
      html += '<div class="card" style="margin-bottom:16px;background:linear-gradient(135deg, rgba(99,102,241,.04), rgba(139,92,246,.04))">' +
        '<div style="display:flex;align-items:center;justify-content:space-between;padding:6px 4px">' +
          '<div style="display:flex;align-items:center;gap:12px"><div style="font-size:26px">🔒</div>' +
            '<div><div style="font-weight:700;font-size:14px">Base de cálculo bloqueada</div>' +
            '<div class="text-xs text-3">Custos, valor hora e parâmetros DRE — só admin</div></div></div>' +
          '<button class="btn btn-sm" id="btnDestrancarPrecif" type="button" onclick="precifDestrancarBase()" style="background:var(--accent);color:#fff;border:none;font-weight:600;padding:8px 14px">🔓 Desbloquear</button>' +
        '</div>' +
      '</div>';
    }

    // === TABELA DE PRODUTOS ===
    const margemM = parseFloat(cfg.margem_m) || 70;
    const margemG = parseFloat(cfg.margem_g) || 100;
    const margemGG = parseFloat(cfg.margem_gg) || 200;

    html += '<div class="card" style="margin-bottom:16px"><div class="card-header"><div class="card-title">📋 Selecione os produtos para o orçamento</div>' +
      '<span class="text-xs text-3">✓ Marque, escolha faixa e desconto · valores recalculam automaticamente</span></div>' +
      '<div style="overflow-x:auto"><table style="width:100%;font-size:12px;min-width:1000px;border-collapse:collapse">' +
        '<thead><tr style="background:var(--surface-2)">' +
          '<th style="text-align:center;padding:8px 6px;border-bottom:1px solid var(--border);width:32px"></th>' +
          '<th style="text-align:left;padding:8px 6px;border-bottom:1px solid var(--border);font-weight:600">Produto</th>' +
          (baseDestrancada ? '<th style="text-align:right;padding:8px 6px;border-bottom:1px solid var(--border);font-weight:600">Horas</th>' : '') +
          '<th style="text-align:center;padding:8px 6px;border-bottom:1px solid var(--border);background:rgba(34,197,94,.08);font-weight:700;color:#16a34a">M (' + margemM + '%)</th>' +
          '<th style="text-align:center;padding:8px 6px;border-bottom:1px solid var(--border);background:rgba(99,102,241,.08);font-weight:700;color:#4f46e5">G (' + margemG + '%)</th>' +
          '<th style="text-align:center;padding:8px 6px;border-bottom:1px solid var(--border);background:rgba(239,68,68,.08);font-weight:700;color:#dc2626">GG (' + margemGG + '%)</th>' +
          '<th style="text-align:center;padding:8px 6px;border-bottom:1px solid var(--border);font-weight:600;width:90px">Faixa</th>' +
          '<th style="text-align:right;padding:8px 6px;border-bottom:1px solid var(--border);font-weight:700;width:120px">Preço escolhido</th>' +
          '<th style="padding:8px 6px;border-bottom:1px solid var(--border);width:36px"></th>' +
        '</tr></thead><tbody>';

    _precifProdutos.filter(p => p.ativo !== false).forEach(p => {
      const horas = parseFloat(p.horas_estimadas) || 0;
      const custo = horas * valorHora;
      const sugestaoM = _precifArredonda90(custo * (1 + margemM/100));
      const sugestaoG = _precifArredonda90(custo * (1 + margemG/100));
      const sugestaoGG = _precifArredonda90(custo * (1 + margemGG/100));
      const precoM = p.preco_m_override != null ? p.preco_m_override : sugestaoM;
      const precoG = p.preco_g_override != null ? p.preco_g_override : sugestaoG;
      const precoGG = p.preco_gg_override != null ? p.preco_gg_override : sugestaoGG;

      const sel = _precifSel[p.id];
      const isSel = !!sel;
      const faixa = sel ? sel.faixa : 'g';
      const precoBase = faixa === 'm' ? precoM : (faixa === 'gg' ? precoGG : precoG);
      const rowBg = isSel ? 'background:rgba(34,197,94,.04)' : '';

      html += '<tr style="border-bottom:1px solid var(--border);' + rowBg + '">' +
        '<td style="padding:6px;text-align:center"><input type="checkbox" ' + (isSel?'checked':'') + ' onchange="precifToggleSelecao(\'' + p.id + '\',this.checked)" style="cursor:pointer;width:16px;height:16px" /></td>' +
        '<td style="padding:6px"><div style="display:flex;align-items:center;gap:6px"><input value="' + escapeHtml(p.produto||'') + '" onblur="precifSalvaCampo(\'' + p.id + '\',\'produto\',this.value)" style="background:transparent;border:none;flex:1;font-size:12px;font-weight:600;color:var(--text);outline:none;padding:4px" /><button onclick="precifEditarDescricao(\'' + p.id + '\')" title="' + (p.descricao ? 'Editar descrição (já cadastrada)' : 'Adicionar descrição do serviço') + '" style="background:' + (p.descricao ? 'rgba(34,197,94,.15)' : 'transparent') + ';border:1px solid ' + (p.descricao ? 'var(--success)' : 'var(--border)') + ';border-radius:5px;cursor:pointer;font-size:12px;padding:3px 6px;color:' + (p.descricao ? 'var(--success)' : 'var(--text-3)') + ';flex-shrink:0;white-space:nowrap" type="button">' + (p.descricao ? '📝 ✓' : '📝') + '</button></div><div class="text-xs text-3" style="margin-top:1px">' + escapeHtml(p.categoria||'—') + '</div></td>' +
        (baseDestrancada ? '<td style="padding:6px;text-align:right"><input type="number" step="0.5" value="' + horas + '" onblur="precifSalvaCampo(\'' + p.id + '\',\'horas_estimadas\',this.value)" style="background:transparent;border:none;width:55px;text-align:right;font-size:12px;color:var(--text);outline:none;padding:4px" /></td>' : '') +
        '<td style="padding:6px;text-align:center;background:rgba(34,197,94,.04);font-weight:700;color:#16a34a">' + _precifFmt(precoM) + '</td>' +
        '<td style="padding:6px;text-align:center;background:rgba(99,102,241,.04);font-weight:700;color:#4f46e5">' + _precifFmt(precoG) + '</td>' +
        '<td style="padding:6px;text-align:center;background:rgba(239,68,68,.04);font-weight:700;color:#dc2626">' + _precifFmt(precoGG) + '</td>' +
        '<td style="padding:6px;text-align:center">' +
          (isSel ? '<select onchange="precifSetFaixa(\'' + p.id + '\',this.value)" style="background:var(--surface);border:1px solid var(--border);padding:4px 6px;border-radius:5px;font-size:11.5px;width:78px;font-weight:600">' +
            '<option value="m"' + (faixa==='m'?' selected':'') + '>M</option>' +
            '<option value="g"' + (faixa==='g'?' selected':'') + '>G</option>' +
            '<option value="gg"' + (faixa==='gg'?' selected':'') + '>GG</option>' +
            '</select>' : '<span class="text-xs text-3">—</span>') +
        '</td>' +
        '<td style="padding:6px;text-align:right;font-weight:700;font-size:13px;color:' + (isSel?'var(--success)':'var(--text-3)') + '">' +
          (isSel ? _precifFmt(precoBase) : '—') +
        '</td>' +
        '<td style="padding:6px;text-align:right"><button class="icon-btn" onclick="precifRemoverProduto(\'' + p.id + '\')" style="color:var(--text-3);width:22px;height:22px;font-size:13px">×</button></td>' +
      '</tr>';
    });

    html += '</tbody></table></div></div>';

    // === CALCULADORA: SERVICO CUSTOM (nao esta na tabela) ===
    html += '<div class="card" style="margin-bottom:16px;background:linear-gradient(135deg, rgba(245,158,11,.04), rgba(239,68,68,.04))">' +
      '<div class="card-header"><div class="card-title">➕ Adicionar serviço não listado</div>' +
      '<span class="text-xs text-3">Pra serviços que não estão na tabela acima</span></div>' +

      '<div style="display:grid;grid-template-columns:1fr;gap:10px">' +
        '<div><div class="info-label" style="margin-bottom:5px">📝 Descrição do serviço *</div>' +
          '<input type="text" id="precifCalcDesc" placeholder="Descreva o serviço..." style="width:100%;background:var(--surface);border:1px solid var(--border);padding:9px 12px;border-radius:8px;font-size:13px" /></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">⏱ Horas</div>' +
            '<input type="number" id="precifCalcHoras" value="1" step="0.5" oninput="precifAtualizaCalcCustom()" style="width:100%;background:var(--surface);border:1px solid var(--border);padding:9px 12px;border-radius:8px;font-size:14px;font-weight:700;text-align:center" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Faixa</div>' +
            '<select id="precifCalcFaixa" onchange="precifAtualizaCalcCustom()" style="width:100%;background:var(--surface);border:1px solid var(--border);padding:9px;border-radius:8px;font-size:13px;font-weight:600">' +
              '<option value="m">M (+' + margemM + '%)</option>' +
              '<option value="g" selected>G (+' + margemG + '%)</option>' +
              '<option value="gg">GG (+' + margemGG + '%)</option>' +
            '</select></div>' +
        '</div>' +
        '<div style="display:flex;justify-content:space-between;align-items:center;gap:14px;background:var(--surface-2);padding:14px;border-radius:9px">' +
          '<div><div class="text-xs text-3">Preço calculado</div>' +
            '<div id="precifCalcResult" style="font-size:22px;font-weight:800;color:var(--text);margin-top:2px">' + _precifFmt(_precifArredonda90(valorHora * (1+margemG/100))) + '</div></div>' +
          '<button class="btn btn-primary" onclick="precifAdicionarCustom()" style="font-size:13px;padding:11px 18px">+ Adicionar à lista</button>' +
        '</div>' +
      '</div>' +
    '</div>';

    // === LISTA DE ITENS SELECIONADOS + BOTAO GERAR ORCAMENTO ===
    const itensSelTabela = Object.keys(_precifSel).map(prodId => {
      const p = _precifProdutos.find(x => x.id === prodId);
      if(!p) return null;
      const horas = parseFloat(p.horas_estimadas) || 0;
      const custo = horas * valorHora;
      const sel = _precifSel[prodId];
      const preco = sel.faixa === 'm' ? _precifArredonda90(custo*(1+margemM/100)) : (sel.faixa === 'gg' ? _precifArredonda90(custo*(1+margemGG/100)) : _precifArredonda90(custo*(1+margemG/100)));
      const precoBase = p['preco_'+sel.faixa+'_override'] != null ? p['preco_'+sel.faixa+'_override'] : preco;
      const final = _precifArredonda90(precoBase * (1 - sel.desconto/100));
      return {tipo:'tabela', prodId, nome: p.produto, faixa: sel.faixa.toUpperCase(), base: precoBase, final: precoBase};
    }).filter(Boolean);

    const totalSel = itensSelTabela.reduce((s,i) => s+i.final, 0) + _precifCustom.reduce((s,i) => s+(i.final||0), 0);
    const totalItens = itensSelTabela.length + _precifCustom.length;

    html += '<div class="card" style="margin-bottom:16px;border:2px solid ' + (totalItens>0?'var(--success)':'var(--border)') + '">' +
      '<div class="card-header"><div class="card-title">🛒 Itens selecionados (' + totalItens + ')</div>' +
      (totalItens>0 ? '<span class="badge b-success">Total: ' + _precifFmt(totalSel) + '</span>' : '<span class="text-xs text-3">Selecione produtos acima ou adicione serviços</span>') +
      '</div>' +
      (totalItens === 0
        ? '<div class="empty-state" style="padding:24px"><div class="ttl" style="font-size:13px">Nada selecionado</div><div class="desc">Marque produtos na tabela acima ou use a calculadora pra adicionar serviços não listados.</div></div>'
        : '<div style="display:flex;flex-direction:column;gap:6px">' +
          itensSelTabela.map(i => '<div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--surface-2);border-radius:7px">' +
            '<span style="font-size:14px">📦</span>' +
            '<div style="flex:1"><div style="font-weight:600;font-size:13px">' + escapeHtml(i.nome) + '</div>' +
              '<div class="text-xs text-3">Faixa ' + i.faixa + '</div></div>' +
            '<div style="font-weight:700;color:var(--success);font-size:14px">' + _precifFmt(i.final) + '</div>' +
            '<button class="icon-btn" onclick="precifToggleSelecao(\'' + i.prodId + '\',false)" title="Remover" style="color:var(--danger);width:24px;height:24px">×</button>' +
          '</div>').join('') +
          _precifCustom.map((i, idx) => '<div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:rgba(245,158,11,.06);border-radius:7px;border-left:3px solid #f59e0b">' +
            '<span style="font-size:14px">✏️</span>' +
            '<div style="flex:1"><div style="font-weight:600;font-size:13px">' + escapeHtml(i.descricao) + '</div>' +
              '<div class="text-xs text-3">' + i.horas + 'h · ' + i.faixa.toUpperCase() + '</div></div>' +
            '<div style="font-weight:700;color:var(--success);font-size:14px">' + _precifFmt(i.final) + '</div>' +
            '<button class="icon-btn" onclick="precifRemoverCustom(' + idx + ')" title="Remover" style="color:var(--danger);width:24px;height:24px">×</button>' +
          '</div>').join('') +
        '</div>' +
        '<div style="margin-top:14px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid var(--border);padding-top:14px">' +
          '<button class="btn" onclick="precifLimparSelecao()">Limpar tudo</button>' +
          '<button class="btn btn-primary" onclick="precifGerarOrcamento()" style="font-size:13.5px;padding:11px 22px">💼 Criar orçamento com estes itens →</button>' +
        '</div>'
      ) +
    '</div>';

    return html;
  } catch(e){
    console.error('[renderPrecificacao]', e);
    return '<div class="card" style="border-left:3px solid var(--danger);padding:18px"><div style="color:var(--danger);font-weight:600">Erro ao renderizar precificação</div><div class="text-xs text-3 mt-2">' + (e.message||e) + '</div></div>';
  }
}
window.renderPrecificacao = renderPrecificacao;

function _precifCard(label, valor, campo, isMoney, cor, isInt){
  const inputHtml = campo
    ? '<input type="number" step="' + (isInt?'1':'0.01') + '" value="' + (parseFloat(valor)||0) + '" onblur="precifSalvaConfig(\'' + campo + '\',this.value)" style="background:transparent;border:none;font-size:18px;font-weight:700;color:var(--text);outline:none;width:100%;text-align:center;border-bottom:2px dashed ' + cor + '" />'
    : '<div style="font-size:18px;font-weight:700;color:var(--text);text-align:center">' + (isMoney ? _precifFmt(valor) : valor) + '</div>';
  return '<div style="background:var(--surface);padding:12px;border-radius:10px;border:1px solid var(--border);border-top:3px solid ' + cor + '">' +
    '<div style="font-size:10.5px;color:var(--text-3);text-transform:uppercase;letter-spacing:.04em;font-weight:600;margin-bottom:6px;text-align:center">' + label + '</div>' +
    inputHtml +
    (isMoney && campo ? '<div class="text-xs text-3" style="text-align:center;margin-top:2px">R$/mês</div>' : '') +
  '</div>';
}

function _precifCardDestaque(label, valor, cor){
  return '<div style="background:linear-gradient(135deg,' + cor + '15,' + cor + '08);padding:12px;border-radius:10px;border:2px solid ' + cor + '">' +
    '<div style="font-size:10.5px;color:' + cor + ';text-transform:uppercase;letter-spacing:.04em;font-weight:700;margin-bottom:4px;text-align:center">' + label + '</div>' +
    '<div style="font-size:22px;font-weight:800;color:' + cor + ';text-align:center">' + _precifFmt(valor) + '</div>' +
    '<div class="text-xs" style="text-align:center;color:' + cor + ';opacity:.7;margin-top:2px">por hora</div>' +
  '</div>';
}

async function precifSalvaConfig(campo, valor){
  if(!_supa || !_precifConfig){ toast('Config nao carregada','info'); return; }
  if(!isAdmin()){ toast('Apenas admins','info'); return; }
  const val = parseFloat(valor) || 0;
  _precifConfig[campo] = val;
  const { error } = await _supa.from('precificacao_config').update({[campo]: val}).eq('id', _precifConfig.id);
  if(error){ toast('Erro: '+error.message,'info'); return; }
  toast('✓ Salvo','success');
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifSalvaConfig = precifSalvaConfig;

async function precifSalvaCampo(prodId, campo, valor){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  if(!isAdmin()){ toast('Apenas admins','info'); return; }
  const p = _precifProdutos.find(x => x.id === prodId);
  if(!p) return;
  let val = valor;
  if(campo === 'horas_estimadas') val = parseFloat(valor) || 0;
  p[campo] = val;
  const { error } = await _supa.from('precificacao_produtos').update({[campo]: val}).eq('id', prodId);
  if(error){ toast('Erro: '+error.message,'info'); return; }
  if(campo === 'horas_estimadas' && currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifSalvaCampo = precifSalvaCampo;

async function precifSalvaPreco(prodId, campo, valor, sugestao){
  if(!_supa) return;
  if(!isAdmin()){ toast('Apenas admins','info'); return; }
  const val = parseFloat(valor) || 0;
  // Se igual a sugestao, salva como null (auto)
  const finalVal = (Math.abs(val - sugestao) < 0.5) ? null : val;
  const p = _precifProdutos.find(x => x.id === prodId);
  if(p) p[campo] = finalVal;
  const { error } = await _supa.from('precificacao_produtos').update({[campo]: finalVal}).eq('id', prodId);
  if(error){ toast('Erro: '+error.message,'info'); return; }
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifSalvaPreco = precifSalvaPreco;

async function precifAddProduto(){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  if(!isAdmin()){ toast('Apenas admins','info'); return; }
  const ordem = (_precifProdutos.length || 0) + 1;
  const { data, error } = await _supa.from('precificacao_produtos').insert({produto:'Novo produto', categoria:'', horas_estimadas:1, ordem}).select().single();
  if(error){ toast('Erro: '+error.message,'info'); return; }
  _precifProdutos.push(data);
  toast('✓ Produto adicionado','success');
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifAddProduto = precifAddProduto;

async function precifRemoverProduto(prodId){
  if(!_supa) return;
  if(!isAdmin()){ toast('Apenas admins','info'); return; }
  const p = _precifProdutos.find(x => x.id === prodId);
  const nome = p ? p.produto : 'produto';
  if(!(await confirmDelete('produto: ' + nome))) return;
  const { error } = await _supa.from('precificacao_produtos').delete().eq('id', prodId);
  if(error){ toast('Erro: '+error.message,'info'); return; }
  _precifProdutos = _precifProdutos.filter(p => p.id !== prodId);
  toast('Produto removido','success');
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifRemoverProduto = precifRemoverProduto;

// Toggle selecao de produto da tabela
function precifToggleSelecao(prodId, selecionado){
  if(selecionado){
    if(!_precifSel[prodId]) _precifSel[prodId] = {faixa:'g', desconto:0};
  } else {
    delete _precifSel[prodId];
  }
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifToggleSelecao = precifToggleSelecao;

function precifSetFaixa(prodId, faixa){
  if(_precifSel[prodId]) _precifSel[prodId].faixa = faixa;
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifSetFaixa = precifSetFaixa;

async function precifSetDesconto(prodId, valor){
  if(!_precifSel[prodId]) return;
  const v = parseFloat(valor) || 0;
  if(v <= 10){
    _precifSel[prodId].desconto = v;
  } else {
    await precifValidaDesconto(prodId, valor, _precifSel[prodId].desconto);
  }
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifSetDesconto = precifSetDesconto;

// Atualiza preview do servico custom
function precifAtualizaCalcCustom(){
  if(!_precifConfig) return;
  const horas = parseFloat((document.getElementById('precifCalcHoras')||{}).value) || 0;
  const faixa = (document.getElementById('precifCalcFaixa')||{}).value || 'g';
  const total = (parseFloat(_precifConfig.pessoas_custo)||0) + (parseFloat(_precifConfig.custo_fixo_variavel)||0);
  const vh = _precifConfig.horas_trabalhadas > 0 ? (total / _precifConfig.horas_trabalhadas) : 0;
  const custo = horas * vh;
  const margem = faixa === 'm' ? (parseFloat(_precifConfig.margem_m)||70) : (faixa === 'gg' ? (parseFloat(_precifConfig.margem_gg)||200) : (parseFloat(_precifConfig.margem_g)||100));
  const base = _precifArredonda90(custo * (1 + margem/100));
  const out = document.getElementById('precifCalcResult');
  if(out) out.textContent = _precifFmt(base);
  window._precifCustomDraft = {horas, faixa, base, final: base};
}
window.precifAtualizaCalcCustom = precifAtualizaCalcCustom;

// Adiciona o servico custom a lista
function precifAdicionarCustom(){
  const desc = (document.getElementById('precifCalcDesc')||{}).value || '';
  if(!desc.trim()){ toast('Informe a descricao','info'); document.getElementById('precifCalcDesc')?.focus(); return; }
  const horas = parseFloat((document.getElementById('precifCalcHoras')||{}).value) || 0;
  if(horas <= 0){ toast('Informe as horas','info'); return; }
  precifAtualizaCalcCustom();
  const draft = window._precifCustomDraft || {};
  _precifCustom.push({
    descricao: desc.trim(),
    horas: horas,
    faixa: draft.faixa || 'g',
    base: draft.base || 0,
    final: draft.base || 0
  });
  toast('✓ Adicionado a lista','success');
  // Limpa form
  ['precifCalcDesc','precifCalcHoras'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.value = id === 'precifCalcHoras' ? '1' : '';
  });
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifAdicionarCustom = precifAdicionarCustom;

function precifRemoverCustom(idx){
  _precifCustom.splice(idx, 1);
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifRemoverCustom = precifRemoverCustom;

function precifLimparSelecao(){
  _precifSel = {};
  _precifCustom = [];
  toast('Selecao limpa','info');
  if(currentPage === 'comercial' && comTab === 'precificacao') renderComercial(document.getElementById('content'));
}
window.precifLimparSelecao = precifLimparSelecao;

// Gera orcamento a partir dos itens selecionados — abre aba Orcamento

// Modal pequeno pra editar descricao de um produto da precificacao
function precifEditarDescricao(prodId){
  if(!_precifProdutos) return;
  const p = _precifProdutos.find(x => x.id === prodId);
  if(!p){ toast('Produto nao encontrado','info'); return; }
  let modal = document.getElementById('precifDescModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'precifDescModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };
  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:520px;width:100%;padding:24px;max-height:90vh;overflow:auto">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">' +
        '<div><div style="font-size:16px;font-weight:700">📝 Descrição do serviço</div>' +
        '<div class="text-xs text-3" style="margin-top:3px">' + escapeHtml(p.produto || '') + '</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'precifDescModal\').remove()" style="font-size:20px">×</button>' +
      '</div>' +
      '<div class="info-label" style="margin-bottom:6px">Escopo, entregáveis, periodicidade, observações...</div>' +
      '<textarea id="precifDescTxt" rows="8" placeholder="Ex: 8 conteúdos mensais (4 posts + 4 stories) · 2 reuniões de alinhamento · Relatório mensal · Acompanhamento de tráfego..." style="width:100%;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:11px 13px;font-size:13px;font-family:inherit;resize:vertical;min-height:180px;color:var(--text)">' + (p.descricao || '') + '</textarea>' +
      '<div class="text-xs text-3" style="margin-top:8px">💡 Essa descrição aparece automaticamente no orçamento quando esse produto for selecionado.</div>' +
      '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">' +
        '<button class="btn" onclick="document.getElementById(\'precifDescModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" id="precifDescSave" onclick="precifSalvarDescricao(\'' + prodId + '\')">💾 Salvar</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
  setTimeout(() => { const t = document.getElementById('precifDescTxt'); if(t) t.focus(); }, 80);
}
window.precifEditarDescricao = precifEditarDescricao;

async function precifSalvarDescricao(prodId){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  const ta = document.getElementById('precifDescTxt');
  if(!ta) return;
  const desc = ta.value;
  const btn = document.getElementById('precifDescSave');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Salvando...'; }
  const { error } = await _supa.from('precificacao_produtos').update({descricao: desc}).eq('id', prodId);
  if(error){
    toast('Erro: ' + (error.message || error), 'info');
    if(String(error.message||'').includes('column') && String(error.message||'').includes('descricao')){
      toast('⚠ Rode o SQL 54-precificacao-descricao.sql', 'info');
    }
    if(btn){ btn.disabled = false; btn.textContent = '💾 Salvar'; }
    return;
  }
  const p = _precifProdutos.find(x => x.id === prodId);
  if(p) p.descricao = desc;
  toast('✓ Descrição salva','success');
  document.getElementById('precifDescModal').remove();
  // Re-renderiza pra atualizar o badge no botao
  if(typeof renderComercial === 'function' && currentPage === 'comercial' && comTab === 'precificacao'){
    renderComercial(document.getElementById('content'));
  }
}
window.precifSalvarDescricao = precifSalvarDescricao;

function precifGerarOrcamento(){
  if(typeof orcamento === 'undefined' || !orcamento){ toast('Orcamento nao inicializado','info'); return; }
  if(!_precifConfig){ toast('Config nao carregada','info'); return; }
  const cfg = _precifConfig;
  const totalCusto = (parseFloat(cfg.pessoas_custo)||0) + (parseFloat(cfg.custo_fixo_variavel)||0);
  const vh = cfg.horas_trabalhadas > 0 ? (totalCusto / cfg.horas_trabalhadas) : 0;
  const mM = parseFloat(cfg.margem_m)||70;
  const mG = parseFloat(cfg.margem_g)||100;
  const mGG = parseFloat(cfg.margem_gg)||200;

  const novos = [];
  // Produtos da tabela
  Object.keys(_precifSel).forEach(prodId => {
    const p = _precifProdutos.find(x => x.id === prodId);
    if(!p) return;
    const sel = _precifSel[prodId];
    const horas = parseFloat(p.horas_estimadas) || 0;
    const custo = horas * vh;
    let preco;
    if(sel.faixa === 'm') preco = p.preco_m_override != null ? p.preco_m_override : _precifArredonda90(custo*(1+mM/100));
    else if(sel.faixa === 'gg') preco = p.preco_gg_override != null ? p.preco_gg_override : _precifArredonda90(custo*(1+mGG/100));
    else preco = p.preco_g_override != null ? p.preco_g_override : _precifArredonda90(custo*(1+mG/100));
    novos.push({desc: p.produto, descricao: p.descricao || '', qtd: 1, valor: preco, custom: false});
  });
  // Servicos custom
  _precifCustom.forEach(c => {
    novos.push({desc: c.descricao, descricao: c.descricaoEscopo || '', qtd: 1, valor: c.final, custom: true});
  });

  if(novos.length === 0){ toast('Nada selecionado','info'); return; }

  // Substitui itens do orcamento atual
  orcamento.itens = novos;
  orcamento._fromPrecif = true;
  orcamento.desconto = 0;
  orcamento.descontoTipo = 'percentual';
  // Limpa selecao da precificacao pra proxima vez
  _precifSel = {};
  _precifCustom = [];
  // Vai pra aba Orcamento
  comTab = 'orcamento';
  toast('✓ Orçamento gerado com ' + novos.length + ' item(s). Adicione cliente, prazo e observações.', 'success');
  renderComercial(document.getElementById('content'));
}
window.precifGerarOrcamento = precifGerarOrcamento;
// ============ /PRECIFICACAO ============


// ============ CONTROLE DE ALMOÇO ============
let _almocos = [];
// Filtro de mes em formato YYYY-MM
let _almocoFiltroMes = '';

// Whitelist de quem tem acesso a aba Almoço (alem de admins)
function _almocoTemAcesso(){
  if(typeof isAdmin === 'function' && isAdmin()) return true;
  const meu = (typeof getMeuNome === 'function' ? getMeuNome() : '');
  if(!meu) return false;
  const primeiro = meu.trim().split(/\s+/)[0].toLowerCase();
  // Apelidos aceitos
  const grupos = [
    ['vini','vinicius','vinícius'],
    ['heidi','heidy','heydi','heydy'],
    ['haisa','haysa','haísa'],
    ['fran','francielle','francielli','franciele']
  ];
  return grupos.some(g => g.includes(primeiro));
}

async function loadAlmocos(){
  if(!_supa) return;
  try {
    const { data, error } = await _supa.from('controle_almoco').select('*').order('data', {ascending:false}).order('hora', {ascending:false});
    if(error){
      if(error.code === '42P01'){ console.warn('[loadAlmocos] tabela nao existe, rode SQL 52'); _almocos = []; return; }
      console.warn('[loadAlmocos]', error); return;
    }
    _almocos = data || [];
    console.log('[loadAlmocos]', _almocos.length, 'registros');
  } catch(e){ console.warn('[loadAlmocos]', e); }
}

function _almocoFmtData(d){
  if(!d) return '—';
  try {
    const parts = (d+'').slice(0,10).split('-');
    if(parts.length !== 3) return d;
    const dt = new Date(parseInt(parts[0]), parseInt(parts[1])-1, parseInt(parts[2]));
    const dias = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
    return parts[2]+'/'+parts[1]+'/'+parts[0]+' · '+dias[dt.getDay()];
  } catch(e){ return d; }
}

function _almocoFmtMes(m){
  if(!m || m.length < 7) return m || '';
  const [a,mm] = m.split('-');
  const nomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  return nomes[parseInt(mm)-1] + '/' + a;
}

function renderAlmoco(c){
  try {
    if(!_almocoTemAcesso()){
      c.innerHTML = '<div class="page-head"><div class="page-title">🍽 Almoço</div></div><div class="card" style="text-align:center;padding:50px 20px"><div style="font-size:42px;margin-bottom:12px">🔒</div><div style="font-size:15px;font-weight:600">Acesso restrito</div><div class="text-sm text-mu" style="margin-top:6px">Aba reservada para gestão de almoços corporativos.</div></div>';
      return;
    }

    if(!_almocoFiltroMes) _almocoFiltroMes = new Date().toISOString().slice(0,7);

    // Filtra por mes
    const filtrados = (_almocos||[]).filter(a => (a.data||'').slice(0,7) === _almocoFiltroMes);
    const internos = filtrados.filter(a => a.tipo === 'interno');
    const convidados = filtrados.filter(a => a.tipo === 'convidado');

    // Meses disponiveis no banco + mes atual
    const mesAtual = new Date().toISOString().slice(0,7);
    const mesesUnicos = Array.from(new Set([mesAtual, ..._almocos.map(a => (a.data||'').slice(0,7)).filter(Boolean)])).sort().reverse();

    // Stats
    const totalGeral = filtrados.length;
    const totalCusto = filtrados.reduce((s,a) => s + (parseFloat(a.custo)||0), 0);

    // Contagem por colab interno (so com profile_id ou nome conhecido)
    const porColab = {};
    internos.forEach(a => {
      const nome = a.nome || '—';
      porColab[nome] = (porColab[nome] || 0) + 1;
    });

    c.innerHTML =
      '<div class="page-head">' +
        '<div><div class="page-title">🍽 Controle de Almoço</div>' +
        '<div class="page-sub">' + totalGeral + ' almoço(s) em ' + _almocoFmtMes(_almocoFiltroMes) + '</div></div>' +
        '<div style="display:flex;gap:8px;flex-wrap:wrap">' +
          '<select onchange="window._almocoFiltroMes=this.value;renderAlmoco(document.getElementById(\'content\'))" class="login-input" style="background:var(--surface-2);width:auto">' +
            mesesUnicos.map(m => '<option value="' + m + '" ' + (_almocoFiltroMes===m?'selected':'') + '>' + _almocoFmtMes(m) + '</option>').join('') +
          '</select>' +
          '<button class="btn btn-primary" onclick="openAlmocoModal()">+ Registrar almoço</button>' +
        '</div>' +
      '</div>' +

      // === STATS ===
      '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-bottom:16px">' +
        '<div class="stat-card" style="border-left:3px solid #6366f1"><div class="stat-value">' + totalGeral + '</div><div class="stat-label">Total no mês</div></div>' +
        '<div class="stat-card" style="border-left:3px solid #22c55e"><div class="stat-value">' + internos.length + '</div><div class="stat-label">👥 Equipe interna</div></div>' +
        '<div class="stat-card" style="border-left:3px solid #f59e0b"><div class="stat-value">' + convidados.length + '</div><div class="stat-label">🤝 Convidados</div></div>' +
        (totalCusto > 0 ? '<div class="stat-card" style="border-left:3px solid #ef4444"><div class="stat-value">R$ ' + totalCusto.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</div><div class="stat-label">💰 Custo total</div></div>' : '') +
      '</div>' +

      // === RANKING POR COLAB (so se houver) ===
      (Object.keys(porColab).length > 0 ? '<div class="card" style="margin-bottom:16px"><div class="card-header"><div class="card-title">👥 Almoços por colaborador</div><span class="text-xs text-3">' + _almocoFmtMes(_almocoFiltroMes) + '</span></div>' +
        '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px">' +
          Object.entries(porColab).sort((a,b) => b[1] - a[1]).map(([nome, cnt]) =>
            '<div style="background:var(--surface-2);padding:11px 14px;border-radius:9px;text-align:center">' +
              '<div style="font-size:11px;color:var(--text-3);font-weight:600;text-transform:uppercase">' + escapeHtml(nome.split(' ')[0]) + '</div>' +
              '<div style="font-size:20px;font-weight:800;color:#6366f1;margin-top:3px">' + cnt + '</div>' +
            '</div>'
          ).join('') +
        '</div></div>' : '') +

      // === EQUIPE INTERNA ===
      '<div class="card" style="margin-bottom:16px;border-left:3px solid #22c55e">' +
        '<div class="card-header"><div class="card-title">👥 Equipe interna · ' + internos.length + '</div></div>' +
        (internos.length === 0
          ? '<div class="empty-state" style="padding:24px"><div class="ttl">Nenhum almoço registrado</div><div class="desc">Clique em "+ Registrar almoço" pra adicionar.</div></div>'
          : '<div style="overflow-x:auto"><table style="width:100%;font-size:12.5px;min-width:600px">' +
            '<thead><tr>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Data</th>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Hora</th>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Nome</th>' +
              '<th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">Custo</th>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Observações</th>' +
              '<th style="padding:8px;border-bottom:1px solid var(--border)"></th>' +
            '</tr></thead><tbody>' +
            internos.map(a => '<tr>' +
              '<td style="padding:8px;font-weight:600">' + _almocoFmtData(a.data) + '</td>' +
              '<td style="padding:8px">' + (a.hora || '—') + '</td>' +
              '<td style="padding:8px">👤 ' + escapeHtml(a.nome || '—') + '</td>' +
              '<td style="padding:8px;text-align:right">' + (a.custo ? 'R$ ' + parseFloat(a.custo).toFixed(2) : '—') + '</td>' +
              '<td style="padding:8px;font-size:11.5px;color:var(--text-2)">' + escapeHtml(a.observacoes || '') + '</td>' +
              '<td style="padding:8px;text-align:right;white-space:nowrap">' +
                '<button class="icon-btn" onclick="openAlmocoModal(\'' + a.id + '\')" title="Editar" style="width:26px;height:26px">✏️</button>' +
                '<button class="icon-btn" onclick="excluirAlmoco(\'' + a.id + '\')" title="Excluir" style="width:26px;height:26px;color:var(--danger)">×</button>' +
              '</td></tr>').join('') +
            '</tbody></table></div>') +
      '</div>' +

      // === OUTROS CONVIDADOS ===
      '<div class="card" style="border-left:3px solid #f59e0b">' +
        '<div class="card-header"><div class="card-title">🤝 Outros convidados · ' + convidados.length + '</div></div>' +
        (convidados.length === 0
          ? '<div class="empty-state" style="padding:24px"><div class="ttl">Nenhum convidado registrado</div><div class="desc">Use o botão acima e selecione tipo "Convidado".</div></div>'
          : '<div style="overflow-x:auto"><table style="width:100%;font-size:12.5px;min-width:600px">' +
            '<thead><tr>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Data</th>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Hora</th>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Nome</th>' +
              '<th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">Custo</th>' +
              '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Observações</th>' +
              '<th style="padding:8px;border-bottom:1px solid var(--border)"></th>' +
            '</tr></thead><tbody>' +
            convidados.map(a => '<tr>' +
              '<td style="padding:8px;font-weight:600">' + _almocoFmtData(a.data) + '</td>' +
              '<td style="padding:8px">' + (a.hora || '—') + '</td>' +
              '<td style="padding:8px">🤝 ' + escapeHtml(a.nome || '—') + '</td>' +
              '<td style="padding:8px;text-align:right">' + (a.custo ? 'R$ ' + parseFloat(a.custo).toFixed(2) : '—') + '</td>' +
              '<td style="padding:8px;font-size:11.5px;color:var(--text-2)">' + escapeHtml(a.observacoes || '') + '</td>' +
              '<td style="padding:8px;text-align:right;white-space:nowrap">' +
                '<button class="icon-btn" onclick="openAlmocoModal(\'' + a.id + '\')" title="Editar" style="width:26px;height:26px">✏️</button>' +
                '<button class="icon-btn" onclick="excluirAlmoco(\'' + a.id + '\')" title="Excluir" style="width:26px;height:26px;color:var(--danger)">×</button>' +
              '</td></tr>').join('') +
            '</tbody></table></div>') +
      '</div>';
  } catch(e){
    console.error('[renderAlmoco]', e);
    c.innerHTML = '<div class="card" style="border-left:3px solid var(--danger);padding:18px"><div style="color:var(--danger);font-weight:600">Erro ao renderizar Almoço</div><div class="text-xs text-3 mt-2">' + (e.message||e) + '</div></div>';
  }
}
window.renderAlmoco = renderAlmoco;

function openAlmocoModal(id){
  const a = id ? (_almocos||[]).find(x => x.id === id) : null;
  let modal = document.getElementById('almocoModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'almocoModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto';
  modal.onclick = (e) => { if(e.target===modal) modal.remove(); };

  // Lista de internos predefinidos
  const internosPadrao = ['Francielle', 'Haisa', 'Heidy', 'Vinicius'];
  const hoje = new Date().toISOString().slice(0,10);
  const tipoInit = a ? a.tipo : 'interno';

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:520px;width:100%;padding:24px;max-height:90vh;overflow:auto">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">' +
        '<div style="font-size:16px;font-weight:700">🍽 ' + (a?'Editar':'Registrar') + ' almoço</div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'almocoModal\').remove()" style="font-size:20px">×</button>' +
      '</div>' +
      '<input type="hidden" id="almId" value="' + (a?a.id:'') + '" />' +

      '<div class="info-label" style="margin-bottom:6px">Tipo</div>' +
      '<div style="display:flex;gap:8px;margin-bottom:14px">' +
        '<label style="flex:1;display:flex;align-items:center;gap:6px;padding:10px 12px;background:var(--surface-2);border-radius:8px;cursor:pointer;font-size:12.5px;font-weight:600"><input type="radio" name="almTipo" value="interno" ' + (tipoInit==='interno'?'checked':'') + ' onchange="almTrocaTipo(this.value)" /> 👥 Equipe interna</label>' +
        '<label style="flex:1;display:flex;align-items:center;gap:6px;padding:10px 12px;background:var(--surface-2);border-radius:8px;cursor:pointer;font-size:12.5px;font-weight:600"><input type="radio" name="almTipo" value="convidado" ' + (tipoInit==='convidado'?'checked':'') + ' onchange="almTrocaTipo(this.value)" /> 🤝 Outro convidado</label>' +
      '</div>' +

      '<div id="almPaneInterno" style="display:' + (tipoInit==='interno'?'block':'none') + ';margin-bottom:14px">' +
        '<div class="info-label" style="margin-bottom:5px">Colaborador</div>' +
        '<select id="almNomeInterno" class="login-input" style="background:var(--surface-2)">' +
          '<option value="">— Selecione —</option>' +
          internosPadrao.map(n => '<option value="' + n + '"' + (a && a.tipo==='interno' && a.nome===n ? ' selected' : '') + '>' + n + '</option>').join('') +
        '</select>' +
      '</div>' +

      '<div id="almPaneConvidado" style="display:' + (tipoInit==='convidado'?'block':'none') + ';margin-bottom:14px">' +
        '<div class="info-label" style="margin-bottom:5px">Nome do convidado</div>' +
        '<input type="text" id="almNomeConvidado" placeholder="Ex: João Silva (cliente Z)" value="' + (a && a.tipo==='convidado' ? escapeHtml(a.nome||'') : '') + '" class="login-input" style="background:var(--surface-2)" />' +
      '</div>' +

      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">' +
        '<div><div class="info-label" style="margin-bottom:5px">Data</div>' +
          '<input type="date" id="almData" value="' + (a?a.data:hoje) + '" class="login-input" style="background:var(--surface-2)" /></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Hora</div>' +
          '<input type="time" id="almHora" value="' + (a?a.hora||'':'12:00') + '" class="login-input" style="background:var(--surface-2)" /></div>' +
      '</div>' +

      '<div style="margin-bottom:14px"><div class="info-label" style="margin-bottom:5px">Custo (R$) — opcional</div>' +
        '<input type="number" id="almCusto" step="0.01" placeholder="0.00" value="' + (a&&a.custo?a.custo:'') + '" class="login-input" style="background:var(--surface-2)" /></div>' +

      '<div style="margin-bottom:18px"><div class="info-label" style="margin-bottom:5px">Observações</div>' +
        '<textarea id="almObs" rows="2" placeholder="Local, motivo, etc..." class="login-input" style="background:var(--surface-2);resize:vertical;font-family:inherit">' + (a?escapeHtml(a.observacoes||''):'') + '</textarea></div>' +

      '<div style="display:flex;gap:8px;justify-content:flex-end">' +
        '<button class="btn" onclick="document.getElementById(\'almocoModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" id="almSaveBtn" onclick="salvarAlmoco()">Salvar</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}
window.openAlmocoModal = openAlmocoModal;

function almTrocaTipo(t){
  document.getElementById('almPaneInterno').style.display = t==='interno' ? 'block' : 'none';
  document.getElementById('almPaneConvidado').style.display = t==='convidado' ? 'block' : 'none';
}
window.almTrocaTipo = almTrocaTipo;

async function salvarAlmoco(){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  if(!_almocoTemAcesso()){ toast('Sem permissão','info'); return; }
  const btn = document.getElementById('almSaveBtn');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Salvando...'; }
  try {
    const id = document.getElementById('almId').value || null;
    const tipoEl = document.querySelector('input[name="almTipo"]:checked');
    const tipo = tipoEl ? tipoEl.value : 'interno';
    let nome = '';
    if(tipo === 'interno') nome = (document.getElementById('almNomeInterno')||{}).value || '';
    else nome = (document.getElementById('almNomeConvidado')||{}).value || '';
    nome = nome.trim();
    if(!nome){ toast('Informe o nome','info'); if(btn){btn.disabled=false;btn.textContent='Salvar';} return; }
    const data = document.getElementById('almData').value;
    if(!data){ toast('Informe a data','info'); if(btn){btn.disabled=false;btn.textContent='Salvar';} return; }
    const hora = document.getElementById('almHora').value || null;
    const custoStr = document.getElementById('almCusto').value;
    const custo = custoStr ? (parseFloat(custoStr) || null) : null;
    const observacoes = document.getElementById('almObs').value;

    const payload = {tipo, nome, data, hora, custo, observacoes};

    if(id){
      const { error } = await _supa.from('controle_almoco').update(payload).eq('id', id);
      if(error) throw error;
    } else {
      const { error } = await _supa.from('controle_almoco').insert(payload);
      if(error) throw error;
    }
    toast('✓ Salvo','success');
    document.getElementById('almocoModal').remove();
    await loadAlmocos();
    if(currentPage === 'almoco') renderAlmoco(document.getElementById('content'));
  } catch(e){
    console.error('[salvarAlmoco]', e);
    const msg = e?.message || e;
    if(String(msg).includes('relation') && String(msg).includes('does not exist')){
      toast('⚠ Rode o SQL 52-controle-almoco.sql no Supabase', 'info');
    } else {
      toast('Erro: ' + msg, 'info');
    }
    if(btn){ btn.disabled = false; btn.textContent = 'Salvar'; }
  }
}
window.salvarAlmoco = salvarAlmoco;

async function excluirAlmoco(id){
  if(!_supa) return;
  if(!_almocoTemAcesso()){ toast('Sem permissão','info'); return; }
  const a = (_almocos||[]).find(x => x.id === id);
  const desc = a ? (a.nome + ' · ' + (a.data||'')) : 'este registro';
  if(!(await confirmDelete('almoço de ' + desc))) return;
  const { error } = await _supa.from('controle_almoco').delete().eq('id', id);
  if(error){ toast('Erro: ' + error.message, 'info'); return; }
  toast('Excluido','success');
  await loadAlmocos();
  if(currentPage === 'almoco') renderAlmoco(document.getElementById('content'));
}
window.excluirAlmoco = excluirAlmoco;
// ============ /ALMOÇO ============

// ============ I3 — COMBINADOS DOS SOCIOS ============
let _i3Reunioes = [];
let _i3Learning = [];

async function loadI3Reunioes(){
  if(!_supa){ _i3Reunioes = []; return []; }
  try {
    const { data, error } = await _supa.from('i3_reunioes').select('*').order('data_reuniao', {ascending: false});
    if(error){
      if(error.code === '42P01'){ console.warn('[loadI3Reunioes] tabela nao existe, rode SQL 50'); _i3Reunioes = []; return []; }
      console.warn('[loadI3Reunioes]', error); _i3Reunioes = []; return [];
    }
    _i3Reunioes = data || [];
    console.log('[loadI3Reunioes] ' + _i3Reunioes.length + ' reuniao(oes)');
    return _i3Reunioes;
  } catch(e){ console.error('[loadI3Reunioes]', e); _i3Reunioes = []; return []; }
}

async function loadI3Learning(){
  if(!_supa){ _i3Learning = []; return []; }
  try {
    const { data, error } = await _supa.from('i3_learning').select('*').order('data', {ascending: false});
    if(error){
      if(error.code === '42P01'){ console.warn('[loadI3Learning] tabela nao existe, rode SQL 50'); _i3Learning = []; return []; }
      console.warn('[loadI3Learning]', error); _i3Learning = []; return [];
    }
    _i3Learning = data || [];
    console.log('[loadI3Learning] ' + _i3Learning.length + ' learning(s)');
    return _i3Learning;
  } catch(e){ console.error('[loadI3Learning]', e); _i3Learning = []; return []; }
}

function _i3FmtMes(d){
  if(!d) return '—';
  try {
    const [a,m] = d.split('-');
    const nomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
    return nomes[parseInt(m)-1] + '/' + a;
  } catch(e){ return d; }
}

function _i3FmtData(d, comDiaSemana){
  if(!d) return '—';
  try {
    const [a,m,dia] = d.split('-');
    const formatado = dia + '/' + m + '/' + a;
    if(!comDiaSemana) return formatado;
    const dt = new Date(parseInt(a), parseInt(m)-1, parseInt(dia));
    const semanas = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
    return formatado + ' · ' + semanas[dt.getDay()];
  } catch(e){ return d; }
}

async function renderI3(c){
  try {
    if(!isGestor()){
      c.innerHTML = '<div class="page-head"><div class="page-title">I3</div></div><div class="card" style="text-align:center;padding:50px 20px"><div style="font-size:42px;margin-bottom:12px">🔒</div><div style="font-size:15px;font-weight:600">Acesso restrito</div><div class="text-sm text-mu" style="margin-top:6px">Essa área é só dos sócios.</div></div>';
      return;
    }
    // Recarrega ao entrar pra garantir dados fresh + detecta se tabelas existem
    let _i3TabelasFaltando = false;
    try {
      const probe = await _supa.from('i3_reunioes').select('id').limit(1);
      if(probe.error && (probe.error.code === '42P01' || probe.status === 404)){
        _i3TabelasFaltando = true;
      }
    } catch(e){ _i3TabelasFaltando = true; }

    await loadI3Reunioes();
    await loadI3Learning();

    const reunioes = _i3Reunioes || [];
    const learning = _i3Learning || [];

    const bannerSql = _i3TabelasFaltando
      ? '<div class="card" style="border-left:4px solid #f59e0b;background:rgba(245,158,11,.08);margin-bottom:14px;padding:14px 18px">' +
          '<div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">' +
            '<div style="font-size:22px">⚠️</div>' +
            '<div><div style="font-size:14px;font-weight:600;color:#92400e">Banco de dados precisa ser preparado</div>' +
            '<div class="text-xs text-3" style="margin-top:2px">As tabelas da aba I3 ainda não foram criadas no Supabase</div></div>' +
          '</div>' +
          '<div style="background:var(--surface-2);padding:10px 12px;border-radius:6px;font-size:12.5px;line-height:1.6">' +
            '<div style="font-weight:600;margin-bottom:6px">📋 Passos pra rodar:</div>' +
            '<div>1. Abra o <strong>Supabase → SQL Editor</strong></div>' +
            '<div>2. Cole o conteúdo do arquivo:</div>' +
            '<code style="display:block;background:var(--bg);padding:8px 10px;border-radius:4px;margin:6px 0;font-size:11.5px;word-break:break-all">C:\\Users\\conta\\OneDrive\\Área de Trabalho\\IMPULSE-ONE\\sql\\50-i3-socios.sql</code>' +
            '<div>3. Clique <strong>Run</strong> e recarregue essa página (Ctrl+Shift+R)</div>' +
          '</div>' +
        '</div>'
      : '';

    c.innerHTML = bannerSql +
      '<div class="page-head">' +
        '<div><div class="page-title">🏛 I3 — Combinados dos Sócios</div>' +
        '<div class="page-sub">Atas mensais · Impulse Learning semanal · RH · Pontos de atenção</div></div>' +
        '<div style="display:flex;gap:8px;flex-wrap:wrap">' +
          '<button class="btn" onclick="limparEventosOrfaosI3()" title="Remove eventos do calendario que ficaram orfaos (de atas/learnings ja excluidas)" style="font-size:11.5px">🧹 Limpar órfãos</button>' +
          '<button class="btn" onclick="openI3LearningModal()">+ Impulse Learning</button>' +
          '<button class="btn btn-primary" onclick="openI3ReuniaoModal()">+ Nova reunião mensal</button>' +
        '</div>' +
      '</div>' +

      // === IMPULSE LEARNING (proximas + recentes) ===
      '<div class="card" style="margin-bottom:18px;border-left:3px solid #6366f1">' +
        '<div class="card-header">' +
          '<div class="card-title">🎓 Impulse Learning · semanal</div>' +
          '<span class="badge b-info">' + learning.length + ' agendamento(s)</span>' +
        '</div>' +
        (learning.length === 0
          ? '<div class="empty-state" style="padding:24px"><div class="ttl">Nenhuma reunião agendada</div><div class="desc">Clique em "+ Impulse Learning" pra agendar a próxima — defina responsável, tema e data.</div></div>'
          : (() => {
              const hojeISO = new Date().toISOString().slice(0,10);
              // Separa futuras (>= hoje) e passadas (< hoje)
              const futuras = learning.filter(l => (l.data||'') >= hojeISO).sort((a,b) => (a.data||'').localeCompare(b.data||''));
              const passadas = learning.filter(l => (l.data||'') < hojeISO).sort((a,b) => (b.data||'').localeCompare(a.data||''));
              const ordenado = futuras.concat(passadas);
              const renderRow = (l) => {
                const ehPassada = (l.data||'') < hojeISO;
                const ehHoje = (l.data||'') === hojeISO;
                const bgRow = ehHoje ? 'background:rgba(99,102,241,.12);border-left:3px solid #6366f1' : (ehPassada ? 'opacity:.55' : 'background:rgba(99,102,241,.04)');
                const textColor = ehPassada ? 'color:var(--text-3)' : '';
                return '<tr style="' + bgRow + '">' +
                  '<td style="padding:8px;font-weight:' + (ehPassada?'400':'600') + ';' + textColor + '">' +
                    (ehHoje?'🔥 ':'') + _i3FmtData(l.data, true) +
                  '</td>' +
                  '<td style="padding:8px;' + textColor + '">' + escapeHtml(l.responsavel || '—') + '</td>' +
                  '<td style="padding:8px;' + textColor + '">' + escapeHtml(l.tema || '—') + '</td>' +
                  '<td style="padding:8px;color:var(--text-2);font-size:11.5px;' + textColor + '">' + escapeHtml(l.observacoes || '') + '</td>' +
                  '<td style="padding:8px;text-align:right;white-space:nowrap">' +
                    '<button class="icon-btn" onclick="openI3LearningModal(\'' + l.id + '\')" title="Editar" style="width:26px;height:26px">✏️</button>' +
                    '<button class="icon-btn" onclick="excluirI3Learning(\'' + l.id + '\')" title="Excluir" style="width:26px;height:26px;color:var(--danger)">×</button>' +
                  '</td>' +
                '</tr>';
              };
              let html = '<div style="overflow-x:auto"><table style="width:100%;font-size:12.5px;min-width:660px">' +
                '<thead><tr>' +
                  '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Data</th>' +
                  '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Responsável</th>' +
                  '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Tema</th>' +
                  '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Observações</th>' +
                  '<th style="padding:8px;border-bottom:1px solid var(--border)"></th>' +
                '</tr></thead><tbody>' +
                futuras.map(renderRow).join('');
              if(passadas.length > 0){
                html += '<tr><td colspan="5" style="padding:10px 8px 4px;font-size:10.5px;color:var(--text-3);text-transform:uppercase;letter-spacing:.05em;font-weight:600;border-top:1px dashed var(--border)">📦 Já realizadas (' + passadas.length + ')</td></tr>';
                html += passadas.map(renderRow).join('');
              }
              return html + '</tbody></table></div>';
            })()) +
      '</div>' +

      // === REUNIOES MENSAIS — ATAS ===
      '<div style="margin-bottom:8px;font-size:14px;font-weight:600;color:var(--text)">📋 Atas das reuniões mensais</div>' +
      (reunioes.length === 0
        ? '<div class="card empty-state" style="padding:36px"><div class="ico">📋</div><div class="ttl">Nenhuma reunião registrada ainda</div><div class="desc">Clique em "+ Nova reunião mensal" pra começar a primeira ata.</div></div>'
        : (() => {
            const hojeISO2 = new Date().toISOString().slice(0,10);
            // Ata "futura" = data_reuniao no futuro OU encontro_data no futuro
            const futurasR = reunioes.filter(r => (r.data_reuniao||'') >= hojeISO2 || (r.encontro_data||'') >= hojeISO2).sort((a,b) => (a.data_reuniao||'').localeCompare(b.data_reuniao||''));
            const passadasR = reunioes.filter(r => !((r.data_reuniao||'') >= hojeISO2 || (r.encontro_data||'') >= hojeISO2)).sort((a,b) => (b.data_reuniao||'').localeCompare(a.data_reuniao||''));
            const ordenadoR = futurasR.concat(passadasR);
            return ordenadoR.map(r => {
            const ehPassada = (r.data_reuniao||'') < hojeISO2 && (r.encontro_data||'') < hojeISO2;
            const tituloFinal = r.titulo || ('Reunião sócios — ' + _i3FmtData(r.data_reuniao, true));
            return '<div class="card" style="margin-bottom:14px' + (ehPassada?';opacity:.55':'') + '">' +
              '<div class="card-header" style="cursor:pointer" onclick="this.parentNode.querySelector(\'.i3-ata-body\').classList.toggle(\'hidden\')">' +
                '<div class="card-title">' + (ehPassada?'📦':'📅') + ' ' + escapeHtml(tituloFinal) + '</div>' +
                '<div style="display:flex;gap:8px;align-items:center">' +
                  '<span class="text-xs text-3">' + _i3FmtData(r.data_reuniao, true) + '</span>' +
                  '<button class="icon-btn" onclick="event.stopPropagation();openI3ReuniaoModal(\'' + r.id + '\')" title="Editar" style="width:26px;height:26px">✏️</button>' +
                  '<button class="icon-btn" onclick="event.stopPropagation();excluirI3Reuniao(\'' + r.id + '\')" title="Excluir" style="width:26px;height:26px;color:var(--danger)">×</button>' +
                '</div>' +
              '</div>' +
              '<div class="i3-ata-body">' +
                // Encontro presencial
                (r.encontro_data
                  ? '<div style="background:var(--surface-2);padding:12px 14px;border-radius:8px;margin-bottom:12px;border-left:3px solid #f59e0b">' +
                      '<div style="font-size:12px;font-weight:600;color:#f59e0b;margin-bottom:4px">📍 ENCONTRO PRESENCIAL DEFINIDO</div>' +
                      '<div style="font-size:14px;font-weight:600">' + _i3FmtData(r.encontro_data) + (r.encontro_local ? ' · ' + escapeHtml(r.encontro_local) : '') + '</div>' +
                      (r.encontro_evento_id ? '<div class="text-xs text-3" style="margin-top:4px">✓ Adicionado na agenda</div>' : '') +
                    '</div>'
                  : '') +
                // Secoes da ata em grid
                '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px">' +
                  _i3SecaoCard('👥 Observações RH', r.obs_rh, '#06b6d4') +
                  _i3SecaoCard('✅ Conclusões / Plano de ação', r.conclusoes, '#22c55e') +
                  _i3SecaoCard('⚠️ Pontos de atenção', r.pontos_atencao, '#ef4444') +
                  _i3SecaoCard('🔍 Pontos para analisar', r.pontos_analisar, '#a855f7') +
                '</div>' +
              '</div>' +
            '</div>';
          }).join('');
          })());
  } catch(e){
    console.error('[renderI3]', e);
    c.innerHTML = '<div class="card" style="border-left:3px solid var(--danger);padding:18px"><div style="color:var(--danger);font-weight:600">Erro ao renderizar I3</div><div class="text-xs text-3 mt-2">' + (e.message||e) + '</div></div>';
  }
}

function _i3SecaoCard(titulo, conteudo, cor){
  const tem = (conteudo||'').trim().length > 0;
  return '<div style="background:var(--surface-2);padding:11px 13px;border-radius:8px;border-left:3px solid ' + cor + '">' +
    '<div style="font-size:11.5px;font-weight:600;color:' + cor + ';margin-bottom:6px">' + titulo + '</div>' +
    '<div style="font-size:12.5px;color:var(--text);white-space:pre-wrap;line-height:1.5">' + (tem ? escapeHtml(conteudo) : '<span class="text-mu" style="font-style:italic">— vazio —</span>') + '</div>' +
  '</div>';
}

// === MODAL: Nova/Editar reuniao mensal ===
function openI3ReuniaoModal(reuniaoId){
  const r = reuniaoId ? (_i3Reunioes||[]).find(x => x.id === reuniaoId) : null;
  let modal = document.getElementById('i3RModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'i3RModal';
  modal.className = 'modal-bg open';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto';
  modal.onclick = (e) => { if(e.target === modal) modal.remove(); };
  const hoje = new Date().toISOString().slice(0,10);
  modal.innerHTML =
    '<div class="modal" style="max-width:760px;width:100%;background:var(--surface);border-radius:14px;padding:24px;max-height:90vh;overflow-y:auto">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">' +
        '<div style="font-size:17px;font-weight:600">📋 ' + (r ? 'Editar' : 'Nova') + ' reunião mensal</div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'i3RModal\').remove()" style="font-size:20px">×</button>' +
      '</div>' +

      '<input type="hidden" id="i3rId" value="' + (r?r.id:'') + '" />' +

      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">' +
        '<div><div class="info-label">Data da reunião</div><input type="date" id="i3rData" class="login-input" value="' + (r?r.data_reuniao:hoje) + '" style="background:var(--surface-2)" /></div>' +
        '<div><div class="info-label">Título (opcional)</div><input type="text" id="i3rTitulo" class="login-input" placeholder="ex: Reunião sócios Mai/2026" value="' + escapeHtml(r?.titulo||'') + '" style="background:var(--surface-2)" /></div>' +
      '</div>' +

      '<div style="background:var(--warning-soft);padding:12px 14px;border-radius:8px;margin-bottom:14px;border-left:3px solid #f59e0b">' +
        '<div style="font-size:12px;font-weight:600;color:#f59e0b;margin-bottom:8px">📍 ENCONTRO PRESENCIAL MENSAL</div>' +
        '<div class="text-xs text-3" style="margin-bottom:8px">Preencha pra agendar automaticamente no Calendário</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label">Data do encontro</div><input type="date" id="i3rEncData" class="login-input" value="' + (r?.encontro_data||'') + '" style="background:var(--surface)" /></div>' +
          '<div><div class="info-label">Local</div><input type="text" id="i3rEncLocal" class="login-input" placeholder="ex: Escritório / Café X" value="' + escapeHtml(r?.encontro_local||'') + '" style="background:var(--surface)" /></div>' +
        '</div>' +
      '</div>' +

      '<div style="margin-bottom:10px"><div class="info-label">👥 Observações de RH</div>' +
        '<textarea id="i3rRh" class="login-input" rows="3" placeholder="Movimentações de equipe, feedbacks, ajustes..." style="background:var(--surface-2);resize:vertical;font-family:inherit">' + escapeHtml(r?.obs_rh||'') + '</textarea></div>' +

      '<div style="margin-bottom:10px"><div class="info-label">✅ Conclusões / Plano de ação</div>' +
        '<textarea id="i3rConc" class="login-input" rows="3" placeholder="O que decidimos fazer, próximos passos..." style="background:var(--surface-2);resize:vertical;font-family:inherit">' + escapeHtml(r?.conclusoes||'') + '</textarea></div>' +

      '<div style="margin-bottom:10px"><div class="info-label">⚠️ Pontos de atenção</div>' +
        '<textarea id="i3rAten" class="login-input" rows="3" placeholder="Riscos, gargalos, coisas que merecem cuidado..." style="background:var(--surface-2);resize:vertical;font-family:inherit">' + escapeHtml(r?.pontos_atencao||'') + '</textarea></div>' +

      '<div style="margin-bottom:14px"><div class="info-label">🔍 Pontos para analisar</div>' +
        '<textarea id="i3rAna" class="login-input" rows="3" placeholder="Hipóteses pra investigar na próxima reunião..." style="background:var(--surface-2);resize:vertical;font-family:inherit">' + escapeHtml(r?.pontos_analisar||'') + '</textarea></div>' +

      '<div style="display:flex;gap:8px;justify-content:flex-end">' +
        '<button class="btn" onclick="document.getElementById(\'i3RModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" id="i3rSave" onclick="salvarI3Reuniao()">Salvar ata</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function salvarI3Reuniao(){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  const btn = document.getElementById('i3rSave');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Salvando...'; }
  try {
    const id = document.getElementById('i3rId').value || null;
    const data_reuniao = document.getElementById('i3rData').value;
    if(!data_reuniao){ toast('Informe a data','info'); if(btn){btn.disabled=false;btn.textContent='Salvar ata';} return; }
    const titulo = document.getElementById('i3rTitulo').value.trim();
    const encontro_data = document.getElementById('i3rEncData').value || null;
    const encontro_local = document.getElementById('i3rEncLocal').value.trim() || null;
    const obs_rh = document.getElementById('i3rRh').value;
    const conclusoes = document.getElementById('i3rConc').value;
    const pontos_atencao = document.getElementById('i3rAten').value;
    const pontos_analisar = document.getElementById('i3rAna').value;

    const payload = {
      data_reuniao, titulo: titulo || null, encontro_data, encontro_local,
      obs_rh, conclusoes, pontos_atencao, pontos_analisar
    };

    let reuniaoId = id;
    // Pega evento_id antigo SE estiver editando
    let eventoIdAnterior = null;
    if(id){
      const reuniaoAntiga = (_i3Reunioes||[]).find(r => r.id === id);
      eventoIdAnterior = reuniaoAntiga?.encontro_evento_id;
      const { error } = await _supa.from('i3_reunioes').update(payload).eq('id', id);
      if(error) throw error;
    } else {
      const { data, error } = await _supa.from('i3_reunioes').insert(payload).select().single();
      if(error) throw error;
      reuniaoId = data.id;
    }

    // SINCRONIZA evento: se removeu encontro_data, deleta evento antigo
    if(!encontro_data && eventoIdAnterior){
      try {
        await _supa.from('eventos_calendario').delete().eq('id', eventoIdAnterior);
        await _supa.from('i3_reunioes').update({encontro_evento_id: null}).eq('id', reuniaoId);
        console.log('[i3 sync] evento antigo removido (data tirada)');
      } catch(e){ console.warn('[i3 sync delete]', e); }
    }
    // Se tinha evento antigo, atualiza no lugar de criar novo
    if(encontro_data && reuniaoId && eventoIdAnterior){
      try {
        const updPayload = {
          titulo: 'Encontro Sócios I3' + (encontro_local ? ' · ' + encontro_local : ''),
          data_inicio: encontro_data,
          local: encontro_local || null,
          descricao: 'Encontro mensal dos sócios I3. Local: ' + (encontro_local || '—')
        };
        const { error: upErr } = await _supa.from('eventos_calendario').update(updPayload).eq('id', eventoIdAnterior);
        if(!upErr){
          toast('✓ Ata salva · agenda atualizada', 'success');
        } else {
          console.warn('[i3 sync update]', upErr);
          toast('✓ Ata salva (agenda nao atualizou)', 'info');
        }
      } catch(e){ console.warn('[i3 sync update]', e); }
    }
    // Cria evento na agenda se tem encontro_data e nao tinha antes
    else if(encontro_data && reuniaoId && !eventoIdAnterior){
      try {
        const evPayload = {
          titulo: 'Encontro Sócios I3' + (encontro_local ? ' · ' + encontro_local : ''),
          data_inicio: encontro_data,
          tipo: 'reuniao',
          cor: '#f59e0b',
          local: encontro_local || null,
          descricao: 'Encontro mensal dos sócios I3. Local: ' + (encontro_local || '—'),
          notificar: true
        };
        const { data: evData, error: evErr } = await _supa.from('eventos_calendario').insert(evPayload).select().single();
        if(!evErr && evData){
          await _supa.from('i3_reunioes').update({encontro_evento_id: evData.id}).eq('id', reuniaoId);
          toast('✓ Ata salva · encontro adicionado na agenda', 'success');
        } else {
          console.warn('[i3 evento]', evErr);
          toast('✓ Ata salva (agenda nao salvou: ' + (evErr?.message||'?') + ')', 'info');
        }
      } catch(e){ console.warn('[i3 evento agenda]', e); toast('✓ Ata salva (agenda falhou)','info'); }
    } else {
      toast('✓ Ata salva', 'success');
    }

    document.getElementById('i3RModal').remove();
    await loadI3Reunioes();
    if(typeof loadEventosCalendario === 'function') await loadEventosCalendario();
    renderI3(document.getElementById('content'));
  } catch(e){
    console.error('[salvarI3Reuniao]', e);
    const msg = e?.message || e;
    if(String(msg).includes('relation') && String(msg).includes('does not exist')){
      toast('⚠ Tabela i3_reunioes nao existe. Rode o SQL 50-i3-socios.sql no Supabase', 'info');
    } else if(e?.code === '42P01'){
      toast('⚠ Rode o SQL 50-i3-socios.sql no Supabase pra criar as tabelas', 'info');
    } else {
      toast('Erro ao salvar: ' + msg, 'info');
    }
    if(btn){ btn.disabled = false; btn.textContent = 'Salvar ata'; }
  }
}

async function excluirI3Reuniao(id){
  if(!(await confirmDelete('ata Não dá pra desfazer.'))) return;
  if(!_supa) return;
  // Antes de deletar, pega o evento_id pra remover da agenda tambem
  const reuniao = (_i3Reunioes||[]).find(r => r.id === id);
  const eventoId = reuniao?.encontro_evento_id;
  const { error } = await _supa.from('i3_reunioes').delete().eq('id', id);
  if(error){ toast('Erro: ' + error.message, 'info'); return; }
  // Sincroniza: remove evento da agenda se existia
  if(eventoId){
    try {
      const { error: evErr } = await _supa.from('eventos_calendario').delete().eq('id', eventoId);
      if(evErr) console.warn('[i3 sync agenda]', evErr);
    } catch(e){ console.warn('[i3 sync agenda]', e); }
  }
  toast('Ata excluida' + (eventoId ? ' · evento removido da agenda' : ''), 'success');
  await loadI3Reunioes();
  if(typeof loadEventosCalendario === 'function') await loadEventosCalendario();
  renderI3(document.getElementById('content'));
}

// === MODAL: Nova/Editar Impulse Learning ===
function openI3LearningModal(learningId){
  const l = learningId ? (_i3Learning||[]).find(x => x.id === learningId) : null;
  let modal = document.getElementById('i3LModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'i3LModal';
  modal.className = 'modal-bg open';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (e) => { if(e.target === modal) modal.remove(); };
  modal.innerHTML =
    '<div class="modal" style="max-width:520px;width:100%;background:var(--surface);border-radius:14px;padding:24px">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">' +
        '<div style="font-size:17px;font-weight:600">🎓 ' + (l?'Editar':'Nova') + ' reunião Impulse Learning</div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'i3LModal\').remove()" style="font-size:20px">×</button>' +
      '</div>' +
      '<input type="hidden" id="i3lId" value="' + (l?l.id:'') + '" />' +
      '<div style="margin-bottom:10px"><div class="info-label">Data</div>' +
        '<input type="date" id="i3lData" class="login-input" value="' + (l?.data||'') + '" style="background:var(--surface-2)" /></div>' +
      '<div style="margin-bottom:10px"><div class="info-label">Responsável pela reunião</div>' +
        '<input type="text" id="i3lResp" class="login-input" placeholder="Nome do responsavel" value="' + escapeHtml(l?.responsavel||'') + '" style="background:var(--surface-2)" /></div>' +
      '<div style="margin-bottom:10px"><div class="info-label">Tema</div>' +
        '<input type="text" id="i3lTema" class="login-input" placeholder="ex: Funis de venda" value="' + escapeHtml(l?.tema||'') + '" style="background:var(--surface-2)" /></div>' +
      '<div style="margin-bottom:14px"><div class="info-label">Observações (opcional)</div>' +
        '<textarea id="i3lObs" class="login-input" rows="3" placeholder="Notas, link de material..." style="background:var(--surface-2);resize:vertical;font-family:inherit">' + escapeHtml(l?.observacoes||'') + '</textarea></div>' +
      '<label style="display:flex;gap:6px;align-items:center;font-size:12.5px;margin-bottom:14px;cursor:pointer">' +
        '<input type="checkbox" id="i3lAgenda" ' + (l?.evento_calendario_id?'checked':'') + ' /> Adicionar no calendário' +
      '</label>' +
      '<div style="display:flex;gap:8px;justify-content:flex-end">' +
        '<button class="btn" onclick="document.getElementById(\'i3LModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" id="i3lSave" onclick="salvarI3Learning()">Salvar</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function salvarI3Learning(){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  const btn = document.getElementById('i3lSave');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Salvando...'; }
  try {
    const id = document.getElementById('i3lId').value || null;
    const data = document.getElementById('i3lData').value;
    if(!data){ toast('Informe a data','info'); if(btn){btn.disabled=false;btn.textContent='Salvar';} return; }
    const responsavel = document.getElementById('i3lResp').value.trim();
    const tema = document.getElementById('i3lTema').value.trim();
    const observacoes = document.getElementById('i3lObs').value;
    const querAgenda = document.getElementById('i3lAgenda').checked;

    const payload = {data, responsavel: responsavel||null, tema: tema||null, observacoes};

    let learningRowId = id;
    let evIdAnt = null;
    if(id){
      const lAntigo = (_i3Learning||[]).find(l => l.id === id);
      evIdAnt = lAntigo?.evento_calendario_id;
      const { error } = await _supa.from('i3_learning').update(payload).eq('id', id);
      if(error) throw error;
    } else {
      const { data: ins, error } = await _supa.from('i3_learning').insert(payload).select().single();
      if(error) throw error;
      learningRowId = ins.id;
    }

    // SINCRONIZA: desmarcou agenda → remove evento antigo
    if(!querAgenda && evIdAnt){
      try {
        await _supa.from('eventos_calendario').delete().eq('id', evIdAnt);
        await _supa.from('i3_learning').update({evento_calendario_id: null}).eq('id', learningRowId);
        console.log('[i3l sync] evento removido (agenda desmarcada)');
      } catch(e){ console.warn('[i3l sync delete]', e); }
    }
    // Tinha evento → atualiza em vez de criar novo
    else if(querAgenda && evIdAnt){
      try {
        const updPayload = {
          titulo: '🎓 Impulse Learning' + (tema?' — '+tema:'') + (responsavel?' · '+responsavel:''),
          data_inicio: data,
          descricao: 'Reunião semanal Impulse Learning. Responsável: ' + (responsavel||'—') + ' · Tema: ' + (tema||'—')
        };
        await _supa.from('eventos_calendario').update(updPayload).eq('id', evIdAnt);
      } catch(e){ console.warn('[i3l sync update]', e); }
    }
    else if(querAgenda && learningRowId && !evIdAnt){
      try {
        const evPayload = {
          titulo: '🎓 Impulse Learning' + (tema?' — '+tema:'') + (responsavel?' · '+responsavel:''),
          data_inicio: data,
          tipo: 'treinamento',
          cor: '#6366f1',
          descricao: 'Reunião semanal Impulse Learning. Responsável: ' + (responsavel||'—') + ' · Tema: ' + (tema||'—'),
          notificar: true
        };
        const { data: evData, error: evErr } = await _supa.from('eventos_calendario').insert(evPayload).select().single();
        if(!evErr && evData){
          await _supa.from('i3_learning').update({evento_calendario_id: evData.id}).eq('id', learningRowId);
        } else {
          console.warn('[i3l evento]', evErr);
        }
      } catch(e){ console.warn('[i3l evento]', e); }
    }

    toast('✓ Salvo', 'success');
    document.getElementById('i3LModal').remove();
    await loadI3Learning();
    if(typeof loadEventosCalendario === 'function') await loadEventosCalendario();
    renderI3(document.getElementById('content'));
  } catch(e){
    console.error('[salvarI3Learning]', e);
    const msg = e?.message || e;
    if(String(msg).includes('relation') && String(msg).includes('does not exist')){
      toast('⚠ Tabela i3_learning nao existe. Rode o SQL 50-i3-socios.sql no Supabase', 'info');
    } else if(e?.code === '42P01'){
      toast('⚠ Rode o SQL 50-i3-socios.sql no Supabase pra criar as tabelas', 'info');
    } else {
      toast('Erro ao salvar: ' + msg, 'info');
    }
    if(btn){ btn.disabled = false; btn.textContent = 'Salvar'; }
  }
}

async function excluirI3Learning(id){
  if(!(await confirmDelete('agendamento'))) return;
  if(!_supa) return;
  // Pega o evento_id antes de deletar pra sincronizar agenda
  const learning = (_i3Learning||[]).find(l => l.id === id);
  const eventoId = learning?.evento_calendario_id;
  const { error } = await _supa.from('i3_learning').delete().eq('id', id);
  if(error){ toast('Erro: ' + error.message, 'info'); return; }
  // Sincroniza: remove evento da agenda se existia
  if(eventoId){
    try {
      const { error: evErr } = await _supa.from('eventos_calendario').delete().eq('id', eventoId);
      if(evErr) console.warn('[i3l sync agenda]', evErr);
    } catch(e){ console.warn('[i3l sync agenda]', e); }
  }
  toast('Excluido' + (eventoId ? ' · evento removido da agenda' : ''), 'success');
  await loadI3Learning();
  if(typeof loadEventosCalendario === 'function') await loadEventosCalendario();
  renderI3(document.getElementById('content'));
}

