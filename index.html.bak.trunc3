const clientColors = ['#0ea5e9','#7c3aed','#ec4899','#f59e0b','#10b981','#ef4444','#06b6d4','#a855f7','#f97316','#3b82f6','#84cc16','#ec4899','#8b5cf6','#14b8a6','#f43f5e','#22c55e','#0891b2','#d946ef','#eab308','#06b6d4','#ea580c'];
const clientNames = ['Aquassafe','ITD','Steel Desk','Weco','Termodron','Concept','Santuse','Precisa Serviços','Qualific','Marmitina','Banca de Síndicos','Dener','Natacenter','Alegria Kids','Sócias','Rentalsul','Pro4saúde','Top Sports','Franci','iGet','Eucassel'];
