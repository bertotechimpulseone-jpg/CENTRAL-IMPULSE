        <div style="flex:1">
          <div style="font-size:16px;font-weight:700">${isEdit?'Editar captação':'Nova captação'}</div>
          <div class="text-xs text-3" style="margin-top:2px">Preencha as informações da gravação</div>
        </div>
        <button class="modal-close" onclick="document.getElementById('capFormModal').remove()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding:20px;max-height:75vh;overflow-y:auto">
        <!-- ============ CLIENTE ============ -->
        <div class="section-title" style="margin-top:0">🏢 Cliente</div>
        <div style="display:flex;gap:6px;margin-bottom:8px">
          <button type="button" id="capTabCli" class="filter-chip ${!useCustom?'active':''}" onclick="capToggleCli('vinculado')">Cliente existente</button>
          <button type="button" id="capTabCustom" class="filter-chip ${useCustom?'active':''}" onclick="capToggleCli('custom')">Cliente avulso</button>
        </div>
        <div id="capCliVinculadoBox" style="display:${useCustom?'none':'block'}">
          <select id="capCli" class="login-input" style="background:var(--surface-2);width:100%">
            <option value="">— Selecione um cliente —</option>${clientOpts}
          </select>
        </div>
        <div id="capCliCustomBox" style="display:${useCustom?'grid':'none'};grid-template-columns:1fr 1fr;gap:10px">
          <input id="capCustomName" class="login-input" placeholder="Nome do contato" value="${escapeHtml(c.client_custom_name||'')}" style="background:var(--surface-2)" />
          <input id="capCustomCompany" class="login-input" placeholder="Empresa (opcional)" value="${escapeHtml(c.client_custom_company||'')}" style="background:var(--surface-2)" />
        </div>

        <!-- ============ DADOS DA CAPTAÇÃO ============ -->
        <div class="section-title">🎥 Detalhes</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:4px">Tipo de captação *</div>
            <input id="capType" class="login-input" placeholder="Ex: Vídeo institucional, Reels, Bastidor" value="${escapeHtml(c.type||'')}" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:4px">Data *</div>
            <input id="capDate" type="date" class="login-input" value="${c.date||''}" style="background:var(--surface-2);width:100%" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:4px">Horário *</div>
            <input id="capTime" type="time" class="login-input" value="${c.time||'10:00'}" style="background:var(--surface-2);width:100%" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:4px">Prioridade</div>
            <select id="capPrio" class="login-input" style="background:var(--surface-2);width:100%">
              ${['low','med','high','urgent'].map(p=>`<option value="${p}" ${c.priority===p?'selected':''}>${ {low:'Baixa',med:'Média',high:'Alta',urgent:'Urgente'}[p] }</option>`).join('')}
            </select>
          </div>
          <div>
            <div class="info-label" style="margin-bottom:4px">Status</div>
            <select id="capStatus" class="login-input" style="background:var(--surface-2);width:100%">
              ${['agendada','confirmada','em andamento','finalizada','cancelada'].map(s=>`<option value="${s}" ${c.status===s?'selected':''}>${s}</option>`).join('')}
            </select>
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:4px">Endereço completo</div>
            <input id="capAddr" class="login-input" placeholder="Rua, número — bairro/cidade" value="${escapeHtml(c.addr||'')}" style="background:var(--surface-2)" />
