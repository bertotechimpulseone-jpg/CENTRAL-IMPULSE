function capToggleCli(mode){
  document.getElementById('capTabCli').classList.toggle('active', mode==='vinculado');
  document.getElementById('capTabCustom').classList.toggle('active', mode==='custom');
  document.getElementById('capCliVinculadoBox').style.display = mode==='vinculado'?'block':'none';
  document.getElementById('capCliCustomBox').style.display = mode==='custom'?'grid':'none';
}

// Upload do briefing pro Supabase Storage (bucket "captacoes-briefing")
async function capUploadBriefing(input){
  const file = input.files && input.files[0];
  if(!file) return;
  if(file.size > 10*1024*1024){ toast('Arquivo muito grande (máx 10MB)','info'); return; }
  if(!_supa){ toast('Supabase necessário','info'); return; }
  toast('Enviando anexo...','info');

  // ESTRATÉGIA 1: tenta Supabase Storage primeiro (bucket "captacoes-briefing")
  try {
    const ext = (file.name.split('.').pop() || 'bin').toLowerCase();
    const path = `briefings/${Date.now()}_${Math.random().toString(36).slice(2,8)}.${ext}`;
    const { error } = await _supa.storage.from('captacoes-briefing').upload(path, file, {upsert:false});
    if(!error){
      const { data: pub } = _supa.storage.from('captacoes-briefing').getPublicUrl(path);
      document.getElementById('capBriefUrl').value = pub.publicUrl;
      document.getElementById('capBriefName').value = file.name;
      document.getElementById('capBriefFileName').textContent = '📎 ' + file.name;
      toast('✓ Anexo enviado','success');
      return;
    }
    console.warn('[uploadBrief] Storage falhou, tentando base64:', error);
    // Se for outro erro que não bucket faltando, mostra
    if(error.message && !error.message.toLowerCase().includes('not found') && !error.message.toLowerCase().includes('bucket')){
      // Continua pro fallback mesmo assim
    }
  } catch(e){
    console.warn('[uploadBrief] exception, tentando base64:', e);
  }

  // ESTRATÉGIA 2 (fallback): salva como base64 no campo do banco (até 1MB)
  if(file.size > 1*1024*1024){
    toast('Arquivo grande (>1MB). Crie o bucket no Supabase Storage.','info');
    alert('⚠ O bucket "captacoes-briefing" não existe no Supabase Storage.\n\nPra arquivos grandes (>1MB), o bucket é necessário:\n\n1. Vai em Supabase → Storage\n2. Clica em "Create bucket"\n3. Nome: captacoes-briefing\n4. MARCA "Public bucket" → Save\n\nPra arquivos pequenos (≤1MB), o sistema salva direto no banco como base64 (não precisa de bucket).\n\nReduza o arquivo e tente de novo, ou crie o bucket.');
    return;
  }

  try {
    const dataUrl = await new Promise((resolve, reject)=>{
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
    document.getElementById('capBriefUrl').value = dataUrl;
    document.getElementById('capBriefName').value = file.name;
    document.getElementById('capBriefFileName').textContent = '📎 ' + file.name + ' (salvo no banco)';
    toast('✓ Anexo salvo no banco (sem bucket)','success');
    console.log('[uploadBrief] salvou como base64,', Math.round(dataUrl.length/1024), 'KB');
  } catch(e){
    toast('Erro ao processar: '+e.message,'info');
    console.error(e);
  }
}

// Gera token random pra share link público
function gerarShareToken(){
  return 'cap_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36).slice(-4);
}

// Salva captação (cria ou edita)
async function salvarCaptacaoForm(capId){
  const isEdit = !!capId;
  const cap = isEdit ? captacoes.find(c => c.id === capId) : null;

  // Cliente
  const isCustom = document.getElementById('capTabCustom').classList.contains('active');
  let clientDbId = null;
  let customName = '';
  let customCompany = '';
  if(isCustom){
    customName = document.getElementById('capCustomName').value.trim();
    customCompany = document.getElementById('capCustomCompany').value.trim();
    if(!customName){ toast('Informe o nome do contato avulso','info'); return; }
  } else {
    clientDbId = document.getElementById('capCli').value || null;
    if(!clientDbId){ toast('Selecione um cliente ou troque para "Cliente avulso"','info'); return; }
  }

  const type = document.getElementById('capType').value.trim();
  if(!type){ toast('Informe o tipo de captação','info'); return; }
  const date = document.getElementById('capDate').value;
  const time = document.getElementById('capTime').value;
  if(!date){ toast('Informe a data','info'); return; }

  const payload = {
    client_id: clientDbId,
    client_custom_name: customName || null,
    client_custom_company: customCompany || null,
    type,
    scheduled_date: date,
    scheduled_time: time,
    priority: document.getElementById('capPrio').value,
    status: document.getElementById('capStatus').value,
    address: document.getElementById('capAddr').value.trim(),
    briefing: document.getElementById('capBrief').value.trim(),
    responsavel_nome: document.getElementById('capRespNome').value.trim() || null,
    responsavel_telefone: document.getElementById('capRespTel').value.replace(/\D/g,'') || null,
    contato_local_nome: document.getElementById('capContNome').value.trim() || null,
    contato_local_telefone: document.getElementById('capContTel').value.replace(/\D/g,'') || null,
    material_url: document.getElementById('capMaterialUrl').value.trim() || null,
    referencia_url: document.getElementById('capRefUrl').value.trim() || null,
    briefing_arquivo_url: document.getElementById('capBriefUrl').value.trim() || null,
    briefing_arquivo_nome: document.getElementById('capBriefName').value.trim() || null
  };

  const btn = document.getElementById('capSaveBtn');
  btn.disabled = true;
  btn.innerHTML = '⏳ Salvando...';

  try {
    if(isEdit && cap && cap._dbId){
      const { error } = await _supa.from('captacoes').update(payload).eq('id', cap._dbId);
      if(error) throw error;
      toast('✓ Captação atualizada','success');
    } else {
      payload.share_token = gerarShareToken();
      // Prazo de entrega automatico: data da captacao + 15 dias corridos
      if(payload.scheduled_date){
        try {
          const d = new Date(payload.scheduled_date + 'T00:00:00');
          d.setDate(d.getDate() + 15);
          payload.prazo_entrega = d.toISOString().split('T')[0];
        } catch(e){ console.warn('[captacao prazo]', e); }
      }
      payload.entregue = false;
      const { data: capInserida, error } = await _supa.from('captacoes').insert(payload).select().single();
      if(error) throw error;

      // Cria evento no calendario com o prazo (se tabela existir)
      if(payload.prazo_entrega && capInserida){
        try {
          const cliNome = payload.client_custom_name || (clients.find(c => c._dbId === payload.client_id) || {}).name || 'Captação';
          const respNome = payload.responsavel_nome || 'Equipe';
          const evento = {
            titulo: '⏱ Prazo entrega: ' + cliNome + ' (' + respNome + ')',
            descricao: 'Captação ' + (payload.type||'') + ' do dia ' + payload.scheduled_date + ' deve ser entregue até hoje. Resp.: ' + respNome,
            data_inicio: payload.prazo_entrega,
            hora: '18:00',
            tipo: 'prazo',
            cor: '#ef4444',
            client_id: payload.client_id || null,
            notificar: true
          };
          if(typeof _currentProfile !== 'undefined' && _currentProfile && _currentProfile.id) evento.profile_id = _currentProfile.id;
          await _supa.from('eventos_calendario').insert(evento);
          if(typeof loadEventosCalendario === 'function') await loadEventosCalendario();
        } catch(ev){ console.warn('[captacao->evento]', ev); }

        // Tambem cria lembrete na vespera (D-1) pra notificar
        try {
          const dPrazo = new Date(payload.prazo_entrega + 'T09:00:00');
          dPrazo.setDate(dPrazo.getDate() - 1);
          const cliNome2 = payload.client_custom_name || (clients.find(c => c._dbId === payload.client_id) || {}).name || 'Captação';
          const lembrete = {
            texto: '⏰ Captação ' + cliNome2 + ' — prazo amanha (' + payload.prazo_entrega + ')',
            data_hora: dPrazo.toISOString(),
            client_id: payload.client_id || null,
            done: false
          };
          if(typeof _currentProfile !== 'undefined' && _currentProfile && _currentProfile.id) lembrete.profile_id = _currentProfile.id;
          await _supa.from('lembretes').insert(lembrete);
          if(typeof loadLembretes === 'function') await loadLembretes();
        } catch(lb){ console.warn('[captacao->lembrete]', lb); }
      }

      toast('✓ Captação criada — prazo entrega: ' + (payload.prazo_entrega || '—') + ' (adicionado na agenda)','success');
    }
    document.getElementById('capFormModal').remove();
    await loadDataFromSupabase();
    renderCaptacao(document.getElementById('content'));
  } catch(e){
    btn.disabled = false;
    btn.innerHTML = '💾 ' + (isEdit?'Salvar alterações':'Criar captação');
    toast('Erro: '+(e.message||e),'info');
    console.error('[salvarCap]', e);
  }
}

// Apelidos pra compatibilidade
function openNovaCaptacaoModal(){ openCaptacaoFormModal(null); }
function salvarNovaCaptacao(){ salvarCaptacaoForm(null); }



// ============ MODAL: NOVA REUNIÃO ============
function openNovaReuniaoModal(reuniaoExistente){
  const editing = !!reuniaoExistente;
  const r = reuniaoExistente || {};
  const mod = document.getElementById('clientModal');
  const hoje = new Date().toISOString().split('T')[0];
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:42px;height:42px;border-radius:10px;background:var(--accent);color:#fff;display:grid;place-items:center;font-weight:700;font-size:18px">📹</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">${editing?'Editar reunião':'Nova reunião'}</div><div class="text-xs text-3" style="margin-top:2px">Agende com cliente · cole o link do Meet ou crie um</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Título *</div><input id="nmTitle" class="login-input" placeholder="Ex: Diagnóstico - ITD" value="${(r.title||'').replace(/"/g,'&quot;')}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Cliente</div><select id="nmCli" class="login-input" style="background:var(--surface-2)"><option value="">Sem cliente (interno)</option>${clients.map(c=>`<option value="${c.id}" ${r.client_id===c._dbId?'selected':''}>${(c.name||'').replace(/</g,'&lt;')}</option>`).join('')}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Tipo</div><select id="nmType" class="login-input" style="background:var(--surface-2)">${['Diagnóstico','Estratégia','Recorrente','Criativa','Renovação','Kickoff','Apresentação'].map(t=>`<option ${r.type===t?'selected':''}>${t}</option>`).join('')}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Data *</div><input id="nmDate" class="login-input" type="date" value="${r.scheduled_at?r.scheduled_at.split('T')[0]:hoje}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Horário *</div><input id="nmTime" class="login-input" type="time" value="${r.scheduled_at?r.scheduled_at.split('T')[1]?.slice(0,5)||'10:00':'10:00'}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Plataforma</div><select id="nmPlat" class="login-input" style="background:var(--surface-2)">${['Google Meet','Zoom','Microsoft Teams','Presencial','WhatsApp call'].map(p=>`<option ${(r.platform||'Google Meet')===p?'selected':''}>${p}</option>`).join('')}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Duração (min)</div><input id="nmDur" class="login-input" type="number" min="15" step="15" value="${r.duration_min||60}" style="background:var(--surface-2)" /></div>

        <div style="grid-column:span 2">
          <div class="info-label" style="margin-bottom:5px;display:flex;align-items:center;justify-content:space-between">
            <span>📹 Link da reunião (Meet/Zoom)</span>
            <div style="display:flex;gap:6px">
              <button type="button" onclick="window.open('https://meet.google.com/new','_blank')" style="padding:4px 9px;font-size:11px;background:var(--surface-2);border:1px solid var(--border);border-radius:6px;cursor:pointer;color:var(--text);font-weight:600">🎬 Abrir Meet</button>
              <button type="button" onclick="navigator.clipboard.readText().then(t=>{const i=document.getElementById('nmLink');if(i)i.value=t;toast('Link colado','success')})" style="padding:4px 9px;font-size:11px;background:var(--surface-2);border:1px solid var(--border);border-radius:6px;cursor:pointer;color:var(--text);font-weight:600">📋 Colar</button>
            </div>
          </div>
          <input id="nmLink" class="login-input" type="url" placeholder="https://meet.google.com/abc-defg-hij" value="${(r.meet_url||'').replace(/"/g,'&quot;')}" style="background:var(--surface-2)" />
          <div class="text-xs text-3" style="margin-top:4px">💡 Clique em "Abrir Meet" → criar sala → copiar link → "Colar" aqui</div>
        </div>

        <div style="grid-column:span 2">
          <div class="info-label" style="margin-bottom:5px">⏰ Lembrete automático antes</div>
          <select id="nmReminder" class="login-input" style="background:var(--surface-2)">
            <option value="0">Não criar lembrete</option>
            <option value="15" ${r.reminder_min==15?'selected':''}>15 minutos antes</option>
            <option value="30" ${r.reminder_min==30||!editing?'selected':''}>30 minutos antes</option>
            <option value="60" ${r.reminder_min==60?'selected':''}>1 hora antes</option>
            <option value="1440">1 dia antes</option>
          </select>
        </div>

        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">📝 Pauta / observações</div><textarea id="nmAgenda" class="login-input" placeholder="Ex: alinhar campanhas de junho, revisar criativos, etc" style="background:var(--surface-2);min-height:70px">${(r.agenda||'').replace(/</g,'&lt;')}</textarea></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:22px;justify-content:flex-end;align-items:center">
        ${editing?`<button class="btn" onclick="excluirReuniao('${r._dbId||''}')" style="color:var(--danger);margin-right:auto">🗑 Excluir</button>`:''}
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovaReuniao(${editing?`'${r._dbId||''}'`:'null'})" id="nmBtn">${editing?'Salvar':'Agendar reunião'}</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function salvarNovaReuniao(editingId){
  const title = document.getElementById('nmTitle').value.trim();
  if(!title){toast('Informe o título','info');return}
  const cliId = document.getElementById('nmCli').value;
  const cli = cliId ? clients.find(c=>c.id===parseInt(cliId)) : null;
  const d = document.getElementById('nmDate').value;
  const t = document.getElementById('nmTime').value;
  if(!d || !t){toast('Preencha data e horário','info');return}
  const scheduledAt = new Date(`${d}T${t}:00`).toISOString();
  const meetUrl = (document.getElementById('nmLink').value||'').trim() || 'https://meet.google.com/new';
  const reminderMin = parseInt(document.getElementById('nmReminder').value)||0;
  const btn = document.getElementById('nmBtn'); btn.disabled = true; btn.textContent = 'Salvando...';
  const payload = {
    title, client_id: cli?cli._dbId:null,
    scheduled_at: scheduledAt,
    duration_min: parseInt(document.getElementById('nmDur').value) || 60,
    type: document.getElementById('nmType').value,
    platform: document.getElementById('nmPlat').value,
    agenda: document.getElementById('nmAgenda').value.trim(),
    meet_url: meetUrl
  };
  let r;
  if(editingId && editingId !== 'null' && editingId !== ''){
    if(_supa){
      const { error } = await _supa.from('meetings').update(payload).eq('id', editingId);
      if(error){ toast('Erro: '+error.message,'info'); btn.disabled=false; btn.textContent='Salvar'; return; }
      r = true;
    } else r = true;
  } else {
    r = await dbCreate('meetings', payload);
  }
  if(r){
    // Cria lembrete automatico se solicitado
    if(reminderMin > 0 && _supa && _currentProfile){
      try {
        const dataAviso = new Date(new Date(scheduledAt).getTime() - reminderMin*60000);
        const nomeCliente = cli ? cli.name : (title.includes('-')?title.split('-').slice(-1)[0].trim():'(interno)');
        const reminderText = `📹 Reunião "${title}" começa em ${reminderMin>=60?(reminderMin/60)+'h':reminderMin+'min'}${cli?' com '+cli.name:''}`;
        await _supa.from('lembretes').insert({
          profile_id: _currentProfile.id,
          texto: reminderText,
          data_hora: dataAviso.toISOString(),
          client_id: cli?cli._dbId:null,
          done: false
        });
        if(typeof loadLembretes === 'function') await loadLembretes();
      } catch(e){ console.warn('[reuniao-lembrete]', e); }
    }
    toast(editingId&&editingId!=='null'?'✓ Reunião atualizada':'✓ Reunião agendada','success');
    closeModal();
    await loadDataFromSupabase();
    renderReunioes(document.getElementById('content'));
  } else { btn.disabled=false; btn.textContent='Agendar reunião' }
}

async function excluirReuniao(id){
  if(!id){ closeModal(); return; }
  if(!(await confirmDelete('reunião'))) return;
  if(_supa){
    const { error } = await _supa.from('meetings').delete().eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  toast('Reunião excluída','success');
  closeModal();
  await loadDataFromSupabase();
  renderReunioes(document.getElementById('content'));
}

// ============ MODAL: NOVA TRANSAÇÃO FINANCEIRA ============
function openNovaTransacaoModal(type){
  const mod = document.getElementById('clientModal');
  const isIn = type==='in';
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:${isIn?'var(--success)':'var(--danger)'};color:#fff;display:grid;place-items:center;font-weight:700;font-size:18px">${isIn?'+':'-'}</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">${isIn?'Nova cobrança / entrada':'Nova despesa'}</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Descrição *</div><input id="ntDesc" class="login-input" placeholder="${isIn?'Ex: Mensalidade maio - ITD':'Ex: Aluguel da sede'}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Valor *</div><input id="ntAmt" class="login-input" type="number" step="0.01" placeholder="0,00" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Data *</div><input id="ntDate" class="login-input" type="date" value="${new Date().toISOString().split('T')[0]}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Categoria</div><select id="ntCat" class="login-input" style="background:var(--surface-2)">${isIn?'<option>recorrente</option><option>projeto</option><option>extra</option>':'<option>aluguel</option><option>salarios</option><option>ferramentas</option><option>trafego</option><option>impostos</option><option>outras</option>'}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Status</div><select id="ntStatus" class="login-input" style="background:var(--surface-2)"><option value="paid" selected>Pago</option><option value="pending">Pendente</option><option value="late">Atrasado</option></select></div>
        ${isIn?`<div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Cliente</div><select id="ntCli" class="login-input" style="background:var(--surface-2)"><option value="">—</option>${clients.map(c=>`<option value="${c.id}">${c.name}</option>`).join('')}</select></div>`:`<div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Fornecedor</div><input id="ntSup" class="login-input" placeholder="Ex: Adobe, INSS" style="background:var(--surface-2)" /></div>`}
        <div><div class="info-label" style="margin-bottom:5px">Forma pagamento</div><select id="ntMethod" class="login-input" style="background:var(--surface-2)"><option>pix</option><option>boleto</option><option>cartao</option><option>transferencia</option></select></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovaTransacao('${type}')" id="ntBtn">Salvar</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function salvarNovaTransacao(type){
  const desc = document.getElementById('ntDesc').value.trim();
  const amt = parseFloat(document.getElementById('ntAmt').value);
  if(!desc || !amt){toast('Preencha descrição e valor','info');return}
  const isIn = type==='in';
  const data = {
    type, description: desc, amount: amt,
    date: document.getElementById('ntDate').value,
    category: document.getElementById('ntCat').value,
    status: document.getElementById('ntStatus').value,
    payment_method: document.getElementById('ntMethod').value
  };
  if(isIn){
    const cliId = document.getElementById('ntCli').value;
    if(cliId){ const c = clients.find(x=>x.id===parseInt(cliId)); if(c) data.client_id = c._dbId; }
  } else {
    data.supplier = document.getElementById('ntSup').value.trim();
  }
  const btn = document.getElementById('ntBtn'); btn.disabled=true; btn.textContent='Salvando...';
  const r = await dbCreate('transactions', data);
  if(r){ toast('✓ Transação registrada','success'); closeModal(); renderFinanceiro(document.getElementById('content')); }
  else { btn.disabled=false; btn.textContent='Salvar' }
}

