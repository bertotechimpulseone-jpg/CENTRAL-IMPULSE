  </div></div>`;
}

// ============ CAPTAÇÃO (lista compacta + mini-calendário) ============
let capFilter = 'all';
let capQuery = '';
let capOpenGroups = {};
let capView = 'lista'; // 'lista' | 'calendario' | 'kanban'
let capMiniCalRef = null; // ano-mês do mini-cal (YYYY-MM)
let capSelectedDay = null; // YYYY-MM-DD filtrando por dia

function capPeriodoLabel(cap, today){
  const cap0 = new Date(cap.date+'T00:00:00');
  cap0.setHours(0,0,0,0);
  const t0 = new Date(today); t0.setHours(0,0,0,0);
  const diff = Math.round((cap0 - t0) / 86400000);
  if(diff === 0) return {key:'hoje', label:'🔴 Hoje', order:0};
  if(diff === 1) return {key:'amanha', label:'🟡 Amanhã', order:1};
  if(diff > 1 && diff <= 7) return {key:'semana', label:'📅 Esta semana', order:2};
  if(diff > 7 && diff <= 30) return {key:'mes', label:'🗓 Este mês', order:3};
  if(diff > 30) return {key:'futuro', label:'⏭ Mais adiante', order:4};
  // diff < 0 = passado
  if(diff >= -7) return {key:'recente', label:'⌛ Recém-passadas', order:5};
  return {key:'antigas', label:'📦 Antigas', order:6};
}

// Quem pode VER TODAS as captacoes e tambem EDITAR (alem de gestores)
function podeGerenciarCaptacoes(){
  try {
    const PRIMEIROS_NOMES = ['gabi','gabriela'];  // adicione aqui outros nomes
    const EMAILS = ['gabi@impulseone.com.br','gabriela@impulseone.com.br'];  // adicione aqui outros emails
    if(typeof isGestor === 'function' && isGestor()) return true;
    const meuNome = (typeof getMeuNome === 'function' ? (getMeuNome()||'') : '').trim();
    const meuPrimeiro = meuNome.split(/\s+/)[0].toLowerCase();
    const meuEmail = (typeof _currentUser !== 'undefined' && _currentUser && _currentUser.email || '').toLowerCase();
    return PRIMEIROS_NOMES.includes(meuPrimeiro) || EMAILS.includes(meuEmail);
  } catch(e){ return false; }
}

function renderCaptacao(c){
  const today = new Date();
  // PERMISSÃO: gestor + lista de pessoas autorizadas (ex: Gabi) veem TODAS — outros só as suas
  const podeVerTudo = podeGerenciarCaptacoes();
  const meuNome = getMeuNome();
  const captacoesVisiveis = podeVerTudo ? captacoes : captacoes.filter(capEhMinha);

  // Filtros
  const filt = captacoesVisiveis.filter(cap=>{
    if(capFilter!=='all' && cap.status!==capFilter) return false;
    if(capSelectedDay && cap.date !== capSelectedDay) return false;
    if(capQuery){
      const q = capQuery.toLowerCase();
      const hay = (cap.client+' '+cap.type+' '+(cap.resp||'')+' '+(cap.addr||'')+' '+cap.status).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });

  // Stats globais (sempre baseado em captacoesVisiveis, não no total)
  const counters = {
    agendada: captacoesVisiveis.filter(x=>x.status==='agendada').length,
    confirmada: captacoesVisiveis.filter(x=>x.status==='confirmada').length,
    andamento: captacoesVisiveis.filter(x=>x.status==='em andamento').length,
    finalizada: captacoesVisiveis.filter(x=>x.status==='finalizada').length,
    total: captacoesVisiveis.length
  };

  const subtitle = podeVerTudo
    ? `${counters.total} captação(ões) cadastrada(s)`
    : `${counters.total} captação(ões) sob sua responsabilidade${meuNome?' — '+meuNome.split(' ')[0]:''}`;

  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Captação${!podeVerTudo?' <span class="badge b-info" style="margin-left:6px;font-size:10.5px;vertical-align:middle">🔒 só suas</span>':''}</div>
          <div class="page-subtitle">${subtitle}</div>
        </div>
        <div class="page-actions">
          <div class="page-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input placeholder="Buscar..." oninput="capQuery=this.value;renderCaptacao(document.getElementById('content'))" value="${escapeHtml(capQuery)}"/>
          </div>
          <button class="btn btn-primary" onclick="openCaptacaoFormModal(null)">+ Nova captação</button>
        </div>
      </div>

      <!-- ===== Cards compactos de status (clique pra filtrar) ===== -->
      <div class="cap-status-row">
        <button class="cap-status-card ${capFilter==='all'?'active':''}" onclick="capFilter='all';capSelectedDay=null;renderCaptacao(document.getElementById('content'))">
          <span class="cap-status-num">${counters.total}</span>
          <span class="cap-status-lbl">Todas</span>
        </button>
        <button class="cap-status-card ${capFilter==='agendada'?'active':''}" onclick="capFilter='agendada';capSelectedDay=null;renderCaptacao(document.getElementById('content'))">
          <span class="cap-status-dot" style="background:#9595a0"></span>
          <span class="cap-status-num">${counters.agendada}</span>
          <span class="cap-status-lbl">Agendadas</span>
        </button>
        <button class="cap-status-card ${capFilter==='confirmada'?'active':''}" onclick="capFilter='confirmada';capSelectedDay=null;renderCaptacao(document.getElementById('content'))">
          <span class="cap-status-dot" style="background:#0ea5e9"></span>
          <span class="cap-status-num">${counters.confirmada}</span>
          <span class="cap-status-lbl">Confirmadas</span>
        </button>
        <button class="cap-status-card ${capFilter==='em andamento'?'active':''}" onclick="capFilter='em andamento';capSelectedDay=null;renderCaptacao(document.getElementById('content'))">
          <span class="cap-status-dot" style="background:#f59e0b"></span>
          <span class="cap-status-num">${counters.andamento}</span>
          <span class="cap-status-lbl">Em andamento</span>
        </button>
        <button class="cap-status-card ${capFilter==='finalizada'?'active':''}" onclick="capFilter='finalizada';capSelectedDay=null;renderCaptacao(document.getElementById('content'))">
          <span class="cap-status-dot" style="background:#28a745"></span>
          <span class="cap-status-num">${counters.finalizada}</span>
          <span class="cap-status-lbl">Finalizadas</span>
        </button>
      </div>

      <!-- ===== Toggle de visualizações ===== -->
      <div class="view-toggle">
        <button class="view-toggle-btn ${capView==='lista'?'active':''}" onclick="capView='lista';renderCaptacao(document.getElementById('content'))">📋 Lista</button>
        <button class="view-toggle-btn ${capView==='calendario'?'active':''}" onclick="capView='calendario';renderCaptacao(document.getElementById('content'))">📅 Calendário</button>
        <button class="view-toggle-btn ${capView==='kanban'?'active':''}" onclick="capView='kanban';renderCaptacao(document.getElementById('content'))">📊 Kanban</button>
        ${capSelectedDay ? `<span class="cap-day-filter">Filtrando: <strong>${new Date(capSelectedDay+'T00:00:00').toLocaleDateString('pt-BR',{day:'2-digit',month:'short'})}</strong> <button onclick="capSelectedDay=null;renderCaptacao(document.getElementById('content'))" style="background:none;border:none;cursor:pointer;color:inherit;margin-left:6px;font-weight:700">×</button></span>` : ''}
      </div>

      ${capView==='lista' ? renderCapLista(filt, today) : ''}
      ${capView==='calendario' ? renderCapCalendarioCompacto(filt, today) : ''}
      ${capView==='kanban' ? renderCapKanban(filt, today) : ''}
    </div>
  `;
}

// ===== VISÃO LISTA: agrupada por período (Hoje, Amanhã, etc.) =====
function renderCapLista(filt, today){
  if(filt.length === 0){
    return `<div class="empty-state" style="padding:80px 20px"><div class="ico">🎬</div><div class="ttl">Nenhuma captação</div><div class="desc">${captacoes.length===0?'Crie a primeira pelo botão "+ Nova captação".':'Ajuste os filtros ou a busca.'}</div></div>`;
  }
  // Agrupa por período
  const grupos = {};
  filt.forEach(cap => {
    const p = capPeriodoLabel(cap, today);
    if(!grupos[p.key]) grupos[p.key] = {label:p.label, order:p.order, items:[]};
    grupos[p.key].items.push(cap);
  });
  const sortedKeys = Object.keys(grupos).sort((a,b)=>grupos[a].order - grupos[b].order);

  return `
    <div class="cap-list-wrap">
      ${sortedKeys.map(k => {
        const g = grupos[k];
        // Ordena items por data + hora
        g.items.sort((a,b)=> (a.date+a.time).localeCompare(b.date+b.time));
        return `
          <div class="cap-list-group">
            <div class="cap-list-group-head">
              <span class="cap-list-group-label">${g.label}</span>
              <span class="cap-list-group-count">${g.items.length}</span>
            </div>
            <div class="cap-list-group-body">
              ${g.items.map(cap => capCardCompacto(cap, today)).join('')}
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

// Card compacto de captação (usado na lista)
function capCardCompacto(cap, today){
  const dateObj = new Date(cap.date+'T'+(cap.time||'10:00'));
  const day = dateObj.getDate();
  const month = dateObj.toLocaleDateString('pt-BR',{month:'short'}).replace('.','');
  const weekday = dateObj.toLocaleDateString('pt-BR',{weekday:'short'}).replace('.','');
  // Comparacao "passada" considera o dia (zerar horas pra nao perder a propria diaria)
  const t0 = new Date(today); t0.setHours(0,0,0,0);
  const cap0 = new Date(cap.date+'T00:00:00');
  const daysUntil = Math.ceil((cap0 - t0) / 86400000);
  // Passada = data ja foi OU status terminal
  const ehPassada = daysUntil < 0 || cap.status === 'finalizada' || cap.status === 'cancelada';
  const statusColor = {agendada:'b-default',confirmada:'b-info','em andamento':'b-warning',finalizada:'b-success',cancelada:'b-danger'}[cap.status] || 'b-default';
  const isUrgent = daysUntil>=0 && daysUntil<=2 && ['agendada','confirmada'].includes(cap.status);
  // Cor neutra cinza pra passadas, cor do cliente pra proximas
  const dateBg = ehPassada ? '#9595a01a' : (cap.color||'#7c3aed')+'1a';
  const dateColor = ehPassada ? '#9595a0' : (cap.color||'#7c3aed');
  return `
    <div class="cap-card ${isUrgent?'urgent':''} ${ehPassada?'passada':''}" onclick="openCaptacaoDetail(${cap.id})">
      <div class="cap-card-date" style="background:${dateBg};color:${dateColor}">
        <div class="cap-card-day">${day}</div>
        <div class="cap-card-month">${month}</div>
        <div class="cap-card-wd">${weekday}</div>
      </div>
      <div class="cap-card-body">
        <div class="cap-card-top">
          <div class="cap-card-title">${escapeHtml(cap.type||'Captação')}</div>
          <span class="badge ${statusColor}" style="margin-left:auto"><span class="dot"></span>${cap.status}</span>
        </div>
        <div class="cap-card-client">🏢 ${escapeHtml(cap.client||'—')}</div>
        <div class="cap-card-meta">
          <span>🕒 ${cap.time||'—'}</span>
          ${cap.resp ? `<span>📸 ${escapeHtml(cap.resp)}</span>` : ''}
          ${cap.contato_local_nome ? `<span>👤 ${escapeHtml(cap.contato_local_nome)}</span>` : ''}
          ${cap.addr ? `<span>📍 ${escapeHtml((cap.addr||'').split('—')[0].trim().substring(0,30))}${cap.addr.length>30?'…':''}</span>` : ''}
          ${isUrgent ? `<span class="badge b-warning" style="font-size:10px">⚠ ${daysUntil===0?'HOJE':daysUntil===1?'AMANHÃ':daysUntil+'d'}</span>` : ''}
        </div>
      </div>
      <div class="cap-card-actions" onclick="event.stopPropagation()">
        ${cap.share_token ? `<button class="icon-btn" title="Copiar link público" onclick="event.stopPropagation();compartilharCaptacao(${cap.id})">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>` : ''}
        ${podeGerenciarCaptacoes() ? `
        <button class="icon-btn" title="Editar" onclick="event.stopPropagation();editarCaptacao(${cap.id})">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
        <button class="icon-btn" title="Excluir" style="color:var(--danger)" onclick="event.stopPropagation();excluirCaptacao(${cap.id})">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>` : ''}
      </div>
    </div>
  `;
}

// ===== VISÃO CALENDÁRIO COMPACTO =====
function renderCapCalendarioCompacto(filt, today){
  // Mini-cal usa o mês atual ou o capMiniCalRef
  const ref = capMiniCalRef ? new Date(capMiniCalRef + '-01T00:00:00') : new Date(today.getFullYear(), today.getMonth(), 1);
  const year = ref.getFullYear();
  const month = ref.getMonth();
  const monthLabel = ref.toLocaleDateString('pt-BR',{month:'long',year:'numeric'});
  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month+1, 0).getDate();
  // Map dia → captações (do mês atual)
  const dayMap = {};
  filt.forEach(cap => {
    const d = new Date(cap.date+'T00:00:00');
    if(d.getFullYear()===year && d.getMonth()===month){
      const dn = d.getDate();
      if(!dayMap[dn]) dayMap[dn] = [];
      dayMap[dn].push(cap);
    }
  });
  return `
    <div class="cap-cal-wrap">
      <div class="cap-cal-head">
        <button class="icon-btn" onclick="capChangeMonth(-1)" title="Mês anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="cap-cal-title">${monthLabel.charAt(0).toUpperCase()+monthLabel.slice(1)}</div>
        <button class="icon-btn" onclick="capChangeMonth(1)" title="Próximo mês">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </button>
        <button class="btn btn-sm" onclick="capMiniCalRef=null;renderCaptacao(document.getElementById('content'))" style="margin-left:auto">Hoje</button>
      </div>
      <div class="cap-cal-compact">
        ${['DOM','SEG','TER','QUA','QUI','SEX','SÁB'].map(d=>`<div class="cap-cal-wd">${d}</div>`).join('')}
        ${(()=>{
          let h = '';
          // dias do mês anterior (cinza)
          for(let i=0;i<firstDay;i++) h += `<div class="cap-cal-cell other"></div>`;
          for(let dn=1; dn<=daysInMonth; dn++){
            const date = new Date(year, month, dn);
            const isToday = date.toDateString() === today.toDateString();
            const list = dayMap[dn] || [];
            const ymd = `${year}-${String(month+1).padStart(2,'0')}-${String(dn).padStart(2,'0')}`;
            h += `<div class="cap-cal-cell ${list.length?'has':''} ${isToday?'today':''} ${capSelectedDay===ymd?'selected':''}" onclick="capSelectDay('${ymd}')">
              <div class="cap-cal-num">${dn}</div>
              ${list.length ? `<div class="cap-cal-dots">${list.slice(0,3).map(c=>`<span class="cap-cal-dot" style="background:${c.color||'#7c3aed'}"></span>`).join('')}${list.length>3?`<span class="cap-cal-more">+${list.length-3}</span>`:''}</div>` : ''}
            </div>`;
          }
          return h;
        })()}
      </div>
    </div>

    <!-- Captações do dia selecionado / próximas -->
    <div class="cap-list-wrap" style="margin-top:18px">
      <div class="cap-list-group-head"><span class="cap-list-group-label">${capSelectedDay ? '📍 Captações em ' + new Date(capSelectedDay+'T00:00:00').toLocaleDateString('pt-BR') : '📋 Todas as captações filtradas'}</span><span class="cap-list-group-count">${filt.length}</span></div>
      ${filt.length === 0 ? `<div class="empty-state" style="padding:40px 20px"><div class="ico">📭</div><div class="ttl">${capSelectedDay?'Nenhuma captação nesse dia':'Nenhuma captação no filtro'}</div></div>` :
        filt.sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time)).map(cap=>capCardCompacto(cap, today)).join('')}
    </div>
  `;
}

function capChangeMonth(delta){
  const ref = capMiniCalRef ? new Date(capMiniCalRef+'-01T00:00:00') : new Date();
  ref.setMonth(ref.getMonth() + delta);
  capMiniCalRef = `${ref.getFullYear()}-${String(ref.getMonth()+1).padStart(2,'0')}`;
  renderCaptacao(document.getElementById('content'));
}

function capSelectDay(ymd){
  capSelectedDay = (capSelectedDay === ymd) ? null : ymd;
  renderCaptacao(document.getElementById('content'));
}

// ===== VISÃO KANBAN (colunas por status) =====
function renderCapKanban(filt, today){
  const cols = ['agendada','confirmada','em andamento','finalizada'];
  const colLabel = {agendada:'📋 Agendadas','confirmada':'✓ Confirmadas','em andamento':'🎥 Em andamento','finalizada':'✅ Finalizadas'};
  return `
    <div class="cap-kanban">
      ${cols.map(st => {
        const items = filt.filter(c => c.status === st).sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time));
        return `
          <div class="cap-kanban-col">
            <div class="cap-kanban-head">
              <span>${colLabel[st]}</span>
              <span class="cap-kanban-count">${items.length}</span>
            </div>
            <div class="cap-kanban-body">
              ${items.length === 0 ? '<div class="cap-kanban-empty">vazio</div>' :
                items.map(cap => {
                  const dateObj = new Date(cap.date+'T'+(cap.time||'10:00'));
                  const day = dateObj.getDate();
                  const mon = dateObj.toLocaleDateString('pt-BR',{month:'short'}).replace('.','');
                  return `
                    <div class="cap-kanban-card" onclick="openCaptacaoDetail(${cap.id})" style="border-left:3px solid ${cap.color||'#7c3aed'}">
                      <div class="cap-kanban-title">${escapeHtml(cap.type||'Captação')}</div>
                      <div class="cap-kanban-cli">${escapeHtml(cap.client||'—')}</div>
                      <div class="cap-kanban-meta">📅 ${day}/${mon} · 🕒 ${cap.time||'—'}</div>
                      ${cap.resp ? `<div class="cap-kanban-meta">📸 ${escapeHtml(cap.resp)}</div>` : ''}
                    </div>
                  `;
                }).join('')}
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

function toggleCapGroup(name){
  capOpenGroups[name] = capOpenGroups[name]===false;
  document.querySelectorAll(`.cap-group[data-client="${name}"]`).forEach(el=>el.classList.toggle('open'));
}

function openCaptacaoDetail(id){
  const cap = captacoes.find(x=>x.id===id); if(!cap) return;
  const dateObj=new Date(cap.date+'T'+cap.time);
  const dateStr=dateObj.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'});
  const daysUntil=Math.ceil((dateObj-Date.now())/86400000);
  const statusColor={agendada:'b-default',confirmada:'b-info','em andamento':'b-warning',finalizada:'b-success',cancelada:'b-danger'}[cap.status];

  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div class="client-logo" style="background:${cap.color};width:48px;height:48px;font-size:16px">${cap.init}</div>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;letter-spacing:-.02em">🎬 ${cap.type}</div>
        <div class="text-xs text-3" style="margin-top:3px">${cap.client} · ${dateStr} · ${cap.time}</div>
      </div>
      <span class="badge ${statusColor}"><span class="dot"></span>${cap.status}</span>
      ${prioBadge(cap.priority)}
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      ${daysUntil>=0&&daysUntil<=2&&['agendada','confirmada'].includes(cap.status)?`<div class="card mb-4" style="background:var(--warning-soft);border:1px solid var(--warning);color:var(--warning-text)"><strong>⚠ Captação em ${daysUntil===0?'HOJE':daysUntil===1?'1 dia':daysUntil+' dias'}</strong> — confirme com a equipe e o cliente.</div>`:''}

      ${(() => {
        if(!cap.prazo_entrega) return '';
        const hoje = new Date(); hoje.setHours(0,0,0,0);
        const prazo = new Date(cap.prazo_entrega+'T00:00:00');
        const diff = Math.round((prazo - hoje)/86400000);
        const entregue = cap.entregue;
        let bg, bord, ico, label;
        if(entregue){ bg='var(--success-soft)'; bord='var(--success)'; ico='✅'; label='Entregue em '+(cap.entregue_em?new Date(cap.entregue_em).toLocaleDateString('pt-BR'):''); }
        else if(diff < 0){ bg='var(--danger-soft)'; bord='var(--danger)'; ico='🚨'; label=Math.abs(diff)+' dia(s) ATRASADA'; }
        else if(diff === 0){ bg='var(--danger-soft)'; bord='var(--danger)'; ico='⏰'; label='VENCE HOJE'; }
        else if(diff <= 3){ bg='var(--warning-soft)'; bord='var(--warning)'; ico='⏰'; label='Vence em '+diff+' dia(s)'; }
        else { bg='var(--surface-2)'; bord='var(--border-strong)'; ico='📅'; label='Em '+diff+' dia(s)'; }
        const prazoBR = prazo.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'});
        return `<div class="card mb-4" style="background:${bg};border:2px solid ${bord};display:flex;align-items:center;gap:14px;padding:14px 18px">
          <div style="font-size:32px">${ico}</div>
          <div style="flex:1">
            <div class="text-xs text-3" style="text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin-bottom:3px">⏱ PRAZO MÁXIMO DE ENTREGA</div>
            <div style="font-size:20px;font-weight:800;letter-spacing:-.02em;color:var(--text)">${prazoBR}</div>
            <div class="text-sm" style="margin-top:3px;font-weight:600">${label}</div>
          </div>
          ${!entregue ? `<button class="btn btn-primary" onclick="marcarCaptacaoEntregue('${cap._dbId}');closeModal()">✓ Marcar entregue</button>` : ''}
        </div>`;
      })()}

      <div class="info-grid mb-4">
        <div class="info-item"><div class="info-label">Cliente</div><div class="info-value">${cap.client}</div></div>
        <div class="info-item"><div class="info-label">Responsável</div><div class="info-value">${cap.resp}</div></div>
        <div class="info-item"><div class="info-label">Data captação</div><div class="info-value">${dateStr}</div></div>
        <div class="info-item"><div class="info-label">Horário</div><div class="info-value">${cap.time}</div></div>
        <div class="info-item" style="grid-column:span 2"><div class="info-label">Endereço</div><div class="info-value">${cap.addr}</div></div>
      </div>

      <div class="qa-grid mb-4">
        <!-- Cliente: usa contato_local_telefone se houver, senão phone do cliente da carteira -->
        ${(() => {
          const cli = clients.find(c => c.name === cap.client);
          const telCli = cap.contato_local_telefone || (cli && cli.phone) || '';
          const nomeContatoCli = cap.contato_local_nome || cap.client;
          const labelSub = telCli ? '+55 '+telCli.slice(-11,-9)+' '+telCli.slice(-9,-4)+'-'+telCli.slice(-4) : 'sem telefone cadastrado';
          return telCli
            ? `<button class="qa" onclick="abrirWhatsCaptacao('${telCli}','${escapeHtml(nomeContatoCli).replace(/'/g,"\\'")}', 'cliente', ${cap.id})"><span class="qa-icon">👤</span><span><div style="font-weight:600">WhatsApp Cliente</div><div class="text-xs text-3">${escapeHtml(nomeContatoCli)} · ${labelSub}</div></span></button>`
            : `<button class="qa" onclick="toast('Cliente sem telefone. Cadastre em Editar captação.','info')" style="opacity:.6"><span class="qa-icon">👤</span><span><div style="font-weight:600">WhatsApp Cliente</div><div class="text-xs text-3">sem telefone cadastrado</div></span></button>`;
        })()}

        <!-- Profissional: usa responsavel_telefone -->
        ${(() => {
          const telProf = cap.responsavel_telefone || '';
          const nomeProf = cap.responsavel_nome || cap.resp || 'Profissional';
          const labelSub = telProf ? '+55 '+telProf.slice(-11,-9)+' '+telProf.slice(-9,-4)+'-'+telProf.slice(-4) : 'sem telefone cadastrado';
          return telProf
            ? `<button class="qa" onclick="abrirWhatsCaptacao('${telProf}','${escapeHtml(nomeProf).replace(/'/g,"\\'")}', 'profissional', ${cap.id})"><span class="qa-icon">📸</span><span><div style="font-weight:600">WhatsApp Profissional</div><div class="text-xs text-3">${escapeHtml(nomeProf)} · ${labelSub}</div></span></button>`
            : `<button class="qa" onclick="toast('Profissional sem telefone. Cadastre em Editar captação.','info')" style="opacity:.6"><span class="qa-icon">📸</span><span><div style="font-weight:600">WhatsApp Profissional</div><div class="text-xs text-3">sem telefone cadastrado</div></span></button>`;
        })()}

        ${cap.material_url || cap.drive ? `<button class="qa" onclick="openLink('${(cap.material_url||cap.drive||'').replace(/'/g,"\\'")}')"><span class="qa-icon">📁</span><span><div style="font-weight:600">Pasta no Drive</div><div class="text-xs text-3">Materiais</div></span></button>` : `<button class="qa" onclick="toast('Sem link cadastrado. Edite a captação pra adicionar.','info')" style="opacity:.6"><span class="qa-icon">📁</span><span><div style="font-weight:600">Pasta no Drive</div><div class="text-xs text-3">sem link</div></span></button>`}
        ${cap.briefing_arquivo_url ? `<button class="qa" onclick="abrirAnexoBriefing(${cap.id})"><span class="qa-icon">📄</span><span><div style="font-weight:600">Anexo do briefing</div><div class="text-xs text-3">${escapeHtml(cap.briefing_arquivo_nome||'arquivo')}</div></span></button>` : `<button class="qa" onclick="toast('Sem anexo. Edite a captação pra adicionar um briefing em PDF/imagem.','info')" style="opacity:.6"><span class="qa-icon">📄</span><span><div style="font-weight:600">Anexo do briefing</div><div class="text-xs text-3">sem anexo</div></span></button>`}
        ${cap.referencia_url ? `<button class="qa" onclick="openLink('${cap.referencia_url.replace(/'/g,"\\'")}')"><span class="qa-icon">🎨</span><span><div style="font-weight:600">Referências</div><div class="text-xs text-3">Moodboard</div></span></button>` : ''}
      </div>

      ${cap.brief ? `
        <div class="section-title">Briefing rápido</div>
        <div class="text-sm text-mu" style="line-height:1.6;padding:13px;background:var(--surface-2);border-radius:9px;border:1px solid var(--border)">${escapeHtml(cap.brief)}</div>
      ` : ''}

      ${cap.materials && cap.materials.length > 0 ? `
        <div class="section-title">Materiais necessários</div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
          ${cap.materials.map(m=>`<span class="badge b-default" style="padding:5px 10px">📦 ${m}</span>`).join('')}
        </div>
      ` : ''}

      <div class="section-title">Atualizar status</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        ${['agendada','confirmada','em andamento','finalizada','cancelada'].map(s=>`<span class="filter-chip ${cap.status===s?'active':''}" onclick="updateCapStatus(${cap.id},'${s}');setTimeout(()=>openCaptacaoDetail(${cap.id}),200)">${s}</span>`).join('')}
      </div>

      <div class="section-title">🔗 Link de compartilhamento</div>
      <div class="text-xs text-3" style="margin-bottom:8px">Envie este link para o profissional e/ou para o cliente — abre uma página simples com todas as informações, sem precisar de login.</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn btn-primary" onclick="compartilharCaptacao(${cap.id})">📤 Gerar / copiar link</button>
        ${cap.share_token ? `<button class="btn" onclick="copy('${location.origin}/?cap=${cap.share_token}','Link copiado')">📋 Copiar URL</button>
        <button class="btn" onclick="openLink('${location.origin}/?cap=${cap.share_token}')">👁 Abrir link</button>
        ${cap.responsavel_telefone ? `<button class="btn" onclick="enviarLinkWhats('${cap.responsavel_telefone}','${cap.share_token}','${escapeHtml(cap.client||'')}', 'profissional')">📱 Enviar ao profissional</button>` : ''}
        ${cap.contato_local_telefone ? `<button class="btn" onclick="enviarLinkWhats('${cap.contato_local_telefone}','${cap.share_token}','${escapeHtml(cap.client||'')}', 'contato')">📱 Enviar ao contato local</button>` : ''}
        ` : ''}
      </div>

      ${podeGerenciarCaptacoes() ? `
        <div class="section-title">Ações</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn" onclick="editarCaptacao(${cap.id})">✏️ Editar dados</button>
          <button class="btn" style="color:var(--danger);border-color:var(--danger)" onclick="excluirCaptacao(${cap.id})">🗑 Excluir captação</button>
        </div>
      ` : ''}
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

// Gera ou recupera o share_token e copia o link
async function compartilharCaptacao(id){
  const cap = captacoes.find(c => c.id === id);
  if(!cap){ toast('Captação não encontrada','info'); return; }
  let token = cap.share_token;
  if(!token){
    token = gerarShareToken();
    if(_supa && cap._dbId){
      const { error } = await _supa.from('captacoes').update({share_token: token}).eq('id', cap._dbId);
      if(error){ toast('Erro: '+error.message,'info'); return; }
    }
    cap.share_token = token;
  }
  const link = `${location.origin}/?cap=${token}`;
  navigator.clipboard.writeText(link);
  toast('✓ Link copiado: '+link,'success');
  // Re-renderiza pra mostrar os outros botões
  openCaptacaoDetail(id);
}

function enviarLinkWhats(telefone, token, cliente, tipo){
  // Sem mensagem pronta — usuario digita o que quiser
  const tel = (telefone||'').replace(/\D/g,'');
  if(!tel){ toast('Telefone invalido','info'); return; }
  window.open(`https://wa.me/${tel}`, '_blank');
}

// ============ EDITAR / EXCLUIR CAPTAÇÃO ============
async function excluirCaptacao(id){
  // Segurança: só gestor/admin pode excluir
  if(!podeGerenciarCaptacoes()){ toast('🔒 Voce nao tem permissao pra excluir captacoes','info'); return; }
  const cap = captacoes.find(c => c.id === id);
  if(!cap){ toast('Captação não encontrada','info'); return; }
  if(!(await confirmDelete('captação ' + cap.type + ' para ' + cap.client + ' em ' + cap.date, {aviso:'Esta ação é permanente.'}))) return;
  try {
    if(_supa && cap._dbId){
      const { error } = await _supa.from('captacoes').delete().eq('id', cap._dbId);
      if(error) throw error;
    }
    const idx = captacoes.findIndex(c => c.id === id);
    if(idx >= 0) captacoes.splice(idx, 1);
    toast('✓ Captação excluída','success');
    closeModal();
    renderCaptacao(document.getElementById('content'));
  } catch(e){
    toast('Erro: '+e.message,'info');
  }
}

function editarCaptacao(id){
  // Segurança: só gestor/admin pode editar
  if(!podeGerenciarCaptacoes()){ toast('🔒 Voce nao tem permissao pra editar captacoes','info'); return; }
  const cap = captacoes.find(c => c.id === id);
  if(!cap){ toast('Captação não encontrada','info'); return; }
  // Fecha modal de detalhes se aberto
  closeModal();
  // Abre o form unificado em modo edição
  openCaptacaoFormModal(cap);
  return;
  // -------- código antigo abaixo (não será mais executado) --------
  const old = document.getElementById('capEditModal');
  if(old) old.remove();
  const bg = document.createElement('div');
  bg.id = 'capEditModal';
  bg.className = 'modal-bg open';
  bg.style.zIndex = '10000';
  // Lista de clientes pro select
  const clientOpts = clients.map(c => `<option value="${c.name}" ${c.name===cap.client?'selected':''}>${c.name}</option>`).join('');
  // Lista de colaboradores pro select de responsável
  const teamOpts = team.map(t => `<option value="${t.name.split(' ')[0]}" ${t.name.split(' ')[0]===cap.resp?'selected':''}>${t.name}</option>`).join('');
  bg.innerHTML = `
    <div class="modal" style="max-width:560px">
      <div class="modal-head">
        <div style="font-size:15px;font-weight:700">✏️ Editar captação</div>
        <button class="modal-close" onclick="document.getElementById('capEditModal').remove()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding:18px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Cliente</div>
            <select id="capEditCliente" class="login-input" style="background:var(--surface-2);width:100%">${clientOpts}</select>
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Tipo de captação</div>
            <input id="capEditType" class="login-input" value="${escapeHtml(cap.type||'')}" placeholder="ex: Vídeo institucional" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Data</div>
            <input id="capEditDate" type="date" class="login-input" value="${cap.date||''}" style="background:var(--surface-2);width:100%" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Hora</div>
            <input id="capEditTime" type="time" class="login-input" value="${cap.time||'10:00'}" style="background:var(--surface-2);width:100%" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Responsável</div>
            <select id="capEditResp" class="login-input" style="background:var(--surface-2);width:100%"><option value="">— sem responsável —</option>${teamOpts}</select>
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Prioridade</div>
            <select id="capEditPrio" class="login-input" style="background:var(--surface-2);width:100%">
              ${['low','med','high','urgent'].map(p=>`<option value="${p}" ${cap.priority===p?'selected':''}>${ {low:'Baixa',med:'Média',high:'Alta',urgent:'Urgente'}[p] }</option>`).join('')}
            </select>
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Endereço</div>
            <input id="capEditAddr" class="login-input" value="${escapeHtml(cap.addr||'')}" placeholder="Rua, número — bairro/cidade" style="background:var(--surface-2)" />
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Briefing</div>
            <textarea id="capEditBrief" class="login-input" rows="3" placeholder="Descrição rápida da captação" style="background:var(--surface-2);resize:vertical;min-height:60px">${escapeHtml(cap.brief||'')}</textarea>
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Status</div>
            <select id="capEditStatus" class="login-input" style="background:var(--surface-2);width:100%">
              ${['agendada','confirmada','em andamento','finalizada','cancelada'].map(s=>`<option value="${s}" ${cap.status===s?'selected':''}>${s}</option>`).join('')}
            </select>
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Link do Drive (opcional)</div>
            <input id="capEditDrive" class="login-input" value="${escapeHtml(cap.drive||'')}" placeholder="https://drive.google.com/..." style="background:var(--surface-2)" />
          </div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:18px">
          <button class="btn" onclick="document.getElementById('capEditModal').remove()">Cancelar</button>
          <button class="btn btn-primary" onclick="salvarEdicaoCaptacao(${cap.id})">💾 Salvar</button>
        </div>
      </div>
    </div>
  `;
  bg.addEventListener('click', e => { if(e.target === bg) bg.remove(); });
  document.body.appendChild(bg);
}

async function salvarEdicaoCaptacao(id){
  const cap = captacoes.find(c => c.id === id);
  if(!cap){ toast('Captação não encontrada','info'); return; }
  const cliName = document.getElementById('capEditCliente').value;
  const cli = clients.find(c => c.name === cliName);
  const type = document.getElementById('capEditType').value.trim();
  const date = document.getElementById('capEditDate').value;
  const time = document.getElementById('capEditTime').value;
  const resp = document.getElementById('capEditResp').value;
  const prio = document.getElementById('capEditPrio').value;
  const addr = document.getElementById('capEditAddr').value.trim();
  const brief = document.getElementById('capEditBrief').value.trim();
  const status = document.getElementById('capEditStatus').value;
  const drive = document.getElementById('capEditDrive').value.trim();
  if(!type || !date){ toast('Tipo e data são obrigatórios','info'); return; }
  // Atualiza local
  Object.assign(cap, {
    client: cliName, color: cli?cli.color:cap.color, init: cli?cli.init:cap.init,
    phone: cli?cli.phone:cap.phone,
    type, date, time, resp, priority: prio, addr, brief, status, drive
  });
  // Persiste no Supabase
  try {
    if(_supa && cap._dbId){
      const payload = {
        type, scheduled_date: date, scheduled_time: time,
        address: addr, briefing: brief, status, priority: prio,
        drive_url: drive
      };
      if(cli && cli._dbId) payload.client_id = cli._dbId;
      const { error } = await _supa.from('captacoes').update(payload).eq('id', cap._dbId);
      if(error) throw error;
    }
    toast('✓ Captação atualizada','success');
    document.getElementById('capEditModal').remove();
    renderCaptacao(document.getElementById('content'));
  } catch(e){
    toast('Erro: '+e.message,'info');
  }
}

// Abre o anexo do briefing (URL pública OU base64)
function abrirAnexoBriefing(capId){
  const cap = captacoes.find(c => c.id === capId);
  if(!cap || !cap.briefing_arquivo_url){ toast('Sem anexo','info'); return; }
  const url = cap.briefing_arquivo_url;
  if(typeof url === 'string' && url.startsWith('data:')){
    openDataUrlAsBlob(url, cap.briefing_arquivo_nome);
  } else {
    window.open(url, '_blank');
    toast('Abrindo anexo…','info');
  }
}

// Abre WhatsApp direto (sem mensagem pronta)
function abrirWhatsCaptacao(telefone, nome, tipo, capId){
  const tel = (telefone||'').replace(/\D/g,'');
  if(!tel){ toast('Telefone inválido','info'); return; }
  window.open(`https://wa.me/${tel}`, '_blank');
  toast('WhatsApp aberto com '+nome.split(' ')[0],'success');
}

function confirmarCaptacao(id){
  const cap=captacoes.find(c=>c.id===id);if(!cap)return;
  // Procura telefone na ordem: contato local > cliente cadastrado > campo phone bruto
  const cli = clients.find(c => c.name === cap.client);
  const tel = (cap.contato_local_telefone || (cli && cli.phone) || cap.phone || '').replace(/\D/g,'');
  if(!tel){
    toast('Sem telefone cadastrado pra confirmar. Edite a captação e adicione o contato.','info');
    return;
  }
  const dateObj=new Date(cap.date+'T'+(cap.time||'10:00'));
  const dateStr=dateObj.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'});
  const nomeContato = cap.contato_local_nome || cap.client;
  window.open(`https://wa.me/${tel}`,'_blank');
  toast('✓ WhatsApp aberto','success');
}
async function updateCapStatus(id,status){
  const cap=captacoes.find(c=>c.id===id);
  if(cap){
    cap.status=status;
    await saveCaptacaoStatus(id, status);  // persiste
    toast(`Status: ${status}`);
    renderCaptacao(document.getElementById('content'));
  }
}

// ============ COMERCIAL ============
let comTab = 'pipeline';
let orcamento = {
  id: null,
  numero: 'ORC-' + String(Date.now()).slice(-6),
  data: new Date().toISOString().split('T')[0],
  validade: new Date(Date.now() + 30*86400000).toISOString().split('T')[0],
  cliente: {nome:'', cnpj:'', endereco:'', email:'', telefone:'', logo:''},
  itens: [],
  desconto: 0,
  descontoTipo: 'percentual',
  formaPagamento: '',
  prazoEntrega: '',
  observacoes: '',
  termos: ''
};
let orcamentosSalvos = [];

function renderComercial(c){
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Comercial</div><div class="page-subtitle">Funil, pipeline e oportunidades de upsell</div></div><div class=\"page-actions\">${searchBar('Buscar lead, cliente...','#content .kanban, #content .grid-2e')}<button class=\"btn\" onclick=\"comTab='orcamento';renderComercial(document.getElementById('content'))">📄 Orçamento</button><button class="btn btn-primary" onclick="openNovoLeadModal()">+ Novo lead</button></div></div>
  <div class="filter-bar">
    <span class="filter-chip ${comTab==='pipeline'?'active':''}" onclick="comTab='pipeline';renderComercial(document.getElementById('content'))">Pipeline</span>
    <span class="filter-chip ${comTab==='upsell'?'active':''}" onclick="comTab='upsell';renderComercial(document.getElementById('content'))">Upsell & Projeções</span>
    <span class="filter-chip ${comTab==='orcamento'?'active':''}" onclick="comTab='orcamento';renderComercial(document.getElementById('content'))">Orçamento</span>
    <span class="filter-chip ${comTab==='historico'?'active':''}" onclick="comTab='historico';renderComercial(document.getElementById('content'))">📊 Histórico</span>
    ${isAdmin() ? `<span class="filter-chip ${comTab==='precificacao'?'active':''}" onclick="comTab='precificacao';renderComercial(document.getElementById('content'))">💲 Precificação</span>` : ''}
  </div>
  ${comTab==='pipeline'?renderPipelineCom():comTab==='upsell'?renderUpsellCom():comTab==='historico'?renderHistoricoOrcamentos():comTab==='precificacao'?renderPrecificacao():renderOrcamentoCom()}
  </div>`;
}

async function renderPipelineCom(){
  const { data } = _supa ? await _supa.from('leads').select('*').order('created_at',{ascending:false}) : {data:null};
  const leads = data ? data.map(l=>({n:l.name,v:parseFloat(l.value)||0,stage:l.stage==='lead'?'Lead':l.stage==='contato'?'Contato inicial':l.stage==='diagnostico'?'Diagnóstico':l.stage==='proposta'?'Proposta enviada':l.stage==='fechamento'?'Fechamento':l.stage,resp:'Equipe',p:l.priority||'med'})) : [];
  const stages=['Lead','Contato inicial','Diagnóstico','Proposta enviada','Fechamento','Fechado'];
  return `<div class="stat-grid">${statCard('Leads ativos','0','no funil','M16 21v-2')}${statCard('Propostas','0','enviadas','M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Em fechamento','0','—','M3 3v18h18')}${statCard('Projeção mês','R$ 0','—','M12 1v22')}</div>
  <div class="kanban">${stages.map(s=>{const list=leads.filter(l=>l.stage===s);return `<div class="kanban-col"><div class="kanban-head"><div class="kanban-title">${s} <span class="kanban-count">${list.length}</span></div></div><div class="kanban-cards">${list.map(l=>`<div class="kanban-card">${prioBadge(l.p)}<div class="kanban-card-title" style="margin-top:6px">${l.n}</div><div class="text-xs text-3" style="margin-bottom:7px">R$ ${l.v.toLocaleString('pt-BR')}/mês</div><div class="kanban-card-foot"><span>👤 ${l.resp}</span><div class="avatar" style="background:${team.find(t=>t.name.startsWith(l.resp))?.color||'#999'}">${l.resp[0]}</div></div></div>`).join('')}<div class="kanban-add">+ Adicionar lead</div></div></div>`}).join('')}</div>`;
}

function renderUpsellCom(){
  const opps=[];
  return `<div class="stat-grid">${statCard('Oportunidades','0','sem dados','M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Potencial mensal','R$ 0','—','M12 1v22')}${statCard('Renovações','0','—','M3 12h18')}${statCard('Mudança plano','0','—','M9 11l3 3L22 4')}</div>
  <div class="card mt-4" style="border-left:3px solid var(--purple)"><div class="card-header"><div class="card-title">🤖 Sugestões automáticas — atualizadas a cada 3 meses</div><span class="badge b-purple">IA</span></div><div class="text-sm text-mu">A IA analisa <strong>tempo de contrato</strong>, <strong>crescimento</strong> e <strong>serviços atuais</strong> para sugerir upgrades e novos pacotes (tráfego, branding, produção, campanhas).</div></div>
  <div class="section-title">Clientes com oportunidade de upsell</div>
  ${opps.map(o=>`<div class="card mb-3" style="display:flex;gap:14px;align-items:center;padding:16px"><div class="client-logo" style="background:${o.cli.color}">${o.cli.init}</div><div style="flex:1"><div style="display:flex;align-items:center;gap:8px;margin-bottom:3px"><strong>${o.cli.name}</strong><span class="badge b-default">${o.months} meses</span><span class="badge b-success">+${o.growth}% crescimento</span></div><div class="text-xs text-3" style="margin-bottom:8px">Atual: <strong style="color:var(--text)">${o.plan.name} · R$ ${o.plan.value.toLocaleString('pt-BR')}/mês</strong> · ${o.reason}</div><div style="display:flex;gap:10px;align-items:center"><span class="badge b-purple">↑ Sugerir: ${o.suggestedPlan}</span><span class="text-xs text-mu">R$ ${o.plan.value.toLocaleString('pt-BR')} → <strong style="color:var(--success-text)">R$ ${o.suggestedVal.toLocaleString('pt-BR')}</strong> (+R$ ${(o.suggestedVal-o.plan.value).toLocaleString('pt-BR')}/mês)</span></div></div><div style="display:flex;flex-direction:column;gap:5px"><button class="btn btn-sm btn-primary" onclick="openClient(${o.cli.id})">Ver cliente</button><button class="btn btn-sm" onclick="comTab='orcamento';renderComercial(document.getElementById('content'))">📄 Orçamento</button></div></div>`).join('')}
  <div class="card mt-4" style="border-left:3px solid var(--warning)"><div class="card-header"><div class="card-title">⏰ Mudança de plano — alertas (1 mês antes)</div></div>
  <div class="empty-state"><div class="ico">📈</div><div class="ttl">Sem upsells sugeridos</div><div class="desc">As sugestões aparecerão conforme os clientes amadurecem.</div></div>
  </div>`;
}

function renderOrcamentoCom(){
  // Carrega tudo em background
  setTimeout(()=>{loadOrcamentosSalvos();loadBudgetServices();loadBudgetClients()}, 50);
  const serv = _budgetServices.length ? _budgetServices : [
    {id:'m1',name:'Gestão de rede social',value:1800},{id:'m2',name:'Design fixo',value:1200},
    {id:'m3',name:'Tráfego pago',value:2200},{id:'m4',name:'Vídeos',value:1800},
    {id:'m5',name:'Captação',value:2500},{id:'m6',name:'Branding',value:4500},
    {id:'m7',name:'Campanhas',value:3200},{id:'m8',name:'Consultoria',value:1500}
  ];
  const subtotal = orcamento.itens.reduce((s,x)=>s+(x.qtd||1)*x.valor,0);
  const descontoVal = orcamento.descontoTipo==='percentual' ? subtotal*(orcamento.desconto/100) : orcamento.desconto;
  const total = Math.max(0, subtotal - descontoVal);
  const cliNome = orcamento.cliente?.nome || '';

  return `<div class="grid-2">
    <div>
      <div class="card mb-3">
        <div class="card-header"><div class="card-title">📄 ${orcamento.id?'Editando orçamento':'Novo orçamento'}</div><div style="display:flex;gap:6px"><button class="btn btn-sm btn-primary" onclick="limparOrcamento()">+ Novo orçamento</button><button class="btn btn-sm" onclick="abrirGerenciarClientes()">👤 Clientes</button></div></div>
        <div class="info-label">CLIENTE</div>
        <div style="display:flex;gap:6px;margin-top:5px">
          <select id="orcCliSelect" onchange="selecionarClienteOrc(this.value)" style="flex:1;padding:9px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:12.5px;color:var(--text);font-family:inherit">
            <option value="">— Selecione um cliente —</option>
            <option value="__manual__">✏️ Inserir dados manualmente</option>
            <option value="__novo__">➕ Cadastrar novo cliente exclusivo</option>
            <optgroup label="━━━ Clientes do CRM ━━━">
              ${(clients||[]).map(c=>`<option value="crm:${c.id}" ${cliNome===c.name?'selected':''}>🏢 ${c.name}</option>`).join('')}
            </optgroup>
            ${(_budgetClients||[]).length?`<optgroup label="━━━ Clientes exclusivos ━━━">${_budgetClients.map(c=>`<option value="bg:${c.id}" ${cliNome===c.name?'selected':''}>💼 ${c.name}</option>`).join('')}</optgroup>`:''}
          </select>
          <button class="btn btn-sm" onclick="renderComercial(document.getElementById('content'))" title="Atualizar lista">🔄</button>
        </div>
        ${!clients||clients.length===0?'<div class="text-xs text-3 mt-3">⏳ Carregando lista de clientes... Aguarde alguns segundos e clique no botão 🔄</div>':`<div class="text-xs text-3 mt-3">${clients.length} clientes do CRM + ${(_budgetClients||[]).length} exclusivos disponíveis</div>`}
        ${orcamento.cliente?.nome ? `
        <div style="margin-top:10px;padding:10px;background:var(--surface-2);border-radius:8px">
          <input class="login-input" value="${orcamento.cliente.nome}" oninput="orcamento.cliente.nome=this.value" placeholder="Nome / Razão Social" style="background:var(--surface);margin-bottom:6px;font-weight:600" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px">
            <input class="login-input" value="${orcamento.cliente.cnpj||''}" oninput="orcamento.cliente.cnpj=this.value" placeholder="CNPJ/CPF" style="background:var(--surface)" />
            <input class="login-input" value="${orcamento.cliente.telefone||''}" oninput="orcamento.cliente.telefone=this.value" placeholder="Telefone" style="background:var(--surface)" />
          </div>
          <input class="login-input" value="${orcamento.cliente.email||''}" oninput="orcamento.cliente.email=this.value" placeholder="Email" style="background:var(--surface);margin-bottom:6px" />
          <input class="login-input" value="${orcamento.cliente.endereco||''}" oninput="orcamento.cliente.endereco=this.value" placeholder="Endereço" style="background:var(--surface)" />
        </div>` : ''}

        ${orcamento.itens.length === 0 ? `
        <div style="background:linear-gradient(135deg, rgba(99,102,241,.05), rgba(139,92,246,.05));border:1px dashed var(--border);border-radius:10px;padding:18px;margin-top:8px;text-align:center">
          <div style="font-size:28px;margin-bottom:6px">💲</div>
          <div style="font-weight:600;font-size:13px;margin-bottom:4px">Comece pela Precificação</div>
          <div class="text-xs text-3" style="margin-bottom:10px">Selecione produtos e serviços lá → vão aparecer aqui prontos pra finalizar</div>
          ${isAdmin() ? `<button class="btn btn-primary" onclick="comTab='precificacao';renderComercial(document.getElementById('content'))">💲 Ir pra Precificação</button>` : '<div class="text-xs text-3">Solicite à equipe</div>'}
        </div>` : ''}

        <button class="btn" style="width:100%;margin-top:6px" onclick="orcAddServicoModal()">+ Adicionar serviço ao orçamento</button>

        ${orcamento.itens.length > 0 ? `
        <div class="section-title" style="display:flex;justify-content:space-between;align-items:center">
          <span>ITENS DO ORÇAMENTO</span>
          ${orcamento._fromPrecif ? `<span class="badge b-success" style="font-size:10px">📋 vindo da Precificação</span>` : ''}
        </div>
        <div style="display:flex;flex-direction:column;gap:6px">
          ${orcamento.itens.map((it,i)=>{
            const trav = orcamento._fromPrecif;
            const inputStyle = 'background:var(--surface);font-size:12px;padding:6px 8px' + (trav?';color:var(--text-3);cursor:not-allowed':'');
            return `
            <div style="background:var(--surface-2);border-radius:7px;border-left:3px solid ${it.custom?'#f59e0b':'var(--success)'};padding:8px;display:flex;flex-direction:column;gap:6px">
              <div style="display:grid;grid-template-columns:1fr 60px 110px auto;gap:6px;align-items:center">
                ${trav ? `<div style="font-size:12.5px;font-weight:600;padding:6px 8px">${(it.desc||'').replace(/</g,'&lt;')}</div>` : `<input class="cron-obs-input" value="${(it.desc||'').replace(/"/g,'&quot;')}" oninput="orcamento.itens[${i}].desc=this.value" placeholder="Nome do serviço" style="${inputStyle};font-weight:600" />`}
                ${trav ? `<div style="text-align:center;font-size:12px;font-weight:600;padding:6px">${it.qtd||1}</div>` : `<input class="cron-obs-input" type="number" min="1" value="${it.qtd||1}" oninput="orcamento.itens[${i}].qtd=parseFloat(this.value)||1;updateOrcTotals()" style="${inputStyle};text-align:center" />`}
                ${trav ? `<div style="text-align:right;font-size:12.5px;font-weight:700;color:var(--success);padding:6px 8px">R$ ${parseFloat(it.valor).toLocaleString('pt-BR',{minimumFractionDigits:2})}</div>` : `<input class="cron-obs-input" type="number" step="0.01" value="${it.valor}" oninput="orcamento.itens[${i}].valor=parseFloat(this.value)||0;updateOrcTotals()" style="${inputStyle}" />`}
                <button class="icon-btn" style="color:var(--danger);width:28px;height:28px" onclick="orcamento.itens.splice(${i},1);renderComercial(document.getElementById('content'))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>
              </div>
              <textarea oninput="orcamento.itens[${i}].descricao=this.value;updateOrcTotals()" placeholder="📝 Descrição / escopo (opcional) — aparece no PDF" style="width:100%;background:var(--surface);font-size:11.5px;padding:6px 8px;border:1px solid var(--border);border-radius:5px;color:var(--text-2);font-family:inherit;resize:vertical;min-height:34px">${(it.descricao||'').replace(/</g,'&lt;').replace(/&/g,'&amp;')}</textarea>
            </div>
          `;}).join('')}
        </div>` : ''}

        <div class="section-title">💰 DESCONTO (%)</div>
        <div class="text-xs text-3" style="margin-bottom:6px">💡 Até 10% sem aprovação · Acima de 10% requer aprovação dos gestores</div>
        <div style="position:relative">
          <input id="orcDescInput" class="login-input" type="number" step="1" min="0" max="80" value="${orcamento.desconto||0}" oninput="orcValidaDesconto(this)" placeholder="0" style="background:var(--surface-2);font-size:14px;font-weight:700;padding-right:30px;text-align:center" />
          <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--text-3);font-weight:600">%</span>
        </div>

        <div class="section-title">PRAZO & CONDIÇÕES</div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Prazo</div><input class="login-input" value="${orcamento.prazoEntrega||''}" oninput="orcamento.prazoEntrega=this.value" placeholder="Ex: 30 dias após aprovação" style="background:var(--surface);font-size:12px;padding:7px 9px;border:none" /></div>
          <div class="info-item"><div class="info-label">Condições</div><input class="login-input" value="${orcamento.formaPagamento||''}" oninput="orcamento.formaPagamento=this.value" placeholder="Ex: PIX à vista ou 2x no cartão" style="background:var(--surface);font-size:12px;padding:7px 9px;border:none" /></div>
        </div>

        <div class="section-title">OBSERVAÇÕES</div>
        <textarea oninput="orcamento.observacoes=this.value" placeholder="Observações..." style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);font-size:12.5px;color:var(--text);font-family:inherit;min-height:70px;resize:vertical">${orcamento.observacoes||''}</textarea>
      </div>

      ${orcamentosSalvos.length>0?`
      <div class="card mb-3">
        <div class="card-header"><div class="card-title">📜 Histórico salvo</div><span class="badge b-default">${orcamentosSalvos.length}</span></div>
        ${orcamentosSalvos.slice(0,8).map(b=>`
          <div class="list-item">
            <div class="list-icon">📄</div>
            <div class="list-content"><div class="list-title">${b.numero||'ORC-'+b.id.slice(0,6)} · ${b.client_data?.nome||'Sem cliente'}</div><div class="list-meta">R$ ${parseFloat(b.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2})} · ${new Date(b.created_at).toLocaleDateString('pt-BR')}</div></div>
            <div class="list-right"><button class="btn btn-sm" onclick="carregarOrcSalvo('${b.id}')">Carregar</button><button class="btn btn-sm" onclick="excluirOrcSalvo('${b.id}')" style="color:var(--danger)">🗑</button></div>
          </div>
        `).join('')}
      </div>`:''}
    </div>

    <div>
      <div class="card" style="position:sticky;top:0">
        <div class="card-header"><div class="card-title">Preview & Total</div><span class="badge b-default">PDF</span></div>
        <div style="background:var(--surface-2);padding:18px;border-radius:10px;border:1px solid var(--border)">
          <div style="display:flex;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--border)">
            <div class="brand-logo">i1</div>
            <div><div style="font-weight:700">IMPULSE ONE</div><div class="text-xs text-3">Orçamento — ${new Date(orcamento.data||Date.now()).toLocaleDateString('pt-BR')}</div></div>
          </div>
          <div style="margin:14px 0"><div class="info-label">Cliente</div><div style="font-size:14px;font-weight:600">${cliNome||'Selecione o cliente'}</div></div>
          <div class="info-label">Itens</div>
          ${orcamento.itens.length===0?'<div class="text-mu text-sm">Nenhum item adicionado</div>':orcamento.itens.map(s=>`<div style="padding:6px 0;border-bottom:1px solid var(--border);font-size:12.5px"><div style="display:flex;justify-content:space-between"><span>${(s.qtd||1)>1?(s.qtd+'x '):''}${s.desc}</span><strong>R$ ${((s.valor||0)*(s.qtd||1)).toLocaleString('pt-BR',{minimumFractionDigits:2})}</strong></div>${s.descricao?'<div class="text-xs text-3" style="margin-top:3px;line-height:1.4">'+s.descricao+'</div>':''}</div>`).join('')}
          <div id="orcTotalsBox">
            <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:13px"><span>Subtotal</span><span>R$ ${subtotal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
            ${descontoVal>0?`<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:13px;color:var(--danger-text)"><span>Desconto</span><span>− R$ ${descontoVal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>`:''}
            <div style="display:flex;justify-content:space-between;padding:10px 0 0;border-top:1px solid var(--border);margin-top:5px;font-size:16px;font-weight:700"><span>Total</span><span style="color:var(--success-text)">R$ ${total.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
          </div>
          ${(orcamento.prazoEntrega||orcamento.formaPagamento)?`<div class="text-xs text-3 mt-3">${orcamento.prazoEntrega?'Prazo: '+orcamento.prazoEntrega:''}${(orcamento.prazoEntrega&&orcamento.formaPagamento)?' · ':''}${orcamento.formaPagamento||''}</div>`:''}
          ${orcamento.observacoes?`<div class="text-xs text-mu mt-3" style="padding:10px;background:var(--surface);border-radius:6px"><strong>Obs:</strong> ${orcamento.observacoes}</div>`:''}
        </div>
        <div style="display:flex;gap:7px;margin-top:14px;flex-direction:column">
          <button class="btn btn-primary" onclick="gerarPDFOrcamento()">📄 Gerar PDF</button>
          <button class="btn" onclick="salvarOrcamento()">💾 Salvar</button>
          <button class="btn" onclick="enviarOrcWhats()">💬 Enviar no WhatsApp</button>
          <button class="btn" onclick="(async () => { if(await confirmDelete('orçamento completo (limpar)')){limparOrcamento()} })()">🗑 Limpar</button>
        </div>
      </div>
    </div>
  </div>`;
}


function orcValidaDesconto(input){
  if(!input) return;
  let v = parseFloat(input.value) || 0;
  if(v < 0) v = 0;
  if(v > 100) v = 100;
  orcamento.desconto = v;
  orcamento.descontoTipo = 'percentual';
  updateOrcTotals();
}
window.orcValidaDesconto = orcValidaDesconto;

async function orcExigirAprovacaoDesconto(){
  const pct = parseFloat(orcamento.desconto) || 0;
  if(pct <= 10) return true;
  if(!window._desbloqueios) window._desbloqueios = {};
  if(window._desbloqueios.orcDesconto) return true;
  const ok = await pedirSenhaRestrita('Esse orçamento tem ' + pct + '% de desconto. Acima de 10% precisa de aprovação dos gestores. Digite a senha de autorização.');
  if(!ok){
    toast('Aprovação cancelada — operação abortada','info');
    return false;
  }
  window._desbloqueios.orcDesconto = true;
  return true;
}
window.orcExigirAprovacaoDesconto = orcExigirAprovacaoDesconto;

async function orcAddServicoModal(){
  if(!_precifConfig || !_precifProdutos.length){
    try { await loadPrecificacao(); } catch(e){}
  }
  if(!_precifConfig){ toast('Precificacao nao carregada. Rode o SQL 51.','info'); return; }
  let modal = document.getElementById('orcAddSrvModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'orcAddSrvModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto';
  modal.onclick = (e) => { if(e.target === modal) modal.remove(); };
  const cfg = _precifConfig;
  const mM = parseFloat(cfg.margem_m)||70;
  const mG = parseFloat(cfg.margem_g)||100;
  const mGG = parseFloat(cfg.margem_gg)||200;
  const produtosOpts = _precifProdutos.filter(p => p.ativo !== false).map(p => '<option value="' + p.id + '">' + escapeHtml(p.produto) + '</option>').join('');
  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:560px;width:100%;padding:24px;max-height:90vh;overflow:auto">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">' +
        '<div style="font-size:16px;font-weight:700">➕ Adicionar serviço ao orçamento</div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'orcAddSrvModal\').remove()" style="font-size:20px">×</button>' +
      '</div>' +
      '<div style="display:flex;gap:6px;margin-bottom:14px">' +
        '<button class="filter-chip active" id="orcAddTabProd" onclick="orcAddSwitchTab(\'prod\')">📦 Da tabela</button>' +
        '<button class="filter-chip" id="orcAddTabCustom" onclick="orcAddSwitchTab(\'custom\')">✏️ Personalizado</button>' +
      '</div>' +
      '<div id="orcAddPaneProd" style="display:block">' +
        '<div class="info-label">Produto</div>' +
        '<select id="orcAddProd" onchange="orcAddCalcular();orcAddCarregaDescricao()" class="login-input" style="background:var(--surface-2);margin-bottom:10px"><option value="">— Selecione —</option>' + produtosOpts + '</select>' +
        '<div class="info-label">Faixa</div>' +
        '<div style="display:flex;gap:8px;margin-bottom:14px">' +
          '<label style="flex:1;display:flex;align-items:center;gap:5px;padding:9px;background:var(--surface-2);border-radius:8px;cursor:pointer;font-size:12px"><input type="radio" name="orcAddFaixa" value="m" onchange="orcAddCalcular()" /> M (+' + mM + '%)</label>' +
          '<label style="flex:1;display:flex;align-items:center;gap:5px;padding:9px;background:var(--surface-2);border-radius:8px;cursor:pointer;font-size:12px"><input type="radio" name="orcAddFaixa" value="g" checked onchange="orcAddCalcular()" /> G (+' + mG + '%)</label>' +
          '<label style="flex:1;display:flex;align-items:center;gap:5px;padding:9px;background:var(--surface-2);border-radius:8px;cursor:pointer;font-size:12px"><input type="radio" name="orcAddFaixa" value="gg" onchange="orcAddCalcular()" /> GG (+' + mGG + '%)</label>' +
        '</div>' +
        '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px">' +
          '<div class="info-label">📝 Descrição do serviço (escopo / o que está incluso)</div>' +
          '<button type="button" id="orcAddSaveDescBtn" onclick="orcAddSalvarDescricaoProduto()" style="background:transparent;border:1px solid var(--accent);color:var(--accent);border-radius:6px;padding:4px 10px;font-size:10.5px;cursor:pointer;font-weight:600;display:none">💾 Salvar pro futuro</button>' +
        '</div>' +
        '<textarea id="orcAddDescProd" placeholder="Descreva o escopo do serviço — entregáveis, periodicidade, observações..." class="login-input" rows="3" style="background:var(--surface-2);margin-bottom:10px;resize:vertical;min-height:70px;font-family:inherit"></textarea>' +
        '<div class="text-xs text-3" style="margin-top:-6px;margin-bottom:10px">💡 Salvando, a descrição aparece automaticamente nos próximos orçamentos desse produto</div>' +
      '</div>' +
      '<div id="orcAddPaneCustom" style="display:none">' +
        '<div class="info-label">Descrição</div>' +
        '<input type="text" id="orcAddDesc" placeholder="Descreva o serviço..." class="login-input" style="background:var(--surface-2);margin-bottom:10px" />' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">' +
          '<div><div class="info-label">Horas</div><input type="number" id="orcAddHoras" value="1" step="0.5" oninput="orcAddCalcular()" class="login-input" style="background:var(--surface-2);text-align:center" /></div>' +
          '<div><div class="info-label">Faixa</div><select id="orcAddFaixaCustom" onchange="orcAddCalcular()" class="login-input" style="background:var(--surface-2)"><option value="m">M (+' + mM + '%)</option><option value="g" selected>G (+' + mG + '%)</option><option value="gg">GG (+' + mGG + '%)</option></select></div>' +
        '</div>' +
        '<div class="info-label">📝 Descrição (opcional)</div>' +
        '<textarea id="orcAddDescCustom" placeholder="Escopo, entregáveis, observações..." class="login-input" rows="3" style="background:var(--surface-2);margin-bottom:10px;resize:vertical;min-height:70px;font-family:inherit"></textarea>' +
      '</div>' +
      '<div style="background:var(--surface-2);padding:14px;border-radius:9px;text-align:center;margin-bottom:14px">' +
        '<div class="text-xs text-3">Valor calculado</div>' +
        '<div id="orcAddPreview" style="font-size:22px;font-weight:800;color:var(--text);margin-top:4px">R$ 0,00</div>' +
      '</div>' +
      '<div style="display:flex;gap:8px;justify-content:flex-end">' +
        '<button class="btn" onclick="document.getElementById(\'orcAddSrvModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" onclick="orcAddConfirmar()">+ Adicionar ao orçamento</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}
window.orcAddServicoModal = orcAddServicoModal;


function orcAddCarregaDescricao(){
  const prodId = document.getElementById('orcAddProd')?.value;
  const ta = document.getElementById('orcAddDescProd');
  const btn = document.getElementById('orcAddSaveDescBtn');
  if(!ta) return;
  if(!prodId){ ta.value=''; if(btn) btn.style.display='none'; return; }
  const p = _precifProdutos.find(x => x.id === prodId);
  ta.value = (p && p.descricao) || '';
  if(btn) btn.style.display = 'inline-block';
}
window.orcAddCarregaDescricao = orcAddCarregaDescricao;

async function orcAddSalvarDescricaoProduto(){
  const prodId = document.getElementById('orcAddProd')?.value;
  if(!prodId){ toast('Selecione um produto primeiro','info'); return; }
  if(!_supa){ toast('Supabase necessário','info'); return; }
  const ta = document.getElementById('orcAddDescProd');
  const desc = ta ? ta.value : '';
  const btn = document.getElementById('orcAddSaveDescBtn');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Salvando...'; }
  const { error } = await _supa.from('precificacao_produtos').update({descricao: desc}).eq('id', prodId);
  if(error){
    toast('Erro: ' + (error.message||error), 'info');
    if(btn){ btn.disabled = false; btn.textContent = '💾 Salvar pro futuro'; }
    if(String(error.message||'').includes('column') && String(error.message||'').includes('descricao')){
      toast('⚠ Rode o SQL 54-precificacao-descricao.sql', 'info');
    }
    return;
  }
  const p = _precifProdutos.find(x => x.id === prodId);
  if(p) p.descricao = desc;
  toast('✓ Descrição salva — vai aparecer nos próximos orçamentos','success');
  if(btn){ btn.disabled = false; btn.textContent = '✓ Salvo'; setTimeout(()=>{ btn.textContent='💾 Salvar pro futuro'; }, 2500); }
}
window.orcAddSalvarDescricaoProduto = orcAddSalvarDescricaoProduto;

function orcAddSwitchTab(tab){
  document.getElementById('orcAddPaneProd').style.display = tab === 'prod' ? 'block' : 'none';
  document.getElementById('orcAddPaneCustom').style.display = tab === 'custom' ? 'block' : 'none';
  document.getElementById('orcAddTabProd').classList.toggle('active', tab === 'prod');
  document.getElementById('orcAddTabCustom').classList.toggle('active', tab === 'custom');
  window._orcAddTab = tab;
  orcAddCalcular();
}
window.orcAddSwitchTab = orcAddSwitchTab;

function orcAddCalcular(){
  if(!_precifConfig) return;
  const cfg = _precifConfig;
  const totCusto = (parseFloat(cfg.pessoas_custo)||0) + (parseFloat(cfg.custo_fixo_variavel)||0);
  const vh = cfg.horas_trabalhadas > 0 ? (totCusto / cfg.horas_trabalhadas) : 0;
  const tab = window._orcAddTab || 'prod';
  let valor = 0;
  if(tab === 'prod'){
    const prodId = document.getElementById('orcAddProd')?.value;
    const p = _precifProdutos.find(x => x.id === prodId);
    if(p){
      const horas = parseFloat(p.horas_estimadas) || 0;
      const custo = horas * vh;
      const faixaEl = document.querySelector('input[name="orcAddFaixa"]:checked');
      const faixa = faixaEl ? faixaEl.value : 'g';
      const margem = faixa === 'm' ? (parseFloat(cfg.margem_m)||70) : (faixa === 'gg' ? (parseFloat(cfg.margem_gg)||200) : (parseFloat(cfg.margem_g)||100));
      const override = p['preco_'+faixa+'_override'];
      valor = override != null ? override : _precifArredonda90(custo * (1 + margem/100));
    }
  } else {
    const horas = parseFloat(document.getElementById('orcAddHoras')?.value) || 0;
    const faixa = document.getElementById('orcAddFaixaCustom')?.value || 'g';
    const margem = faixa === 'm' ? (parseFloat(cfg.margem_m)||70) : (faixa === 'gg' ? (parseFloat(cfg.margem_gg)||200) : (parseFloat(cfg.margem_g)||100));
    valor = _precifArredonda90(horas * vh * (1 + margem/100));
  }
  const out = document.getElementById('orcAddPreview');
  if(out) out.textContent = _precifFmt(valor);
  window._orcAddValor = valor;
}
window.orcAddCalcular = orcAddCalcular;

function orcAddConfirmar(){
  const tab = window._orcAddTab || 'prod';
  const valor = window._orcAddValor || 0;
  if(valor <= 0){ toast('Selecione um produto ou defina horas','info'); return; }
  let descLabel = '';
  let isCustom = false;
  let descricaoEscopo = '';
  if(tab === 'prod'){
    const prodId = document.getElementById('orcAddProd').value;
    const p = _precifProdutos.find(x => x.id === prodId);
    if(!p){ toast('Selecione um produto','info'); return; }
    descLabel = p.produto;
    const taProd = document.getElementById('orcAddDescProd');
    descricaoEscopo = taProd ? taProd.value.trim() : (p.descricao||'');
    // Auto-salva descrição no produto se mudou (persiste para próximos orçamentos)
    if(descricaoEscopo && descricaoEscopo !== (p.descricao||'').trim()){
      p.descricao = descricaoEscopo;
      if(_supa) _supa.from('precificacao_produtos').update({descricao: descricaoEscopo}).eq('id', prodId).then(r => {
        if(r.error) console.warn('[orcAddConfirmar] auto-save descricao:', r.error);
      });
    }
  } else {
    const desc = document.getElementById('orcAddDesc').value.trim();
    if(!desc){ toast('Informe a descricao','info'); return; }
    descLabel = desc;
    isCustom = true;
    const taCust = document.getElementById('orcAddDescCustom');
    descricaoEscopo = taCust ? taCust.value.trim() : '';
  }
  if(!Array.isArray(orcamento.itens)) orcamento.itens = [];
  orcamento.itens.push({desc: descLabel, descricao: descricaoEscopo, qtd: 1, valor: valor, custom: isCustom});
  toast('✓ Adicionado ao orçamento','success');
  document.getElementById('orcAddSrvModal').remove();
  renderComercial(document.getElementById('content'));
}
window.orcAddConfirmar = orcAddConfirmar;

function updateOrcTotals(){
  // Re-renderiza só o preview (mantém foco nos inputs)
  const subtotal = orcamento.itens.reduce((s,x)=>s+(x.qtd||1)*x.valor,0);
  const descontoVal = orcamento.descontoTipo==='percentual' ? subtotal*(orcamento.desconto/100) : orcamento.desconto;
  const total = Math.max(0, subtotal - descontoVal);
  const box = document.getElementById('orcTotalsBox');
  if(box){
    box.innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:13px"><span>Subtotal</span><span>R$ ${subtotal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
      ${descontoVal>0?`<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:13px;color:var(--danger-text)"><span>Desconto</span><span>− R$ ${descontoVal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>`:''}
      <div style="display:flex;justify-content:space-between;padding:10px 0 0;border-top:1px solid var(--border);margin-top:5px;font-size:16px;font-weight:700"><span>Total</span><span style="color:var(--success-text)">R$ ${total.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
    `;
  }
}

function addServicoPersonalizado(){
  orcamento.itens.push({desc:'Serviço personalizado', qtd:1, valor:0, custom:true});
  renderComercial(document.getElementById('content'));
}

// Toggle visibilidade do textarea de descricao do servico
function toggleDescServico(servId){
  const box = document.getElementById('descBox-' + servId);
  if(!box) return;
  const aberto = box.style.display !== 'none';
  box.style.display = aberto ? 'none' : 'block';
  if(!aberto){
    setTimeout(() => { const tx = document.getElementById('descTxt-' + servId); if(tx) tx.focus(); }, 50);
  }
}

// Salva descricao no servico (local + banco se aplicavel)
async function salvarDescricaoServico(servId, descricao){
  // Atualiza local
  if(typeof _budgetServices !== 'undefined' && Array.isArray(_budgetServices)){
    const s = _budgetServices.find(x => x.id === servId);
    if(s) s.description = descricao || '';
  }
  // Atualiza descricao nos itens ja selecionados
  if(typeof orcamento !== 'undefined' && orcamento && Array.isArray(orcamento.itens)){
    const s = (_budgetServices||[]).find(x => x.id === servId);
    if(s){
      orcamento.itens.forEach(it => { if(it.desc === s.name) it.descricao = descricao || ''; });
    }
  }
  // Cache localStorage
  try {
    const cache = JSON.parse(localStorage.getItem('budgetServicesCache')||'{}');
    cache[servId] = cache[servId] || {};
    cache[servId].description = descricao || '';
    localStorage.setItem('budgetServicesCache', JSON.stringify(cache));
  } catch(e){}
  // Salva no banco
  if(typeof _supa !== 'undefined' && _supa){
    const r = await _supa.from('budget_services').update({description: descricao || null}).eq('id', servId);
    if(r.error){
      if(r.error.code === '42703' || (r.error.message||'').includes('column')){
        toast('⚠ Rode o SQL: alter table budget_services add column description text','info');
      } else {
        console.warn('[salvarDescricaoServico]', r.error);
      }
    }
  }
}

// Carrega descricoes do localStorage se nao tiver no objeto (fallback)
function _aplicarDescricoesCache(lista){
  if(!Array.isArray(lista)) return;
  try {
    const cache = JSON.parse(localStorage.getItem('budgetServicesCache')||'{}');
    lista.forEach(s => {
      if(!s.description && cache[s.id] && cache[s.id].description){
        s.description = cache[s.id].description;
      }
    });
  } catch(e){}
}

function toggleOrcServ(id){
  const item = _budgetServices.find(s=>s.id===id);
  if(!item){
    // fallback mock
    const fallback = [{id:'m1',name:'Gestão de rede social',value:1800},{id:'m2',name:'Design fixo',value:1200},{id:'m3',name:'Tráfego pago',value:2200},{id:'m4',name:'Vídeos',value:1800},{id:'m5',name:'Captação',value:2500},{id:'m6',name:'Branding',value:4500},{id:'m7',name:'Campanhas',value:3200},{id:'m8',name:'Consultoria',value:1500}];
    const f = fallback.find(s=>s.id===id);
    if(!f) return;
    item = f;
  }
  const realItem = item;
  const idx = orcamento.itens.findIndex(x=>x.desc===realItem.name && !x.custom);
  if(idx>=0) orcamento.itens.splice(idx,1);
  else orcamento.itens.push({desc:realItem.name, qtd:1, valor:parseFloat(realItem.value), descricao: (realItem.description || realItem.descricao || '')});
  renderComercial(document.getElementById('content'));
}

function selecionarClienteOrc(val){
  console.log('[ORC] cliente selecionado:', val);
  if(!val || val === ''){
    orcamento.cliente = {nome:'', cnpj:'', endereco:'', email:'', telefone:'', logo:''};
  } else if(val === '__manual__'){
    orcamento.cliente = {nome:'Novo cliente (editar)', cnpj:'', endereco:'', email:'', telefone:'', logo:''};
  } else if(val === '__novo__'){
    abrirGerenciarClientes();
    return;
  } else if(val.startsWith('crm:')){
    const id = parseInt(val.slice(4));
    const cli = (clients||[]).find(c=>c.id===id);
    if(cli){
      orcamento.cliente = {nome: cli.name, cnpj:'', endereco:'', email: cli.email||'', telefone: cli.phone||'', logo:''};
      console.log('[ORC] cliente CRM importado:', cli.name);
    } else {
      toast('Cliente nao encontrado','info');
    }
  } else if(val.startsWith('bg:')){
    const id = val.slice(3);
    const cli = (_budgetClients||[]).find(c=>c.id===id);
    if(cli) orcamento.cliente = {nome: cli.name, cnpj: cli.cnpj||'', endereco: cli.address||'', email: cli.email||'', telefone: cli.phone||'', logo:''};
  }
  renderComercial(document.getElementById('content'));
}

function abrirGerenciarServicos(){
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700">⚙️</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">Serviços padrão</div><div class="text-xs text-3" style="margin-top:3px">Edite valores, adicione novos serviços ou desative os antigos</div></div>
      <button class="modal-close" onclick="closeModal();renderComercial(document.getElementById('content'))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div id="servListMgr">
        ${_budgetServices.map(s=>`
          <div class="card mb-2" style="padding:12px" id="servrow-${s.id}">
            <div style="display:grid;grid-template-columns:2fr 130px auto;gap:8px;align-items:center;margin-bottom:8px">
              <input class="cron-obs-input" value="${s.name}" onblur="updateBudgetServ('${s.id}','name',this.value)" placeholder="Nome do serviço" style="background:var(--surface-2);font-size:13px;padding:8px 10px;font-weight:600" />
              <input class="cron-obs-input" type="number" step="0.01" value="${s.value}" onblur="updateBudgetServ('${s.id}','value',parseFloat(this.value)||0)" placeholder="Valor" style="background:var(--surface-2);font-size:13px;padding:8px 10px;text-align:right" />
              <button class="icon-btn" style="color:var(--danger);width:32px;height:32px" onclick="deleteBudgetServ('${s.id}')" title="Excluir"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>
            </div>
            <div class="text-xs text-3" style="margin-bottom:4px;font-weight:600">📝 Descrição (vai aparecer no orçamento e no PDF)</div>
            <textarea class="cron-obs-input" onblur="updateBudgetServ('${s.id}','description',this.value)" placeholder="Ex: 12 posts/mês no feed, Stories diários, gestão completa, relatório mensal..." style="background:var(--surface-2);font-size:12.5px;padding:8px 10px;width:100%;resize:vertical;min-height:60px;font-family:inherit;color:var(--text);border:1px solid var(--border);border-radius:6px">${(s.description||'').replace(/</g,'&lt;')}</textarea>
          </div>
        `).join('')}
      </div>
      <div class="card mt-3" style="background:var(--surface-2);padding:14px">
        <div class="card-title" style="margin-bottom:10px">+ Adicionar novo serviço</div>
        <div style="display:grid;grid-template-columns:2fr 130px auto;gap:8px;margin-bottom:8px">
          <input id="newServName" class="login-input" placeholder="Nome (ex: Edição de vídeos)" style="background:var(--surface)" />
          <input id="newServValue" class="login-input" type="number" step="0.01" placeholder="Valor (R$)" style="background:var(--surface);text-align:right" />
          <button class="btn btn-primary" onclick="addBudgetServ()">+ Adicionar</button>
        </div>
        <textarea id="newServDesc" class="login-input" placeholder="Descrição do serviço (opcional)..." style="background:var(--surface);min-height:50px;resize:vertical;font-family:inherit"></textarea>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function updateBudgetServ(id, field, value){
  const s = _budgetServices.find(x=>x.id===id);
  if(s) s[field] = value;
  // Cache localStorage pra fallback
  try {
    const cache = JSON.parse(localStorage.getItem('budgetServicesCache')||'{}');
    cache[id] = cache[id] || {};
    cache[id][field] = value;
    localStorage.setItem('budgetServicesCache', JSON.stringify(cache));
  } catch(e){}
  if(!_supa){ toast('Salvo local (sem banco)','info'); return; }
  const { error } = await _supa.from('budget_services').update({[field]:value}).eq('id', id);
  if(error){
    if(error.code === '42703' || (error.message||'').includes('column')){
      if(field === 'description'){
        toast('⚠ Rode o SQL: alter table budget_services add column description text','info');
      } else {
        toast('Erro: campo '+field+' nao existe no banco','info');
      }
    } else {
      toast('Erro: '+error.message,'info');
    }
    return;
  }
  toast('✓ '+ (field==='description'?'Descricao':'Campo') + ' salvo','success');
}

async function deleteBudgetServ(id){
  if(!(await confirmDelete('serviço da lista padrão'))) return;
  if(_supa) await _supa.from('budget_services').delete().eq('id', id);
  _budgetServices = _budgetServices.filter(x=>x.id!==id);
  document.getElementById('servrow-'+id)?.remove();
  toast('Serviço excluído','success');
}

async function addBudgetServ(){
  const name = document.getElementById('newServName').value.trim();
  const value = parseFloat(document.getElementById('newServValue').value) || 0;
  const description = (document.getElementById('newServDesc')?.value||'').trim() || null;
  if(!name){toast('Informe o nome','info');return}
  if(!_supa){toast('Banco necessário','info');return}
  // Tenta inserir com descricao; se a coluna nao existe, insere sem
  let r = await _supa.from('budget_services').insert({name, value, description, position: _budgetServices.length+1}).select().single();
  if(r.error && (r.error.code === '42703' || (r.error.message||'').includes('column'))){
    toast('⚠ Coluna description nao existe — salvando sem descricao. Rode o SQL pra ativar.','info');
    r = await _supa.from('budget_services').insert({name, value, position: _budgetServices.length+1}).select().single();
  }
  if(r.error){ toast('Erro: '+r.error.message,'info'); return; }
  if(r.data){
    if(description && !r.data.description) r.data.description = description;
    _budgetServices.push(r.data);
    toast('✓ Servico adicionado','success');
    abrirGerenciarServicos();
  }
}

