}

async function loadTransactions(){
  if(!_supa) return [];
  const { data } = await _supa.from('transactions').select('*').order('date',{ascending:false}).limit(50);
  return data || [];
}

// ============ FINANCEIRO ============
function renderFinanceiro(c){
  // Restrição: só gestor/admin
  if(!isGestor()){
    c.innerHTML = `<div class="page active"><div class="empty-state" style="padding:80px 20px"><div class="ico">🔒</div><div class="ttl">Acesso restrito</div><div class="desc">A aba Financeiro é visível apenas para gestores e administradores.</div></div></div>`;
    return;
  }
  const totalMrr = clients.reduce((s,c)=>s+c.mrr,0);
  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div><div class="page-title">Financeiro</div><div class="page-subtitle">Visão consolidada · maio/2026</div></div>
        <div class="page-actions">
          ${searchBar('Buscar transação...','.card table')}<button class="btn" onclick="openNovaTransacaoModal('out')">💸 Nova despesa</button>
          <button class="btn">💸 Nova despesa</button>
          <button class="btn btn-primary" onclick="openNovaTransacaoModal('in')">+ Nova cobrança</button>
        </div>
      </div>
      <div class="stat-grid">
        ${statCard('Faturamento mês','R$ '+totalMrr.toLocaleString('pt-BR'),`${clients.length} clientes`,'M22 12h-4l-3 9L9 3l-3 9H2')}
        ${statCard('Despesas mês','R$ 0','Cadastre despesas','M5 12h14')}
        ${statCard('Lucro líquido','R$ '+totalMrr.toLocaleString('pt-BR'),'Sem despesas','M12 1v22')}
        ${statCard('A receber','R$ 0','Sem cobranças','M12 8v4l3 3')}
        ${statCard('Inadimplência','R$ 0','—','M12 9v4')}
        ${statCard('MRR total','R$ '+totalMrr.toLocaleString('pt-BR'),`${clients.length} contratos`,'M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0')}
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-header"><div class="card-title">Fluxo de caixa — 12 meses</div></div>
          <div class="chart-box"><canvas id="cashChart"></canvas></div>
        </div>
        <div class="card">
          <div class="card-header"><div class="card-title">Categorias de despesa</div></div>
          <div class="chart-box"><canvas id="expChart"></canvas></div>
        </div>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-header"><div class="card-title">DRE simplificado</div></div>
          <table class="table">
            <tbody>
              <tr><td>Receita bruta</td><td style="text-align:right"><strong>R$ ${totalMrr.toLocaleString('pt-BR')}</strong></td></tr>
              <tr><td class="text-mu">(–) Impostos (Simples 6%)</td><td style="text-align:right;color:var(--danger-text)">R$ ${Math.round(totalMrr*.06).toLocaleString('pt-BR')}</td></tr>
              <tr><td><strong>Receita líquida</strong></td><td style="text-align:right"><strong>R$ ${Math.round(totalMrr*.94).toLocaleString('pt-BR')}</strong></td></tr>
              <tr><td class="text-mu">(–) Salários e PJs</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
              <tr><td class="text-mu">(–) Ferramentas/SaaS</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
              <tr><td class="text-mu">(–) Tráfego pago</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
              <tr><td class="text-mu">(–) Outras despesas</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
              <tr style="background:var(--surface-2)"><td><strong>Lucro líquido</strong></td><td style="text-align:right;color:var(--success-text)"><strong>R$ ${Math.round((totalMrr-24560)*0.85).toLocaleString('pt-BR')}</strong></td></tr>
            </tbody>
          </table>
        </div>
        <div class="card">
          <div class="card-header"><div class="card-title">Próximos vencimentos</div></div>
          ${clients.slice(0,7).map(cli=>`
            <div class="list-item">
              <div class="list-icon" style="background:${cli.color}1a;color:${cli.color}">${cli.init}</div>
              <div class="list-content"><div class="list-title">${cli.name}</div><div class="list-meta">Vence em ${20+Math.floor(Math.random()*10)} mai</div></div>
              <div class="list-right"><strong>R$ ${cli.mrr.toLocaleString('pt-BR')}</strong><div>${cli.status==='late'?'<span class="badge b-danger">Atrasado</span>':'<span class="badge b-warning">Pendente</span>'}</div></div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
  `;
  drawCashChart();drawExpChart();
}
function drawCashChart(){
  const ctx=document.getElementById('cashChart');if(!ctx)return;
  const isDark=document.documentElement.getAttribute('data-theme')==='dark';
  const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';
  new Chart(ctx,{type:'bar',
    data:{labels:['Jun','Jul','Ago','Set','Out','Nov','Dez','Jan','Fev','Mar','Abr','Mai'],
      datasets:[
        {label:'Entradas',data:[58,62,66,60,70,76,84,78,82,88,92,87],backgroundColor:isDark?'#f5f5f7':'#1d1d1f',borderRadius:4,barPercentage:.6},
        {label:'Saídas',data:[28,29,30,29,31,32,34,32,33,34,35,24.5],backgroundColor:isDark?'#3a3a44':'#d2d2d7',borderRadius:4,barPercentage:.6},
      ]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:8}}},
      scales:{x:{grid:{display:false},ticks:{color:txtCol}},y:{grid:{color:gridCol},ticks:{color:txtCol,callback:v=>'R$ '+v+'k'}}}}
  });
}
function drawExpChart(){
  const ctx=document.getElementById('expChart');if(!ctx)return;
  const isDark=document.documentElement.getAttribute('data-theme')==='dark';
  const txtCol=isDark?'#9595a0':'#6e6e73';
  new Chart(ctx,{type:'doughnut',
    data:{labels:['Equipe','Tráfego','Ferramentas','Impostos','Outras'],
      datasets:[{data:[16200,4500,1860,5220,2000],backgroundColor:['#1d1d1f','#7c3aed','#0ea5e9','#f59e0b','#a1a1a6'],borderColor:isDark?'#141417':'#fff',borderWidth:3}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'68%',
      plugins:{legend:{position:'right',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:10}}}}
  });
}
// ============ OPERACIONAL ============
let _operacionalJaAberto = false;
let currentCollab = 'Éllen';
let opView = 'checklist'; // 'checklist' | 'kanban'
let _showColleagueTabs = false;  // mostra os tabs de outros colaboradores?

// Devolve o nome do usuario logado e cria a entrada em dailyChecklists se necessario
function getMeuChecklistNome(){
  let candidatos = [];
  try {
    if(_currentProfile && _currentProfile.name){
      const completo = String(_currentProfile.name).trim();
      candidatos.push(completo.split(/\s+/)[0]);  // primeiro nome
      candidatos.push(completo.replace(/\s*\([^)]*\)\s*/g,'').trim().split(/\s+/)[0]); // sem parenteses
      candidatos.push(completo);
    }
    if(_currentUser && _currentUser.email){
      const local = _currentUser.email.split('@')[0];
      candidatos.push(local.charAt(0).toUpperCase() + local.slice(1));
      candidatos.push(local);
    }
  } catch(e){}
  // tenta match exato ou prefixo case-insensitive
  if(typeof dailyChecklists === 'undefined') return null;
  for(const c of candidatos){
    if(!c) continue;
    if(dailyChecklists[c]) return c;
    const match = Object.keys(dailyChecklists).find(n => n.toLowerCase() === c.toLowerCase() || n.toLowerCase().startsWith(c.toLowerCase()) || c.toLowerCase().startsWith(n.toLowerCase()));
    if(match) return match;
  }
  // Nao achou - CRIA uma entrada nova pro usuario logado
  const meuNome = candidatos.find(c => c) || 'Eu';
  if(!dailyChecklists[meuNome]) dailyChecklists[meuNome] = [];
  return meuNome;
}

// Retorna o objeto "member" do usuario logado, usando profile/email se nao tiver no team
function getMeuMember(){
  try {
    if(_currentProfile){
      const nome = _currentProfile.name || _currentProfile.full_name || '';
      const found = (team||[]).find(t => t._dbId === _currentProfile.id || (t.name||'').toLowerCase() === nome.toLowerCase() || (nome||'').toLowerCase().startsWith((t.name||'').toLowerCase().split(' ')[0]));
      if(found) return found;
      return {
        name: nome || (_currentUser?.email||'').split('@')[0],
        role: _currentProfile.role || _currentProfile.cargo || _currentProfile.position || '',
        init: (nome || 'E')[0].toUpperCase(),
        color: '#a855f7'
      };
    }
  } catch(e){}
  return null;
}

// Garante que ao abrir Operacional, o currentCollab seja o do usuario logado
function priorizarMeuChecklist(){
  const meu = getMeuChecklistNome();
  if(meu) currentCollab = meu;
}
function toggleVerColegas(){
  _showColleagueTabs = !_showColleagueTabs;
  renderOperacional(document.getElementById('content'));
}
function abrirChecklistDe(nome){
  currentCollab = nome;
  _showColleagueTabs = false;
  renderOperacional(document.getElementById('content'));
}

function renderOperacional(c){
  // Na primeira vez na aba, prioriza o checklist do proprio usuario
  if(!_operacionalJaAberto){ priorizarMeuChecklist(); _operacionalJaAberto = true; }
  const totalTasks = Object.values(dailyChecklists).flat().length;
  const doneTasks = Object.values(dailyChecklists).flat().filter(t=>t.done).length;
  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Checklist</div>
          <div class="page-subtitle">${totalTasks} tarefas · ${doneTasks} concluídas · ${totalTasks-doneTasks} pendentes</div>
        </div>
        <div class="page-actions">
          <div style="display:flex;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:3px">
            <button class="btn ${opView==='checklist'?'btn-primary':''}" style="border:none;padding:5px 11px" onclick="opView='checklist';renderOperacional(document.getElementById('content'))">Checklists</button>
            <button class="btn ${opView==='kanban'?'btn-primary':''}" style="border:none;padding:5px 11px" onclick="opView='kanban';renderOperacional(document.getElementById('content'))">Kanban</button>
          </div>
          ${searchBar('Buscar tarefa, cliente, colaborador...','.kanban, .grid-2e')}<button class="btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>Histórico</button>
          <button class="btn btn-primary" onclick="openNovaTarefaModal()">+ Nova tarefa</button>
        </div>
      </div>

      ${opView==='checklist'?renderChecklistView():renderKanbanView()}
    </div>
  `;
}

function renderChecklistView(){
  const today = new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'});
  const collabList = Object.keys(dailyChecklists);
  const currentList = dailyChecklists[currentCollab]||[];
  const doneCount = currentList.filter(t=>t.done).length;
  const pct = currentList.length?Math.round(doneCount/currentList.length*100):0;
  const meuNomeRef = getMeuChecklistNome();
  // Se estou vendo MEU checklist, usar info do meu profile
  let member;
  if(currentCollab === meuNomeRef){
    member = getMeuMember() || team.find(t=>t.name.startsWith(currentCollab)) || team[0] || {name:currentCollab, role:'', init:currentCollab[0], color:'#a855f7'};
  } else {
    member = team.find(t=>t.name.startsWith(currentCollab)) || {name:currentCollab, role:'', init:currentCollab[0], color:'#888'};
  }

  return `
    <div class="text-xs text-3 mb-3">📅 ${today.charAt(0).toUpperCase()+today.slice(1)} · Checklists gerados automaticamente às 06:00</div>

    ${(() => {
      const meuNome = getMeuChecklistNome();
      const ehMeuChecklist = currentCollab === meuNome;
      const outros = collabList.filter(n => n !== meuNome);
      return `
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap">
          ${meuNome ? `
            <button onclick="abrirChecklistDe('${meuNome.replace(/'/g,"\'")}')" style="display:flex;align-items:center;gap:8px;padding:8px 14px;border:1.5px solid ${ehMeuChecklist?'var(--accent)':'var(--border)'};background:${ehMeuChecklist?'var(--accent)':'var(--surface)'};color:${ehMeuChecklist?'#fff':'var(--text)'};border-radius:9px;cursor:pointer;font-weight:600;font-size:13px;transition:.15s">
              ${(() => { const m = team.find(t=>t.name.startsWith(meuNome))||{init:meuNome[0],color:'#888'}; return `<div class="avatar" style="background:${m.color};width:22px;height:22px;font-size:11px;border:2px solid ${ehMeuChecklist?'#fff':'transparent'}">${m.init}</div>`; })()}
              <span>Meu checklist</span>
              ${(() => { const list = dailyChecklists[meuNome]||[]; const done = list.filter(t=>t.done).length; return `<span style="font-size:11px;opacity:.85;background:${ehMeuChecklist?'rgba(255,255,255,.2)':'var(--surface-2)'};padding:1px 7px;border-radius:5px">${done}/${list.length}</span>`; })()}
            </button>` : ''}
          ${outros.length ? `
            <button onclick="toggleVerColegas()" style="display:flex;align-items:center;gap:6px;padding:8px 14px;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:9px;cursor:pointer;font-weight:500;font-size:13px;transition:.15s">
              👥 ${_showColleagueTabs ? 'Esconder colegas' : 'Ver checklists dos colegas'}
              <span style="background:var(--surface-2);padding:1px 7px;border-radius:5px;font-size:11px;opacity:.85">${outros.length}</span>
            </button>` : ''}
          ${!ehMeuChecklist && meuNome ? `
            <span class="badge b-info" style="margin-left:auto">👀 Vendo: ${currentCollab}</span>` : ''}
        </div>
        ${(_showColleagueTabs && outros.length) ? `
          <div class="collab-tabs" style="margin-bottom:14px">
            ${outros.map(name => {
              const m = team.find(t=>t.name.startsWith(name))||{init:name[0],color:'#999'};
              const list = dailyChecklists[name]||[];
              const done = list.filter(t=>t.done).length;
              return `
                <div class="collab-tab ${name===currentCollab?'active':''}" onclick="abrirChecklistDe('${name.replace(/'/g,"\'")}')">
                  <div class="avatar" style="background:${m.color};color:#fff">${m.init}</div>
                  <span>${name}</span>
                  <span style="font-size:10px;opacity:.7">${done}/${list.length}</span>
                </div>`;
            }).join('')}
          </div>` : ''}
      `;
    })()}

    <div class="filter-bar">
      <span class="filter-chip active">Hoje</span>
      <span class="filter-chip">Esta semana</span>
      <span class="filter-chip">Este mês</span>
      <span class="filter-chip">Histórico</span>
      <span style="margin-left:auto"></span>
      <span class="filter-chip">Todas</span>
      <span class="filter-chip">Urgentes</span>
      <span class="filter-chip">Pendentes</span>
      <span class="filter-chip">Concluídas</span>
    </div>

    <div class="grid-2e">
      <div>
        <div class="profile-head" style="padding:16px;margin-bottom:14px">
          <div class="profile-avatar" style="background:${member.color};width:54px;height:54px;font-size:20px">${member.init}</div>
          <div style="flex:1">
            <div style="font-size:16px;font-weight:700">${member.name||currentCollab}</div>
            <div class="text-xs text-3">${member.role||''}</div>
            <div style="margin-top:8px"><div class="meter"><div class="meter-fill" style="width:${pct}%"></div></div></div>
            <div class="text-xs text-3" style="margin-top:5px">${doneCount} de ${currentList.length} concluídas · ${pct}%</div>
          </div>
        </div>

        ${(() => {
          if(currentList.length === 0) return '<div class="card text-mu text-sm">Nenhuma tarefa para este colaborador.</div>';
          // Ordena: pendentes primeiro (por horário/prioridade), concluídas depois (mais recentes embaixo)
          const ordenadas = currentList
            .map((t,i) => ({...t, _origIdx: i}))
            .sort((a,b) => {
              if(a.done !== b.done) return a.done ? 1 : -1;  // pendentes em cima
              if(a.done){
                // Ambas concluídas: mais recente embaixo
                return (a.done_at||'').localeCompare(b.done_at||'');
              }
              // Ambas pendentes: ordena por horário
              return (a.time||'').localeCompare(b.time||'');
            });
          const pendentes = ordenadas.filter(t => !t.done);
          const concluidas = ordenadas.filter(t => t.done);
          const fmtHora = (iso) => {
            if(!iso) return '';
            try {
              return new Date(iso).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
            } catch(e){ return ''; }
          };
          const renderItem = (t) => `
            <div class="check-item ${t.done?'done':''}" onclick="openEditarTarefaModal('${currentCollab}',${t._origIdx})" title="Clique pra editar" style="cursor:pointer">
              <div class="check-box ${t.done?'checked':''}" onclick="event.stopPropagation();toggleCheck('${currentCollab}',${t._origIdx})"></div>
              <div class="check-body">
                <div class="check-title">${escapeHtml(t.t||'')}</div>
                <div class="check-meta">
                  ${prioBadge(t.p)}
                  <span>🕐 ${t.time||'—'}</span>
                  <span>📌 ${escapeHtml(t.client||'—')}</span>
                  ${t.done && t.done_at ? `<span style="color:var(--success-text);font-weight:600">✓ concluída ${fmtHora(t.done_at)}</span>` : ''}
                </div>
              </div>
            </div>
          `;
          let out = '';
          out += `<div class="text-xs text-3" style="text-transform:uppercase;letter-spacing:.05em;font-weight:600;margin:6px 0 8px">📌 PENDENTES (${pendentes.length})</div>`;
          out += pendentes.length === 0
            ? '<div class="card text-mu text-sm" style="background:var(--success-soft);color:var(--success-text)">🎉 Todas concluídas!</div>'
            : pendentes.map(renderItem).join('');
          if(concluidas.length > 0){
            out += `<div class="text-xs text-3" style="text-transform:uppercase;letter-spacing:.05em;font-weight:600;margin:14px 0 8px;opacity:.7">✅ CONCLUÍDAS (${concluidas.length})</div>`;
            out += concluidas.map(renderItem).join('');
          }
          return out;
        })()}

        <div class="kanban-add" style="margin-top:8px;cursor:pointer" onclick="openNovaTarefaModal({preset_collab:'${currentCollab}'})">+ Adicionar tarefa para ${currentCollab}</div>
      </div>

      <div>
        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📊 Resumo do dia</div></div>
          <div class="stat-grid" style="grid-template-columns:1fr 1fr">
            ${statCard('Concluídas',doneCount,'de '+currentList.length,'M9 11l3 3L22 4')}
            ${statCard('Restantes',currentList.length-doneCount,'pendentes','M12 8v4l3 3')}
          </div>
          <div style="margin-top:14px">
            <div class="text-xs text-mu mb-2">Distribuição por prioridade</div>
            ${['urgent','high','med','low'].map(p=>{
              const cnt = currentList.filter(t=>t.p===p).length;
              if(!cnt) return '';
              return `<div style="display:flex;justify-content:space-between;padding:5px 0;font-size:12px"><span>${prioBadge(p)}</span><strong>${cnt}</strong></div>`;
            }).join('')}
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📅 Esta semana</div></div>
          ${['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'].map((d,i)=>{
            const t = Math.floor(Math.random()*8)+2;
            const done = Math.floor(Math.random()*t);
            const pct = Math.round(done/t*100);
            return `<div style="display:flex;align-items:center;gap:10px;padding:6px 0">
              <span class="text-xs text-mu" style="width:30px">${d}</span>
              <div class="meter" style="flex:1"><div class="meter-fill" style="width:${pct}%"></div></div>
              <span class="text-xs text-mu" style="width:40px;text-align:right">${done}/${t}</span>
            </div>`;
          }).join('')}
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">📋 Salvamento automático</div></div>
          <div class="text-xs text-mu">Todas as alterações são salvas automaticamente. Última sincronização: <strong>agora</strong></div>
          <div class="text-xs text-3 mt-3">📂 Histórico mensal disponível em Histórico → Operacional</div>
        </div>
      </div>
    </div>
  `;
}

function toggleCheck(collab,idx){
  const item = dailyChecklists[collab][idx];
  item.done = !item.done;
  // Salva timestamp se concluiu, limpa se reabriu
  item.done_at = item.done ? new Date().toISOString() : null;
  saveTaskDone(collab, idx, item.done, item.done_at);
  renderOperacional(document.getElementById('content'));
  toast(item.done?'Tarefa concluída ✓':'Tarefa reaberta','success');
}

function renderKanbanView(){
  const cols = [
    {id:'backlog',title:'Backlog',color:'var(--text-3)'},
    {id:'todo',title:'A fazer',color:'var(--info)'},
    {id:'doing',title:'Em andamento',color:'var(--purple)'},
    {id:'review',title:'Em revisão',color:'var(--warning)'},
    {id:'approval',title:'Aprovação cliente',color:'var(--pink)'},
    {id:'done',title:'Concluído',color:'var(--success)'},
  ];
  // Build cards from dailyChecklists distributed across columns
  const all = [];
  Object.entries(dailyChecklists).forEach(([col,list])=>{
    list.forEach(t=>all.push({...t,owner:col}));
  });
  // Random distribution
  const buckets = {backlog:[],todo:[],doing:[],review:[],approval:[],done:[]};
  all.forEach((t,i)=>{
    if(t.done) buckets.done.push(t);
    else {
      const target = ['backlog','todo','doing','review','approval'][i%5];
      buckets[target].push(t);
    }
  });

  return `
    <div class="filter-bar">
      <span class="filter-chip active">Todos</span>
      <span class="filter-chip">Meus</span>
      <span class="filter-chip">Urgentes</span>
      <span class="filter-chip">Atrasadas</span>
      <span class="filter-chip">Por cliente</span>
      <span class="filter-chip">Por colaborador</span>
    </div>

    <div class="kanban">
      ${cols.map(col=>`
        <div class="kanban-col" data-col="${col.id}" ondragover="event.preventDefault()" ondrop="dropCard(event,'${col.id}')">
          <div class="kanban-head">
            <div class="kanban-title">
              <span style="width:7px;height:7px;border-radius:50%;background:${col.color}"></span>
              ${col.title}
              <span class="kanban-count">${buckets[col.id].length}</span>
            </div>
          </div>
          <div class="kanban-cards">
            ${buckets[col.id].map((t,i)=>{
              const m = team.find(x=>x.name.startsWith(t.owner))||{init:'?',color:'#999'};
              return `
                <div class="kanban-card" draggable="true" ondragstart="dragStart(event,'${col.id}',${i})">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
                    ${prioBadge(t.p)}
                    <span class="text-xs text-3">🕐 ${t.time}</span>
                  </div>
                  <div class="kanban-card-title">${t.t}</div>
                  <div class="text-xs text-3" style="margin-bottom:7px">📌 ${t.client}</div>
                  <div class="kanban-card-foot">
                    <div style="display:flex;gap:8px"><span>💬 ${Math.floor(Math.random()*4)+1}</span><span>📎 ${Math.floor(Math.random()*2)}</span></div>
                    <div class="avatar" style="background:${m.color}">${m.init}</div>
                  </div>
                </div>
              `;
            }).join('')}
            <div class="kanban-add" style="cursor:pointer" onclick="openNovaTarefaModal({preset_status:'${col.id}'})">+ Adicionar tarefa</div>
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

let dragData = null;
function dragStart(e,col,idx){dragData={col,idx};e.target.classList.add('dragging');setTimeout(()=>e.target.classList.remove('dragging'),0)}
function dropCard(e,toCol){if(!dragData||dragData.col===toCol)return;toast('Card movido para '+toCol);dragData=null}
// ============ CALENDÁRIO (centralizado, com datas BR + RS) ============
// ============ CALENDARIO DINAMICO ============
let _ferias = [];                          // ferias_programadas carregadas do banco
let _calCurrent = new Date();             // mes atualmente exibido (1o dia do mes)
_calCurrent.setDate(1); _calCurrent.setHours(0,0,0,0);

async function loadFerias(){
  console.log('[loadFerias] iniciando...');
  if(!_supa){ console.warn('[loadFerias] _supa undefined'); return []; }
  try {
    const { data, error } = await _supa.from('ferias_programadas').select('*').order('data_inicio', {ascending: true});
    if(error){ console.error('[loadFerias] erro:', error); _ferias = []; return []; }
    _ferias = data || [];
    console.log('[loadFerias] ✓ ' + _ferias.length + ' registro(s) carregado(s)', _ferias);
    return _ferias;
  } catch(e){ console.error('[loadFerias] exception:', e); _ferias = []; return []; }
}

// Devolve array de eventos do mes atualmente exibido (_calCurrent)

// ============ Handler universal de click em evento do calendario ============
function abrirEventoCalendario(e){
  if(!e || typeof e !== 'object') return;
  try {
    // Eventos personalizados (banco) -> openEventoModal
    if(e.eventoId && typeof openEventoModal === 'function'){
      openEventoModal(e.eventoId); return;
    }
    // Ferias -> abrirFerias
    if(e.feriasId && typeof abrirFerias === 'function'){
      abrirFerias(e.feriasId); return;
    }
    // Captacao -> openCaptacaoDetail (numero ou _dbId)
    if(e.captacaoId != null && typeof openCaptacaoDetail === 'function'){
      openCaptacaoDetail(e.captacaoId); return;
    }
    // Aniversario / admissao -> abre perfil do colaborador
    if(typeof e.profileIdx === 'number' && team[e.profileIdx] && typeof renderEquipePerfil === 'function'){
      window.perfilId = e.profileIdx;
      if(typeof goTo === 'function') goTo('equipe');
      setTimeout(() => { if(typeof renderEquipePerfil === 'function') renderEquipePerfil(); }, 200);
      return;
    }
    // Feriado / outros -> toast informativo
    toast(e.titulo || 'Evento', 'info');
  } catch(err){ console.warn('[abrirEventoCalendario]', err); }
}
window.abrirEventoCalendario = abrirEventoCalendario;

function getEventosDoMes(){
  const ano = _calCurrent.getFullYear();
  const mes = _calCurrent.getMonth(); // 0-11
  const eventos = {}; // dia -> [eventos]

  const push = (dia, ev) => { if(!eventos[dia]) eventos[dia] = []; eventos[dia].push(ev); };

  // 1) Feriados nacionais + RS + Porto Alegre + datas comemorativas
  const feriados = {
    1:  [[1,'🎊 Confraternização Universal']],
    2:  [[2,'⛵ N. Sra. dos Navegantes (POA)']],
    3:  [[26,'🏛 Aniversário de Porto Alegre']],
    4:  [[21,'⛓ Tiradentes']],
    5:  [[1,'⚒ Dia do Trabalho']],
    6:  [[12,'💕 Dia dos Namorados']],
    7:  [],
    8:  [],
    9:  [[7,'🇧🇷 Independência'],[20,'🌵 Revolução Farroupilha (RS)']],
    10: [[12,'🧒 Crianças / N. Sra. Aparecida'],[15,'👩‍🏫 Dia do Professor']],
    11: [[2,'🕊 Finados'],[15,'🏛 Proclamação da República'],[20,'✊ Consciência Negra']],
    12: [[24,'🎄 Véspera de Natal'],[25,'🎄 Natal'],[31,'🎆 Véspera de Ano Novo']]
  };

  // Helper: enésimo dia da semana do mês (0=domingo)
  function nDomingo(ano, mes0, n){
    const d = new Date(ano, mes0, 1);
    while(d.getDay() !== 0) d.setDate(d.getDate()+1);
    d.setDate(d.getDate() + (n-1)*7);
    return d.getDate();
  }

  // Calcula Pascoa (algoritmo de Meeus/Jones/Butcher)
  function calcPascoa(ano){
    const a = ano % 19;
    const b = Math.floor(ano / 100);
    const c = ano % 100;
    const d = Math.floor(b / 4);
    const e = b % 4;
    const f = Math.floor((b + 8) / 25);
    const g = Math.floor((b - f + 1) / 3);
    const h = (19 * a + b - d - g + 15) % 30;
    const i = Math.floor(c / 4);
    const k = c % 4;
    const l = (32 + 2 * e + 2 * i - h - k) % 7;
    const m = Math.floor((a + 11 * h + 22 * l) / 451);
    const mesP = Math.floor((h + l - 7 * m + 114) / 31);
    const diaP = ((h + l - 7 * m + 114) % 31) + 1;
    return new Date(ano, mesP - 1, diaP);
  }

  const pascoa = calcPascoa(ano);
  const sextaSanta = new Date(pascoa); sextaSanta.setDate(pascoa.getDate() - 2);
  const carnavalTerca = new Date(pascoa); carnavalTerca.setDate(pascoa.getDate() - 47);
  const carnavalSegunda = new Date(pascoa); carnavalSegunda.setDate(pascoa.getDate() - 48);
  const corpusChristi = new Date(pascoa); corpusChristi.setDate(pascoa.getDate() + 60);

  (feriados[mes+1]||[]).forEach(([d,t]) => push(d, {tipo:'feriado',titulo:t,cor:'#a855f7'}));

  // Feriados móveis (calculados a partir da Páscoa)
  if(pascoa.getMonth() === mes) push(pascoa.getDate(), {tipo:'feriado',titulo:'🐰 Páscoa',cor:'#ec4899'});
  if(sextaSanta.getMonth() === mes) push(sextaSanta.getDate(), {tipo:'feriado',titulo:'✝ Sexta-feira Santa',cor:'#a855f7'});
  if(carnavalSegunda.getMonth() === mes) push(carnavalSegunda.getDate(), {tipo:'feriado',titulo:'🎭 Carnaval (segunda)',cor:'#f59e0b'});
  if(carnavalTerca.getMonth() === mes) push(carnavalTerca.getDate(), {tipo:'feriado',titulo:'🎭 Carnaval (terça)',cor:'#f59e0b'});
  if(corpusChristi.getMonth() === mes) push(corpusChristi.getDate(), {tipo:'feriado',titulo:'🍞 Corpus Christi',cor:'#a855f7'});

  // Dias comemorativos móveis
  if(mes === 4) push(nDomingo(ano,4,2), {tipo:'feriado',titulo:'💐 Dia das Mães',cor:'#ec4899'});
  if(mes === 7) push(nDomingo(ano,7,2), {tipo:'feriado',titulo:'👨 Dia dos Pais',cor:'#0ea5e9'});

  // 2) Aniversários dos colaboradores (m.birthday: YYYY-MM-DD)
  (team||[]).forEach((m, idx) => {
    if(m.birthday){
      const parts = m.birthday.split('-');
      if(parts.length === 3 && parseInt(parts[1]) === mes+1){
        const dia = parseInt(parts[2]);
        const idade = ano - parseInt(parts[0]);
        push(dia, {tipo:'aniversario',titulo:'🎂 '+(m.name||'').split(' ')[0]+(idade>0?' ('+idade+')':''),cor:'#f59e0b',profileIdx:idx});
      }
    }
    // Aniversário de admissão (m.since: YYYY-MM-DD)
    if(m.since){
      const parts = m.since.split('-');
      if(parts.length === 3 && parseInt(parts[1]) === mes+1){
        const dia = parseInt(parts[2]);
        const anos = ano - parseInt(parts[0]);
        if(anos > 0) push(dia, {tipo:'admissao',titulo:'🏆 '+(m.name||'').split(' ')[0]+' · '+anos+'a empresa',cor:'#10b981',profileIdx:idx});
      }
    }
  });

  // 3) Férias programadas que tocam este mes
  (_ferias||[]).forEach(f => {
    if(!f.data_inicio || !f.data_fim) return;
    const di = new Date(f.data_inicio+'T00:00:00');
    const df = new Date(f.data_fim+'T00:00:00');
    const profile = (team||[]).find(t => t._dbId === f.profile_id);
    const nome = profile ? (profile.name||'').split(' ')[0] : 'Colaborador';
    // Para cada dia que cai neste mes, adiciona evento
    const cursor = new Date(Math.max(di, new Date(ano,mes,1)));
    cursor.setHours(0,0,0,0);
    const limitMes = new Date(ano, mes+1, 0); // ultimo dia do mes
    while(cursor <= df && cursor <= limitMes){
      if(cursor.getMonth() === mes){
        const isInicio = cursor.getTime() === di.getTime();
        const isFim = cursor.getTime() === df.getTime();
        const tit = isInicio ? '🏖 '+nome+' inicia férias' : (isFim ? '🏖 '+nome+' volta' : '🏖 '+nome);
        push(cursor.getDate(), {tipo:'ferias',titulo:tit,cor:'#06b6d4',feriasId:f.id,profileIdx:(team||[]).indexOf(profile)});
      }
      cursor.setDate(cursor.getDate()+1);
    }
  });

  // 4a) Eventos personalizados do calendario
  (_eventosCalendario||[]).forEach(ev => {
    if(!ev.data_inicio) return;
    const parts = ev.data_inicio.split('-');
    if(parts.length !== 3) return;
    const evAno = parseInt(parts[0]);
    const evMes = parseInt(parts[1]) - 1;
    const evDia = parseInt(parts[2]);
    if(evAno === ano && evMes === mes){
      const info = (typeof tipoEventoInfo === 'function') ? tipoEventoInfo(ev.tipo) : {icon:'📌', cor:ev.cor||'#0ea5e9'};
      push(evDia, {tipo: ev.tipo||'evento', titulo: info.icon+' '+(ev.titulo||'')+(ev.hora?' · '+ev.hora:''), cor: ev.cor||info.cor, eventoId: ev.id});
    }
  });

  // 4) Reuniões (se existirem)
  try {
    (typeof meetings !== 'undefined' ? meetings : []).forEach(mt => {
      // meetings tem dia (d.day, d.m abreviado) - sem ano. Usa apenas se mes bate
      const mIdx = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'].indexOf((mt.m||'').toUpperCase().slice(0,3));
      if(mIdx === mes){
        push(parseInt(mt.day), {tipo:'reuniao',titulo:'📅 '+(mt.title||mt.c||'Reunião'),cor:'#0ea5e9'});
      }
    });
  } catch(e){}

  // 5) Captações já marcadas — DIA DA CAPTAÇÃO (cap.date) + PRAZO DE ENTREGA (cap.prazo_entrega)
  try {
    (typeof captacoes !== 'undefined' ? captacoes : []).forEach(cap => {
      // 5a) Dia da captação
      if(cap.date){
        const parts = cap.date.split('-');
        if(parts.length === 3){
          const capAno = parseInt(parts[0]);
          const capMes = parseInt(parts[1]) - 1;
          const capDia = parseInt(parts[2]);
          if(capAno === ano && capMes === mes){
            const cliNome = cap.client || cap.client_custom_name || 'Captação';
            const ico = cap.type === 'video' ? '🎬' : cap.type === 'foto' ? '📷' : '🎥';
            push(capDia, {
              tipo: 'captacao',
              titulo: ico + ' ' + cliNome + (cap.time ? ' · ' + cap.time : '') + (cap.resp ? ' (' + cap.resp + ')' : ''),
              cor: '#7c3aed',
              captacaoId: cap.id
            });
          }
        }
      }
      // 5b) Prazo de entrega (se ainda nao entregue)
      if(cap.prazo_entrega && !cap.entregue){
        const partsP = cap.prazo_entrega.split('-');
        if(partsP.length === 3){
          const pAno = parseInt(partsP[0]);
          const pMes = parseInt(partsP[1]) - 1;
          const pDia = parseInt(partsP[2]);
          if(pAno === ano && pMes === mes){
            const cliNome = cap.client || cap.client_custom_name || 'Captação';
            push(pDia, {
              tipo: 'prazo',
              titulo: '⏱ Prazo: ' + cliNome + (cap.resp ? ' (' + cap.resp + ')' : ''),
              cor: '#ef4444',
              captacaoId: cap.id
            });
          }
        }
      }
    });
  } catch(e){ console.warn('[captacoes->calendario]', e); }

  return eventos;
}

function calNavegar(delta){
  _calCurrent.setMonth(_calCurrent.getMonth() + delta);
  renderCalendario(document.getElementById('content'));
}
function calHoje(){
  _calCurrent = new Date();
  _calCurrent.setDate(1); _calCurrent.setHours(0,0,0,0);
  renderCalendario(document.getElementById('content'));
}

// Toggle do filtro de tipo no calendario
function calToggleFiltro(tipo){
  window._calFiltroTipo = (window._calFiltroTipo === tipo) ? '' : tipo;
  renderCalendario(document.getElementById('content'));
}

function renderCalendario(c){
  if(typeof _calFiltroTipo === 'undefined') window._calFiltroTipo = '';
  const ano = _calCurrent.getFullYear();
  const mes = _calCurrent.getMonth();
  const nomesMeses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const dias = ['DOM','SEG','TER','QUA','QUI','SEX','SÁB'];
  const primeiroDia = new Date(ano, mes, 1);
  const ultimoDia = new Date(ano, mes+1, 0);
  const diasNoMes = ultimoDia.getDate();
  const offset = primeiroDia.getDay(); // 0..6 (dom=0)
  const hoje = new Date();
  const isHojeMes = hoje.getFullYear() === ano && hoje.getMonth() === mes;
  const eventos = getEventosDoMes();

  // Contadores pra rodape de stats
  let countAniv = 0, countFerias = 0, countFeriado = 0, countAdmissao = 0;
  Object.values(eventos).forEach(arr => arr.forEach(e => {
    if(e.tipo === 'aniversario') countAniv++;
    else if(e.tipo === 'ferias') countFerias++;
    else if(e.tipo === 'feriado') countFeriado++;
    else if(e.tipo === 'admissao') countAdmissao++;
  }));

  let html = '<div class="page active">'+
    '<div class="page-header">'+
      '<div><div class="page-title">Calendário</div><div class="page-subtitle">'+nomesMeses[mes]+' '+ano+' · Reuniões, férias, aniversários e feriados</div></div>'+
      '<div class="page-actions">'+
        '<button class="icon-btn" onclick="calNavegar(-1)" title="Mês anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button>'+
        '<button class="btn" onclick="calHoje()">Hoje</button>'+
        '<button class="icon-btn" onclick="calNavegar(1)" title="Próximo mês"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>'+
        '<button class="btn" onclick="openEventoModal()" title="Adicionar evento ao calendario" style="background:var(--accent);color:#fff;border:1px solid var(--accent);font-weight:700">+ Novo evento</button><button class="btn btn-primary" onclick="openProgramarFeriasModal()">🏖 Programar férias</button>'+
      '</div>'+
    '</div>'+
    '<div class="filter-bar">'+
      '<span class="badge" onclick="calToggleFiltro(\'ferias\')" style="background:' + (_calFiltroTipo==='ferias'?'#06b6d4':'#06b6d41a') + ';color:' + (_calFiltroTipo==='ferias'?'#fff':'#06b6d4') + ';cursor:pointer"><span class="dot" style="background:' + (_calFiltroTipo==='ferias'?'#fff':'#06b6d4') + '"></span>Férias ('+countFerias+')</span>'+
      '<span class="badge" onclick="calToggleFiltro(\'aniversario\')" style="background:' + (_calFiltroTipo==='aniversario'?'#f59e0b':'#f59e0b1a') + ';color:' + (_calFiltroTipo==='aniversario'?'#fff':'#f59e0b') + ';cursor:pointer"><span class="dot" style="background:' + (_calFiltroTipo==='aniversario'?'#fff':'#f59e0b') + '"></span>Aniversários ('+countAniv+')</span>'+
      '<span class="badge" onclick="calToggleFiltro(\'admissao\')" style="background:' + (_calFiltroTipo==='admissao'?'#10b981':'#10b9811a') + ';color:' + (_calFiltroTipo==='admissao'?'#fff':'#10b981') + ';cursor:pointer"><span class="dot" style="background:' + (_calFiltroTipo==='admissao'?'#fff':'#10b981') + '"></span>Admissão ('+countAdmissao+')</span>'+
      '<span class="badge" onclick="calToggleFiltro(\'feriado\')" style="background:' + (_calFiltroTipo==='feriado'?'#a855f7':'#a855f71a') + ';color:' + (_calFiltroTipo==='feriado'?'#fff':'#a855f7') + ';cursor:pointer"><span class="dot" style="background:' + (_calFiltroTipo==='feriado'?'#fff':'#a855f7') + '"></span>Feriados ('+countFeriado+')</span>'+
    '</div>'+
    '<div class="cal-grid">'+
    dias.map(d=>'<div class="cal-head">'+d+'</div>').join('');

  // Dias do mês anterior (cinza)
  const mesAnt = new Date(ano, mes, 0).getDate();
  for(let i=offset-1; i>=0; i--){
    html += '<div class="cal-day other"><div class="cal-num">'+(mesAnt-i)+'</div></div>';
  }
  // Dias do mês
  for(let d=1; d<=diasNoMes; d++){
    const isHoje = isHojeMes && d === hoje.getDate();
    let evs = eventos[d] || [];
    if(_calFiltroTipo){
      evs = evs.filter(e => e.tipo === _calFiltroTipo);
    }
    const tiposUnicos = [...new Set(evs.map(e => e.tipo))];
    const emojiMap = {aniversario:'🎂',ferias:'🏖',feriado:'🎊',admissao:'🏆',reuniao:'📹',evento:'📌',treinamento:'🎓',prazo:'⚠',tarefa:'✅',outro:'📅'};
    const topEmojis = tiposUnicos.map(t => emojiMap[t]||'•').join(' ');
    // Dots coloridos pra mobile (max 4)
    const dotsHtml = evs.slice(0,4).map(e => '<span class="cal-dot" style="background:'+e.cor+'" title="'+(e.titulo||'').replace(/"/g,'&quot;')+'"></span>').join('');
    html += '<div class="cal-day '+(isHoje?'today':'')+'">'+
      (topEmojis ? '<div style="position:absolute;top:4px;right:6px;font-size:14px;line-height:1;letter-spacing:1px;filter:drop-shadow(0 1px 2px rgba(0,0,0,.25))">'+topEmojis+'</div>' : '')+
      '<div class="cal-num">'+d+'</div>'+
      evs.slice(0,4).map((e, evIdx) => {
        const key = 'ev_'+d+'_'+evIdx;
        if(!window._calEvCache) window._calEvCache = {};
        window._calEvCache[key] = e;
        return '<div class="cal-event" title="'+(e.titulo||'').replace(/"/g,'&quot;')+'" style="background:'+e.cor+'1a;color:'+e.cor+';font-size:10px;padding:2px 5px;border-radius:4px;margin-top:2px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer" onclick="abrirEventoCalendario(window._calEvCache[\''+key+'\'])">'+e.titulo+'</div>';
      }).join('')+
      (evs.length > 4 ? '<div style="font-size:10px;color:var(--text-muted);margin-top:2px">+'+(evs.length-4)+' mais</div>' : '')+
      (dotsHtml ? '<div class="cal-dots">'+dotsHtml+'</div>' : '')+
    '</div>';
  }
  // Dias do mês seguinte
  const totalCelulas = offset + diasNoMes;
  const restante = (7 - (totalCelulas % 7)) % 7;
  for(let i=1; i<=restante; i++){
    html += '<div class="cal-day other"><div class="cal-num">'+i+'</div></div>';
  }

  html += '</div>';

  // === LISTA MOBILE — agenda do mes em lista (so aparece em mobile via CSS) ===
  const diasComEventos = [];
  for(let d=1; d<=diasNoMes; d++){
    let evs = eventos[d] || [];
    if(_calFiltroTipo) evs = evs.filter(e => e.tipo === _calFiltroTipo);
    if(evs.length > 0) diasComEventos.push({dia:d, eventos:evs});
  }
  if(diasComEventos.length > 0){
    html += '<div class="cal-mobile-list">' +
      '<div style="font-size:13px;font-weight:700;margin-bottom:10px;color:var(--text)">📅 ' + nomesMeses[mes] + ' · ' + diasComEventos.length + ' dia(s) com eventos</div>' +
      diasComEventos.map(dia => {
        const dataObj = new Date(ano, mes, dia.dia);
        const diaSemana = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'][dataObj.getDay()];
        const isHojeDia = isHojeMes && dia.dia === hoje.getDate();
        return '<div class="cal-mobile-day" style="' + (isHojeDia?'border-left:3px solid var(--accent)':'') + '">' +
          '<div class="cal-mobile-day-head"><span>' + (isHojeDia?'🔵 HOJE · ':'') + diaSemana + ', ' + dia.dia + '/' + (mes+1).toString().padStart(2,'0') + '</span><span class="text-xs text-3">' + dia.eventos.length + ' evento(s)</span></div>' +
          dia.eventos.map((e, evIdx) => {
            const key = 'mev_'+dia.dia+'_'+evIdx;
            if(!window._calEvCache) window._calEvCache = {};
            window._calEvCache[key] = e;
            return '<div class="cal-mobile-event" style="background:' + e.cor + '15;color:' + e.cor + ';cursor:pointer" onclick="abrirEventoCalendario(window._calEvCache[\''+key+'\'])">' +
              '<span style="width:8px;height:8px;border-radius:50%;background:' + e.cor + ';flex-shrink:0"></span>' +
              '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + (e.titulo||'(sem titulo)') + '</span>' +
            '</div>';
          }).join('') +
        '</div>';
      }).join('') +
    '</div>';
  } else {
    html += '<div class="cal-mobile-list"><div class="empty-state" style="padding:24px"><div class="ico">📅</div><div class="ttl">Sem eventos esse mês</div><div class="desc">Use o botão "+ Novo evento" pra agendar.</div></div></div>';
  }

  // Lista de próximos eventos (proximos 30 dias)
  const proximos = listarProximosEventos(30);
  html += '<div class="grid-2 mt-4">'+
    '<div class="card"><div class="card-header"><div class="card-title">📌 Próximos 30 dias</div></div>'+
      (proximos.length === 0
        ? '<div class="empty-state"><div class="ico">📅</div><div class="ttl">Nenhum evento</div><div class="desc">Programe férias ou cadastre aniversário dos colaboradores.</div></div>'
        : proximos.map(p => {
            const d = new Date(p.data);
            const dias = Math.ceil((d - new Date()) / 86400000);
            const subtxt = dias === 0 ? 'HOJE' : (dias === 1 ? 'Amanhã' : 'em '+dias+' dias');
            return '<div class="list-item" '+(p.tipo==='ferias'?'onclick="abrirFerias(\''+p.feriasId+'\')" style="cursor:pointer"':'')+'>'+
              '<div class="list-icon" style="background:'+p.cor+'1a;color:'+p.cor+';font-size:16px">'+(p.titulo||'').split(' ')[0]+'</div>'+
              '<div class="list-content"><div class="list-title">'+(p.titulo||'').substring((p.titulo||'').indexOf(' ')+1)+'</div><div class="list-meta">'+d.toLocaleDateString('pt-BR')+' · '+subtxt+'</div></div>'+
              (p.tipo === 'ferias' ? '<button class="icon-btn" onclick="event.stopPropagation();excluirFerias(\''+p.feriasId+'\')" title="Cancelar" style="color:var(--danger)">×</button>' : '')+
            '</div>';
          }).join('')
      )+
    '</div>'+
    '<div class="card"><div class="card-header"><div class="card-title">🏖 Férias em curso</div></div>'+
      (function(){
        const hoje = new Date(); hoje.setHours(0,0,0,0);
        const ativas = (_ferias||[]).filter(f => {
          const di = new Date(f.data_inicio+'T00:00:00');
          const df = new Date(f.data_fim+'T00:00:00');
          return di <= hoje && hoje <= df;
        });
        if(ativas.length === 0) return '<div class="empty-state"><div class="ico">✓</div><div class="ttl">Ninguém de férias</div><div class="desc">Toda a equipe está presente hoje.</div></div>';
        return ativas.map(f => {
          const p = (team||[]).find(t => t._dbId === f.profile_id);
          const di = new Date(f.data_inicio+'T00:00:00');
          const df = new Date(f.data_fim+'T00:00:00');
          const total = Math.round((df - di)/86400000)+1;
          const restantes = Math.ceil((df - hoje)/86400000);
          return '<div class="list-item">'+
            '<div class="avatar" style="background:'+(p?p.color:'#888')+'">'+(p?p.init:'?')+'</div>'+
            '<div class="list-content"><div class="list-title">'+(p?p.name:'Colaborador removido')+'</div><div class="list-meta">'+di.toLocaleDateString('pt-BR')+' - '+df.toLocaleDateString('pt-BR')+' · '+total+' dias</div></div>'+
            '<span class="badge b-info">volta em '+restantes+' dia'+(restantes!==1?'s':'')+'</span>'+
          '</div>';
        }).join('');
      })()+
    '</div>'+
  '</div>'+
  '</div>';

  c.innerHTML = html;
}

// Lista eventos dos proximos N dias (todos os tipos)
function listarProximosEventos(diasFrente){
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  const limite = new Date(hoje.getTime() + diasFrente*86400000);
  const lista = [];
  // ferias programadas
  (_ferias||[]).forEach(f => {
    if(!f.data_inicio) return;
    const di = new Date(f.data_inicio+'T00:00:00');
    if(di >= hoje && di <= limite){
      const p = (team||[]).find(t => t._dbId === f.profile_id);
      const nome = p ? (p.name||'').split(' ')[0] : 'Colaborador';
      lista.push({data: di, titulo: '🏖 '+nome+' começa férias', cor: '#06b6d4', tipo: 'ferias', feriasId: f.id});
    }
  });
  // aniversarios e admissoes nos proximos N dias
  (team||[]).forEach((m, idx) => {
    function checkData(iso, label, emoji, cor, tipo){
      if(!iso) return;
      const parts = iso.split('-');
      if(parts.length !== 3) return;
      const m_ = parseInt(parts[1]) - 1;
      const d_ = parseInt(parts[2]);
      // proxima ocorrencia (este ano ou ano que vem)
      let prox = new Date(hoje.getFullYear(), m_, d_);
      if(prox < hoje) prox = new Date(hoje.getFullYear()+1, m_, d_);
      if(prox <= limite){
        let titulo = emoji+' '+(m.name||'').split(' ')[0]+' · '+label;
        if(tipo === 'admissao'){
          const anos = prox.getFullYear() - parseInt(parts[0]);
          if(anos > 0) titulo = emoji+' '+(m.name||'').split(' ')[0]+' · '+anos+'a de empresa';
        }
        if(tipo === 'aniversario'){
          const idade = prox.getFullYear() - parseInt(parts[0]);
          if(idade > 0) titulo = emoji+' '+(m.name||'').split(' ')[0]+' faz '+idade;
        }
        lista.push({data: prox, titulo, cor, tipo});
      }
    }
    checkData(m.birthday, 'aniversário', '🎂', '#f59e0b', 'aniversario');
    checkData(m.since, 'admissão', '🏆', '#10b981', 'admissao');
  });

  return lista.sort((a,b) => a.data - b.data).slice(0, 12);
}

// ============ FERIAS — MODAL e CRUD ============
// Helper: monta HTML de um periodo de ferias (input inicio+fim)
function montaPeriodoHTML(numero, valIni, valFim){
  const idx = numero - 1;
  return '<div class="periodo-item" data-idx="'+idx+'" style="background:var(--surface-2);padding:12px;border-radius:10px;border:1px solid var(--border)">'+
    '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">'+
      '<div class="periodo-titulo" style="font-size:12px;font-weight:700;color:var(--text-2)">📅 Período '+numero+'</div>'+
      (numero > 1 ? '<button type="button" onclick="window.removerPeriodo(this)" style="padding:3px 8px;border:none;background:transparent;color:var(--danger);cursor:pointer;font-size:11px">× remover</button>' : '') +
    '</div>'+
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">'+
      '<div><label style="font-size:11px;font-weight:600;display:block;margin-bottom:4px;color:var(--text-2)">Início</label>'+
        '<input type="date" class="ferias-inicio" value="'+(valIni||'')+'" onchange="window.atualizarDiasFerias()" oninput="window.atualizarDiasFerias()" style="width:100%;padding:9px 10px;border:1.5px solid var(--border-strong);border-radius:8px;background:var(--surface);color:var(--text);font-size:13px;outline:none">'+
      '</div>'+
      '<div><label style="font-size:11px;font-weight:600;display:block;margin-bottom:4px;color:var(--text-2)">Fim</label>'+
        '<input type="date" class="ferias-fim" value="'+(valFim||'')+'" onchange="window.atualizarDiasFerias()" oninput="window.atualizarDiasFerias()" style="width:100%;padding:9px 10px;border:1.5px solid var(--border-strong);border-radius:8px;background:var(--surface);color:var(--text);font-size:13px;outline:none">'+
      '</div>'+
    '</div>'+
    '<div style="margin-top:6px;font-size:11px;color:var(--text-3)" class="periodo-dias-info">— preencha início e fim</div>'+
  '</div>';
}

async function openProgramarFeriasModal(feriasExistentes){
  // Remove modal antigo
  const old = document.getElementById('feriasModal'); if(old) old.remove();

  const editing = !!feriasExistentes;
  const id = editing ? feriasExistentes.id : null;

  // Carrega ferias se vazio
  if(!_ferias.length){ try { await loadFerias(); } catch(e){} }

  const teamOpts = (team||[]).filter(t => t._dbId).map(t => '<option value="'+t._dbId+'" '+(feriasExistentes && feriasExistentes.profile_id===t._dbId?'selected':'')+'>'+(t.name||'').replace(/</g,'&lt;')+'</option>').join('');

  const overlay = document.createElement('div');
  overlay.id = 'feriasModal';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:10000;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)';
  overlay.onclick = (e) => { if(e.target === overlay) overlay.remove(); };

  overlay.innerHTML =
    '<div style="background:var(--surface);border:1px solid var(--border-strong);border-radius:18px;max-width:480px;width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 24px 80px rgba(0,0,0,.4)">'+
      '<div style="padding:22px 24px 18px;background:linear-gradient(135deg,#06b6d4 0%,#0ea5e9 100%);color:#fff;border-radius:18px 18px 0 0;display:flex;align-items:flex-start;gap:14px;position:relative">'+
        '<div style="font-size:34px;line-height:1">🏖</div>'+
        '<div style="flex:1">'+
          '<div style="font-size:18px;font-weight:800">'+(editing?'Editar férias':'Programar férias')+'</div>'+
          '<div style="font-size:12px;opacity:.92;margin-top:3px;line-height:1.4">'+(editing?'Atualize os dados':'Vai aparecer no calendário e nos próximos eventos')+'</div>'+
        '</div>'+
        '<button onclick="document.getElementById(\'feriasModal\').remove()" style="position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:8px;border:none;background:rgba(255,255,255,.22);color:#fff;cursor:pointer;font-size:16px">×</button>'+
      '</div>'+
      '<div style="padding:22px 24px 4px">'+
        '<div style="margin-bottom:18px">'+
          '<label style="font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px;margin-bottom:8px">👤 Colaborador</label>'+
          '<select id="feriasProfile" style="width:100%;padding:13px 14px;border:1.5px solid var(--border-strong);border-radius:10px;background:var(--surface-2);color:var(--text);font-size:14px;outline:none;cursor:pointer">'+
            '<option value="">— Selecione —</option>'+teamOpts+
          '</select>'+
        '</div>'+
        '<div class="text-xs text-3" style="margin-bottom:8px;font-weight:600">💡 Voce pode dividir as ferias em ate 3 periodos. Total no ano deve somar 30 dias.</div>'+
        '<div id="periodosWrap" style="display:flex;flex-direction:column;gap:10px;margin-bottom:14px">'+
          montaPeriodoHTML(1, editing ? feriasExistentes.data_inicio : '', editing ? feriasExistentes.data_fim : '') +
          montaPeriodoHTML(2, '', '') +
          montaPeriodoHTML(3, '', '') +
        '</div>'+
        '<button type="button" onclick="window.adicionarPeriodo()" style="width:100%;padding:10px;border:1.5px dashed var(--border-strong);background:transparent;color:var(--accent);border-radius:10px;cursor:pointer;font-weight:600;font-size:12.5px;margin-bottom:14px">+ Adicionar mais um período</button>'+
        '<div id="feriasResumo" style="background:linear-gradient(135deg,var(--surface-2),var(--surface));padding:13px 16px;border-radius:10px;margin-bottom:18px;display:flex;align-items:center;gap:12px;border:2px solid var(--border)">'+
          '<div style="font-size:24px">📊</div>'+
          '<div style="flex:1"><div style="font-size:13px;font-weight:700">Total no ano (somando todos os períodos)</div><div id="feriasDias" style="font-size:20px;font-weight:800;color:var(--accent)">0 dias</div>'+
          '<div id="feriasMeta" class="text-xs" style="margin-top:2px;color:var(--text-3)">Meta: 30 dias por ano</div></div>'+
        '</div>'+
        '<div style="margin-bottom:8px">'+
          '<label style="font-size:13px;font-weight:700;display:block;margin-bottom:8px">📝 Observações <span style="font-weight:500;color:var(--text-muted);font-size:11px">(opcional)</span></label>'+
          '<textarea id="feriasObs" rows="2" placeholder="Ex: férias antecipadas, retorno antes da campanha de junho..." style="width:100%;padding:13px 14px;border:1.5px solid var(--border-strong);border-radius:10px;background:var(--surface-2);color:var(--text);font-family:inherit;font-size:14px;resize:vertical">'+(editing?(feriasExistentes.observacoes||''):'')+'</textarea>'+
        '</div>'+
      '</div>'+
      '<div style="padding:16px 24px 22px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--border);margin-top:14px;background:var(--surface-2);border-radius:0 0 18px 18px">'+
        (editing ? '<button onclick="excluirFerias(\''+id+'\');document.getElementById(\'feriasModal\').remove()" style="padding:11px 18px;border:1px solid var(--danger);background:transparent;color:var(--danger);border-radius:10px;cursor:pointer;font-weight:600;font-size:13px;margin-right:auto">🗑 Cancelar férias</button>' : '')+
        '<button onclick="document.getElementById(\'feriasModal\').remove()" style="padding:11px 22px;border:1px solid var(--border);background:transparent;color:var(--text);border-radius:10px;cursor:pointer;font-weight:600;font-size:13px">Cancelar</button>'+
        '<button onclick="salvarFerias('+(id?"'"+id+"'":'null')+')" style="padding:11px 26px;border:none;background:#06b6d4;color:#fff;border-radius:10px;cursor:pointer;font-weight:700;font-size:13px;box-shadow:0 6px 16px rgba(0,0,0,.18)">✓ Salvar</button>'+
      '</div>'+
    '</div>';

  document.body.appendChild(overlay);
  if(feriasExistentes && feriasExistentes.profile_id){
    setTimeout(()=>{ const sel = document.getElementById('feriasProfile'); if(sel) sel.value = feriasExistentes.profile_id; }, 50);
  }
  // Dispara o calculo inicial pra mostrar 0 dias / validacao
  setTimeout(() => { if(typeof window.atualizarDiasFerias === 'function') window.atualizarDiasFerias(); }, 100);
}

window.atualizarDiasFerias = function(){
  try {
    const wrap = document.getElementById('periodosWrap');
    const out = document.getElementById('feriasDias');
    const meta = document.getElementById('feriasMeta');
    const wrapResumo = document.getElementById('feriasResumo');
    if(!wrap || !out){ return; }
    const items = wrap.querySelectorAll('.periodo-item');
    let totalGeral = 0;
    let temErro = false;
    let periodosPreenchidos = 0;
    items.forEach((item) => {
      const inputIni = item.querySelector('.ferias-inicio');
      const inputFim = item.querySelector('.ferias-fim');
      const info = item.querySelector('.periodo-dias-info');
      if(!inputIni || !inputFim) return;
      const di = inputIni.value;
      const df = inputFim.value;
      if(!di || !df){
        if(info){ info.textContent = '— preencha início e fim'; info.style.color = 'var(--text-3)'; }
        return;
      }
      const d1 = new Date(di + 'T00:00:00');
      const d2 = new Date(df + 'T00:00:00');
      if(isNaN(d1.getTime()) || isNaN(d2.getTime())){
        if(info){ info.textContent = '⚠ data inválida'; info.style.color = 'var(--danger)'; }
        temErro = true; return;
      }
      if(d2 < d1){
        if(info){ info.textContent = '⚠ fim antes do início'; info.style.color = 'var(--danger)'; }
        temErro = true; return;
      }
      const dias = Math.round((d2 - d1) / 86400000) + 1;
      if(info){ info.textContent = dias + ' dia' + (dias !== 1 ? 's' : ''); info.style.color = 'var(--text-2)'; }
      totalGeral += dias;
      periodosPreenchidos++;
    });
    out.textContent = totalGeral + ' dia' + (totalGeral !== 1 ? 's' : '') + (periodosPreenchidos > 1 ? ' em ' + periodosPreenchidos + ' períodos' : '');

    // Validacao 30 dias
    if(meta && wrapResumo){
      if(totalGeral === 0){
        meta.textContent = 'Meta: 30 dias por ano';
        meta.style.color = 'var(--text-3)';
        wrapResumo.style.borderColor = 'var(--border)';
        out.style.color = 'var(--accent)';
      } else if(totalGeral === 30){
        meta.textContent = '✅ Total bate com a meta de 30 dias!';
        meta.style.color = 'var(--success-text)';
        wrapResumo.style.borderColor = 'var(--success)';
        wrapResumo.style.background = 'var(--success-soft)';
        out.style.color = 'var(--success-text)';
      } else if(totalGeral < 30){
        meta.textContent = '⚠ Faltam ' + (30 - totalGeral) + ' dia(s) pra completar 30 do ano';
        meta.style.color = 'var(--warning-text)';
        wrapResumo.style.borderColor = 'var(--warning)';
        wrapResumo.style.background = 'var(--warning-soft)';
        out.style.color = 'var(--warning-text)';
      } else {
        meta.textContent = '⚠ Passou ' + (totalGeral - 30) + ' dia(s) do limite legal de 30 dias';
        meta.style.color = 'var(--danger)';
        wrapResumo.style.borderColor = 'var(--danger)';
        wrapResumo.style.background = 'var(--danger-soft)';
        out.style.color = 'var(--danger)';
      }
    }

    if(temErro) out.style.color = 'var(--danger)';
  } catch(e){ console.error('[atualizarDiasFerias]', e); }
};

window.adicionarPeriodo = function(){
  try {
    console.log('[ferias] adicionarPeriodo chamada');
    const wrap = document.getElementById('periodosWrap');
    if(!wrap){ toast('Erro: container não encontrado','info'); return; }
    const qtd = wrap.querySelectorAll('.periodo-item').length;
    const novoIdx = qtd;
    console.log('[ferias] adicionando periodo ' + (novoIdx + 1));
    const novo = document.createElement('div');
    novo.className = 'periodo-item';
    novo.setAttribute('data-idx', novoIdx);
    novo.style.cssText = 'background:var(--surface-2);padding:12px;border-radius:10px;border:1px solid var(--border)';
    novo.innerHTML =
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">' +
        '<div class="periodo-titulo" style="font-size:12px;font-weight:700;color:var(--text-2)">📅 Período ' + (novoIdx + 1) + '</div>' +
        '<button type="button" onclick="window.removerPeriodo(this)" style="padding:3px 8px;border:none;background:transparent;color:var(--danger);cursor:pointer;font-size:11px">× remover</button>' +
      '</div>' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">' +
        '<div><label style="font-size:11px;font-weight:600;display:block;margin-bottom:4px;color:var(--text-2)">Início</label>' +
          '<input type="date" class="ferias-inicio" onchange="window.atualizarDiasFerias()" oninput="window.atualizarDiasFerias()" style="width:100%;padding:9px 10px;border:1.5px solid var(--border-strong);border-radius:8px;background:var(--surface);color:var(--text);font-size:13px;outline:none">' +
        '</div>' +
        '<div><label style="font-size:11px;font-weight:600;display:block;margin-bottom:4px;color:var(--text-2)">Fim</label>' +
          '<input type="date" class="ferias-fim" onchange="window.atualizarDiasFerias()" oninput="window.atualizarDiasFerias()" style="width:100%;padding:9px 10px;border:1.5px solid var(--border-strong);border-radius:8px;background:var(--surface);color:var(--text);font-size:13px;outline:none">' +
        '</div>' +
      '</div>' +
      '<div style="margin-top:6px;font-size:11px;color:var(--text-3)" class="periodo-dias-info">— preencha início e fim</div>';
    wrap.appendChild(novo);
    window.atualizarDiasFerias();
    console.log('[ferias] periodo ' + (novoIdx + 1) + ' adicionado. Total agora: ' + wrap.querySelectorAll('.periodo-item').length);
  } catch(e){ console.error('[adicionarPeriodo]', e); toast('Erro ao adicionar: '+e.message,'info'); }
};

window.removerPeriodo = function(btn){
  try {
    const item = btn.closest('.periodo-item');
    if(!item) return;
    const wrap = document.getElementById('periodosWrap');
    if(wrap.querySelectorAll('.periodo-item').length <= 1){
      toast('Precisa ter pelo menos 1 período','info');
      return;
    }
    item.remove();
    Array.from(wrap.querySelectorAll('.periodo-item')).forEach((p, i) => {
      p.setAttribute('data-idx', i);
      const titulo = p.querySelector('.periodo-titulo');
      if(titulo) titulo.textContent = '📅 Período ' + (i + 1);
    });
    window.atualizarDiasFerias();
  } catch(e){ console.error('[removerPeriodo]', e); }
};

async function salvarFerias(id){
  console.log('[salvarFerias] id=', id);
  const profile_id = document.getElementById('feriasProfile').value;
  const observacoes = document.getElementById('feriasObs').value || null;
  console.log('[salvarFerias] profile_id=', profile_id, 'obs=', observacoes);
  if(!profile_id){ toast('Selecione um colaborador','info'); return; }

  // Coleta todos os periodos preenchidos
  const periodos = [];
  const wrap = document.getElementById('periodosWrap');
  if(!wrap){ toast('Erro: container de períodos não encontrado','info'); return; }
  Array.from(wrap.querySelectorAll('.periodo-item')).forEach((item, idx) => {
    const di = item.querySelector('.ferias-inicio').value;
    const df = item.querySelector('.ferias-fim').value;
    console.log('[salvarFerias] periodo '+(idx+1)+': di=', di, 'df=', df);
    if(!di || !df) return;
    if(new Date(df+'T00:00:00') < new Date(di+'T00:00:00')) { console.warn('[salvarFerias] periodo '+(idx+1)+' tem fim antes do inicio, ignorado'); return; }
    const dias = Math.round((new Date(df+'T00:00:00') - new Date(di+'T00:00:00'))/86400000)+1;
    periodos.push({data_inicio: di, data_fim: df, dias});
  });
  console.log('[salvarFerias] periodos validos:', periodos.length, periodos);
  if(periodos.length === 0){ toast('Preencha pelo menos um período (início e fim)','info'); return; }

  // Verifica se _supa esta disponivel
  if(!_supa){
    toast('⚠ Banco nao conectado. Faca logout e login novamente.','info');
    console.error('[salvarFerias] _supa undefined!');
    return;
  }

  // Editing = update do primeiro periodo
  if(id){
    const p = periodos[0];
    const payload = {profile_id, data_inicio: p.data_inicio, data_fim: p.data_fim, dias: p.dias, observacoes, status: 'programada', updated_at: new Date().toISOString()};
    console.log('[salvarFerias] UPDATE id=' + id, payload);
    try {
      const { data, error } = await _supa.from('ferias_programadas').update(payload).eq('id', id).select().single();
      if(error){
        console.error('[salvarFerias] UPDATE erro:', error);
        toast('Erro ao atualizar: ' + error.message, 'info');
        return;
      }
      console.log('[salvarFerias] ✓ UPDATE OK', data);
      const idx = _ferias.findIndex(f => f.id === id);
      if(idx >= 0) Object.assign(_ferias[idx], payload);
    } catch(ex){
      console.error('[salvarFerias] UPDATE exception:', ex);
      toast('Erro: ' + (ex.message||ex), 'info');
      return;
    }
    document.getElementById('feriasModal').remove();
    toast('🏖 Férias atualizadas','success');
  } else {
    // Cria N registros (1 por período)
    let salvos = 0;
    let erros = 0;
    for(let i = 0; i < periodos.length; i++){
      const p = periodos[i];
      const payload = {profile_id, data_inicio: p.data_inicio, data_fim: p.data_fim, dias: p.dias, observacoes, status: 'programada'};
      console.log('[salvarFerias] INSERT periodo ' + (i+1), payload);
      try {
        const { data, error } = await _supa.from('ferias_programadas').insert(payload).select().single();
        if(error){
          console.error('[salvarFerias] INSERT erro periodo ' + (i+1) + ':', error);
          toast('Erro periodo ' + (i+1) + ': ' + error.message, 'info');
          erros++;
          continue;
        }
        console.log('[salvarFerias] ✓ INSERT periodo ' + (i+1) + ' OK', data);
        _ferias.push(data);
        salvos++;
      } catch(ex){
        console.error('[salvarFerias] INSERT exception:', ex);
        toast('Erro: ' + (ex.message||ex), 'info');
        erros++;
      }
    }
    document.getElementById('feriasModal').remove();
    if(salvos > 0){
      toast('🏖 ' + salvos + ' período(s) salvos' + (erros>0?' ('+erros+' falharam)':''), 'success');
    } else if(erros > 0){
      toast('✗ Nenhum período salvo. Veja os erros no console (F12).', 'info');
      return;
    }
  }

  // Recarrega do banco pra garantir sincronia
  try { await loadFerias(); } catch(e){ console.warn('[salvarFerias] reload falhou', e); }

  if(currentPage === 'calendario') renderCalendario(document.getElementById('content'));
  if(currentPage === 'equipe' && typeof renderEquipe === 'function') renderEquipe(document.getElementById('content'));
}

async function excluirFerias(id){
  if(!(await confirmDelete('Cancelar período de férias'))) return;
  if(_supa){
    const { error } = await _supa.from('ferias_programadas').delete().eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  _ferias = _ferias.filter(f => f.id !== id);
  toast('Férias canceladas','success');
  if(currentPage === 'calendario') renderCalendario(document.getElementById('content'));
}

function abrirFerias(id){
  const f = _ferias.find(x => x.id === id);
  if(f) openProgramarFeriasModal(f);
}

