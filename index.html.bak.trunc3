<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
<title>IMPULSE ONE — Central da Agência</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root[data-theme="light"]{
  --bg:#f5f5f7;
  --surface:#ffffff;
  --surface-2:#fafafa;
  --surface-3:#f0f0f3;
  --surface-hover:#f5f5f7;
  --border:#e8e8ed;
  --border-strong:#d2d2d7;
  --text:#1d1d1f;
  --text-2:#6e6e73;
  --text-3:#a1a1a6;
  --accent:#1d1d1f;
  --accent-2:#000;
  --accent-soft:rgba(0,0,0,.05);
  --accent-border:rgba(0,0,0,.12);
  --success:#28a745;
  --success-soft:#e6f7ec;
  --success-text:#1a7335;
  --warning:#f59e0b;
  --warning-soft:#fef4e0;
  --warning-text:#9a6500;
  --danger:#ef4444;
  --danger-soft:#fdecec;
  --danger-text:#b42424;
  --info:#0ea5e9;
  --info-soft:#e4f4fc;
  --info-text:#0369a1;
  --purple:#7c3aed;
  --purple-soft:#f1ebfd;
  --purple-text:#5b21b6;
  --pink:#ec4899;
  --pink-soft:#fce4f1;
  --pink-text:#a8265e;
  --shadow-sm:0 1px 2px rgba(0,0,0,.04);
  --shadow:0 4px 12px rgba(0,0,0,.05);
  --shadow-lg:0 12px 40px rgba(0,0,0,.12);
}
:root[data-theme="dark"]{
  --bg:#0a0a0c;
  --surface:#141417;
  --surface-2:#1a1a1f;
  --surface-3:#23232a;
  --surface-hover:#1f1f25;
  --border:#27272f;
  --border-strong:#3a3a44;
  --text:#f5f5f7;
  --text-2:#9595a0;
  --text-3:#6e6e7a;
  --accent:#f5f5f7;
  --accent-2:#ffffff;
  --accent-soft:rgba(255,255,255,.06);
  --accent-border:rgba(255,255,255,.15);
  --success:#34d399;
  --success-soft:rgba(52,211,153,.12);
  --success-text:#34d399;
  --warning:#fbbf24;
  --warning-soft:rgba(251,191,36,.12);
  --warning-text:#fbbf24;
  --danger:#f87171;
  --danger-soft:rgba(248,113,113,.12);
  --danger-text:#f87171;
  --info:#38bdf8;
  --info-soft:rgba(56,189,248,.12);
  --info-text:#38bdf8;
  --purple:#a78bfa;
  --purple-soft:rgba(167,139,250,.12);
  --purple-text:#a78bfa;
  --pink:#f472b6;
  --pink-soft:rgba(244,114,182,.12);
  --pink-text:#f472b6;
  --shadow-sm:0 1px 2px rgba(0,0,0,.3);
  --shadow:0 4px 16px rgba(0,0,0,.4);
  --shadow-lg:0 16px 50px rgba(0,0,0,.6);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;
  background:var(--bg);
  color:var(--text);
  font-size:13.5px;
  line-height:1.5;
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
  letter-spacing:-.005em;
  transition:background .25s,color .25s;
}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--text-3)}

/* Layout */
.app{display:flex;height:100vh;overflow:hidden}
.sidebar{
  width:240px;background:var(--surface);
  border-right:1px solid var(--border);
  display:flex;flex-direction:column;flex-shrink:0;
}
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;background:var(--bg)}
.topbar{
  height:58px;background:var(--surface);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 22px;gap:14px;
  flex-shrink:0;
}
.content{flex:1;overflow-y:auto;padding:26px 30px}

/* Brand */
.brand{padding:18px 18px 16px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border)}
.brand-logo{
  width:34px;height:34px;border-radius:9px;background:var(--accent);
  color:var(--surface);display:grid;place-items:center;
  font-weight:800;font-size:12px;letter-spacing:-.04em;
  overflow:hidden;flex-shrink:0;
}
.brand-logo img{
  width:100%;height:100%;object-fit:cover;display:block;
}
.brand-logo.has-image{background:transparent;padding:0}
.brand-name{font-weight:700;font-size:15px;letter-spacing:-.02em}
.brand-sub{font-size:10.5px;color:var(--text-3);margin-top:1px;letter-spacing:.02em}

/* Nav */
.nav{flex:1;overflow-y:auto;padding:12px 10px}
.nav-group{margin-bottom:4px}
.nav-label{
  font-size:10px;text-transform:uppercase;letter-spacing:.08em;
  color:var(--text-3);padding:10px 10px 6px;font-weight:600;
}
.nav-item{
  display:flex;align-items:center;gap:11px;
  padding:7px 10px;border-radius:7px;
  color:var(--text-2);cursor:pointer;
  font-size:13px;font-weight:500;
  transition:.15s;margin-bottom:1px;position:relative;
}
.nav-item:hover{background:var(--surface-hover);color:var(--text)}
.nav-item.active{background:var(--accent-soft);color:var(--text);font-weight:600}
.nav-item svg{width:16px;height:16px;flex-shrink:0;stroke-width:1.8}
.nav-badge{
  margin-left:auto;font-size:10px;background:var(--accent);color:var(--surface);
  padding:1px 7px;border-radius:9px;font-weight:600;
}

/* User card */
.user-card{padding:10px;border-top:1px solid var(--border);display:flex;align-items:center;gap:10px}
.avatar{
  width:32px;height:32px;border-radius:50%;background:var(--accent);
  display:grid;place-items:center;color:var(--surface);font-weight:600;font-size:12px;
  flex-shrink:0;letter-spacing:-.01em;
}
.user-info{flex:1;min-width:0}
.user-name{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-role{font-size:11px;color:var(--text-3)}

/* Topbar */
.search{flex:1;max-width:440px;position:relative}
.search input{
  width:100%;background:var(--surface-2);border:1px solid var(--border);
  color:var(--text);padding:8px 14px 8px 36px;border-radius:8px;
  font-size:13px;font-family:inherit;outline:none;transition:.15s;
}
.search input:focus{border-color:var(--accent-border);background:var(--surface)}
.search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:var(--text-3)}
.search kbd{
  position:absolute;right:10px;top:50%;transform:translateY(-50%);
  background:var(--surface);border:1px solid var(--border);
  font-size:10px;padding:1px 6px;border-radius:4px;color:var(--text-3);font-family:inherit;
}
.top-actions{display:flex;align-items:center;gap:6px;margin-left:auto}
.icon-btn{
  width:34px;height:34px;border-radius:8px;background:transparent;border:1px solid transparent;
  display:grid;place-items:center;cursor:pointer;color:var(--text-2);transition:.15s;position:relative;
}
.icon-btn:hover{background:var(--surface-hover);color:var(--text)}
.icon-btn svg{width:16px;height:16px;stroke-width:1.8}
.icon-btn .dot{
  position:absolute;top:6px;right:7px;width:7px;height:7px;
  background:var(--danger);border-radius:50%;border:2px solid var(--surface);
}
.btn{
  padding:7px 13px;border-radius:8px;font-size:12.5px;font-weight:600;
  cursor:pointer;border:1px solid var(--border);
  display:inline-flex;align-items:center;gap:6px;
  font-family:inherit;transition:.15s;background:var(--surface);color:var(--text);
}
.btn:hover{background:var(--surface-hover);border-color:var(--border-strong)}
.btn-primary{background:var(--accent);color:var(--surface);border-color:var(--accent)}
.btn-primary:hover{background:var(--accent-2);border-color:var(--accent-2);transform:translateY(-1px);box-shadow:var(--shadow)}
.btn svg{width:13px;height:13px;stroke-width:2}
.btn-sm{padding:5px 10px;font-size:11.5px}

/* Page */
.page{display:none;animation:fade .25s ease}
.page.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

.page-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px;gap:18px;flex-wrap:wrap}
.page-title{font-size:22px;font-weight:700;letter-spacing:-.03em;line-height:1.2}
.page-subtitle{color:var(--text-2);font-size:13px;margin-top:4px}
.page-actions{display:flex;gap:7px;align-items:center}

/* Cards */
.card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:12px;padding:18px;box-shadow:var(--shadow-sm);
  transition:.18s;
}
.card-hover:hover{box-shadow:var(--shadow);border-color:var(--border-strong)}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.card-title{font-size:13.5px;font-weight:600;letter-spacing:-.01em}
.card-link{font-size:11.5px;color:var(--text-2);cursor:pointer;font-weight:500}
.card-link:hover{color:var(--text)}

/* Stat cards */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:18px}
.stat{
  background:var(--surface);border:1px solid var(--border);
  border-radius:12px;padding:16px;box-shadow:var(--shadow-sm);
  transition:.18s;
}
.stat:hover{box-shadow:var(--shadow);transform:translateY(-1px)}
.stat-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.stat-label{font-size:11.5px;color:var(--text-2);font-weight:500}
.stat-icon{width:28px;height:28px;border-radius:7px;display:grid;place-items:center;background:var(--surface-3);color:var(--text-2)}
.stat-icon svg{width:14px;height:14px;stroke-width:2}
.stat-value{font-size:22px;font-weight:700;letter-spacing:-.03em;line-height:1.1}
.stat-sub{font-size:11px;color:var(--text-3);margin-top:5px}
.stat-delta{
  display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:600;
  margin-top:6px;padding:2px 6px;border-radius:5px;
}
.delta-up{background:var(--success-soft);color:var(--success-text)}
.delta-down{background:var(--danger-soft);color:var(--danger-text)}

/* Quick actions row */
.quick-row{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:10px;margin-bottom:22px;
}
.quick{
  background:var(--surface);border:1px solid var(--border);border-radius:11px;
  padding:14px;cursor:pointer;display:flex;align-items:center;gap:10px;
  transition:.18s;box-shadow:var(--shadow-sm);
}
.quick:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:var(--border-strong)}
.quick-icon{
  width:36px;height:36px;border-radius:9px;display:grid;place-items:center;
  flex-shrink:0;font-size:16px;
}
.quick-title{font-size:12.5px;font-weight:600;line-height:1.2}
.quick-sub{font-size:10.5px;color:var(--text-3);margin-top:2px}

/* Grids */
.grid-2{display:grid;grid-template-columns:1.5fr 1fr;gap:14px;margin-bottom:14px}
.grid-2e{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:14px}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:14px}
@media (max-width:1100px){.grid-2,.grid-2e,.grid-3,.grid-4{grid-template-columns:1fr}}

.chart-box{height:240px;position:relative}

/* Lists */
.list-item{display:flex;align-items:center;gap:11px;padding:10px 0;border-bottom:1px solid var(--border)}
.list-item:last-child{border-bottom:none}
.list-icon{
  width:32px;height:32px;border-radius:8px;display:grid;place-items:center;
  flex-shrink:0;font-weight:600;font-size:12px;background:var(--surface-3);color:var(--text-2);
}
.list-content{flex:1;min-width:0}
.list-title{font-size:12.5px;font-weight:500;color:var(--text)}
.list-meta{font-size:11px;color:var(--text-3);margin-top:1px}
.list-right{font-size:11.5px;color:var(--text-2);text-align:right;flex-shrink:0}

/* Badges */
.badge{
  display:inline-flex;align-items:center;gap:4px;
  padding:2px 7px;border-radius:5px;font-size:10.5px;font-weight:600;
  letter-spacing:.005em;
}
.badge .dot{width:5px;height:5px;border-radius:50%;background:currentColor}
.b-default{background:var(--surface-3);color:var(--text-2)}
.b-success{background:var(--success-soft);color:var(--success-text)}
.b-warning{background:var(--warning-soft);color:var(--warning-text)}
.b-danger{background:var(--danger-soft);color:var(--danger-text)}
.b-info{background:var(--info-soft);color:var(--info-text)}
.b-purple{background:var(--purple-soft);color:var(--purple-text)}
.b-pink{background:var(--pink-soft);color:var(--pink-text)}

/* Priority */
.prio{padding:2px 8px;border-radius:5px;font-size:10.5px;font-weight:600;letter-spacing:.005em}
.prio-urgent{background:#fef0f0;color:#b42424}
.prio-high{background:#fef4e0;color:#9a6500}
.prio-med{background:#e4f4fc;color:#0369a1}
.prio-low{background:#f0f0f3;color:#6e6e73}
:root[data-theme="dark"] .prio-urgent{background:rgba(239,68,68,.15);color:#fca5a5}
:root[data-theme="dark"] .prio-high{background:rgba(245,158,11,.15);color:#fcd34d}
:root[data-theme="dark"] .prio-med{background:rgba(14,165,233,.15);color:#7dd3fc}
:root[data-theme="dark"] .prio-low{background:rgba(255,255,255,.06);color:#a1a1a6}

/* Tables */
.table{width:100%;border-collapse:collapse;font-size:12.5px}
.table th{
  text-align:left;font-weight:600;color:var(--text-3);
  font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;
  padding:9px 10px;border-bottom:1px solid var(--border);
}
.table td{padding:11px 10px;border-bottom:1px solid var(--border)}
.table tr:last-child td{border-bottom:none}
.table tr:hover td{background:var(--surface-2)}

/* Client card */
.client-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.client-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:11px;padding:15px;cursor:pointer;
  transition:.18s;box-shadow:var(--shadow-sm);position:relative;
}
.client-card:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:var(--border-strong)}
.client-head{display:flex;gap:11px;align-items:center;margin-bottom:12px}
.client-logo{
  width:42px;height:42px;border-radius:10px;display:grid;place-items:center;
  font-weight:700;font-size:14px;color:#fff;flex-shrink:0;letter-spacing:-.02em;
}
.client-name{font-size:13.5px;font-weight:600;line-height:1.2}
.client-segment{font-size:11px;color:var(--text-3);margin-top:2px}
.client-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding-top:11px;border-top:1px solid var(--border)}
.client-stat-val{font-size:13px;font-weight:600}
.client-stat-lbl{font-size:9.5px;color:var(--text-3);text-transform:uppercase;letter-spacing:.05em;margin-top:1px}

/* Modal */
.modal-bg{
  position:fixed;inset:0;background:rgba(0,0,0,.5);
  display:none;align-items:center;justify-content:center;
  z-index:100;backdrop-filter:blur(6px);padding:20px;
}
.modal-bg.open{display:flex;animation:fade .2s ease}
.modal{
  background:var(--surface);border:1px solid var(--border);
  border-radius:14px;width:100%;max-width:980px;max-height:90vh;
  overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--shadow-lg);
}
.modal-head{padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:14px}
.modal-close{
  margin-left:auto;width:30px;height:30px;border-radius:7px;
  background:transparent;border:none;color:var(--text-2);cursor:pointer;display:grid;place-items:center;
}
.modal-close:hover{background:var(--surface-hover);color:var(--text)}
.modal-tabs{display:flex;gap:0;padding:0 22px;border-bottom:1px solid var(--border);overflow-x:auto;align-items:stretch;min-height:42px}
.modal-tab{
  padding:12px 11px;font-size:11.5px;color:var(--text-2);
  cursor:pointer;border-bottom:2px solid transparent;font-weight:500;white-space:nowrap;
  flex-shrink:0;line-height:1.4;display:flex;align-items:center;
}
.modal-tab.active{color:var(--text);border-bottom-color:var(--text);font-weight:600}
.modal-tab:hover{color:var(--text)}
.modal-body{flex:1;overflow-y:auto;padding:22px}
.modal-pane{display:none}
.modal-pane.active{display:block}

/* Quick action buttons (in client modal) */
.qa-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-bottom:18px}
.qa{
  padding:9px 11px;background:var(--surface-2);border:1px solid var(--border);
  border-radius:8px;font-size:11.5px;cursor:pointer;color:var(--text);
  display:flex;align-items:center;gap:7px;font-family:inherit;
  transition:.15s;font-weight:500;text-align:left;width:100%;
}
.qa:hover{background:var(--surface-3);border-color:var(--border-strong);transform:translateY(-1px)}
.qa-icon{font-size:15px;line-height:1}

/* Info grid */
.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.info-item{padding:11px 12px;background:var(--surface-2);border-radius:8px;border:1px solid var(--border)}
.info-label{font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;font-weight:600}
.info-value{font-size:12.5px;font-weight:500;display:flex;align-items:center;gap:6px;justify-content:space-between}
.info-value .copy-btn{
  width:22px;height:22px;border-radius:5px;background:transparent;border:none;
  cursor:pointer;color:var(--text-3);display:grid;place-items:center;flex-shrink:0;
}
.info-value .copy-btn:hover{background:var(--surface-3);color:var(--text)}
.info-value .copy-btn svg{width:12px;height:12px}

/* Filter bar */
.filter-bar{display:flex;gap:6px;margin-bottom:18px;align-items:center;flex-wrap:wrap}
.filter-chip{
  padding:5px 11px;border-radius:7px;background:var(--surface);
  border:1px solid var(--border);font-size:11.5px;cursor:pointer;
  color:var(--text-2);transition:.15s;font-weight:500;
}
.filter-chip:hover{color:var(--text);background:var(--surface-hover)}
.filter-chip.active{background:var(--accent);color:var(--surface);border-color:var(--accent)}

/* Section title */
.section-title{font-size:11.5px;font-weight:600;color:var(--text-2);text-transform:uppercase;letter-spacing:.06em;margin:22px 0 10px}

/* Progress */
.meter{height:5px;background:var(--surface-3);border-radius:3px;overflow:hidden}
.meter-fill{height:100%;background:var(--accent);border-radius:3px;transition:width .3s}

/* Kanban */
.kanban{display:flex;gap:12px;overflow-x:auto;padding-bottom:8px}
.kanban-col{
  min-width:280px;flex:1;background:var(--surface);border:1px solid var(--border);
  border-radius:11px;padding:11px;display:flex;flex-direction:column;
  max-height:calc(100vh - 220px);box-shadow:var(--shadow-sm);
}
.kanban-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:11px;padding:0 3px}
.kanban-title{font-size:12.5px;font-weight:600;display:flex;align-items:center;gap:7px}
.kanban-count{font-size:10.5px;color:var(--text-3);background:var(--surface-3);padding:1px 7px;border-radius:8px;font-weight:600}
.kanban-cards{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:7px;padding:2px}
.kanban-card{
  background:var(--surface-2);border:1px solid var(--border);border-radius:8px;
  padding:11px;cursor:grab;transition:.15s;
}
.kanban-card:hover{border-color:var(--border-strong);background:var(--surface-3);box-shadow:var(--shadow-sm)}
.kanban-card:active{cursor:grabbing}
.kanban-card.dragging{opacity:.4}
.kanban-card-title{font-size:12.5px;font-weight:500;margin:6px 0;line-height:1.35}
.kanban-card-foot{display:flex;justify-content:space-between;align-items:center;margin-top:8px;font-size:10.5px;color:var(--text-3)}
.kanban-card .avatar{width:22px;height:22px;font-size:10px}
.kanban-add{padding:8px;border:1px dashed var(--border);border-radius:7px;text-align:center;color:var(--text-3);font-size:11.5px;cursor:pointer;transition:.15s}
.kanban-add:hover{border-color:var(--text-2);color:var(--text)}

/* Calendar */
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.cal-mobile-list{display:none}
.cal-head{background:var(--surface-2);padding:9px;text-align:center;font-size:10.5px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.05em}
.cal-day{background:var(--surface);min-height:90px;padding:7px;cursor:pointer;transition:.15s;position:relative}
.cal-day:hover{background:var(--surface-2)}
.cal-day.other{opacity:.35}
.cal-day.today .cal-num{background:var(--accent);color:var(--surface);border-radius:50%;width:20px;height:20px;display:grid;place-items:center}
.cal-num{font-size:11.5px;font-weight:600;margin-bottom:4px}
.cal-event{font-size:9.5px;padding:1px 6px;border-radius:4px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}

/* Notification panel */
.notif-pop{position:absolute;top:50px;right:18px;width:340px;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);display:none;z-index:50}
.notif-pop.open{display:block;animation:fade .15s}
.notif-pop-head{padding:13px 16px;border-bottom:1px solid var(--border);font-weight:600;font-size:12.5px;display:flex;justify-content:space-between;align-items:center}
.notif-list{max-height:380px;overflow-y:auto;padding:5px}
.notif-item{padding:10px;border-radius:8px;cursor:pointer;display:flex;gap:9px}
.notif-item:hover{background:var(--surface-2)}
.notif-dot{width:7px;height:7px;border-radius:50%;background:var(--text);flex-shrink:0;margin-top:6px}

/* Toast */
.toast-wrap{position:fixed;bottom:24px;right:24px;z-index:200;display:flex;flex-direction:column;gap:8px}
.toast{
  background:var(--surface);border:1px solid var(--border);box-shadow:var(--shadow-lg);
  border-radius:10px;padding:11px 15px;font-size:12.5px;font-weight:500;
  display:flex;align-items:center;gap:9px;animation:slideUp .25s ease;
  min-width:240px;
}
.toast.success{border-left:3px solid var(--success)}
.toast.info{border-left:3px solid var(--info)}
@keyframes slideUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* Checklist (operacional) */
.collab-tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:14px}
.collab-tab{
  padding:8px 14px;background:var(--surface);border:1px solid var(--border);
  border-radius:9px;font-size:12px;cursor:pointer;color:var(--text-2);
  display:flex;align-items:center;gap:8px;font-weight:500;transition:.15s;
  white-space:nowrap;flex-shrink:0;
}
.collab-tab:hover{background:var(--surface-hover);color:var(--text)}
.collab-tab.active{background:var(--accent);color:var(--surface);border-color:var(--accent)}
.collab-tab .avatar{width:22px;height:22px;font-size:10px;background:var(--surface-3);color:var(--text)}
.collab-tab.active .avatar{background:rgba(255,255,255,.2);color:var(--surface)}

.check-item{
  display:flex;align-items:flex-start;gap:11px;padding:13px;
  background:var(--surface);border:1px solid var(--border);border-radius:10px;
  margin-bottom:7px;transition:.15s;
}
.check-item:hover{border-color:var(--border-strong)}
.check-item.done{opacity:.6}
.check-item.done .check-title{text-decoration:line-through;color:var(--text-2)}
.check-box{
  width:18px;height:18px;border-radius:5px;border:1.5px solid var(--border-strong);
  cursor:pointer;flex-shrink:0;margin-top:1px;transition:.15s;
  display:grid;place-items:center;background:var(--surface);
}
.check-box.checked{background:var(--accent);border-color:var(--accent)}
.check-box.checked::after{content:'✓';color:var(--surface);font-size:12px;font-weight:700}
.check-body{flex:1;min-width:0}
.check-title{font-size:13px;font-weight:500;line-height:1.35}
.check-meta{display:flex;gap:10px;align-items:center;margin-top:6px;font-size:11px;color:var(--text-3);flex-wrap:wrap}

/* Team profile */
.profile-head{
  background:var(--surface);border:1px solid var(--border);border-radius:14px;
  padding:24px;margin-bottom:18px;display:flex;gap:20px;align-items:center;
  box-shadow:var(--shadow-sm);
}
.profile-avatar{
  width:80px;height:80px;border-radius:50%;display:grid;place-items:center;
  color:#fff;font-weight:700;font-size:28px;flex-shrink:0;letter-spacing:-.03em;
}
.profile-name{font-size:22px;font-weight:700;letter-spacing:-.02em}
.profile-role{font-size:13px;color:var(--text-2);margin-top:3px}
.profile-meta{display:flex;gap:18px;margin-top:10px;font-size:12px;color:var(--text-3);flex-wrap:wrap}

/* Ponto card */
.ponto-clock{
  text-align:center;padding:30px 20px;background:var(--surface);
  border:1px solid var(--border);border-radius:14px;margin-bottom:16px;
}
.ponto-time{font-size:46px;font-weight:700;letter-spacing:-.04em;line-height:1}
.ponto-date{font-size:12px;color:var(--text-2);margin-top:8px;text-transform:capitalize}
.ponto-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:18px}
.ponto-btn{
  padding:14px 12px;border-radius:10px;border:1px solid var(--border);
  background:var(--surface-2);color:var(--text);font-weight:600;cursor:pointer;
  font-family:inherit;font-size:12px;transition:.15s;display:flex;flex-direction:column;
  align-items:center;gap:6px;
}
.ponto-btn:hover{background:var(--surface-3);border-color:var(--border-strong);transform:translateY(-2px)}
.ponto-btn.done{background:var(--success-soft);color:var(--success-text);border-color:var(--success)}
.ponto-btn .icon{font-size:20px}

/* Acessos */
.acesso-card{
  background:var(--surface-2);border:1px solid var(--border);border-radius:10px;
  padding:14px;margin-bottom:8px;display:flex;align-items:center;gap:14px;
}
.acesso-platform{
  width:38px;height:38px;border-radius:9px;display:grid;place-items:center;
  font-size:18px;flex-shrink:0;background:var(--surface);border:1px solid var(--border);
}
.acesso-info{flex:1;min-width:0}
.acesso-name{font-size:13px;font-weight:600}
.acesso-login{font-size:11.5px;color:var(--text-2);margin-top:2px;font-family:'SF Mono',Menlo,monospace}
.acesso-pwd{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--text-2);font-family:'SF Mono',Menlo,monospace;letter-spacing:.05em}
.acesso-actions{display:flex;gap:4px}

/* Career timeline */
.timeline{position:relative;padding-left:24px;margin-top:14px}
.timeline::before{content:'';position:absolute;left:7px;top:0;bottom:0;width:2px;background:var(--border)}
.tl-item{position:relative;padding-bottom:18px}
.tl-item::before{
  content:'';position:absolute;left:-21px;top:5px;width:14px;height:14px;
  border-radius:50%;background:var(--surface);border:2px solid var(--accent);
}
.tl-item.success::before{border-color:var(--success);background:var(--success)}
.tl-date{font-size:10.5px;color:var(--text-3);font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-bottom:3px}
.tl-title{font-size:13px;font-weight:600;margin-bottom:3px}
.tl-desc{font-size:11.5px;color:var(--text-2)}

/* Toggle */
.toggle{width:34px;height:20px;background:var(--surface-3);border-radius:10px;position:relative;cursor:pointer;transition:.2s;flex-shrink:0;border:1px solid var(--border)}
.toggle::after{content:'';position:absolute;left:2px;top:1px;width:14px;height:14px;border-radius:50%;background:var(--surface);transition:.2s;box-shadow:0 1px 2px rgba(0,0,0,.2)}
.toggle.on{background:var(--accent);border-color:var(--accent)}
.toggle.on::after{left:17px;background:var(--surface)}

/* File grid */
.file-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:11px}
.file{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:14px;text-align:center;cursor:pointer;transition:.15s;box-shadow:var(--shadow-sm)}
.file:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:var(--border-strong)}
.file-icon{width:42px;height:42px;border-radius:9px;margin:0 auto 8px;display:grid;place-items:center;font-size:20px;background:var(--surface-3)}
.file-name{font-size:11.5px;font-weight:600;margin-bottom:2px;word-break:break-word;line-height:1.3}
.file-meta{font-size:10px;color:var(--text-3)}

/* Helpers */
.flex{display:flex}.gap-2{gap:8px}.gap-3{gap:12px}
.mb-2{margin-bottom:8px}.mb-3{margin-bottom:12px}.mb-4{margin-bottom:16px}
.mt-3{margin-top:12px}.mt-4{margin-top:16px}
.text-sm{font-size:12px}.text-xs{font-size:11px}
.text-mu{color:var(--text-2)}.text-3{color:var(--text-3)}
.font-bold{font-weight:700}.font-semi{font-weight:600}
.center{text-align:center}
.divider{height:1px;background:var(--border);margin:18px 0}

/* ============================================================
   MOBILE / RESPONSIVE v2 — Touch-friendly (Apple HIG 44px)
   ============================================================ */
.mobile-menu-btn{
  display:none;width:44px;height:44px;border-radius:10px;
  background:transparent;border:1px solid transparent;
  align-items:center;justify-content:center;cursor:pointer;
  color:var(--text);transition:.15s;flex-shrink:0;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
.mobile-refresh-btn{
  display:none;width:44px;height:44px;border-radius:10px;
  background:transparent;border:1px solid transparent;
  align-items:center;justify-content:center;cursor:pointer;
  color:var(--text);transition:.15s;flex-shrink:0;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
.mobile-back-btn{
  display:none;width:44px;height:44px;border-radius:10px;
  background:transparent;border:1px solid transparent;
  align-items:center;justify-content:center;cursor:pointer;
  color:var(--text);transition:.15s;flex-shrink:0;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
.mobile-menu-btn:active{background:var(--surface-3);transform:scale(.94)}
.mobile-menu-btn svg{width:22px;height:22px;pointer-events:none}
.mobile-brand{display:none;align-items:center;gap:8px;flex-shrink:0;pointer-events:none}
.mobile-brand .brand-logo{width:30px;height:30px;font-size:11px;border-radius:7px}
.mobile-brand .brand-name{font-size:14px;font-weight:700;letter-spacing:-.02em}
.sidebar-overlay{
  display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);
  z-index:9998;backdrop-filter:blur(2px);
  animation:fade .2s ease;
  -webkit-tap-highlight-color:transparent;
}
.sidebar-close{
  display:none;width:40px;height:40px;border-radius:10px;
  background:transparent;border:1px solid transparent;
  align-items:center;justify-content:center;cursor:pointer;
  color:var(--text);transition:.15s;flex-shrink:0;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
.sidebar-close:active{background:var(--surface-3);transform:scale(.94)}
.sidebar-close svg{width:20px;height:20px;pointer-events:none}

/* TABLET ≤1024px — sidebar mais estreita, content menor */
@media (max-width:1024px){
  .sidebar{width:220px}
  .content{padding:20px 22px}
  .search{max-width:300px}
  .search kbd{display:none}
}

/* ============================================================
   MOBILE ≤768px — sidebar drawer + touch targets ≥44px
   ============================================================ */
@media (max-width:768px){
  /* Remove sticky-hover (mantém só efeito :active no toque) */
  *{-webkit-tap-highlight-color:transparent !important}
  button,a,.nav-item,.btn,.icon-btn,.quick,.card,
  .cli-btn,.client-card,.cron-cli,.list-item,.modal-tab,
  .ponto-tab,.filter-chip,.tab,.search-result,.novo-item,
  .notif-item,.fb-collab,.cap-row,.team-card{
    touch-action:manipulation;
  }

  .mobile-menu-btn{display:inline-flex}
  .mobile-brand{display:flex}
  .sidebar-close{display:inline-flex}

  /* SIDEBAR drawer */
  .sidebar{
    position:fixed;left:-300px;top:0;bottom:0;
    width:288px;max-width:85vw;z-index:9999;
    transition:left .28s cubic-bezier(.4,0,.2,1);
    box-shadow:none;overflow-y:auto;
    -webkit-overflow-scrolling:touch;
  }
  .sidebar.open{left:0;box-shadow:0 20px 60px rgba(0,0,0,.4)}
  .sidebar-overlay.open{display:block}

  /* Nav items maiores no mobile (touch-friendly) */
  .nav{padding:10px 8px}
  .nav-item{
    padding:13px 12px;font-size:14px;min-height:44px;
    border-radius:9px;margin-bottom:2px;
  }
  .nav-item svg{width:18px;height:18px}
  .nav-label{font-size:11px;padding:14px 12px 8px}
  .brand{padding:16px 16px 14px}
  .user-card{padding:12px}
  .user-card .icon-btn{width:40px;height:40px}

  /* TOPBAR */
  .topbar{
    padding:0 8px;gap:6px;height:56px;
    overflow:visible;
  }
  .search{flex:1;max-width:none;min-width:0}
  .search input{
    padding:9px 12px 9px 32px;font-size:14px;
    height:40px;
  }
  .search svg{left:9px;width:15px;height:15px}
  .search input::placeholder{color:var(--text-3);font-size:13px}
  .top-actions{gap:2px;margin-left:0}
  /* Botão NOVO + e ícones com touch ≥44px */
  .top-actions .btn-primary{
    width:44px;height:44px;padding:0;border-radius:10px;
    justify-content:center;font-size:0;
  }
  .top-actions .btn-primary svg{
    width:18px;height:18px;margin:0;stroke-width:3;
  }
  .top-actions .icon-btn{width:44px;height:44px;border-radius:10px}
  .top-actions .icon-btn svg{width:18px;height:18px}

  /* CONTENT */
  .content{padding:14px 12px}

  /* Page header */
  .page-header{
    flex-direction:column;align-items:stretch;gap:10px;margin-bottom:16px;
  }
  .page-title{font-size:19px}
  .page-subtitle{font-size:12px}
  .page-actions{flex-wrap:wrap;gap:6px}
  .page-actions .btn{font-size:13px;padding:10px 14px;min-height:40px}

  /* Grids — tudo em coluna */
  .grid-2,.grid-2e,.grid-3,.grid-4{grid-template-columns:1fr !important;gap:10px}
  .stat-grid{grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:14px}
  .stat{padding:14px;min-height:80px}
  .stat-value{font-size:19px}
  .stat-label{font-size:11px}
  .quick-row{grid-template-columns:repeat(2,1fr);gap:8px}
  .quick{padding:14px;min-height:64px}
  .quick-title{font-size:12.5px}
  .quick-sub{font-size:10.5px}
  .quick-icon{width:36px;height:36px;font-size:15px}

  /* Cards */
  .card{padding:14px;border-radius:12px}
  .card-title{font-size:13px}

  /* Tabelas — scroll horizontal suave */
  .table-wrap,.tbl-wrap,.scroll-x,
  .ponto-table-wrap,.cron-wrap{
    overflow-x:auto;-webkit-overflow-scrolling:touch;
    margin:0 -12px;padding:0 12px;
  }
  .table{font-size:12px;min-width:520px}
  .table th,.table td{padding:10px 8px;white-space:nowrap}
  /* botões dentro de tabelas — alvo maior */
  .table .btn,.table .btn-sm,.table .icon-btn{
    min-height:36px;min-width:36px;padding:8px 12px;
  }

  /* Modal — quase full screen */
  .modal{
    width:96vw !important;max-width:96vw !important;
    max-height:94vh;border-radius:14px;margin:0;
  }
  .modal-head{padding:14px 16px;gap:10px}
  .modal-head h2,.modal-head .modal-title{font-size:15px}
  .modal-close{
    width:40px !important;height:40px !important;
    min-width:40px;font-size:18px;border-radius:9px;
  }
  .modal-tabs{padding:0 8px;gap:0;flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch}
  .modal-tab{padding:13px 14px;font-size:12.5px;white-space:nowrap;flex-shrink:0;min-height:44px}
  .modal-body{padding:14px}
  .modal-bg{padding:6px;align-items:flex-start;padding-top:20px}

  /* Popups (notif, novo) — full width acima de tudo */
  .notif-pop{
    width:calc(100vw - 12px);right:6px;left:6px;top:60px;
    max-height:75vh;overflow-y:auto;z-index:9990;
    -webkit-overflow-scrolling:touch;
  }
  .notif-item{padding:14px 12px;min-height:56px}
  .novo-menu{
    width:calc(100vw - 12px);right:6px;left:auto;top:54px;
    max-height:75vh;overflow-y:auto;z-index:9990;
    -webkit-overflow-scrolling:touch;
  }
  .novo-item{padding:13px 14px;min-height:52px;font-size:14px}
  .search-results{
    width:calc(100vw - 16px);left:-4px;right:auto;top:46px;
    max-height:65vh;z-index:9990;
  }
  .search-result{padding:12px 12px;min-height:48px;font-size:13px}

  /* Botões padrão (mais altos pra toque) */
  .btn{padding:10px 14px;font-size:13px;min-height:40px;border-radius:9px}
  .btn-sm{padding:7px 11px;font-size:12px;min-height:34px}
  .btn-primary{min-height:42px}
  .icon-btn{width:40px;height:40px;border-radius:9px}
  .icon-btn svg{width:18px;height:18px}

  /* Inputs (evita zoom iOS com 14px+) */
  input,select,textarea{
    font-size:16px !important;
    min-height:42px;
  }
  textarea{min-height:80px}

  /* Toast pos */
  .toast-wrap{left:8px;right:8px;bottom:16px;max-width:none;z-index:9995}

  /* Cronograma — mantem planilha no mobile com scroll horizontal touch */
  .cron-mobile{display:none}
  .cron-scroll-hint{display:block!important}
  .cron-table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:10px}
  .cron-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
  .cron-table{min-width:900px;font-size:11.5px}
  .cron-table th{font-size:9.5px!important;padding:8px 6px!important;position:sticky;top:0;background:var(--surface)!important;z-index:5}
  .cron-table td{padding:6px 5px!important;min-height:48px;vertical-align:middle}
  .cron-table input,.cron-table select{font-size:13px!important;min-height:36px!important;padding:6px 8px!important}
  /* Primeira coluna (nome do cliente) congelada à esquerda pra dar referencia ao deslizar */
  .cron-table th:first-child{position:sticky;left:0;background:var(--surface)!important;z-index:6;box-shadow:2px 0 4px rgba(0,0,0,.08);min-width:160px;max-width:160px}
  .cron-table td:first-child{position:sticky;left:0;z-index:4;box-shadow:2px 0 4px rgba(0,0,0,.08);min-width:160px;max-width:160px}
  /* Cor de fundo da primeira coluna acompanha a cor de status da linha */
  .cron-table tr td:first-child{background:var(--surface)!important}
  .cron-table tr[data-status="apenas-trafego"] td:first-child{background:#bae6fd!important;color:#0c4a6e!important}
  .cron-table tr[data-status="agendado-mlabs"] td:first-child{background:#86efac!important;color:#14532d!important}
  .cron-table tr[data-status="agendado-meta"] td:first-child{background:#86efac!important;color:#14532d!important}
  .cron-table tr[data-status="aguardando-aprov"] td:first-child{background:#d1fae5!important;color:#065f46!important}
  .cron-table tr[data-status="trello-vini"] td:first-child{background:#ddd6fe!important;color:#4c1d95!important}
  .cron-table tr[data-status="mlabs-vini"] td:first-child{background:#ddd6fe!important;color:#4c1d95!important}
  .cron-table tr[data-status="desenvolvimento"] td:first-child{background:#fde68a!important;color:#78350f!important}
  .cron-table tr[data-status="cal-pronto"] td:first-child{background:#e5e7eb!important;color:#374151!important}
  .cron-table tr[data-status="cancelado"] td:first-child{background:#fecaca!important;color:#7f1d1d!important}
  /* Dica visual de scroll */
  .cron-scroll-hint{display:block;text-align:center;font-size:11px;color:var(--text-3);padding:6px 0;font-style:italic}

  /* Calendário mobile — visual limpo: dia + dots, texto detalhado vira lista */
  .cal-grid,.cal-month,.cron-table,.calendar-grid{font-size:11px}
  .cal-day,.cal-cell{min-height:62px;padding:6px 4px;font-size:11px;display:flex;flex-direction:column;align-items:flex-start}
  .cal-day .cal-num{font-size:13px;font-weight:600;margin-bottom:3px}
  .cal-day.today .cal-num{background:var(--accent);color:#fff;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;margin:0 auto 3px;font-size:12px}
  /* Esconde os pequenos cards de evento — fica so o emoji-marker no canto */
  .cal-day .cal-event{display:none}
  /* Mas mostra dots embaixo do numero pra dar pista do que tem */
  .cal-day .cal-dots{display:flex;flex-wrap:wrap;gap:2px;margin-top:auto;align-items:center;justify-content:center;width:100%}
  .cal-day .cal-dots .cal-dot{width:6px;height:6px;border-radius:50%}
  /* Botoes de navegacao do mes maiores */
  .page-actions button{min-width:42px;min-height:42px;padding:0 10px}
  /* Botoes texto continuam OK */
  .page-actions .btn{padding:8px 12px;min-width:auto}
  /* Filtros do calendario com toque maior */
  .filter-bar .badge{padding:8px 11px;font-size:11.5px;min-height:34px;display:inline-flex;align-items:center}
  /* Lista mobile de eventos do mes (so aparece em mobile) */
  .cal-mobile-list{display:block;margin-top:14px}
  .cal-mobile-day{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:10px 12px;margin-bottom:7px}
  .cal-mobile-day-head{font-size:12px;font-weight:700;color:var(--text);margin-bottom:6px;display:flex;justify-content:space-between;align-items:center}
  .cal-mobile-event{padding:6px 9px;border-radius:6px;font-size:12px;font-weight:500;margin-bottom:4px;display:flex;align-items:center;gap:7px;cursor:pointer}
  .cal-mobile-event:last-child{margin-bottom:0}

  /* Chart altura menor */
  .chart-box{height:220px}

  /* Filtros */
  .filter-chip,.filter-bar,.filters{flex-wrap:wrap;gap:6px}
  .filter-chip{min-height:36px;padding:8px 12px;font-size:12px}

  /* Forms */
  .form-row,.form-grid{grid-template-columns:1fr !important}
  .form-row > div,.form-grid > div{margin-bottom:4px}

  /* Ponto planilha */
  .ponto-grid,.planilha-grid{grid-template-columns:1fr !important}
  .ponto-tab,.ponto-tabs{overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch}
  .ponto-tab > *,.ponto-tabs > *{flex-shrink:0;min-height:44px;padding:11px 14px}

  /* Login screen */
  .login-card{width:92vw;max-width:380px;padding:24px 20px}
  .login-card input{font-size:16px;padding:12px 14px;min-height:46px}
  .login-btn{padding:13px;font-size:14px;min-height:48px}

  /* Back to top */
  .back-top{
    bottom:calc(80px + env(safe-area-inset-bottom,0px));
    right:14px;width:46px;height:46px;
  }

  /* Ctx menu adaptado (long-press) */
  .ctx-menu{
    min-width:200px;font-size:14px;
    max-width:calc(100vw - 16px);
    z-index:9997;
  }
  .ctx-menu > div,.ctx-menu .ctx-item{
    padding:13px 14px;min-height:44px;
  }

  /* Tabs em geral */
  .tabs,.tab-bar{
    overflow-x:auto;-webkit-overflow-scrolling:touch;flex-wrap:nowrap;
    margin:0 -12px;padding:0 12px;
  }
  .tab,.tab-item{flex-shrink:0;white-space:nowrap;min-height:44px;padding:12px 16px}

  /* CLI grid botões */
  .cli-btn{padding:18px 12px;min-height:120px}
  .cli-btn .name{font-size:13px}

  /* Collab tabs */
  .collab-tab{padding:10px 14px;font-size:12.5px;min-height:42px}

  /* Garante que elementos com onclick respondam ao toque */
  [onclick]{cursor:pointer;-webkit-tap-highlight-color:transparent}

  /* Body sem scroll horizontal */
  html,body{overflow-x:hidden;width:100%}
  .app{width:100%;overflow-x:hidden}
  .main{width:100%;min-width:0}
  .content{width:100%;max-width:100%;box-sizing:border-box}
}

/* ============================================================
   SMALL MOBILE ≤480px — ajustes finos
   ============================================================ */
@media (max-width:480px){
  .topbar{padding:0 6px;gap:4px;height:54px}
  .mobile-brand .brand-name{display:none}
  .mobile-brand .brand-logo{width:32px;height:32px}
  .content{padding:12px 10px}
  .stat-grid{grid-template-columns:1fr;gap:8px}
  .quick-row{grid-template-columns:1fr}
  .page-title{font-size:18px}
  .modal-tab{padding:12px 11px;font-size:12px}
  .icon-btn{width:40px;height:40px}
  .icon-btn svg{width:17px;height:17px}
  .mobile-menu-btn{width:42px;height:42px}
  .top-actions{gap:0}
  .top-actions .btn-primary,.top-actions .icon-btn{width:42px;height:42px}
  .search input{font-size:14px;padding-left:30px}
}

/* ============================================================
   MOBILE FIXES — telas novas (CRM redesign, Pagamentos, Ferias multi)
   ============================================================ */
@media (max-width:900px){
  /* CRM redesign 2-col vira 1 */
  .crm-grid{grid-template-columns:1fr !important;gap:10px}
  .crm-grid > .card:first-child{position:relative !important;top:auto !important;max-height:none}
  .crm-cli-item{padding:10px 12px;min-height:48px}
  .crm-cli-item div[style*="overflow:hidden"]{max-width:200px}
  .crm-tl-item{padding-left:24px;padding-bottom:14px}
  .crm-tl-card{padding:10px 12px}
}

@media (max-width:768px){
  /* Andre — grid de clientes vira 2 col, depois 1 col */
  div[style*="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))"]{
    grid-template-columns:repeat(2,1fr) !important;gap:6px !important;
  }
  /* Cards de cliente no CRM saude */
  div[style*="grid-template-columns:repeat(auto-fill,minmax(290px,1fr))"]{
    grid-template-columns:1fr !important;
  }
  div[style*="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))"]{
    grid-template-columns:1fr !important;
  }
  /* Ferias periodos — coluna inicio/fim */
  .periodo-item div[style*="grid-template-columns:1fr 1fr"]{
    grid-template-columns:1fr !important;gap:8px !important;
  }
  /* Pagamentos tabelas — scroll horizontal forcado */
  .card div[style*="overflow-x:auto"] table{min-width:600px}
  /* Stat cards menores no mobile */
  .stat-card{padding:12px;min-height:auto}
  .stat-card .stat-value,.stat-card div[style*="font-size:22px"],
  .stat-card div[style*="font-size:24px"]{font-size:18px !important}
  .stat-card .stat-label{font-size:10.5px}

  /* Modal cliente — tabs scrollam */
  .modal-tabs{padding:0 4px}
  .modal-tab{padding:11px 10px;font-size:11.5px}

  /* Captacao card grande */
  .cap-card{padding:14px}
  .cap-card-name{font-size:14px}

  /* Forms em 2 colunas viram 1 */
  div[style*="grid-template-columns:1fr 1fr;gap:10px"],
  div[style*="grid-template-columns:1fr 1fr;gap:12px"],
  div[style*="grid-template-columns:2fr 1fr"],
  div[style*="grid-template-columns:2fr 1fr auto"],
  div[style*="grid-template-columns:1fr 60px 110px"],
  div[style*="grid-template-columns:1fr 1fr 1fr"]{
    grid-template-columns:1fr !important;gap:8px !important;
  }

  /* Botões de "+ Nova captação" etc com fonte menor */
  .btn-primary{font-size:13px}

  /* Dashboard cards de demandas/captacoes */
  div[style*="display:flex;align-items:center;gap:12px"][style*="padding:10px"]{
    flex-wrap:wrap;gap:8px !important;
  }

  /* Chart.js canvas — altura menor */
  canvas{max-height:240px !important}

  /* Andre — grid de clientes em 1 col no celular */
  div[style*="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))"]{
    grid-template-columns:1fr !important;
  }

  /* Banner deadline */
  .deadline-banner{padding:10px 12px;flex-wrap:wrap;gap:6px}
  .deadline-banner .db-text{font-size:12px;flex:1 1 100%}
  .deadline-banner .db-go{font-size:11px}
}

@media (max-width:480px){
  /* Force tudo em 1 coluna */
  .stat-grid{grid-template-columns:1fr !important}
  .crm-grid{gap:8px}
  /* Tables — scroll */
  table{font-size:11.5px}
  th,td{padding:8px 6px !important;white-space:nowrap}
  /* Modal central */
  #pagVarModal > div,#trfModal > div,#relacModal > div,
  #eventoModal > div,#feriasModal > div,#detClienteModal > div,
  #selFeriasModal > div,#gestaoFeriasModal > div{
    max-width:96vw !important;width:96vw !important;
    max-height:92vh !important;border-radius:12px !important;
  }
  /* Reduz padding modais */
  div[style*="padding:18px 22px"]{padding:14px 16px !important}
  /* Texto info-label mais compacto */
  .info-label{font-size:10.5px;letter-spacing:.04em}
  .info-value{font-size:12.5px}
  /* Page head — coluna */
  .page-head{flex-direction:column;align-items:stretch;gap:10px}
  .page-head > div:last-child{display:flex;flex-wrap:wrap;gap:6px}
}

/* iOS Safari — safe areas (notch) */
@supports (padding:max(0px)){
  .topbar{padding-top:max(0px, env(safe-area-inset-top))}
  .content{padding-bottom:max(20px, env(safe-area-inset-bottom))}
  .sidebar{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
}


/* Safe-area iOS / notch */
@supports (padding:env(safe-area-inset-bottom)){
  @media (max-width:768px){
    .content{padding-bottom:calc(14px + env(safe-area-inset-bottom))}
    .toast-wrap{bottom:calc(16px + env(safe-area-inset-bottom))}
    .sidebar{padding-bottom:env(safe-area-inset-bottom)}
  }
}

/* Orientação landscape no celular — sidebar não cobre tudo */
@media (max-width:900px) and (orientation:landscape){
  .sidebar{max-width:60vw;width:260px}
  .topbar{height:48px}
  .mobile-menu-btn,.top-actions .icon-btn,.top-actions .btn-primary{width:40px;height:40px}
  .content{padding:10px 14px}
}

/* DEVICES SEM HOVER (touch puro) — remove hover sticky */
@media (hover:none){
  .nav-item:hover,.btn:hover,.icon-btn:hover,
  .card-hover:hover,.quick:hover,.cli-btn:hover,
  .list-item:hover,.client-card:hover,.modal-tab:hover,
  .novo-item:hover,.notif-item:hover,.search-result:hover,
  .mobile-menu-btn:hover,.sidebar-close:hover{
    background:initial;transform:none;box-shadow:initial;
  }
  /* Mantém :active pra feedback visual */
  .nav-item:active,.btn:active,.icon-btn:active,
  .quick:active,.cli-btn:active,.modal-tab:active,
  .novo-item:active,.notif-item:active,.search-result:active{
    background:var(--surface-hover);
  }
}

/* Novo menu dropdown */
.novo-menu{position:absolute;top:42px;right:0;width:230px;background:var(--surface);border:1px solid var(--border);border-radius:11px;box-shadow:var(--shadow-lg);padding:6px;z-index:60;display:none;animation:fade .15s}
.novo-menu.open{display:block}
.novo-item{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:8px;cursor:pointer;font-size:13px;transition:.15s}
.novo-item:hover{background:var(--surface-hover)}
.novo-item span{display:flex;flex-direction:column;line-height:1.25}

/* Busca global resultado */
.search-results{position:absolute;top:42px;left:0;right:0;background:var(--surface);border:1px solid var(--border);border-radius:11px;box-shadow:var(--shadow-lg);padding:6px;z-index:55;display:none;max-height:380px;overflow-y:auto}
.search-results.open{display:block}
.search-section{font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;padding:8px 10px 5px;font-weight:600}
.search-result{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:7px;cursor:pointer;font-size:13px}
.search-result:hover{background:var(--surface-hover)}
.search-empty{padding:24px;text-align:center;color:var(--text-3);font-size:12.5px}

/* Empty state */
.empty-state{padding:36px 22px;text-align:center;color:var(--text-3)}
.empty-state .ico{font-size:36px;opacity:.4;margin-bottom:8px}
.empty-state .ttl{font-size:14px;font-weight:600;color:var(--text-2);margin-bottom:3px}
.empty-state .desc{font-size:12px}

/* Loading bar */
.load-bar{position:fixed;top:0;left:0;height:2px;background:var(--accent);width:0;z-index:200;transition:width .25s}

/* Floating back to top */
.back-top{position:fixed;bottom:24px;right:24px;width:42px;height:42px;border-radius:50%;background:var(--surface);border:1px solid var(--border-strong);box-shadow:var(--shadow);display:none;align-items:center;justify-content:center;cursor:pointer;color:var(--text);z-index:50;transition:.18s}
.back-top:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.back-top.show{display:flex}

/* Disabled hint pulse */
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}

/* Better focus state */
button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}

/* Search input field actually working */
.search input::placeholder{color:var(--text-3)}

/* ============ CRONOGRAMA — cores por status na linha inteira ============ */
.cron-table tr.cron-row-status td{transition:background .15s;font-size:12px}
.cron-table tr.cron-row-status td{padding:7px 8px !important;line-height:1.3}
.cron-table th{padding:6px 8px !important;font-size:10px}
/* Cards mobile do cronograma — escondido no desktop */
.cron-mobile{display:none}
.cron-mobile-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:11px;border-left:5px solid var(--accent);box-shadow:0 1px 3px rgba(0,0,0,.05)}
.cron-mobile-card-head{display:flex;align-items:center;gap:11px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--border)}
.cron-mobile-card-head .cron-mobile-name{font-weight:700;font-size:15px;line-height:1.2;color:var(--text)}
.cron-mobile-card-head .cron-mobile-seg{font-size:11.5px;color:var(--text-3);margin-top:2px}
/* Cada linha do card vira um bloco com label em cima e valor embaixo */
.cron-mobile-row{display:flex;flex-direction:column;gap:5px;margin-bottom:10px}
.cron-mobile-row:last-child{margin-bottom:0}
.cron-mobile-row > .lbl{font-weight:700;color:var(--text-2);font-size:11px;text-transform:uppercase;letter-spacing:.05em}
.cron-mobile-row > .val{display:flex;align-items:center;gap:8px;width:100%}
/* Inputs e selects dentro do card — tamanho confortavel + override do font 16px global */
.cron-mobile-card input[type="text"],
.cron-mobile-card input[type="number"],
.cron-mobile-card input[type="date"],
.cron-mobile-card select,
.cron-mobile-card textarea{
  background:var(--surface-2)!important;
  border:1px solid var(--border)!important;
  border-radius:8px!important;
  padding:10px 12px!important;
  font-size:14px!important;
  font-family:inherit!important;
  min-height:44px!important;
  color:var(--text)!important;
  width:100%!important;
  box-sizing:border-box;
}
.cron-mobile-card textarea{min-height:60px!important;resize:vertical}
/* Numeros (qtd) compactos */
.cron-mobile-card .num-input{max-width:75px!important;text-align:center!important;font-weight:700!important}
/* Linha do prazo com sub label */
.cron-mobile-deadline-sub{font-size:11.5px;font-weight:600;padding:6px 10px;border-radius:6px;background:var(--surface-2);white-space:nowrap}

/* Cores claras (pastel) na linha inteira por status */
.cron-table tr[data-status="apenas-trafego"] td{background:#bae6fd !important;color:#0c4a6e !important}
.cron-table tr[data-status="agendado-mlabs"] td{background:#86efac !important;color:#14532d !important}
.cron-table tr[data-status="agendado-meta"] td{background:#86efac !important;color:#14532d !important}
.cron-table tr[data-status="aguardando-aprov"] td{background:#d1fae5 !important;color:#065f46 !important}
.cron-table tr[data-status="trello-vini"] td{background:#ddd6fe !important;color:#4c1d95 !important}
.cron-table tr[data-status="mlabs-vini"] td{background:#ddd6fe !important;color:#4c1d95 !important}
.cron-table tr[data-status="desenvolvimento"] td{background:#fde68a !important;color:#78350f !important}
.cron-table tr[data-status="cal-pronto"] td{background:#e5e7eb !important;color:#374151 !important}
.cron-table tr[data-status="cancelado"] td{background:#fecaca !important;color:#7f1d1d !important;opacity:.7}
.cron-table tr[data-status="planejado"] td,
.cron-table tr:not([data-status]) td,
.cron-table tr[data-status=""] td{background:var(--surface) !important}

/* Hover sutil */
.cron-table tr.cron-row-status:hover td{filter:brightness(.97)}

/* Select transparente sobre a linha colorida */
.cron-status-select{background:rgba(255,255,255,.5);color:inherit;font-weight:600;border:1px solid rgba(0,0,0,.15)}
.cron-status-select option{background:var(--surface);color:var(--text)}

/* Inputs na linha ficam transparentes */
.cron-table tr.cron-row-status td input[type="number"],
.cron-table tr.cron-row-status td input[type="date"],
.cron-table tr.cron-row-status td input[type="text"],
.cron-table tr.cron-row-status td .cron-obs-input{
  background:rgba(255,255,255,.4) !important;
  color:inherit !important;
  font-weight:500;
}
.cron-table tr.cron-row-status td input::placeholder,
.cron-table tr.cron-row-status td .cron-obs-input::placeholder{color:rgba(0,0,0,.45)}

/* Logo e nome do cliente: fonte menor */
.cron-table .cron-cli-logo{width:26px !important;height:26px !important;font-size:10px !important;border-radius:6px}
.cron-table .cron-cli-name{font-size:12px !important;font-weight:600}
.cron-table .cron-cli .text-xs{font-size:10px !important}

/* Modo dark */
:root[data-theme="dark"] .cron-table tr[data-status="apenas-trafego"] td{background:#075985 !important;color:#bae6fd !important}
:root[data-theme="dark"] .cron-table tr[data-status="agendado-mlabs"] td,
:root[data-theme="dark"] .cron-table tr[data-status="agendado-meta"] td{background:#15803d !important;color:#dcfce7 !important}
:root[data-theme="dark"] .cron-table tr[data-status="aguardando-aprov"] td{background:#166534 !important;color:#d1fae5 !important}
:root[data-theme="dark"] .cron-table tr[data-status="trello-vini"] td,
:root[data-theme="dark"] .cron-table tr[data-status="mlabs-vini"] td{background:#5b21b6 !important;color:#ddd6fe !important}
:root[data-theme="dark"] .cron-table tr[data-status="desenvolvimento"] td{background:#92400e !important;color:#fed7aa !important}
:root[data-theme="dark"] .cron-table tr[data-status="cal-pronto"] td{background:#4b5563 !important;color:#e5e7eb !important}
:root[data-theme="dark"] .cron-table tr[data-status="cancelado"] td{background:#7f1d1d !important;color:#fecaca !important}
:root[data-theme="dark"] .cron-table tr.cron-row-status td input,
:root[data-theme="dark"] .cron-table tr.cron-row-status td .cron-obs-input{background:rgba(0,0,0,.2) !important}
:root[data-theme="dark"] .cron-status-select{background:rgba(0,0,0,.25);border-color:rgba(255,255,255,.2)}

/* ============ CAPTAÇÃO v2 — Lista + Mini-cal + Kanban ============ */

/* Cards de status (clicáveis pra filtrar) */
.cap-status-row{
  display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:14px;
}
.cap-status-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:11px;padding:14px;cursor:pointer;
  display:flex;flex-direction:column;align-items:flex-start;gap:4px;
  transition:.15s;font-family:inherit;text-align:left;
  position:relative;overflow:hidden;
}
.cap-status-card:hover{border-color:var(--border-strong);transform:translateY(-1px);box-shadow:var(--shadow-sm)}
.cap-status-card.active{
  background:var(--accent);color:var(--surface);border-color:var(--accent);
  box-shadow:0 4px 12px rgba(0,0,0,.15);
}
.cap-status-card.active .cap-status-lbl{color:var(--surface);opacity:.85}
.cap-status-card.active .cap-status-num{color:var(--surface)}
.cap-status-num{font-size:24px;font-weight:700;letter-spacing:-.03em;line-height:1;color:var(--text)}
.cap-status-lbl{font-size:11.5px;color:var(--text-2);font-weight:500;letter-spacing:.01em}
.cap-status-dot{
  width:8px;height:8px;border-radius:50%;
  position:absolute;top:14px;right:14px;
}

/* Toggle de visualização */
.view-toggle{
  display:flex;gap:4px;padding:4px;background:var(--surface-2);
  border-radius:9px;width:fit-content;margin-bottom:14px;border:1px solid var(--border);
  align-items:center;flex-wrap:wrap;
}
.view-toggle-btn{
  padding:7px 14px;border-radius:7px;background:transparent;border:none;
  font-size:12.5px;font-weight:600;color:var(--text-2);cursor:pointer;
  font-family:inherit;transition:.15s;
}
.view-toggle-btn:hover{color:var(--text)}
.view-toggle-btn.active{background:var(--surface);color:var(--text);box-shadow:var(--shadow-sm)}
.cap-day-filter{
  margin-left:8px;font-size:11.5px;color:var(--text-2);
  background:var(--accent-soft);padding:5px 10px;border-radius:6px;
  display:inline-flex;align-items:center;gap:4px;
}

/* Lista de captações */
.cap-list-wrap{display:flex;flex-direction:column;gap:18px}
.cap-list-group{}
.cap-list-group-head{
  display:flex;align-items:center;gap:10px;margin-bottom:8px;
  padding:0 4px;
}
.cap-list-group-label{
  font-size:12.5px;font-weight:700;color:var(--text);letter-spacing:.005em;
}
.cap-list-group-count{
  font-size:10px;background:var(--surface-3);color:var(--text-2);
  padding:2px 7px;border-radius:6px;font-weight:600;
}
.cap-list-group-body{display:flex;flex-direction:column;gap:6px}

/* Card de captação compacto */
.cap-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:11px;padding:12px 14px;
  display:flex;align-items:center;gap:14px;
  cursor:pointer;transition:.15s;
}
.cap-card:hover{border-color:var(--border-strong);box-shadow:var(--shadow-sm);transform:translateX(2px)}
.cap-card.urgent{border-left:3px solid var(--warning)}
/* Captacoes ja passadas/finalizadas ficam desbotadas pra destacar as proximas */
.cap-card.passada{opacity:.55;background:var(--surface-2)}
.cap-card.passada:hover{opacity:.85}
.cap-card.passada .cap-card-title{color:var(--text-2);font-weight:600}
.cap-card-date{
  width:56px;height:62px;border-radius:9px;flex-shrink:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:4px;
}
.cap-card-day{font-size:20px;font-weight:800;line-height:1;letter-spacing:-.03em}
.cap-card-month{font-size:9.5px;text-transform:uppercase;font-weight:700;letter-spacing:.06em;margin-top:2px}
.cap-card-wd{font-size:8.5px;text-transform:uppercase;opacity:.7;margin-top:2px;letter-spacing:.05em}
.cap-card-body{flex:1;min-width:0}
.cap-card-top{display:flex;align-items:center;gap:8px;margin-bottom:3px}
.cap-card-title{font-size:13.5px;font-weight:700;color:var(--text);letter-spacing:-.01em}
.cap-card-client{font-size:11.5px;color:var(--text-2);font-weight:600;margin-bottom:4px}
.cap-card-meta{display:flex;gap:10px;flex-wrap:wrap;font-size:11px;color:var(--text-3)}
.cap-card-actions{display:flex;gap:2px;flex-shrink:0;opacity:0;transition:.15s}
.cap-card:hover .cap-card-actions{opacity:1}
.cap-card-actions .icon-btn{width:32px;height:32px}
.cap-card-actions .icon-btn svg{width:14px;height:14px}

/* Mini calendário compacto */
.cap-cal-wrap{
  background:var(--surface);border:1px solid var(--border);
  border-radius:12px;padding:14px;margin-bottom:14px;
}
.cap-cal-head{
  display:flex;align-items:center;gap:8px;margin-bottom:10px;
}
.cap-cal-title{
  font-size:14px;font-weight:700;color:var(--text);
  flex:1;text-align:center;letter-spacing:-.01em;
}
.cap-cal-compact{
  display:grid;grid-template-columns:repeat(7,1fr);gap:3px;
}
.cap-cal-wd{
  font-size:9.5px;color:var(--text-3);text-transform:uppercase;
  letter-spacing:.06em;font-weight:600;text-align:center;padding:6px 0;
}
.cap-cal-cell{
  aspect-ratio:1;border-radius:7px;background:var(--surface-2);
  display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
  padding:5px 4px;cursor:pointer;transition:.12s;border:1px solid transparent;
  position:relative;
}
.cap-cal-cell:hover{background:var(--surface-3);border-color:var(--border)}
.cap-cal-cell.other{visibility:hidden}
.cap-cal-cell.has{background:var(--surface);border-color:var(--border-strong)}
.cap-cal-cell.today{background:var(--accent);color:var(--surface);font-weight:700}
.cap-cal-cell.today .cap-cal-num{color:var(--surface)}
.cap-cal-cell.selected{
  background:var(--accent-soft);border-color:var(--accent);
  box-shadow:0 0 0 2px var(--accent) inset;
}
.cap-cal-num{font-size:12.5px;font-weight:600;color:var(--text);line-height:1}
.cap-cal-dots{
  display:flex;gap:2px;align-items:center;margin-top:auto;
  padding-bottom:1px;flex-wrap:wrap;justify-content:center;
}
.cap-cal-dot{width:5px;height:5px;border-radius:50%;display:block}
.cap-cal-more{font-size:8px;color:var(--text-3);font-weight:700;margin-left:1px}

/* Kanban */
.cap-kanban{
  display:grid;grid-template-columns:repeat(4,1fr);gap:10px;
}
.cap-kanban-col{
  background:var(--surface-2);border:1px solid var(--border);
  border-radius:10px;padding:10px;min-height:200px;
}
.cap-kanban-head{
  display:flex;align-items:center;justify-content:space-between;
  font-size:12px;font-weight:700;color:var(--text);margin-bottom:10px;
  padding:0 4px;
}
.cap-kanban-count{
  font-size:10px;background:var(--surface);color:var(--text-2);
  padding:2px 7px;border-radius:5px;font-weight:600;
}
.cap-kanban-body{display:flex;flex-direction:column;gap:6px}
.cap-kanban-empty{
  text-align:center;color:var(--text-3);font-size:11px;
  padding:24px 0;font-style:italic;
}
.cap-kanban-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:8px;padding:10px;cursor:pointer;transition:.12s;
}
.cap-kanban-card:hover{box-shadow:var(--shadow-sm);transform:translateY(-1px)}
.cap-kanban-title{font-size:12.5px;font-weight:700;color:var(--text);margin-bottom:3px;line-height:1.3}
.cap-kanban-cli{font-size:11px;color:var(--text-2);margin-bottom:5px;font-weight:600}
.cap-kanban-meta{font-size:10.5px;color:var(--text-3);line-height:1.5}

/* Responsivo */
@media (max-width:900px){
  .cap-status-row{grid-template-columns:repeat(3,1fr)}
  .cap-kanban{grid-template-columns:1fr 1fr}
}
@media (max-width:768px){
  .cap-status-row{grid-template-columns:repeat(2,1fr);gap:8px}
  .cap-status-card{padding:11px}
  .cap-status-num{font-size:20px}
  .cap-status-lbl{font-size:11px}
  .view-toggle{width:100%;justify-content:center}
  .cap-card{padding:11px;gap:11px}
  .cap-card-date{width:48px;height:56px}
  .cap-card-day{font-size:18px}
  .cap-card-actions{opacity:1}
  .cap-card-actions .icon-btn{width:36px;height:36px}
  .cap-card-meta{gap:6px;font-size:10.5px}
  .cap-cal-wrap{padding:10px}
  .cap-cal-num{font-size:11px}
  .cap-kanban{grid-template-columns:1fr;gap:8px}
  .cap-kanban-col{min-height:auto}
}
@media (max-width:480px){
  .cap-status-row{grid-template-columns:1fr 1fr}
  .cap-card-actions .icon-btn svg{width:13px;height:13px}
}

/* Quick action wrapper + botão editar pequeno */
.qa-wrap{position:relative;display:flex}
.qa-wrap .qa{flex:1;width:100%}
.qa-edit{
  position:absolute;top:6px;right:6px;
  width:24px;height:24px;border:1px solid var(--border);background:var(--surface);
  border-radius:6px;cursor:pointer;font-size:11px;
  display:none;align-items:center;justify-content:center;
  color:var(--text-2);transition:.15s;z-index:2;
}
.qa-wrap:hover .qa-edit,.qa-wrap:focus-within .qa-edit{display:inline-flex}
.qa-edit:hover{background:var(--accent-soft);color:var(--text);border-color:var(--accent-border)}

/* Info item editável (clicável) */
.info-item.info-editable{
  cursor:pointer;transition:.15s;position:relative;
}
.info-item.info-editable:hover{
  background:var(--surface-2);border-color:var(--accent-border);
}
.info-item.info-editable::after{
  content:'✏️';position:absolute;top:8px;right:10px;
  font-size:11px;opacity:0;transition:.15s;
}
.info-item.info-editable:hover::after{opacity:.6}
.info-item.info-editable.editing{
  background:var(--surface);border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-soft);cursor:text;
}
.info-item.info-editable.editing::after{display:none}
.info-inline-input{
  width:100%;background:transparent;border:none;outline:none;
  font-size:13.5px;font-weight:500;color:var(--text);
  font-family:inherit;padding:2px 0;margin-top:2px;
}
.info-inline-input::placeholder{color:var(--text-3);font-weight:400}

/* Popup mini de edição pra quick actions */
.qa-inline-popup{
  position:absolute;top:calc(100% + 6px);left:0;right:0;
  background:var(--surface);border:1px solid var(--border-strong);
  border-radius:10px;padding:11px 12px;box-shadow:var(--shadow-lg);
  z-index:40;animation:fade .15s ease;
}
.qa-inline-label{
  font-size:10.5px;color:var(--text-3);text-transform:uppercase;
  letter-spacing:.06em;font-weight:600;margin-bottom:6px;
}
.qa-inline-popup input{
  width:100%;padding:8px 10px;border-radius:7px;
  border:1px solid var(--border);background:var(--surface-2);
  font-size:13px;font-family:inherit;color:var(--text);outline:none;
  transition:.15s;
}
.qa-inline-popup input:focus{border-color:var(--accent);background:var(--surface)}
.qa-inline-actions{
  display:flex;justify-content:flex-end;gap:6px;margin-top:9px;
}
.qa-inline-actions .btn{padding:5px 10px;font-size:11.5px}

/* Page search — usado dentro de page-actions (Clientes etc) */
.page-search{
  position:relative;display:inline-flex;align-items:center;
  background:var(--surface-2);border:1px solid var(--border);
  border-radius:8px;padding:0 12px 0 32px;height:36px;
  min-width:240px;max-width:340px;flex:0 1 auto;
  transition:border-color .15s;
}
.page-search:focus-within{border-color:var(--accent-border);background:var(--surface)}
.page-search svg{
  position:absolute;left:10px;top:50%;transform:translateY(-50%);
  width:15px;height:15px;color:var(--text-3);
  pointer-events:none;flex-shrink:0;
}
.page-search input{
  background:transparent;border:none;outline:none;
  font-size:13px;font-family:inherit;color:var(--text);
  width:100%;padding:0;height:100%;
}
.page-search input::placeholder{color:var(--text-3)}
@media (max-width:768px){
  .page-search{width:100%;max-width:none;min-width:0;height:42px;padding-left:34px}
  .page-search input{font-size:14px}
}


/* Grid de clientes (4 por linha) — minimalista logo + nome */
.cli-grid-btn{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
@media (max-width:1280px){.cli-grid-btn{grid-template-columns:repeat(4,1fr)}}
@media (max-width:900px){.cli-grid-btn{grid-template-columns:repeat(3,1fr)}}
@media (max-width:600px){.cli-grid-btn{grid-template-columns:repeat(2,1fr)}}
@media (max-width:400px){.cli-grid-btn{grid-template-columns:1fr}}
.cli-btn{
  background:var(--surface);border:1px solid var(--border);
  border-radius:12px;padding:14px 10px;cursor:pointer;
  transition:.18s;text-align:center;width:100%;
  display:flex;flex-direction:column;align-items:center;gap:8px;
  font-family:inherit;color:inherit;
  box-shadow:var(--shadow-sm);min-height:110px;justify-content:center;
}
.cli-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:var(--border-strong)}
.cli-btn:active{transform:translateY(-1px)}
.cli-btn-logo{
  width:46px;height:46px;border-radius:11px;display:grid;place-items:center;
  color:#fff;font-weight:700;font-size:16px;letter-spacing:-.03em;
  box-shadow:0 3px 10px rgba(0,0,0,.08);
  overflow:hidden;
}
.cli-btn-logo img{width:100%;height:100%;object-fit:cover;display:block}
.cli-btn-logo.has-image{
  box-shadow:0 4px 14px rgba(0,0,0,.12);
  background:var(--surface-2) !important;
}
/* Logo editável no modal de cliente */
.client-logo-editable{position:relative;border-radius:13px;display:grid;place-items:center;color:#fff;font-weight:700;letter-spacing:-.02em;transition:.2s}
.client-logo-editable .client-logo-overlay{
  position:absolute;inset:0;background:rgba(0,0,0,.45);
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:18px;opacity:0;transition:.18s;border-radius:inherit;
}
.client-logo-editable:hover .client-logo-overlay{opacity:1}
.client-logo-editable.has-image{box-shadow:0 4px 14px rgba(0,0,0,.15)}
.cli-btn-name{font-size:12.5px;font-weight:700;letter-spacing:-.02em;line-height:1.25;color:var(--text)}

/* Destaque pulsante vermelho - borda continua ao redor da linha (v2.62-2.63) */
@keyframes highlightBgPulse {
  0%, 100% { background: rgba(239,68,68,.16) !important; }
  50%      { background: rgba(239,68,68,.04) !important; }
}
@keyframes highlightBorderPulse {
  0%, 100% { border-color: #ef4444; }
  50%      { border-color: #fca5a5; }
}
.highlight-pulse > td {
  border-top: 3px solid #ef4444 !important;
  border-bottom: 3px solid #ef4444 !important;
  animation: highlightBgPulse 1.1s ease-in-out 6, highlightBorderPulse 1.1s ease-in-out 6;
  position: relative;
}
.highlight-pulse > td:first-child {
  border-left: 3px solid #ef4444 !important;
}
.highlight-pulse > td:last-child {
  border-right: 3px solid #ef4444 !important;
}
.highlight-pulse > td:first-child::before {
  content: "👀 Olha aqui";
  position: absolute;
  left: 8px; top: -26px;
  background: #ef4444; color: #fff;
  font-size: 10.5px; font-weight: 700;
  padding: 3px 9px; border-radius: 6px;
  box-shadow: 0 4px 12px rgba(239,68,68,.4);
  white-space: nowrap;
  z-index: 5;
  animation: highlightBgPulse 1.1s ease-in-out 6;
}

/* Cronograma — tabela horizontal */
.cron-months{display:flex;gap:5px;overflow-x:auto;padding:5px 0;margin-bottom:14px}
.cron-month-tab{padding:8px 14px;background:var(--surface);border:1px solid var(--border);border-radius:9px;font-size:12px;cursor:pointer;color:var(--text-2);font-weight:600;white-space:nowrap;transition:.15s;font-family:inherit}
.cron-month-tab:hover{background:var(--surface-hover);color:var(--text)}
.cron-month-tab.active{background:var(--accent);color:var(--surface);border-color:var(--accent)}
.cron-month-tab.current{border-color:var(--accent);color:var(--text)}
.cron-month-tab .badge-mini{background:var(--danger);color:#fff;font-size:9px;padding:1px 5px;border-radius:8px;margin-left:5px;font-weight:700}

.cron-table-wrap{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-sm)}
.cron-scroll{overflow-x:auto}
.cron-table{width:100%;min-width:980px;border-collapse:collapse;font-size:12.5px}
.cron-table thead th{background:var(--surface-2);color:var(--text-3);font-size:10px;text-transform:uppercase;letter-spacing:.06em;font-weight:600;padding:11px 12px;text-align:left;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:5}
.cron-table tbody td{padding:12px;border-bottom:1px solid var(--border);vertical-align:middle}
.cron-table tbody tr:last-child td{border-bottom:none}
.cron-table tbody tr:hover td{background:var(--surface-2)}
.cron-table .cron-cli{display:flex;align-items:center;gap:10px;min-width:180px}
.cron-table .cron-cli-logo{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;color:#fff;font-weight:700;font-size:11px;flex-shrink:0}
.cron-table .cron-cli-name{font-size:12.5px;font-weight:600}
.cron-progress{width:90px;height:6px;background:var(--surface-3);border-radius:3px;overflow:hidden;margin-top:4px}
.cron-progress-bar{height:100%;background:var(--accent)}
.cron-progress-bar.success{background:var(--success)}
.cron-progress-bar.warning{background:var(--warning)}
.cron-progress-bar.danger{background:var(--danger)}
.cron-pill{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:600}
.cron-pill .av{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;font-size:9px;letter-spacing:-.02em}
.cron-status{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:600}
.cron-obs-input{width:100%;background:transparent;border:1px solid transparent;color:var(--text);font-size:12px;font-family:inherit;padding:6px 8px;border-radius:6px;transition:.15s;min-width:140px}
.cron-obs-input:hover{background:var(--surface-2);border-color:var(--border)}
.cron-obs-input:focus{outline:none;background:var(--surface);border-color:var(--accent-border)}
.cron-deadline{font-weight:600;font-variant-numeric:tabular-nums}
.cron-deadline.urgent{color:var(--danger-text)}
.cron-deadline.soon{color:var(--warning-text)}

/* Banner de alerta de prazo (topo da tela) */
.deadline-banner{
  background:var(--surface);border:1px solid var(--warning);
  border-left:3px solid var(--warning);
  border-radius:10px;padding:11px 14px;
  display:flex;align-items:center;gap:11px;margin-bottom:18px;
  cursor:pointer;transition:.15s;animation:slideUp .3s ease;
}
.deadline-banner:hover{background:var(--warning-soft)}
.deadline-banner.urgent{border-color:var(--danger);border-left-color:var(--danger)}
.deadline-banner.urgent:hover{background:var(--danger-soft)}
.deadline-banner .db-ico{font-size:18px;flex-shrink:0}
.deadline-banner .db-text{flex:1;font-size:12.5px}
.deadline-banner .db-text strong{color:var(--text)}
.deadline-banner .db-go{font-size:11px;color:var(--text-3)}

/* Alerta modal central (aparece ao entrar no sistema) */
.alert-modal{position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);z-index:300;display:none;align-items:center;justify-content:center;padding:24px}
.alert-modal.open{display:flex;animation:fade .2s}
.alert-modal-box{background:var(--surface);border:1px solid var(--border);border-radius:14px;width:100%;max-width:480px;box-shadow:var(--shadow-lg);overflow:hidden}
.alert-modal-head{padding:18px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:11px}
.alert-modal-ico{width:42px;height:42px;border-radius:10px;background:var(--warning-soft);color:var(--warning-text);display:grid;place-items:center;font-size:20px;flex-shrink:0}
.alert-modal-ico.urgent{background:var(--danger-soft);color:var(--danger-text)}
.alert-modal-body{padding:14px 20px;max-height:340px;overflow-y:auto}
.alert-modal-foot{padding:14px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px}
.alert-item{display:flex;align-items:center;gap:10px;padding:11px;background:var(--surface-2);border-radius:9px;margin-bottom:7px;cursor:pointer;transition:.15s}
.alert-item:hover{background:var(--surface-3)}


/* Calendário grande em destaque para Captação */
.cap-cal{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;background:var(--surface);padding:18px;border-radius:14px;border:1px solid var(--border);box-shadow:var(--shadow-sm)}
.cap-cal .cc-head{font-size:11px;font-weight:600;color:var(--text-3);text-align:center;text-transform:uppercase;letter-spacing:.06em;padding:8px 4px}
.cap-cal .cc-day{aspect-ratio:1;border-radius:10px;display:flex;flex-direction:column;background:var(--surface-2);padding:8px;font-size:12.5px;font-weight:600;position:relative;transition:.15s;min-height:84px;overflow:hidden;border:1.5px solid transparent}
.cap-cal .cc-day:hover{background:var(--surface-3)}
.cap-cal .cc-day.other{opacity:.3}
.cap-cal .cc-day.today{background:var(--accent);color:var(--surface)}
.cap-cal .cc-day.today .cc-num{color:var(--surface)}
.cap-cal .cc-day.has{background:var(--accent-soft);border-color:var(--accent)}
.cap-cal .cc-day.has.today{background:var(--accent);border-color:var(--accent)}
.cap-cal .cc-day.has.today .cc-num{color:var(--surface)}
.cap-cal .cc-num{font-size:14px;font-weight:700;line-height:1;text-align:left;margin-bottom:5px;color:var(--text)}
.cap-cal .cc-day.today .cc-num{color:var(--surface)}
.cap-cal .cc-items{display:flex;gap:4px;flex-wrap:wrap;margin-top:auto;justify-content:flex-start}
.cap-cal .cc-item{
  width:26px;height:26px;border-radius:7px;display:grid;place-items:center;
  color:#fff;font-weight:700;font-size:10px;cursor:pointer;
  border:2px solid var(--surface);transition:.18s;letter-spacing:-.02em;position:relative;
}
.cap-cal .cc-day.today .cc-item{border-color:var(--accent)}
.cap-cal .cc-item:hover{transform:scale(1.25);z-index:5;box-shadow:0 4px 14px rgba(0,0,0,.28)}
.cap-cal .cc-item::after{
  content:'🎬';position:absolute;top:-5px;right:-5px;font-size:9px;
  background:var(--surface);border-radius:50%;width:14px;height:14px;
  display:grid;place-items:center;opacity:0;transition:.18s;
  box-shadow:0 2px 5px rgba(0,0,0,.2);
}
.cap-cal .cc-item:hover::after{opacity:1}

/* Legenda compacta */
.cap-legend{display:flex;gap:18px;flex-wrap:wrap;padding:13px 4px;font-size:11px;color:var(--text-3)}
.cap-legend-item{display:flex;align-items:center;gap:6px}
.cap-legend-dot{width:12px;height:12px;border-radius:50%;display:inline-block}


/* Feedback */
.fb-layout{display:grid;grid-template-columns:280px 1fr;gap:16px;align-items:flex-start}
@media (max-width:1000px){.fb-layout{grid-template-columns:1fr}}
.fb-sidebar{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:8px;position:sticky;top:0;max-height:calc(100vh - 140px);overflow-y:auto}
.fb-collab{display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:8px;cursor:pointer;transition:.15s;margin-bottom:2px}
.fb-collab:hover{background:var(--surface-hover)}
.fb-collab.active{background:var(--accent-soft);border-left:3px solid var(--accent);padding-left:8px}
.fb-collab .av{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;font-size:11px;flex-shrink:0}
.fb-collab-info{flex:1;min-width:0}
.fb-collab-name{font-size:12.5px;font-weight:600;line-height:1.2}
.fb-collab-meta{font-size:10.5px;color:var(--text-3);margin-top:2px}
.fb-collab-score{font-size:11px;font-weight:700;color:var(--text);flex-shrink:0;background:var(--surface-2);padding:3px 7px;border-radius:6px}

.fb-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:14px;box-shadow:var(--shadow-sm)}
.fb-types{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.fb-type{padding:5px 12px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:11.5px;cursor:pointer;font-weight:600;font-family:inherit;color:var(--text)}
.fb-type:hover{background:var(--surface-3)}
.fb-type.active{background:var(--accent);color:var(--surface);border-color:var(--accent)}
.fb-type.positive.active{background:var(--success);border-color:var(--success);color:#fff}
.fb-type.concern.active{background:var(--warning);border-color:var(--warning);color:#fff}
.fb-type.development.active{background:var(--info);border-color:var(--info);color:#fff}
.fb-textarea{width:100%;min-height:120px;padding:13px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);font-family:inherit;font-size:13px;color:var(--text);resize:vertical;outline:none;transition:.15s;line-height:1.55}
.fb-textarea:focus{border-color:var(--border-strong);background:var(--surface)}
.fb-score-slider{display:flex;align-items:center;gap:14px;margin-top:10px}
.fb-score-input{flex:1;height:6px;background:var(--surface-3);border-radius:3px;outline:none;-webkit-appearance:none;appearance:none}
.fb-score-input::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:var(--accent);cursor:pointer;border:3px solid var(--surface);box-shadow:0 2px 6px rgba(0,0,0,.15)}
.fb-score-input::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:var(--accent);cursor:pointer;border:3px solid var(--surface)}
.fb-score-val{font-size:22px;font-weight:700;letter-spacing:-.03em;min-width:50px;text-align:center}

.fb-ai{background:linear-gradient(135deg,var(--surface-2),var(--surface));border:1px solid var(--border-strong);border-left:3px solid var(--purple);border-radius:11px;padding:16px}
.fb-ai-head{display:flex;align-items:center;gap:8px;margin-bottom:11px}
.fb-ai-ico{width:30px;height:30px;border-radius:8px;background:var(--purple-soft);color:var(--purple-text);display:grid;place-items:center;font-size:14px}
.fb-ai-title{font-size:13px;font-weight:700}
.fb-ai-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:9px;margin-bottom:11px}
.fb-ai-metric{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:9px 11px}
.fb-ai-metric-val{font-size:15px;font-weight:700;letter-spacing:-.02em}
.fb-ai-metric-lbl{font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.05em;margin-top:1px}

.fb-tag{display:inline-block;padding:3px 8px;background:var(--surface);border:1px solid var(--border);border-radius:5px;font-size:11px;font-weight:500;margin:0 4px 4px 0}

.fb-history{}
.fb-entry{display:flex;gap:12px;padding:12px;background:var(--surface-2);border-radius:10px;margin-bottom:8px;border-left:3px solid var(--border)}
.fb-entry.positive{border-left-color:var(--success)}
.fb-entry.concern{border-left-color:var(--warning)}
.fb-entry.development{border-left-color:var(--info)}
.fb-entry-ico{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;flex-shrink:0;font-size:14px}
.fb-entry.positive .fb-entry-ico{background:var(--success-soft);color:var(--success-text)}
.fb-entry.concern .fb-entry-ico{background:var(--warning-soft);color:var(--warning-text)}
.fb-entry.development .fb-entry-ico{background:var(--info-soft);color:var(--info-text)}
.fb-entry-body{flex:1;min-width:0}
.fb-entry-head{display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:11.5px;color:var(--text-3)}
.fb-entry-text{font-size:12.5px;line-height:1.5;color:var(--text)}

.fb-skills{display:flex;flex-direction:column;gap:9px}
.fb-skill{display:grid;grid-template-columns:120px 1fr 40px;gap:11px;align-items:center;font-size:12px}
.fb-skill-bar{height:7px;background:var(--surface-3);border-radius:4px;overflow:hidden}
.fb-skill-fill{height:100%;border-radius:4px;background:var(--accent);transition:width .5s}
.fb-skill-val{text-align:right;font-weight:700;font-size:12px}

/* Login screen */
.login-bg{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:500;padding:20px}
.login-bg.hidden{display:none}
.login-bg.show{display:flex}
.login-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:40px 36px;width:100%;max-width:420px;box-shadow:var(--shadow-lg);text-align:center}
.login-logo{width:54px;height:54px;border-radius:14px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:800;font-size:18px;letter-spacing:-.04em;margin:0 auto 18px}
.login-title{font-size:22px;font-weight:700;letter-spacing:-.03em;margin-bottom:6px}
.login-sub{font-size:13px;color:var(--text-2);margin-bottom:30px}
.login-form{display:flex;flex-direction:column;gap:11px}
.login-input{padding:13px 15px;border-radius:10px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13.5px;outline:none;transition:.15s;width:100%}
.login-input:focus{border-color:var(--accent);background:var(--surface)}
.login-btn{padding:14px;border-radius:10px;background:var(--accent);color:var(--surface);border:none;font-family:inherit;font-size:13.5px;font-weight:600;cursor:pointer;transition:.15s;margin-top:6px}
.login-btn:hover{transform:translateY(-1px);box-shadow:var(--shadow)}
.login-btn:disabled{opacity:.55;cursor:wait}
.login-error{color:var(--danger-text);font-size:12.5px;text-align:left;margin-top:6px;padding:9px 12px;background:var(--danger-soft);border-radius:7px;display:none}
.login-error.show{display:block}
.login-footer{margin-top:24px;font-size:11px;color:var(--text-3)}

</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
  window.IMPULSE_CONFIG = {
    SUPABASE_URL: 'https://pzqxceqtnsmpsiaejhjw.supabase.co',
    SUPABASE_ANON_KEY: 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB6cXhjZXF0bnNtcHNpYWVqaGp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkxNDkwNjgsImV4cCI6MjA5NDcyNTA2OH0.VFgxhwTFdTDhVAX9v4Gi5jtx5TKVCdf74SZohHMfuD8'
  };
</script>
<script>
// ============ LOGIN STANDALONE - sempre disponivel ============
(function(){
  const CFG = window.IMPULSE_CONFIG || {};
  
  window.doLogin = async function(e){
    if(e && e.preventDefault) e.preventDefault();
    const email = (document.getElementById('loginEmail') || {}).value || '';
    const pwd = (document.getElementById('loginPwd') || {}).value || '';
    const errEl = document.getElementById('loginErr');
    const btn = document.getElementById('loginBtn');
    if(errEl) errEl.classList.remove('show');
    if(!email.trim() || !pwd){
      if(errEl){errEl.textContent='Preencha email e senha';errEl.classList.add('show')}
      return false;
    }
    if(btn){btn.disabled=true;btn.textContent='Entrando...'}
    try {
      // PREFERIR usar o SDK se disponivel
      if(window.supabase && window.IMPULSE_CONFIG){
        if(!window._supaInstance){
          window._supaInstance = window.supabase.createClient(CFG.SUPABASE_URL, CFG.SUPABASE_ANON_KEY);
          console.log('[LOGIN] _supaInstance criada');
        }
        console.log('[LOGIN] Tentando via SDK:', email);
        const { data, error } = await window._supaInstance.auth.signInWithPassword({email: email.trim(), password: pwd});
        if(error){
          console.error('[LOGIN] erro SDK:', error);
          const msg = error.message;
          const friendly = msg.toLowerCase().includes('credentials') ? 'Email ou senha incorretos'
                         : msg.toLowerCase().includes('confirmed') ? 'Email nao confirmado. Marque Auto Confirm no Supabase.'
                         : msg;
          if(errEl){errEl.textContent=friendly;errEl.classList.add('show')}
          if(btn){btn.disabled=false;btn.textContent='Entrar'}
          return false;
        }
        console.log('[LOGIN] Sucesso SDK:', data.user.email, '— sessao deve estar salva no localStorage');
        // Verifica se salvou
        const key = 'sb-' + new URL(CFG.SUPABASE_URL).hostname.split('.')[0] + '-auth-token';
        const saved = localStorage.getItem(key);
        console.log('[LOGIN] localStorage tem key?', key, !!saved);
        // Aguarda um pouco e recarrega
        setTimeout(()=>location.reload(), 500);
        return false;
      }
      // FALLBACK fetch direto se SDK nao carregou
      console.log('[LOGIN] Via fetch (SDK indisponivel):', email);
      const r = await fetch(CFG.SUPABASE_URL + '/auth/v1/token?grant_type=password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': CFG.SUPABASE_ANON_KEY },
        body: JSON.stringify({email: email.trim(), password: pwd})
      });
      const data = await r.json();
      if(!r.ok){
        const msg = data.error_description || data.msg || data.error || 'Email ou senha incorretos';
        const friendly = msg.toLowerCase().includes('credentials') ? 'Email ou senha incorretos'
                       : msg.toLowerCase().includes('confirmed') ? 'Email nao confirmado.'
                       : msg;
        if(errEl){errEl.textContent=friendly;errEl.classList.add('show')}
        if(btn){btn.disabled=false;btn.textContent='Entrar'}
        return false;
      }
      const key = 'sb-' + new URL(CFG.SUPABASE_URL).hostname.split('.')[0] + '-auth-token';
      localStorage.setItem(key, JSON.stringify({
        access_token: data.access_token, refresh_token: data.refresh_token,
        expires_at: Math.floor(Date.now()/1000) + (data.expires_in||3600),
        expires_in: data.expires_in, token_type: 'bearer', user: data.user
      }));
      location.reload();
    } catch(err){
      console.error('[LOGIN] Erro:', err);
      if(errEl){errEl.textContent='Erro: '+err.message;errEl.classList.add('show')}
      if(btn){btn.disabled=false;btn.textContent='Entrar'}
    }
    return false;
  };
  console.log('[LOGIN] doLogin standalone instalado');

  // Auto-check: se ja tem sessao salva, esconde tela de login imediatamente
  window.autoCheckSession = async function(){
    try {
      const key = 'sb-' + new URL(CFG.SUPABASE_URL).hostname.split('.')[0] + '-auth-token';
      const raw = localStorage.getItem(key);
      if(raw){
        const session = JSON.parse(raw);
        console.log('[AUTO] Sessao encontrada:', session.user?.email);
        // Esconde login screen
        const ls = document.getElementById('loginScreen');
        if(ls){ ls.style.display='none'; ls.classList.add('hidden'); }
        return session;
      }
    } catch(e){ console.warn('[AUTO] erro check:', e); }
    return null;
  };
  // Rodar quando DOM pronto
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', ()=>window.autoCheckSession());
  } else {
    setTimeout(()=>window.autoCheckSession(), 50);
  }
})();
</script>
</head>
<body>
<div class="login-bg" id="loginScreen">
  <div class="login-card">
    <div class="login-logo">i1</div>
    <div class="login-title">IMPULSE ONE</div>
    <div class="login-sub">Acesso restrito · entre com email e senha</div>
    <div class="login-form" id="loginForm" autocomplete="off">
      <!-- Honeypot — alguns gerenciadores de senha caem aqui e ignoram os reais -->
      <input type="text" name="username" style="display:none !important;visibility:hidden;position:absolute;left:-9999px" tabindex="-1" aria-hidden="true" />
      <input type="password" name="password" style="display:none !important;visibility:hidden;position:absolute;left:-9999px" tabindex="-1" aria-hidden="true" />

      <input class="login-input" type="text" id="loginEmail" placeholder="seu@email.com" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-form-type="other" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" onkeydown="if(event.key==='Enter'){event.preventDefault();doLogin(event)}" />
      <input class="login-input" type="password" id="loginPwd" placeholder="senha" autocomplete="new-password" autocorrect="off" autocapitalize="off" spellcheck="false" data-form-type="other" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" onkeydown="if(event.key==='Enter'){event.preventDefault();doLogin(event)}" />
      <div class="login-error" id="loginErr"></div>
      <button class="login-btn" id="loginBtn" type="button" onclick="doLogin(event)">Entrar</button>
    </div>
    <div class="login-footer">© 2026 Impulse One · Acesso restrito à equipe<br><span style="cursor:pointer;text-decoration:underline" onclick="localStorage.clear();sessionStorage.clear();location.reload()">Limpar sessão e recarregar</span></div>
  </div>
</div>
<div class="app">
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-logo" id="sidebarBrandLogo">i1</div>
      <div style="flex:1">
        <div class="brand-name">Impulse One</div>
        <div class="brand-sub">Central da Agência</div>
      </div>
      <button class="sidebar-close" onclick="closeSidebar()" aria-label="Fechar menu" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <nav class="nav" id="nav"></nav>
    <div class="user-card">
      <div class="avatar" id="userAvatar">E</div>
      <div class="user-info">
        <div class="user-name" id="userName">Ederson Oliveira</div>
        <div class="user-role" id="userRole">Founder</div>
      </div>
      <button class="icon-btn" onclick="toggleTheme()" title="Alternar tema">
        <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>
    </div>
    <div style="padding:6px 12px;font-size:10px;color:var(--text-3);text-align:center;border-top:1px solid var(--border);font-family:monospace">
      v3.91 · Cronograma: designer e trafego replicam pros meses futuros vazios
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <button class="mobile-menu-btn" id="mobileMenuBtn" onclick="toggleSidebar()" aria-label="Menu" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <button class="mobile-back-btn" id="mobileBackBtn" onclick="voltarPagina()" aria-label="Voltar" type="button" style="display:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <button class="mobile-refresh-btn" id="mobileRefreshBtn" onclick="atualizarPaginaAtual()" aria-label="Atualizar" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/></svg>
      </button>
      <div class="mobile-brand">
        <div class="brand-logo" id="mobileBrandLogo">i1</div>
        <div class="brand-name">Impulse One</div>
      </div>
      <div class="search" style="position:relative">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input placeholder="Pesquisar clientes, captações, colaboradores, páginas..." id="globalSearch" oninput="globalSearch(this.value)" onfocus="globalSearch(this.value)" />
        <kbd>⌘K</kbd>
        <div class="search-results" id="searchResults"></div>
      </div>
      <div class="top-actions">
        <button class="icon-btn" onclick="toast('Suporte: contato@novastudio.com.br','info')" title="Ajuda"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg></button>
        <button class="icon-btn" onclick="toggleNotif()" title="Notificações"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></button>
        <div style="position:relative">
          <button class="btn btn-primary" onclick="toggleNovoMenu(event)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>Novo</button>
          <div class="novo-menu" id="novoMenu">
            <div class="novo-item" onclick="closeNovo();goTo('clientes');toast('Adicione um novo cliente','info')">👤 <span><strong>Novo cliente</strong><div class="text-xs text-3">CRM</div></span></div>
            <div class="novo-item" onclick="closeNovo();goTo('operacional');toast('Crie uma nova tarefa','info')">✅ <span><strong>Nova tarefa</strong><div class="text-xs text-3">Operacional</div></span></div>
            <div class="novo-item" onclick="closeNovo();goTo('captacao');toast('Nova captação agendada','info')">🎬 <span><strong>Nova captação</strong><div class="text-xs text-3">Captação</div></span></div>
            <div class="novo-item" onclick="closeNovo();goTo('reunioes');toast('Reunião agendada','info')">📹 <span><strong>Nova reunião</strong><div class="text-xs text-3">Reuniões</div></span></div>
            <div class="novo-item" onclick="closeNovo();goTo('comercial');comTab='orcamento';renderComercial(document.getElementById('content'))">📄 <span><strong>Novo orçamento</strong><div class="text-xs text-3">Comercial</div></span></div>
            <div class="novo-item" onclick="closeNovo();goTo('comercial');comTab='pipeline';renderComercial(document.getElementById('content'))">📈 <span><strong>Novo lead</strong><div class="text-xs text-3">Comercial</div></span></div>
            <div class="novo-item" onclick="closeNovo();goTo('calendario');toast('Adicione no calendário','info')">📅 <span><strong>Novo evento</strong><div class="text-xs text-3">Calendário</div></span></div>
            <div class="novo-item" onclick="closeNovo();goTo('financeiro');toast('Nova despesa','info')">💸 <span><strong>Nova despesa</strong><div class="text-xs text-3">Financeiro</div></span></div>
          </div>
        </div>
      </div>
      <div class="notif-pop" id="notifPop">
        <div class="notif-pop-head"><span>Notificações</span><span class="text-3 text-xs" style="cursor:pointer">Marcar como lidas</span></div>
        <div class="notif-list" id="notifList">
          <div class="empty-state" style="padding:30px 18px"><div class="ico">🔔</div><div class="ttl">Sem notificações</div><div class="desc">Você está em dia.</div></div>
        </div>
      </div>
    </div>
    <div class="content" id="content"></div>
  </div>
</div>

<div class="ctx-menu" id="ctxMenu" onclick="event.stopPropagation()"></div>
<div class="modal-bg" id="modalBg" onclick="if(event.target===this)closeModal()">
  <div class="modal" id="clientModal"></div>
</div>
<div class="toast-wrap" id="toastWrap"></div>

<!-- Botão flutuante de lembretes (canto inferior direito) -->
<button id="lembretesBtn" onclick="openLembretesWidget()" title="Meus lembretes" style="position:fixed;bottom:24px;right:24px;width:54px;height:54px;border-radius:50%;background:var(--accent);color:var(--surface);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 8px 24px rgba(0,0,0,.18);z-index:80;transition:.18s">
  💡
  <span id="lembretesBadge" style="position:absolute;top:-3px;right:-3px;background:var(--danger);color:#fff;font-size:10px;min-width:18px;height:18px;border-radius:9px;padding:0 5px;display:none;align-items:center;justify-content:center;font-weight:700">0</span>
</button>

<!-- Widget de lembretes (canto inferior direito) -->
<div id="lembretesWidget" style="position:fixed;bottom:90px;right:24px;width:360px;max-width:calc(100vw - 32px);max-height:500px;background:var(--surface);border:1px solid var(--border-strong);border-radius:14px;box-shadow:0 16px 50px rgba(0,0,0,.2);display:none;flex-direction:column;z-index:79;overflow:hidden">
  <div style="padding:14px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;background:var(--surface-2)">
    <div style="font-size:20px">💡</div>
    <div style="flex:1">
      <div style="font-weight:700;font-size:14px">Meus lembretes</div>
      <div class="text-xs text-3" id="lembretesSubtitle">0 pendentes</div>
    </div>
    <button class="icon-btn" onclick="addLembrete()" title="Novo lembrete" style="width:32px;height:32px;background:var(--accent);color:var(--surface)">+</button>
    <button class="icon-btn" onclick="closeLembretesWidget()" title="Fechar" style="width:32px;height:32px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
  </div>
  <div id="lembretesList" style="flex:1;overflow-y:auto;padding:8px"></div>
</div>

<script>


// ============ DEBUG: confirma que script principal rodou ============


// ============ GERENCIADOR DE LINKS (multiplos por botao) ============
async function loadLinksByGroup(groupKey){
  // Pega do banco (se rolar) E do localStorage, e mescla
  let dbLinks = [];
  if(_supa){
    try {
      const { data, error } = await _supa.from('custom_links').select('*').eq('group_key', groupKey).order('position', {ascending: true});
      if(error){
        console.warn('[Links] erro no banco:', error.message);
      } else {
        dbLinks = data || [];
        // Se a tabela não tem coluna 'description', mescla do localStorage
        try {
          const descMap = JSON.parse(localStorage.getItem('link_desc_map') || '{}');
          dbLinks.forEach(l => {
            if(!l.description && descMap[l.id]) l.description = descMap[l.id];
          });
        } catch(e){}
      }
    } catch(e){ console.warn('[Links] load group:', e); }
  }
  const localLinks = _localLinksGet(groupKey);
  return [...dbLinks, ...localLinks];
}

async function openLinksManager(groupKey, groupLabel, defaultUrl){
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `<div class="empty-state" style="padding:60px"><div class="ico">⏳</div></div>`;
  document.getElementById('modalBg').classList.add('open');
  const links = await loadLinksByGroup(groupKey);

  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:42px;height:42px;border-radius:11px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-size:18px">🔗</div>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;letter-spacing:-.02em">${groupLabel}</div>
        <div class="text-xs text-3" style="margin-top:3px">${links.length} link(s) salvo(s) · clique em "Abrir" para acessar</div>
      </div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div id="linksList">
        ${links.length === 0 ? `
          <div class="empty-state" style="padding:32px 16px">
            <div class="ico">🔗</div>
            <div class="ttl">Nenhum link adicionado ainda</div>
            <div class="desc">Adicione abaixo o primeiro link deste grupo.</div>
          </div>
        ` : links.map(l => linkRowHTML(l)).join('')}
      </div>

      <div class="card mt-3" style="background:var(--surface-2)">
        <div class="card-header" style="margin-bottom:11px"><div class="card-title">➕ Adicionar novo link</div></div>
        <div style="display:grid;grid-template-columns:1fr 2fr;gap:8px;margin-bottom:8px">
          <input id="newLinkLabel" class="login-input" placeholder="Nome (ex: Contrato 2026)" style="background:var(--surface)" />
          <input id="newLinkUrl" class="login-input" placeholder="https://drive.google.com/..." style="background:var(--surface)" />
        </div>
        <div style="display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center">
          <input id="newLinkDesc" class="login-input" placeholder="Descrição (opcional) — ex: Contrato anual, válido até dez/26" style="background:var(--surface)" />
          <button class="btn btn-primary" onclick="addLinkToGroup('${groupKey.replace(/'/g,"\\'")}', '${groupLabel.replace(/'/g,"\\'")}')">+ Adicionar</button>
        </div>
        ${defaultUrl ? `<div class="text-xs text-3 mt-3">💡 Link padrão sugerido: <a href="${defaultUrl}" target="_blank" style="color:var(--text-2);text-decoration:underline">${defaultUrl}</a></div>` : ''}
      </div>
    </div>
  `;
}

function linkRowHTML(l){
  const safeId = l.id;
  const safeUrl = (l.url||'').replace(/"/g,'&quot;');
  const safeLabel = (l.label||'').replace(/"/g,'&quot;').replace(/</g,'&lt;');
  const safeDesc = (l.description||'').replace(/"/g,'&quot;').replace(/</g,'&lt;');
  return `
    <div class="card mb-2" id="link-row-${safeId}" style="padding:12px;display:flex;align-items:flex-start;gap:11px">
      <div style="width:34px;height:34px;border-radius:8px;background:var(--surface-2);display:grid;place-items:center;font-size:14px;flex-shrink:0;margin-top:2px">🔗</div>
      <div style="flex:1;min-width:0">
        <input class="cron-obs-input" value="${safeLabel}" placeholder="Nome do link" onblur="updateLink('${safeId}', 'label', this.value)" style="width:100%;font-weight:600;font-size:13px;padding:5px 7px;background:transparent;border:none;border-bottom:1px dashed transparent;outline:none" onfocus="this.style.borderBottomColor='var(--accent-border)'" />
        <input class="cron-obs-input" value="${safeUrl}" placeholder="URL (https://...)" onblur="updateLink('${safeId}', 'url', this.value)" style="width:100%;font-size:11.5px;color:var(--text-2);padding:5px 7px;background:transparent;margin-top:2px;border:none;border-bottom:1px dashed transparent;outline:none" onfocus="this.style.borderBottomColor='var(--accent-border)'" />
        <input class="cron-obs-input" value="${safeDesc}" placeholder="📝 descrição (opcional) — ex: contrato anual" onblur="updateLink('${safeId}', 'description', this.value)" style="width:100%;font-size:11px;color:var(--text-3);padding:4px 7px;background:transparent;margin-top:2px;border:none;border-bottom:1px dashed transparent;outline:none;font-style:italic" onfocus="this.style.borderBottomColor='var(--accent-border)';this.style.fontStyle='normal'" />
      </div>
      <div style="display:flex;flex-direction:column;gap:4px;flex-shrink:0">
        <button class="btn btn-sm btn-primary" onclick="openLink('${safeUrl.replace(/'/g,"\\'")}')" title="Abrir em nova aba">Abrir</button>
        <button class="btn btn-sm" onclick="copy('${safeUrl.replace(/'/g,"\\'")}','Link copiado')" title="Copiar URL" style="font-size:11px">📋 Copiar</button>
        <button class="icon-btn" title="Excluir" onclick="removeLinkRow('${safeId}')" style="color:var(--danger);align-self:center"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
      </div>
    </div>
  `;
}

// Helpers de fallback (localStorage)
function _localLinksKey(groupKey){ return 'custom_links_'+groupKey; }
function _localLinksGet(groupKey){
  try { return JSON.parse(localStorage.getItem(_localLinksKey(groupKey)) || '[]'); }
  catch(e){ return []; }
}
function _localLinksSet(groupKey, arr){
  try { localStorage.setItem(_localLinksKey(groupKey), JSON.stringify(arr||[])); }
  catch(e){}
}

async function addLinkToGroup(groupKey, groupLabel){
  const label = document.getElementById('newLinkLabel').value.trim();
  const url = document.getElementById('newLinkUrl').value.trim();
  const description = (document.getElementById('newLinkDesc')?.value || '').trim();
  if(!label || !url){ toast('Preencha nome e URL','info'); return; }
  // Aceita URLs sem protocolo - adiciona https://
  let urlFinal = url;
  if(!urlFinal.match(/^https?:\/\//i)){
    urlFinal = 'https://' + urlFinal;
  }
  const novoItem = {
    id: 'local_' + Date.now() + '_' + Math.random().toString(36).slice(2,6),
    group_key: groupKey,
    label, url: urlFinal, description,
    link_key: groupKey + '-' + Date.now(),
    _local: true
  };
  const clearForm = () => {
    document.getElementById('newLinkLabel').value = '';
    document.getElementById('newLinkUrl').value = '';
    const dEl = document.getElementById('newLinkDesc');
    if(dEl) dEl.value = '';
  };
  // Tenta salvar no banco
  if(_supa){
    try {
      const payload = {
        group_key: groupKey, label, url: urlFinal,
        link_key: novoItem.link_key
      };
      if(description) payload.description = description;
      // Tenta inserir com descrição, se falhar (coluna não existe) tenta sem
      let { data, error } = await _supa.from('custom_links').insert(payload).select().single();
      if(error && description && error.message && error.message.toLowerCase().includes('description')){
        // Coluna description não existe — salva sem ela no banco e descrição local
        delete payload.description;
        const r2 = await _supa.from('custom_links').insert(payload).select().single();
        if(r2.error) throw r2.error;
        // Anota descrição no localStorage como complemento (mapeado por id)
        if(description){
          const descMap = JSON.parse(localStorage.getItem('link_desc_map') || '{}');
          descMap[r2.data.id] = description;
          localStorage.setItem('link_desc_map', JSON.stringify(descMap));
        }
        toast('✓ Link adicionado (descrição salva localmente — rode o SQL pra sincronizar)','success');
      } else if(error){
        throw error;
      } else {
        toast('✓ Link adicionado','success');
      }
      clearForm();
      openLinksManager(groupKey, groupLabel);
      return;
    } catch(e){
      console.warn('[addLinkToGroup] banco falhou, salvando local:', e);
      if(e.message && (e.message.toLowerCase().includes('custom_links') || e.message.toLowerCase().includes('group_key') || e.code === 'PGRST205' || e.code === 'PGRST204')){
        const list = _localLinksGet(groupKey);
        list.push(novoItem);
        _localLinksSet(groupKey, list);
        toast('⚠ Link salvo localmente (rode o SQL 09-link-groups.sql)','info');
        clearForm();
        openLinksManager(groupKey, groupLabel);
        return;
      }
      toast('Erro: '+e.message,'info');
      return;
    }
  }
  // Sem Supabase: salva local
  const list = _localLinksGet(groupKey);
  list.push(novoItem);
  _localLinksSet(groupKey, list);
  toast('✓ Link salvo localmente','success');
  clearForm();
  openLinksManager(groupKey, groupLabel);
}

async function updateLink(id, field, value){
  // Link local: atualiza no localStorage
  if(typeof id === 'string' && id.startsWith('local_')){
    // Procura em qual grupo está
    for(let i = 0; i < localStorage.length; i++){
      const k = localStorage.key(i);
      if(!k || !k.startsWith('custom_links_')) continue;
      const arr = _localLinksGet(k.replace('custom_links_',''));
      const it = arr.find(x => x.id === id);
      if(it){
        it[field] = value;
        _localLinksSet(k.replace('custom_links_',''), arr);
        toast('Salvo localmente ✓','success');
        return;
      }
    }
    return;
  }
  if(!_supa) return;
  try {
    await _supa.from('custom_links').update({[field]: value}).eq('id', id);
    toast('Salvo ✓','success');
  } catch(e){ toast('Erro: '+e.message,'info') }
}

async function removeLinkRow(id){
  if(!(await confirmDelete('link'))) return;
  // Link local: remove do localStorage
  if(typeof id === 'string' && id.startsWith('local_')){
    for(let i = 0; i < localStorage.length; i++){
      const k = localStorage.key(i);
      if(!k || !k.startsWith('custom_links_')) continue;
      const arr = _localLinksGet(k.replace('custom_links_',''));
      const novo = arr.filter(x => x.id !== id);
      if(novo.length !== arr.length){
        _localLinksSet(k.replace('custom_links_',''), novo);
        const row = document.getElementById('link-row-'+id);
        if(row) row.remove();
        toast('Removido','success');
        return;
      }
    }
    return;
  }
  if(!_supa) return;
  try {
    await _supa.from('custom_links').delete().eq('id', id);
    const row = document.getElementById('link-row-'+id);
    if(row) row.remove();
    toast('Link removido','success');
  } catch(e){ toast('Erro: '+e.message,'info') }
}


// ============ SISTEMA DE LINKS CUSTOMIZADOS ============
const _customLinks = {}; // key -> {url, label}

async function loadCustomLinks(){
  if(!_supa) return;
  try {
    const { data } = await _supa.from('custom_links').select('*');
    if(data){
      data.forEach(l => _customLinks[l.link_key] = {url: l.url, label: l.label});
    }
    applyCustomLinks();
  } catch(e){ console.warn('[Links] load:', e); }
}

function applyCustomLinks(){
  // Marca elementos que tem link customizado
  document.querySelectorAll('[data-link-key]').forEach(el => {
    const key = el.dataset.linkKey;
    if(_customLinks[key]){
      el.dataset.hasLink = '1';
      el.title = (el.title || '') + ' · 🔗 ' + _customLinks[key].url;
    } else {
      delete el.dataset.hasLink;
    }
  });
}

function getElementLinkKey(el){
  let e = el;
  while(e && e !== document.body){
    if(e.dataset && e.dataset.linkKey) return e.dataset.linkKey;
    // Sempre gera key pelo texto + tag/classe
    const txt = (e.textContent || '').trim().split('\n')[0].slice(0, 40);
    if(txt && txt.length > 1){
      const cls = (e.className && typeof e.className === 'string') ? e.className.split(' ').filter(c => c && !['active','open','show','hidden'].includes(c))[0] || '' : '';
      const key = ((cls||e.tagName.toLowerCase()) + '-' + txt).toLowerCase().replace(/[^a-z0-9-]/g,'-').replace(/-+/g,'-').slice(0, 80);
      e.dataset.linkKey = key;
      return key;
    }
    e = e.parentElement;
  }
  return null;
}

// Right-click GLOBAL — UNIVERSAL, sempre captura
window.addEventListener('contextmenu', function(e){
  console.log('[CTX] right-click em:', e.target.tagName, e.target.className);
  // Ignora apenas inputs editaveis
  const tag = e.target.tagName;
  if(tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') {
    console.log('[CTX] ignorado (input editavel)');
    return;
  }
  // Lista ampla de seletores clicaveis (sem combinadores)
  const ctxSelectors = '.quick, .qa, .btn, .icon-btn, .nav-item, .cli-btn, .client-card, .clist-row, .file, .cron-cli, .cron-row, .meeting-card, .fb-collab, .fb-entry, .cap-row, .cap-group-head, .cc-item, .cc-day, .kanban-card, .list-item, .team-card, .notif-item, .acesso-card, .modal-tab, .filter-chip, .search-result, .novo-item, .collab-tab, .stat, .card, button, a';
  let linkable = e.target.closest(ctxSelectors);
  console.log('[CTX] elemento linkavel:', linkable ? linkable.className.slice(0,50) : 'NENHUM');
  if(!linkable) {
    // Mesmo se nao achou, oferece opcao de vincular link generico
    linkable = e.target;
  }
  e.preventDefault();
  e.stopPropagation();
  const key = getElementLinkKey(linkable) || ('elem-' + Date.now());
  console.log('[CTX] abrindo menu com key:', key);
  showCtxMenu(e.clientX, e.clientY, key, linkable);
  return false;
}, true); // capture mode pra rodar antes de qualquer outro

function showCtxMenu(x, y, key, el){
  const menu = document.getElementById('ctxMenu');
  if(!menu) return;
  const current = _customLinks[key];
  const label = (el.textContent || '').trim().split('\n')[0].slice(0, 35) || 'Elemento';
  // Detectar tipo do elemento pra ofecer acoes especificas
  const isClient = el.closest('.cli-btn, .client-card, .clist-row');
  const isFile = el.closest('.file');
  const isTask = el.closest('.kanban-card, .check-item');
  const isMeeting = el.closest('.meeting-card');
  const isCaptacao = el.closest('.cap-row, .cap-cal .cc-item');
  const isFeedback = el.closest('.fb-entry');
  const isNavItem = el.classList.contains('nav-item');
  const safeKey = key.replace(/'/g,"\\'");
  const safeLabel = label.replace(/'/g,"\\'");
  
  let actions = '';
  // ===== Acoes especificas por tipo =====
  if(isFile){
    actions += `<div class="ctx-item" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')">📁 Abrir no Google Drive</div>`;
    actions += `<div class="ctx-item" onclick="toast('Renomeando: ${safeLabel}','info')">✏️ Renomear</div>`;
    actions += `<div class="ctx-item" onclick="toast('Download iniciado','info')">⬇ Baixar</div>`;
    actions += `<div class="ctx-item" onclick="copy('${safeLabel}','Nome do arquivo')">📋 Copiar nome</div>`;
    actions += `<div class="ctx-divider"></div>`;
  }
  if(isClient){
    const cliId = el.closest('[onclick*="openClient"]')?.getAttribute('onclick')?.match(/openClient\((\d+)\)/)?.[1];
    if(cliId){
      actions += `<div class="ctx-item" onclick="openClient(${cliId})">👁 Abrir perfil completo</div>`;
      actions += `<div class="ctx-item danger" onclick="confirmarExcluirCliente(${cliId})">🗑 Excluir cliente</div>`;
      actions += `<div class="ctx-divider"></div>`;
    }
  }
  if(isCaptacao){
    actions += `<div class="ctx-item" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')">📁 Pasta no Drive</div>`;
    actions += `<div class="ctx-divider"></div>`;
  }
  if(isMeeting){
    actions += `<div class="ctx-item" onclick="openLinksManager('dashboard-meet','📹 Google Meet','https://meet.google.com/new')">📹 Iniciar reunião</div>`;
    actions += `<div class="ctx-divider"></div>`;
  }
  // ===== Acoes universais =====
  if(current){
    actions += `<div class="ctx-item" onclick="openLink('${current.url.replace(/'/g,"\\\'")}')">🔗 Abrir link: ${current.url.slice(0,30)}${current.url.length>30?'...':''}</div>`;
    actions += `<div class="ctx-item" onclick="editCustomLink('${safeKey}')">✏️ Editar link vinculado</div>`;
    actions += `<div class="ctx-item danger" onclick="removeCustomLink('${safeKey}')">🗑 Remover link</div>`;
  } else {
    actions += `<div class="ctx-item" onclick="createCustomLink('${safeKey}','${safeLabel}')">🔗 Vincular a um link</div>`;
  }
  actions += `<div class="ctx-divider"></div>`;
  actions += `<div class="ctx-item" onclick="copy(\`${safeLabel}\`,'Texto')">📋 Copiar texto</div>`;
  actions += `<div class="ctx-item" onclick="openLink(window.location.href + '#' + '${safeKey}')">🔖 Copiar link direto</div>`;
  
  menu.innerHTML = `
    <div class="ctx-current">📌 ${label}</div>
    ${actions}
  `;
  menu.style.left = Math.min(x, window.innerWidth - 240) + 'px';
  menu.style.top = Math.min(y, window.innerHeight - 320) + 'px';
  menu.style.display = 'block';
  menu.style.visibility = 'visible';
  menu.style.opacity = '1';
  menu.style.pointerEvents = 'auto';
  menu.style.zIndex = '99999';
  menu.classList.add('open');
  // Flag para impedir fechamento imediato
  window._ctxJustOpened = Date.now();
  console.log('[CTX] menu aberto em', x, y, '· visible?', menu.offsetWidth > 0);
}

async function createCustomLink(key, defaultLabel){
  closeCtxMenu();
  const url = prompt(`Cole a URL para vincular a "${defaultLabel}":\n\n(Exemplo: https://drive.google.com/drive/folders/abc)`, 'https://');
  if(!url || !url.startsWith('http')) return;
  if(_supa){
    try {
      await _supa.from('custom_links').upsert({link_key: key, url, label: defaultLabel}, {onConflict: 'link_key'});
      _customLinks[key] = {url, label: defaultLabel};
      applyCustomLinks();
      toast('✓ Link vinculado e salvo','success');
    } catch(e){ toast('Erro ao salvar: '+e.message,'info') }
  } else {
    _customLinks[key] = {url, label: defaultLabel};
    applyCustomLinks();
    toast('Link salvo localmente (sem banco)','info');
  }
}

async function editCustomLink(key){
  closeCtxMenu();
  const current = _customLinks[key];
  const url = prompt('Editar URL:', current.url);
  if(!url) return;
  if(_supa){
    try {
      await _supa.from('custom_links').update({url}).eq('link_key', key);
      _customLinks[key].url = url;
      applyCustomLinks();
      toast('✓ Link atualizado','success');
    } catch(e){ toast('Erro: '+e.message,'info') }
  }
}

async function removeCustomLink(key){
  closeCtxMenu();
  if(!(await confirmDelete('link customizado'))) return;
  if(_supa){
    try {
      await _supa.from('custom_links').delete().eq('link_key', key);
      delete _customLinks[key];
      applyCustomLinks();
      toast('✓ Link removido','success');
    } catch(e){ toast('Erro: '+e.message,'info') }
  }
}

function closeCtxMenu(){
  const m = document.getElementById('ctxMenu');
  if(m){
    m.classList.remove('open');
    m.style.display = 'none';
  }
}

// Fecha menu ao clicar fora — com delay pra evitar fechar no mesmo evento que abriu
document.addEventListener('click', e => {
  // Se menu acabou de abrir (menos de 300ms), nao fecha
  if(window._ctxJustOpened && (Date.now() - window._ctxJustOpened) < 300) return;
  if(!e.target.closest('.ctx-menu')) closeCtxMenu();
});

// Tambem fecha com Escape
document.addEventListener('keydown', e => {
  if(e.key === 'Escape') closeCtxMenu();
});

// Interceptar clicks pra usar link custom se existir
document.addEventListener('click', e => {
  // Verifica se o elemento (ou ancestral) tem link customizado
  let el = e.target;
  while(el && el !== document.body){
    if(el.dataset && el.dataset.linkKey && _customLinks[el.dataset.linkKey]){
      e.preventDefault();
      e.stopPropagation();
      openLink(_customLinks[el.dataset.linkKey].url);
      return;
    }
    el = el.parentElement;
  }
}, true); // capture mode pra rodar antes de outros handlers

// Re-aplicar links a cada renderizacao (observer)
const _renderObs = new MutationObserver(() => applyCustomLinks());
setTimeout(() => {
  const cEl = document.getElementById('content');
  if(cEl) _renderObs.observe(cEl, {childList: true, subtree: true});
}, 1500);


console.log('[MAIN] Script principal iniciou');

// ============ SUPABASE DATA LAYER ============
let _dataSource = 'mock'; // 'mock' | 'supabase'

async function loadDataFromSupabase(){
  if(!_supa) return false;
  try {
    // ===== CLIENTES =====
    const { data: cliData, error: cliErr } = await _supa.from('clients').select('*').order('name');
    if(cliErr) throw cliErr;
    if(cliData && cliData.length > 0){
      clients.length = 0;
      cliData.forEach((cl, idx) => {
        clients.push({
          id: idx + 1, _dbId: cl.id, origIdx: idx,
          name: cl.name, segment: cl.segment || '', color: cl.color || '#1d1d1f',
          init: cl.initials || cl.name.substring(0,2).toUpperCase(),
          logo_url: cl.logo_url || '',
          mrr: parseFloat(cl.mrr) || 0, status: cl.status || 'active',
          owner: cl.owner_interno || '',
          phone: cl.phone || cl.contact_phone || '',
          ig: cl.instagram || '',
          site: cl.website || cl.site_url || '',
          email: cl.email || cl.contact_email || '',
          // Campos de contato extra
          contact_name: cl.contact_name || '',
          contact_role: cl.contact_role || '',
          // URLs customizadas dos quick actions
          instagram_url: cl.instagram_url || '',
          drive_url: cl.drive_url || '',
          meet_url: cl.meet_url || '',
          mlabs_url: cl.mlabs_url || '',
          site_url: cl.site_url || cl.website || '',
          contrato_url: cl.contrato_url || '',
          criativos_url: cl.criativos_url || '',
          relatorios_url: cl.relatorios_url || '',
          whatsapp_url: cl.whatsapp_url || '',
          observacoes: cl.observacoes || '',
          antes_impulse: cl.antes_impulse || {},
          gestor_nome: cl.gestor_nome || '',
          gestor_id: cl.gestor_id || null,
          planName: cl.plan_name || '',
          planValue: parseFloat(cl.plan_value) || 0,
          plan_designer: cl.plan_designer || '',
          contract_start: cl.contract_start || '',
          renovation_date: cl.renovation_date || '',
          services_list: cl.services_list || cl.services || [],
          services: cl.services || [],
          journey_steps: Array.isArray(cl.journey_steps) ? cl.journey_steps : [],
          oculto: !!cl.oculto,
          cnpj: cl.cnpj || ''
        });
      });
    }

    // ===== CAPTACOES =====
    const { data: capData } = await _supa.from('captacoes').select('*').order('scheduled_date');
    if(capData){
      captacoes.length = 0;
      capData.forEach((cp, idx) => {
        const cli = clients.find(c=>c._dbId===cp.client_id);
        const cliName = cp.client_custom_name || (cli?cli.name:'Cliente avulso');
        const cliInit = cp.client_custom_name ? cp.client_custom_name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase() : (cli?cli.init:'C');
        captacoes.push({
          id: idx + 1, _dbId: cp.id,
          client: cliName,
          client_id: cp.client_id,
          client_custom_name: cp.client_custom_name || '',
          client_custom_company: cp.client_custom_company || '',
          color: cli?cli.color:'#7c3aed',
          init: cliInit,
          phone: cli?cli.phone:'',
          type: cp.type,
          resp: cp.responsavel_nome || 'Equipe',
          responsavel_nome: cp.responsavel_nome || '',
          responsavel_telefone: cp.responsavel_telefone || '',
          contato_local_nome: cp.contato_local_nome || '',
          contato_local_telefone: cp.contato_local_telefone || '',
          material_url: cp.material_url || '',
          referencia_url: cp.referencia_url || '',
          briefing_arquivo_url: cp.briefing_arquivo_url || '',
          briefing_arquivo_nome: cp.briefing_arquivo_nome || '',
          share_token: cp.share_token || '',
          addr: cp.address || '',
          date: cp.scheduled_date,
          time: (cp.scheduled_time || '10:00').substring(0,5),
          status: cp.status || 'agendada',
          priority: cp.priority || 'med',
          brief: cp.briefing || '',
          drive: cp.drive_url || cp.material_url || '',
          materials: cp.materials || [],
          prazo_entrega: cp.prazo_entrega || null,
          entregue: cp.entregue || false,
          entregue_em: cp.entregue_em || null
        });
      });
    }

    // ===== CRONOGRAMA =====
    const { data: cronData } = await _supa.from('cronograma').select('*');
    if(cronData && cronData.length > 0){
      // Reconstruir o objeto cronograma global a partir do banco
      const newCron = {};
      cronData.forEach(row => {
        const cli = clients.find(c=>c._dbId===row.client_id);
        if(!cli) return;
        if(!newCron[cli.id]) newCron[cli.id] = {};
        newCron[cli.id][row.month] = {
          _dbId: row.id,
          produced: row.produced || 0,
          target: row.target || 0,
          hasTraffic: row.has_traffic || false,
          trafficManager: row.traffic_manager || '',
          designer: row.designer || '',
          status: row.status || 'planejado',
          pop: row.pop || '',
          deadline: row.deadline || '',
          obs: row.observations || ''
        };
      });
      // Substituir cronograma em-place
      Object.keys(cronograma).forEach(k => delete cronograma[k]);
      Object.assign(cronograma, newCron);
    }


    // ===== PROFILES (mapear team + atualizar campos) =====
    // Carrega lista de excluidos ANTES dos profiles, pra filtrar corretamente
    try { await _loadColabExcluidos(); } catch(e){ console.warn('[excluidos] load falhou', e); }
    // Normalizador: tira acentos e lowercase pra match de nomes (leticia ↔ Letícia)
    const _normNome = s => (s||'').normalize('NFD').replace(/[\u0300-\u036F]/g,'').toLowerCase().trim();
    const { data: profData } = await _supa.from('profiles').select('*').order('full_name');
    if(profData){
      console.log('[LOAD] 📥 Recebidos', profData.length, 'profiles do banco:', profData);
      profData.forEach(p => {
        console.log('[LOAD] profile:', p.full_name, '| salary:', p.salary, '| vacation_total:', p.vacation_total, '| vacation_used:', p.vacation_used);
        // Match com team por full_name (exato ou primeiro nome IGUAL — nao startsWith pra evitar Gabriel vs Gabrielly)
        const found = team.find(t => {
          if(!t.name || !p.full_name) return false;
          // Match exato por nome completo
          if(t.name === p.full_name) return true;
          // Match exato por _dbId (se ja tinha sido linkado)
          if(t._dbId && t._dbId === p.id) return true;
          // Match exato por email (mais confiavel)
          if(t.email && p.email && t.email.toLowerCase() === p.email.toLowerCase()) return true;
          // Match por primeiro nome EXATO (sem acento, case-insensitive) — leticia ↔ Letícia
          const tPrim = _normNome((t.name||'').split(/\s+/)[0]);
          const pPrim = _normNome((p.full_name||'').split(/\s+/)[0]);
          return tPrim === pPrim && tPrim.length > 0;
        });
        if(found){
          found._dbId = p.id;
          // ATUALIZA todos os campos do banco no mock (pra mudancas persistirem)
          if(p.full_name) found.name = p.full_name;
          if(p.position) found.role = p.position;
          if(p.cpf !== null && p.cpf !== undefined) found.cpf = p.cpf;
          if(p.phone !== null && p.phone !== undefined) found.phone = p.phone;
          if(p.email !== null && p.email !== undefined) found.email = p.email;
          if(p.address !== null && p.address !== undefined) found.address = p.address;
          if(p.contract_type !== undefined) found.contract_type = p.contract_type || 'CLT';
          if(p.contract_start) found.since = p.contract_start;
          if(p.salary !== null && p.salary !== undefined) found.salary = parseFloat(p.salary);
          if(p.bank !== null && p.bank !== undefined) found.bank = p.bank;
          if(p.vacation_total !== null && p.vacation_total !== undefined) found.vacationDays = p.vacation_total;
          if(p.vacation_used !== null && p.vacation_used !== undefined) found.vacationUsed = p.vacation_used;
          if(p.vacation_period_end) found.vacation_period_end = p.vacation_period_end;
          if(p.vacation_legal_deadline) found.vacation_legal_deadline = p.vacation_legal_deadline;
          if(p.last_vacation) found.lastVacation = p.last_vacation;
          if(p.birthday) found.birthday = p.birthday;
          if(p.productivity !== null && p.productivity !== undefined) found.prod = p.productivity;
          if(p.weekly_tasks !== null && p.weekly_tasks !== undefined) found.tasks = p.weekly_tasks;
          if(p.promotion_eval) found.promotion_eval = p.promotion_eval;
          if(p.raise_eval) found.raise_eval = p.raise_eval;
          if(p.areas_develop) found.areas_develop = p.areas_develop;
          if(p.strengths) found.strengths = p.strengths;
          if(p.next_review) found.next_review = p.next_review;
          if(p.work_start_time) found.work_start_time = p.work_start_time;
          if(p.work_end_time) found.work_end_time = p.work_end_time;
          if(p.lunch_duration_min !== null && p.lunch_duration_min !== undefined) found.lunch_duration_min = p.lunch_duration_min;
          if(p.tolerance_min !== null && p.tolerance_min !== undefined) found.tolerance_min = p.tolerance_min;
          if(p.work_days) found.work_days = p.work_days;
          if(p.avatar_color) found.color = p.avatar_color;
          if(p.initials) found.init = p.initials;
        } else {
          // Profile no banco que não está no mock — adiciona ao team
          team.push({
            _dbId: p.id,
            name: p.full_name,
            role: p.position || '',
            cpf: p.cpf || '',
            phone: p.phone || '',
            email: p.email || '',
            address: p.address || '',
            contract_type: p.contract_type || 'CLT',
            since: p.contract_start || '2024-01-01',
            salary: parseFloat(p.salary)||0,
            bank: p.bank || '',
            vacationDays: p.vacation_total || 30,
            vacationUsed: p.vacation_used || 0,
            prod: p.productivity || 85,
            tasks: p.weekly_tasks || 10,
            color: p.avatar_color || '#1d1d1f',
            init: p.initials || (p.full_name?.[0]||'?').toUpperCase()
          });
        }
      });

      // Remove team mock inicial que foi marcado como excluido localmente
      for(let k = team.length - 1; k >= 0; k--){
        if(_estaExcluido(team[k].name, team[k]._dbId)){
          console.log('[load] colaborador excluido (skip):', team[k].name);
          team.splice(k, 1);
        }
      }
    }

    // ===== AUTOMATIONS =====
    const { data: autoData } = await _supa.from('automations').select('*');
    if(autoData){
      _serverAutomations = autoData.map(a => ({
        _dbId: a.id, name: a.name, desc: a.description, trig: a.trigger, act: a.action, on: a.enabled
      }));
    }

    // ===== FEEDBACKS =====
    const { data: fbData } = await _supa.from('feedbacks').select('*').order('created_at',{ascending:false});
    if(fbData){
      // Limpar e repopular feedbackData
      Object.keys(feedbackData).forEach(k => feedbackData[k] = []);
      fbData.forEach(f => {
        // Achar collaborator por _dbId nas team profiles
        const tm = team.find(t => t._dbId === f.collaborator_id);
        if(tm){
          if(!feedbackData[tm.name]) feedbackData[tm.name] = [];
          feedbackData[tm.name].push({
            id: f.id, _dbId: f.id,
            type: f.type, author: f.author_id || 'Equipe',
            date: f.created_at.split('T')[0], period: f.period || 'Q2 2026',
            score: parseFloat(f.score), text: f.text
          });
        }
      });
    }

    
    // ===== MEETINGS =====
    const { data: mtData } = await _supa.from('meetings').select('*').order('scheduled_at',{ascending:true});
    if(mtData){
      meetings.length = 0;
      mtData.forEach((m, idx) => {
        const cli = clients.find(c=>c._dbId===m.client_id);
        const d = new Date(m.scheduled_at);
        meetings.push({
          id: idx+1, _dbId: m.id,
          day: d.getDate(),
          m: d.toLocaleDateString('pt-BR',{month:'short'}).replace('.',''),
          title: m.title,
          time: d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}),
          type: m.type || 'Reunião',
          c: cli?cli.name:'Interno',
          plat: m.platform || 'Google Meet',
          people: m.attendees || ['E'],
          notes: m.notes, ata: m.ata, meet_url: m.meet_url
        });
      });
    }

    // ===== TASKS (Kanban + Daily checklist) =====
    const { data: tkData } = await _supa.from('tasks').select('*').order('created_at',{ascending:false});
    if(tkData){
      // Limpar dailyChecklists do banco
      Object.keys(dailyChecklists).forEach(k => dailyChecklists[k] = []);
      tkData.forEach(t => {
        const tm = team.find(x => x._dbId === t.assigned_to);
        if(!tm) return;
        const firstName = tm.name.split(' ')[0];
        if(!dailyChecklists[firstName]) dailyChecklists[firstName] = [];
        if(t.is_daily){
          const cli = clients.find(c=>c._dbId===t.client_id);
          dailyChecklists[firstName].push({
            _dbId: t.id,
            t: t.title, p: t.priority||'med',
            time: t.scheduled_time?t.scheduled_time.substring(0,5):'09:00',
            client: cli?cli.name:'Geral',
            done: t.done||false
          });
        }
      });
    }

    _dataSource = 'supabase';
    // Aplica cache local sobre os clientes (preserva edições não salvas no banco)
    try { aplicarCacheLocalClientes(); } catch(e){ console.warn('[cache local clientes]', e); }
    try { aplicarCacheLocalCronograma(); } catch(e){ console.warn('[cache local cron]', e); }
    return true;
  } catch(e) {
    console.error('Erro Supabase:', e);
    return false;
  }
}

let _serverAutomations = null;

// ============ SAVE HELPERS (com logs visiveis + toasts em todos) ============
async function dbCreate(table, data){
  console.log('[dbCreate] ' + table, data);
  if(!_supa){ toast('⚠ Banco nao conectado (Supabase)', 'info'); console.warn('[dbCreate] _supa undefined'); return null; }
  try {
    const { data: r, error } = await _supa.from(table).insert(data).select().single();
    if(error) throw error;
    console.log('[dbCreate] ✓ ' + table, r);
    return r;
  } catch(e) {
    console.error('[dbCreate] ✗ ' + table, e);
    toast('Erro ao criar em ' + table + ': ' + (e.message||e), 'info');
    return null;
  }
}

async function dbUpdate(table, id, data){
  console.log('[dbUpdate] ' + table + ' id=' + id, data);
  if(!_supa){ toast('⚠ Banco nao conectado', 'info'); console.warn('[dbUpdate] _supa undefined'); return null; }
  if(!id){ toast('⚠ ID nao informado pra update', 'info'); console.warn('[dbUpdate] id vazio'); return null; }
  try {
    const { data: r, error } = await _supa.from(table).update(data).eq('id', id).select().single();
    if(error) throw error;
    console.log('[dbUpdate] ✓ ' + table, r);
    return r;
  } catch(e) {
    console.error('[dbUpdate] ✗ ' + table, e);
    // Erro de RLS / permissao
    if(e.code === '42501' || (e.message||'').toLowerCase().includes('policy') || (e.message||'').toLowerCase().includes('permission')){
      toast('🔒 Permissao negada (RLS). Rode o SQL 42-rls-tudo-aberto.sql no Supabase', 'info');
    } else {
      toast('Erro ao atualizar ' + table + ': ' + (e.message||e), 'info');
    }
    return null;
  }
}

async function dbDelete(table, id){
  console.log('[dbDelete] ' + table + ' id=' + id);
  if(!_supa){ toast('⚠ Banco nao conectado', 'info'); console.warn('[dbDelete] _supa undefined'); return false; }
  if(!id){ toast('⚠ ID nao informado pra delete', 'info'); console.warn('[dbDelete] id vazio'); return false; }
  try {
    const { error } = await _supa.from(table).delete().eq('id', id);
    if(error) throw error;
    console.log('[dbDelete] ✓ ' + table);
    return true;
  } catch(e) {
    console.error('[dbDelete] ✗ ' + table, e);
    if(e.code === '42501' || (e.message||'').toLowerCase().includes('policy') || (e.message||'').toLowerCase().includes('permission')){
      toast('🔒 Permissao negada (RLS). Rode o SQL 42-rls-tudo-aberto.sql', 'info');
    } else if(e.code === '23503' || (e.message||'').toLowerCase().includes('foreign')){
      toast('Nao da pra excluir: tem dados vinculados a esse registro', 'info');
    } else {
      toast('Erro ao excluir ' + table + ': ' + (e.message||e), 'info');
    }
    return false;
  }
}

// HEALTH CHECK: chame no console pra verificar se tudo esta funcionando
window.verificarSistema = async function(){
  console.log('=== HEALTH CHECK SISTEMA ===');
  console.log('1. _supa disponivel:', !!_supa);
  console.log('2. Usuario logado:', _currentUser && _currentUser.email);
  console.log('3. Perfil carregado:', _currentProfile && _currentProfile.name);
  console.log('4. Total team:', team.length, 'colaboradores');
  console.log('5. Total clients:', clients.length, 'clientes');
  if(_supa){
    try {
      const { data, error } = await _supa.from('profiles').select('id,name').limit(1);
      console.log('6. READ profiles:', error ? '✗ '+error.message : '✓ OK', data && data[0]);
    } catch(e){ console.log('6. READ profiles: ✗', e.message); }
    try {
      const { error } = await _supa.from('profiles').update({updated_at: new Date().toISOString()}).eq('id', '00000000-0000-0000-0000-000000000000');
      console.log('7. UPDATE profiles (teste):', error && error.code === '42501' ? '🔒 RLS BLOQUEANDO' : (error ? '✓ permitido (id fake nao existe)' : '✓ OK'));
    } catch(e){ console.log('7. UPDATE profiles: ✗', e.message); }
  }
  toast('Health check rodado. Veja o console (F12)', 'success');
};

// ============ SAVE ESPECIFICOS ============

// Debouncer pra observações do cronograma
let _cronTimers = {};
function debouncedSaveCron(cliId, month, value){
  const key = cliId + '-' + month;
  if(_cronTimers[key]) clearTimeout(_cronTimers[key]);
  _cronTimers[key] = setTimeout(()=>{
    saveCronogramaObs(cliId, month, value);
  }, 800);
}

async function saveCronogramaObs(cliId, month, value){
  const cli = clients.find(c=>c.id===cliId);
  if(!cli || !cli._dbId) return;
  const entry = cronograma[cliId] && cronograma[cliId][month];
  if(!entry) return;
  if(entry._dbId){
    await dbUpdate('cronograma', entry._dbId, {observations: value});
  } else {
    const r = await dbCreate('cronograma', {client_id: cli._dbId, year: 2026, month, observations: value, target: entry.target, produced: entry.produced, status: entry.status, deadline: entry.deadline});
    if(r) entry._dbId = r.id;
  }
}

// Atualiza qualquer campo do cronograma (genérico)
// ============ CACHE LOCAL DO CRONOGRAMA ============
function _cronLocalKey(cliId, month){ return 'cron_'+cliId+'_'+month; }
function _cronLocalGet(cliId, month){
  try { return JSON.parse(localStorage.getItem(_cronLocalKey(cliId,month)) || '{}'); }
  catch(e){ return {}; }
}
function _cronLocalSet(cliId, month, field, value){
  const data = _cronLocalGet(cliId, month);
  data[field] = value;
  try { localStorage.setItem(_cronLocalKey(cliId,month), JSON.stringify(data)); } catch(e){}
}
// Aplica cache local sobre o cronograma carregado do banco
function aplicarCacheLocalCronograma(){
  if(!cronograma) return;
  Object.keys(cronograma).forEach(cliId => {
    Object.keys(cronograma[cliId]).forEach(month => {
      const cache = _cronLocalGet(cliId, month);
      const entry = cronograma[cliId][month];
      Object.keys(cache).forEach(k => {
        const val = entry[k];
        const isEmpty = val === '' || val === null || val === undefined || val === 0 || val === false || (Array.isArray(val) && val.length === 0);
        if(isEmpty && cache[k] !== '' && cache[k] !== null && cache[k] !== undefined){
          entry[k] = cache[k];
        }
      });
    });
  });
}

// Alterna se cliente está oculto da visualizacao
async function toggleClienteOculto(cliId){
  const cli = clients.find(c => c.id === cliId);
  if(!cli){ toast('Cliente nao encontrado','info'); return; }
  const novoEstado = !cli.oculto;
  cli.oculto = novoEstado;
  if(_supa && cli._dbId){
    const { error } = await _supa.from('clients').update({oculto: novoEstado}).eq('id', cli._dbId);
    if(error){
      if(error.code === '42703' || (error.message||'').includes('column')){
        toast('⚠ Rode o SQL 49-clientes-ocultos.sql pra salvar no banco','info');
      } else {
        toast('Erro: '+error.message,'info');
      }
      cli.oculto = !novoEstado;
      return;
    }
  }
  toast(novoEstado ? '👁‍🗨 Cliente ocultado · acesse pela aba "Ocultos"' : '👁 Cliente voltou pra lista', 'success');
  if(typeof renderCronograma === 'function') renderCronograma(document.getElementById('content'));
}

async function updateCronField(cliId, month, field, value){
  const cli = clients.find(c=>c.id===cliId);
  if(!cli){ toast('Cliente não encontrado','info'); return; }
  if(!cronograma[cliId]) cronograma[cliId] = {};
  if(!cronograma[cliId][month]) cronograma[cliId][month] = {produced:0,target:0,status:'planejado',deadline:'',obs:'',hasTraffic:false,designer:'',trafficManager:''};
  const entry = cronograma[cliId][month];
  // 1) Atualiza memória
  entry[field] = value;
  // 2) Salva cache local SEMPRE (não perde com refresh mesmo se banco falhar)
  _cronLocalSet(cliId, month, field, value);

  // Mapping pra colunas do banco
  const map = {
    produced:'produced', target:'target',
    hasTraffic:'has_traffic', trafficManager:'traffic_manager',
    designer:'designer', status:'status', pop:'pop', deadline:'deadline', obs:'observations'
  };
  const col = map[field];
  if(!col){ console.warn('[updateCronField] coluna não mapeada:', field); return; }
  if(!_supa || !cli._dbId){ return; }
  try {
    if(entry._dbId){
      const payload = {};
      payload[col] = (value === '' ? null : value);
      const { error } = await _supa.from('cronograma').update(payload).eq('id', entry._dbId);
      if(error){
        console.error('[updateCronField] erro:', error);
        if(error.code === 'PGRST204' || (error.message && error.message.toLowerCase().includes(col))){
          toast('⚠ Coluna "'+col+'" não existe no banco. Salvo no seu navegador.','info');
        } else { toast('Erro: '+error.message,'info'); }
        return;
      }
    } else {
      // Cria nova linha com todos os campos
      const payload = {
        client_id: cli._dbId, year: 2026, month,
        produced: entry.produced||0,
        target: entry.target||0,
        has_traffic: !!entry.hasTraffic,
        traffic_manager: entry.trafficManager||null,
        designer: entry.designer||null,
        status: entry.status||'planejado',
        pop: entry.pop||null,
        deadline: entry.deadline||null,
        observations: entry.obs||null
      };
      const { data, error } = await _supa.from('cronograma').insert(payload).select().single();
      if(error){
        console.error('[insertCron]', error);
        if(error.code === '23505'){
          // Duplicado — busca o que já existe
          const r = await _supa.from('cronograma').select('id').eq('client_id', cli._dbId).eq('year',2026).eq('month',month).maybeSingle();
          if(r.data && r.data.id){
            entry._dbId = r.data.id;
            // Tenta atualizar agora
            return updateCronField(cliId, month, field, value);
          }
        }
        toast('Erro: '+error.message,'info');
        return;
      }
      entry._dbId = data.id;
    }
    // Propaga designer e trafficManager pros proximos meses VAZIOS do mesmo ano (2026)
    // — so propaga onde o campo correspondente ainda nao foi customizado.
    // Quando propaga trafficManager, garante hasTraffic=true junto.
    if((field === 'designer' || field === 'trafficManager') && value){
      try {
        const propagados = await propagarCronCampo(cliId, month, field, value);
        if(propagados > 0){
          toast('✓ Replicado em ' + propagados + ' mes(es) futuro(s)','success');
        }
      } catch(e){ console.warn('[propagarCronCampo]', e); }
    }

    // Re-renderiza pra refletir mudanças
    if(field === 'status' || field === 'pop' || field === 'deadline' || field === 'produced' || field === 'target' || field === 'designer' || field === 'trafficManager' || field === 'hasTraffic'){
      renderCronograma(document.getElementById('content'));
    }
  } catch(e){
    console.error('[updateCronField] exception:', e);
    toast('Erro: '+e.message,'info');
  }
}

// Propaga um campo (designer ou trafficManager) pros proximos meses do ano
// que estao VAZIOS. Nao sobrescreve meses ja customizados.
// Retorna o numero de meses afetados.
async function propagarCronCampo(cliId, fromMonth, field, value){
  const cli = clients.find(c => c.id === cliId);
  if(!cli || !cli._dbId) return 0;
  if(!cronograma[cliId]) cronograma[cliId] = {};
  const col = field === 'designer' ? 'designer' : 'traffic_manager';
  let count = 0;
  // Itera de fromMonth+1 ate dezembro (11) do mesmo ano (2026 hardcoded)
  for(let mes = fromMonth + 1; mes <= 11; mes++){
    if(!cronograma[cliId][mes]){
      cronograma[cliId][mes] = {produced:0,target:0,status:'planejado',deadline:'',obs:'',hasTraffic:false,designer:'',trafficManager:''};
    }
    const entry = cronograma[cliId][mes];
    const atual = entry[field];
    // So propaga se o campo no mes futuro esta vazio
    if(atual && atual !== '') continue;
    entry[field] = value;
    _cronLocalSet(cliId, mes, field, value);
    // Quando propaga trafficManager, garante hasTraffic=true tambem
    const extraHasTraffic = (field === 'trafficManager');
    if(extraHasTraffic){
      entry.hasTraffic = true;
      _cronLocalSet(cliId, mes, 'hasTraffic', true);
    }
    if(_supa){
      try {
        if(entry._dbId){
          const payload = {};
          payload[col] = value;
          if(extraHasTraffic) payload.has_traffic = true;
          await _supa.from('cronograma').update(payload).eq('id', entry._dbId);
        } else {
          const payload = {
            client_id: cli._dbId, year: 2026, month: mes,
            produced: entry.produced||0, target: entry.target||0,
            has_traffic: extraHasTraffic ? true : !!entry.hasTraffic,
            traffic_manager: entry.trafficManager||null,
            designer: entry.designer||null,
            status: entry.status||'planejado',
            pop: entry.pop||null,
            deadline: entry.deadline||null,
            observations: entry.obs||null
          };
          const { data, error } = await _supa.from('cronograma').insert(payload).select().single();
          if(!error && data) entry._dbId = data.id;
          else if(error && error.code === '23505'){
            // Ja existe — busca o _dbId e atualiza
            const r = await _supa.from('cronograma').select('id').eq('client_id', cli._dbId).eq('year',2026).eq('month',mes).maybeSingle();
            if(r.data && r.data.id){
              entry._dbId = r.data.id;
              const upd = {};
              upd[col] = value;
              if(extraHasTraffic) upd.has_traffic = true;
              await _supa.from('cronograma').update(upd).eq('id', entry._dbId);
            }
          }
        }
      } catch(e){ console.warn('[propagarCronCampo] mes', mes, e); }
    }
    count++;
  }
  return count;
}

async function saveCronogramaStatus(cliId, month, status){
  const cli = clients.find(c=>c.id===cliId);
  if(!cli || !cli._dbId) return;
  const entry = cronograma[cliId] && cronograma[cliId][month];
  if(!entry) return;
  entry.status = status;
  if(entry._dbId) await dbUpdate('cronograma', entry._dbId, {status});
}

async function saveTaskDone(collab, idx, done, done_at){
  const list = dailyChecklists[collab];
  const item = list && list[idx];
  if(!item) return;
  const ts = done_at || (done ? new Date().toISOString() : null);
  if(item._dbId){
    // Tenta com done_at; se a coluna não existir, salva só done
    try {
      const { error } = await _supa.from('tasks').update({done, done_at: ts}).eq('id', item._dbId);
      if(error && error.message && error.message.toLowerCase().includes('done_at')){
        await _supa.from('tasks').update({done}).eq('id', item._dbId);
      }
    } catch(e){
      console.warn('[saveTaskDone]', e);
      await dbUpdate('tasks', item._dbId, {done});
    }
  } else {
    const tm = team.find(t=>t.name.startsWith(collab));
    const r = await dbCreate('tasks', {
      title: item.t, assigned_to: tm?tm._dbId:null,
      priority: item.p, scheduled_time: item.time, is_daily: true,
      done, done_at: ts,
      due_date: new Date().toISOString().split('T')[0]
    });
    if(r) item._dbId = r.id;
  }
}

async function saveFeedbackDb(collabName, fb){
  const tm = team.find(t=>t.name===collabName);
  if(!tm || !tm._dbId){toast('Colaborador sem registro no banco','info');return null}
  return await dbCreate('feedbacks', {
    collaborator_id: tm._dbId,
    type: fb.type, period: fb.period, score: fb.score, text: fb.text,
    author_id: tm._dbId  // por enquanto autor = mesmo (mock)
  });
}

async function saveAutomationToggle(idx, enabled){
  if(!_serverAutomations || !_serverAutomations[idx]) return;
  const a = _serverAutomations[idx];
  if(a._dbId) await dbUpdate('automations', a._dbId, {enabled});
  a.on = enabled;
}

async function savePontoBate(profileName, tipo, time){
  const tm = team.find(t=>t.name.startsWith(profileName)||t.name===profileName);
  if(!tm || !tm._dbId) return;
  const today = new Date().toISOString().split('T')[0];
  // Buscar registro existente do dia
  const { data: existing } = await _supa.from('time_clock').select('*').eq('profile_id', tm._dbId).eq('work_date', today).maybeSingle();
  const fieldMap = {entrada:'entrada', intervaloIn:'intervalo_inicio', intervaloOut:'intervalo_fim', saida:'saida'};
  const field = fieldMap[tipo];
  if(!field) return;
  const now = new Date().toISOString();
  if(existing){
    await dbUpdate('time_clock', existing.id, {[field]: now});
  } else {
    await dbCreate('time_clock', {profile_id: tm._dbId, work_date: today, [field]: now});
  }
}

async function saveCaptacaoStatus(capId, status){
  const cap = captacoes.find(c=>c.id===capId);
  if(!cap || !cap._dbId) return;
  cap.status = status;
  await dbUpdate('captacoes', cap._dbId, {status});
}


async function createClientInSupabase(data){
  if(!_supa) {toast('Supabase nao configurado','info');return null}
  try {
    const insert = {
      name: data.name,
      segment: data.segment || null,
      color: data.color || '#1d1d1f',
      initials: data.initials || data.name.substring(0,2).toUpperCase(),
      mrr: data.mrr || 0,
      status: data.status || 'active',
      phone: data.phone || null,
      email: data.email || null,
      instagram: data.instagram || null,
      website: data.website || null,
      plan_name: data.plan_name || 'Essencial',
      plan_value: data.plan_value || 1800,
      services: data.services || ['gestao_social','design']
    };
    const { data: created, error } = await _supa.from('clients').insert(insert).select().single();
    if(error) throw error;
    toast(`Cliente "${data.name}" criado no banco`,'success');
    await loadDataFromSupabase();
    return created;
  } catch(e) {
    toast('Erro ao criar: ' + e.message,'info');
    return null;
  }
}

async function deleteClientFromSupabase(dbId, name){
  if(!_supa || !dbId) return false;
  try {
    const { error } = await _supa.from('clients').delete().eq('id', dbId);
    if(error) throw error;
    toast(`Cliente "${name}" excluido do banco`,'success');
    await loadDataFromSupabase();
    return true;
  } catch(e) {
    toast('Erro ao excluir: ' + e.message,'info');
    return false;
  }
}


// ============ SUPABASE AUTH ============
const _supa = (window.supabase && window.IMPULSE_CONFIG)
  ? window.supabase.createClient(window.IMPULSE_CONFIG.SUPABASE_URL, window.IMPULSE_CONFIG.SUPABASE_ANON_KEY)
  : null;

let _currentUser = null;
let _appStarted = false;

async function checkAuth(){
  // ROTA PÚBLICA: ?cap=TOKEN abre página de captação sem login
  const url = new URL(window.location.href);
  const capToken = url.searchParams.get('cap');
  if(capToken){
    renderPublicCaptacao(capToken);
    return;
  }
  // ROTA PÚBLICA: ?briefing=TOKEN abre formulário pro cliente responder
  const brfToken = url.searchParams.get('briefing');
  if(brfToken){
    renderPublicBriefing(brfToken);
    return;
  }

  if(!_supa){
    document.getElementById('loginScreen')?.classList.add('hidden');
    if(!_appStarted){startApp(null);_appStarted=true}
    return;
  }
  const { data } = await _supa.auth.getSession();
  if(data && data.session){
    _currentUser = data.session.user;
    await loadCurrentProfile();
    document.getElementById('loginScreen')?.classList.add('hidden');
    if(!_appStarted){startApp(_currentUser);_appStarted=true}
  } else {
    document.getElementById('loginScreen')?.classList.remove('hidden');
    // Anti-autocomplete: gera nomes random e limpa campos
    try {
      const emailInp = document.getElementById('loginEmail');
      const pwdInp = document.getElementById('loginPwd');
      if(emailInp){
        emailInp.name = 'u_' + Math.random().toString(36).slice(2,10);
        // Limpa imediatamente e de novo depois (alguns navegadores preenchem com delay)
        emailInp.value = '';
        setTimeout(()=>{ emailInp.value = ''; }, 50);
        setTimeout(()=>{ emailInp.value = ''; }, 200);
        setTimeout(()=>{ emailInp.value = ''; }, 500);
        // Bloqueia readonly que é removido no foco (truque anti-autofill)
        emailInp.setAttribute('readonly', 'readonly');
        emailInp.addEventListener('focus', function(){ this.removeAttribute('readonly'); }, {once: true});
      }
      if(pwdInp){
        pwdInp.name = 'p_' + Math.random().toString(36).slice(2,10);
        pwdInp.value = '';
        setTimeout(()=>{ pwdInp.value = ''; }, 50);
        setTimeout(()=>{ pwdInp.value = ''; }, 200);
        setTimeout(()=>{ pwdInp.value = ''; }, 500);
        pwdInp.setAttribute('readonly', 'readonly');
        pwdInp.addEventListener('focus', function(){ this.removeAttribute('readonly'); }, {once: true});
      }
    } catch(e){}
  }
}

// ============ PÁGINA PÚBLICA DA CAPTAÇÃO (sem login) ============
async function renderPublicCaptacao(token){
  // Esconde tudo do app e do login
  document.getElementById('loginScreen')?.classList.add('hidden');
  const app = document.querySelector('.app');
  if(app) app.style.display = 'none';
  // Cria container limpo
  let pub = document.getElementById('publicCapView');
  if(!pub){
    pub = document.createElement('div');
    pub.id = 'publicCapView';
    pub.style.cssText = 'min-height:100vh;background:var(--bg);padding:32px 20px;display:flex;justify-content:center;align-items:flex-start';
    document.body.appendChild(pub);
  }
  pub.innerHTML = `<div style="text-align:center;padding:60px"><div style="font-size:32px;margin-bottom:14px">⏳</div><div style="font-size:14px;color:var(--text-2)">Carregando captação...</div></div>`;

  if(!_supa){
    pub.innerHTML = `<div style="text-align:center;padding:60px;color:var(--danger)">Erro ao conectar ao banco.</div>`;
    return;
  }
  try {
    const { data: cap, error } = await _supa.from('captacoes').select('*').eq('share_token', token).maybeSingle();
    if(error || !cap){
      pub.innerHTML = `
        <div style="max-width:480px;width:100%;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:40px;text-align:center;box-shadow:var(--shadow)">
          <div style="font-size:42px;margin-bottom:14px">🔍</div>
          <h2 style="margin:0 0 6px;font-size:18px;font-weight:700">Captação não encontrada</h2>
          <div style="font-size:13px;color:var(--text-3)">O link pode ter expirado ou ser inválido.</div>
        </div>`;
      return;
    }
    // Busca cliente (opcional)
    let cliName = cap.client_custom_name;
    if(cap.client_id){
      const { data: cli } = await _supa.from('clients').select('name').eq('id', cap.client_id).maybeSingle();
      if(cli) cliName = cli.name;
    }
    const dateObj = cap.scheduled_date ? new Date(cap.scheduled_date+'T'+(cap.scheduled_time||'10:00')) : null;
    const dateStr = dateObj ? dateObj.toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}) : '—';
    const timeStr = (cap.scheduled_time||'').substring(0,5) || '—';

    const linkRow = (icon, label, value, href) => value ? `
      <div style="display:flex;align-items:center;gap:12px;padding:13px 14px;background:var(--surface-2);border-radius:10px;margin-bottom:8px">
        <div style="font-size:20px;width:36px;text-align:center">${icon}</div>
        <div style="flex:1;min-width:0">
          <div style="font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:2px">${label}</div>
          <div style="font-size:14px;color:var(--text);font-weight:500;word-break:break-word">${href?`<a href="${href}" target="_blank" style="color:var(--text);text-decoration:none">${value} ↗</a>`:value}</div>
        </div>
      </div>` : '';

    pub.innerHTML = `
      <div style="max-width:640px;width:100%">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:var(--shadow)">
          <!-- Header -->
          <div style="background:linear-gradient(135deg,#1d1d1f,#3a3a3c);color:#fff;padding:28px">
            <div style="display:inline-block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.15);padding:4px 10px;border-radius:6px;margin-bottom:10px;font-weight:600">🎬 Captação agendada</div>
            <div style="font-size:22px;font-weight:800;letter-spacing:-.02em;margin-bottom:4px">${escapeHtml(cap.type||'Captação')}</div>
            <div style="font-size:13px;opacity:.8">${escapeHtml(cliName||'Cliente avulso')} ${cap.client_custom_company?'· '+escapeHtml(cap.client_custom_company):''}</div>
          </div>

          <!-- Status & data -->
          <div style="padding:20px 28px;border-bottom:1px solid var(--border);display:flex;gap:18px;flex-wrap:wrap;align-items:center">
            <div>
              <div style="font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:3px">📅 Quando</div>
              <div style="font-size:15px;font-weight:600">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)} · ${timeStr}</div>
            </div>
            <div style="margin-left:auto">
              <span class="badge ${ {agendada:'b-default',confirmada:'b-info','em andamento':'b-warning',finalizada:'b-success',cancelada:'b-danger'}[cap.status] || 'b-default'}" style="padding:5px 12px;font-size:12px">${cap.status||'agendada'}</span>
            </div>
          </div>

          <!-- Endereço -->
          ${cap.address ? `
          <div style="padding:18px 28px;border-bottom:1px solid var(--border)">
            <div style="font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:5px">📍 Endereço</div>
            <div style="font-size:14px;line-height:1.5">${escapeHtml(cap.address)}</div>
            <a href="https://maps.google.com/?q=${encodeURIComponent(cap.address)}" target="_blank" style="display:inline-block;margin-top:8px;font-size:12px;color:var(--accent);font-weight:600">🗺 Abrir no Maps →</a>
          </div>` : ''}

          <!-- Contatos -->
          <div style="padding:20px 28px;border-bottom:1px solid var(--border)">
            <div style="font-size:13px;font-weight:700;margin-bottom:12px">👥 Contatos</div>
            ${linkRow('📸','Nosso profissional', (cap.responsavel_nome||'')+(cap.responsavel_telefone?' — '+cap.responsavel_telefone:''), cap.responsavel_telefone?`https://wa.me/${cap.responsavel_telefone}`:null)}
            ${linkRow('👤','Contato no local', (cap.contato_local_nome||'')+(cap.contato_local_telefone?' — '+cap.contato_local_telefone:''), cap.contato_local_telefone?`https://wa.me/${cap.contato_local_telefone}`:null)}
            ${!cap.responsavel_nome && !cap.contato_local_nome ? `<div class="text-xs text-3">Nenhum contato cadastrado.</div>` : ''}
          </div>

          <!-- Briefing -->
          ${cap.briefing || cap.briefing_arquivo_url ? `
          <div style="padding:20px 28px;border-bottom:1px solid var(--border)">
            <div style="font-size:13px;font-weight:700;margin-bottom:10px">📝 Briefing</div>
            ${cap.briefing ? `<div style="font-size:13.5px;line-height:1.65;color:var(--text-2);white-space:pre-wrap;background:var(--surface-2);padding:14px;border-radius:10px;margin-bottom:10px">${escapeHtml(cap.briefing)}</div>` : ''}
            ${cap.briefing_arquivo_url ? `
              <a href="${cap.briefing_arquivo_url}" target="_blank" style="display:inline-flex;align-items:center;gap:8px;padding:10px 14px;background:var(--accent);color:var(--surface);border-radius:9px;text-decoration:none;font-size:13px;font-weight:600">
                📎 Baixar anexo do briefing${cap.briefing_arquivo_nome?' ('+escapeHtml(cap.briefing_arquivo_nome)+')':''}
              </a>` : ''}
          </div>` : ''}

          <!-- Links -->
          ${cap.material_url || cap.referencia_url ? `
          <div style="padding:20px 28px;border-bottom:1px solid var(--border)">
            <div style="font-size:13px;font-weight:700;margin-bottom:10px">📂 Links</div>
            ${linkRow('📤','Enviar material captado aqui', cap.material_url || '', cap.material_url)}
            ${linkRow('🎨','Referências / moodboard', cap.referencia_url || '', cap.referencia_url)}
          </div>` : ''}

          <!-- Footer -->
          <div style="padding:18px 28px;background:var(--surface-2);text-align:center">
            <div style="font-size:11px;color:var(--text-3)">Esta página foi gerada pelo sistema <strong>IMPULSE ONE</strong></div>
            <div style="font-size:10.5px;color:var(--text-3);margin-top:3px">Link exclusivo · não compartilhe publicamente</div>
          </div>
        </div>
      </div>
    `;
  } catch(e){
    console.error('[renderPublicCaptacao]', e);
    pub.innerHTML = `<div style="text-align:center;padding:60px;color:var(--danger)">Erro: ${e.message}</div>`;
  }
}

// ============ PÁGINA PÚBLICA DO BRIEFING (cliente responde) ============
async function renderPublicBriefing(token){
  document.getElementById('loginScreen')?.classList.add('hidden');
  const app = document.querySelector('.app');
  if(app) app.style.display = 'none';
  let pub = document.getElementById('publicCapView');
  if(!pub){
    pub = document.createElement('div');
    pub.id = 'publicCapView';
    pub.style.cssText = 'min-height:100vh;background:var(--bg);padding:24px 16px;display:flex;justify-content:center;align-items:flex-start';
    document.body.appendChild(pub);
  }
  pub.innerHTML = `<div style="text-align:center;padding:60px"><div style="font-size:32px;margin-bottom:14px">⏳</div><div style="font-size:14px;color:var(--text-2)">Carregando formulário...</div></div>`;

  if(!_supa){
    pub.innerHTML = `<div style="text-align:center;padding:60px;color:var(--danger)">Erro ao conectar.</div>`;
    return;
  }
  try {
    const { data: brf, error } = await _supa.from('client_briefings').select('*').eq('share_token', token).maybeSingle();
    if(error || !brf){
      pub.innerHTML = `
        <div style="max-width:480px;width:100%;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:40px;text-align:center;box-shadow:var(--shadow)">
          <div style="font-size:42px;margin-bottom:14px">🔍</div>
          <h2 style="margin:0 0 6px;font-size:18px;font-weight:700">Formulário não encontrado</h2>
          <div style="font-size:13px;color:var(--text-3)">O link pode ter expirado ou ser inválido.</div>
        </div>`;
      return;
    }
    // Já respondido?
    if(brf.responded_at && brf.responses){
      pub.innerHTML = `
        <div style="max-width:520px;width:100%;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:40px;text-align:center;box-shadow:var(--shadow)">
          <div style="font-size:46px;margin-bottom:14px">✅</div>
          <h2 style="margin:0 0 6px;font-size:20px;font-weight:700">Formulário já respondido</h2>
          <div style="font-size:13.5px;color:var(--text-2);line-height:1.6;margin-top:10px">Obrigado! Suas respostas já chegaram pra nós em ${new Date(brf.responded_at).toLocaleDateString('pt-BR')}. Se precisar enviar algo novo, fale conosco no WhatsApp.</div>
        </div>`;
      return;
    }
    // Renderiza o formulário
    const questions = brf.questions || [];
    pub.innerHTML = `
      <div style="max-width:680px;width:100%">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:var(--shadow)">
          <div style="background:linear-gradient(135deg,#1d1d1f,#3a3a3c);color:#fff;padding:28px">
            <div style="display:inline-block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.15);padding:4px 10px;border-radius:6px;margin-bottom:10px;font-weight:600">📋 Formulário · IMPULSE ONE</div>
            <div style="font-size:22px;font-weight:800;letter-spacing:-.02em;margin-bottom:6px">${escapeHtml(brf.title||'Briefing')}</div>
            ${brf.description ? `<div style="font-size:14px;opacity:.9;line-height:1.55;white-space:pre-wrap">${escapeHtml(brf.description)}</div>` : ''}
          </div>

          <form id="briefingForm" onsubmit="return submeterBriefing(event, '${brf.id}', '${token}')" style="padding:24px 28px">
            <div style="margin-bottom:18px;padding:13px 14px;background:var(--info-soft);color:var(--info-text);border-radius:9px;font-size:12.5px">
              ⏱️ Leva uns ${Math.max(2, Math.ceil(questions.length*0.5))} minutinhos. Suas respostas ficam salvas no nosso sistema.
            </div>

            <div style="margin-bottom:18px">
              <div style="font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:5px">SEU NOME *</div>
              <input id="brfRespName" required class="login-input" placeholder="Pra sabermos quem respondeu" style="background:var(--surface-2);width:100%" />
            </div>

            ${questions.map((q,i)=>{
              const reqMark = q.required ? ' *' : '';
              let input = '';
              if(q.type === 'long'){
                input = `<textarea name="${q.id}" ${q.required?'required':''} rows="3" placeholder="Sua resposta..." class="login-input" style="background:var(--surface-2);width:100%;resize:vertical;min-height:80px"></textarea>`;
              } else if(q.type === 'choice'){
                input = (q.options||[]).map(opt => `
                  <label style="display:flex;align-items:center;gap:9px;padding:10px 12px;background:var(--surface-2);border:1px solid var(--border);border-radius:9px;cursor:pointer;margin-bottom:6px;font-size:14px">
                    <input type="radio" name="${q.id}" value="${escapeHtml(opt)}" ${q.required?'required':''} />
                    <span>${escapeHtml(opt)}</span>
                  </label>
                `).join('');
              } else {
                const type = q.type === 'email' ? 'email' : q.type === 'phone' ? 'tel' : q.type === 'url' ? 'url' : 'text';
                input = `<input type="${type}" name="${q.id}" ${q.required?'required':''} class="login-input" placeholder="Sua resposta..." style="background:var(--surface-2);width:100%" />`;
              }
              return `
                <div style="margin-bottom:18px">
                  <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:8px;line-height:1.4">${i+1}. ${escapeHtml(q.label)}${reqMark}</div>
                  ${input}
                </div>
              `;
            }).join('')}

            <button type="submit" class="btn btn-primary" style="width:100%;padding:14px;font-size:14px;font-weight:700;margin-top:8px">
              ✓ Enviar respostas
            </button>
          </form>

          <div style="padding:14px 28px;background:var(--surface-2);text-align:center">
            <div style="font-size:11px;color:var(--text-3)">Formulário gerado pelo sistema <strong>IMPULSE ONE</strong></div>
          </div>
        </div>
      </div>
    `;
  } catch(e){
    console.error('[renderPublicBriefing]', e);
    pub.innerHTML = `<div style="text-align:center;padding:60px;color:var(--danger)">Erro: ${e.message}</div>`;
  }
}

async function submeterBriefing(ev, briefingId, token){
  ev.preventDefault();
  const form = ev.target;
  const nome = (form.querySelector('#brfRespName')?.value || '').trim();
  if(!nome){ alert('Por favor preencha seu nome'); return false; }
  const responses = {};
  form.querySelectorAll('[name]').forEach(el => {
    if(el.name === 'brfRespName') return;
    if(el.type === 'radio'){
      if(el.checked) responses[el.name] = el.value;
    } else {
      responses[el.name] = el.value.trim();
    }
  });
  const btn = form.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.innerHTML = '⏳ Enviando...';
  try {
    const { error } = await _supa.from('client_briefings').update({
      responses,
      responded_at: new Date().toISOString(),
      responded_by: nome,
      status: 'respondido'
    }).eq('id', briefingId);
    if(error) throw error;
    // Tela de sucesso
    document.getElementById('publicCapView').innerHTML = `
      <div style="max-width:520px;width:100%;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:50px 30px;text-align:center;box-shadow:var(--shadow)">
        <div style="font-size:64px;margin-bottom:14px">🎉</div>
        <h2 style="margin:0 0 8px;font-size:22px;font-weight:800;letter-spacing:-.02em">Obrigado, ${escapeHtml(nome.split(' ')[0])}!</h2>
        <div style="font-size:14px;color:var(--text-2);line-height:1.65;margin-top:10px">Suas respostas foram enviadas com sucesso. Já estão com a nossa equipe e vamos dar sequência ao trabalho.</div>
        <div style="font-size:12px;color:var(--text-3);margin-top:24px">Pode fechar essa página.</div>
      </div>
    `;
  } catch(e){
    btn.disabled = false;
    btn.innerHTML = '✓ Enviar respostas';
    alert('Erro ao enviar: '+e.message+'\n\nTente novamente em alguns segundos.');
    console.error(e);
  }
  return false;
}

let _currentProfile = null;

async function loadCurrentProfile(){
  if(!_supa || !_currentUser) return;
  try {
    const { data } = await _supa.from('profiles').select('*').eq('email', _currentUser.email).maybeSingle();
    if(data){
      _currentProfile = data;
    } else {
      // Cria profile basico se nao existe
      const { data: created } = await _supa.from('profiles').insert({
        full_name: _currentUser.email.split('@')[0],
        email: _currentUser.email,
        role: 'colaborador',
        permissions: ['dashboard','clientes','cronograma']
      }).select().single();
      _currentProfile = created;
    }
  } catch(e) { console.error('Profile load:', e) }
}

function canAccess(pageId){
  if(!_currentProfile) return true;
  // FORCE admin para emails admin conhecidos
  if(_currentUser && _currentUser.email && (_currentUser.email === 'vini@impulseone.com.br' || _currentUser.email.toLowerCase().includes('vini@'))) return true;
  if(_currentProfile.role === 'admin') return true;
  return (_currentProfile.permissions || []).includes(pageId);
}

// Helpers globais de ordenacao alfabetica
function sortAlfa(arr, key){
  if(!Array.isArray(arr)) return arr;
  return arr.slice().sort((a,b) => {
    const va = (key ? (a[key]||'') : (a||'')) + '';
    const vb = (key ? (b[key]||'') : (b||'')) + '';
    return va.localeCompare(vb, 'pt-BR', {sensitivity:'base'});
  });
}


// === Ponto restrito a estagiários (e admins veem tudo) ===
function ehEstagiario(){
  try {
    const meuNome = (typeof getMeuNome === 'function' ? getMeuNome() : '').trim();
    if(!meuNome) return false;
    // Procura pelo team pelo nome ou primeiro nome
    const meuPrim = meuNome.split(/\s+/)[0].toLowerCase();
    const m = (typeof team !== 'undefined' ? team : []).find(t =>
      (t.name||'') === meuNome ||
      (t.name||'').split(' ')[0].toLowerCase() === meuPrim
    );
    if(!m) return false;
    const tipo = (m.contract_type||'').toLowerCase();
    return tipo === 'estagio' || tipo === 'estágio' || tipo === 'estagiario' || tipo === 'estagiária' || tipo === 'estagiaria';
  } catch(e){ return false; }
}
window.ehEstagiario = ehEstagiario;

function isAdmin(){
  if(!_currentUser) return false;
  const email = (_currentUser.email||'').toLowerCase();
  // Lista hardcoded de admins (mesmo acesso que Vini/Ederson)
  const ADMIN_EMAILS = ['vini@impulseone.com.br','vinicius@impulseone.com.br','edersonoliveira.eder@gmail.com'];
  if(ADMIN_EMAILS.includes(email)) return true;
  if(email.includes('vini@')) return true;
  // Admins por primeiro nome (caso emails sejam diferentes)
  const nome = (_currentProfile && _currentProfile.name ? _currentProfile.name : email.split('@')[0]).toLowerCase();
  const primeiro = nome.split(/\s+/)[0];
  const ADMIN_NOMES = ['vini','vinicius','ederson','heidy','heidi','haisa','haísa'];
  if(ADMIN_NOMES.includes(primeiro)) return true;
  return _currentProfile && _currentProfile.role === 'admin';
}

// Whitelist HARDCODED para ver valores financeiros (planos, MRR, pagamentos)
// Independente do role no banco - apenas emails listados podem ver
function podeVerValores(){
  if(!_currentUser || !_currentUser.email) return false;
  const email = (_currentUser.email||'').toLowerCase().trim();
  const whitelist = [
    'vini@impulseone.com.br',
    'vinicius@impulseone.com.br',
    'edersonoliveira.eder@gmail.com'  // proprietario
  ];
  if(whitelist.includes(email)) return true;
  if(email.includes('vini@')) return true;
  // Tambem permite Heidy/Haisa por nome (acesso financeiro total)
  const nome = (_currentProfile && _currentProfile.name ? _currentProfile.name : email.split('@')[0]).toLowerCase();
  const primeiro = nome.split(/\s+/)[0];
  const NOMES_VALORES = ['vini','vinicius','ederson','heidy','heidi','haisa','haísa'];
  if(NOMES_VALORES.includes(primeiro)) return true;
  console.log('[podeVerValores] BLOQUEADO para email:', email);
  return false;
}

// Retorna true se o usuario eh admin OU gestor/coordenador/gerente
function isGestor(){
  if(isAdmin()) return true;
  if(!_currentProfile) return false;
  const role = (_currentProfile.role || '').toLowerCase();
  if(['gestor','gerente','coordenador','founder','owner','manager'].includes(role)) return true;
  // Tambem aceita pelo cargo (role livre)
  const cargo = (_currentProfile.cargo || _currentProfile.position || '').toLowerCase();
  return /gerent|coorden|gestor|founder|director|diretor/.test(cargo);
}

async function doLogin(e){
  if(e && e.preventDefault) e.preventDefault();
  console.log('[Login] Tentando logar...');
  const email = (document.getElementById('loginEmail')?.value||'').trim();
  const pwd = document.getElementById('loginPwd')?.value || '';
  const errEl = document.getElementById('loginErr');
  const btn = document.getElementById('loginBtn');
  if(errEl) errEl.classList.remove('show');
  if(!email || !pwd){
    if(errEl){errEl.textContent='Preencha email e senha';errEl.classList.add('show')}
    return false;
  }
  if(!_supa){
    if(errEl){errEl.textContent='Supabase não configurado. Recarregue a página.';errEl.classList.add('show')}
    console.error('[Login] _supa é null');
    return false;
  }
  if(btn){btn.disabled=true;btn.textContent='Entrando...'}
  try {
    const { data, error } = await _supa.auth.signInWithPassword({ email, password: pwd });
    if(error){
      console.error('[Login] Erro:', error);
      const msg = error.message==='Invalid login credentials' ? 'Email ou senha incorretos'
                : error.message==='Email not confirmed' ? 'Email não confirmado. Marque Auto Confirm no Supabase.'
                : error.message;
      if(errEl){errEl.textContent=msg;errEl.classList.add('show')}
      if(btn){btn.disabled=false;btn.textContent='Entrar'}
      return false;
    }
    console.log('[Login] Sucesso:', data.user.email);
    _currentUser = data.user;
    try { await loadCurrentProfile(); } catch(ex){ console.warn('[Login] profile load:', ex) }
    document.getElementById('loginScreen')?.classList.add('hidden');
    if(!_appStarted){startApp(_currentUser);_appStarted=true}
  } catch(err){
    console.error('[Login] Exception:', err);
    if(errEl){errEl.textContent='Erro: '+err.message;errEl.classList.add('show')}
    if(btn){btn.disabled=false;btn.textContent='Entrar'}
  }
  return false;
}

async function doLogout(){
  if(_supa) await _supa.auth.signOut();
  location.reload();
}

// Garantir disponibilidade global das funcoes de login
window.doLogin = doLogin;
window.doLogout = doLogout;
window.checkAuth = checkAuth;


async function startApp(user){
  console.log('[startApp] iniciando, user:', user?.email);
  // Atualiza nome do usuário no rodapé da sidebar
  if(user){
    setTimeout(()=>{
      const nameEl = document.querySelector('.user-name');
      const roleEl = document.querySelector('.user-role');
      const avEl = document.querySelector('.user-card .avatar');
      if(nameEl) nameEl.textContent = user.email.split('@')[0];
      if(roleEl) roleEl.textContent = user.email;
      if(avEl) avEl.textContent = user.email[0].toUpperCase();
    }, 200);
  }
  // Carrega logo da agência (do cache + sincroniza com servidor)
  try { loadAppLogo(); } catch(e){ console.warn('[startApp] logo:', e); }

  // ===== CARREGA DADOS DO SUPABASE =====
  try {
    if(_supa) {
      console.log('[startApp] carregando dados do Supabase...');
      await loadDataFromSupabase();
      console.log('[startApp] dados carregados');
    }
  } catch(e){ console.warn('[startApp] loadData falhou:', e); }

  // ===== CARREGA TODAS AS TABELAS DO SUPABASE (boot completo) =====
  // IMPORTANTE: cada loadXxx em try/catch separado pra que falha de uma nao derrube as outras
  if(_supa) {
    const _loaders = [
      'loadColaboradorPagamentos',
      'loadPagamentosFixos',
      'loadFerias',
      'loadRelacionamentos',    // CRM
      'loadParcerias',
      'loadCampanhas',          // Trafego Pago
      'loadLembretes',
      'loadEventosCalendario',
      'loadCustomLinks',
      'loadTransactions',       // Financeiro
      'loadBudgetServices',     // Orcamento
      'loadBudgetClients',
      'loadOrcamentosSalvos',
      'loadPontoLogs',          // Ponto
      'loadAlmocos',            // Almoço
      'loadI3Reunioes',         // I3 - atas socios
      'loadI3Learning',         // I3 - learning semanal
      'loadPrecificacao',       // Precificacao DRE
    ];
    // Mapeamento direto (sem eval) pra funcionar em strict mode
    const _loaderMap = {
      loadColaboradorPagamentos: typeof loadColaboradorPagamentos==='function'?loadColaboradorPagamentos:null,
      loadPagamentosFixos: typeof loadPagamentosFixos==='function'?loadPagamentosFixos:null,
      loadFerias: typeof loadFerias==='function'?loadFerias:null,
      loadRelacionamentos: typeof loadRelacionamentos==='function'?loadRelacionamentos:null,
      loadParcerias: typeof loadParcerias==='function'?loadParcerias:null,
      loadCampanhas: typeof loadCampanhas==='function'?loadCampanhas:null,
      loadLembretes: typeof loadLembretes==='function'?loadLembretes:null,
      loadEventosCalendario: typeof loadEventosCalendario==='function'?loadEventosCalendario:null,
      loadCustomLinks: typeof loadCustomLinks==='function'?loadCustomLinks:null,
      loadTransactions: typeof loadTransactions==='function'?loadTransactions:null,
      loadBudgetServices: typeof loadBudgetServices==='function'?loadBudgetServices:null,
      loadBudgetClients: typeof loadBudgetClients==='function'?loadBudgetClients:null,
      loadOrcamentosSalvos: typeof loadOrcamentosSalvos==='function'?loadOrcamentosSalvos:null,
      loadPontoLogs: typeof loadPontoLogs==='function'?loadPontoLogs:null,
      loadAlmocos: typeof loadAlmocos==='function'?loadAlmocos:null,
      loadI3Reunioes: typeof loadI3Reunioes==='function'?loadI3Reunioes:null,
      loadI3Learning: typeof loadI3Learning==='function'?loadI3Learning:null,
      loadPrecificacao: typeof loadPrecificacao==='function'?loadPrecificacao:null,
    };
    for(const nome of _loaders) {
      const fn = _loaderMap[nome];
      if(!fn) { console.warn('[startApp] ' + nome + ' nao encontrada'); continue; }
      try { await fn(); }
      catch(e){ console.warn('[startApp] ' + nome + ' falhou:', e?.message || e); }
    }
    console.log('[startApp] todas as tabelas carregadas');
  }

  // ===== RENDERIZA NAV DA SIDEBAR =====
  try {
    if(typeof renderNav === 'function'){
      console.log('[startApp] renderizando nav...');
      renderNav();
    }
  } catch(e){ console.warn('[startApp] renderNav falhou:', e); }

  // ===== RENDERIZA PAGINA INICIAL (restaura ultima do localStorage) =====
  try {
    let pageInicial = 'dashboard';
    try {
      const ultima = localStorage.getItem('_impulse_last_page');
      if(ultima && typeof ultima === 'string') pageInicial = ultima;
    } catch(e){}
    if(typeof currentPage !== 'undefined' && currentPage && currentPage !== 'dashboard'){
      pageInicial = currentPage;
    }
    if(typeof goTo === 'function'){
      console.log('[startApp] restaurando pagina:', pageInicial);
      goTo(pageInicial, {skipHistory: true});
    } else if(typeof renderPage === 'function'){
      renderPage(pageInicial);
    } else if(typeof renderDashboard === 'function'){
      renderDashboard(document.getElementById('content'));
    }
  } catch(e){ console.warn('[startApp] navegacao inicial falhou:', e); }

  console.log('[startApp] concluido');
}

// Adicionar botão de logout ao clicar no avatar do usuário (botão de tema)
function setupLogout(){
  setTimeout(()=>{
    const userCard = document.querySelector('.user-card');
    if(userCard && !document.getElementById('logoutBtn')){
      const btn = document.createElement('button');
      btn.id = 'logoutBtn';
      btn.className = 'icon-btn';
      btn.title = 'Sair';
      btn.onclick = doLogout;
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>';
      userCard.appendChild(btn);
    }
  }, 500);
}

// Disparar checkAuth assim que DOM carrega
if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', ()=>{checkAuth();setupLogout()});
} else {
  // DOM ja carregado, dispara imediatamente
  setTimeout(()=>{checkAuth();setupLogout()}, 50);
}


