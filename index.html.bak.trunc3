}

async function salvarNovoLead(){
  const name = document.getElementById('nlName').value.trim();
  if(!name){toast('Informe o nome da empresa','info');return}
  const data = {
    name, contact_name: document.getElementById('nlContact').value.trim(),
    phone: document.getElementById('nlPhone').value.replace(/\D/g,''),
    email: document.getElementById('nlEmail').value.trim(),
    segment: document.getElementById('nlSeg').value.trim(),
    value: parseFloat(document.getElementById('nlValue').value)||0,
    stage: document.getElementById('nlStage').value,
    priority: document.getElementById('nlPrio').value
  };
  const btn = document.getElementById('nlBtn'); btn.disabled=true; btn.textContent='Salvando...';
  const r = await dbCreate('leads', data);
  if(r){ toast('✓ Lead adicionado ao pipeline','success'); closeModal(); renderComercial(document.getElementById('content')); }
  else { btn.disabled=false; btn.textContent='Criar lead' }
}

// ============ MODAL: NOVA TAREFA ============
function openNovaTarefaModal(opts){
  opts = opts || {};
  // Preset do responsável a partir do nome do colaborador (primeiro nome)
  let presetAssDbId = '';
  if(opts.preset_collab){
    const m = team.find(t => t.name === opts.preset_collab || t.name.split(' ')[0] === opts.preset_collab);
    if(m && m._dbId) presetAssDbId = m._dbId;
  }
  const presetStatus = opts.preset_status || 'todo';
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700">✅</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">Nova tarefa</div><div class="text-xs text-3" style="margin-top:2px">${opts.preset_collab?'pra '+escapeHtml(opts.preset_collab):''}</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Título *</div><input id="ntkTitle" class="login-input" placeholder="Ex: Editar reels da semana" autofocus style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Responsável</div><select id="ntkAss" class="login-input" style="background:var(--surface-2)"><option value="">— ninguém —</option>${team.map(t=>`<option value="${t._dbId||''}" ${presetAssDbId===t._dbId?'selected':''}>${t.name}</option>`).join('')}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Cliente</div><select id="ntkCli" class="login-input" style="background:var(--surface-2)"><option value="">Geral / Interno</option>${sortAlfa(clients, 'name').map(c=>`<option value="${c._dbId}">${c.name}</option>`).join('')}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Prioridade</div><select id="ntkPrio" class="login-input" style="background:var(--surface-2)"><option value="urgent">🔴 Urgente</option><option value="high">🟠 Alta</option><option value="med" selected>🔵 Média</option><option value="low">⚪ Baixa</option></select></div>
        <div><div class="info-label" style="margin-bottom:5px">Status</div><select id="ntkStatus" class="login-input" style="background:var(--surface-2)"><option value="todo" ${presetStatus==='todo'?'selected':''}>📋 A fazer</option><option value="doing" ${presetStatus==='doing'?'selected':''}>🎬 Em andamento</option><option value="review" ${presetStatus==='review'?'selected':''}>👁 Em revisão</option><option value="done" ${presetStatus==='done'?'selected':''}>✅ Concluída</option></select></div>
        <div><div class="info-label" style="margin-bottom:5px">Horário</div><input id="ntkTime" class="login-input" type="time" value="09:00" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Data</div><input id="ntkDate" class="login-input" type="date" value="${new Date().toISOString().split('T')[0]}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Tag (opcional)</div><input id="ntkTag" class="login-input" placeholder="Conteúdo / Design / Vídeo..." style="background:var(--surface-2)" /></div>
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Descrição (opcional)</div><textarea id="ntkDesc" class="login-input" rows="2" placeholder="Detalhes adicionais..." style="background:var(--surface-2);resize:vertical;min-height:60px"></textarea></div>
      </div>
      <label style="display:flex;gap:8px;align-items:center;margin-top:14px;font-size:12.5px"><input type="checkbox" id="ntkDaily" checked /> Adicionar ao checklist diário do responsável</label>
      <div style="display:flex;gap:8px;margin-top:18px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovaTarefa()" id="ntkBtn">➕ Criar tarefa</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
  setTimeout(()=>document.getElementById('ntkTitle')?.focus(), 50);
}

async function salvarNovaTarefa(){
  const title = document.getElementById('ntkTitle').value.trim();
  if(!title){ toast('Informe o título','info'); return; }
  const assId = document.getElementById('ntkAss').value || null;
  const cliId = document.getElementById('ntkCli').value || null;
  const status = document.getElementById('ntkStatus')?.value || 'todo';
  const tag = document.getElementById('ntkTag').value.trim();
  const desc = document.getElementById('ntkDesc')?.value.trim() || '';
  const data = {
    title, assigned_to: assId, client_id: cliId,
    priority: document.getElementById('ntkPrio').value,
    scheduled_time: document.getElementById('ntkTime').value,
    due_date: document.getElementById('ntkDate').value,
    tag, status,
    description: desc || null,
    is_daily: document.getElementById('ntkDaily').checked
  };
  const btn = document.getElementById('ntkBtn'); btn.disabled=true; btn.textContent='⏳ Salvando...';

  // Atualiza local IMEDIATAMENTE (pra Gabi ver na hora, mesmo sem banco)
  try {
    if(assId){
      const member = team.find(t => t._dbId === assId);
      const collabName = member ? member.name.split(' ')[0] : null;
      const cli = clients.find(c => c._dbId === cliId);
      const clientName = cli ? cli.name : 'Geral';
      if(collabName){
        if(!dailyChecklists[collabName]) dailyChecklists[collabName] = [];
        dailyChecklists[collabName].push({
          t: title,
          p: data.priority,
          time: data.scheduled_time,
          client: clientName,
          done: false,
          _dbId: null  // será preenchido se o save no banco der certo
        });
      }
    }
  } catch(e){ console.warn(e); }

  // Persiste no banco (se rolar)
  const r = await dbCreate('tasks', data);
  if(r){
    toast('✓ Tarefa criada','success');
    closeModal();
    await loadDataFromSupabase();
    renderOperacional(document.getElementById('content'));
  } else {
    // Mesmo sem banco, mostra localmente
    toast('⚠ Salvo localmente. Verifique se a tabela "tasks" existe no Supabase.','info');
    closeModal();
    renderOperacional(document.getElementById('content'));
  }
}

// ============ EDIÇÃO INLINE NO CLIENTE ============
async function saveClienteField(clientId, field, value){
  const cli = clients.find(c=>c.id===clientId);
  if(!cli || !cli._dbId) return;
  const map = {name:'name',segment:'segment',phone:'phone',email:'email',instagram:'instagram',website:'website',status:'status'};
  const dbField = map[field];
  if(!dbField) return;
  await dbUpdate('clients', cli._dbId, {[dbField]: value});
  cli[field === 'instagram' ? 'ig' : field === 'website' ? 'site' : field] = value;
  toast('✓ Atualizado','success');
}


