// ============ NAV ============
let currentPage = 'dashboard';
function renderNav(){
  const nav = document.getElementById('nav');
  if(!nav){ console.warn('[NAV] elemento #nav nao encontrado'); return; }
  // Se nao temos profile carregado, mostra TUDO pra nao deixar tela vazia
  const isAdminUser = isAdmin();
  const hasProfile = !!_currentProfile;
  console.log('[NAV] Renderizando · admin:', isAdminUser, '· profile:', hasProfile);
  const gestor = isGestor();
  nav.innerHTML = navItems.map(g=>{
    const visibleItems = g.items.filter(it=>{
      if(it.adminOnly && !isAdminUser) return false;
      if(it.gestorOnly && !gestor) return false;
      // Almoço: só Fran, Haisa, Heidy, Vini + admins
      if(it.id === 'almoco' && typeof _almocoTemAcesso === 'function' && !_almocoTemAcesso()) return false;
      // Ponto: só estagiários + admins veem
      if(it.id === 'ponto' && !isAdminUser && typeof ehEstagiario === 'function' && !ehEstagiario()) return false;
      // Pagamentos: aparece pra TODOS os colaboradores autenticados (cada um ve so o seu)
      // Admin financeiro (Vini/Ederson/Heidy/Haisa) ve tudo, resto ve so o proprio
      // Se nao tem profile carregado, mostra tudo (fail open)
      if(!hasProfile) return true;
      if(isAdminUser) return true;
      return canAccess(it.id);
    });
    if(visibleItems.length===0) return '';
    return `<div class="nav-group"><div class="nav-label">${g.group}</div>${visibleItems.map(it=>`<div class="nav-item ${it.id===currentPage?'active':''}" data-page="${it.id}" onclick="goTo('${it.id}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">${it.icon}</svg><span>${it.label}</span>${it.badge?`<span class="nav-badge">${it.badge}</span>`:''}</div>`).join('')}</div>`;
  }).join('');
  // Atualiza user-card com nome real do usuario logado
  updateUserCard();
}

// Atualiza a barra inferior do sidebar (avatar, nome, cargo) com base no profile logado
function updateUserCard(){
  try {
    const elName = document.getElementById('userName');
    const elRole = document.getElementById('userRole');
    const elAv = document.getElementById('userAvatar');
    if(!elName) return;
    let nome = 'Ederson Oliveira';
    let cargo = 'Founder';
    let init = 'E';
    let cor = '';
    if(_currentProfile && _currentProfile.name){
      nome = _currentProfile.name;
      cargo = _currentProfile.role || _currentProfile.cargo || _currentProfile.position || '—';
      init = nome.trim().charAt(0).toUpperCase();
      // Se houver no team, pega cor
      const tm = (typeof team !== 'undefined') ? team.find(t => t.name === nome || t.name.split(' ')[0].toLowerCase() === nome.split(' ')[0].toLowerCase()) : null;
      if(tm){ cor = tm.color || ''; cargo = tm.role; }
    } else if(_currentUser && _currentUser.email){
      const local = _currentUser.email.split('@')[0];
      nome = local.charAt(0).toUpperCase() + local.slice(1);
      init = nome.charAt(0).toUpperCase();
    }
    elName.textContent = nome;
    elRole.textContent = cargo;
    elAv.textContent = init;
    if(cor) elAv.style.background = cor;
  } catch(e){ console.warn('[updateUserCard]', e); }
}

// ============ LOGO DA AGÊNCIA ============
// Salva URL/base64 da logo no Supabase e no localStorage como cache.
async function loadAppLogo(){
  try {
    // 1. tenta carregar do cache local (instantâneo)
    const cached = localStorage.getItem('app_logo_url');
    if(cached) renderBrandLogo(cached);
    // 2. busca do servidor (sincroniza se houver mudança)
    if(_supa){
      const { data, error } = await _supa.from('app_settings').select('value').eq('key','logo_url').maybeSingle();
      if(!error && data && data.value){
        localStorage.setItem('app_logo_url', data.value);
        renderBrandLogo(data.value);
      } else if(!error && !data){
        // não há logo no banco — remove cache se existir
        if(cached){ localStorage.removeItem('app_logo_url'); renderBrandLogo(null); }
      }
    }
  } catch(e){ console.warn('[loadAppLogo]', e); }
}

// Aplica a logo nos elementos brand-logo (sidebar + mobile). Passa null pra voltar ao i1.
function renderBrandLogo(url){
  const targets = ['sidebarBrandLogo','mobileBrandLogo'];
  targets.forEach(id=>{
    const el = document.getElementById(id);
    if(!el) return;
    if(url){
      el.innerHTML = `<img src="${url}" alt="Logo" onerror="this.parentElement.classList.remove('has-image');this.parentElement.textContent='i1'"/>`;
      el.classList.add('has-image');
    } else {
      el.innerHTML = 'i1';
      el.classList.remove('has-image');
      el.style.background = '';
    }
  });
  const preview = document.getElementById('logoPreview');
  if(preview){
    if(url){
      preview.innerHTML = `<img src="${url}" alt="Logo" style="max-width:120px;max-height:120px;border-radius:12px;border:1px solid var(--border);background:var(--surface-2);padding:8px;object-fit:contain"/>`;
    } else {
      preview.innerHTML = `<div style="width:120px;height:120px;border-radius:12px;border:1px dashed var(--border-strong);background:var(--surface-2);display:grid;place-items:center;color:var(--text-3);font-size:11px">Sem logo</div>`;
    }
  }
}

// Faz upload da logo: redimensiona para max 256x256, converte pra base64 (PNG/JPG/SVG)
async function uploadLogo(input){
  const file = input.files && input.files[0];
  if(!file) return;
  if(!/^image\/(png|jpe?g|svg\+xml|webp|gif)$/.test(file.type)){
    toast('Formato inválido. Use PNG, JPG, SVG, WebP ou GIF.', 'info'); return;
  }
  if(file.size > 2*1024*1024){
    toast('Arquivo muito grande. Máx 2MB.', 'info'); return;
  }
  toast('Processando logo...', 'info');
  try {
    let dataUrl;
    if(file.type === 'image/svg+xml'){
      // SVG: lê como texto e converte direto
      const txt = await file.text();
      dataUrl = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(txt)));
    } else {
      // Imagem raster: redimensiona pra 256x256 antes de salvar
      dataUrl = await new Promise((resolve, reject)=>{
        const reader = new FileReader();
        reader.onload = e => {
          const img = new Image();
          img.onload = () => {
            const max = 256;
            let w = img.width, h = img.height;
            if(w > max || h > max){
              if(w > h){ h = Math.round(h * max / w); w = max; }
              else { w = Math.round(w * max / h); h = max; }
            }
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            // PNG mantém transparência; JPG é menor
            resolve(canvas.toDataURL(file.type === 'image/png' ? 'image/png' : 'image/jpeg', 0.92));
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }
    // Sempre salva no localStorage primeiro (logo já aparece no seu navegador)
    localStorage.setItem('app_logo_url', dataUrl);
    renderBrandLogo(dataUrl);
    input.value = '';

    // Tenta salvar no banco pra sincronizar com a equipe inteira
    if(_supa){
      const { error } = await _supa.from('app_settings').upsert({key:'logo_url', value:dataUrl, updated_at:new Date().toISOString()}, {onConflict:'key'});
      if(error){
        console.error('[uploadLogo] banco:', error);
        if(error.message && (error.message.includes('app_settings') || error.code === 'PGRST205')){
          toast('⚠ Logo salva localmente! Pra sincronizar com a equipe, rode o SQL "16-logo.sql"', 'info');
          alert('✅ LOGO APLICADA NESTE NAVEGADOR\n\n⚠ Mas a tabela "app_settings" não existe no banco — então a logo NÃO vai aparecer pros outros colaboradores.\n\nPra sincronizar com toda a equipe:\n1. Abra o Supabase → SQL Editor\n2. Cole o conteúdo do arquivo: sql/16-logo.sql\n3. Clique em Run\n4. Volte aqui e tente enviar a logo de novo\n\nO conteúdo do SQL:\n\ncreate table if not exists app_settings (\n  key text primary key,\n  value text,\n  updated_at timestamptz default now()\n);\n\nalter table app_settings enable row level security;\ncreate policy "auth all settings" on app_settings\n  for all to authenticated using (true) with check (true);');
          return;
        }
        toast('Logo aplicada localmente. Banco falhou: '+error.message, 'info');
        return;
      }
      toast('✓ Logo atualizada e sincronizada!', 'success');
    } else {
      toast('✓ Logo aplicada (modo offline)', 'success');
    }
  } catch(e){
    console.error('[uploadLogo]', e);
    toast('Erro ao processar imagem: '+e.message, 'info');
  }
}

// Remove a logo (volta pro i1)
// ============ UPLOAD LOGO DE CLIENTE ============
async function uploadClienteLogo(input, cliId){
  const file = input.files && input.files[0];
  if(!file) return;
  if(!/^image\/(png|jpe?g|svg\+xml|webp|gif)$/.test(file.type)){
    toast('Formato inválido. Use PNG, JPG, SVG, WebP ou GIF.', 'info'); return;
  }
  if(file.size > 2*1024*1024){
    toast('Arquivo muito grande. Máx 2MB.', 'info'); return;
  }
  const cli = clients.find(c => c.id === cliId);
  if(!cli){ toast('Cliente não encontrado','info'); return; }
  toast('Processando logo...', 'info');
  try {
    // Redimensiona / converte pra base64
    let dataUrl;
    if(file.type === 'image/svg+xml'){
      const txt = await file.text();
      dataUrl = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(txt)));
    } else {
      dataUrl = await new Promise((resolve, reject)=>{
        const reader = new FileReader();
        reader.onload = e => {
          const img = new Image();
          img.onload = () => {
            const max = 256;
            let w = img.width, h = img.height;
            if(w > max || h > max){
              if(w > h){ h = Math.round(h * max / w); w = max; }
              else { w = Math.round(w * max / h); h = max; }
            }
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            resolve(canvas.toDataURL(file.type === 'image/png' ? 'image/png' : 'image/jpeg', 0.92));
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }
    // Atualiza local imediatamente
    cli.logo_url = dataUrl;
    // Salva no banco
    if(_supa && cli._dbId){
      const { error } = await _supa.from('clients').update({logo_url: dataUrl}).eq('id', cli._dbId);
      if(error){
        if(error.message && (error.message.includes('logo_url') || error.code === 'PGRST204')){
          toast('⚠ Logo aplicada localmente. Rode o SQL 21-cliente-logo.sql pra sincronizar.', 'info');
          alert('Pra a logo aparecer pra todos da equipe:\n\n1. Abre Supabase → SQL Editor\n2. Cola e roda:\n\nalter table clients add column if not exists logo_url text;\n\n3. Volta aqui e tenta de novo.');
        } else {
          toast('Erro: '+error.message,'info');
        }
        return;
      }
    }
    toast('✓ Logo atualizada!', 'success');
    input.value = '';
    // Re-abre modal pra ver mudança
    closeModal();
    setTimeout(()=>openClient(cliId), 100);
    // Atualiza grid se estiver visível
    if(currentPage === 'clientes') renderClientes(document.getElementById('content'));
  } catch(e){
    console.error('[uploadClienteLogo]', e);
    toast('Erro: '+e.message,'info');
  }
}

async function removerClienteLogo(cliId){
  if(!(await confirmDelete('a logo dcliente\n\nVolta a mostrar as iniciais.'))) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  cli.logo_url = '';
  if(_supa && cli._dbId){
    await _supa.from('clients').update({logo_url: null}).eq('id', cli._dbId);
  }
  toast('Logo removida','success');
  closeModal();
  setTimeout(()=>openClient(cliId), 100);
  if(currentPage === 'clientes') renderClientes(document.getElementById('content'));
}

async function removerLogo(){
  if(!(await confirmDelete('logo da agência', {aviso:'Volta ao padrão i1.'}))) return;
  try {
    if(_supa){
      await _supa.from('app_settings').delete().eq('key','logo_url');
    }
    localStorage.removeItem('app_logo_url');
    renderBrandLogo(null);
    toast('Logo removida', 'success');
  } catch(e){ console.error(e); toast('Erro: '+e.message, 'info'); }
}
// Historico de navegacao (em memoria) e persistencia (localStorage)
if(typeof _navHistory === 'undefined') var _navHistory = [];
function goTo(page, opts){
  opts = opts || {};
  // Empilha pagina ANTERIOR no historico (a menos que seja restauracao ou voltar)
  if(currentPage && currentPage !== page && !opts.skipHistory){
    _navHistory.push(currentPage);
    if(_navHistory.length > 20) _navHistory.shift();
  }
  currentPage = page;
  // Persistir ultima pagina pra Ctrl+R / refresh
  try { localStorage.setItem('_impulse_last_page', page); } catch(e){}
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active', n.dataset.page===page));
  renderPage(page);
  // Atualiza visibilidade do botao voltar mobile
  try { atualizarBotaoVoltarMobile(); } catch(e){}
  // Fecha sidebar no mobile ao navegar
  closeSidebar();
  // Scroll pro topo no mobile
  try{ document.getElementById('content').scrollTop = 0; }catch(e){}
}

function voltarPagina(){
  if(_navHistory.length === 0){ toast('Sem pagina anterior','info'); return; }
  const anterior = _navHistory.pop();
  goTo(anterior, {skipHistory: true});
}
window.voltarPagina = voltarPagina;
// Re-renderiza a pagina atual sem F5 do navegador (botao refresh mobile)
function atualizarPaginaAtual(){
  try {
    if(typeof currentPage !== 'string' || !currentPage){ toast('Nada pra atualizar','info'); return; }
    if(typeof renderPage === 'function'){
      // Spinner visual rapido
      try { toast('🔄 Atualizando ' + currentPage + '...','info'); } catch(e){}
      // Re-carrega dados do supabase em background
      if(typeof loadDataFromSupabase === 'function' && _supa){
        loadDataFromSupabase().catch(()=>{}).finally(() => {
          renderPage(currentPage);
        });
      } else {
        renderPage(currentPage);
      }
    }
  } catch(e){ console.warn('[atualizarPaginaAtual]', e); }
}
window.atualizarPaginaAtual = atualizarPaginaAtual;


function atualizarBotaoVoltarMobile(){
  const btn = document.getElementById('mobileBackBtn');
  if(!btn) return;
  btn.style.display = (_navHistory.length > 0) ? 'flex' : 'none';
}
window.atualizarBotaoVoltarMobile = atualizarBotaoVoltarMobile;

// ============ MOBILE SIDEBAR ============
function toggleSidebar(){
  const sb = document.getElementById('sidebar');
  const ov = document.getElementById('sidebarOverlay');
  if(!sb) return;
  const isOpen = sb.classList.contains('open');
  if(isOpen){ closeSidebar(); } else { openSidebar(); }
}
function openSidebar(){
  const sb = document.getElementById('sidebar');
  const ov = document.getElementById('sidebarOverlay');
  if(sb) sb.classList.add('open');
  if(ov) ov.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeSidebar(){
  const sb = document.getElementById('sidebar');
  const ov = document.getElementById('sidebarOverlay');
  if(sb) sb.classList.remove('open');
  if(ov) ov.classList.remove('open');
  document.body.style.overflow = '';
}
// Fecha sidebar com ESC
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape'){ closeSidebar(); }
});
// Fecha automaticamente se redimensionar pra desktop
window.addEventListener('resize', function(){
  if(window.innerWidth > 768){ closeSidebar(); }
});
function renderPage(page){
  const c = document.getElementById('content');
  // Verifica permissão — se o usuário não tem acesso, redireciona pra primeira aba acessível
  if(_currentProfile && !isAdmin() && !canAccess(page)){
    const fallback = (typeof getFirstAccessiblePage === 'function') ? getFirstAccessiblePage() : 'dashboard';
    if(fallback !== page){
      console.log('[renderPage] sem acesso a', page, '— redirecionando para', fallback);
      currentPage = fallback;
      // Atualiza marcação visual do menu
      document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', n.dataset.page === fallback));
      page = fallback;
    }
  }
  const r = {
    dashboard:renderDashboard,clientes:renderClientes,financeiro:renderFinanceiro,
    operacional:renderOperacional,calendario:renderCalendario,conteudo:renderConteudo,trafego:renderTrafegoPago,relacionamento:renderRelacionamento,parcerias:renderParcerias,i3:renderI3,almoco:renderAlmoco,
    reunioes:renderReunioes,equipe:renderEquipe,automacao:renderAutomacao,
    arquivos:renderArquivos,config:renderConfig,
    captacao:renderCaptacao,comercial:renderComercial,ponto:renderPontoPage,
    cronograma:renderCronograma,
    usuarios:renderUsuarios,
    feedback:renderFeedback,
    pagamentos:renderPagamentos,
  };
  c.innerHTML='';c.scrollTop=0;
  (r[page]||renderDashboard)(c);
}
function toggleNotif(){
  const pop = document.getElementById('notifPop');
  pop.classList.toggle('open');
  if(pop.classList.contains('open')){
    atualizarNotificacoes();
  }
}

// Preenche o sininho com prazos urgentes (hoje, amanhã, atrasados)
function atualizarNotificacoes(){
  const list = document.getElementById('notifList');
  if(!list) return;
  const hoje = getDeadlineAlerts({range:'today'});
  const atrasados = getDeadlineAlerts({range:'overdue'});
  const amanha = getDeadlineAlerts({range:'soon'}).filter(a => a.diff === 1);
  const total = hoje.length + atrasados.length + amanha.length;

  if(total === 0){
    list.innerHTML = `<div class="empty-state" style="padding:30px 18px"><div class="ico">🔔</div><div class="ttl">Sem notificações</div><div class="desc">Você está em dia.</div></div>`;
    // Esconde o ponto vermelho
    const dot = document.querySelector('.icon-btn[title="Notificações"] .dot');
    if(dot) dot.remove();
    return;
  }

  // Adiciona o ponto vermelho no sininho
  const bellBtn = document.querySelector('.icon-btn[title="Notificações"]');
  if(bellBtn && !bellBtn.querySelector('.dot')){
    const d = document.createElement('span');
    d.className = 'dot';
    bellBtn.appendChild(d);
  }

  const mkItem = (alert, tipo) => {
    const cli = alert.client;
    const labelData = alert.diff===0?'🚨 HOJE':alert.diff===1?'⏰ Amanhã':alert.diff<0?`⚠ Atrasado ${Math.abs(alert.diff)}d`:`em ${alert.diff}d`;
    const corDot = alert.diff < 0 ? 'var(--danger)' : alert.diff === 0 ? 'var(--danger)' : 'var(--warning)';
    return `
      <div class="notif-item" onclick="goToCronCli(${cli.id},${alert.month});toggleNotif()" style="cursor:pointer">
        <span class="notif-dot" style="background:${corDot}"></span>
        <div>
          <div class="text-sm font-semi">${labelData} — ${cli.name}</div>
          <div class="text-xs text-3">${alert.data.target||0} conteúdos · ${alert.data.status||'planejado'}</div>
        </div>
      </div>
    `;
  };
  list.innerHTML = [
    ...atrasados.map(a => mkItem(a, 'atrasado')),
    ...hoje.map(a => mkItem(a, 'hoje')),
    ...amanha.map(a => mkItem(a, 'amanha'))
  ].join('');
}
document.addEventListener('click',e=>{if(!e.target.closest('.notif-pop')&&!e.target.closest('[title="Notificações"]'))document.getElementById('notifPop').classList.remove('open')});
function closeModal(){document.getElementById('modalBg').classList.remove('open')}

function statBadge(s){
  // Compat: status antigos (onboarding/paused/late) viram active. Só active/cancelado.
  const status = (s === 'cancelado' || s === 'cancelled') ? 'cancelado' : 'active';
  const m = {active:['b-success','Ativo'], cancelado:['b-danger','Cancelado']};
  const [c,l] = m[status];
  return `<span class="badge ${c}" onclick="toggleClienteStatus(event)" data-cli-status="${status}" style="cursor:pointer" title="Clique pra alternar"><span class="dot"></span>${l}</span>`;
}
// Toggle direto do status (chamado pelo botão grande no modal)
async function toggleClientStatusDirect(cliId){
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  const novo = cli.status === 'cancelado' ? 'active' : 'cancelado';
  if(novo === 'cancelado'){
    if(!confirm(`Marcar "${cli.name}" como CANCELADO?\n\nEle vai aparecer na lista de Cancelados e sair dos Ativos.`)) return;
  }
  await updateClientField(cliId, 'status', novo);
  cli.status = novo;
  setTimeout(()=>openClient(cliId), 100);
  if(currentPage === 'clientes') renderClientes(document.getElementById('content'));
}

// Botão de toggle do status no badge do modal (compat antigo)
function toggleClienteStatus(ev){
  ev.stopPropagation();
  const badge = ev.currentTarget;
  // Acha o cliente atual pelo nome no modal head
  const modalHead = badge.closest('.modal-head');
  if(!modalHead) return;
  const nome = modalHead.querySelector('div[style*="font-weight:700"]')?.textContent?.trim();
  const cli = clients.find(c => c.name === nome);
  if(!cli){ toast('Cliente não encontrado','info'); return; }
  const novo = cli.status === 'cancelado' ? 'active' : 'cancelado';
  if(novo === 'cancelado' && !confirm(`Marcar "${cli.name}" como CANCELADO?`)) return;
  updateClientField(cli.id, 'status', novo).then(()=>{
    cli.status = novo;
    setTimeout(()=>openClient(cli.id), 100);
    if(currentPage === 'clientes') renderClientes(document.getElementById('content'));
  });
}
function prioBadge(p){const m={urgent:'Urgente',high:'Alta',med:'Média',low:'Baixa'};return `<span class="prio prio-${p}">${m[p]}</span>`}

// ============ DASHBOARD ============
let dashFilter = {prio:'all',collab:'all',client:'all'};

// Card de prazos no dashboard (hoje + atrasados)
function renderDashboardPrazosHoje(){
  const hoje = getDeadlineAlerts({range:'today', debug:true});
  const atrasados = getDeadlineAlerts({range:'overdue'});
  const amanha = getDeadlineAlerts({range:'soon'}).filter(a => a.diff === 1);
  const total = hoje.length + atrasados.length + amanha.length;
  console.log('[Dashboard prazos] hoje:', hoje.length, '· atrasados:', atrasados.length, '· amanhã:', amanha.length);
  if(total === 0){
    return '';  // sem prazos urgentes, não polui o dashboard
  }
  const statusLabel = {
    'apenas-trafego':'🚀 Apenas tráfego pago',
    'agendado-mlabs':'📅 Agendado MLABS',
    'agendado-meta':'📊 Agendado Meta',
    'aguardando-aprov':'⏳ Aguardando aprovação',
    'trello-vini':'📋 Trello Vini',
    'mlabs-vini':'📱 MLABS Vini',
    'desenvolvimento':'🎨 Desenvolvimento',
    'cal-pronto':'✓ Cal pronto',
    'planejado':'📋 Planejado'
  };
  const row = (alert) => {
    const cli = alert.client;
    const labelStatus = statusLabel[alert.data.status] || (alert.data.status || 'planejado');
    let badge = '';
    if(alert.diff === 0) badge = '<span class="badge b-danger" style="font-size:10px">🚨 HOJE</span>';
    else if(alert.diff === 1) badge = '<span class="badge b-warning" style="font-size:10px">⏰ Amanhã</span>';
    else if(alert.diff < 0) badge = `<span class="badge b-danger" style="font-size:10px">⚠ Atrasado ${Math.abs(alert.diff)}d</span>`;
    return `
      <div class="list-item" style="cursor:pointer;padding:10px 12px;border-bottom:1px solid var(--border)" onclick="goToCronCli(${cli.id},${alert.month})">
        <div class="cron-cli-logo ${cli.logo_url?'has-image':''}" style="width:30px;height:30px;font-size:11px;border-radius:7px;background:${cli.logo_url?'transparent':cli.color};color:#fff;display:grid;place-items:center;flex-shrink:0;overflow:hidden">${cli.logo_url?`<img src="${cli.logo_url}" style="width:100%;height:100%;object-fit:cover" />`:cli.init}</div>
        <div class="list-content">
          <div class="list-title" style="font-size:13px">${cli.name}</div>
          <div class="list-meta" style="font-size:11px">${labelStatus} · ${alert.data.target||0} conteúdos meta</div>
        </div>
        <div class="list-right">${badge}</div>
      </div>
    `;
  };
  return `
    <div class="card mb-3" style="border:1px solid var(--warning);background:linear-gradient(135deg,var(--warning-soft),var(--surface));overflow:hidden">
      <div class="card-header" style="padding-bottom:8px;border-bottom:1px solid var(--border)">
        <div class="card-title" style="display:flex;align-items:center;gap:8px">
          <span style="font-size:20px">🚨</span>
          <span>Prazos urgentes</span>
          <span class="badge b-danger" style="margin-left:4px">${hoje.length+atrasados.length} crítico(s)</span>
        </div>
        <span class="card-link" onclick="goTo('cronograma')">Cronograma →</span>
      </div>
      ${atrasados.length > 0 ? `
        <div style="padding:6px 0">
          <div class="text-xs text-3" style="padding:4px 12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em">⚠ Vencidos (${atrasados.length})</div>
          ${atrasados.slice(0,5).map(row).join('')}
        </div>
      ` : ''}
      ${hoje.length > 0 ? `
        <div style="padding:6px 0">
          <div class="text-xs text-3" style="padding:4px 12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em">🚨 Hoje (${hoje.length})</div>
          ${hoje.map(row).join('')}
        </div>
      ` : ''}
      ${amanha.length > 0 ? `
        <div style="padding:6px 0">
          <div class="text-xs text-3" style="padding:4px 12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em">⏰ Amanhã (${amanha.length})</div>
          ${amanha.map(row).join('')}
        </div>
      ` : ''}
    </div>
  `;
}

// ============ CAPTACOES: PRAZO DE ENTREGA (+15 dias) ============
function getCaptacoesPrazoAlertas(){
  if(typeof captacoes === 'undefined' || !Array.isArray(captacoes)) return [];
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  const alertas = [];
  captacoes.forEach(cap => {
    if(!cap.prazo_entrega || cap.entregue) return;
    try {
      const prazo = new Date(cap.prazo_entrega + 'T00:00:00');
      if(isNaN(prazo.getTime())) return;
      const diff = Math.round((prazo - hoje) / 86400000);
      // Avisa em D-1, D-0 e atrasado (diff <= 1)
      if(diff <= 1){
        alertas.push({captacao: cap, prazo, diff});
      }
    } catch(e){ console.warn('[capt prazo]', e); }
  });
  alertas.sort((a,b) => a.diff - b.diff);
  return alertas;
}

async function marcarCaptacaoEntregue(dbId){
  if(!(await confirmDelete('Marcar captacao como ENTREGUE Uma notificacao sera enviada pros admins.'))) return;
  const agora = new Date().toISOString();
  if(_supa){
    const { error } = await _supa.from('captacoes').update({entregue: true, entregue_em: agora}).eq('id', dbId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  const cap = captacoes.find(c => c._dbId === dbId);
  if(cap){ cap.entregue = true; cap.entregue_em = agora; }

  // Notificacao pros admins (Vini/Vinicius/Ederson) — cria lembretes pra cada
  try {
    const cliNome = (cap && (cap.client || cap.client_custom_name)) || 'Captacao';
    const respNome = (cap && cap.resp) || (typeof _currentProfile !== 'undefined' && _currentProfile ? _currentProfile.name : 'Colaborador');
    const adminEmails = ['vini@impulseone.com.br','vinicius@impulseone.com.br','edersonoliveira.eder@gmail.com'];
    const adminProfiles = (team||[]).filter(t => adminEmails.includes((t.email||'').toLowerCase()));
    if(_supa && adminProfiles.length > 0){
      for(const adm of adminProfiles){
        if(!adm._dbId) continue;
        await _supa.from('lembretes').insert({
          profile_id: adm._dbId,
          texto: '✅ ' + respNome + ' entregou a captacao de ' + cliNome,
          data_hora: agora,
          done: false
        });
      }
    }
    if(typeof loadLembretes === 'function') await loadLembretes();
  } catch(e){ console.warn('[notif entrega]', e); }

  // Remove o evento "Prazo entrega" do calendario, se existir
  try {
    if(_supa && cap){
      const cliNome = cap.client || cap.client_custom_name || '';
      const tituloPrazo = '⏱ Prazo entrega: ' + cliNome;
      await _supa.from('eventos_calendario').delete().like('titulo', tituloPrazo + '%').eq('data_inicio', cap.prazo_entrega);
      if(typeof loadEventosCalendario === 'function') await loadEventosCalendario();
    }
  } catch(e){ console.warn('[remove evento prazo]', e); }

  toast('✓ Entrega registrada — admins notificados','success');
  if(typeof currentPage !== 'undefined' && typeof renderPage === 'function'){
    renderPage(currentPage);
  }
}

function renderDemandasCRMCard(){
  if(typeof _relacionamentos === 'undefined' || !Array.isArray(_relacionamentos)) return '';
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  const demandas = _relacionamentos.filter(r => r.proxima_acao && r.proxima_data).map(r => {
    const d = new Date(r.proxima_data+'T00:00:00');
    const diff = Math.round((d - hoje) / 86400000);
    return Object.assign({}, r, {diff: diff});
  }).filter(d => d.diff <= 7).sort((a,b) => a.diff - b.diff);
  if(demandas.length === 0) return '';
  const urgentes = demandas.filter(d => d.diff <= 0);
  return '<div class="card" style="border-left:4px solid ' + (urgentes.length>0?'var(--danger)':'var(--warning)') + ';margin-bottom:14px">' +
    '<div class="card-header"><div class="card-title">📌 Demandas do CRM (próximas)</div>' +
    '<span class="badge ' + (urgentes.length>0?'b-danger':'b-warning') + '">' + demandas.length + ' demanda(s)</span></div>' +
    '<div style="display:flex;flex-direction:column;gap:8px">' +
      demandas.slice(0,6).map(d => {
        const cli = clients.find(c => c._dbId === d.client_id);
        const label = d.diff < 0 ? Math.abs(d.diff)+'d atrasada' : d.diff === 0 ? 'HOJE' : 'em '+d.diff+'d';
        const badge = d.diff <= 0 ? 'b-danger' : 'b-warning';
        return '<div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--surface-2);border-radius:8px;border:1px solid var(--border)" onclick="goTo(\'relacionamento\')" style="cursor:pointer">' +
          '<div class="cron-cli-logo" style="background:' + (cli?cli.color:'#888') + ';width:30px;height:30px;font-size:11px">' + (cli?cli.init:'?') + '</div>' +
          '<div style="flex:1"><div style="font-size:13px;font-weight:600">' + (cli?cli.name:'(sem cliente)') + ' — ' + escapeHtml(d.proxima_acao||'') + '</div>' +
          '<div class="text-xs text-3" style="margin-top:2px">' + (d.proxima_data||'') + (d.responsavel_nome ? ' · ' + escapeHtml(d.responsavel_nome) : '') + '</div></div>' +
          '<span class="badge ' + badge + '">' + label + '</span>' +
          '<button class="btn btn-sm" onclick="event.stopPropagation();concluirDemanda(\'' + d.id + '\')" style="padding:3px 8px;font-size:11px">✓</button>' +
        '</div>';
      }).join('') +
    '</div></div>';
}

function renderCaptacoesEntreguesCard(){
  // So mostra pra admin/gestor
  if(typeof isGestor === 'function' && !isGestor()) return '';
  if(typeof captacoes === 'undefined' || !Array.isArray(captacoes)) return '';
  const setedias = new Date(); setedias.setDate(setedias.getDate() - 7); setedias.setHours(0,0,0,0);
  const recentes = captacoes
    .filter(c => c.entregue && c.entregue_em && new Date(c.entregue_em) >= setedias)
    .sort((a,b) => (b.entregue_em||'').localeCompare(a.entregue_em||''));
  if(recentes.length === 0) return '';
  return '<div class="card" style="border-left:4px solid var(--success);margin-bottom:14px">' +
    '<div class="card-header"><div class="card-title">✅ Entregas recentes (7 dias)</div>' +
    '<span class="badge b-success">' + recentes.length + ' entrega(s)</span></div>' +
    '<div style="display:flex;flex-direction:column;gap:8px">' +
      recentes.slice(0,8).map(cap => {
        const cliNome = cap.client || cap.client_custom_name || '(sem cliente)';
        const quando = cap.entregue_em ? new Date(cap.entregue_em).toLocaleString('pt-BR',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '';
        const tipoIco = cap.type === 'video' ? '🎬' : cap.type === 'foto' ? '📷' : '🎥';
        return '<div style="display:flex;align-items:center;gap:12px;padding:9px 12px;background:var(--success-soft);border-radius:9px;border:1px solid var(--success);color:var(--success-text)">' +
          '<div style="font-size:18px">' + tipoIco + '</div>' +
          '<div style="flex:1">' +
            '<div style="font-size:13px;font-weight:600;color:var(--text)">' + escapeHtml(cliNome) + ' · ' + escapeHtml(cap.resp||'') + '</div>' +
            '<div class="text-xs text-3" style="margin-top:2px">Capt. ' + (cap.date||'?') + ' · prazo ' + (cap.prazo_entrega||'?') + ' · entregue ' + quando + '</div>' +
          '</div>' +
          '<span class="badge b-success">✓ Entregue</span>' +
        '</div>';
      }).join('') +
    '</div></div>';
}

function renderCaptacoesPrazoCard(){
  const alertas = getCaptacoesPrazoAlertas();
  if(alertas.length === 0) return '';
  const vencidas = alertas.filter(a => a.diff < 0);
  const hoje = alertas.filter(a => a.diff === 0);
  const amanha = alertas.filter(a => a.diff === 1);
  const isUrgente = vencidas.length + hoje.length > 0;
  return '<div class="card" style="border-left:4px solid ' + (isUrgente?'var(--danger)':'var(--warning)') + ';margin-bottom:14px">' +
    '<div class="card-header"><div class="card-title">' + (isUrgente?'🚨':'⏰') + ' Captações: prazos de entrega</div>' +
    '<span class="badge ' + (isUrgente?'b-danger':'b-warning') + '">' + alertas.length + ' aviso(s)</span></div>' +
    '<div style="display:flex;flex-direction:column;gap:8px">' +
      alertas.map(a => {
        const cap = a.captacao;
        const cliNome = cap.client || cap.client_custom_name || '(sem cliente)';
        const tipoIco = cap.type === 'video' ? '🎬' : cap.type === 'foto' ? '📷' : '🎥';
        const label = a.diff < 0 ? Math.abs(a.diff) + ' dia(s) ATRASADA' : a.diff === 0 ? 'VENCE HOJE' : 'vence AMANHÃ';
        const badge = a.diff < 0 ? 'b-danger' : a.diff === 0 ? 'b-danger' : 'b-warning';
        return '<div style="display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--surface-2);border-radius:9px;border:1px solid var(--border)">' +
          '<div style="font-size:20px">' + tipoIco + '</div>' +
          '<div style="flex:1">' +
            '<div style="font-size:13.5px;font-weight:600">' + escapeHtml(cliNome) + (cap.responsavel_nome ? ' · ' + escapeHtml(cap.responsavel_nome) : '') + '</div>' +
            '<div class="text-xs text-3" style="margin-top:2px">Captação ' + (cap.date||'?') + ' · prazo entrega ' + (cap.prazo_entrega||'?') + ' · resp.: ' + escapeHtml(cap.resp||'Equipe') + '</div>' +
          '</div>' +
          '<span class="badge ' + badge + '">' + label + '</span>' +
          '<button class="btn btn-sm" onclick="marcarCaptacaoEntregue(\'' + cap._dbId + '\')" title="Marcar como entregue" style="font-size:11px;padding:5px 10px">✓ Entregue</button>' +
        '</div>';
      }).join('') +
    '</div></div>';
}

function renderDashboard(c){
  const date = new Date();
  const hr = date.getHours();
  const greeting = hr<12?'Bom dia':hr<18?'Boa tarde':'Boa noite';
  const dateStr = date.toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  let nome = 'Ederson';
  try {
    if(_currentProfile && _currentProfile.name){
      nome = String(_currentProfile.name).trim().split(/\s+/)[0];
    } else if(_currentUser && _currentUser.email){
      const local = _currentUser.email.split('@')[0];
      nome = local.charAt(0).toUpperCase() + local.slice(1);
    }
  } catch(e){}

  // ===== Aniversariantes do mês (atual)
  const mesAtual = date.getMonth();
  const anoAtual = date.getFullYear();
  const aniversariantes = (team||[]).filter(m => {
    if(!m.birthday) return false;
    const p = m.birthday.split('-');
    return p.length === 3 && (parseInt(p[1])-1) === mesAtual;
  }).map(m => {
    const p = m.birthday.split('-');
    const dia = parseInt(p[2]);
    const ano = parseInt(p[0]);
    return {...m, dia, idade: anoAtual - ano};
  }).sort((a,b) => a.dia - b.dia);

  // ===== Admissões aniversariantes do mês
  const aniversariosAdmissao = (team||[]).filter(m => {
    if(!m.since) return false;
    const p = m.since.split('-');
    if(p.length !== 3) return false;
    if((parseInt(p[1])-1) !== mesAtual) return false;
    const ano = parseInt(p[0]);
    return (anoAtual - ano) > 0;
  }).map(m => {
    const p = m.since.split('-');
    return {...m, dia: parseInt(p[2]), anos: anoAtual - parseInt(p[0])};
  }).sort((a,b) => a.dia - b.dia);

  // ===== Pendências de checklist por colaborador (hoje)
  const hojeStr = date.toISOString().split('T')[0];
  let checklistsPendentes = [];
  try {
    const dailyOk = typeof dailyChecklists !== 'undefined';
    if(dailyOk){
      Object.entries(dailyChecklists).forEach(([nome, lista]) => {
        const total = (lista||[]).length;
        const pendentes = (lista||[]).filter(t => !t.done).length;
        const m = (team||[]).find(t => t.name.startsWith(nome)) || {init: nome[0], color: '#999'};
        if(pendentes > 0){
          checklistsPendentes.push({nome, m, status: 'pendente', total, pendentes});
        }
      });
    }
  } catch(e){}

  // ===== Próximas reuniões (próximos 7 dias)
  const proxReunioes = (typeof meetings !== 'undefined' ? meetings : []).slice(0, 4);

  // ===== Próximas captações
  const proxCaptacoes = (typeof captacoes !== 'undefined' ? captacoes : [])
    .filter(c => ['agendada','confirmada','em andamento'].includes((c.status||'').toLowerCase()))
    .slice(0, 4);

  // ===== Lembretes pendentes do usuário
  const meusLembretes = (typeof getMeusLembretes === 'function') ? getMeusLembretes().filter(l => !l.done).slice(0,4) : [];

  // ===== Total clientes
  const totalClientes = (clients||[]).filter(x => x.status !== 'cancelado').length;

  c.innerHTML = `
    <div class="page active">
      ${typeof renderDeadlineBanner === 'function' ? renderDeadlineBanner() : ''}
      ${typeof renderCaptacoesPrazoCard === 'function' ? renderCaptacoesPrazoCard() : ''}
      ${typeof renderCaptacoesEntreguesCard === 'function' ? renderCaptacoesEntreguesCard() : ''}
      ${typeof renderDemandasCRMCard === 'function' ? renderDemandasCRMCard() : ''}

      <div class="page-header">
        <div>
          <div class="page-title">Olá ${nome}, ${greeting.toLowerCase()}!</div>
          <div class="page-subtitle">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)} · Impulse One</div>
        </div>
        <div class="page-actions">
          <button class="btn" onclick="goTo('calendario')">📅 Calendário completo</button>
          <button class="btn btn-primary" onclick="goTo('captacao')">🎬 Nova captação</button>
        </div>
      </div>

      <!-- Stats compactos: só o que importa -->
      <div class="stat-grid">
        ${statCard('Captações próximas', String(proxCaptacoes.length), 'agendadas', 'M14 6l-4 4 4 4')}
        ${statCard('Reuniões', String(proxReunioes.length), 'próximas', 'M23 7l-7 5 7 5z')}
        ${statCard('Aniversariantes', String(aniversariantes.length + aniversariosAdmissao.length), 'no mês', 'M12 1v22')}
        ${statCard('Checklists pendentes', String(checklistsPendentes.length), 'colaboradores', 'M9 11l3 3L22 4')}
      </div>

      <!-- Linha 1: Calendário (esquerda) + Aniversariantes + Lembretes (direita) -->
      <div class="grid-2e">
        <div class="card">
          <div class="card-header">
            <div class="card-title">📅 ${['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'][mesAtual]} ${anoAtual}</div>
            <span class="card-link" onclick="goTo('calendario')">Ver completo</span>
          </div>
          ${renderMiniCalendarioDashboard()}
        </div>

        <div style="display:flex;flex-direction:column;gap:14px">
          <div class="card">
            <div class="card-header">
              <div class="card-title">🎂 Aniversariantes do mês</div>
              <span class="card-link" onclick="goTo('equipe')">Equipe</span>
            </div>
            ${aniversariantes.length === 0 && aniversariosAdmissao.length === 0
              ? '<div class="empty-state" style="padding:24px 12px"><div class="ico">🎂</div><div class="ttl" style="font-size:13px">Ninguém faz aniversário neste mês</div></div>'
              : aniversariantes.map(p => {
                  const passou = p.dia < date.getDate();
                  return `<div class="list-item">
                    <div class="avatar" style="background:${p.color};${passou?'opacity:.5':''}">${p.init}</div>
                    <div class="list-content">
                      <div class="list-title">🎂 ${p.name} <span class="text-xs text-3">· faz ${p.idade}</span></div>
                      <div class="list-meta">Dia ${p.dia} ${passou?'· passou':'· em breve'}</div>
                    </div>
                    <button class="icon-btn" onclick="openWhatsAppQuick('${(p.phone||'').replace(/[^0-9]/g,'')}','Feliz aniversário, ${(p.name||'').split(' ')[0]}! 🎉')" title="Mandar mensagem">💬</button>
                  </div>`;
                }).join('') +
                aniversariosAdmissao.map(p => `<div class="list-item">
                  <div class="avatar" style="background:${p.color}">${p.init}</div>
                  <div class="list-content">
                    <div class="list-title">🏆 ${p.name}</div>
                    <div class="list-meta">${p.anos} ano${p.anos>1?'s':''} de empresa · dia ${p.dia}</div>
                  </div>
                </div>`).join('')
            }
          </div>

          <div class="card">
            <div class="card-header">
              <div class="card-title">💡 Meus lembretes</div>
              <span class="card-link" onclick="openLembretesWidget()">+ Novo</span>
            </div>
            ${meusLembretes.length === 0
              ? '<div class="empty-state" style="padding:24px 12px"><div class="ico">✓</div><div class="ttl" style="font-size:13px">Tudo em dia</div></div>'
              : meusLembretes.map(l => {
                  const dt = l.data_hora ? new Date(l.data_hora) : null;
                  const txt = dt ? (dt.toLocaleDateString('pt-BR') === new Date().toLocaleDateString('pt-BR') ? '🚨 Hoje ' + dt.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}) : dt.toLocaleDateString('pt-BR')) : 'Sem data';
                  return `<div class="list-item">
                    <div class="list-icon">💡</div>
                    <div class="list-content">
                      <div class="list-title">${(l.texto||'').substring(0,60).replace(/</g,'&lt;')}</div>
                      <div class="list-meta">${txt}</div>
                    </div>
                  </div>`;
                }).join('')
            }
          </div>
        </div>
      </div>

      <!-- Linha 2: Captações + Reuniões -->
      <div class="grid-2e">
        <div class="card">
          <div class="card-header">
            <div class="card-title">🎬 Próximas captações</div>
            <span class="card-link" onclick="goTo('captacao')">Ver todas</span>
          </div>
          ${proxCaptacoes.length === 0
            ? '<div class="empty-state" style="padding:30px 16px"><div class="ico">🎬</div><div class="ttl">Sem captações agendadas</div><div class="desc">Agende em Captação.</div></div>'
            : proxCaptacoes.map(cap => `<div class="list-item">
                <div class="list-icon">🎬</div>
                <div class="list-content">
                  <div class="list-title">${(cap.type||'Captação').replace(/</g,'&lt;')}</div>
                  <div class="list-meta">${(cap.client||'').replace(/</g,'&lt;')} · ${cap.date||''} ${cap.time?'· '+cap.time:''}</div>
                </div>
                <span class="badge b-info">${cap.status||'agendada'}</span>
              </div>`).join('')
          }
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">📹 Próximas reuniões</div>
            <span class="card-link" onclick="goTo('reunioes')">Ver todas</span>
          </div>
          ${proxReunioes.length === 0
            ? '<div class="empty-state" style="padding:30px 16px"><div class="ico">📅</div><div class="ttl">Sem reuniões agendadas</div><div class="desc">Agende em Reuniões.</div></div>'
            : proxReunioes.map(mt => `<div class="list-item">
                <div class="list-icon">📹</div>
                <div class="list-content">
                  <div class="list-title">${(mt.title||'').replace(/</g,'&lt;')}</div>
                  <div class="list-meta">${mt.day||''}/${mt.m||''} · ${mt.time||''} · ${(mt.c||'').replace(/</g,'&lt;')}</div>
                </div>
                <span class="badge b-default">${mt.type||''}</span>
              </div>`).join('')
          }
        </div>
      </div>

      <!-- Linha 3: Pendências operacionais (checklists) -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">⚠ Pendências operacionais — checklists</div>
          <span class="card-link" onclick="goTo('operacional')">Operacional</span>
        </div>
        ${checklistsPendentes.length === 0
          ? '<div class="empty-state" style="padding:30px 16px"><div class="ico">✓</div><div class="ttl">Todos checklists em dia</div><div class="desc">Nenhum colaborador com pendência.</div></div>'
          : '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;padding:6px 4px 12px">'+
            checklistsPendentes.map(p => {
              const corBadge = p.status === 'vazio' ? 'b-warning' : 'b-info';
              const corBorda = p.status === 'vazio' ? 'var(--warning)' : 'var(--accent)';
              const txt = p.status === 'vazio' ? 'Checklist não preenchido' : `${p.pendentes} de ${p.total} pendentes`;
              return `<div onclick="currentCollab='${p.nome.replace(/\'/g,'')}';goTo('operacional')" style="border:1px solid var(--border);border-left:3px solid ${corBorda};border-radius:10px;padding:10px 12px;cursor:pointer;background:var(--surface);display:flex;align-items:center;gap:10px;transition:.15s" onmouseover="this.style.background='var(--surface-2)'" onmouseout="this.style.background='var(--surface)'">
                <div class="avatar" style="background:${p.m.color};width:34px;height:34px;font-size:13px">${p.m.init}</div>
                <div style="flex:1;min-width:0">
                  <div style="font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${p.nome}</div>
                  <div class="text-xs text-3" style="margin-top:2px">${txt}</div>
                </div>
              </div>`;
            }).join('')+'</div>'
        }
      </div>
    </div>
  `;
}

// Mini calendário do dashboard (mes atual com pontos de eventos)
function renderMiniCalendarioDashboard(){
  const hoje = new Date();
  const ano = hoje.getFullYear();
  const mes = hoje.getMonth();
  const primeiroDia = new Date(ano, mes, 1);
  const ultimoDia = new Date(ano, mes+1, 0);
  const diasNoMes = ultimoDia.getDate();
  const offset = primeiroDia.getDay();

  // Eventos do mes
  let eventos = {};
  try {
    if(typeof getEventosDoMes === 'function'){
      // Forca o calendario "atual" pra mes corrente
      const bkp = (typeof _calCurrent !== 'undefined') ? new Date(_calCurrent) : null;
      _calCurrent = new Date(ano, mes, 1);
      eventos = getEventosDoMes();
      if(bkp) _calCurrent = bkp;
    }
  } catch(e){}

  const dias = ['D','S','T','Q','Q','S','S'];
  let html = '<div style="padding:6px 4px"><div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:6px">' +
    dias.map(d => '<div style="font-size:10px;color:var(--text-muted);text-align:center;font-weight:700;padding:4px">'+d+'</div>').join('') +
    '</div><div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px">';

  // Dias do mes anterior
  for(let i=0; i<offset; i++){
    html += '<div style="aspect-ratio:1;border-radius:6px;background:transparent"></div>';
  }
  // Dias do mes
  for(let d=1; d<=diasNoMes; d++){
    const isHoje = d === hoje.getDate();
    const evs = eventos[d] || [];
    const tipos = [...new Set(evs.map(e => e.tipo))];
    const tooltip = evs.map(e => e.titulo).join(' · ').replace(/"/g,'&quot;');
    const emojiMap = {aniversario:'🎂',ferias:'🏖',feriado:'🎊',admissao:'🏆',reuniao:'📹',evento:'📌',treinamento:'🎓',prazo:'⚠',tarefa:'✅',outro:'📅'};
    const emojisTop = tipos.slice(0,3).map(t => emojiMap[t]||'•').join('');
    html += `<div title="${tooltip}" style="aspect-ratio:1;border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;cursor:${evs.length?'pointer':'default'};background:${isHoje?'var(--accent)':(evs.length?'var(--surface-2)':'transparent')};border:${isHoje?'2px solid var(--accent)':'1px solid var(--border)'};color:${isHoje?'#fff':'var(--text)'};padding:2px" ${evs.length?'onclick="goTo(\'calendario\')"':''}>${emojisTop?'<div style="font-size:11px;line-height:1;margin-bottom:1px">'+emojisTop+'</div>':''}<div style="font-size:11px;font-weight:${isHoje?'700':'500'};line-height:1">${d}</div></div>`;
  }
  html += '</div></div>';
  // Legenda
  html += '<div style="display:flex;flex-wrap:wrap;gap:8px;padding:8px 4px 4px;font-size:10px;color:var(--text-muted);justify-content:center"><span style="display:flex;align-items:center;gap:4px"><div style="width:6px;height:6px;border-radius:50%;background:#06b6d4"></div>Férias</span><span style="display:flex;align-items:center;gap:4px"><div style="width:6px;height:6px;border-radius:50%;background:#f59e0b"></div>Aniversário</span><span style="display:flex;align-items:center;gap:4px"><div style="width:6px;height:6px;border-radius:50%;background:#10b981"></div>Admissão</span><span style="display:flex;align-items:center;gap:4px"><div style="width:6px;height:6px;border-radius:50%;background:#a855f7"></div>Feriado</span></div>';
  return html;
}

// Helper: abre WhatsApp Web direto com mensagem
function openWhatsAppQuick(numero, msg){
  if(!numero){ toast('Sem telefone cadastrado','info'); return; }
  const url = 'https://wa.me/'+numero.replace(/[^0-9]/g,'')+(msg?'?text='+encodeURIComponent(msg):'');
  window.open(url, '_blank');
}

function dashListCard(title,icon,pageId,items){
  const filtered = items.filter(it=>{
    if(dashFilter.prio!=='all' && it.p!==dashFilter.prio) return false;
    if(dashFilter.collab!=='all' && it.o && !it.o.includes(dashFilter.collab)) return false;
    if(dashFilter.client!=='all' && it.c!==dashFilter.client) return false;
    return true;
  });
  return `
    <div class="card">
      <div class="card-header"><div class="card-title">${icon} ${title} <span class="badge b-default" style="margin-left:6px">${filtered.length}</span></div><span class="card-link" onclick="goTo('${pageId}')">Ver tudo</span></div>
      ${filtered.length===0?'<div class="text-mu text-sm">Nenhum item nos filtros atuais.</div>':filtered.map(it=>`
        <div class="list-item">
          ${prioBadge(it.p)}
          <div class="list-content" style="margin-left:4px">
            <div class="list-title">${it.t}</div>
            <div class="list-meta">${it.c}${it.o?' · '+it.o:''}</div>
          </div>
          <div class="list-right"><span class="badge b-default">${it.tag}</span></div>
        </div>
      `).join('')}
    </div>
  `;
}

function statCard(label,value,sub,iconPath,extra,color){
  const colorClass = color==='warning'?'style="background:var(--warning-soft);color:var(--warning-text)"':color==='pink'?'style="background:var(--pink-soft);color:var(--pink-text)"':'';
  return `
    <div class="stat">
      <div class="stat-head">
        <div class="stat-label">${label}</div>
        <div class="stat-icon" ${colorClass}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${iconPath}"/></svg></div>
      </div>
      <div class="stat-value">${value}</div>
      <div class="stat-sub">${sub}</div>
      ${extra?`<div class="mt-3">${extra}</div>`:''}
    </div>
  `;
}
function progress(done,total){
  const pct = Math.round(done/total*100);
  return `<div class="meter"><div class="meter-fill" style="width:${pct}%"></div></div><div class="text-xs text-3" style="margin-top:4px">${pct}% concluído</div>`;
}

// === Placeholder pages, will be filled next ===
// ============ CLIENTES (grid de botões 4 por linha) ============
let _clientesView = 'cards';  // 'cards' | 'gestores'

function renderClientes(c){
  if(_clientesView === 'gestores'){
    renderClientesGestores(c);
    return;
  }
  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Clientes</div>
          <div class="page-subtitle">${clients.length} clientes · ${clients.filter(x=>x.status!=='cancelado').length} ativos · ordem alfabética</div>
        </div>
        <div class="page-actions" style="flex-wrap:wrap">
          <button class="btn" onclick="_clientesView='gestores';renderClientes(document.getElementById('content'))" title="Atualização semanal: ver e trocar gestor de cada cliente" style="background:var(--accent);color:#fff;border:1px solid var(--accent);font-weight:700">📋 Gestores semanal</button>
          <div class="page-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder="Buscar cliente, segmento, owner..." oninput="filterClientes(this.value)"/></div>
          <button class="btn btn-primary" onclick="openNovoClienteModal()">+ Adicionar</button>
        </div>
      </div>

      <div class="filter-bar">
        <span class="filter-chip active" onclick="cliFilterStatus('all',this)">Todos · ${clients.length}</span>
        <span class="filter-chip" onclick="cliFilterStatus('active',this)">Ativos · ${clients.filter(x=>x.status!=='cancelado').length}</span>
        <span class="filter-chip" onclick="cliFilterStatus('cancelado',this)">Cancelados · ${clients.filter(x=>x.status==='cancelado').length}</span>
      </div>

      <div class="cli-grid-btn" id="cliList">
        ${clients.map(cli=>{
          const plan = planoCliente(cli.id);
          const searchKey = `${cli.name} ${cli.segment} ${cli.owner||''} ${cli.gestor_nome||''} ${plan?plan.name:''}`.toLowerCase();
          return `
            <button class="cli-btn" data-search="${searchKey}" data-status="${cli.status}" onclick="openClient(${cli.id})">
              <div class="cli-btn-logo ${cli.logo_url?'has-image':''}" style="background:${cli.logo_url?'transparent':cli.color}">${cli.logo_url?`<img src="${cli.logo_url}" alt="${escapeHtml(cli.name)}" onerror="this.outerHTML='${cli.init}'"/>`:cli.init}</div>
              <div class="cli-btn-name">${cli.name}${cli.gestor_nome?`<div style="font-size:10px;color:var(--text-muted);font-weight:500;margin-top:2px">👤 ${cli.gestor_nome}</div>`:''}</div>
            </button>
          `;
        }).join('')}
      </div>

      <div class="empty-state" id="cliEmpty" style="display:none">
        <div class="ico">🔍</div>
        <div class="ttl">Nenhum cliente encontrado</div>
        <div class="desc">Tente outro termo de busca ou filtro.</div>
      </div>
    </div>
  `;
}

// View de atualizacao semanal: tabela compacta com cliente + gestor editavel
function renderClientesGestores(c){
  // Coleta lista de gestores disponiveis (todos do team)
  const gestoresDisponiveis = (team||[]).map(t => t.name).filter(n => n);

  // Agrupar por gestor pra ver concentracao
  const porGestor = {};
  clients.forEach(cli => {
    if(cli.status === 'cancelado') return;
    const g = cli.gestor_nome || '— sem gestor —';
    if(!porGestor[g]) porGestor[g] = 0;
    porGestor[g]++;
  });

  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Gestores por cliente</div>
          <div class="page-subtitle">Atualização semanal · troque os gestores e adicione novos clientes</div>
        </div>
        <div class="page-actions">
          <button class="btn" onclick="_clientesView='cards';renderClientes(document.getElementById('content'))">← Voltar pra cards</button>
          <button class="btn" onclick="popularClientesPadrao()" title="Garante que os 12 clientes da lista existem">⚡ Inserir lista padrão</button>
          <button class="btn btn-primary" onclick="openNovoClienteModal()">+ Novo cliente</button>
        </div>
      </div>

      ${Object.keys(porGestor).length > 0 ? `
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;padding:10px 12px;background:var(--surface);border:1px solid var(--border);border-radius:10px">
          ${Object.entries(porGestor).sort((a,b)=>b[1]-a[1]).map(([g,n]) => `<span class="badge b-default" style="font-size:12px">👤 ${g.replace(/</g,'&lt;')} <strong style="margin-left:4px">${n}</strong></span>`).join('')}
        </div>` : ''}

      <div class="card" style="padding:0;overflow-x:auto">
        <table class="table" style="min-width:680px">
          <thead><tr>
            <th style="width:50px"></th>
            <th>Cliente</th>
            <th style="width:240px">Gestor responsável</th>
            <th>Plano</th>
            <th style="width:120px">Status</th>
            <th style="width:90px">Ações</th>
          </tr></thead>
          <tbody>
            ${clients.filter(c => c.status !== 'cancelado').sort((a,b) => (a.name||'').localeCompare(b.name||'')).map(cli => `
              <tr>
                <td><div class="avatar" style="background:${cli.color};width:32px;height:32px;font-size:12px">${cli.init||(cli.name||'?')[0]}</div></td>
                <td><div style="cursor:pointer;font-weight:600" onclick="openClient(${cli.id})">${(cli.name||'').replace(/</g,'&lt;')}</div>${cli.segment ? `<div class="text-xs text-3">${cli.segment}</div>` : ''}</td>
                <td>
                  <input type="text" list="dl-gestores-${cli.id}" value="${(cli.gestor_nome||'').replace(/"/g,'&quot;')}" onblur="setGestorCliente(${cli.id}, this.value)" placeholder="— sem gestor —" style="width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);color:var(--text);font-size:13px;font-family:inherit">
                  <datalist id="dl-gestores-${cli.id}">${gestoresDisponiveis.map(g => `<option value="${g.replace(/"/g,'&quot;')}">`).join('')}</datalist>
                </td>
                <td class="text-mu text-sm">${(planoCliente(cli.id)||{}).name || '—'}</td>
                <td><span class="badge b-success">Ativo</span></td>
                <td><button class="btn btn-sm" onclick="openClient(${cli.id})" style="padding:4px 9px;font-size:11px">✏️ Editar</button></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>

      <div style="margin-top:14px;padding:12px 14px;background:var(--surface-2);border-radius:10px;font-size:12px;color:var(--text-muted)">
        💡 <strong>Dica:</strong> Você pode digitar qualquer nome no campo do gestor (a lista é uma sugestão dos colaboradores cadastrados, mas aceita texto livre).
      </div>
    </div>
  `;
}

async function setGestorCliente(clientId, nomeGestor){
  const cli = clients.find(c => c.id === clientId);
  if(!cli) return;
  const valor = (nomeGestor||'').trim() || null;
  if(cli.gestor_nome === valor) return;
  cli.gestor_nome = valor;
  // Tenta encontrar o gestor_id no team
  let gestor_id = null;
  if(valor){
    const found = (team||[]).find(t => t.name === valor || (t.name||'').toLowerCase().startsWith(valor.toLowerCase()));
    if(found && found._dbId) gestor_id = found._dbId;
  }
  if(_supa && cli._dbId){
    const { error } = await _supa.from('clients').update({gestor_nome: valor, gestor_id}).eq('id', cli._dbId);
    if(error){ console.warn(error); toast('Erro: '+error.message,'info'); return; }
  }
  toast('✓ Gestor atualizado','success');
}

// Insere/atualiza a lista padrão de 12 clientes (atualização semanal)
async function popularClientesPadrao(){
  const lista = [
    {nome:'Weco', gestor:'André'},
    {nome:'Natacenter', gestor:'André'},
    {nome:'Eucassel', gestor:'Alex'},
    {nome:'Steel Desk', gestor:'André'},
    {nome:'Marmtina', gestor:'André'},
    {nome:'Precisa Serviço', gestor:'Alex'},
    {nome:'Aquassafe', gestor:'André'},
    {nome:'Banca de Síndicos', gestor:'André'},
    {nome:'Concept', gestor:'André'},
    {nome:'Alegria Kids', gestor:'André'},
    {nome:'Impulse', gestor:'André'},
    {nome:'Franci', gestor:'André'}
  ];
  if(!confirm(`Atualizar lista de clientes?\n\n• Vai CRIAR os clientes que não existem (${lista.length} no total)\n• Vai DEFINIR o gestor de cada um\n• Clientes existentes serão MANTIDOS e atualizados\n\nConfirma?`)) return;
  let criados = 0, atualizados = 0;
  const cores = ['#0ea5e9','#7c3aed','#ec4899','#f59e0b','#10b981','#ef4444','#06b6d4','#a855f7','#f97316','#3b82f6','#84cc16','#14b8a6'];
  for(let i=0; i<lista.length; i++){
    const item = lista[i];
    // Procura cliente existente
    let cli = clients.find(c => (c.name||'').toLowerCase().trim() === item.nome.toLowerCase().trim());
    if(cli){
      // Atualiza gestor
      cli.gestor_nome = item.gestor;
      if(_supa && cli._dbId){
        try { await _supa.from('clients').update({gestor_nome: item.gestor}).eq('id', cli._dbId); } catch(e){ console.warn(e); }
      }
      atualizados++;
    } else {
      // Cria
      const novo = {
        name: item.nome,
        init: item.nome[0].toUpperCase(),
        color: cores[i % cores.length],
        segment: '',
        owner: '',
        gestor_nome: item.gestor,
        status: 'active',
        mrr: 0,
        score: 0
      };
      if(_supa){
        try {
          const { data, error } = await _supa.from('clients').insert(novo).select().single();
          if(!error && data){
            novo._dbId = data.id;
            novo.id = clients.length > 0 ? Math.max(...clients.map(c=>c.id))+1 : 1;
            clients.push(novo);
            criados++;
          } else if(error){
            console.warn('[popularClientes]', error);
          }
        } catch(e){ console.error(e); }
      } else {
        novo.id = clients.length > 0 ? Math.max(...clients.map(c=>c.id))+1 : 1;
        clients.push(novo);
        criados++;
      }
    }
  }
  toast(`✓ ${criados} criado(s) · ${atualizados} atualizado(s)`,'success');
  renderClientes(document.getElementById('content'));
}
function filterClientes(q){
  const list = document.getElementById('cliList');
  const empty = document.getElementById('cliEmpty');
  if(!list) return;
  const v = (q||'').toLowerCase();
  let shown = 0;
  list.querySelectorAll('.cli-btn').forEach(row=>{
    const matchSearch = row.dataset.search.includes(v);
    const activeStatus = list.dataset.status || 'all';
    // 'active' agora significa "qualquer coisa que NÃO seja cancelado"
    let matchStatus;
    if(activeStatus === 'all') matchStatus = true;
    else if(activeStatus === 'active') matchStatus = row.dataset.status !== 'cancelado';
    else matchStatus = row.dataset.status === activeStatus;
    const show = matchSearch && matchStatus;
    row.style.display = show?'':'none';
    if(show) shown++;
  });
  if(empty) empty.style.display = shown===0?'':'none';
}
function cliFilterStatus(status,el){
  el.parentNode.querySelectorAll('.filter-chip').forEach(s=>s.classList.toggle('active',s===el));
  const list = document.getElementById('cliList');
  if(list){list.dataset.status = status;}
  const inp = document.querySelector('.page-search input');
  filterClientes(inp?inp.value:'');
}


// ============ MODAL: NOVO CLIENTE ============
function openNovoClienteModal(){
  const mod = document.getElementById('clientModal');
  const colors = ['#0ea5e9','#7c3aed','#ec4899','#f59e0b','#10b981','#ef4444','#06b6d4','#a855f7','#f97316','#3b82f6','#84cc16','#14b8a6','#f43f5e','#22c55e','#ea580c','#eab308'];
  const randColor = colors[Math.floor(Math.random()*colors.length)];
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:${randColor};color:#fff;display:grid;place-items:center;font-weight:700">+</div>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;letter-spacing:-.02em">Novo cliente</div>
        <div class="text-xs text-3" style="margin-top:3px">Preencha os dados basicos - voce pode editar depois</div>
      </div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><div class="info-label" style="margin-bottom:5px">Nome da empresa *</div><input id="ncName" class="login-input" placeholder="Ex: Acme Corp" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Segmento</div><input id="ncSeg" class="login-input" placeholder="Ex: Tecnologia" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">WhatsApp</div><input id="ncPhone" class="login-input" placeholder="11999999999" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Email</div><input id="ncEmail" class="login-input" type="email" placeholder="contato@empresa.com" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Instagram</div><input id="ncIg" class="login-input" placeholder="@empresa" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Site</div><input id="ncSite" class="login-input" placeholder="empresa.com.br" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Plano</div>
          <select id="ncPlan" class="login-input" style="background:var(--surface-2)">
            <option value="">— Sem plano —</option>
            <option value="Essencial">Essencial</option>
            <option value="Crescimento">Crescimento</option>
            <option value="Premium">Premium</option>
            <option value="Enterprise">Enterprise</option>
          </select>
        </div>
        <div><div class="info-label" style="margin-bottom:5px">Status</div>
          <select id="ncStatus" class="login-input" style="background:var(--surface-2)">
            <option value="active" selected>Ativo</option>
            <option value="cancelado">Cancelado</option>
          </select>
        </div>
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Cor de identidade</div>
          <div style="display:flex;gap:6px;flex-wrap:wrap">
            ${colors.map(col=>`<button type="button" onclick="document.getElementById('ncColorVal').value='${col}';document.querySelectorAll('.color-pick').forEach(x=>x.style.transform='scale(1)');this.style.transform='scale(1.3)'" class="color-pick" style="width:28px;height:28px;border-radius:7px;background:${col};border:2px solid var(--border);cursor:pointer;transition:.15s;${col===randColor?'transform:scale(1.3)':''}"></button>`).join('')}
          </div>
          <input type="hidden" id="ncColorVal" value="${randColor}" />
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovoCliente()" id="ncSaveBtn">Criar cliente</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
  setTimeout(()=>document.getElementById('ncName').focus(), 100);
}

async function salvarNovoCliente(){
  const name = document.getElementById('ncName').value.trim();
  if(!name){toast('Nome obrigatorio','info');document.getElementById('ncName').focus();return}
  const plan = document.getElementById('ncPlan').value;
  const planVals = {Essencial:1800,Crescimento:3200,Premium:5500,Enterprise:8900};
  const btn = document.getElementById('ncSaveBtn');
  btn.disabled = true; btn.textContent = 'Salvando...';
  const data = {
    name,
    segment: document.getElementById('ncSeg').value.trim(),
    phone: document.getElementById('ncPhone').value.trim().replace(/\D/g,''),
    email: document.getElementById('ncEmail').value.trim(),
    instagram: document.getElementById('ncIg').value.trim(),
    website: document.getElementById('ncSite').value.trim(),
    plan_name: plan,
    plan_value: planVals[plan],
    mrr: planVals[plan],
    status: document.getElementById('ncStatus').value,
    color: document.getElementById('ncColorVal').value,
    initials: name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase()
  };
  const created = await createClientInSupabase(data);
  if(created){
    closeModal();
    renderClientes(document.getElementById('content'));
  } else {
    btn.disabled = false; btn.textContent = 'Criar cliente';
  }
}

async function confirmarExcluirCliente(id){
  const cli = clients.find(c=>c.id===id);
  if(!cli) return;
  if(!cli._dbId){toast('Cliente nao esta no banco (modo demo)','info');return}
  if(!(await confirmDelete('cliente: ' + cli.name, {aviso:'Todos os dados relacionados (captações, cronograma, etc.) também serão apagados.'}))) return;
  const ok = await deleteClientFromSupabase(cli._dbId, cli.name);
  if(ok){
    closeModal();
    renderClientes(document.getElementById('content'));
  }
}


// ============ CLIENT MODAL ============
function openClient(id){
  const cli = clients.find(x=>x.id===id);if(!cli)return;
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <label class="client-logo client-logo-editable ${cli.logo_url?'has-image':''}" style="background:${cli.logo_url?'transparent':cli.color};width:54px;height:54px;font-size:16px;cursor:pointer;overflow:hidden;position:relative" title="Clique pra trocar a logo">
        ${cli.logo_url?`<img src="${cli.logo_url}" alt="${escapeHtml(cli.name)}" style="width:100%;height:100%;object-fit:cover;display:block" onerror="this.outerHTML='${cli.init}'"/>`:cli.init}
        <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp,image/gif" onchange="uploadClienteLogo(this, ${cli.id})" style="display:none" />
        <span class="client-logo-overlay">📷</span>
      </label>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;letter-spacing:-.02em">${cli.name}</div>
      </div>
      <button class="btn ${cli.status==='cancelado'?'':'btn-primary'}" style="${cli.status==='cancelado'?'background:var(--danger);border-color:var(--danger);color:#fff':'background:var(--success);border-color:var(--success);color:#fff'};display:flex;align-items:center;gap:6px" onclick="toggleClientStatusDirect(${cli.id})" title="Clique pra alternar entre Ativo e Cancelado">
        <span style="width:8px;height:8px;border-radius:50%;background:#fff"></span>
        ${cli.status==='cancelado'?'Cancelado':'Ativo'}
      </button>
      <button class="icon-btn" title="Excluir cliente" onclick="confirmarExcluirCliente(${cli.id})" style="color:var(--danger);margin-right:4px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg></button>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-tabs">
      <div class="modal-tab active" onclick="cliTab(this,'visao')">Visão</div>
      <div class="modal-tab" onclick="cliTab(this,'acessos')">🔐 Acessos</div>
      <div class="modal-tab" onclick="cliTab(this,'jornada')">Jornada</div>
      <div class="modal-tab" onclick="cliTab(this,'briefing')">Briefing</div>
      <div class="modal-tab" onclick="cliTab(this,'plano')">Plano</div>
      <div class="modal-tab" onclick="cliTab(this,'arquivos')">Arquivos</div>
      <div class="modal-tab" onclick="cliTab(this,'antes')">📊 Antes</div>
      <div class="modal-tab" onclick="cliTab(this,'historico')">Histórico</div>
    </div>
    <div class="modal-body">
      ${paneVisao(cli)}
      ${paneAcessos(cli)}
      ${paneJornada(cli)}
      ${paneBriefing(cli)}
      ${paneFinanceiro(cli)}
      ${paneArquivos(cli)}
      ${paneAntes(cli)}
      ${paneHistorico(cli)}
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}
function cliTab(el,pane){
  el.parentNode.querySelectorAll('.modal-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.modal-pane').forEach(p=>p.classList.toggle('active',p.dataset.pane===pane));
}

function paneVisao(cli){
  const podeContrato = isGestor();
  // Helper para botão de quick action com link configurável
  const qa = (icon, label, field, url, opensFn) => {
    const has = !!url;
    const sub = has ? (url.length > 30 ? url.substring(0,28)+'…' : url) : '— sem link —';
    const click = has
      ? (opensFn || `openLink('${url.replace(/'/g,"\\'")}')`)
      : `editClientField(${cli.id}, '${field}', '${label}', '')`;
    return `<div class="qa-wrap" style="position:relative">
      <button class="qa" onclick="${click}" title="${has?'Abrir '+label:'Clique para configurar'}">
        <span class="qa-icon">${icon}</span>
        <span><div style="font-weight:600">${label}</div><div class="text-xs text-3">${sub}</div></span>
      </button>
      <button class="qa-edit" onclick="event.stopPropagation();editClientField(${cli.id}, '${field}', '${label} (URL)', \`${(url||'').replace(/`/g,'\\`')}\`)" title="Editar link">✏️</button>
    </div>`;
  };
  // Helper para campo de info editável
  const info = (label, field, val, ph='') => `
    <div class="info-item info-editable" onclick="editClientField(${cli.id}, '${field}', '${label}', \`${(val||'').replace(/`/g,'\\`')}\`)" title="Clique para editar">
      <div class="info-label">${label}</div>
      <div class="info-value">${val ? val : `<span style="color:var(--text-3);font-weight:400">${ph||'— clique para preencher —'}</span>`}</div>
    </div>`;

  return `
    <div class="modal-pane active" data-pane="visao">
      <div class="qa-grid">
        ${qa('💬','WhatsApp','whatsapp_url',cli.whatsapp_url || (cli.phone?'https://wa.me/'+cli.phone.replace(/\D/g,''):''),cli.phone?`whatsApp('${cli.phone}','${cli.name}')`:null)}
        ${qa('📷','Instagram','instagram_url',cli.instagram_url || (cli.ig?'https://instagram.com/'+cli.ig.replace('@',''):''))}
        ${qa('📁','Google Drive','drive_url',cli.drive_url)}
        ${qa('📹','Google Meet','meet_url',cli.meet_url||'https://meet.google.com/new')}
        ${qa('📅','MLABS','mlabs_url',cli.mlabs_url||'https://app.mlabs.com.br')}
        ${qa('🌐','Site','site_url',cli.site_url || (cli.site?'https://'+cli.site:''))}
        ${podeContrato ? `<div class="qa-wrap" style="position:relative">
          <button class="qa" onclick="openLinksManager('client-${cli.id}-contrato', '📄 Contrato - ${escapeHtml(cli.name).replace(/'/g,"\\'")}','')" title="Múltiplos contratos / aditivos · restrito a gestores">
            <span class="qa-icon">📄</span>
            <span><div style="font-weight:600">Contrato <span style="font-size:9px;background:var(--accent);color:var(--surface);padding:1px 5px;border-radius:4px;margin-left:3px;vertical-align:middle">restrito</span></div><div class="text-xs text-3">Múltiplos arquivos</div></span>
          </button>
        </div>` : ''}
        ${qa('🎨','Criativos','criativos_url',cli.criativos_url)}
        ${qa('📊','Relatórios','relatorios_url',cli.relatorios_url)}
        <div class="qa-wrap" style="position:relative">
          <button class="qa" onclick="copy('https://app.impulseone.com.br/c/${cli.id}','Link do cliente')">
            <span class="qa-icon">🔗</span>
            <span><div style="font-weight:600">Copiar link</div><div class="text-xs text-3">Compartilhar</div></span>
          </button>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><div class="card-title">⚡ Mensagens prontas — WhatsApp</div></div>
        <div class="qa-grid" style="grid-template-columns:repeat(auto-fit,minmax(110px,1fr))">
          ${[
            ['💰','Cobrança',`Olá ${cli.name}! Tudo bem? Passando para lembrar do vencimento da mensalidade. Qualquer dúvida estamos à disposição.`],
            ['✅','Aprovação','Olá! Os conteúdos da semana estão prontos para aprovação. Pode dar uma olhada quando puder?'],
            ['📅','Reunião','Olá! Vamos marcar nossa reunião mensal? Tenho disponibilidade nos seguintes horários...'],
            ['📦','Material','Olá! Enviamos o material novo no Drive. Qualquer ajuste é só avisar!'],
            ['🔁','Follow-up','Olá! Passando para saber se conseguiu analisar nossa proposta. Estou à disposição!'],
            ['🎂','Aniversário',`Feliz aniversário, ${cli.name}! Que seu ano seja repleto de conquistas. Toda a equipe Nova torce por vocês!`],
            ['📝','Pós-reunião','Obrigado pela reunião de hoje! Em anexo o resumo dos próximos passos discutidos.'],
          ].map(t=>`<button class="qa" onclick="copy(\`${t[2].replace(/'/g,"\\'")}\`,'Mensagem');whatsApp('${cli.phone}','${cli.name}')"><span class="qa-icon">${t[0]}</span><span style="font-weight:600">${t[1]}</span></button>`).join('')}
        </div>
      </div>

      <div class="section-title" style="margin-top:0;display:flex;align-items:center;gap:8px">
        Informações de contato
        <span class="text-xs text-3" style="font-weight:400;letter-spacing:0">— clique em qualquer campo para editar</span>
      </div>
      <div class="info-grid">
        ${info('Responsável','contact_name',cli.contact_name)}
        ${info('Cargo','contact_role',cli.contact_role)}
        ${info('WhatsApp','phone',cli.phone,'ex: 5511999998888')}
        ${info('E-mail','email',cli.email,'contato@empresa.com.br')}
        ${info('CNPJ / CPF','cnpj',cli.cnpj,'00.000.000/0000-00')}
        ${info('Início do contrato','contract_start',cli.contract_start ? new Date(cli.contract_start+'T12:00:00').toLocaleDateString('pt-BR') : '','AAAA-MM-DD')}
        ${info('Instagram','ig',cli.ig,'@usuario')}
        ${info('Site','site',cli.site,'empresa.com.br')}
        ${info('Segmento','segment',cli.segment)}
        ${info('Owner interno','owner',cli.owner,'colaborador responsável')}
      </div>

    </div>
  `;
}

function paneAcessos(cli){
  const creds = _credsCache[cli._dbId] || [];
  // Carrega async se ainda não carregou
  if(!_credsCache[cli._dbId] && cli._dbId){
    loadCredentials(cli._dbId).then(()=>{
      // Re-renderiza o modal silenciosamente
      const pane = document.querySelector('.modal-pane[data-pane="acessos"]');
      if(pane && pane.classList.contains('active')){
        pane.outerHTML = paneAcessos(cli);
      }
    });
  }
  // Agrupa por categoria
  const grupos = {
    'redes': {label:'📱 Redes sociais', items:[]},
    'anuncios': {label:'🎯 Anúncios', items:[]},
    'ferramentas': {label:'🛠 Ferramentas', items:[]},
    'hospedagem': {label:'🌐 Hospedagem & domínio', items:[]},
    'outros': {label:'📦 Outros', items:[]}
  };
  creds.forEach(c => {
    const cat = grupos[c.categoria] ? c.categoria : 'outros';
    grupos[cat].items.push(c);
  });

  const renderCred = (c) => `
    <div class="acesso-card">
      <div class="acesso-platform">${c.icone || '🔑'}</div>
      <div class="acesso-info">
        <div class="acesso-name">${c.plataforma}</div>
        <div class="acesso-login">${c.login || '—'}</div>
      </div>
      <div class="acesso-pwd" id="pwd-${c.id}" data-real="${(c.senha||'').replace(/"/g,'&quot;')}">
        ${c.senha ? '•'.repeat(Math.min((c.senha||'').length, 10)) : '—'}
      </div>
      <div class="acesso-actions">
        ${c.senha ? `
          <button class="icon-btn" title="Mostrar/ocultar senha" onclick="togglePwd('pwd-${c.id}',this)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
          <button class="icon-btn" title="Copiar senha" onclick="copyPwd('pwd-${c.id}')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        ` : ''}
        ${c.login ? `<button class="icon-btn" title="Copiar login" onclick="copy('${(c.login||'').replace(/'/g,"\\'")}','Login')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 12H8M12 16V8"/><circle cx="12" cy="12" r="10"/></svg>
        </button>` : ''}
        ${c.url ? `<button class="icon-btn" title="Abrir plataforma" onclick="openLink('${c.url.replace(/'/g,"\\'")}')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14L21 3M21 3v7M21 3h-7M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
        </button>` : ''}
        <button class="icon-btn" title="Editar" onclick="editCredential('${c.id}', ${cli.id})">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
        <button class="icon-btn" title="Excluir" style="color:var(--danger)" onclick="deleteCredential('${c.id}', ${cli.id}, '${c.plataforma.replace(/'/g,"\\'")}')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
    </div>
  `;

  return `
    <div class="modal-pane" data-pane="acessos">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap">
        <div>
          <div style="font-size:14px;font-weight:600">🔐 Acessos & credenciais</div>
          <div class="text-xs text-3" style="margin-top:3px">Logins e senhas das plataformas deste cliente</div>
        </div>
        <button class="btn btn-primary btn-sm" onclick="addCredential(${cli.id})"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>Adicionar credencial</button>
      </div>

      ${creds.length === 0 ? `
        <div class="empty-state" style="padding:50px 20px">
          <div class="ico">🔐</div>
          <div class="ttl">Nenhuma credencial cadastrada</div>
          <div class="desc">Clique em "+ Adicionar credencial" pra cadastrar logins e senhas das redes sociais, ferramentas e plataformas do cliente.</div>
        </div>
      ` : Object.keys(grupos).map(cat => {
        const g = grupos[cat];
        if(g.items.length === 0) return '';
        return `<div class="section-title" style="margin-top:14px">${g.label} <span class="text-xs text-3" style="font-weight:400">· ${g.items.length}</span></div>
          ${g.items.map(renderCred).join('')}`;
      }).join('')}

      <div class="card mt-4" style="border-left:3px solid var(--info)">
        <div class="card-header" style="margin-bottom:8px"><div class="card-title">ℹ️ Como usar</div></div>
        <div class="text-xs text-mu" style="line-height:1.6">
          1. Clique em <strong>+ Adicionar credencial</strong> para cadastrar uma nova plataforma.<br>
          2. Categorias: redes / anuncios / ferramentas / hospedagem / outros.<br>
          3. Use os botões de cada linha para <strong>👁 ver, 📋 copiar, ✏️ editar ou 🗑 excluir</strong>.<br>
          4. Tudo fica salvo no Supabase, sincronizado para toda a equipe.
        </div>
      </div>
    </div>
  `;
}

function togglePwd(id,btn){
  const el = document.getElementById(id);
  if(el.dataset.shown==='1'){
    el.textContent='••••••••••';
    el.dataset.shown='0';
  } else {
    el.textContent = el.dataset.real;
    el.dataset.shown='1';
  }
}
function copyPwd(id){
  const el = document.getElementById(id);
  copy(el.dataset.real,'Senha');
}

// ============ EDIÇÃO DE CLIENTE (campos e URLs) ============
// ============ CACHE LOCAL DOS CAMPOS DO CLIENTE ============
// Garante que mesmo se o banco der erro silencioso, o valor fica salvo no navegador
function _cliLocalKey(cliId){ return 'client_overrides_' + cliId; }
function _cliLocalGet(cliId){
  try { return JSON.parse(localStorage.getItem(_cliLocalKey(cliId)) || '{}'); }
  catch(e){ return {}; }
}
function _cliLocalSet(cliId, field, value){
  const data = _cliLocalGet(cliId);
  data[field] = value;
  try { localStorage.setItem(_cliLocalKey(cliId), JSON.stringify(data)); } catch(e){}
}
// Aplica cache local sobre os clientes carregados do banco (chamar depois do loadDataFromSupabase)
function aplicarCacheLocalClientes(){
  if(!Array.isArray(clients)) return;
  clients.forEach(cli => {
    const cache = _cliLocalGet(cli.id);
    Object.keys(cache).forEach(k => {
      // Só aplica se o campo do banco vier vazio (não sobrescreve valor preenchido pelo banco)
      const val = cli[k];
      const isEmpty = val === '' || val === null || val === undefined || (Array.isArray(val) && val.length === 0);
      if(isEmpty){
        cli[k] = cache[k];
      }
    });
  });
}

async function updateClientField(cliId, field, value){
  const cli = clients.find(c => c.id === cliId);
  if(!cli){
    toast('Cliente não encontrado','info');
    console.error('[updateClientField] cliente não encontrado para id:', cliId);
    return;
  }
  // 1) Atualiza local (memória) IMEDIATAMENTE
  cli[field] = value;
  // 2) Salva no localStorage (cache permanente no navegador)
  _cliLocalSet(cliId, field, value);

  if(!_supa || !cli._dbId){
    toast('Salvo localmente (cliente sem ID no banco — atualize)','info');
    console.warn('[updateClientField] sem _supa ou _dbId. cli:', cli);
    return;
  }
  // 3) Mapeia campo local → coluna do banco
  const mapping = {
    contact_name:'contact_name', contact_role:'contact_role',
    phone:'phone', email:'email', ig:'instagram', site:'website',
    owner:'owner_interno', segment:'segment', mrr:'mrr', status:'status',
    logo_url:'logo_url',
    planName:'plan_name', planValue:'plan_value', plan_designer:'plan_designer',
    contract_start:'contract_start', renovation_date:'renovation_date',
    services_list:'services_list', journey_steps:'journey_steps',
    instagram_url:'instagram_url', drive_url:'drive_url',
    meet_url:'meet_url', mlabs_url:'mlabs_url', site_url:'site_url',
    contrato_url:'contrato_url', criativos_url:'criativos_url',
    relatorios_url:'relatorios_url', whatsapp_url:'whatsapp_url',
    observacoes:'observacoes'
  };
  const col = mapping[field];
  if(!col){
    console.warn('[updateClientField] coluna não mapeada:', field, '— salvo só localmente');
    toast('Campo "'+field+'" salvo localmente','info');
    return;
  }
  // 4) Persiste no Supabase
  try {
    const payload = {};
    payload[col] = (value === '' ? null : value);
    const { error } = await _supa.from('clients').update(payload).eq('id', cli._dbId);
    if(error){
      console.error('[updateClientField] erro do banco:', error);
      // Coluna não existe — informa qual SQL precisa rodar
      const msg = (error.message||'').toLowerCase();
      if(error.code === 'PGRST204' || msg.includes('column') || msg.includes(col)){
        toast('⚠ Coluna "'+col+'" não existe no banco. Salvo localmente. Rode os SQLs em sql/','info');
        alert(`⚠ A coluna "${col}" ainda não existe na tabela "clients" do Supabase.\n\nO valor foi salvo no seu navegador (localStorage) — vai funcionar pra você nesse computador.\n\nPra sincronizar com a equipe inteira, abre o Supabase → SQL Editor e roda os SQLs:\n• 17-cliente-completo.sql\n• 21-cliente-logo.sql\n• 23-cliente-plano.sql\n• 25-jornada-cliente.sql\n\n(Eles têm "alter table clients add column if not exists" - safe pra rodar.)`);
        return;
      }
      toast('Erro ao salvar no banco: '+error.message,'info');
      return;
    }
    toast('✓ Salvo','success');
  } catch(e){
    console.error('[updateClientField] exception:', e);
    toast('Erro: '+e.message,'info');
  }
}

// Editor inline: input no próprio espaço (sem prompt)
function editClientField(cliId, field, label, currentVal){
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  // Encontra o elemento .info-editable correspondente ao field clicado
  // (passamos pelo target via onclick — usamos event.currentTarget)
  const target = (event && event.currentTarget && event.currentTarget.closest('.info-editable'))
                  || (event && event.target && event.target.closest('.info-editable'));
  if(target && !target.querySelector('input,textarea')){
    inlineEditField(target, cliId, field, label, currentVal);
  } else {
    // Fallback se chamada sem evento (ou caso quick-action edit)
    inlineEditQuickAction(cliId, field, label, currentVal);
  }
}

// Transforma um info-item em input editável
function inlineEditField(target, cliId, field, label, currentVal){
  const orig = target.innerHTML;
  const cli = clients.find(c => c.id === cliId);
  const val = (cli && cli[field] != null) ? cli[field] : (currentVal||'');
  target.classList.add('editing');
  target.innerHTML = `
    <div class="info-label">${label}</div>
    <input class="info-inline-input" type="text" value="${(val+'').replace(/"/g,'&quot;')}" placeholder="Digite aqui..." />
  `;
  const inp = target.querySelector('input');
  inp.focus();
  inp.select();
  let saved = false;
  const save = async (commit) => {
    if(saved) return; saved = true;
    target.classList.remove('editing');
    if(commit){
      const novo = inp.value.trim();
      if(novo !== (val+'').trim()){
        await updateClientField(cliId, field, novo);
      }
    }
    // Re-renderiza só esse item via openClient (que regera modal)
    // Pra evitar fechar/abrir, tenta atualizar localmente:
    const novoVal = commit ? inp.value.trim() : val;
    target.innerHTML = `
      <div class="info-label">${label}</div>
      <div class="info-value">${novoVal ? escapeHtml(novoVal) : `<span style="color:var(--text-3);font-weight:400">— clique para preencher —</span>`}</div>
    `;
  };
  inp.addEventListener('blur', ()=>save(true));
  inp.addEventListener('keydown', e=>{
    if(e.key === 'Enter'){ e.preventDefault(); inp.blur(); }
    else if(e.key === 'Escape'){ saved = true; target.classList.remove('editing'); target.innerHTML = orig; }
  });
  // Não dispara o onclick do parent
  inp.addEventListener('click', e=>e.stopPropagation());
}

function escapeHtml(s){
  return (s+'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// Editor inline para botões quick action (URLs) — popup mini ancorado
function inlineEditQuickAction(cliId, field, label, currentVal){
  // Remove qualquer popup aberto antes
  document.querySelectorAll('.qa-inline-popup').forEach(p=>p.remove());

  const editBtn = event && event.currentTarget;
  const wrap = editBtn ? editBtn.closest('.qa-wrap') : null;
  if(!wrap){
    // Fallback raro: usa prompt
    const novo = prompt('Editar '+label+':', currentVal||'');
    if(novo !== null) updateClientField(cliId, field, novo.trim()).then(()=>setTimeout(()=>openClient(cliId),100));
    return;
  }
  const cli = clients.find(c => c.id === cliId);
  const val = (cli && cli[field] != null) ? cli[field] : (currentVal||'');
  const popup = document.createElement('div');
  popup.className = 'qa-inline-popup';
  popup.innerHTML = `
    <div class="qa-inline-label">${label}</div>
    <input type="text" placeholder="https://..." value="${(val+'').replace(/"/g,'&quot;')}" />
    <div class="qa-inline-actions">
      <button class="btn btn-sm" data-act="cancel">Cancelar</button>
      <button class="btn btn-sm btn-primary" data-act="save">Salvar</button>
    </div>
  `;
  wrap.appendChild(popup);
  const inp = popup.querySelector('input');
  inp.focus();
  inp.select();
  const close = () => popup.remove();
  popup.querySelector('[data-act="cancel"]').addEventListener('click', e=>{e.stopPropagation();close();});
  popup.querySelector('[data-act="save"]').addEventListener('click', async e=>{
    e.stopPropagation();
    const novo = inp.value.trim();
    close();
    await updateClientField(cliId, field, novo);
    setTimeout(()=>openClient(cliId), 100);
  });
  inp.addEventListener('keydown', async e=>{
    if(e.key === 'Enter'){
      e.preventDefault();
      const novo = inp.value.trim();
      close();
      await updateClientField(cliId, field, novo);
      setTimeout(()=>openClient(cliId), 100);
    } else if(e.key === 'Escape'){
      close();
    }
  });
  popup.addEventListener('click', e=>e.stopPropagation());
  // Fecha ao clicar fora
  setTimeout(()=>{
    document.addEventListener('click', function handler(ev){
      if(!popup.contains(ev.target)){
        document.removeEventListener('click', handler);
        close();
      }
    });
  }, 50);
}

// ============ CREDENCIAIS (logins/senhas por cliente) ============
let _credsCache = {}; // cliDbId -> [creds]

async function loadCredentials(cliDbId){
  if(!_supa || !cliDbId){ return []; }
  try {
    const { data, error } = await _supa.from('client_credentials')
      .select('*').eq('client_id', cliDbId).order('categoria').order('position');
    if(error){ console.error('[loadCreds]', error); return []; }
    _credsCache[cliDbId] = data || [];
    return data || [];
  } catch(e){ console.error(e); return []; }
}

// Modal in-page para adicionar/editar credencial (sem prompt do navegador)
function openCredModal(cliId, credExisting){
  const cli = clients.find(c => c.id === cliId);
  if(!cli || !cli._dbId){ toast('Cliente sem ID — recarregue','info'); return; }
  const c = credExisting || {plataforma:'', categoria:'redes', login:'', senha:'', url:'', icone:''};
  // Remove modal antigo
  const old = document.getElementById('credModalBg');
  if(old) old.remove();

  const bg = document.createElement('div');
  bg.id = 'credModalBg';
  bg.className = 'modal-bg open';
  bg.style.zIndex = '10000';
  bg.innerHTML = `
    <div class="modal" style="max-width:480px">
      <div class="modal-head">
        <div style="font-size:15px;font-weight:700">${credExisting?'✏️ Editar':'➕ Nova'} credencial</div>
        <button class="modal-close" onclick="closeCredModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding:18px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div>
            <div class="info-label" style="margin-bottom:5px">Plataforma *</div>
            <input id="credPlat" class="login-input" placeholder="ex: Instagram, Meta Ads" value="${escapeHtml(c.plataforma)}" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Categoria</div>
            <select id="credCat" class="login-input" style="background:var(--surface-2);width:100%">
              <option value="redes" ${c.categoria==='redes'?'selected':''}>📱 Redes sociais</option>
              <option value="anuncios" ${c.categoria==='anuncios'?'selected':''}>🎯 Anúncios</option>
              <option value="ferramentas" ${c.categoria==='ferramentas'?'selected':''}>🛠 Ferramentas</option>
              <option value="hospedagem" ${c.categoria==='hospedagem'?'selected':''}>🌐 Hospedagem</option>
              <option value="outros" ${c.categoria==='outros'?'selected':''}>📦 Outros</option>
            </select>
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Login / E-mail</div>
            <input id="credLogin" class="login-input" placeholder="ex: contato@empresa.com.br" value="${escapeHtml(c.login||'')}" style="background:var(--surface-2)" />
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Senha</div>
            <input id="credSenha" type="text" class="login-input" placeholder="${credExisting?'deixe vazio para manter atual':'senha do acesso'}" value="${credExisting?'':escapeHtml(c.senha||'')}" style="background:var(--surface-2)" />
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">URL (opcional)</div>
            <input id="credUrl" class="login-input" placeholder="https://..." value="${escapeHtml(c.url||'')}" style="background:var(--surface-2)" />
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Ícone (emoji, opcional)</div>
            <input id="credIcone" class="login-input" placeholder="📷 📅 🔑..." value="${escapeHtml(c.icone||'')}" maxlength="2" style="background:var(--surface-2);width:80px" />
          </div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:18px">
          <button class="btn" onclick="closeCredModal()">Cancelar</button>
          <button class="btn btn-primary" onclick="saveCredFromModal(${cliId}, ${credExisting?`'${credExisting.id}'`:'null'})">${credExisting?'💾 Salvar alterações':'➕ Adicionar credencial'}</button>
        </div>
      </div>
    </div>
  `;
  bg.addEventListener('click', e=>{ if(e.target === bg) closeCredModal(); });
  document.body.appendChild(bg);
  setTimeout(()=>document.getElementById('credPlat')?.focus(), 50);
}

function closeCredModal(){
  const el = document.getElementById('credModalBg');
  if(el) el.remove();
}

async function saveCredFromModal(cliId, credId){
  const cli = clients.find(c => c.id === cliId);
  const plat = document.getElementById('credPlat').value.trim();
  if(!plat){ toast('Informe a plataforma','info'); return; }
  const cat = document.getElementById('credCat').value;
  const login = document.getElementById('credLogin').value.trim();
  const senha = document.getElementById('credSenha').value;
  const url = document.getElementById('credUrl').value.trim();
  const icone = document.getElementById('credIcone').value.trim();
  try {
    if(credId){
      const payload = {plataforma:plat, categoria:cat, login, url, icone, updated_at:new Date().toISOString()};
      if(senha) payload.senha = senha; // só atualiza se digitou
      const { error } = await _supa.from('client_credentials').update(payload).eq('id', credId);
      if(error) throw error;
      toast('✓ Atualizado','success');
    } else {
      const { error } = await _supa.from('client_credentials').insert({
        client_id: cli._dbId, categoria:cat, plataforma:plat,
        login, senha, url, icone
      });
      if(error) throw error;
      toast('✓ Credencial adicionada','success');
    }
    closeCredModal();
    // Re-carrega credenciais e re-renderiza
    delete _credsCache[cli._dbId];
    await loadCredentials(cli._dbId);
    setTimeout(()=>openClient(cliId), 50);
  } catch(e){
    toast('Erro: '+(e.message||e),'info');
    console.error(e);
  }
}

function addCredential(cliId){ openCredModal(cliId, null); }

function editCredential(credId, cliId){
  const cli = clients.find(c => c.id === cliId);
  const creds = _credsCache[cli._dbId] || [];
  const c = creds.find(x => x.id === credId);
  if(!c){ toast('Credencial não encontrada','info'); return; }
  openCredModal(cliId, c);
}

async function deleteCredential(credId, cliId, plat){
  if(!(await confirmDelete('credencial: ' + plat))) return;
  try {
    const { error } = await _supa.from('client_credentials').delete().eq('id', credId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
    toast('✓ Excluído','success');
    setTimeout(()=>openClient(cliId), 100);
  } catch(e){ toast('Erro: '+e.message,'info'); }
}

// Etapas padrão da jornada IMPULSE ONE (template inicial)
const JORNADA_PADRAO = [
  {id:'js_briefing', name:'Reunião de briefing', description:'Primeira conversa pra entender o cliente, objetivos e expectativas', done:false},
  {id:'js_conhecer', name:'Conhecendo o cliente', description:'Mergulho na marca, mercado, concorrentes, materiais existentes', done:false},
  {id:'js_apresentacao', name:'Apresentação "Prazer, sou da IMPULSE"', description:'Apresentação institucional da agência, equipe e processo', done:false},
  {id:'js_cal_acessos', name:'Aprovação do calendário editorial + acessos', description:'Cliente aprova cronograma do mês e nos passa acessos das redes/ferramentas', done:false},
  {id:'js_aprov_conteudo', name:'Aprovação dos conteúdos editoriais (mensal)', description:'Cliente revisa e aprova os conteúdos do mês corrente', done:false}
];

function paneJornada(cli){
  // Se cliente ainda não tem jornada, usa o template padrão
  const steps = (cli.journey_steps && cli.journey_steps.length > 0) ? cli.journey_steps : JORNADA_PADRAO.map(s => ({...s}));
  const done = steps.filter(s => s.done).length;
  const total = steps.length;
  const pct = total > 0 ? Math.round(done/total*100) : 0;

  return `
    <div class="modal-pane" data-pane="jornada">
      <!-- Resumo do progresso -->
      <div class="card mb-4" style="background:linear-gradient(135deg,var(--surface-2),var(--surface));border:1px solid var(--border-strong)">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:10px">
          <div>
            <div class="text-xs text-3" style="text-transform:uppercase;letter-spacing:.08em;font-weight:600">Jornada do cliente</div>
            <div style="font-size:22px;font-weight:700;letter-spacing:-.02em;margin-top:4px">${done} de ${total} etapas concluídas</div>
          </div>
          <div style="text-align:right">
            <div style="font-size:32px;font-weight:800;letter-spacing:-.03em;color:${pct===100?'var(--success-text)':'var(--text)'}">${pct}%</div>
            <div class="text-xs text-3">${pct===100?'🎉 Completo!':'em andamento'}</div>
          </div>
        </div>
        <div style="height:8px;background:var(--surface-3);border-radius:4px;overflow:hidden">
          <div style="height:100%;background:${pct===100?'var(--success)':'var(--accent)'};width:${pct}%;transition:width .3s"></div>
        </div>
      </div>

      <!-- Checklist editável -->
      <div class="section-title" style="margin-top:0;display:flex;align-items:center;justify-content:space-between">
        <span>📋 Etapas da jornada</span>
        <span class="text-xs text-3" style="font-weight:400;letter-spacing:0">clique no quadrado pra marcar · clique no nome pra editar</span>
      </div>

      <div style="display:flex;flex-direction:column;gap:8px" id="journeyList">
        ${steps.map((s,i)=>{
          const dt = s.completed_at ? new Date(s.completed_at).toLocaleDateString('pt-BR') : '';
          const safeId = s.id;
          return `
            <div class="journey-step ${s.done?'done':''}" style="display:flex;align-items:flex-start;gap:12px;padding:14px;background:${s.done?'var(--success-soft)':'var(--surface)'};border:1px solid ${s.done?'var(--success)':'var(--border)'};border-radius:11px;transition:.2s">
              <button onclick="toggleJourneyStep(${cli.id}, '${safeId}')" title="Marcar/desmarcar" style="width:28px;height:28px;border-radius:7px;border:2px solid ${s.done?'var(--success)':'var(--border-strong)'};background:${s.done?'var(--success)':'var(--surface)'};color:#fff;cursor:pointer;display:grid;place-items:center;flex-shrink:0;font-size:14px;font-weight:700;transition:.18s">${s.done?'✓':''}</button>
              <div style="flex:1;min-width:0">
                <!-- Nome editável inline -->
                <input type="text" value="${escapeHtml(s.name)}"
                  onblur="updateJourneyStepField(${cli.id}, '${safeId}', 'name', this.value)"
                  onkeydown="if(event.key==='Enter'){this.blur()}"
                  style="width:100%;font-size:14px;font-weight:600;color:${s.done?'var(--text-3)':'var(--text)'};background:transparent;border:none;border-bottom:1px dashed transparent;font-family:inherit;padding:2px 0;outline:none;${s.done?'text-decoration:line-through':''}"
                  onfocus="this.style.borderBottomColor='var(--accent-border)'"
                  onblur2="this.style.borderBottomColor='transparent'" />
                <!-- Descrição editável inline -->
                <textarea
                  placeholder="adicionar descrição (opcional)..."
                  onblur="updateJourneyStepField(${cli.id}, '${safeId}', 'description', this.value)"
                  oninput="this.style.height='auto';this.style.height=this.scrollHeight+'px'"
                  style="width:100%;font-size:12px;color:var(--text-3);background:transparent;border:none;border-bottom:1px dashed transparent;font-family:inherit;padding:3px 0;outline:none;resize:none;line-height:1.5;margin-top:2px;min-height:18px;overflow:hidden"
                  onfocus="this.style.borderBottomColor='var(--accent-border)'">${escapeHtml(s.description||'')}</textarea>
                ${s.done && dt ? `<div class="text-xs text-3" style="margin-top:4px;color:var(--success-text);font-weight:500">✓ concluído em ${dt}</div>` : ''}
              </div>
              <div style="display:flex;flex-direction:column;gap:2px;flex-shrink:0">
                <button class="icon-btn" onclick="moverJourneyStep(${cli.id}, '${safeId}', -1)" title="Mover pra cima" style="width:26px;height:26px">↑</button>
                <button class="icon-btn" onclick="moverJourneyStep(${cli.id}, '${safeId}', 1)" title="Mover pra baixo" style="width:26px;height:26px">↓</button>
                <button class="icon-btn" onclick="removerJourneyStep(${cli.id}, '${safeId}')" title="Excluir" style="width:26px;height:26px;color:var(--danger)">×</button>
              </div>
            </div>
          `;
        }).join('')}
      </div>

      <div style="display:flex;gap:6px;margin-top:12px;flex-wrap:wrap">
        <button class="btn btn-sm" onclick="adicionarJourneyStep(${cli.id})">+ Nova etapa</button>
        ${(cli.journey_steps && cli.journey_steps.length > 0) ? `<button class="btn btn-sm" onclick="resetJourneyPadrao(${cli.id})" style="color:var(--text-3)">↺ Voltar ao template padrão</button>` : `<span class="text-xs text-3" style="padding:8px 12px">Usando template padrão · qualquer alteração cria uma jornada personalizada deste cliente</span>`}
      </div>
    </div>
  `;
}

// =========== JORNADA: funções ===========
function getJourneySteps(cli){
  if(!cli.journey_steps || cli.journey_steps.length === 0){
    // Materializa o template padrão pra esse cliente
    return JORNADA_PADRAO.map(s => ({...s}));
  }
  return cli.journey_steps.slice();
}

async function toggleJourneyStep(cliId, stepId){
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  let steps = getJourneySteps(cli);
  const idx = steps.findIndex(s => s.id === stepId);
  if(idx < 0) return;
  steps[idx].done = !steps[idx].done;
  steps[idx].completed_at = steps[idx].done ? new Date().toISOString() : null;
  cli.journey_steps = steps;
  await updateClientField(cliId, 'journey_steps', steps);
  setTimeout(()=>openClient(cliId), 50);
}

async function adicionarJourneyStep(cliId){
  const nome = prompt('Nome da nova etapa:');
  if(!nome || !nome.trim()) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  let steps = getJourneySteps(cli);
  steps.push({
    id: 'js_' + Date.now() + '_' + Math.random().toString(36).slice(2,6),
    name: nome.trim(),
    description: '',
    done: false
  });
  cli.journey_steps = steps;
  await updateClientField(cliId, 'journey_steps', steps);
  setTimeout(()=>openClient(cliId), 50);
}

async function removerJourneyStep(cliId, stepId){
  if(!(await confirmDelete('etapa'))) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  let steps = getJourneySteps(cli).filter(s => s.id !== stepId);
  cli.journey_steps = steps;
  await updateClientField(cliId, 'journey_steps', steps);
  setTimeout(()=>openClient(cliId), 50);
}

// Atualiza qualquer campo de uma etapa (nome, descrição) sem prompt
async function updateJourneyStepField(cliId, stepId, field, value){
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  let steps = getJourneySteps(cli);
  const step = steps.find(s => s.id === stepId);
  if(!step) return;
  const novoValor = (value||'').trim();
  if(step[field] === novoValor) return; // não mudou, não salva
  // Nome não pode ficar vazio
  if(field === 'name' && !novoValor){
    toast('O nome da etapa não pode ficar vazio','info');
    setTimeout(()=>openClient(cliId), 50);
    return;
  }
  step[field] = novoValor;
  cli.journey_steps = steps;
  await updateClientField(cliId, 'journey_steps', steps);
  // Não reabre o modal — mantém o input focado/em edição
}

async function renomearJourneyStep(cliId, stepId){
  return updateJourneyStepField(cliId, stepId, 'name', prompt('Renomear:') || '');
}

async function editarDescJourneyStep(cliId, stepId){
  return updateJourneyStepField(cliId, stepId, 'description', prompt('Descrição:') || '');
}

async function moverJourneyStep(cliId, stepId, delta){
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  let steps = getJourneySteps(cli);
  const idx = steps.findIndex(s => s.id === stepId);
  const newIdx = idx + delta;
  if(idx < 0 || newIdx < 0 || newIdx >= steps.length) return;
  [steps[idx], steps[newIdx]] = [steps[newIdx], steps[idx]];
  cli.journey_steps = steps;
  await updateClientField(cliId, 'journey_steps', steps);
  setTimeout(()=>openClient(cliId), 50);
}

async function resetJourneyPadrao(cliId){
  if(!(await confirmDelete('Voltar pro template padrão da IMPULSE ONE\n\nIsso vai apagar suas etapas customizadas e o progresso atual.'))) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  cli.journey_steps = [];
  await updateClientField(cliId, 'journey_steps', []);
  setTimeout(()=>openClient(cliId), 50);
}

// Cache de briefings por cliente
let _briefingsCache = {};

function paneBriefing(cli){
  // Carrega briefings async
  if(cli._dbId && !_briefingsCache[cli._dbId]){
    loadBriefings(cli._dbId).then(()=>{
      const pane = document.querySelector('.modal-pane[data-pane="briefing"]');
      if(pane && pane.classList.contains('active')){
        pane.outerHTML = paneBriefing(cli);
      }
    });
  }
  const briefings = _briefingsCache[cli._dbId] || [];

  return `
    <div class="modal-pane" data-pane="briefing">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap">
        <div>
          <div style="font-size:14px;font-weight:600">📝 Briefings & Formulários</div>
          <div class="text-xs text-3" style="margin-top:3px">Crie um formulário, envia o link pro cliente responder, e veja as respostas aqui.</div>
        </div>
        <button class="btn btn-primary btn-sm" onclick="abrirEditorBriefing(${cli.id}, null)">+ Novo briefing</button>
      </div>

      ${briefings.length === 0 ? `
        <div class="empty-state" style="padding:50px 20px">
          <div class="ico">📋</div>
          <div class="ttl">Nenhum briefing criado</div>
          <div class="desc">Crie um formulário personalizado e envie pro cliente preencher.</div>
        </div>
      ` : briefings.map(b => {
        const respondido = b.responses && b.responded_at;
        const total = (b.questions || []).length;
        return `
          <div class="card mb-3" style="display:flex;align-items:center;gap:14px;padding:14px">
            <div style="width:44px;height:44px;border-radius:10px;background:${respondido?'var(--success-soft)':'var(--surface-2)'};color:${respondido?'var(--success-text)':'var(--text-2)'};display:grid;place-items:center;font-size:20px">${respondido?'✅':'📋'}</div>
            <div style="flex:1;min-width:0">
              <div style="font-size:14px;font-weight:600">${escapeHtml(b.title||'Briefing')}</div>
              <div class="text-xs text-3" style="margin-top:3px">
                ${total} pergunta(s) ·
                ${respondido ? `<span style="color:var(--success-text)">✓ Respondido em ${new Date(b.responded_at).toLocaleDateString('pt-BR')}${b.responded_by?' por '+escapeHtml(b.responded_by):''}</span>` : 'Status: '+(b.status||'rascunho')}
              </div>
            </div>
            <div style="display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end">
              ${respondido ? `<button class="btn btn-sm btn-primary" onclick="verRespostasBriefing('${b.id}', ${cli.id})">👁 Ver respostas</button>` : ''}
              <button class="btn btn-sm" onclick="abrirEditorBriefing(${cli.id}, '${b.id}')" title="Editar perguntas">✏️</button>
              <button class="btn btn-sm" onclick="copiarLinkBriefing('${b.id}', ${cli.id})" title="Copiar link pro cliente">🔗</button>
              <button class="btn btn-sm" onclick="excluirBriefing('${b.id}', ${cli.id})" title="Excluir" style="color:var(--danger)">🗑</button>
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

// =========== BRIEFINGS — funções ===========
async function loadBriefings(cliDbId){
  if(!_supa || !cliDbId) return [];
  try {
    const { data, error } = await _supa.from('client_briefings')
      .select('*').eq('client_id', cliDbId).order('created_at', {ascending:false});
    if(error){ console.warn('[loadBriefings]', error); _briefingsCache[cliDbId] = []; return []; }
    _briefingsCache[cliDbId] = data || [];
    return data || [];
  } catch(e){ console.error(e); return []; }
}

function gerarBriefingToken(){
  return 'brf_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36).slice(-4);
}

// ===== EDITOR (admin cria/edita perguntas) =====
function abrirEditorBriefing(cliId, briefingId){
  const cli = clients.find(c => c.id === cliId);
  if(!cli){ toast('Cliente não encontrado','info'); return; }
  const briefing = briefingId ? (_briefingsCache[cli._dbId]||[]).find(b => b.id === briefingId) : null;
  const b = briefing || {
    title: 'Briefing inicial', description: '',
    questions: [
      {id:'q1', type:'text', label:'Qual é o nome da empresa?', required:true},
      {id:'q2', type:'long', label:'Conte um pouco sobre a história da marca', required:true},
      {id:'q3', type:'long', label:'Quais são os 3 principais diferenciais?', required:false}
    ],
    status: 'rascunho'
  };
  // Garante IDs únicos em todas as questions
  b.questions = (b.questions||[]).map((q,i) => ({...q, id: q.id || 'q'+(i+1)+'_'+Date.now()}));

  const old = document.getElementById('briefingEditor');
  if(old) old.remove();
  const bg = document.createElement('div');
  bg.id = 'briefingEditor';
  bg.className = 'modal-bg open';
  bg.style.zIndex = '10001';
  bg.innerHTML = `
    <div class="modal" style="max-width:720px">
      <div class="modal-head">
        <div style="width:42px;height:42px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700;font-size:18px">📝</div>
        <div style="flex:1">
          <div style="font-size:16px;font-weight:700">${briefing?'Editar briefing':'Novo briefing'}</div>
          <div class="text-xs text-3" style="margin-top:2px">Monte o formulário que o cliente vai preencher</div>
        </div>
        <button class="modal-close" onclick="document.getElementById('briefingEditor').remove()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding:18px;max-height:75vh;overflow-y:auto">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:4px">Título do briefing</div>
            <input id="brfTitle" class="login-input" value="${escapeHtml(b.title||'')}" placeholder="Ex: Briefing inicial - Aquassafe" style="background:var(--surface-2)" />
          </div>
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:4px">Mensagem de boas-vindas (opcional)</div>
            <textarea id="brfDesc" class="login-input" rows="2" placeholder="Olá! Preciso que você responda esse formulário para começarmos..." style="background:var(--surface-2);resize:vertical;min-height:60px">${escapeHtml(b.description||'')}</textarea>
          </div>
        </div>

        <div class="section-title" style="margin-top:0">📋 Perguntas <span class="text-xs text-3" style="font-weight:400">· clique nas perguntas pra editar</span></div>
        <div id="brfQuestionsList" style="display:flex;flex-direction:column;gap:8px"></div>

        <div style="display:flex;gap:6px;margin-top:12px;flex-wrap:wrap">
          <button class="btn btn-sm" onclick="brfAddQuestion('text')">+ Pergunta curta</button>
          <button class="btn btn-sm" onclick="brfAddQuestion('long')">+ Pergunta longa</button>
          <button class="btn btn-sm" onclick="brfAddQuestion('choice')">+ Escolha (múltipla)</button>
          <button class="btn btn-sm" onclick="brfAddQuestion('email')">+ Email</button>
          <button class="btn btn-sm" onclick="brfAddQuestion('phone')">+ Telefone</button>
          <button class="btn btn-sm" onclick="brfAddQuestion('url')">+ Link/URL</button>
        </div>

        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:22px;padding-top:14px;border-top:1px solid var(--border)">
          <button class="btn" onclick="document.getElementById('briefingEditor').remove()">Cancelar</button>
          <button class="btn btn-primary" onclick="salvarBriefing(${cliId}, ${briefingId?`'${briefingId}'`:'null'})">💾 ${briefing?'Salvar alterações':'Criar briefing'}</button>
        </div>
      </div>
    </div>
  `;
  bg.addEventListener('click', e=>{ if(e.target===bg) bg.remove(); });
  document.body.appendChild(bg);
  // Render inicial das perguntas
  window._brfTempQuestions = b.questions.slice();
  brfRenderQuestions();
}

function brfRenderQuestions(){
  const list = document.getElementById('brfQuestionsList');
  if(!list) return;
  const qs = window._brfTempQuestions || [];
  if(qs.length === 0){
    list.innerHTML = '<div class="empty-state" style="padding:30px"><div class="ico">📭</div><div class="ttl">Sem perguntas ainda</div><div class="desc">Clique nos botões abaixo pra adicionar.</div></div>';
    return;
  }
  const typeLabels = {text:'Resposta curta',long:'Resposta longa',choice:'Escolha múltipla',email:'Email',phone:'Telefone',url:'Link'};
  list.innerHTML = qs.map((q,i)=>`
    <div class="card" style="padding:12px;display:flex;align-items:flex-start;gap:10px">
      <div style="background:var(--surface-3);width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:700;flex-shrink:0">${i+1}</div>
      <div style="flex:1;min-width:0">
        <input value="${escapeHtml(q.label||'')}" placeholder="Texto da pergunta" oninput="window._brfTempQuestions[${i}].label=this.value" style="width:100%;background:transparent;border:none;border-bottom:1px solid var(--border);font-family:inherit;font-size:13.5px;font-weight:600;color:var(--text);padding:4px 0;outline:none" />
        <div style="display:flex;gap:8px;margin-top:6px;align-items:center;flex-wrap:wrap">
          <span class="badge b-default" style="font-size:10px">${typeLabels[q.type]||q.type}</span>
          <label style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text-2);cursor:pointer">
            <input type="checkbox" ${q.required?'checked':''} onchange="window._brfTempQuestions[${i}].required=this.checked" /> obrigatória
          </label>
          ${q.type==='choice'?`<input value="${escapeHtml((q.options||[]).join(', '))}" placeholder="opções separadas por vírgula" oninput="window._brfTempQuestions[${i}].options=this.value.split(',').map(s=>s.trim()).filter(Boolean)" style="flex:1;font-size:11.5px;padding:4px 8px;border:1px solid var(--border);border-radius:5px;font-family:inherit;background:var(--surface-2);color:var(--text);outline:none;min-width:200px" />`:''}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:2px;flex-shrink:0">
        <button class="icon-btn" onclick="brfMoveQuestion(${i}, -1)" title="Mover pra cima" style="width:26px;height:26px">↑</button>
        <button class="icon-btn" onclick="brfMoveQuestion(${i}, 1)" title="Mover pra baixo" style="width:26px;height:26px">↓</button>
        <button class="icon-btn" onclick="brfRemoveQuestion(${i})" title="Excluir" style="width:26px;height:26px;color:var(--danger)">🗑</button>
      </div>
    </div>
  `).join('');
}

function brfAddQuestion(type){
  const labels = {text:'Pergunta curta',long:'Pergunta longa',choice:'Escolha múltipla',email:'Seu email',phone:'Seu telefone',url:'Link de referência'};
  window._brfTempQuestions = window._brfTempQuestions || [];
  window._brfTempQuestions.push({
    id: 'q_' + Date.now() + '_' + Math.random().toString(36).slice(2,6),
    type, label: labels[type] || 'Nova pergunta',
    required: false,
    options: type==='choice' ? ['Opção 1','Opção 2'] : undefined
  });
  brfRenderQuestions();
}

function brfRemoveQuestion(i){
  window._brfTempQuestions.splice(i,1);
  brfRenderQuestions();
}

function brfMoveQuestion(i, delta){
  const qs = window._brfTempQuestions;
  const j = i + delta;
  if(j < 0 || j >= qs.length) return;
  [qs[i], qs[j]] = [qs[j], qs[i]];
  brfRenderQuestions();
}

async function salvarBriefing(cliId, briefingId){
  const cli = clients.find(c => c.id === cliId);
  if(!cli || !cli._dbId){ toast('Cliente sem ID — recarregue','info'); return; }
  const title = document.getElementById('brfTitle').value.trim() || 'Briefing';
  const description = document.getElementById('brfDesc').value.trim();
  const questions = window._brfTempQuestions || [];
  if(questions.length === 0){ toast('Adicione pelo menos uma pergunta','info'); return; }
  // Validação simples
  for(const q of questions){
    if(!q.label || !q.label.trim()){ toast('Todas as perguntas precisam de um texto','info'); return; }
  }
  try {
    const payload = {
      title, description, questions,
      client_id: cli._dbId,
      updated_at: new Date().toISOString()
    };
    if(briefingId){
      const { error } = await _supa.from('client_briefings').update(payload).eq('id', briefingId);
      if(error) throw error;
      toast('✓ Briefing atualizado','success');
    } else {
      payload.share_token = gerarBriefingToken();
      payload.status = 'rascunho';
      const { error } = await _supa.from('client_briefings').insert(payload);
      if(error) throw error;
      toast('✓ Briefing criado','success');
    }
    document.getElementById('briefingEditor').remove();
    delete _briefingsCache[cli._dbId];
    await loadBriefings(cli._dbId);
    setTimeout(()=>openClient(cliId), 50);
  } catch(e){
    console.error('[salvarBriefing]', e);
    if(e.message && e.message.includes('client_briefings')){
      toast('⚠ Rode o SQL 22-briefings.sql no Supabase pra ativar essa função','info');
    } else {
      toast('Erro: '+e.message,'info');
    }
  }
}

async function excluirBriefing(briefingId, cliId){
  if(!(await confirmDelete('briefing As respostas também serão apagadas.'))) return;
  const cli = clients.find(c => c.id === cliId);
  try {
    await _supa.from('client_briefings').delete().eq('id', briefingId);
    toast('✓ Excluído','success');
    delete _briefingsCache[cli._dbId];
    await loadBriefings(cli._dbId);
    setTimeout(()=>openClient(cliId), 50);
  } catch(e){ toast('Erro: '+e.message,'info'); }
}

async function copiarLinkBriefing(briefingId, cliId){
  const cli = clients.find(c => c.id === cliId);
  const briefing = (_briefingsCache[cli._dbId]||[]).find(b => b.id === briefingId);
  if(!briefing){ toast('Briefing não encontrado','info'); return; }
  let token = briefing.share_token;
  if(!token){
    token = gerarBriefingToken();
    await _supa.from('client_briefings').update({share_token: token, status:'enviado'}).eq('id', briefingId);
    briefing.share_token = token;
    briefing.status = 'enviado';
  } else if(briefing.status === 'rascunho'){
    await _supa.from('client_briefings').update({status:'enviado'}).eq('id', briefingId);
    briefing.status = 'enviado';
  }
  const link = `${location.origin}/?briefing=${token}`;
  navigator.clipboard.writeText(link);
  toast('✓ Link copiado!','success');
  // Pergunta se quer enviar por WhatsApp
  if(cli.phone){
    if(confirm('Link copiado: '+link+'\n\nEnviar pelo WhatsApp do cliente ('+cli.phone+')?')){
      const msg = `Olá! Preciso que você preencha esse formulário pra alinharmos o trabalho:\n\n${link}\n\nÉ rápido, em uns minutos. Qualquer dúvida me chame!`;
      window.open(`https://wa.me/${cli.phone.replace(/\D/g,'')}?text=${encodeURIComponent(msg)}`, '_blank');
    }
  } else {
    alert('Link copiado:\n\n'+link+'\n\nCole e envie pro cliente. Quando ele preencher, as respostas aparecem aqui automaticamente.');
  }
}

// Visualizar respostas (admin)
function verRespostasBriefing(briefingId, cliId){
  const cli = clients.find(c => c.id === cliId);
  const briefing = (_briefingsCache[cli._dbId]||[]).find(b => b.id === briefingId);
  if(!briefing || !briefing.responses){ toast('Sem respostas ainda','info'); return; }

  const old = document.getElementById('briefingRespModal');
  if(old) old.remove();
  const bg = document.createElement('div');
  bg.id = 'briefingRespModal';
  bg.className = 'modal-bg open';
  bg.style.zIndex = '10001';
  const respondidoEm = briefing.responded_at ? new Date(briefing.responded_at).toLocaleString('pt-BR') : '—';
  bg.innerHTML = `
    <div class="modal" style="max-width:680px">
      <div class="modal-head">
        <div style="width:42px;height:42px;border-radius:10px;background:var(--success);color:#fff;display:grid;place-items:center;font-weight:700;font-size:18px">✅</div>
        <div style="flex:1">
          <div style="font-size:16px;font-weight:700">${escapeHtml(briefing.title)}</div>
          <div class="text-xs text-3" style="margin-top:2px">Respondido em ${respondidoEm}${briefing.responded_by?' por '+escapeHtml(briefing.responded_by):''}</div>
        </div>
        <button class="modal-close" onclick="document.getElementById('briefingRespModal').remove()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding:18px;max-height:75vh;overflow-y:auto">
        ${(briefing.questions||[]).map((q,i)=>{
          const resp = briefing.responses[q.id] || '';
          return `
            <div style="padding:12px 14px;background:var(--surface-2);border-radius:10px;margin-bottom:8px">
              <div class="text-xs text-3" style="font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px">Pergunta ${i+1}</div>
              <div style="font-size:13.5px;font-weight:600;margin-bottom:8px;color:var(--text)">${escapeHtml(q.label)}</div>
              <div style="font-size:14px;color:var(--text-2);line-height:1.6;white-space:pre-wrap;padding:10px 12px;background:var(--surface);border-radius:8px;border:1px solid var(--border)">${resp ? escapeHtml(resp) : '<em style="color:var(--text-3)">— sem resposta —</em>'}</div>
            </div>
          `;
        }).join('')}
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
          <button class="btn" onclick="document.getElementById('briefingRespModal').remove()">Fechar</button>
          <button class="btn btn-primary" onclick="exportarRespostasPDF('${briefingId}', ${cliId})">📄 Exportar PDF</button>
        </div>
      </div>
    </div>
  `;
  bg.addEventListener('click', e => { if(e.target === bg) bg.remove(); });
  document.body.appendChild(bg);
}

// Exporta respostas como PDF (usa jsPDF que já carregado)
function exportarRespostasPDF(briefingId, cliId){
  try {
    const cli = clients.find(c => c.id === cliId);
    const briefing = (_briefingsCache[cli._dbId]||[]).find(b => b.id === briefingId);
    if(!briefing) return;
    const { jsPDF } = window.jspdf || {};
    if(!jsPDF){ toast('PDF não disponível','info'); return; }
    const doc = new jsPDF();
    let y = 20;
    doc.setFontSize(16); doc.setFont(undefined, 'bold');
    doc.text(briefing.title || 'Briefing', 20, y); y += 8;
    doc.setFontSize(10); doc.setFont(undefined, 'normal');
    doc.setTextColor(100);
    doc.text(`Cliente: ${cli.name}`, 20, y); y += 5;
    doc.text(`Respondido em: ${new Date(briefing.responded_at).toLocaleString('pt-BR')}`, 20, y); y += 10;
    doc.setTextColor(0);
    (briefing.questions||[]).forEach((q,i)=>{
      const resp = briefing.responses[q.id] || '— sem resposta —';
      if(y > 270){ doc.addPage(); y = 20; }
      doc.setFont(undefined,'bold'); doc.setFontSize(11);
      const labelLines = doc.splitTextToSize(`${i+1}. ${q.label}`, 170);
      doc.text(labelLines, 20, y); y += labelLines.length * 5 + 2;
      doc.setFont(undefined,'normal'); doc.setFontSize(10); doc.setTextColor(70);
      const respLines = doc.splitTextToSize(resp, 170);
      doc.text(respLines, 20, y); y += respLines.length * 5 + 6;
      doc.setTextColor(0);
    });
    doc.save(`briefing-${cli.name}-${new Date().toISOString().split('T')[0]}.pdf`);
    toast('✓ PDF exportado','success');
  } catch(e){ console.error(e); toast('Erro ao gerar PDF: '+e.message,'info'); }
}

function paneConteudo(cli){
  return `
    <div class="modal-pane" data-pane="conteudo">
      <div class="text-mu text-sm mb-4">Calendário editorial — Maio/2026</div>
      ${['Instagram','Reels','Stories','TikTok'].map(p=>`
        <div class="card mb-3">
          <div class="card-header"><div class="card-title">${p}</div><span class="badge b-default">${Math.floor(Math.random()*8+3)} posts</span></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            ${Array.from({length:5}).map((_,i)=>{
              const st=['Aprovado','Aprovado','Em produção','Aguardando','Publicado'][i];
              const co=['b-success','b-success','b-warning','b-info','b-purple'][i];
              return `<div style="padding:8px 12px;background:var(--surface-2);border-radius:8px;border:1px solid var(--border);min-width:130px">
                <div class="text-xs text-3">${17+i} mai · 19h</div>
                <div class="text-sm font-semi">Post #${i+1}</div>
                <span class="badge ${co}" style="margin-top:5px">${st}</span>
              </div>`;
            }).join('')}
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

function paneFinanceiro(cli){
  const planName = cli.planName || '';
  const planValue = parseFloat(cli.planValue) || parseFloat(cli.mrr) || 0;
  const servicesList = Array.isArray(cli.services_list) && cli.services_list.length ? cli.services_list : (cli.services || []);
  const allServices = ['Gestão de rede social','Tráfego pago','Design fixo','Branding','Vídeos','Captação','Campanhas','Consultoria'];

  const fmtData = (d) => {
    if(!d) return '';
    try { return new Date(d+'T00:00:00').toLocaleDateString('pt-BR'); } catch(e){ return d; }
  };

  return `
    <div class="modal-pane" data-pane="plano">
      <!-- ===== Plano (editável) ===== -->
      <div class="card mb-4" style="background:linear-gradient(135deg,var(--surface-2),var(--surface));border:1px solid var(--border-strong)">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap">
          <div style="flex:1;min-width:220px">
            <div class="text-xs text-3" style="text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-bottom:4px">Plano atual</div>
            <input type="text" value="${escapeHtml(planName)}" placeholder="Ex: Premium, Crescimento..."
              onblur="updateClientField(${cli.id},'planName',this.value);cli.planName=this.value"
              style="font-size:22px;font-weight:700;letter-spacing:-.02em;background:transparent;border:none;border-bottom:1px dashed var(--border-strong);font-family:inherit;color:var(--text);padding:2px 0;width:100%;outline:none" />
            <div class="text-sm text-mu" style="margin-top:6px">${servicesList.length>0?servicesList.length+' serviço(s) inclusos':'Marque os serviços abaixo'}</div>
          </div>
          <!-- Valor do plano removido — fica salvo no banco mas nao aparece na UI -->
        </div>
      </div>

      <!-- ===== Campos editáveis ===== -->
      <div class="info-grid mb-4">
        <div class="info-item info-editable" onclick="editClientField(${cli.id},'owner','Owner (Gerente)',\`${(cli.owner||'').replace(/`/g,'\\\\`')}\`)" title="Clique pra editar">
          <div class="info-label">Owner (Gerente)</div>
          <div class="info-value">${cli.owner ? escapeHtml(cli.owner) : '<span style="color:var(--text-3);font-weight:400">— clique para preencher —</span>'}</div>
        </div>
        <div class="info-item info-editable" onclick="editClientField(${cli.id},'plan_designer','Designer responsável',\`${(cli.plan_designer||'').replace(/`/g,'\\\\`')}\`)" title="Clique pra editar">
          <div class="info-label">Designer responsável</div>
          <div class="info-value">${cli.plan_designer ? escapeHtml(cli.plan_designer) : '<span style="color:var(--text-3);font-weight:400">— clique para preencher —</span>'}</div>
        </div>
        <div class="info-item info-editable" style="position:relative">
          <div class="info-label">Cliente desde</div>
          <input type="date" value="${cli.contract_start||''}"
            onchange="updateClientField(${cli.id},'contract_start',this.value);cli.contract_start=this.value"
            style="background:transparent;border:none;font-family:inherit;font-size:13.5px;font-weight:500;color:var(--text);padding:2px 0;width:100%;outline:none;cursor:pointer" />
        </div>
        <div class="info-item info-editable" style="position:relative">
          <div class="info-label">Renovação</div>
          <input type="date" value="${cli.renovation_date||''}"
            onchange="updateClientField(${cli.id},'renovation_date',this.value);cli.renovation_date=this.value"
            style="background:transparent;border:none;font-family:inherit;font-size:13.5px;font-weight:500;color:var(--text);padding:2px 0;width:100%;outline:none;cursor:pointer" />
        </div>
      </div>

      <!-- ===== Serviços contratados (clicáveis) ===== -->
      <div class="section-title" style="margin-top:0;display:flex;align-items:center;justify-content:space-between">
        <span>Serviços contratados</span>
        <span class="text-xs text-3" style="font-weight:400;letter-spacing:0">clique pra marcar/desmarcar</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px">
        ${allServices.map(s=>{
          const has = servicesList.includes(s);
          return `<div onclick="toggleServicoCliente(${cli.id}, '${s.replace(/'/g,"\\'")}')" style="display:flex;align-items:center;gap:10px;padding:11px 13px;background:${has?'var(--success-soft)':'var(--surface)'};border:1px solid ${has?'var(--success)':'var(--border)'};border-radius:9px;cursor:pointer;transition:.15s">
            <div style="width:22px;height:22px;border-radius:6px;display:grid;place-items:center;background:${has?'var(--success)':'var(--surface-3)'};color:${has?'#fff':'var(--text-3)'};font-size:13px;font-weight:700;flex-shrink:0">${has?'✓':'+'}</div>
            <span style="flex:1;font-size:13px;font-weight:${has?'600':'500'};${has?'color:var(--text)':'color:var(--text-2)'}">${s}</span>
            ${has?'<span class="badge b-success">Incluso</span>':'<span class="text-xs text-3">não incluso</span>'}
          </div>`;
        }).join('')}

        <!-- Adicionar serviço custom -->
        ${(servicesList||[]).filter(s => !allServices.includes(s)).map(s=>`
          <div style="display:flex;align-items:center;gap:10px;padding:11px 13px;background:var(--purple-soft);border:1px solid var(--purple);border-radius:9px">
            <div style="width:22px;height:22px;border-radius:6px;display:grid;place-items:center;background:var(--purple);color:#fff;font-size:13px;font-weight:700">★</div>
            <span style="flex:1;font-size:13px;font-weight:600">${escapeHtml(s)}</span>
            <span class="badge b-purple">Custom</span>
            <button class="icon-btn" onclick="removerServicoCliente(${cli.id}, '${s.replace(/'/g,"\\'")}')" title="Remover" style="color:var(--danger);width:28px;height:28px">×</button>
          </div>
        `).join('')}

        <button class="btn btn-sm" onclick="adicionarServicoCustom(${cli.id})" style="align-self:flex-start;margin-top:6px">+ Adicionar serviço custom</button>
      </div>
    </div>
  `;
}

// Marca/desmarca serviço dos contratados
async function toggleServicoCliente(cliId, servico){
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  const list = Array.isArray(cli.services_list) ? cli.services_list.slice() : [];
  const idx = list.indexOf(servico);
  if(idx >= 0){ list.splice(idx, 1); } else { list.push(servico); }
  cli.services_list = list;
  await updateClientField(cliId, 'services_list', list);
  setTimeout(()=>openClient(cliId), 50);
}

async function adicionarServicoCustom(cliId){
  const nome = prompt('Nome do serviço custom:');
  if(!nome || !nome.trim()) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  const list = Array.isArray(cli.services_list) ? cli.services_list.slice() : [];
  if(list.includes(nome.trim())){ toast('Esse serviço já está na lista','info'); return; }
  list.push(nome.trim());
  cli.services_list = list;
  await updateClientField(cliId, 'services_list', list);
  setTimeout(()=>openClient(cliId), 50);
}

async function removerServicoCliente(cliId, servico){
  if(!(await confirmDelete('serviço: ' + servico))) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  const list = (cli.services_list || []).filter(s => s !== servico);
  cli.services_list = list;
  await updateClientField(cliId, 'services_list', list);
  _refreshPanePlano(cli);
}

