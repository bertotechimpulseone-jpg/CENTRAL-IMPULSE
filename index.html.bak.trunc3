// Cronograma anual — gera dados determinísticos por cliente x mês
const cronograma = {};
clients.forEach((cli)=>{
  cronograma[cli.id] = {};
  for(let m=1;m<=12;m++){
    cronograma[cli.id][m] = {
      produced:0, target:0, hasTraffic:false,
      trafficManager:'', designer:'',
      status:'planejado',
      deadline:'',
      obs:''
    };
  }
});

// Status que NÃO geram alerta de prazo (já estão prontos ou cancelados)
const _STATUS_COMPLETOS = ['cancelado','concluido'];

function getDeadlineAlerts(opts){
  // opts = {range: 'today' | 'soon' | 'all' | 'overdue' | 'week'}
  const range = (opts && opts.range) || 'soon'; // 'soon' = hoje + amanhã (padrão)
  const today = new Date(); today.setHours(0,0,0,0);
  const alerts = [];
  if(typeof cronograma === 'undefined' || !cronograma) return alerts;
  clients.forEach(cli=>{
    Object.entries(cronograma[cli.id]||{}).forEach(([m,d])=>{
      if(!d || !d.deadline) return;
      const dl = new Date(d.deadline+'T00:00:00');
      if(isNaN(dl.getTime())) return;
      const diff = Math.round((dl-today)/86400000);
      // Pula só os realmente finalizados/cancelados
      if(_STATUS_COMPLETOS.includes(d.status||'')) return;
      let aceita = false;
      if(range === 'today') aceita = (diff === 0);
      else if(range === 'soon') aceita = (diff === 0 || diff === 1);
      else if(range === 'week') aceita = (diff >= 0 && diff <= 7);
      else if(range === 'overdue') aceita = (diff < 0);
      else aceita = true;
      if(aceita){
        alerts.push({client:cli,month:parseInt(m),data:d,diff});
      }
    });
  });
  // Ordena: vencidos primeiro, depois hoje, depois amanhã, etc.
  alerts.sort((a,b) => a.diff - b.diff);
  // Log de debug (pra ajudar a diagnosticar)
  if(opts && opts.debug){
    console.log('[getDeadlineAlerts]', range, 'today=', today.toISOString().split('T')[0], 'achou:', alerts.length, alerts);
  }
  return alerts;
}


// ============ THEME ============
function toggleTheme(){
  const r = document.documentElement;
  const next = r.getAttribute('data-theme')==='light'?'dark':'light';
  r.setAttribute('data-theme',next);
  localStorage.setItem('theme',next);
  updateThemeIcon();
  // Redraw current charts after theme change
  setTimeout(()=>renderPage(currentPage),50);
}
function updateThemeIcon(){
  const t = document.documentElement.getAttribute('data-theme');
  const ic = document.getElementById('themeIcon');
  if(!ic) return;
  if(t==='dark'){
    ic.innerHTML = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  } else {
    ic.innerHTML = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>';
  }
}
