        <div><div class="info-label" style="margin-bottom:5px">Email</div><input id="nlEmail" class="login-input" type="email" placeholder="contato@empresa.com" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Valor estimado/mês (R$)</div><input id="nlValue" class="login-input" type="number" placeholder="3000" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Etapa</div><select id="nlStage" class="login-input" style="background:var(--surface-2)"><option>lead</option><option>contato</option><option>diagnostico</option><option>proposta</option><option>fechamento</option></select></div>
        <div><div class="info-label" style="margin-bottom:5px">Prioridade</div><select id="nlPrio" class="login-input" style="background:var(--surface-2)"><option value="urgent">Urgente</option><option value="high">Alta</option><option value="med" selected>Média</option><option value="low">Baixa</option></select></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovoLead()" id="nlBtn">Criar lead</button>
      </div>
