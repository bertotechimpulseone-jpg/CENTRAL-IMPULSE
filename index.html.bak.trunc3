function renderReunioes(c){
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Reuniões</div><div class="page-subtitle">5 agendadas esta semana · 12 realizadas no mês</div></div><div class="page-actions">${searchBar('Buscar reunião, cliente...','.grid-2')}<button class="btn" onclick="openLinksManager('dashboard-meet','📹 Google Meet','https://meet.google.com/new')">📹 Google Meet</button><button class="btn" onclick="openLinksManager('dashboard-zoom','🎥 Zoom','https://zoom.us')">🎥 Zoom</button><button class="btn btn-primary" onclick="openNovaReuniaoModal()">+ Agendar</button></div></div>
  <div class="filter-bar"><span class="filter-chip active">Próximas</span><span class="filter-chip">Realizadas</span><span class="filter-chip">Diagnóstico</span><span class="filter-chip">Estratégica</span><span class="filter-chip">Recorrente</span></div>
  <div class="grid-2">
    <div><div class="section-title" style="margin-top:0">Próximas reuniões</div>
