// Detecta e remove eventos do calendario criados por I3 mas cuja reuniao/learning ja nao existe
async function limparEventosOrfaosI3(){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  if(!isGestor()){ toast('Acesso restrito','info'); return; }
  toast('Procurando eventos órfãos...', 'info');
  try {
    // 1. Carrega todos eventos da agenda
    const { data: evs, error: evErr } = await _supa.from('eventos_calendario').select('id, titulo, data_inicio, tipo');
    if(evErr){ toast('Erro: '+evErr.message,'info'); return; }
    if(!evs || evs.length === 0){ toast('Nenhum evento na agenda', 'info'); return; }

    // 2. IDs validos referenciados pelas I3 atuais
    const idsReunioes = new Set((_i3Reunioes||[]).map(r => r.encontro_evento_id).filter(Boolean));
    const idsLearning = new Set((_i3Learning||[]).map(l => l.evento_calendario_id).filter(Boolean));
    const idsValidos = new Set([...idsReunioes, ...idsLearning]);

    // 3. Detecta órfãos: eventos cujo titulo começa com marcadores I3 mas não estão referenciados
    const orfaos = evs.filter(ev => {
      const t = (ev.titulo||'');
      const ehI3 = t.startsWith('Encontro Sócios I3') || t.startsWith('🎓 Impulse Learning');
      return ehI3 && !idsValidos.has(ev.id);
    });

    if(orfaos.length === 0){
      toast('✓ Nenhum evento órfão encontrado', 'success');
      return;
    }

    const lista = orfaos.map(o => '· ' + o.titulo + ' (' + o.data_inicio + ')').join('\n');
    if(!(await confirmDelete(orfaos.length + ' evento(s) órfão(s)', {aviso: lista}))){
      toast('Cancelado', 'info');
      return;
    }

    // 4. Deleta um por um
    let ok = 0, fail = 0;
    for(const o of orfaos){
      const { error } = await _supa.from('eventos_calendario').delete().eq('id', o.id);
      if(error){ console.warn('[orfao]', o, error); fail++; } else { ok++; }
    }

    toast('✓ ' + ok + ' órfão(s) removido(s)' + (fail?' · ' + fail + ' falharam':''), 'success');
    if(typeof loadEventosCalendario === 'function') await loadEventosCalendario();
  } catch(e){
    console.error('[limparEventosOrfaosI3]', e);
    toast('Erro: ' + (e.message||e), 'info');
  }
}
window.limparEventosOrfaosI3 = limparEventosOrfaosI3;
// ============ /I3 ============

async function renderPagamentos(c){
  try {
    if(typeof _pagamentosFixos === 'undefined') window._pagamentosFixos = [];
    if(typeof _colaboradorPagamentos === 'undefined') window._colaboradorPagamentos = [];
    if(typeof _pagFiltroMes === 'undefined') window._pagFiltroMes = '';
    if(typeof _pagFiltroColab === 'undefined') window._pagFiltroColab = '';

    // === WHITELIST FINANCEIRA: SO ESSES VEEM PAGAMENTOS DE TODOS ===
    const ADMIN_FINANCEIRO_EMAILS = ['vini@impulseone.com.br','vinicius@impulseone.com.br','edersonoliveira.eder@gmail.com'];
    const ADMIN_FINANCEIRO_NOMES = ['vini','vinicius','ederson','heidy','heidi','haisa','haísa'];

    // Resolve quem eu sou (3 fallbacks pra garantir meuDbId)
    let meuDbId = null, meuNomePrimeiro = '', meuEmail = '';
    if(_currentProfile && _currentProfile.id) meuDbId = _currentProfile.id;
    if(_currentUser && _currentUser.email){
      meuEmail = _currentUser.email.toLowerCase();
    }
    if(!meuDbId && meuEmail){
      // Tenta achar no team por email
      const meu = team.find(tm => (tm.email||'').toLowerCase() === meuEmail);
      if(meu && meu._dbId) meuDbId = meu._dbId;
    }
    if(!meuDbId && meuEmail && _supa){
      // Ultimo fallback: busca direto no banco
      try {
        const r = await _supa.from('profiles').select('id').eq('email', meuEmail).maybeSingle();
        if(r.data && r.data.id) meuDbId = r.data.id;
      } catch(e){ console.warn('[fallback profile fetch]', e); }
    }
    if(_currentProfile && _currentProfile.name){
      meuNomePrimeiro = _currentProfile.name.split(' ')[0].toLowerCase();
    }
    if(meuEmail && !meuNomePrimeiro){
      meuNomePrimeiro = meuEmail.split('@')[0].toLowerCase();
    }
    // Se nao tem nome no _currentProfile mas tem meuDbId, busca o nome real no banco
    if(meuDbId && _supa && (!_currentProfile || !_currentProfile.name)){
      try {
        const r = await _supa.from('profiles').select('full_name, position, avatar_color, initials').eq('id', meuDbId).maybeSingle();
        if(r.data){
          if(!_currentProfile) window._currentProfile = {id: meuDbId};
          if(r.data.full_name && !_currentProfile.name){
            _currentProfile.name = r.data.full_name;
            meuNomePrimeiro = r.data.full_name.split(' ')[0].toLowerCase();
            console.log('[renderPagamentos] nome carregado do banco:', r.data.full_name);
          }
        }
      } catch(e){ console.warn('[fetch nome]', e); }
    }
    console.log('[renderPagamentos] meuDbId=', meuDbId, 'nome=', meuNomePrimeiro, 'email=', meuEmail);
    // Recarrega team do banco pra pegar colabs novos (Gael, Antonio, etc)
    if(_supa && (team.length < 10 || true)){
      try {
        const { data: novosProfiles } = await _supa.from('profiles').select('id, full_name, email, position, avatar_color, initials').order('full_name');
        if(novosProfiles){
          novosProfiles.forEach(p => {
            const existe = (team||[]).find(tm => tm._dbId === p.id || (tm.email||'').toLowerCase() === (p.email||'').toLowerCase());
            if(!existe){
              team.push({
                _dbId: p.id,
                name: p.full_name || (p.email||'').split('@')[0] || '(sem nome)',
                email: p.email || '',
                role: p.position || '',
                color: p.avatar_color || '#888',
                init: p.initials || ((p.full_name||'?')[0]||'?').toUpperCase()
              });
              console.log('[refresh team] adicionado:', p.full_name);
            } else if(!existe._dbId && p.id){
              existe._dbId = p.id;
              if(p.full_name && existe.name !== p.full_name) existe.name = p.full_name;
            }
          });
        }
      } catch(e){ console.warn('[refresh team]', e); }
    }
    // Carrega profiles que aparecem em pagamentos mas nao estao no team
    try { await carregarProfilesPagamentos(); } catch(e){ console.warn(e); }

    // ehGestor financeiro: vê tudo
    const ehGestor = ADMIN_FINANCEIRO_EMAILS.includes(meuEmail) || ADMIN_FINANCEIRO_NOMES.some(n => meuNomePrimeiro === n);
    // QUALQUER colaborador autenticado pode adicionar pagamento pra si proprio
    const podeAdicionarProprio = !ehGestor && !!_currentUser;
    const temAcesso = ehGestor || podeAdicionarProprio;

    if(!temAcesso){
      c.innerHTML = '<div class="page-head"><div class="page-title">💰 Pagamentos</div></div><div class="card" style="text-align:center;padding:50px 20px"><div style="font-size:42px;margin-bottom:12px">🔒</div><div style="font-size:15px;font-weight:600">Acesso restrito</div><div class="text-sm text-mu" style="margin-top:6px">Essa área é só pra gestores e colaboradores autorizados.</div></div>';
      return;
    }

    // CASO ESPECIAL: Andre — UI por cliente com valor fixo
    const ehAndre = !ehGestor && (meuNomePrimeiro === 'andre' || meuNomePrimeiro === 'andré');
    if(ehAndre){
      return renderPagamentosAndre(c, meuDbId);
    }

    // Colaborador comum (Fran/Henrique/Leticia) so vê os pagamentos DELE
    if(!ehGestor){
      window._pagFiltroColab = meuDbId || '';
    }

    const fixos = _pagamentosFixos || [];
    let todos = _colaboradorPagamentos || [];
    if(_pagFiltroColab){
      todos = todos.filter(p => p.profile_id === _pagFiltroColab);
    }

    // DECLARAR colabSelecionado AQUI antes de qualquer uso
    const colabSelecionado = _pagFiltroColab ? team.find(tm => tm._dbId === _pagFiltroColab) : null;

    const mesAtual = new Date().toISOString().slice(0,7); // YYYY-MM
    if(!_pagFiltroMes) window._pagFiltroMes = mesAtual;
    const filtro = _pagFiltroMes;

    // Lista de meses disponiveis
    const mesesUnicos = Array.from(new Set([mesAtual, ...todos.map(p => p.mes_ref).filter(Boolean)])).sort().reverse();

    // Pagamentos variáveis do mes filtrado
    const variaveisMes = todos.filter(p => p.mes_ref === filtro);
    // Historico (todos exceto o mes filtrado)
    const historicoTodos = todos.filter(p => p.mes_ref && p.mes_ref !== filtro);
    // Agrupa historico por mes
    const historicoPorMes = {};
    historicoTodos.forEach(p => {
      if(!historicoPorMes[p.mes_ref]) historicoPorMes[p.mes_ref] = [];
      historicoPorMes[p.mes_ref].push(p);
    });
    const mesesHistorico = Object.keys(historicoPorMes).sort().reverse();

    const totalFixos = (colabSelecionado || !ehGestor) ? 0 : fixos.filter(p => p.ativo).reduce((s,p) => s + (parseFloat(p.valor)||0), 0);
    const totalVariavelMes = variaveisMes.reduce((s,p) => s + (parseFloat(p.valor)||0), 0);
    const variavelMesPago = variaveisMes.filter(p => p.status_pago).reduce((s,p) => s + (parseFloat(p.valor)||0), 0);
    const variavelMesPendente = totalVariavelMes - variavelMesPago;
    const totalGeralMes = totalFixos + totalVariavelMes;
    // Total do colaborador no ano todo
    const totalColabAno = colabSelecionado ? todos.filter(p => p.mes_ref && p.mes_ref.startsWith(new Date().getFullYear()+'')).reduce((s,p) => s+(parseFloat(p.valor)||0), 0) : 0;

    const fmtMes = (m) => {
      if(!m || m.length < 7) return m || '';
      const [a,mm] = m.split('-');
      const nomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
      return nomes[parseInt(mm)-1] + '/' + a;
    };

    const subtitulo = colabSelecionado ? 'Pagamentos de ' + colabSelecionado.name : 'Folha do mês — fixos + variáveis + histórico';

    const anoAtualStr = new Date().getFullYear() + '';
    const variavelAnoTotal = (_colaboradorPagamentos||[]).filter(p => p.mes_ref && p.mes_ref.startsWith(anoAtualStr)).reduce((s,p) => s+(parseFloat(p.valor)||0), 0);

    c.innerHTML =
      '<div class="page-head"><div><div class="page-title">💰 Pagamentos</div>' +
      '<div class="page-sub">' + subtitulo + '</div></div>' +
      '<div style="display:flex;gap:8px;flex-wrap:wrap">' +
        // Filtro de mes
        '<select onchange="window._pagFiltroMes=this.value;renderPagamentos(document.getElementById(\'content\'))" class="login-input" style="background:var(--surface-2);width:auto" title="Filtrar por mês">' +
          mesesUnicos.map(m => '<option value="' + m + '" ' + (filtro===m?'selected':'') + '>' + fmtMes(m) + '</option>').join('') +
          '<option value="" ' + (filtro===''?'selected':'') + '>— Todos os meses —</option>' +
        '</select>' +
        // Filtro de colaborador (so pra gestor)
        (ehGestor ? '<select onchange="window._pagFiltroColab=this.value;renderPagamentos(document.getElementById(\'content\'))" class="login-input" style="background:var(--surface-2);width:auto" title="Filtrar por colaborador">' +
          '<option value="">— Todos colaboradores —</option>' +
          sortAlfa(team.filter(tm => tm._dbId), 'name').map(tm => '<option value="' + tm._dbId + '" ' + (_pagFiltroColab===tm._dbId?'selected':'') + '>' + tm.name + '</option>').join('') +
        '</select>' : '') +
        ((ehGestor || podeAdicionarProprio) ? '<button class="btn btn-primary" onclick="novoPagamentoVariavelModal(' + (podeAdicionarProprio && !ehGestor ? '\'' + meuDbId + '\'' : '') + ')">+ Pagamento variável</button>' : '') +
        (ehGestor ? '<button class="btn" onclick="novoPagamentoFixoModal()">+ Fixo</button>' : '') +
      '</div></div>' +

      // === STAT CARDS — Total / Variaveis mes / Variaveis ano / A pagar / Ja pago ===
      '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin-bottom:16px">' +
        '<div class="stat-card"><div class="stat-value">R$ ' + ((colabSelecionado||!ehGestor) ? totalVariavelMes : (totalFixos+totalVariavelMes)).toFixed(2) + '</div><div class="stat-label">' + (colabSelecionado ? 'Total ' + colabSelecionado.name.split(' ')[0] + ' em ' + fmtMes(filtro) : 'Total ' + fmtMes(filtro) + ' (fixos+var)') + '</div></div>' +
        (colabSelecionado ? '<div class="stat-card"><div class="stat-value">R$ ' + totalColabAno.toFixed(2) + '</div><div class="stat-label">Total ' + new Date().getFullYear() + ' (' + colabSelecionado.name.split(' ')[0] + ')</div></div>' : '<div class="stat-card"><div class="stat-value">R$ ' + totalFixos.toFixed(2) + '</div><div class="stat-label">Fixos mensais</div></div>') +
        '<div class="stat-card" style="border-left:3px solid var(--info, var(--accent))"><div class="stat-value">R$ ' + totalVariavelMes.toFixed(2) + '</div><div class="stat-label">💸 Variáveis ' + fmtMes(filtro) + '</div></div>' +
        (colabSelecionado ? '' : '<div class="stat-card"><div class="stat-value">R$ ' + variavelAnoTotal.toFixed(2) + '</div><div class="stat-label">📊 Variáveis ' + anoAtualStr + ' (geral)</div></div>') +
        '<div class="stat-card" style="border-left:3px solid var(--warning)"><div class="stat-value" style="color:var(--warning-text)">R$ ' + (((colabSelecionado||!ehGestor)?0:fixos.filter(f => f.ativo && !fixoFoiPagoNoMes(f, filtro)).reduce((s,f)=>s+(parseFloat(f.valor)||0),0)) + variavelMesPendente).toFixed(2) + '</div><div class="stat-label">⏳ A pagar</div></div>' +
        '<div class="stat-card" style="border-left:3px solid var(--success)"><div class="stat-value" style="color:var(--success-text)">R$ ' + (((colabSelecionado||!ehGestor)?0:fixos.filter(f => f.ativo && fixoFoiPagoNoMes(f, filtro)).reduce((s,f)=>s+(parseFloat(f.valor)||0),0)) + variavelMesPago).toFixed(2) + '</div><div class="stat-label">✅ Já pago</div></div>' +
      '</div>' +

      // === PAGAMENTOS FIXOS (so quando nao tem filtro de colaborador) ===
      (colabSelecionado || !ehGestor ? '' : '<div class="card" style="margin-bottom:16px"><div class="card-header"><div class="card-title">📌 Pagamentos fixos mensais</div>' +
        '<span class="badge b-info">Total ativo: R$ ' + totalFixos.toFixed(2) + '</span></div>' +
        (fixos.length === 0
          ? '<div class="empty-state" style="padding:24px"><div class="ttl">Nenhum pagamento fixo</div><div class="desc">Aluguel, salários fixos, assinaturas — clique em "+ Fixo"</div></div>'
          : '<table style="width:100%;font-size:12.5px"><thead><tr>' +
            '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Nome</th>' +
            '<th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">Valor</th>' +
            '<th style="text-align:center;padding:8px;border-bottom:1px solid var(--border)">Ativo</th>' +
            '<th style="text-align:center;padding:8px;border-bottom:1px solid var(--border);background:var(--warning-soft)">Pago ' + fmtMes(filtro) + '</th>' +
            '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Observações</th>' +
            '<th style="padding:8px;border-bottom:1px solid var(--border)"></th></tr></thead><tbody>' +
            fixos.map(p => {
              const pagoNoMes = fixoFoiPagoNoMes(p, filtro);
              return '<tr style="' + (pagoNoMes?'background:rgba(34,197,94,.06)':'') + '">' +
                '<td style="padding:8px"><input value="' + escapeHtml(p.nome||'') + '" onblur="atualizarPagFixoCampo(\'' + p.id + '\',\'nome\',this.value)" style="background:transparent;border:none;width:100%;font-family:inherit;font-size:12.5px;color:var(--text);outline:none" /></td>' +
                '<td style="padding:8px;text-align:right"><input type="number" step="0.01" value="' + (parseFloat(p.valor)||0) + '" onblur="atualizarPagFixoCampo(\'' + p.id + '\',\'valor\',this.value)" style="background:transparent;border:none;width:90px;text-align:right;font-family:inherit;font-size:12.5px;color:var(--text);outline:none" /></td>' +
                '<td style="padding:8px;text-align:center"><input type="checkbox" ' + (p.ativo?'checked':'') + ' onchange="atualizarPagFixoCampo(\'' + p.id + '\',\'ativo\',this.checked)" title="Ativo: entra no calculo do mes" /></td>' +
                '<td style="padding:8px;text-align:center;background:rgba(245,158,11,.05)"><label style="cursor:pointer;display:inline-flex;align-items:center;gap:5px;font-size:11px"><input type="checkbox" ' + (pagoNoMes?'checked':'') + ' onchange="toggleFixoPagoMes(\'' + p.id + '\',\'' + filtro + '\')" />' + (pagoNoMes?'<span style="color:var(--success-text);font-weight:600">pago</span>':'<span style="color:var(--text-3)">marcar</span>') + '</label></td>' +
                '<td style="padding:8px"><input value="' + escapeHtml(p.observacoes||'') + '" onblur="atualizarPagFixoCampo(\'' + p.id + '\',\'observacoes\',this.value)" placeholder="opcional" style="background:transparent;border:none;width:100%;font-family:inherit;font-size:12.5px;color:var(--text);outline:none" /></td>' +
                '<td style="padding:8px;text-align:right"><button class="icon-btn" onclick="excluirPagamentoFixo(\'' + p.id + '\')" style="color:var(--danger);width:26px;height:26px">×</button></td>' +
              '</tr>';
            }).join('') +
          '</tbody></table>') +
      '</div>') +

      // === PAGAMENTOS VARIÁVEIS DO MES — SEPARADOS POR STATUS ===
      (() => {
        const sortPagamentos = (lista) => lista.slice().sort((a,b) => {
          const colA = (getColabPorId(a.profile_id) || {}).name || '';
          const colB = (getColabPorId(b.profile_id) || {}).name || '';
          return colA.localeCompare(colB, 'pt-BR', {sensitivity:'base'});
        });
        const pendentes = sortPagamentos(variaveisMes.filter(p => !p.status_pago));
        const pagos = sortPagamentos(variaveisMes.filter(p => p.status_pago));
        const totalPendentes = pendentes.reduce((s,p) => s+(parseFloat(p.valor)||0), 0);
        const totalPagos = pagos.reduce((s,p) => s+(parseFloat(p.valor)||0), 0);

        const renderLinha = (p, isPago) => {
          const colab = getColabPorId(p.profile_id);
          const valorRO = ehGestor ? '' : 'readonly disabled';
          const inputStyle = 'background:transparent;border:none;width:100%;font-family:inherit;font-size:12.5px;color:var(--text);outline:none' + (ehGestor?'':';cursor:default');
          // Detecta se eh registro do tipo "Andre por cliente" (tem JSON em observacoes)
          let temDetalhesClientes = false;
          try {
            const obs = JSON.parse(p.observacoes||'{}');
            if(Array.isArray(obs.clientes) && obs.clientes.length > 0) temDetalhesClientes = true;
          } catch(e){}
          return '<tr style="' + (isPago?'opacity:.85':'') + '">' +
            '<td style="padding:8px"><div style="display:flex;align-items:center;gap:8px">' + (colab?'<div class="avatar" style="background:'+colab.color+';width:24px;height:24px;font-size:10px">'+colab.init+'</div>':'') + '<strong>' + (colab?colab.name:'(deletado)') + '</strong></div></td>' +
            '<td style="padding:8px">' + (ehGestor
              ? '<input value="' + escapeHtml(p.descricao||'') + '" onblur="atualizarPagVarCampo(\'' + p.id + '\',\'descricao\',this.value)" style="' + inputStyle + '" />' + (temDetalhesClientes?'<button onclick="verClientesPagamento(\'' + p.id + '\')" style="display:block;margin-top:4px;font-size:11px;color:var(--accent);background:none;border:none;cursor:pointer;padding:0">📋 Ver clientes selecionados</button>':'')
              : escapeHtml(p.descricao||'') + (temDetalhesClientes?'<button onclick="verClientesPagamento(\'' + p.id + '\')" style="display:block;margin-top:4px;font-size:11px;color:var(--accent);background:none;border:none;cursor:pointer;padding:0">📋 Ver clientes</button>':'')
            ) + '</td>' +
            '<td style="padding:8px;text-align:right">' + (ehGestor
              ? '<input type="number" step="0.01" value="' + (parseFloat(p.valor)||0) + '" onblur="atualizarPagVarCampo(\'' + p.id + '\',\'valor\',this.value)" style="background:transparent;border:none;width:90px;text-align:right;font-family:inherit;font-size:12.5px;color:var(--text);outline:none" />'
              : 'R$ ' + (parseFloat(p.valor)||0).toFixed(2)
            ) + '</td>' +
            // Status_pago: so gestor edita
            '<td style="padding:8px;text-align:center">' + (ehGestor
              ? (isPago
                  ? '<button class="btn btn-sm" onclick="atualizarPagVarCampo(\'' + p.id + '\',\'status_pago\',false)" title="Desmarcar como pago" style="padding:3px 10px;font-size:11px;color:var(--success)">✓ Pago</button>'
                  : '<button class="btn btn-sm btn-primary" onclick="marcarComoPago(\'' + p.id + '\')" style="padding:3px 10px;font-size:11px">Marcar pago</button>')
              : (isPago ? '<span class="badge b-success">Pago</span>' : '<span class="badge b-warning">Pendente</span>')
            ) + '</td>' +
            '<td style="padding:8px">' + (ehGestor
              ? '<input type="date" value="' + (p.data_pagamento||'') + '" onblur="atualizarPagVarCampo(\'' + p.id + '\',\'data_pagamento\',this.value)" style="background:transparent;border:none;font-family:inherit;font-size:12.5px;color:var(--text);outline:none" />'
              : (p.data_pagamento || '<span class="text-mu" style="font-size:11px">aguardando</span>')
            ) + '</td>' +
            '<td style="padding:8px;text-align:right">' + (ehGestor || (!isPago && p.profile_id === meuDbId)
              ? '<button class="icon-btn" onclick="excluirPagamentoVariavel(\'' + p.id + '\')" style="color:var(--danger);width:26px;height:26px" title="Excluir">×</button>'
              : ''
            ) + '</td>' +
          '</tr>';
        };

        const headerCols =
          '<thead><tr>' +
            '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Colaborador</th>' +
            '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Descrição</th>' +
            '<th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">Valor</th>' +
            '<th style="text-align:center;padding:8px;border-bottom:1px solid var(--border)">Status</th>' +
            '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Data pgto</th>' +
            '<th style="padding:8px;border-bottom:1px solid var(--border)"></th>' +
          '</tr></thead>';

        return (
          // SECAO PENDENTES
          '<div class="card" style="margin-bottom:14px;border-left:3px solid var(--warning)"><div class="card-header"><div class="card-title">⏳ Pendentes — ' + fmtMes(filtro) + '</div>' +
            '<span class="badge b-warning">R$ ' + totalPendentes.toFixed(2) + ' · ' + pendentes.length + '</span></div>' +
            (pendentes.length === 0
              ? '<div class="text-mu text-sm" style="padding:16px">Nenhum pagamento pendente nesse mês.</div>'
              : '<div style="overflow-x:auto"><table style="width:100%;font-size:12.5px;min-width:700px">' + headerCols + '<tbody>' + pendentes.map(p => renderLinha(p, false)).join('') + '</tbody></table></div>') +
          '</div>' +
          // SECAO PAGOS
          '<div class="card" style="margin-bottom:14px;border-left:3px solid var(--success)"><div class="card-header"><div class="card-title">✅ Pagos — ' + fmtMes(filtro) + '</div>' +
            '<span class="badge b-success">R$ ' + totalPagos.toFixed(2) + ' · ' + pagos.length + '</span></div>' +
            (pagos.length === 0
              ? '<div class="text-mu text-sm" style="padding:16px">Nenhum pagamento marcado como pago nesse mês ainda.</div>'
              : '<div style="overflow-x:auto"><table style="width:100%;font-size:12.5px;min-width:700px">' + headerCols + '<tbody>' + pagos.map(p => renderLinha(p, true)).join('') + '</tbody></table></div>') +
          '</div>'
        );
      })() +

      // === HISTÓRICO POR MES ===
      '<div class="card"><div class="card-header"><div class="card-title">📜 Histórico (meses anteriores)</div>' +
        '<span class="badge b-default">' + mesesHistorico.length + ' mês(es)</span></div>' +
        (mesesHistorico.length === 0
          ? '<div class="text-mu text-sm">Sem histórico ainda. Quando você cadastrar pagamentos em outros meses eles aparecerão aqui.</div>'
          : mesesHistorico.map(mes => {
              const lista = historicoPorMes[mes];
              const total = lista.reduce((s,p) => s + (parseFloat(p.valor)||0), 0);
              const pagos = lista.filter(p => p.status_pago).reduce((s,p) => s + (parseFloat(p.valor)||0), 0);
              return '<div style="margin-bottom:10px"><details style="background:var(--surface-2);padding:8px 12px;border-radius:8px;border:1px solid var(--border)">' +
                '<summary style="cursor:pointer;font-weight:600;font-size:13px;display:flex;justify-content:space-between;align-items:center"><span>📅 ' + fmtMes(mes) + ' · ' + lista.length + ' lançamento(s)</span><span class="text-xs" style="color:var(--text-3);font-weight:400">R$ ' + total.toFixed(2) + ' (R$ ' + pagos.toFixed(2) + ' pago)</span></summary>' +
                '<div style="margin-top:10px"><table style="width:100%;font-size:12px">' +
                  '<thead><tr><th style="text-align:left;padding:5px">Colab.</th><th style="text-align:left;padding:5px">Descrição</th><th style="text-align:right;padding:5px">Valor</th><th style="text-align:center;padding:5px">Pago</th><th style="text-align:left;padding:5px">Data</th></tr></thead><tbody>' +
                  lista.map(p => {
                    const colab = getColabPorId(p.profile_id);
                    return '<tr><td style="padding:5px">' + (colab?colab.name:'(deletado)') + '</td>' +
                      '<td style="padding:5px">' + escapeHtml(p.descricao||'') + '</td>' +
                      '<td style="padding:5px;text-align:right">R$ ' + (parseFloat(p.valor)||0).toFixed(2) + '</td>' +
                      '<td style="padding:5px;text-align:center">' + (p.status_pago?'<span class="badge b-success">✓</span>':'<span class="badge b-warning">—</span>') + '</td>' +
                      '<td style="padding:5px">' + (p.data_pagamento||'-') + '</td></tr>';
                  }).join('') +
                '</tbody></table></div>' +
              '</details></div>';
            }).join('')) +
      '</div>';
  } catch(e){
    console.error('[renderPagamentos]', e);
    c.innerHTML = '<div class="page-head"><div class="page-title">💰 Pagamentos</div></div><div class="card" style="border-left:3px solid var(--danger)"><div style="color:var(--danger);font-weight:600">Erro ao renderizar pagamentos</div><div class="text-xs text-3 mt-2">' + (e.message||e) + '</div></div>';
  }
}

// ========== UI ESPECIAL: ANDRE — pagamento por cliente (R$ 350 cada) ==========
function renderPagamentosAndre(c, meuDbId){
  if(typeof _pagAndreMes === 'undefined') window._pagAndreMes = new Date().toISOString().slice(0,7);
  if(typeof _pagAndreValorCli === 'undefined') window._pagAndreValorCli = 350;

  const mesAtual = _pagAndreMes;
  const clientesAtivos = sortAlfa((clients||[]).filter(c => (c.status||'').toLowerCase() !== 'cancelado'), 'name');

  // Procura o registro do mes do Andre (se existe)
  const registroMes = (_colaboradorPagamentos||[]).find(p =>
    p.profile_id === meuDbId && p.mes_ref === mesAtual && (p.descricao||'').includes('Gestão')
  );

  // Carrega selecionados do banco
  let selecionados = [];
  let valorPorCli = _pagAndreValorCli;
  let valoresOverride = {}; // {clienteId: valorEspecificoDoMes}
  if(registroMes){
    try {
      const dados = JSON.parse(registroMes.observacoes || '{}');
      if(Array.isArray(dados.clientes)) selecionados = dados.clientes;
      if(dados.valor_por_cliente) valorPorCli = parseFloat(dados.valor_por_cliente) || 350;
      if(dados.valores_override && typeof dados.valores_override === 'object') valoresOverride = dados.valores_override;
    } catch(e){ /* observacoes pode nao ser JSON */ }
  }
  // Helper pra pegar valor de um cliente (override OU padrao)
  const getValorCli = (cliId) => {
    const v = valoresOverride[cliId];
    return (v !== undefined && v !== null && !isNaN(parseFloat(v))) ? parseFloat(v) : valorPorCli;
  };
  // Total: soma considerando overrides
  const calcTotalReal = () => selecionados.reduce((s, id) => s + getValorCli(id), 0);

  // Historico (outros meses do Andre)
  const historico = (_colaboradorPagamentos||[])
    .filter(p => p.profile_id === meuDbId && p.mes_ref !== mesAtual)
    .sort((a,b) => (b.mes_ref||'').localeCompare(a.mes_ref||''));

  // Lista de meses disponiveis pra trocar
  const mesesUnicos = Array.from(new Set([mesAtual, ...(_colaboradorPagamentos||[]).filter(p => p.profile_id === meuDbId).map(p => p.mes_ref).filter(Boolean)])).sort().reverse();

  const fmtMes = (m) => {
    if(!m || m.length < 7) return m || '';
    const [a,mm] = m.split('-');
    const nomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
    return nomes[parseInt(mm)-1] + '/' + a;
  };

  const total = calcTotalReal();
  const status = registroMes ? (registroMes.status_pago ? 'pago' : 'pendente') : 'nao-salvo';

  c.innerHTML =
    '<div class="page-head"><div><div class="page-title">💰 Meus pagamentos</div>' +
    '<div class="page-sub">André — R$ ' + valorPorCli.toFixed(2) + ' por cliente atendido</div></div>' +
    '<select onchange="window._pagAndreMes=this.value;renderPagamentos(document.getElementById(\'content\'))" class="login-input" style="background:var(--surface-2);width:auto">' +
      mesesUnicos.map(m => '<option value="' + m + '" ' + (mesAtual===m?'selected':'') + '>' + fmtMes(m) + '</option>').join('') +
      [...Array(12)].map((_,i) => { const d = new Date(); d.setMonth(d.getMonth()-i); return d.toISOString().slice(0,7); }).filter(m => !mesesUnicos.includes(m)).map(m => '<option value="' + m + '">' + fmtMes(m) + '</option>').join('') +
    '</select></div>' +

    // Stat cards
    '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:16px">' +
      '<div class="stat-card"><div class="stat-value">' + selecionados.length + '</div><div class="stat-label">Clientes em ' + fmtMes(mesAtual) + '</div></div>' +
      '<div class="stat-card"><div class="stat-value">R$ ' + valorPorCli.toFixed(2) + '</div><div class="stat-label">Por cliente</div></div>' +
      '<div class="stat-card" style="border-left:3px solid ' + (status==='pago'?'var(--success)':status==='pendente'?'var(--warning)':'var(--border-strong)') + '"><div class="stat-value">R$ ' + total.toFixed(2) + '</div><div class="stat-label">Total ' + fmtMes(mesAtual) + ' · ' + (status==='pago'?'✅ pago':status==='pendente'?'⏳ pendente':'📝 nao salvo') + '</div></div>' +
    '</div>' +

    // Lista de clientes com checkbox
    '<div class="card" style="margin-bottom:16px"><div class="card-header"><div class="card-title">📋 Clientes atendidos em ' + fmtMes(mesAtual) + '</div>' +
      '<span class="text-xs text-3">marque quem voce atendeu</span></div>' +
      '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:6px">' +
        clientesAtivos.map(cli => {
          const marcado = selecionados.includes(cli._dbId);
          const valorEspecifico = valoresOverride[cli._dbId];
          const temOverride = valorEspecifico !== undefined && valorEspecifico !== null;
          const valorMostrar = temOverride ? parseFloat(valorEspecifico) : valorPorCli;
          return '<div style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:' + (marcado?'var(--accent-soft, var(--success-soft))':'var(--surface-2)') + ';border:1px solid ' + (marcado?'var(--accent)':'var(--border)') + ';border-radius:7px;font-size:12.5px">' +
            '<input type="checkbox" class="andre-cli-check" data-cli="' + cli._dbId + '" data-valor="' + valorMostrar + '" ' + (marcado?'checked':'') + ' onchange="atualizarTotalAndre()" style="cursor:pointer" />' +
            '<div class="cron-cli-logo" style="background:' + (cli.color||'#888') + ';width:24px;height:24px;font-size:10px">' + (cli.init||'?') + '</div>' +
            '<span style="flex:1;font-weight:' + (marcado?'600':'500') + ';min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + cli.name + '</span>' +
            (marcado ? (
              '<input type="number" step="0.01" class="andre-cli-valor" data-cli="' + cli._dbId + '" value="' + valorMostrar + '" onchange="atualizarTotalAndre()" oninput="atualizarTotalAndre()" title="Valor neste mes (deixe 350 pra padrao)" style="width:75px;padding:4px 6px;border:1px solid ' + (temOverride?'var(--warning)':'var(--border)') + ';border-radius:5px;background:var(--surface);text-align:right;font-size:12px;color:' + (temOverride?'var(--warning-text)':'var(--text)') + ';font-weight:' + (temOverride?'700':'500') + ';font-family:inherit" />'
            ) : '') +
          '</div>';
        }).join('') +
      '</div>' +
      '<div style="margin-top:14px;padding:12px;background:var(--surface-2);border-radius:8px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">' +
        '<div><div class="text-xs text-3">Total calculado</div><div style="font-size:22px;font-weight:800;color:var(--accent)" id="andreTotalCalc">' + selecionados.length + ' × R$ ' + valorPorCli.toFixed(2) + ' = <strong>R$ ' + total.toFixed(2) + '</strong></div></div>' +
        '<button class="btn btn-primary" onclick="salvarPagamentoAndre(\'' + meuDbId + '\',\'' + mesAtual + '\',' + valorPorCli + ')" style="padding:11px 22px;font-size:13px">💾 ' + (registroMes ? 'Atualizar' : 'Salvar') + ' ' + fmtMes(mesAtual) + '</button>' +
      '</div>' +
    '</div>' +

    // Historico
    '<div class="card"><div class="card-header"><div class="card-title">📜 Histórico</div>' +
      '<span class="badge b-default">' + historico.length + ' mês(es)</span></div>' +
      (historico.length === 0
        ? '<div class="text-mu text-sm" style="padding:16px">Sem histórico ainda. Salve esse mês pra começar.</div>'
        : '<table style="width:100%;font-size:12.5px"><thead><tr><th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Mês</th><th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Descrição</th><th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">Valor</th><th style="text-align:center;padding:8px;border-bottom:1px solid var(--border)">Status</th><th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Data pgto</th></tr></thead><tbody>' +
          historico.map(p => {
            let qtdCli = 0;
            try { const o = JSON.parse(p.observacoes||'{}'); if(Array.isArray(o.clientes)) qtdCli = o.clientes.length; } catch(e){}
            return '<tr><td style="padding:8px"><strong>' + fmtMes(p.mes_ref) + '</strong></td>' +
              '<td style="padding:8px">' + escapeHtml(p.descricao||'') + (qtdCli>0?' <span class="text-xs text-3">(' + qtdCli + ' cli)</span>':'') + '</td>' +
              '<td style="padding:8px;text-align:right;font-weight:600">R$ ' + (parseFloat(p.valor)||0).toFixed(2) + '</td>' +
              '<td style="padding:8px;text-align:center">' + (p.status_pago?'<span class="badge b-success">Pago</span>':'<span class="badge b-warning">Pendente</span>') + '</td>' +
              '<td style="padding:8px">' + (p.data_pagamento||'-') + '</td></tr>';
          }).join('') +
        '</tbody></table>') +
    '</div>';
}

// Recalcula o total quando marca/desmarca cliente
function atualizarTotalAndre(){
  // Re-renderiza so o card de clientes pra mostrar/esconder inputs de valor
  const wrap = document.querySelector('#andreTotalCalc')?.closest('.card');
  const checks = document.querySelectorAll('.andre-cli-check');
  const valorPadrao = (typeof _pagAndreValorCli !== 'undefined') ? _pagAndreValorCli : 350;
  let marcados = 0;
  let total = 0;
  let temCustom = false;
  checks.forEach(c => {
    if(c.checked){
      marcados++;
      // Tenta pegar do input de valor associado
      const valorInput = document.querySelector('.andre-cli-valor[data-cli="' + c.dataset.cli + '"]');
      const v = valorInput ? (parseFloat(valorInput.value)||valorPadrao) : valorPadrao;
      total += v;
      if(Math.abs(v - valorPadrao) > 0.001) temCustom = true;
    }
  });
  const el = document.getElementById('andreTotalCalc');
  if(el){
    if(temCustom){
      el.innerHTML = marcados + ' cliente(s) (alguns com valor customizado) = <strong>R$ ' + total.toFixed(2) + '</strong>';
    } else {
      el.innerHTML = marcados + ' × R$ ' + valorPadrao.toFixed(2) + ' = <strong>R$ ' + total.toFixed(2) + '</strong>';
    }
  }
  // Re-render se o status do checkbox mudou (pra mostrar/esconder input)
  // Mas evita loop: só re-renderiza se diferenca grande
  const algumMarcadoSemInput = Array.from(checks).some(c => c.checked && !document.querySelector('.andre-cli-valor[data-cli="' + c.dataset.cli + '"]'));
  const algumInputSemCheck = Array.from(document.querySelectorAll('.andre-cli-valor')).some(inp => {
    const ck = document.querySelector('.andre-cli-check[data-cli="' + inp.dataset.cli + '"]');
    return ck && !ck.checked;
  });
  if(algumMarcadoSemInput || algumInputSemCheck){
    renderPagamentos(document.getElementById('content'));
  }
}

// Mostra modal com a lista de clientes selecionados de um pagamento
function verClientesPagamento(pagId){
  const p = (_colaboradorPagamentos||[]).find(x => x.id === pagId);
  if(!p){ toast('Pagamento nao encontrado','info'); return; }
  let dados = {};
  try { dados = JSON.parse(p.observacoes||'{}'); } catch(e){}
  const ids = Array.isArray(dados.clientes) ? dados.clientes : [];
  const nomesCache = Array.isArray(dados.clientes_nomes) ? dados.clientes_nomes : [];
  const valorPorCli = dados.valor_por_cliente || 350;
  const valoresOverride = (dados.valores_override && typeof dados.valores_override === 'object') ? dados.valores_override : {};
  const colab = getColabPorId(p.profile_id);

  // Permissao: admin financeiro pode editar
  const ehAdminFin = (function(){
    try {
      const email = (_currentUser && _currentUser.email || '').toLowerCase();
      const ADMIN_EMAILS = ['vini@impulseone.com.br','vinicius@impulseone.com.br','edersonoliveira.eder@gmail.com'];
      if(ADMIN_EMAILS.includes(email)) return true;
      const nome = (_currentProfile && _currentProfile.name ? _currentProfile.name : email.split('@')[0]).toLowerCase().split(' ')[0];
      return ['vini','vinicius','ederson','heidy','heidi','haisa','haísa'].includes(nome);
    } catch(e){ return false; }
  })();

  const getValor = (cliId) => {
    const v = valoresOverride[cliId];
    return (v !== undefined && v !== null && !isNaN(parseFloat(v))) ? parseFloat(v) : valorPorCli;
  };
  const calcTotal = () => ids.reduce((s, id) => s + getValor(id), 0);

  let modal = document.getElementById('detClienteModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'detClienteModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:560px;width:100%;max-height:88vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)" id="detClienteCard">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:40px;height:40px;border-radius:9px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:18px">' + (ehAdminFin?'✏️':'📋') + '</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">' + (ehAdminFin?'Editar valores por cliente':'Clientes selecionados') + '</div>' +
        '<div class="text-xs text-3" style="margin-top:2px">' + (colab?colab.name:'') + ' · ' + (p.mes_ref||'') + ' · padrão R$ ' + valorPorCli.toFixed(2) + '</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'detClienteModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:14px 22px 18px">' +
        '<div class="text-xs text-3" style="margin-bottom:10px"><strong>' + ids.length + '</strong> cliente(s) · Total atual: <strong id="detClienteTotal">R$ ' + calcTotal().toFixed(2) + '</strong>' + (ehAdminFin?' · <span style="color:var(--accent)">edite os valores abaixo</span>':'') + '</div>' +
        '<div style="display:flex;flex-direction:column;gap:6px">' +
          ids.map((id, idx) => {
            const cli = clients.find(c => c._dbId === id);
            const nome = cli ? cli.name : (nomesCache[idx] || '(cliente removido)');
            const cor = cli ? cli.color : '#888';
            const init = cli ? cli.init : '?';
            const valor = getValor(id);
            const temOv = valoresOverride[id] !== undefined && valoresOverride[id] !== null;
            return '<div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--surface-2);border-radius:7px">' +
              '<div class="cron-cli-logo" style="background:' + cor + ';width:28px;height:28px;font-size:11px">' + init + '</div>' +
              '<span style="flex:1;font-size:13px;font-weight:500;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + nome + '</span>' +
              (ehAdminFin
                ? '<input type="number" step="0.01" class="det-cli-valor" data-cli="' + id + '" value="' + valor + '" oninput="atualizarTotalDetCliente()" onchange="atualizarTotalDetCliente()" style="width:90px;padding:5px 8px;border:1px solid ' + (temOv?'var(--warning)':'var(--border)') + ';border-radius:5px;background:var(--surface);text-align:right;font-size:12.5px;font-weight:' + (temOv?'700':'500') + ';color:' + (temOv?'var(--warning-text)':'var(--text)') + ';font-family:inherit" />'
                : '<span class="text-xs text-3" style="font-weight:' + (temOv?'700':'500') + ';color:' + (temOv?'var(--warning-text)':'var(--text-3)') + '">R$ ' + valor.toFixed(2) + '</span>'
              ) +
            '</div>';
          }).join('') +
        '</div>' +
        (ehAdminFin
          ? '<div style="margin-top:14px;padding:10px;background:var(--surface-2);border-radius:8px;font-size:11.5px;color:var(--text-3)">💡 Valores diferentes do padrão (R$ ' + valorPorCli.toFixed(2) + ') ficam destacados em amarelo. Os ajustes só valem pra ' + (p.mes_ref||'') + '.</div>'
          : ''
        ) +
      '</div>' +
      (ehAdminFin
        ? '<div style="padding:14px 22px 18px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid var(--border)">' +
            '<button class="btn" onclick="document.getElementById(\'detClienteModal\').remove()">Cancelar</button>' +
            '<button class="btn btn-primary" onclick="salvarValoresPorCliente(\'' + pagId + '\')">💾 Salvar alterações</button>' +
          '</div>'
        : ''
      ) +
    '</div>';
  document.body.appendChild(modal);
}

// Recalcula o total no modal de edicao de valores
function atualizarTotalDetCliente(){
  const inputs = document.querySelectorAll('.det-cli-valor');
  let total = 0;
  inputs.forEach(inp => { total += parseFloat(inp.value)||0; });
  const el = document.getElementById('detClienteTotal');
  if(el) el.textContent = 'R$ ' + total.toFixed(2);
}

// Salva os ajustes de valor feitos pelo admin
async function salvarValoresPorCliente(pagId){
  const p = (_colaboradorPagamentos||[]).find(x => x.id === pagId);
  if(!p){ toast('Pagamento nao encontrado','info'); return; }
  let dados = {};
  try { dados = JSON.parse(p.observacoes||'{}'); } catch(e){}
  const valorPadrao = dados.valor_por_cliente || 350;
  const overrides = {};
  document.querySelectorAll('.det-cli-valor').forEach(inp => {
    const v = parseFloat(inp.value);
    if(!isNaN(v) && Math.abs(v - valorPadrao) > 0.001){
      overrides[inp.dataset.cli] = v;
    }
  });
  dados.valores_override = overrides;
  const ids = Array.isArray(dados.clientes) ? dados.clientes : [];
  const novoTotal = ids.reduce((s, id) => s + (overrides[id] !== undefined ? overrides[id] : valorPadrao), 0);
  const temOv = Object.keys(overrides).length > 0;
  const nomesCli = (dados.clientes_nomes && Array.isArray(dados.clientes_nomes)) ? dados.clientes_nomes : [];
  const listaResumo = nomesCli.length <= 4 ? nomesCli.join(', ') : nomesCli.slice(0,3).join(', ') + ' +' + (nomesCli.length-3);
  const novaDesc = 'Gestão de ' + ids.length + ' cliente(s)' + (temOv?' (valores customizados)':'') + ' — ' + listaResumo;

  if(_supa){
    const { error } = await _supa.from('colaborador_pagamentos').update({
      observacoes: JSON.stringify(dados),
      valor: novoTotal,
      descricao: novaDesc
    }).eq('id', pagId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  p.observacoes = JSON.stringify(dados);
  p.valor = novoTotal;
  p.descricao = novaDesc;
  toast('✓ Valores atualizados · novo total R$ ' + novoTotal.toFixed(2),'success');
  document.getElementById('detClienteModal').remove();
  if(typeof renderPagamentos === 'function') renderPagamentos(document.getElementById('content'));
}

async function salvarPagamentoAndre(meuDbId, mesRef, valorPorCli){
  const checks = document.querySelectorAll('.andre-cli-check');
  const selecionados = [];
  const valoresOverride = {};
  checks.forEach(c => {
    if(c.checked){
      selecionados.push(c.dataset.cli);
      const inp = document.querySelector('.andre-cli-valor[data-cli="' + c.dataset.cli + '"]');
      if(inp){
        const v = parseFloat(inp.value);
        if(!isNaN(v) && Math.abs(v - valorPorCli) > 0.001){
          valoresOverride[c.dataset.cli] = v;
        }
      }
    }
  });
  // Total considerando overrides
  const total = selecionados.reduce((s, id) => s + (valoresOverride[id] !== undefined ? valoresOverride[id] : valorPorCli), 0);
  // Descricao detalhada com nomes
  const nomesCli = selecionados.map(id => {
    const cli = clients.find(c => c._dbId === id);
    return cli ? cli.name : '?';
  });
  const listaResumo = nomesCli.length <= 4 ? nomesCli.join(', ') : nomesCli.slice(0,3).join(', ') + ' +' + (nomesCli.length-3);
  const temOverride = Object.keys(valoresOverride).length > 0;
  const descricao = 'Gestão de ' + selecionados.length + ' cliente(s)' + (temOverride?' (valores customizados)':'') + ' — ' + listaResumo;
  const observacoes = JSON.stringify({clientes: selecionados, clientes_nomes: nomesCli, valor_por_cliente: valorPorCli, valores_override: valoresOverride});

  // Procura registro existente desse mes
  const existente = (_colaboradorPagamentos||[]).find(p =>
    p.profile_id === meuDbId && p.mes_ref === mesRef && (p.descricao||'').includes('Gestão')
  );

  if(!_supa){ toast('Banco nao conectado','info'); return; }

  if(existente){
    const { error } = await _supa.from('colaborador_pagamentos').update({
      descricao, valor: total, observacoes
    }).eq('id', existente.id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
    existente.descricao = descricao;
    existente.valor = total;
    existente.observacoes = observacoes;
    toast('✓ ' + mesRef + ' atualizado · R$ ' + total.toFixed(2),'success');
  } else {
    const payload = {
      profile_id: meuDbId,
      mes_ref: mesRef,
      descricao, valor: total,
      status_pago: false,
      observacoes
    };
    const { data, error } = await _supa.from('colaborador_pagamentos').insert(payload).select().single();
    if(error){ toast('Erro: '+error.message,'info'); return; }
    _colaboradorPagamentos.unshift(data);
    toast('✓ ' + mesRef + ' salvo · R$ ' + total.toFixed(2),'success');
  }
  renderPagamentos(document.getElementById('content'));
}

function novoPagamentoVariavelModal(presetColabId){
  if(!_supa){ toast('Banco nao conectado','info'); return; }
  const isPreset = !!presetColabId;
  const ehGestorAtual = (typeof isGestor === 'function') ? isGestor() : false;
  let modal = document.getElementById('pagVarModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'pagVarModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };
  const mesAtual = (typeof _pagFiltroMes !== 'undefined' && _pagFiltroMes) ? _pagFiltroMes : new Date().toISOString().slice(0,7);
  const hojeStr = new Date().toISOString().split('T')[0];
  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:520px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:40px;height:40px;border-radius:9px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:18px">💸</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">Novo pagamento variável</div>' +
        '<div class="text-xs text-3" style="margin-top:2px">Bônus, comissão, vale, extras...</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'pagVarModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px;display:flex;flex-direction:column;gap:12px">' +
        '<div><div class="info-label" style="margin-bottom:5px">Colaborador *</div>' +
          // Hidden input garante envio mesmo se select disabled
          (isPreset ? '<input type="hidden" id="pvColabPreset" value="' + presetColabId + '" />' : '') +
          '<select id="pvColab" class="login-input" style="background:var(--surface-2)" ' + (isPreset?'disabled':'') + '>' +
            '<option value="">— Selecione —</option>' +
            sortAlfa(team.filter(tm => tm._dbId), 'name').map(tm => '<option value="' + tm._dbId + '" ' + (presetColabId===tm._dbId?'selected':'') + '>' + tm.name + '</option>').join('') +
            // Se for preset mas o usuario nao está em team, cria a opcao
            (isPreset && !team.some(tm => tm._dbId === presetColabId) ? '<option value="' + presetColabId + '" selected>' + (function(){
              // Tenta achar nome de varias fontes
              if(_currentProfile && _currentProfile.name) return _currentProfile.name;
              if(_profilesExtras && _profilesExtras[presetColabId] && _profilesExtras[presetColabId].name) return _profilesExtras[presetColabId].name;
              if(_currentUser && _currentUser.email) return _currentUser.email.split('@')[0];
              return 'Eu';
            })() + '</option>' : '') +
          '</select>' +
          (isPreset ? '<div class="text-xs text-3" style="margin-top:4px">Voce so pode adicionar pagamento pra si mesmo</div>' : '') +
        '</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Mês de referência</div><input id="pvMes" type="month" value="' + mesAtual + '" class="login-input" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Valor (R$)</div><input id="pvValor" type="number" step="0.01" value="0" class="login-input" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Descrição *</div><input id="pvDesc" placeholder="Ex: Bônus janeiro, Comissão venda XYZ" class="login-input" style="background:var(--surface-2)" /></div>' +
        (ehGestorAtual ? (
          '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
            '<div><div class="info-label" style="margin-bottom:5px">Data pagamento</div><input id="pvData" type="date" value="" class="login-input" style="background:var(--surface-2)" /></div>' +
            '<div style="display:flex;align-items:center;justify-content:center;padding-top:24px"><label style="display:flex;align-items:center;gap:6px;font-size:13px"><input type="checkbox" id="pvPago" /> Já pago</label></div>' +
          '</div>'
        ) : (
          '<div class="text-xs text-3" style="background:var(--surface-2);padding:10px 12px;border-radius:8px;border:1px solid var(--border)">⏳ Esse pagamento ficará como <strong>pendente</strong>. Um admin/gestor vai marcar como pago após a quitação.</div>'
        )) +
        '<div><div class="info-label" style="margin-bottom:5px">Observações</div><textarea id="pvObs" rows="2" class="login-input" style="background:var(--surface-2);resize:vertical"></textarea></div>' +
      '</div>' +
      '<div style="padding:14px 22px 18px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid var(--border)">' +
        '<button class="btn" onclick="document.getElementById(\'pagVarModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" onclick="salvarPagamentoVariavel()">💾 Salvar</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function salvarPagamentoVariavel(){
  const ehGestor = isGestor();
  // Prioriza hidden input (caso select esteja disabled)
  const presetEl = document.getElementById('pvColabPreset');
  const selEl = document.getElementById('pvColab');
  const profile_id = (presetEl && presetEl.value) || (selEl ? selEl.value : '');
  console.log('[salvarPagamentoVariavel] profile_id=', profile_id, 'preset=', presetEl?.value, 'sel=', selEl?.value);
  if(!profile_id){ toast('Selecione o colaborador','info'); return; }
  const descricao = (document.getElementById('pvDesc').value||'').trim();
  if(!descricao){ toast('Informe a descrição','info'); return; }
  const valor = parseFloat(document.getElementById('pvValor').value)||0;
  const mes_ref = document.getElementById('pvMes').value;
  // Colab comum NAO ve campos de data/pago — sempre pendente sem data
  const dataEl = document.getElementById('pvData');
  const pagoEl = document.getElementById('pvPago');
  const data_pagamento = (ehGestor && dataEl) ? (dataEl.value || null) : null;
  const status_pago = (ehGestor && pagoEl) ? pagoEl.checked : false;
  const observacoes = (document.getElementById('pvObs').value||'').trim() || null;
  const payload = {profile_id, mes_ref, descricao, valor, data_pagamento, status_pago, observacoes};
  if(_supa){
    const { data, error } = await _supa.from('colaborador_pagamentos').insert(payload).select().single();
    if(error){ toast('Erro: '+error.message,'info'); return; }
    _colaboradorPagamentos.unshift(data);
  }
  document.getElementById('pagVarModal').remove();
  toast('✓ Pagamento variável adicionado','success');
  renderPagamentos(document.getElementById('content'));
}

async function marcarComoPago(id){
  const p = _colaboradorPagamentos.find(x => x.id === id);
  if(!p) return;
  const hoje = new Date().toISOString().split('T')[0];
  const dataInput = prompt('Data do pagamento (YYYY-MM-DD):', p.data_pagamento || hoje);
  if(!dataInput) return;
  if(_supa){
    const { error } = await _supa.from('colaborador_pagamentos').update({status_pago: true, data_pagamento: dataInput}).eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  p.status_pago = true;
  p.data_pagamento = dataInput;
  toast('✓ Marcado como pago em ' + dataInput,'success');
  renderPagamentos(document.getElementById('content'));
}

async function atualizarPagVarCampo(id, campo, valor){
  const p = _colaboradorPagamentos.find(x => x.id === id);
  if(!p) return;
  if(campo === 'valor') valor = parseFloat(valor)||0;
  p[campo] = valor;
  if(_supa) await _supa.from('colaborador_pagamentos').update({[campo]: valor}).eq('id', id);
  if(campo === 'valor' || campo === 'status_pago'){
    renderPagamentos(document.getElementById('content'));
  }
}

async function excluirPagamentoVariavel(id){
  if(!(await confirmDelete('pagamento'))) return;
  if(_supa){
    const { error } = await _supa.from('colaborador_pagamentos').delete().eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  _colaboradorPagamentos = _colaboradorPagamentos.filter(p => p.id !== id);
  toast('Pagamento excluido','success');
  renderPagamentos(document.getElementById('content'));
}

// Verifica se um fixo foi pago num mes especifico
function fixoFoiPagoNoMes(fixo, mes){
  if(!fixo || !mes) return false;
  try {
    const arr = JSON.parse(fixo.pagos_meses || '[]');
    return Array.isArray(arr) && arr.includes(mes);
  } catch(e){ return false; }
}

// Marca/desmarca um fixo como pago em um mes
async function toggleFixoPagoMes(fixoId, mes){
  const p = _pagamentosFixos.find(x => x.id === fixoId);
  if(!p) return;
  let arr = [];
  try { arr = JSON.parse(p.pagos_meses || '[]'); if(!Array.isArray(arr)) arr = []; } catch(e){ arr = []; }
  const idx = arr.indexOf(mes);
  if(idx >= 0) arr.splice(idx, 1); else arr.push(mes);
  p.pagos_meses = JSON.stringify(arr);
  if(_supa){
    const { error } = await _supa.from('pagamentos_fixos').update({pagos_meses: p.pagos_meses}).eq('id', fixoId);
    if(error){
      if(error.code === '42703' || (error.message||'').includes('column')){
        toast('⚠ Rode o SQL 44-fixos-pago-mes.sql no Supabase pra marcar pago','info');
      } else {
        toast('Erro: '+error.message,'info');
      }
      return;
    }
  }
  renderPagamentos(document.getElementById('content'));
}

async function atualizarPagFixoCampo(id, campo, valor){
  const p = _pagamentosFixos.find(x => x.id === id);
  if(!p) return;
  if(campo === 'valor') valor = parseFloat(valor)||0;
  p[campo] = valor;
  if(_supa) await _supa.from('pagamentos_fixos').update({[campo]: valor}).eq('id', id);
  if(campo === 'valor' || campo === 'ativo'){
    renderPagamentos(document.getElementById('content'));
  }
}

function novoPagamentoFixoModal(){
  const nome = prompt('Nome do pagamento fixo (ex: Aluguel, Notion, Salário fixo):');
  if(!nome || !nome.trim()) return;
  const valor = parseFloat(prompt('Valor mensal (R$):','0')) || 0;
  const observacoes = prompt('Observações (opcional):','') || null;
  (async () => {
    const ordem = (_pagamentosFixos||[]).length;
    const payload = {nome: nome.trim(), valor, ativo: true, observacoes, ordem};
    if(_supa){
      const { data, error } = await _supa.from('pagamentos_fixos').insert(payload).select().single();
      if(error){ toast('Erro: '+error.message,'info'); return; }
      _pagamentosFixos.push(data);
    } else {
      _pagamentosFixos.push(Object.assign({}, payload, {id:'tmp-'+Date.now()}));
    }
    toast('Pagamento fixo criado','success');
    renderPagamentos(document.getElementById('content'));
  })();
}

// ============ PERFIL COMPLETO + EQUIPE ============
function openEquipePerfil(perfilId){
  const m = team.find(t => t.id === perfilId || t._dbId === perfilId);
  if(!m){ toast('Perfil nao encontrado','info'); return; }
  goTo('equipe');
  setTimeout(() => {
    if(typeof currentPerfil !== 'undefined') currentPerfil = perfilId;
    if(typeof renderPerfilFull === 'function') renderPerfilFull(document.getElementById('content'), m);
  }, 100);
}

function renderPerfilFull(c, member){
  if(!c) c = document.getElementById('content');
  const m = member || team[0];
  if(!m){ c.innerHTML = '<div class="card text-mu">Selecione um colaborador</div>'; return; }
  const id = m.id;
  const saveFn = (campo) => "salvarPerfilCampo('" + (m._dbId||'') + "','" + campo + "',this.value)";
  const inputStyle = 'background:transparent;border:none;border-bottom:1px dashed var(--border);width:100%;font-family:inherit;font-size:13px;color:var(--text);padding:2px 0;outline:none';

  c.innerHTML =
    '<div class="page-head"><div><a onclick="goTo(\'equipe\')" style="cursor:pointer;color:var(--accent);font-size:13px">← Voltar pra Equipe</a>' +
    '<div class="page-title" style="display:flex;align-items:center;gap:12px"><div class="profile-avatar" style="background:' + (m.color||'#888') + ';width:48px;height:48px;font-size:18px">' + (m.init||'') + '</div>' + (m.name||'') + '</div>' +
    '<div class="page-sub">' + (m.role||'') + '</div></div></div>' +

    '<div class="card" style="margin-bottom:16px"><div class="card-header"><div class="card-title">👤 Informações pessoais</div>' +
      '<span class="text-xs text-3" style="font-weight:400">campos editáveis — clique e digite</span></div>' +
      '<div class="info-grid">' +
        '<div class="info-item"><div class="info-label">Nome completo</div><input value="' + (m.name||'') + '" onblur="' + saveFn('name') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Cargo</div><input value="' + (m.role||'') + '" onblur="' + saveFn('role') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Email</div><input type="email" value="' + (m.email||'') + '" onblur="' + saveFn('email') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Telefone</div><input value="' + (m.phone||'') + '" onblur="' + saveFn('phone') + '" placeholder="(99) 99999-9999" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Aniversário</div><input type="date" value="' + (m.birthday||'') + '" onblur="' + saveFn('birthday') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Tipo de doc</div><select onchange="' + saveFn('cpf_type') + '" style="' + inputStyle + '"><option value="cpf" ' + (m.cpf_type==='cpf'||!m.cpf_type?'selected':'') + '>CPF</option><option value="cnpj" ' + (m.cpf_type==='cnpj'?'selected':'') + '>CNPJ</option></select></div>' +
        '<div class="info-item"><div class="info-label">' + (m.cpf_type==='cnpj'?'CNPJ':'CPF') + '</div><input value="' + (m.cpf||'') + '" onblur="' + saveFn('cpf') + '" placeholder="' + (m.cpf_type==='cnpj'?'00.000.000/0000-00':'000.000.000-00') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Chave PIX</div><input value="' + (m.pix_key||'') + '" onblur="' + saveFn('pix_key') + '" placeholder="email, telefone ou chave aleatória" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Salário base (R$)</div><input type="number" step="0.01" value="' + (m.salary||0) + '" onblur="' + saveFn('salary') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Forças / Skills</div><input value="' + (m.strengths||'') + '" onblur="' + saveFn('strengths') + '" placeholder="Ex: Criatividade, prazo" style="' + inputStyle + '" /></div>' +
      '</div>' +
    '</div>' +

    '<div class="card" style="margin-bottom:16px"><div class="card-header"><div class="card-title">🏖 Status</div></div>' +
      '<div class="info-grid">' +
        '<div class="info-item"><div class="info-label">Tem direito a férias?</div><select onchange="' + saveFn('vacation_eligible') + '" style="' + inputStyle + '"><option value="true" ' + (m.vacation_eligible!==false?'selected':'') + '>Sim</option><option value="false" ' + (m.vacation_eligible===false?'selected':'') + '>Não</option></select></div>' +
        '<div class="info-item"><div class="info-label">Dias de férias por ano</div><input type="number" value="' + (m.vacation_total||30) + '" onblur="' + saveFn('vacation_total') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Dias usados (' + new Date().getFullYear() + ')</div><input type="number" value="' + (m.vacation_used||0) + '" onblur="' + saveFn('vacation_used') + '" style="' + inputStyle + '" /></div>' +
        '<div class="info-item"><div class="info-label">Pode ver valores financeiros</div><select onchange="' + saveFn('can_see_values') + '" style="' + inputStyle + '"><option value="false" ' + (!m.can_see_values?'selected':'') + '>Não</option><option value="true" ' + (m.can_see_values?'selected':'') + '>Sim</option></select></div>' +
      '</div>' +
    '</div>' +

    '<div class="card"><div class="card-header"><div class="card-title">📊 Resumo</div></div>' +
      '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr))">' +
        '<div class="stat-card"><div class="stat-value">' + (m.vacation_total||30) + '</div><div class="stat-label">Dias férias/ano</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + (m.vacation_used||0) + '</div><div class="stat-label">Usados ' + new Date().getFullYear() + '</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + ((m.vacation_total||30) - (m.vacation_used||0)) + '</div><div class="stat-label">Disponível</div></div>' +
      '</div>' +
    '</div>';
}

async function salvarPerfilCampo(dbId, campo, valor){
  if(!dbId){ toast('Perfil sem ID no banco','info'); return; }
  // Coerções
  if(campo === 'vacation_total' || campo === 'vacation_used'){ valor = parseInt(valor)||0; }
  if(campo === 'salary'){ valor = parseFloat(valor)||0; }
  if(campo === 'vacation_eligible' || campo === 'can_see_values'){ valor = valor === 'true' || valor === true; }
  if(_supa){
    const { error } = await _supa.from('profiles').update({[campo]: valor}).eq('id', dbId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  // Atualiza local
  const m = team.find(t => t._dbId === dbId);
  if(m) m[campo] = valor;
  toast('✓ Salvo','success');
}

// ============ v2.61: PLANO NAO PULA ABA AO MARCAR SERVICO ============
function _refreshPanePlano(cli){
  try {
    const pane = document.querySelector('.modal-pane[data-pane="plano"]');
    if(!pane){
      setTimeout(() => {
        try {
          if(typeof openClient === 'function') openClient(cli.id);
          setTimeout(() => {
            const t = document.querySelector('.modal-tab[data-tab="plano"]');
            if(t) t.click();
          }, 80);
        } catch(e){}
      }, 30);
      return;
    }
    const eraAtivo = pane.classList.contains('active');
    const tmp = document.createElement('div');
    if(typeof paneFinanceiro === 'function'){
      tmp.innerHTML = paneFinanceiro(cli);
      const novoWrapper = tmp.querySelector('.modal-pane[data-pane=\"plano\"]');
      if(novoWrapper){
        pane.innerHTML = novoWrapper.innerHTML;
        if(eraAtivo) pane.classList.add('active');
      }
    }
  } catch(e){ console.warn('refreshPanePlano falhou:', e); }
}

// Sobreescreve handlers de servico pra usar _refreshPanePlano em vez de openClient (que reabre na Visao)
window.toggleServicoCliente = async function(cliId, servico){
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  const list = Array.isArray(cli.services_list) ? cli.services_list.slice() : [];
  const idx = list.indexOf(servico);
  if(idx >= 0) list.splice(idx, 1); else list.push(servico);
  cli.services_list = list;
  if(typeof updateClientField === 'function') await updateClientField(cliId, 'services_list', list);
  _refreshPanePlano(cli);
};

window.adicionarServicoCustom = async function(cliId){
  const nome = prompt('Nome do servico custom:');
  if(!nome || !nome.trim()) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  const list = Array.isArray(cli.services_list) ? cli.services_list.slice() : [];
  if(list.includes(nome.trim())){ toast('Esse servico ja esta na lista','info'); return; }
  list.push(nome.trim());
  cli.services_list = list;
  if(typeof updateClientField === 'function') await updateClientField(cliId, 'services_list', list);
  _refreshPanePlano(cli);
};

window.removerServicoCliente = async function(cliId, servico){
  if(!(await confirmDelete('serviço: ' + servico))) return;
  const cli = clients.find(c => c.id === cliId);
  if(!cli) return;
  const list = (cli.services_list || []).filter(s => s !== servico);
  cli.services_list = list;
  if(typeof updateClientField === 'function') await updateClientField(cliId, 'services_list', list);
  _refreshPanePlano(cli);
};

// ============ v2.62-2.63: DESTAQUE VERMELHO CONTINUO + BANNER COM LISTA ============
// Sobreescreve goToCronCli pra adicionar borda vermelha pulsante
const _origGoToCronCli = typeof goToCronCli === 'function' ? goToCronCli : null;
window.goToCronCli = function(clientId, month){
  if(typeof cronMonth !== 'undefined') cronMonth = month;
  goTo('cronograma');
  setTimeout(() => {
    const row = document.getElementById('cron-row-'+clientId);
    if(row){
      document.querySelectorAll('.highlight-pulse').forEach(el => el.classList.remove('highlight-pulse'));
      row.scrollIntoView({behavior:'smooth',block:'center'});
      row.classList.add('highlight-pulse');
      setTimeout(() => row.classList.remove('highlight-pulse'), 7000);
    } else {
      if(typeof toast === 'function') toast('Cliente nao visivel no mes atual','warning');
    }
  }, 250);
};

// Modal com lista detalhada de prazos (quando tem mais de 1 e o user quer ver todos)
window.showDeadlineDetails = function(range){
  const alerts = (typeof getDeadlineAlerts === 'function') ? getDeadlineAlerts({range: range==='today'?'today':'soon'}) : [];
  if(!alerts.length){ toast('Nenhum prazo encontrado','info'); return; }
  const titulo = range==='today' ? '🚨 Prazos vencendo HOJE' : '⏰ Prazos próximos';
  if(typeof closeAlertModal === 'function') closeAlertModal();
  const wrap = document.createElement('div');
  wrap.className = 'alert-modal open';
  wrap.id = 'alertModal';
  wrap.onclick = (ev) => { if(ev.target === wrap) wrap.remove(); };
  wrap.innerHTML =
    '<div class="alert-modal-box">' +
      '<div class="alert-modal-head">' +
        '<div class="alert-modal-ico ' + (range==='today'?'urgent':'') + '">' + (range==='today'?'🚨':'⏰') + '</div>' +
        '<div style="flex:1"><div style="font-size:15px;font-weight:700;letter-spacing:-.01em">' + titulo + '</div>' +
        '<div class="text-xs text-3">' + alerts.length + ' prazo(s) — clique pra ir direto</div></div>' +
        '<button class="modal-close" onclick="this.closest(\'.alert-modal\').remove()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>' +
      '</div>' +
      '<div class="alert-modal-body">' +
        alerts.map(a => '<div class="alert-item" onclick="this.closest(\'.alert-modal\').remove();goToCronCli(' + a.client.id + ',' + a.month + ')">' +
          '<div class="cron-cli-logo" style="background:' + (a.client.color||'#888') + ';width:36px;height:36px;font-size:12px">' + (a.client.init || (a.client.name||'').slice(0,2).toUpperCase()) + '</div>' +
          '<div style="flex:1"><div style="font-size:13px;font-weight:600">' + (a.client.name||'(sem nome)') + '</div>' +
          '<div class="text-xs text-3">Mes ' + a.month + ' · ' + (a.data.produced||0) + '/' + (a.data.target||0) + ' conteudos · prazo ' + (a.data.deadline||'') + '</div></div>' +
          '<span class="badge ' + (a.diff===0?'b-danger':a.diff<0?'b-danger':'b-warning') + '">' + (a.diff===0?'HOJE':a.diff===1?'amanha':a.diff<0?Math.abs(a.diff)+'d atrasado':'em '+a.diff+'d') + '</span>' +
        '</div>').join('') +
      '</div>' +
    '</div>';
  document.body.appendChild(wrap);
};

// Sobreescreve renderDeadlineBanner pra abrir lista quando mais de 1 prazo
window.renderDeadlineBanner = function(){
  const alerts = (typeof getDeadlineAlerts === 'function') ? getDeadlineAlerts() : [];
  if(alerts.length===0) return '';
  const urgent = alerts.filter(a => a.diff===0);
  const tomorrow = alerts.filter(a => a.diff===1);
  const urgClick = urgent.length === 1
    ? "goToCronCli(" + (urgent[0]&&urgent[0].client&&urgent[0].client.id) + "," + (urgent[0]&&urgent[0].month) + ")"
    : "showDeadlineDetails('today')";
  const tomClick = tomorrow.length === 1
    ? "goToCronCli(" + (tomorrow[0]&&tomorrow[0].client&&tomorrow[0].client.id) + "," + (tomorrow[0]&&tomorrow[0].month) + ")"
    : "showDeadlineDetails('soon')";
  return (urgent.length ? '<div class="deadline-banner urgent" onclick="' + urgClick + '"><span class="db-ico">🚨</span><div class="db-text"><strong>' + urgent.length + ' prazo(s) HOJE</strong> — ' + urgent.map(a => a.client.name).slice(0,2).join(', ') + (urgent.length>2?' +'+(urgent.length-2):'') + '</div><span class="db-go">' + (urgent.length>1?'Ver lista':'Ver') + ' →</span></div>' : '') +
         (tomorrow.length ? '<div class="deadline-banner" onclick="' + tomClick + '"><span class="db-ico">⏰</span><div class="db-text"><strong>' + tomorrow.length + ' prazo(s) amanha</strong> — ' + tomorrow.map(a => a.client.name).slice(0,2).join(', ') + (tomorrow.length>2?' +'+(tomorrow.length-2):'') + '</div><span class="db-go">' + (tomorrow.length>1?'Ver lista':'Ver') + ' →</span></div>' : '');
};

// ============ v2.64: EDITAR ITEM DO CHECKLIST CLICANDO ============
window.openEditarTarefaModal = function(collab, idx){
  const item = (dailyChecklists[collab] || [])[idx];
  if(!item){ toast('Tarefa nao encontrada','info'); return; }

  let cliDbId = '';

  if(item.client && item.client !== 'Geral'){
    const cli = clients.find(c => c.name === item.client);
    if(cli) cliDbId = cli._dbId || '';
  }
  let assDbId = '';
  const mem = team.find(t => t.name === collab || t.name.split(' ')[0] === collab);
  if(mem && mem._dbId) assDbId = mem._dbId;

  const titulo = (item.t||'').replace(/"/g,'&quot;');
  const horario = item.time || '09:00';
  const prio = item.p || 'med';
  const dbId = item._dbId || '';

  const mod = document.getElementById('clientModal');
  if(!mod){ toast('Modal nao disponivel','info'); return; }
  mod.innerHTML =
    '<div class="modal-head">' +
      '<div style="width:40px;height:40px;border-radius:10px;background:var(--warning);color:var(--surface);display:grid;place-items:center;font-weight:700">✎</div>' +
      '<div style="flex:1"><div style="font-size:17px;font-weight:700">Editar tarefa</div><div class="text-xs text-3" style="margin-top:2px">de ' + escapeHtml(collab) + '</div></div>' +
      '<button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>' +
    '</div>' +
    '<div class="modal-body">' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">' +
        '<div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Titulo *</div><input id="edtkTitle" class="login-input" value="' + titulo + '" autofocus style="background:var(--surface-2)" /></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Responsavel</div><select id="edtkAss" class="login-input" style="background:var(--surface-2)"><option value="">— ninguem —</option>' + team.map(t => '<option value="' + (t._dbId||'') + '" ' + (assDbId===t._dbId?'selected':'') + '>' + t.name + '</option>').join('') + '</select></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Cliente</div><select id="edtkCli" class="login-input" style="background:var(--surface-2)"><option value="">Geral / Interno</option>' + clients.map(c => '<option value="' + c._dbId + '" ' + (cliDbId===c._dbId?'selected':'') + '>' + c.name + '</option>').join('') + '</select></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Prioridade</div><select id="edtkPrio" class="login-input" style="background:var(--surface-2)"><option value="urgent" ' + (prio==='urgent'?'selected':'') + '>🔴 Urgente</option><option value="high" ' + (prio==='high'?'selected':'') + '>🟠 Alta</option><option value="med" ' + (prio==='med'?'selected':'') + '>🔵 Media</option><option value="low" ' + (prio==='low'?'selected':'') + '>⚪ Baixa</option></select></div>' +
