      <div class="quick" onclick="openLinksManager('tools-googleads','🔍 Google Ads','https://ads.google.com')"><div class="quick-icon" style="background:#fdecec;color:#b42424;font-size:22px">🔍</div><div><div class="quick-title">Google Ads</div><div class="quick-sub">Campanhas</div></div></div>
      <div class="quick" onclick="openLinksManager('tools-tiktok','🎵 TikTok Business','https://www.tiktok.com/business')"><div class="quick-icon" style="background:#f0f0f3;color:#1d1d1f;font-size:22px">🎵</div><div><div class="quick-title">TikTok Business</div><div class="quick-sub">Conteúdo + ads</div></div></div>
      <div class="quick" onclick="openLinksManager('tools-trends','📈 Google Trends','https://trends.google.com')"><div class="quick-icon" style="background:#e6f7ec;color:#1a7335;font-size:22px">📈</div><div><div class="quick-title">Google Trends</div><div class="quick-sub">Tendências</div></div></div>
