            <input id="capMaterialUrl" class="login-input" placeholder="https://drive.google.com/... ou WeTransfer" value="${escapeHtml(c.material_url||'')}" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:4px">Link de referências (moodboard, exemplos)</div>
            <input id="capRefUrl" class="login-input" placeholder="https://..." value="${escapeHtml(c.referencia_url||'')}" style="background:var(--surface-2)" />
