// confirmDelete: modal de confirmacao que exige digitar "apagar"
// Retorna Promise<boolean>. true = confirmou, false = cancelou.
function confirmDelete(itemDesc, opts){
  opts = opts || {};
  return new Promise((resolve) => {
    let modal = document.getElementById('confirmDeleteModal');
    if(modal) modal.remove();
    modal = document.createElement('div');
    modal.id = 'confirmDeleteModal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:99999;display:flex;align-items:center;justify-content:center;padding:18px';
    const onCancel = () => { try { modal.remove(); } catch(e){} resolve(false); };
    modal.onclick = (e) => { if(e.target === modal) onCancel(); };

    const titulo = opts.titulo || 'Confirmar exclusão';
    const aviso = opts.aviso || 'Essa ação <strong>não pode ser desfeita</strong>.';
    const item = (itemDesc || 'este item').toString();
    const esc = (s) => (s+'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

    modal.innerHTML =
      '<div style="background:var(--surface);border-radius:14px;max-width:460px;width:100%;padding:24px;box-shadow:0 24px 60px rgba(0,0,0,.5);border-top:4px solid var(--danger)">' +
        '<div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">' +
          '<div style="width:44px;height:44px;border-radius:50%;background:rgba(239,68,68,.15);display:grid;place-items:center;font-size:24px">🗑️</div>' +
          '<div><div style="font-size:17px;font-weight:700;color:var(--text)">' + esc(titulo) + '</div></div>' +
        '</div>' +
        '<div style="font-size:13.5px;color:var(--text-2);margin-bottom:14px;line-height:1.55">' +
          'Você está prestes a apagar: <strong style="color:var(--text)">' + esc(item) + '</strong>.<br>' + aviso + '<br><br>' +
          'Para confirmar, digite <strong style="color:var(--danger);font-family:monospace;background:rgba(239,68,68,.1);padding:2px 8px;border-radius:4px">apagar</strong> abaixo:' +
        '</div>' +
        '<input id="cdInput" class="login-input" placeholder="Digite apagar" autocomplete="off" style="background:var(--surface-2);border:2px solid var(--border);font-family:inherit;font-size:14px;text-align:center;letter-spacing:.05em" />' +
        '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:18px">' +
          '<button class="btn" id="cdCancel" type="button">Cancelar</button>' +
          '<button class="btn" id="cdOk" type="button" disabled style="background:var(--danger);color:#fff;border-color:var(--danger);opacity:.4;cursor:not-allowed">🗑 Apagar</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(modal);

    const inp = document.getElementById('cdInput');
    const btnOk = document.getElementById('cdOk');
    const btnCancel = document.getElementById('cdCancel');
    setTimeout(() => inp && inp.focus(), 50);

    btnCancel.onclick = onCancel;
    btnOk.onclick = () => {
      if(btnOk.disabled) return;
      try { modal.remove(); } catch(e){}
      resolve(true);
    };
    inp.addEventListener('input', () => {
      const ok = (inp.value || '').trim().toLowerCase() === 'apagar';
      btnOk.disabled = !ok;
      btnOk.style.opacity = ok ? '1' : '.4';
      btnOk.style.cursor = ok ? 'pointer' : 'not-allowed';
    });
    inp.addEventListener('keydown', (e) => {
      if(e.key === 'Enter' && !btnOk.disabled){ e.preventDefault(); btnOk.click(); }
      if(e.key === 'Escape'){ onCancel(); }
    });
  });
}
window.confirmDelete = confirmDelete;

// sortControl: gera HTML de select padrao de ordenacao
// usado em listas. Define window._sortBy_KEY = valor e re-renderiza
function sortControl(stateKey, options, currentValue, onChangeFn){
  const opts = options || [
    {v:'alfa', label:'A → Z'},
    {v:'alfa_desc', label:'Z → A'},
    {v:'date_desc', label:'Mais recentes'},
    {v:'date_asc', label:'Mais antigos'}
  ];
  const cur = currentValue || opts[0].v;
  return '<select onchange="window[\'' + stateKey + '\']=this.value;' + onChangeFn + '" class="login-input" style="background:var(--surface-2);width:auto;min-width:140px;font-size:12.5px" title="Ordenar">' +
    opts.map(o => '<option value="' + o.v + '" ' + (cur===o.v?'selected':'') + '>↕ ' + o.label + '</option>').join('') +
    '</select>';
}
window.sortControl = sortControl;

// Aplica ordenacao a um array de objetos
function aplicarOrdenacao(arr, modo, nomeKey, dataKey){
  if(!Array.isArray(arr)) return arr;
  const copy = arr.slice();
  const _getName = (o) => (nomeKey ? (o[nomeKey]||'') : (o.name||o.titulo||o.nome||'')) + '';
  const _getDate = (o) => (dataKey ? (o[dataKey]||'') : (o.created_at||o.data||o.data_criacao||o.date||'')) + '';
  switch(modo){
    case 'alfa':
      return copy.sort((a,b) => _getName(a).localeCompare(_getName(b), 'pt-BR', {sensitivity:'base'}));
    case 'alfa_desc':
      return copy.sort((a,b) => _getName(b).localeCompare(_getName(a), 'pt-BR', {sensitivity:'base'}));
    case 'date_desc':
      return copy.sort((a,b) => _getDate(b).localeCompare(_getDate(a)));
    case 'date_asc':
      return copy.sort((a,b) => _getDate(a).localeCompare(_getDate(b)));
    default:
      return copy;
  }
}
window.aplicarOrdenacao = aplicarOrdenacao;

