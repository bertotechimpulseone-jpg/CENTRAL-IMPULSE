// Lista de colaboradores excluidos (persistido no SUPABASE + localStorage fallback)
let _colabExcluidosCache = null;  // cache em memoria

async function _loadColabExcluidos(){
  if(_supa){
    try {
      const { data, error } = await _supa.from('colaboradores_excluidos').select('nome_normalizado, nome_original');
      if(!error && data){
        _colabExcluidosCache = data.map(d => d.nome_normalizado);
        // Tambem grava no localStorage como cache rapido
        try { localStorage.setItem('colaboradoresExcluidos', JSON.stringify(_colabExcluidosCache)); } catch(e){}
        console.log('[excluidos] carregados do banco:', _colabExcluidosCache.length);
        return _colabExcluidosCache;
      }
    } catch(e){ console.warn('[excluidos] erro ao carregar do banco, usando localStorage', e); }
  }
  // Fallback localStorage
  try {
    const raw = localStorage.getItem('colaboradoresExcluidos');
    _colabExcluidosCache = raw ? JSON.parse(raw) : [];
  } catch(e){ _colabExcluidosCache = []; }
  return _colabExcluidosCache;
}

function _getColabExcluidos(){
  if(_colabExcluidosCache) return _colabExcluidosCache;
  // Lazy load sincrono do localStorage (banco vai sobrescrever depois)
  try {
    const raw = localStorage.getItem('colaboradoresExcluidos');
    _colabExcluidosCache = raw ? JSON.parse(raw) : [];
  } catch(e){ _colabExcluidosCache = []; }
  return _colabExcluidosCache;
}

async function _addColabExcluido(nome, dbId){
  const chave = (dbId || nome || '').toLowerCase().trim();
  if(!chave) return;
  const lista = _getColabExcluidos();
  if(!lista.includes(chave)) lista.push(chave);
  _colabExcluidosCache = lista;
  try { localStorage.setItem('colaboradoresExcluidos', JSON.stringify(lista)); } catch(e){}
  // Salva no banco tambem
  if(_supa){
    try {
      const payload = {nome_normalizado: chave, nome_original: nome || null, profile_dbid: dbId || null};
      if(_currentProfile && _currentProfile.id) payload.excluido_por = _currentProfile.id;
      const { error } = await _supa.from('colaboradores_excluidos').upsert(payload, {onConflict: 'nome_normalizado'});
      if(error){
        console.warn('[excluidos] erro ao salvar no banco:', error);
        if(error.code === '42P01' || (error.message||'').includes('does not exist')){
          toast('⚠ Rode o SQL 43-colaboradores-excluidos.sql no Supabase pra exclusao funcionar entre dispositivos','info');
        }
      } else {
        console.log('[excluidos] ✓ salvo no banco:', chave);
      }
    } catch(e){ console.warn('[excluidos] excecao banco', e); }
  }
}

async function _removeColabExcluido(nome, dbId){
  const chaves = [(dbId||'').toLowerCase().trim(), (nome||'').toLowerCase().trim()].filter(Boolean);
  const lista = _getColabExcluidos();
  _colabExcluidosCache = lista.filter(x => !chaves.includes(x));
  try { localStorage.setItem('colaboradoresExcluidos', JSON.stringify(_colabExcluidosCache)); } catch(e){}
  if(_supa){
    try {
      for(const c of chaves){
        await _supa.from('colaboradores_excluidos').delete().eq('nome_normalizado', c);
      }
    } catch(e){ console.warn('[excluidos] erro ao remover do banco', e); }
  }
}

function _estaExcluido(nome, dbId){
  const lista = _getColabExcluidos();
  const chaves = [(dbId||'').toLowerCase().trim(), (nome||'').toLowerCase().trim()].filter(Boolean);
  return chaves.some(c => lista.includes(c));
}

