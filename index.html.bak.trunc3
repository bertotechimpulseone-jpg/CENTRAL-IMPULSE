    {v:'whatsapp', i:'💚', l:'WhatsApp'},
    {v:'ligacao', i:'📞', l:'Ligação'},
    {v:'reuniao', i:'📹', l:'Reunião'},
    {v:'email', i:'📧', l:'Email'},
    {v:'presencial', i:'🤝', l:'Presencial'},
    {v:'feedback', i:'⭐', l:'Feedback'},
    {v:'suporte', i:'🔧', l:'Suporte'},
    {v:'aprovacao', i:'✓', l:'Aprovação'}
  ];
  let modal = document.getElementById('relacModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
