                <div style="position:absolute;top:8px;right:8px;display:flex;gap:6px">
                  <button onclick="document.getElementById('antesPrintInput').click()" style="background:rgba(0,0,0,.7);color:#fff;border:none;padding:6px 10px;border-radius:6px;font-size:11px;cursor:pointer;font-weight:600">📷 Trocar</button>
                  <button onclick="salvarAntesField(${cli.id},'print_url',null)" style="background:rgba(239,68,68,.9);color:#fff;border:none;padding:6px 10px;border-radius:6px;font-size:11px;cursor:pointer;font-weight:600">🗑 Remover</button>
                </div>
              </div>`
            : `<div onclick="document.getElementById('antesPrintInput').click()" style="border:2px dashed var(--border-strong);border-radius:12px;padding:40px 20px;text-align:center;cursor:pointer;background:var(--surface-2);transition:.15s" onmouseover="this.style.borderColor='var(--accent)';this.style.background='var(--surface)'" onmouseout="this.style.borderColor='var(--border-strong)';this.style.background='var(--surface-2)'">
