        <div class="section-title">📸 Nosso profissional (quem vai gravar)</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div>
            <div class="info-label" style="margin-bottom:4px">Nome</div>
            <select id="capRespNome" class="login-input" style="background:var(--surface-2);font-family:inherit" onchange="autoPreencherTelefoneResp(this.value)"><option value="">— Selecione —</option>${['Gabriel','Yas','Vini'].map(n=>`<option value="${n}" ${(c.responsavel_nome||'')===n || ((c.responsavel_nome||'')==='Gael' && n==='Gabriel')?'selected':''}>${n}</option>`).join('')}</select>
            <datalist id="capRespList">${['Gabriel','Gael','Yas','Vini','Vinicius','Vinicius (Founder)','Vini (Founder)'].filter((v,i,a)=>a.indexOf(v)===i).map(n=>`<option value="${n}"></option>`).join('')}</datalist>
            <button type="button" onclick="abrirCadastroResponsavelRapido()" style="margin-top:5px;font-size:11px;color:var(--accent);background:none;border:none;cursor:pointer;padding:0;text-decoration:underline">+ Cadastrar/editar telefone dos responsáveis</button>
          </div>
          <div>
            <div class="info-label" style="margin-bottom:4px">Telefone (WhatsApp)</div>
            <input id="capRespTel" class="login-input" placeholder="Ex: 5511999998888" value="${escapeHtml(c.responsavel_telefone||'')}" style="background:var(--surface-2)" />
          </div>
        </div>

        <!-- ============ CONTATO LOCAL ============ -->
        <div class="section-title">👤 Contato no local (quem vai receber)</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div>
            <div class="info-label" style="margin-bottom:4px">Nome</div>
            <input id="capContNome" class="login-input" placeholder="Pessoa que recebe a equipe" value="${escapeHtml(c.contato_local_nome||'')}" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:4px">Telefone (WhatsApp)</div>
            <input id="capContTel" class="login-input" placeholder="Ex: 5511988887777" value="${escapeHtml(c.contato_local_telefone||'')}" style="background:var(--surface-2)" />
          </div>
        </div>

        <!-- ============ BRIEFING ============ -->
        <div class="section-title">📝 Briefing</div>
        <textarea id="capBrief" class="login-input" rows="4" placeholder="Detalhes da captação, ângulos, mensagens-chave, equipamentos..." style="background:var(--surface-2);resize:vertical;min-height:90px;width:100%">${escapeHtml(c.brief||'')}</textarea>
        <div style="margin-top:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <label class="btn btn-sm" style="cursor:pointer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;margin-right:4px"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            ${c.briefing_arquivo_url?'Trocar anexo':'Anexar briefing (PDF, DOC, imagem)'}
            <input type="file" id="capBriefFile" accept="application/pdf,image/*,.doc,.docx" onchange="capUploadBriefing(this)" style="display:none" />
          </label>
          <span id="capBriefFileName" class="text-xs text-3">${c.briefing_arquivo_nome?'📎 '+c.briefing_arquivo_nome:'nenhum anexo'}</span>
          ${c.briefing_arquivo_url?`<button type="button" class="btn btn-sm" onclick="openLink('${c.briefing_arquivo_url}')">👁 Ver anexo</button>`:''}
        </div>
        <input type="hidden" id="capBriefUrl" value="${escapeHtml(c.briefing_arquivo_url||'')}" />
        <input type="hidden" id="capBriefName" value="${escapeHtml(c.briefing_arquivo_nome||'')}" />

