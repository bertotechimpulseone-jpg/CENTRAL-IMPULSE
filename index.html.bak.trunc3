let equipeView = 'lista'; // lista | ponto | perfil
let perfilId = 0;
let pontoAuth = false;
let pontoUser = null;
let pontoToday = {entrada:null,intervaloIn:null,intervaloOut:null,saida:null};

// ============ MODAL: NOVO COLABORADOR ============
function openNovoColaboradorModal(){
  const old = document.getElementById('novoColabModal');
  if(old) old.remove();
  const cores = ['#0ea5e9','#7c3aed','#ec4899','#f59e0b','#10b981','#ef4444','#06b6d4','#a855f7','#f97316','#3b82f6','#84cc16','#14b8a6','#8b5cf6'];
  const bg = document.createElement('div');
  bg.id = 'novoColabModal';
  bg.className = 'modal-bg open';
  bg.style.zIndex = '10000';
  bg.innerHTML = `
    <div class="modal" style="max-width:560px">
      <div class="modal-head">
        <div style="width:42px;height:42px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700;font-size:18px">👤</div>
        <div style="flex:1">
          <div style="font-size:16px;font-weight:700">Novo colaborador</div>
          <div class="text-xs text-3" style="margin-top:2px">Cadastra na equipe e cria o perfil no Supabase</div>
        </div>
        <button class="modal-close" onclick="document.getElementById('novoColabModal').remove()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding:20px;max-height:75vh;overflow-y:auto">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div style="grid-column:span 2">
            <div class="info-label" style="margin-bottom:5px">Nome completo *</div>
            <input id="ncolName" class="login-input" placeholder="Ex: João Silva" autofocus style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Cargo / função *</div>
            <input id="ncolRole" class="login-input" placeholder="Ex: Social Media" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Cor do avatar</div>
            <div id="ncolColorPick" style="display:flex;gap:5px;flex-wrap:wrap;padding:7px 0">
              ${cores.map((c,i)=>`<button type="button" class="ncol-color ${i===0?'sel':''}" data-color="${c}" style="width:26px;height:26px;border-radius:7px;background:${c};border:2px solid transparent;cursor:pointer" onclick="document.querySelectorAll('.ncol-color').forEach(b=>b.classList.remove('sel'));this.classList.add('sel')"></button>`).join('')}
            </div>
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">E-mail (login)</div>
            <input id="ncolEmail" class="login-input" placeholder="primeironome@impulseone.com.br" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Telefone (WhatsApp)</div>
            <input id="ncolPhone" class="login-input" placeholder="5511999998888" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">CPF (opcional)</div>
            <input id="ncolCpf" class="login-input" placeholder="000.000.000-00" style="background:var(--surface-2)" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Data admissão</div>
            <input id="ncolSince" type="date" class="login-input" value="${new Date().toISOString().split('T')[0]}" style="background:var(--surface-2);width:100%" />
          </div>
          <div>
            <div class="info-label" style="margin-bottom:5px">Salário (R$)</div>
            <input id="ncolSalary" type="number" min="0" step="100" class="login-input" placeholder="0" style="background:var(--surface-2)" />
          </div>
          <div style="grid-column:span 2;background:var(--surface-2);border-radius:9px;padding:11px 13px;border:1px solid var(--border)">
            <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
              <input type="checkbox" id="ncolCreateLogin" checked style="width:16px;height:16px;cursor:pointer" />
              <div style="flex:1">
                <div style="font-size:13px;font-weight:600">🔐 Criar login automaticamente</div>
                <div class="text-xs text-3" style="margin-top:2px">Email padrão: primeironome@impulseone.com.br · Senha: impulse2026</div>
              </div>
            </label>
          </div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:22px">
          <button class="btn" onclick="document.getElementById('novoColabModal').remove()">Cancelar</button>
          <button class="btn btn-primary" onclick="salvarNovoColaborador()" id="ncolSaveBtn">➕ Criar colaborador</button>
        </div>
      </div>
    </div>
  `;
  bg.addEventListener('click', e => { if(e.target===bg) bg.remove(); });
  document.body.appendChild(bg);
  // Adiciona estilo para .ncol-color.sel
  if(!document.getElementById('ncolColorStyle')){
    const s = document.createElement('style');
    s.id = 'ncolColorStyle';
    s.textContent = '.ncol-color.sel{border-color:var(--text) !important;box-shadow:0 0 0 2px var(--surface) inset}';
    document.head.appendChild(s);
  }
  // Auto-gera email ao digitar nome
  setTimeout(()=>{
    const nameInp = document.getElementById('ncolName');
    const emailInp = document.getElementById('ncolEmail');
    nameInp.addEventListener('input', ()=>{
      if(emailInp.value && emailInp.dataset.touched) return;
      const first = nameInp.value.trim().split(/\s+/)[0].toLowerCase()
        .normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z]/g,'');
      if(first) emailInp.value = first + '@impulseone.com.br';
    });
    emailInp.addEventListener('input', ()=>{ emailInp.dataset.touched = '1'; });
  }, 50);
}

async function salvarNovoColaborador(){
  const name = document.getElementById('ncolName').value.trim();
  const role = document.getElementById('ncolRole').value.trim();
  if(!name){ toast('Informe o nome','info'); return; }
  if(!role){ toast('Informe o cargo','info'); return; }
  if(!_supa){ toast('Supabase necessário','info'); return; }
  const email = document.getElementById('ncolEmail').value.trim().toLowerCase();
  const phone = document.getElementById('ncolPhone').value.replace(/\D/g,'');
  const cpf = document.getElementById('ncolCpf').value.trim();
  const since = document.getElementById('ncolSince').value;
  const salary = parseFloat(document.getElementById('ncolSalary').value) || 0;
  const colorBtn = document.querySelector('.ncol-color.sel');
  const cor = colorBtn ? colorBtn.dataset.color : '#7c3aed';
  const init = name.trim().charAt(0).toUpperCase();
  const createLogin = document.getElementById('ncolCreateLogin').checked;

  const btn = document.getElementById('ncolSaveBtn');
  btn.disabled = true;
  btn.innerHTML = '⏳ Criando...';

  try {
    // 1. Cria profile no banco
    const payload = {
      full_name: name,
      position: role,
      email: email || null,
      phone: phone || null,
      cpf: cpf || null,
      contract_start: since || null,
      salary: salary || 0,
      vacation_total: 30,
      vacation_used: 0,
      role: 'member'
    };
    const { data: created, error: insErr } = await _supa.from('profiles').insert(payload).select().single();
    if(insErr) throw insErr;

    toast('✓ Perfil criado no banco','success');

    // 2. Adiciona ao team local em memória
    team.push({
      name, role, init, color: cor,
      tasks: 0, prod: 0, hours: 0, salary,
      cpf, since, vacationDays: 30, vacationUsed: 0,
      phone, email,
      _dbId: created.id
    });

    // 3. Cria login no Auth (se marcado)
    if(createLogin && email){
      try {
        const senha = 'impulse2026';
        const { data: signData, error: signErr } = await _supa.auth.signUp({email, password: senha});
        if(signErr){
          if(signErr.message && signErr.message.includes('already')){
            toast(`⚠ Login não criado: email já existe`, 'info');
          } else {
            toast(`Perfil OK, mas login falhou: ${signErr.message}`, 'info');
          }
        } else {
          // Vincula auth_user_id no profile
          await _supa.from('profiles').update({
            auth_user_id: signData.user?.id,
            stored_password_hint: senha
          }).eq('id', created.id);
          toast(`✓ Login criado: ${email} / ${senha}`, 'success');
        }
      } catch(eAuth){
        console.error('[login]', eAuth);
        toast('Perfil criado, login falhou: '+eAuth.message, 'info');
      }
    }

    document.getElementById('novoColabModal').remove();
    await loadDataFromSupabase();
    renderEquipe(document.getElementById('content'));
  } catch(e){
    btn.disabled = false;
    btn.innerHTML = '➕ Criar colaborador';
    console.error('[salvarNovoColaborador]', e);
    toast('Erro: '+(e.message||e),'info');
  }
}

// EXCLUIR colaborador (DELETE total no banco)
async function excluirColaborador(profileDbIdOrIdx){
  if(!isGestor()){ toast('🔒 Apenas admin/gestor pode excluir','info'); return; }
  console.log('[excluirColaborador] arg recebido:', profileDbIdOrIdx, typeof profileDbIdOrIdx);
  // Marca antes de comecar — garante persistencia mesmo se DELETE no banco falhar

  // Tenta achar por _dbId primeiro (UUID), depois por indice numerico, depois por email/nome
  let mem = null;
  let idx = -1;

  if(profileDbIdOrIdx !== '' && profileDbIdOrIdx != null){
    // Tenta por _dbId
    idx = team.findIndex(x => x._dbId === profileDbIdOrIdx);
    if(idx < 0){
      // Tenta como indice numerico
      const n = parseInt(profileDbIdOrIdx);
      if(!isNaN(n) && n >= 0 && n < team.length) idx = n;
    }
    if(idx >= 0) mem = team[idx];
  }

  if(!mem){
    toast('Colaborador nao encontrado. Verifique o console (F12).','info');
    console.warn('[excluirColaborador] nao encontrei. team atual:', team.map(t => ({name:t.name, _dbId:t._dbId})));
    return;
  }

  const nome = mem.name;
  const temBanco = !!mem._dbId;
  const aviso = temBanco
    ? '⚠ EXCLUIR DEFINITIVAMENTE "' + nome + '" do sistema?\n\n- Cadastro vai sair do banco\n- Ferias e pagamentos antigos ficam preservados\n\nContinuar?'
    : '⚠ Remover "' + nome + '" da lista?\n\nEsse cadastro nao esta no banco (so local). Continuar?';

  if(!(await confirmDelete('colaborador ' + (mem.name||''), {aviso: aviso}))) return;

  if(temBanco && _supa){
    const { error } = await _supa.from('profiles').delete().eq('id', mem._dbId);
    if(error){
      // Se der erro de FK, sugere desativar em vez de excluir
      if(error.code === '23503' || (error.message||'').toLowerCase().includes('foreign')){
        if(confirm('Esse colaborador tem dados vinculados (ferias/pagamentos/tarefas). Nao da pra excluir.\n\nVoce quer apenas TIRAR DA LISTA DE FERIAS (manter dados historicos)?')){
          await _supa.from('profiles').update({contract_type: 'PJ', active: false}).eq('id', mem._dbId);
          mem.contract_type = 'PJ';
          mem.active = false;
          toast('✓ ' + nome + ' desativado (dados preservados)','success');
          if(typeof renderEquipe === 'function') renderEquipe(document.getElementById('content'));
        }
        return;
      }
      toast('Erro ao excluir: '+error.message,'info');
      return;
    }
  }

  // Marca como excluido no localStorage (pra nao voltar do mock inicial)
  _addColabExcluido(mem.name, mem._dbId);
  team.splice(idx, 1);
  toast('✓ ' + nome + ' excluido(a) do sistema','success');
  if(typeof renderEquipe === 'function') renderEquipe(document.getElementById('content'));
}

// MARCAR colaborador como "sem direito a ferias" (some da aba de ferias mas continua na equipe)
async function tirarColaboradorDeFerias(profileDbIdOrIdx){
  console.log('[tirarColaboradorDeFerias] arg:', profileDbIdOrIdx);
  let mem = null;
  let idx = -1;
  if(profileDbIdOrIdx !== '' && profileDbIdOrIdx != null){
    idx = team.findIndex(x => x._dbId === profileDbIdOrIdx);
    if(idx < 0){
      const n = parseInt(profileDbIdOrIdx);
      if(!isNaN(n) && n >= 0 && n < team.length) idx = n;
    }
    if(idx >= 0) mem = team[idx];
  }
  if(!mem){ toast('Colaborador nao encontrado','info'); console.warn('[tirar] team:', team.map(t=>({n:t.name, id:t._dbId}))); return; }
  if(!confirm('Marcar "' + mem.name + '" como SEM direito a ferias?\n\nEle some da lista mas continua na equipe.')) return;

  // Garante que o colaborador existe no banco antes de atualizar
  if(_supa){
    let dbId = mem._dbId;
    if(!dbId){
      console.log('[tirar] sem _dbId, criando profile no banco...');
      dbId = await ensureProfileInDB(mem);
      if(!dbId){
        toast('Erro: nao foi possivel salvar no banco. A mudanca nao vai persistir.','info');
        return;
      }
      console.log('[tirar] profile criado, _dbId=', dbId);
    }
    const r = await dbUpdate('profiles', dbId, {contract_type: 'PJ'});
    if(!r){
      console.error('[tirar] dbUpdate retornou null');
      return;
    }
  } else {
    toast('⚠ Banco nao conectado, mudanca so local','info');
  }
  mem.contract_type = 'PJ';
  toast('✓ ' + mem.name + ' removido da lista de ferias','success');
  if(typeof renderEquipe === 'function') renderEquipe(document.getElementById('content'));
}

// COLOCAR colaborador existente NA aba de ferias (muda PJ -> CLT)
function abrirSelecionarColaboradorFerias(){
  const semFerias = (team||[]).filter(m => {
    const tipo = (m.contract_type||'').toUpperCase();
    return tipo === 'PJ' || tipo === 'MEI' || tipo === 'FREELANCE' || tipo === 'AUTONOMO';
  });
  if(semFerias.length === 0){
    toast('Todos os colaboradores ja estao na lista de ferias','info');
    return;
  }

  let modal = document.getElementById('selFeriasModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'selFeriasModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:480px;width:100%;max-height:80vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:40px;height:40px;border-radius:9px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:18px">🏖</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">Adicionar a lista de férias</div>' +
        '<div class="text-xs text-3" style="margin-top:2px">Escolha um colaborador da equipe pra incluir na gestão de férias.</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'selFeriasModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:14px 22px 22px;display:flex;flex-direction:column;gap:8px">' +
        semFerias.map(m =>
          '<div style="display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--surface-2);border-radius:9px;border:1px solid var(--border);cursor:pointer" onclick="colocarColaboradorEmFerias(\'' + (m._dbId||'') + '\')">' +
            '<div class="avatar" style="background:' + m.color + ';width:32px;height:32px;font-size:12px">' + m.init + '</div>' +
            '<div style="flex:1"><div style="font-size:13.5px;font-weight:600">' + m.name + '</div>' +
            '<div class="text-xs text-3">' + (m.role||'') + ' · contrato: ' + (m.contract_type||'PJ') + '</div></div>' +
            '<button class="btn btn-sm btn-primary" style="padding:4px 10px;font-size:11px">+ Adicionar</button>' +
          '</div>'
        ).join('') +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function colocarColaboradorEmFerias(profileDbId){
  console.log('[colocarEmFerias] arg:', profileDbId);
  if(!profileDbId){ toast('ID nao informado','info'); return; }
  const mem = team.find(x => x._dbId === profileDbId);
  if(!mem){ toast('Colaborador nao encontrado','info'); return; }
  if(!confirm('Adicionar "' + mem.name + '" a lista de ferias?\n\nO contrato dele(a) sera alterado para CLT.')) return;
  if(!_supa){
    toast('⚠ Banco nao conectado','info');
    return;
  }
  const r = await dbUpdate('profiles', profileDbId, {contract_type: 'CLT'});
  if(!r) return;
  mem.contract_type = 'CLT';
  toast('✓ ' + mem.name + ' adicionado(a) a lista de ferias','success');
  const modal = document.getElementById('selFeriasModal');
  if(modal) modal.remove();
  if(typeof renderEquipe === 'function') renderEquipe(document.getElementById('content'));
}

function renderEquipe(c){
  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Equipe & RH</div>
          <div class="page-subtitle">${team.length} colaboradores · Gestão completa de pessoas</div>
        </div>
        <div class="page-actions">
          <div style="display:flex;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:3px;gap:2px">
            <button class="btn ${equipeView==='lista'||equipeView==='perfil'?'btn-primary':''}" style="border:none;padding:5px 11px" onclick="equipeView='lista';renderEquipe(document.getElementById('content'))">Equipe</button>
            <button class="btn ${equipeView==='ferias'?'btn-primary':''}" style="border:none;padding:5px 11px" onclick="equipeView='ferias';renderEquipe(document.getElementById('content'))">Férias</button>
            <button class="btn ${equipeView==='carreira'?'btn-primary':''}" style="border:none;padding:5px 11px" onclick="equipeView='carreira';renderEquipe(document.getElementById('content'))">Carreira</button>
            <button class="btn" style="border:none;padding:5px 11px" onclick="goTo('ponto')">⏱ Ponto</button>
          </div>
          ${searchBar('Buscar colaborador...','.client-grid, .card')}<button class="btn btn-primary" onclick="openNovoColaboradorModal()">+ Adicionar</button>
        </div>
      </div>

      ${equipeView==='perfil'?renderEquipePerfil():
        equipeView==='ferias'?renderFerias():
        equipeView==='carreira'?renderCarreira():renderEquipeLista()}
    </div>
  `;
}

// Restaura colaboradores excluidos — modal com lista de quem foi excluido
async function restaurarColaboradoresExcluidos(){
  let lista = [];
  // Busca os dados completos do banco (com nome_original)
  if(_supa){
    try {
      const { data } = await _supa.from('colaboradores_excluidos').select('nome_normalizado, nome_original, profile_dbid, excluido_em');
      if(data) lista = data;
    } catch(e){ console.warn(e); }
  }
  // Fallback localStorage
  if(lista.length === 0){
    const norms = _getColabExcluidos() || [];
    lista = norms.map(n => ({nome_normalizado: n, nome_original: n, profile_dbid: null}));
  }
  if(lista.length === 0){
    toast('Nenhum colaborador excluido pra restaurar','info');
    return;
  }

  let modal = document.getElementById('restaurarExcModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'restaurarExcModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:520px;width:100%;max-height:88vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:40px;height:40px;border-radius:9px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:18px">↺</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">Colaboradores excluídos</div>' +
        '<div class="text-xs text-3" style="margin-top:2px">' + lista.length + ' pessoa(s) na lista de exclusão. Marque os que quer restaurar.</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'restaurarExcModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:14px 22px;display:flex;flex-direction:column;gap:6px">' +
        lista.map((item, idx) => {
          const dataEx = item.excluido_em ? new Date(item.excluido_em).toLocaleDateString('pt-BR') : '';
          const nome = item.nome_original || item.nome_normalizado || '(sem nome)';
          return '<label style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--surface-2);border-radius:8px;cursor:pointer">' +
            '<input type="checkbox" class="restaurar-cb" data-key="' + (item.nome_normalizado||'').replace(/"/g,'&quot;') + '" />' +
            '<div style="flex:1"><div style="font-size:13px;font-weight:600">' + escapeHtml(nome) + '</div>' +
            (dataEx ? '<div class="text-xs text-3">Excluído em ' + dataEx + '</div>' : '') + '</div>' +
          '</label>';
        }).join('') +
      '</div>' +
      '<div style="padding:14px 22px 18px;display:flex;gap:8px;justify-content:space-between;align-items:center;border-top:1px solid var(--border)">' +
        '<button class="btn btn-sm" onclick="document.querySelectorAll(\'.restaurar-cb\').forEach(c => c.checked = true)">✓ Marcar todos</button>' +
        '<div style="display:flex;gap:8px">' +
          '<button class="btn" onclick="document.getElementById(\'restaurarExcModal\').remove()">Cancelar</button>' +
          '<button class="btn btn-primary" onclick="confirmarRestaurarSelecionados()">↺ Restaurar selecionados</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function confirmarRestaurarSelecionados(){
  const checks = document.querySelectorAll('.restaurar-cb');
  const chaves = [];
  checks.forEach(c => { if(c.checked) chaves.push(c.dataset.key); });
  if(chaves.length === 0){ toast('Marque pelo menos um pra restaurar','info'); return; }

  // Remove os selecionados do localStorage
  try {
    const cache = JSON.parse(localStorage.getItem('colaboradoresExcluidos')||'[]');
    const novo = cache.filter(c => !chaves.includes(c));
    localStorage.setItem('colaboradoresExcluidos', JSON.stringify(novo));
    _colabExcluidosCache = novo;
  } catch(e){}

  // Remove do banco
  if(_supa){
    for(const c of chaves){
      try { await _supa.from('colaboradores_excluidos').delete().eq('nome_normalizado', c); } catch(e){ console.warn(e); }
    }
  }

  document.getElementById('restaurarExcModal').remove();
  toast('✓ ' + chaves.length + ' colaborador(es) restaurado(s). Recarregando...','success');
  setTimeout(() => location.reload(), 800);
}

function renderEquipeLista(){
  const totalSal = team.reduce((s,t)=>s + (parseFloat(t.salary)||0), 0);
  const totalHoras = team.reduce((s,t)=>s + (parseInt(t.hours)||0), 0);
  return `
    <div class="stat-grid">
      ${statCard('Total', String(team.length),'colaboradores','M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2')}
      ${statCard('Produtividade', team.some(t=>t.prod>0) ? Math.round(team.reduce((s,t)=>s+(t.prod||0),0)/team.length)+'%' : '—','média da equipe','M22 12h-4l-3 9L9 3l-3 9H2')}
      ${statCard('Horas/semana', totalHoras+'h','soma da equipe','M12 8v4l3 3')}
      ${statCard('Custo folha','R$ '+totalSal.toLocaleString('pt-BR'), totalSal===0?'cadastre salários':'mensal','M12 1v22')}
    </div>

    <div class="section-title" style="margin-top:0;display:flex;align-items:center;justify-content:space-between">
      <span>Colaboradores</span>
      <span class="text-xs text-3" style="font-weight:400;cursor:pointer" onclick="restaurarColaboradoresExcluidos()" title="Restaurar colaboradores que voce excluiu por engano">↺ Restaurar excluídos (${(_getColabExcluidos()||[]).length})</span>
    </div>
    <div class="client-grid">
      ${team.map((t,i)=>({...t, _origIdx:i})).sort((a,b)=>(a.name||'').localeCompare(b.name||'','pt-BR',{sensitivity:'base'})).map((t)=>{const i=t._origIdx;return `
        <div class="client-card" style="position:relative">
          <div onclick="perfilId=${i};equipeView='perfil';renderEquipe(document.getElementById('content'))" style="cursor:pointer">
            <div class="client-head">
              <div class="client-logo" style="background:${t.color}">${t.init}</div>
              <div style="flex:1">
                <div class="client-name">${t.name}</div>
                <div class="client-segment">${t.role}</div>
              </div>
            </div>
            <div style="margin:8px 0"><div class="meter"><div class="meter-fill" style="width:${t.prod}%"></div></div></div>
            <div class="text-xs text-3 mb-2">${t.prod}% produtividade</div>
            <div class="client-stats">
              <div><div class="client-stat-val">${t.tasks}</div><div class="client-stat-lbl">Tarefas</div></div>
              <div><div class="client-stat-val">${t.hours}h</div><div class="client-stat-lbl">Semana</div></div>
              <div><div class="client-stat-val">${t.vacationDays-t.vacationUsed}</div><div class="client-stat-lbl">Férias</div></div>
            </div>
          </div>
          ${isGestor() ? `<button class="icon-btn" onclick="event.stopPropagation();excluirColaborador('${t._dbId||i}')" title="Excluir colaborador" style="position:absolute;top:8px;right:8px;width:26px;height:26px;color:var(--danger);background:var(--surface);border:1px solid var(--border);font-size:12px">🗑</button>` : ''}
        </div>
      `;}).join('')}
    </div>

    ${equipeView==='perfil'?renderPerfilModal():''}
  `;
}

function renderPerfil(){
  return renderPerfilFull();
}

function renderPerfilModal(){
  return ''; // perfil is shown as separate view
}

// When clicking a member, show full profile inline
window.addEventListener('DOMContentLoaded',()=>{});

function renderEquipePerfil(){
  setTimeout(()=>renderProfileDocs(perfilId), 200);
  const m = team[perfilId];
  if(!m){
    return '<div class="empty-state" style="padding:60px"><div class="ico">⚠</div><div class="ttl">Colaborador não encontrado</div></div>';
  }
  // Data segura: se m.since vazio/inválido, usa data padrão (hoje)
  let since = new Date(m.since);
  if(isNaN(since.getTime())){
    since = new Date();
  }
  const months = Math.floor((Date.now()-since.getTime())/(1000*60*60*24*30));
  return `
    <div style="margin-bottom:14px"><button class="btn btn-sm" onclick="equipeView='lista';renderEquipe(document.getElementById('content'))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>Voltar</button></div>

    <div class="profile-head">
      <div class="profile-avatar" style="background:${m.color}">${m.init}</div>
      <div style="flex:1">
        <input class="login-input" value="${m.name}" onblur="editProfileField(perfilId,'full_name',this.value)" style="background:transparent;border:none;font-size:22px;font-weight:700;letter-spacing:-.02em;padding:0;width:100%" />
        <input class="login-input" value="${m.role}" onblur="editProfileField(perfilId,'position',this.value)" style="background:transparent;border:none;font-size:13px;color:var(--text-2);padding:0;width:100%;margin-top:3px" />
        <div class="profile-meta">
          <span>📅 ${months} meses na agência</span>
          <span>💼 ${m.tasks} tarefas ativas</span>
          <span>📊 ${m.prod}% produtividade</span>
          <span>🏖 ${m.vacationDays-m.vacationUsed} dias de férias disponíveis</span>
        </div>
      </div>
      <div style="display:flex;gap:6px">
        <button class="btn btn-sm" onclick="whatsApp('${m.phone}','${m.name}')">💬 WhatsApp</button>
        <button class="btn btn-sm" onclick="diagnosticarSync(perfilId)">🔍 Diagnóstico</button>
        <button class="btn btn-sm" onclick="forcarReloadProfile()">🔄 Recarregar</button>
        <button class="btn btn-sm btn-primary" onclick="salvarTudoProfile(perfilId)">💾 Salvar tudo</button>
      </div>
    </div>

    <div class="grid-2e">
      <div>
        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📋 Informações pessoais</div></div>
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Nome completo</div>
              <input class="login-input" value="${m.name}" onblur="editProfileField(perfilId,'full_name',this.value);m.name=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label" style="display:flex;align-items:center;gap:6px">
                <select onchange="editProfileField(perfilId,'cpf_type',this.value);m.cpf_type=this.value;document.querySelector('input[data-cpfcnpj]')?.setAttribute('placeholder', this.value==='CNPJ'?'00.000.000/0000-00':'000.000.000-00')" style="background:var(--surface-2);border:1px solid var(--border);border-radius:5px;padding:2px 6px;font-size:11px;color:var(--text);font-family:inherit;font-weight:700">
                  <option value="CPF" ${(m.cpf_type||'CPF')==='CPF'?'selected':''}>CPF</option>
                  <option value="CNPJ" ${m.cpf_type==='CNPJ'?'selected':''}>CNPJ</option>
                </select>
              </div>
              <input data-cpfcnpj class="login-input" value="${m.cpf||''}" onblur="editProfileField(perfilId,'cpf',this.value);m.cpf=this.value" placeholder="${(m.cpf_type||'CPF')==='CNPJ'?'00.000.000/0000-00':'000.000.000-00'}" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Cargo</div>
              <input class="login-input" value="${m.role||''}" onblur="editProfileField(perfilId,'position',this.value);m.role=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">WhatsApp</div>
              <input class="login-input" value="${m.phone||''}" onblur="editProfileField(perfilId,'phone',this.value);m.phone=this.value" placeholder="(11) 99999-9999" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">E-mail corporativo</div>
              <input class="login-input" value="${m.email||(m.name.split(' ')[0].toLowerCase()+'@impulseone.com.br')}" onblur="editProfileField(perfilId,'email',this.value);m.email=this.value" placeholder="email@impulseone.com.br" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Endereço</div>
              <input class="login-input" value="${m.address||''}" onblur="editProfileField(perfilId,'address',this.value);m.address=this.value" placeholder="Rua, número, cidade/UF" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Tipo de contrato</div>
              <select onchange="editProfileField(perfilId,'contract_type',this.value);m.contract_type=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500;color:var(--text);font-family:inherit">
                <option value="CLT" ${(m.contract_type||'CLT')==='CLT'?'selected':''}>CLT</option>
                <option value="PJ" ${m.contract_type==='PJ'?'selected':''}>PJ</option>
                <option value="MEI" ${m.contract_type==='MEI'?'selected':''}>MEI</option>
                <option value="Estágio" ${m.contract_type==='Estágio'?'selected':''}>Estágio</option>
                <option value="Freelance" ${m.contract_type==='Freelance'?'selected':''}>Freelance</option>
              </select>
            </div>
            <div class="info-item">
              <div class="info-label">Data de admissão</div>
              <input class="login-input" type="date" value="${m.since||''}" onblur="editProfileField(perfilId,'contract_start',this.value);m.since=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">🎂 Aniversário</div>
              <input class="login-input" type="date" value="${m.birthday||''}" onblur="editProfileField(perfilId,'birthday',this.value);m.birthday=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" placeholder="dd/mm/aaaa" />
            </div>
            <div class="info-item">
              <div class="info-label">Salário (R$)</div>
              <input class="login-input" type="number" step="0.01" value="${m.salary||0}" onblur="editProfileField(perfilId,'salary',parseFloat(this.value)||0);m.salary=parseFloat(this.value)||0" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Banco / Conta</div>
              <input class="login-input" value="${m.bank||''}" onblur="editProfileField(perfilId,'bank',this.value);m.bank=this.value" placeholder="Nubank · ag 0001 · cc 12345" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">🔑 Chave PIX</div>
              <input class="login-input" value="${m.pix_key||''}" onblur="editProfileField(perfilId,'pix_key',this.value);m.pix_key=this.value" placeholder="CPF, e-mail, telefone ou aleatória" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">🏖 Controle de férias</div><span class="badge ${m.vacationDays-m.vacationUsed<10?'b-warning':'b-success'}">${m.vacationDays-m.vacationUsed} dias disponíveis</span></div>
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Início do período aquisitivo</div>
              <input class="login-input" type="date" value="${m.since||''}" onblur="editProfileField(perfilId,'contract_start',this.value);m.since=this.value;renderEquipe(document.getElementById('content'))" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Fim do período aquisitivo</div>
              <input class="login-input" type="date" value="${m.vacation_period_end||''}" onblur="editProfileField(perfilId,'vacation_period_end',this.value);m.vacation_period_end=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Dias totais</div>
              <input class="login-input" type="number" min="0" value="${m.vacationDays}" onblur="editProfileField(perfilId,'vacation_total',parseInt(this.value)||30);m.vacationDays=parseInt(this.value)||30;renderEquipe(document.getElementById('content'))" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Já utilizados</div>
              <input class="login-input" type="number" min="0" value="${m.vacationUsed}" onblur="editProfileField(perfilId,'vacation_used',parseInt(this.value)||0);m.vacationUsed=parseInt(this.value)||0;renderEquipe(document.getElementById('content'))" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Saldo (auto)</div>
              <div class="info-value"><strong style="color:var(--success-text)">${m.vacationDays-m.vacationUsed} dias</strong> <span class="text-xs text-3">(calculado)</span></div>
            </div>
            <div class="info-item">
              <div class="info-label">Prazo legal (limite)</div>
              <input class="login-input" type="date" value="${m.vacation_legal_deadline||''}" onblur="editProfileField(perfilId,'vacation_legal_deadline',this.value);m.vacation_legal_deadline=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Última saída</div>
              <input class="login-input" value="${m.lastVacation||(m.vacationUsed>0?'15 dez 2024 — 15 dias':'Nunca')}" onblur="editProfileField(perfilId,'last_vacation',this.value);m.lastVacation=this.value" placeholder="Ex: 15 dez 2024 — 15 dias" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
          </div>
          ${months>10 && m.vacationUsed===0?`<div style="margin-top:12px;padding:11px;background:var(--warning-soft);border-radius:8px;color:var(--warning-text);font-size:12px;font-weight:500">⚠ Férias próximas — programe nos próximos 60 dias</div>`:''}
          <div style="margin-top:12px;display:flex;gap:6px"><button class="btn btn-sm btn-primary">📅 Programar férias</button><button class="btn btn-sm">📜 Histórico</button></div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">⏰ Jornada de trabalho</div><span class="badge b-info">Calculo automatico</span></div>
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Hora de entrada</div>
              <input class="login-input" type="time" value="${m.work_start_time||'09:00'}" onblur="editProfileField(perfilId,'work_start_time',this.value);m.work_start_time=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Hora de saída</div>
              <input class="login-input" type="time" value="${m.work_end_time||'18:00'}" onblur="editProfileField(perfilId,'work_end_time',this.value);m.work_end_time=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Intervalo (min)</div>
              <input class="login-input" type="number" min="0" max="240" value="${m.lunch_duration_min||60}" onblur="editProfileField(perfilId,'lunch_duration_min',parseInt(this.value)||60);m.lunch_duration_min=parseInt(this.value)||60" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Tolerância atraso (min)</div>
              <input class="login-input" type="number" min="0" max="60" value="${m.tolerance_min!==undefined?m.tolerance_min:15}" onblur="editProfileField(perfilId,'tolerance_min',parseInt(this.value)||0);m.tolerance_min=parseInt(this.value)||0" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item" style="grid-column:span 2">
              <div class="info-label">Dias de trabalho</div>
              <div style="display:flex;gap:6px;margin-top:4px">
                ${[['1','Seg'],['2','Ter'],['3','Qua'],['4','Qui'],['5','Sex'],['6','Sáb'],['0','Dom']].map(d => {
                  const days = (m.work_days||'1,2,3,4,5').split(',');
                  const checked = days.includes(d[0]);
                  return `<label style="display:flex;align-items:center;gap:4px;padding:6px 10px;background:${checked?'var(--accent)':'var(--surface-2)'};color:${checked?'var(--surface)':'var(--text)'};border-radius:6px;cursor:pointer;font-size:11.5px;font-weight:600"><input type="checkbox" ${checked?'checked':''} onchange="toggleWorkDay(perfilId,'${d[0]}',this.checked)" style="display:none" />${d[1]}</label>`;
                }).join('')}
              </div>
            </div>
          </div>
          <div style="background:var(--surface-2);padding:11px;border-radius:8px;margin-top:12px;font-size:12px;color:var(--text-2)">
            📊 <strong>Carga diária esperada:</strong> ${calcularCargaDiaria(m)}h por dia<br/>
            📅 <strong>Carga mensal estimada:</strong> ${(calcularCargaDiaria(m) * calcularDiasUteisMes(m)).toFixed(0)}h em ${calcularDiasUteisMes(m)} dias úteis
          </div>
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">📎 Documentos</div><button class="btn btn-sm" onclick="abrirUploadDocModal(perfilId)">+ Adicionar documento</button></div>
          <div class="file-grid" id="profile-docs-grid">
            <div class="text-mu text-sm center" style="grid-column:span 4;padding:20px">Carregando documentos...</div>
          </div>
        </div>
      </div>

      <div>
        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📊 Desempenho</div></div>
          <div class="stat-grid" style="grid-template-columns:1fr 1fr;margin-bottom:14px">
            <div class="stat">
              <div class="stat-head"><div class="stat-label">Produtividade</div><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div></div>
              <input class="login-input" type="number" min="0" max="100" value="${m.prod}" onblur="editProfileField(perfilId,'productivity',parseInt(this.value)||0);m.prod=parseInt(this.value)||0" style="background:transparent;border:none;font-size:22px;font-weight:700;letter-spacing:-.03em;padding:0;width:100%" />
              <div class="stat-sub">últimos 30d (em %)</div>
            </div>
            <div class="stat">
              <div class="stat-head"><div class="stat-label">Tarefas/semana</div><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/></svg></div></div>
              <input class="login-input" type="number" min="0" value="${m.tasks||0}" onblur="editProfileField(perfilId,'weekly_tasks',parseInt(this.value)||0);m.tasks=parseInt(this.value)||0" style="background:transparent;border:none;font-size:22px;font-weight:700;letter-spacing:-.03em;padding:0;width:100%" />
              <div class="stat-sub">média</div>
            </div>
          </div>
          <div class="text-xs text-mu mb-2">Evolução nos últimos 6 meses</div>
          ${[78,82,85,87,m.prod-2,m.prod].map((p,i)=>{
            const lbl = ['Dez','Jan','Fev','Mar','Abr','Mai'][i];
            return `<div style="display:flex;align-items:center;gap:10px;padding:5px 0">
              <span class="text-xs text-mu" style="width:32px">${lbl}</span>
              <div class="meter" style="flex:1"><div class="meter-fill" style="width:${p}%"></div></div>
              <span class="text-xs font-semi" style="width:32px;text-align:right">${p}%</span>
            </div>`;
          }).join('')}
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">🎯 Jornada & Evolução</div><span class="badge b-info">Timeline</span></div>
          <div class="timeline">
            <div class="tl-item success"><div class="tl-date">${since.toLocaleDateString('pt-BR')}</div><div class="tl-title">Admissão na Nova</div><div class="tl-desc">Início como ${m.role}</div></div>
            ${m.vacationUsed>0?`<div class="tl-item"><div class="tl-date">DEZ 2024</div><div class="tl-title">Primeiro período de férias</div><div class="tl-desc">${m.vacationUsed} dias de descanso</div></div>`:''}
            <div class="tl-item"><div class="tl-date">MAR 2025</div><div class="tl-title">Avaliação semestral — Nota 9.0</div><div class="tl-desc">Desempenho acima da média</div></div>
            <div class="tl-item"><div class="tl-date">SET 2025</div><div class="tl-title">Aumento salarial — +12%</div><div class="tl-desc">Reconhecimento de evolução</div></div>
            <div class="tl-item"><div class="tl-date">FEV 2026</div><div class="tl-title">Avaliação trimestral — Nota 9.4</div><div class="tl-desc">Liderança em projetos</div></div>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📈 Revisão de crescimento</div><button class="btn btn-sm btn-primary">+ Nova revisão</button></div>
          <div class="text-xs text-mu mb-3">Próxima revisão: <strong>15 jun 2026</strong></div>
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Possível promoção</div>
              <input class="login-input" value="${m.promotion_eval||(m.prod>90?'Sim — Sênior':'Em avaliação')}" onblur="editProfileField(perfilId,'promotion_eval',this.value);m.promotion_eval=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Possível aumento</div>
              <input class="login-input" value="${m.raise_eval||(m.prod>88?'—':'Próx. ciclo')}" onblur="editProfileField(perfilId,'raise_eval',this.value);m.raise_eval=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Áreas a desenvolver</div>
              <input class="login-input" value="${m.areas_develop||'Gestão de equipe'}" onblur="editProfileField(perfilId,'areas_develop',this.value);m.areas_develop=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Pontos fortes</div>
              <input class="login-input" value="${m.strengths||'Criatividade, prazo'}" onblur="editProfileField(perfilId,'strengths',this.value);m.strengths=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">💬 Feedbacks recentes</div></div>
          <div class="empty-state"><div class="ico">💬</div><div class="ttl">Sem feedbacks</div><div class="desc">Os feedbacks recebidos aparecerão aqui.</div></div>
        </div>
      </div>
    </div>
  `;
}

// ============ FOLHA PONTO ============
function renderPonto(){
  const now=new Date();
  const opts={timeZone:'America/Sao_Paulo',hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'};
  const time=now.toLocaleTimeString('pt-BR',opts);
  const dateStr=now.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo',weekday:'long',day:'numeric',month:'long',year:'numeric'});
  if(!pontoAuth){
    return `<div style="max-width:440px;margin:40px auto"><div class="card">
      <div class="ponto-clock" style="border:none;padding:0;margin-bottom:20px">
        <div class="ponto-time" id="liveClock">${time}</div>
        <div class="ponto-date">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)}</div>
        <div class="text-xs text-3" style="margin-top:6px">🇧🇷 Horário oficial de Brasília</div>
      </div>
      <div class="section-title" style="margin-top:0">Identifique-se para bater o ponto</div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div><div class="info-label" style="margin-bottom:5px">Colaborador</div>
        <select id="pontoSelect" style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13px">
          <option value="">Selecione...</option>
          ${team.map(t=>`<option value="${t.name}">${t.name}</option>`).join('')}
        </select></div>
        <div><div class="info-label" style="margin-bottom:5px">Senha individual</div>
        <input type="password" id="pontoPwd" placeholder="••••" style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13px"/></div>
        <button class="btn btn-primary" style="justify-content:center;padding:11px" onclick="pontoLogin()">🔐 Entrar para bater ponto</button>
      </div>
      <div class="text-xs text-3 center mt-4">🔒 Registro seguro · Logs auditáveis · Senha pessoal e intransferível</div>
    </div></div>`;
  }
  return `<div class="grid-2e"><div>
    <div class="ponto-clock">
      <div style="font-size:13px;color:var(--text-2);margin-bottom:8px">Olá, <strong style="color:var(--text)">${pontoUser}</strong></div>
      <div class="ponto-time" id="liveClock">${time}</div>
      <div class="ponto-date">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)}</div>
      <div class="text-xs text-3" style="margin-top:6px">🇧🇷 Horário oficial de Brasília</div>
      <div class="ponto-actions">
        <button class="ponto-btn ${pontoToday.entrada?'done':''}" onclick="batePonto('entrada')"><span class="icon">🌅</span><span>Entrada</span><span class="text-xs text-3">${pontoToday.entrada||'—'}</span></button>
        <button class="ponto-btn ${pontoToday.intervaloIn?'done':''}" onclick="batePonto('intervaloIn')"><span class="icon">🍽</span><span>Início intervalo</span><span class="text-xs text-3">${pontoToday.intervaloIn||'—'}</span></button>
        <button class="ponto-btn ${pontoToday.intervaloOut?'done':''}" onclick="batePonto('intervaloOut')"><span class="icon">☕</span><span>Fim intervalo</span><span class="text-xs text-3">${pontoToday.intervaloOut||'—'}</span></button>
        <button class="ponto-btn ${pontoToday.saida?'done':''}" onclick="batePonto('saida')"><span class="icon">🌙</span><span>Saída</span><span class="text-xs text-3">${pontoToday.saida||'—'}</span></button>
      </div>
      <div style="margin-top:16px;display:flex;gap:8px;justify-content:center"><button class="btn btn-sm" onclick="pontoAuth=false;pontoUser=null;renderEquipe(document.getElementById('content'))">Trocar usuário</button></div>
    </div>
    <div class="card mt-4">
      <div class="card-header"><div class="card-title">📊 Resumo do mês — maio/2026</div></div>
      <div class="stat-grid" style="grid-template-columns:repeat(3,1fr)">
        ${statCard('Horas trabalhadas','156h','de 176h','M12 8v4l3 3')}
        ${statCard('Banco de horas','+8h','crédito','M12 1v22')}
        ${statCard('Atrasos','2','total','M12 9v4')}
      </div>
    </div>
  </div>
  <div>
    <div class="card mb-3">
      <div class="card-header"><div class="card-title">📅 Histórico mensal</div><div style="display:flex;gap:6px"><button class="btn btn-sm">PDF</button><button class="btn btn-sm">Excel</button></div></div>
      <table class="table"><thead><tr><th>Dia</th><th>Entrada</th><th>Intervalo</th><th>Saída</th><th>Total</th></tr></thead><tbody>
        ${Array.from({length:10}).map((_,i)=>{const d=18-i;if(d<1)return '';return `<tr><td><strong>${d.toString().padStart(2,'0')}/05</strong></td><td>09:0${Math.floor(Math.random()*9)}</td><td>12:0${Math.floor(Math.random()*9)} → 13:0${Math.floor(Math.random()*9)}</td><td>18:0${Math.floor(Math.random()*9)}</td><td><strong>8h 0${Math.floor(Math.random()*9)}min</strong></td></tr>`}).join('')}
      </tbody></table>
    </div>
    <div class="card">
      <div class="card-header"><div class="card-title">🏖 Saldo de férias</div></div>
      <div class="text-xs text-mu mb-2">Período aquisitivo atual</div>
      <div class="meter mb-3"><div class="meter-fill" style="width:60%"></div></div>
      <div style="display:flex;justify-content:space-between;font-size:12px"><span>18 dias acumulados</span><span class="font-semi">de 30 dias</span></div>
    </div>
  </div></div>`;
}

function pontoLogin(){
  const sel=document.getElementById('pontoSelect').value;
  const pwd=document.getElementById('pontoPwd').value;
  if(!sel){toast('Selecione o colaborador','info');return}
  if(!pwd){toast('Digite a senha','info');return}
  pontoAuth=true;pontoUser=sel;
  toast(`Bem-vindo(a), ${sel}!`);
  renderPontoPage(document.getElementById('content'));
}
async function batePonto(tipo){
  const now=new Date();
  const t=now.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'});
  if(pontoToday[tipo]){toast('Já registrado anteriormente','info');return}
  pontoToday[tipo]=t;
  await savePontoBate(pontoUser, tipo, t);  // persiste no banco
  toast(`✓ Ponto registrado às ${t}`);
  renderPontoPage(document.getElementById('content'));
}
setInterval(()=>{
  const el=document.getElementById('liveClock');
  if(el){const now=new Date();el.textContent=now.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'})}
},1000);

// ============ FÉRIAS ============
// Modal de gestao de ferias por ano — permite adicionar/editar dias manualmente pra cada colaborador
function abrirGestaoFeriasAno(ano, profileDbId){
  const teamComFerias = (team||[]).filter(m => {
    const tipo = (m.contract_type||'').toUpperCase();
    return tipo !== 'PJ' && tipo !== 'MEI' && tipo !== 'FREELANCE' && tipo !== 'AUTONOMO';
  });
  if(teamComFerias.length === 0){ toast('Nenhum colaborador com ferias','info'); return; }

  // Pega registros existentes do ano
  const registrosAno = (typeof _ferias !== 'undefined' ? _ferias : [])
    .filter(f => f.data_inicio && f.data_inicio.startsWith(ano+'-'))
    .filter(f => teamComFerias.some(m => m._dbId === f.profile_id));

  // Agrupa total por colaborador
  const totalPorColab = {};
  registrosAno.forEach(f => {
    if(!totalPorColab[f.profile_id]) totalPorColab[f.profile_id] = 0;
    totalPorColab[f.profile_id] += (parseInt(f.dias)||0);
  });

  let modal = document.getElementById('gestaoFeriasModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'gestaoFeriasModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:760px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:42px;height:42px;border-radius:10px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:20px">🏖</div>' +
        '<div style="flex:1"><div style="font-size:17px;font-weight:700">Gestão de férias — '+ano+'</div>' +
        '<div class="text-xs text-3" style="margin-top:2px">Adicione/edite férias de '+ano+' pra cada colaborador. Os registros sao salvos como períodos no banco.</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'gestaoFeriasModal\').remove()" style="width:32px;height:32px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px">' +
        '<div class="text-xs text-3" style="margin-bottom:10px">Existem <strong>'+registrosAno.length+'</strong> registro(s) de férias para '+ano+'.</div>' +
        '<table class="table" style="width:100%;font-size:12.5px">' +
          '<thead><tr><th>Colaborador</th><th style="text-align:center">Total usado em '+ano+'</th><th style="text-align:right">Ações</th></tr></thead>' +
          '<tbody>' +
          teamComFerias.map(m => {
            const total = totalPorColab[m._dbId] || 0;
            const destaque = profileDbId && m._dbId === profileDbId ? 'background:var(--warning-soft);border-left:3px solid var(--warning)' : '';
            return '<tr style="' + destaque + '">' +
              '<td><div style="display:flex;align-items:center;gap:10px"><div class="avatar" style="background:' + m.color + ';width:30px;height:30px;font-size:12px">' + m.init + '</div><div><strong>' + m.name + '</strong><div class="text-xs text-3">' + (m.role||'') + '</div></div></div></td>' +
              '<td style="text-align:center"><strong style="font-size:14px;color:' + (total>0?'var(--text)':'var(--text-3)') + '">' + total + ' dias</strong></td>' +
              '<td style="text-align:right">' +
                '<button class="btn btn-sm btn-primary" onclick="adicionarFeriasAno(' + ano + ',\'' + (m._dbId||'') + '\')" style="padding:4px 10px;font-size:11px" title="Adicionar período em ' + ano + '">+ Adicionar período</button>' +
              '</td>' +
            '</tr>';
          }).join('') +
          '</tbody>' +
        '</table>' +
        (registrosAno.length > 0 ? (
          '<div style="margin-top:18px;padding-top:14px;border-top:1px solid var(--border)">' +
            '<div style="font-weight:700;margin-bottom:8px;font-size:13px">📅 Períodos cadastrados em '+ano+'</div>' +
            '<div style="display:flex;flex-direction:column;gap:6px">' +
            registrosAno.sort((a,b) => (a.data_inicio||'').localeCompare(b.data_inicio||'')).map(f => {
              const pes = teamComFerias.find(m => m._dbId === f.profile_id);
              if(!pes) return '';
              const di = new Date(f.data_inicio+'T00:00:00').toLocaleDateString('pt-BR');
              const df = new Date(f.data_fim+'T00:00:00').toLocaleDateString('pt-BR');
              return '<div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--surface-2);border-radius:8px;border:1px solid var(--border)">' +
                '<div class="avatar" style="background:' + pes.color + ';width:24px;height:24px;font-size:10px">' + pes.init + '</div>' +
                '<div style="flex:1"><div style="font-size:12.5px;font-weight:600">' + pes.name + '</div>' +
                '<div class="text-xs text-3">' + di + ' até ' + df + ' · <strong>' + (f.dias||0) + ' dias</strong>' + (f.motivo ? ' · ' + f.motivo : '') + '</div></div>' +
                '<button class="btn btn-sm" onclick="openProgramarFeriasModal({editing:\'' + f.id + '\'});document.getElementById(\'gestaoFeriasModal\').remove()" style="padding:3px 8px;font-size:11px">✏️</button>' +
                '<button class="btn btn-sm" onclick="excluirFeriasNoModal(\'' + f.id + '\',' + ano + ')" style="padding:3px 8px;font-size:11px;color:var(--danger)">🗑</button>' +
              '</div>';
            }).join('') +
            '</div>' +
          '</div>'
        ) : '') +
      '</div>' +
      '<div style="padding:14px 22px 18px;display:flex;gap:8px;justify-content:space-between;align-items:center;border-top:1px solid var(--border)">' +
        '<div class="text-xs text-3">Dica: clique em "+ Adicionar período" pra cadastrar uma faixa de datas (início → fim) com o total de dias.</div>' +
        '<button class="btn" onclick="document.getElementById(\'gestaoFeriasModal\').remove()">Fechar</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

// Atalho: abre o modal de programar ferias com profile_id + ano pre-selecionados
function adicionarFeriasAno(ano, profileDbId){
  // Sugere data_inicio = 01/01/ano
  const sugestaoInicio = ano + '-01-15';
  document.getElementById('gestaoFeriasModal').remove();
  openProgramarFeriasModal({profile_id: profileDbId, data_inicio_sugestao: sugestaoInicio});
}

async function excluirFeriasNoModal(id, ano){
  if(!(await confirmDelete('periodo de ferias'))) return;
  if(_supa){
    const { error } = await _supa.from('ferias_programadas').delete().eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  if(typeof _ferias !== 'undefined') _ferias = _ferias.filter(f => f.id !== id);
  toast('Periodo excluido','success');
  document.getElementById('gestaoFeriasModal').remove();
  abrirGestaoFeriasAno(ano);
}

function renderFerias(){
  // Filtra apenas colaboradores que TEM direito a ferias (CLT/Estagio ou vacation_eligible nao false)
  const teamComFerias = (team||[]).filter(m => {
    const tipo = (m.contract_type||'').toUpperCase();
    const semFerias = tipo === 'PJ' || tipo === 'MEI' || tipo === 'FREELANCE' || tipo === 'AUTONOMO';
    return !semFerias;
  });

  const anoAtual = new Date().getFullYear();
  const ANO_INICIAL = 2023;
  const anos = [];
  for(let a = ANO_INICIAL; a <= anoAtual; a++) anos.push(a);

  // Agrupa _ferias por profile_id + ano
  const historicoPorPessoa = {};
  (typeof _ferias !== 'undefined' ? _ferias : []).forEach(f => {
    if(!f.profile_id || !f.data_inicio) return;
    const ano = parseInt(f.data_inicio.split('-')[0]);
    if(!historicoPorPessoa[f.profile_id]) historicoPorPessoa[f.profile_id] = {};
    if(!historicoPorPessoa[f.profile_id][ano]) historicoPorPessoa[f.profile_id][ano] = 0;
    historicoPorPessoa[f.profile_id][ano] += (parseInt(f.dias) || 0);
  });

  // Stats globais
  const hoje = new Date();
  const emFeriasHoje = (typeof _ferias !== 'undefined' ? _ferias : []).filter(f => {
    if(!f.data_inicio || !f.data_fim) return false;
    const di = new Date(f.data_inicio+'T00:00:00');
    const df = new Date(f.data_fim+'T23:59:59');
    return di <= hoje && hoje <= df;
  }).length;
  const programadasProx60 = (typeof _ferias !== 'undefined' ? _ferias : []).filter(f => {
    if(!f.data_inicio) return false;
    const di = new Date(f.data_inicio+'T00:00:00');
    const diff = (di - hoje) / 86400000;
    return diff >= 0 && diff <= 60;
  }).length;
  const totalSaldo = teamComFerias.reduce((s,m) => {
    const usadosAnoAtual = (historicoPorPessoa[m._dbId] && historicoPorPessoa[m._dbId][anoAtual]) || 0;
    return s + Math.max(0, (m.vacationDays||30) - usadosAnoAtual);
  }, 0);
  const saldoMedio = teamComFerias.length > 0 ? Math.round(totalSaldo / teamComFerias.length) : 0;
  const alertas = teamComFerias.filter(m => {
    const months = m.since ? Math.floor((Date.now() - new Date(m.since+'T00:00:00').getTime())/(1000*60*60*24*30)) : 0;
    const usadosAnoAtual = (historicoPorPessoa[m._dbId] && historicoPorPessoa[m._dbId][anoAtual]) || 0;
    return months > 10 && usadosAnoAtual === 0;
  }).length;

  return `<div class="stat-grid">
    ${statCard('Em férias agora', emFeriasHoje, 'colaborador(es)', 'M20 12V8H6a2 2 0 0 1 0-4h12v4')}
    ${statCard('Programadas', programadasProx60, 'próx. 60 dias', 'M3 12h18')}
    ${statCard('Saldo médio', saldoMedio, 'dias/pessoa', 'M12 1v22')}
    ${statCard('Alertas', alertas, 'prazo legal próximo', 'M12 9v4', null, alertas>0?'warning':'')}
  </div>
  <div class="section-title" style="margin-top:0;display:flex;align-items:center;justify-content:space-between">
    <span>Controle por colaborador (apenas quem tem férias — ${teamComFerias.length} pessoa(s))</span>
    <div style="display:flex;gap:8px">
      <button class="btn btn-sm" onclick="openProgramarFeriasModal()" style="font-size:12px;padding:6px 12px">🏖 Programar férias</button>
      <button class="btn btn-sm" onclick="abrirSelecionarColaboradorFerias()" style="font-size:12px;padding:6px 12px">+ Existente da equipe</button>
      <button class="btn btn-sm btn-primary" onclick="openNovoColaboradorModal()" style="font-size:12px;padding:6px 12px">+ Novo colaborador</button>
    </div>
  </div>
  <div class="card" style="padding:0;overflow-x:auto">
    <table class="table" style="min-width:1100px"><thead><tr>
      <th>Colaborador</th>
      <th>Admissão</th>
      <th>Período</th>
      ${anos.map(a => `<th style="text-align:center;background:${a===anoAtual?'var(--warning-soft)':'transparent'};cursor:pointer" onclick="abrirGestaoFeriasAno(${a})" title="Clique pra gerenciar ${a}"><span style="display:inline-flex;align-items:center;gap:4px">${a===anoAtual?'<strong>'+a+' (atual)</strong>':a}<span style="font-size:10px;opacity:.6">⚙</span></span></th>`).join('')}
      <th>Total/ano</th>
      <th>Saldo ${anoAtual}</th>
      <th>Próximas férias</th>
      <th>Status</th>
      <th style="width:130px">Ações</th>
    </tr></thead><tbody>
    ${teamComFerias.map((m) => {
      const i = team.indexOf(m);
      const since = m.since ? new Date(m.since+'T00:00:00') : null;
      const sinceValida = since && !isNaN(since.getTime());
      const months = sinceValida ? Math.floor((Date.now()-since.getTime())/(1000*60*60*24*30)) : 0;
      const totalDias = m.vacationDays || 30;
      const histPessoa = historicoPorPessoa[m._dbId] || {};
      const usadosAnoAtual = histPessoa[anoAtual] || 0;
      const saldo = Math.max(0, totalDias - usadosAnoAtual);
      const isClose = sinceValida && months > 10 && usadosAnoAtual === 0;
      const proxFerias = (typeof _ferias!=='undefined'?_ferias:[]).filter(f=>f.profile_id===m._dbId && new Date(f.data_inicio+'T00:00:00')>=new Date()).sort((a,b)=>a.data_inicio.localeCompare(b.data_inicio))[0];
      const proxFeriasTxt = proxFerias ? new Date(proxFerias.data_inicio+'T00:00:00').toLocaleDateString('pt-BR')+' ('+proxFerias.dias+'d)' : '—';
      const inpStyle = "background:transparent;border:1px solid var(--border);border-radius:5px;padding:3px 6px;font-size:12px;color:var(--text);width:60px;font-family:inherit;cursor:text";

      const cellsAnos = anos.map(a => {
        const dias = histPessoa[a] || 0;
        const bg = a===anoAtual ? 'var(--warning-soft)' : 'transparent';
        return `<td style="text-align:center;background:${bg};cursor:pointer" onclick="abrirGestaoFeriasAno(${a},'${m._dbId||''}')" title="Clique pra editar ${a} de ${m.name}"><span style="font-weight:600;color:${dias>0?'var(--text)':'var(--text-3)'};text-decoration:underline;text-decoration-style:dotted">${dias>0?dias+'d':'+'}</span></td>`;
      }).join('');

      return `<tr>
        <td><div style="display:flex;align-items:center;gap:10px;cursor:pointer" onclick="perfilId=${i};equipeView='perfil';renderEquipe(document.getElementById('content'))"><div class="avatar" style="background:${m.color}">${m.init}</div><div><strong>${m.name}</strong><div class="text-xs text-3">${m.role||''}</div></div></div></td>
        <td><input type="date" onclick="event.stopPropagation()" value="${m.since||''}" onblur="editProfileField(${i},'contract_start',this.value);team[${i}].since=this.value;renderEquipe(document.getElementById('content'))" style="background:transparent;border:1px solid var(--border);border-radius:5px;padding:3px 6px;font-size:11px;color:var(--text);font-family:inherit;width:130px"></td>
        <td class="text-mu">${sinceValida ? months+' meses' : '—'}</td>
        ${cellsAnos}
        <td><input type="number" min="0" max="60" onclick="event.stopPropagation()" value="${totalDias}" onblur="editProfileField(${i},'vacation_total',parseInt(this.value)||30);team[${i}].vacationDays=parseInt(this.value)||30;renderEquipe(document.getElementById('content'))" style="${inpStyle}"> dias</td>
        <td><strong style="color:${saldo<=5?'var(--danger)':saldo<=15?'var(--success)':'var(--info)'}">${saldo} dias</strong></td>
        <td class="text-mu">${proxFeriasTxt}</td>
        <td>${isClose ? '<span class="badge b-warning">⚠ Programar</span>' : saldo<=15 ? '<span class="badge b-success">Em dia</span>' : '<span class="badge b-info">Saldo alto</span>'}</td>
        <td><div style="display:flex;gap:4px">
          <button class="btn btn-sm btn-primary" onclick="event.stopPropagation();openProgramarFeriasModal({profile_id:'${m._dbId||''}'})" style="padding:4px 8px;font-size:11px" title="Programar férias">📅</button>
          <button class="btn btn-sm" onclick="event.stopPropagation();perfilId=${i};equipeView='perfil';renderEquipe(document.getElementById('content'))" style="padding:4px 8px;font-size:11px" title="Editar perfil">✏️</button>
          <button class="btn btn-sm" onclick="event.stopPropagation();tirarColaboradorDeFerias('${m._dbId||i}')" style="padding:4px 8px;font-size:11px;color:var(--danger)" title="Tirar da lista de férias">🏖✕</button>
        </div></td>
      </tr>`;
    }).join('')}
    </tbody></table>
  </div>

  <div class="card mt-4">
    <div class="card-header"><div class="card-title">📜 Histórico detalhado de férias (todos os registros)</div>
      <span class="text-xs text-3">${(typeof _ferias!=='undefined'?_ferias:[]).length} registro(s)</span>
    </div>
    ${(() => {
      const todasFerias = (typeof _ferias!=='undefined'?_ferias:[])
        .filter(f => teamComFerias.some(m => m._dbId === f.profile_id))
        .sort((a,b) => (b.data_inicio||'').localeCompare(a.data_inicio||''));
      if(todasFerias.length === 0) return '<div class="text-mu text-sm">Nenhuma férias registrada ainda. Use o botão "Programar férias" pra adicionar.</div>';
      return '<table class="table" style="width:100%"><thead><tr><th>Colaborador</th><th>Início</th><th>Fim</th><th>Dias</th><th>Ano</th><th>Status</th><th style="width:80px">Ações</th></tr></thead><tbody>' +
        todasFerias.map(f => {
          const pes = teamComFerias.find(m => m._dbId === f.profile_id);
          if(!pes) return '';
          const di = new Date(f.data_inicio+'T00:00:00');
          const df = new Date(f.data_fim+'T23:59:59');
          const hojeD = new Date();
          let status, badge;
          if(hojeD < di){ status = 'Programada'; badge = 'b-info'; }
          else if(hojeD > df){ status = 'Concluída'; badge = 'b-success'; }
          else { status = 'Em curso'; badge = 'b-warning'; }
          return `<tr>
            <td><div style="display:flex;align-items:center;gap:8px"><div class="avatar" style="background:${pes.color};width:26px;height:26px;font-size:11px">${pes.init}</div><strong>${pes.name}</strong></div></td>
            <td>${di.toLocaleDateString('pt-BR')}</td>
            <td>${df.toLocaleDateString('pt-BR')}</td>
            <td><strong>${f.dias||0} dias</strong></td>
            <td><span class="badge b-default">${di.getFullYear()}</span></td>
            <td><span class="badge ${badge}">${status}</span></td>
            <td><div style="display:flex;gap:4px">
              <button class="btn btn-sm" onclick="openProgramarFeriasModal({editing:'${f.id}'})" style="padding:3px 7px;font-size:10px" title="Editar">✏️</button>
              <button class="btn btn-sm" onclick="excluirFerias('${f.id}')" style="padding:3px 7px;font-size:10px;color:var(--danger)" title="Excluir">🗑</button>
            </div></td>
          </tr>`;
        }).join('') +
      '</tbody></table>';
    })()}
  </div>

  <div class="card mt-4" style="border-left:3px solid var(--warning)">
    <div class="card-header"><div class="card-title">⚠ Alertas automáticos</div></div>
    ${teamComFerias.filter(m=>{
      const months=m.since?Math.floor((Date.now()-new Date(m.since+'T00:00:00'))/(1000*60*60*24*30)):0;
      const usadosAnoAtual = (historicoPorPessoa[m._dbId] && historicoPorPessoa[m._dbId][anoAtual]) || 0;
      return months>10 && usadosAnoAtual===0;
    }).map(m=>`<div class="list-item"><div class="avatar" style="background:${m.color}">${m.init}</div><div class="list-content"><div class="list-title">${m.name} — programar férias nos próximos 60 dias</div><div class="list-meta">Prazo legal próximo (sem férias em ${anoAtual})</div></div><button class="btn btn-sm btn-primary" onclick="event.stopPropagation();openProgramarFeriasModal({profile_id:'${m._dbId||''}'})">📅 Programar</button></div>`).join('')||'<div class="text-mu text-sm">Nenhum alerta no momento.</div>'}
  </div>`;
}

// ============ CARREIRA ============
function renderCarreira(){
  return `<div class="stat-grid">
    ${statCard('Revisões trimestrais','9','programadas','M3 3v18h18')}
    ${statCard('Promoções pendentes','3','para revisão','M22 12h-4l-3 9L9 3l-3 9H2')}
    ${statCard('Aumentos sugeridos','5','este trimestre','M12 1v22')}
    ${statCard('NPS interno','9.2','+0.4','M22 11.08V12a10 10 0 1 1-5.93-9.14')}
  </div>
  <div class="section-title" style="margin-top:0">Jornada de carreira por colaborador</div>
  <div class="grid-2e">
    ${team.map((m,i)=>{const sP=m.prod>90;const sA=m.prod>88;return `<div class="card card-hover" style="cursor:pointer" onclick="perfilId=${i};equipeView='perfil';renderEquipe(document.getElementById('content'))"><div style="display:flex;align-items:center;gap:12px;margin-bottom:14px"><div class="avatar" style="background:${m.color};width:42px;height:42px;font-size:16px">${m.init}</div><div style="flex:1"><div style="font-size:14px;font-weight:700">${m.name}</div><div class="text-xs text-3">${m.role}</div></div><div style="text-align:right"><div style="font-size:18px;font-weight:700">${m.prod}%</div><div class="text-xs text-3">desempenho</div></div></div><div style="display:flex;gap:6px;flex-wrap:wrap">${sP?'<span class="badge b-success">↑ Sugerir promoção</span>':''}${sA?'<span class="badge b-info">↑ Sugerir aumento</span>':''}<span class="badge b-default">Próx. revisão: 15 jun</span></div></div>`}).join('')}
  </div>
  <div class="card mt-4">
    <div class="card-header"><div class="card-title">🔔 Lembretes automáticos</div></div>
    ${[['Revisão trimestral — todos','15 jun 2026','b-info'],['Revisão semestral — Éllen, Gabi, Heidy','01 ago 2026','b-purple'],['Revisão anual — Henrique','05 jun 2026','b-warning'],['Avaliação experiência — Haisa','12 jul 2026','b-default']].map(r=>`<div class="list-item"><div class="list-icon">🔔</div><div class="list-content"><div class="list-title">${r[0]}</div><div class="list-meta">${r[1]}</div></div><div class="list-right"><span class="badge ${r[2]}">Programado</span></div></div>`).join('')}
  </div>`;
}


async function loadTransactions(){
  if(!_supa) return [];
  const { data } = await _supa.from('transactions').select('*').order('date',{ascending:false}).limit(50);
  return data || [];
}

// ============ FINANCEIRO ============
function renderFinanceiro(c){
  const totalMrr=clients.reduce((s,c)=>s+c.mrr,0);
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Financeiro</div><div class="page-subtitle">Visão consolidada · maio/2026</div></div><div class="page-actions">${searchBar('Buscar transação...','.card table')}<button class="btn" onclick="openNovaTransacaoModal('out')">💸 Nova despesa</button><button class="btn">💸 Nova despesa</button><button class="btn btn-primary" onclick="openNovaTransacaoModal('in')">+ Nova cobrança</button></div></div>
  <div class="stat-grid">${statCard('Faturamento mês','R$ '+totalMrr.toLocaleString('pt-BR'),`${clients.length} clientes`,'M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Despesas mês','R$ 0','Cadastre despesas','M5 12h14')}${statCard('Lucro líquido','R$ '+totalMrr.toLocaleString('pt-BR'),'Sem despesas','M12 1v22')}${statCard('A receber','R$ 0','Sem cobranças','M12 8v4l3 3')}${statCard('Inadimplência','R$ 0','—','M12 9v4')}${statCard('MRR total','R$ '+totalMrr.toLocaleString('pt-BR'),`${clients.length} contratos`,'M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0')}</div>
  <div class="grid-2"><div class="card"><div class="card-header"><div class="card-title">Fluxo de caixa — 12 meses</div></div><div class="chart-box"><canvas id="cashChart"></canvas></div></div><div class="card"><div class="card-header"><div class="card-title">Categorias de despesa</div></div><div class="chart-box"><canvas id="expChart"></canvas></div></div></div>
  <div class="grid-2"><div class="card"><div class="card-header"><div class="card-title">DRE simplificado</div></div><table class="table"><tbody>
    <tr><td>Receita bruta</td><td style="text-align:right"><strong>R$ ${totalMrr.toLocaleString('pt-BR')}</strong></td></tr>
    <tr><td class="text-mu">(–) Impostos (Simples 6%)</td><td style="text-align:right;color:var(--danger-text)">R$ ${Math.round(totalMrr*.06).toLocaleString('pt-BR')}</td></tr>
    <tr><td><strong>Receita líquida</strong></td><td style="text-align:right"><strong>R$ ${Math.round(totalMrr*.94).toLocaleString('pt-BR')}</strong></td></tr>
    <tr><td class="text-mu">(–) Salários e PJs</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
    <tr><td class="text-mu">(–) Ferramentas/SaaS</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
    <tr><td class="text-mu">(–) Tráfego pago</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
    <tr><td class="text-mu">(–) Outras despesas</td><td style="text-align:right;color:var(--text-3)">R$ 0,00</td></tr>
    <tr style="background:var(--surface-2)"><td><strong>Lucro líquido</strong></td><td style="text-align:right;color:var(--success-text)"><strong>R$ ${Math.round((totalMrr-24560)*0.85).toLocaleString('pt-BR')}</strong></td></tr>
  </tbody></table></div>
  <div class="card"><div class="card-header"><div class="card-title">Próximos vencimentos</div></div>${clients.slice(0,7).map(cli=>`<div class="list-item"><div class="list-icon" style="background:${cli.color}1a;color:${cli.color}">${cli.init}</div><div class="list-content"><div class="list-title">${cli.name}</div><div class="list-meta">Vence em ${20+Math.floor(Math.random()*10)} mai</div></div><div class="list-right"><strong>R$ ${cli.mrr.toLocaleString('pt-BR')}</strong><div>${cli.status==='late'?'<span class="badge b-danger">Atrasado</span>':'<span class="badge b-warning">Pendente</span>'}</div></div></div>`).join('')}</div></div>
  </div>`;
  drawCashChart();drawExpChart();
}

function drawCashChart(){const ctx=document.getElementById('cashChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';new Chart(ctx,{type:'bar',data:{labels:['Jun','Jul','Ago','Set','Out','Nov','Dez','Jan','Fev','Mar','Abr','Mai'],datasets:[{label:'Entradas',data:[58,62,66,60,70,76,84,78,82,88,92,87],backgroundColor:isDark?'#f5f5f7':'#1d1d1f',borderRadius:4,barPercentage:.6},{label:'Saídas',data:[28,29,30,29,31,32,34,32,33,34,35,24.5],backgroundColor:isDark?'#3a3a44':'#d2d2d7',borderRadius:4,barPercentage:.6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:8}}},scales:{x:{grid:{display:false},ticks:{color:txtCol}},y:{grid:{color:gridCol},ticks:{color:txtCol,callback:v=>'R$ '+v+'k'}}}}});}
function drawExpChart(){const ctx=document.getElementById('expChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';new Chart(ctx,{type:'doughnut',data:{labels:['Equipe','Tráfego','Ferramentas','Impostos','Outras'],datasets:[{data:[16200,4500,1860,5220,2000],backgroundColor:['#1d1d1f','#7c3aed','#0ea5e9','#f59e0b','#a1a1a6'],borderColor:isDark?'#141417':'#fff',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'68%',plugins:{legend:{position:'right',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:10}}}}});}

// ============ AUTOMAÇÃO ============
function renderAutomacao(c){
  const autos=[{name:'Onboarding automático',desc:'Cliente fechou → Cria pastas, envia contrato, agenda kickoff',on:true,trig:'Cliente fechado',act:'Workspace + email'},{name:'Cobrança 3 dias antes',desc:'Lembrete WhatsApp antes do vencimento',on:true,trig:'D-3 vencimento',act:'WhatsApp'},{name:'Aniversário do cliente',desc:'Mensagem personalizada',on:true,trig:'Aniversário',act:'WhatsApp'},{name:'Conteúdo aprovado → Agendar',desc:'Quando cliente aprova, agenda no MLABS',on:true,trig:'Aprovação',act:'Agendar MLABS'},{name:'Aviso de atraso',desc:'Notifica responsável e gerente',on:true,trig:'Tarefa atrasada',act:'Email + Slack'},{name:'Relatório mensal',desc:'Gera e envia no dia 1',on:true,trig:'Dia 1 do mês',act:'PDF + envio'},{name:'Follow-up proposta',desc:'D+3 após envio',on:false,trig:'Proposta enviada',act:'WhatsApp'},{name:'Checklist diário',desc:'Gera tarefas diárias por colaborador',on:true,trig:'06:00 todo dia',act:'Criar checklist'}];
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Automação</div><div class="page-subtitle">${autos.filter(a=>a.on).length} ativas · 248 execuções no mês</div></div><div class="page-actions">${searchBar('Buscar automação...','#content')}<button class="btn" onclick="toast('Integrações','info')">🔗 Integrações</button><button class="btn btn-primary">+ Nova automação</button></div></div>
  <div class="stat-grid">${statCard('Ativas',autos.filter(a=>a.on).length,'rodando','M13 2 3 14h9l-1 8 10-12h-9l1-8z')}${statCard('Execuções','0','sem histórico','M22 11.08V12a10 10 0 1 1-5.93-9.14')}${statCard('Tempo economizado','0h','—','M12 8v4l3 3')}${statCard('Taxa sucesso','—','sem dados','M9 11l3 3L22 4')}</div>
  <div class="section-title" style="margin-top:0">Integrações conectadas</div>
  <div class="grid-4 mb-4">${[['WhatsApp','💬','on'],['Gmail','📧','on'],['Google Agenda','📅','on'],['Slack','💼','on'],['Notion','📝','off'],['MLABS','📱','on'],['ClickUp','✅','on'],['Meta Business','📘','on']].map(i=>`<div class="card" style="padding:13px;display:flex;align-items:center;gap:11px"><div style="width:34px;height:34px;border-radius:8px;background:var(--surface-2);display:grid;place-items:center;font-size:16px">${i[1]}</div><div style="flex:1"><div class="text-sm font-semi">${i[0]}</div><div class="text-xs text-3">${i[2]==='on'?'Conectado':'Desconectado'}</div></div><div class="toggle ${i[2]==='on'?'on':''}" onclick="this.classList.toggle('on');toast(this.classList.contains('on')?'Conectado':'Desconectado')"></div></div>`).join('')}</div>
  <div class="section-title">Automações ativas</div>
  ${autos.map(a=>`<div class="card mb-3" style="display:flex;align-items:center;gap:14px;padding:14px"><div style="width:38px;height:38px;border-radius:9px;background:var(--surface-2);display:grid;place-items:center;font-size:16px">⚡</div><div style="flex:1"><div style="font-size:13.5px;font-weight:600;margin-bottom:4px">${a.name}</div><div style="display:flex;gap:8px;align-items:center;font-size:11.5px;flex-wrap:wrap"><span class="text-xs text-3">QUANDO</span><span class="badge b-default">${a.trig}</span><span class="text-xs text-3">→</span><span class="text-xs text-3">ENTÃO</span><span class="badge b-default">${a.act}</span></div><div class="text-xs text-3" style="margin-top:5px">${a.desc}</div></div><div class="toggle ${a.on?'on':''}" onclick="this.classList.toggle('on');const _on=this.classList.contains('on');toast(_on?'Ativada':'Desativada');saveAutomationToggle(${autos.indexOf(a)}, _on)"></div></div>`).join('')}
  </div>`;
}

// ============ RELATÓRIOS ============
function renderRelatorios(c){
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Relatórios</div><div class="page-subtitle">Performance consolidada · maio/2026</div></div><div class="page-actions">${searchBar('Buscar...','.grid-3, .grid-2')}${searchBar('Buscar colaborador...','.card')}<button class="btn" onclick="toast('Exportando PDF…','info')">📤 PDF</button><button class="btn" onclick="toast('Exportando Excel…','info')">📊 Excel</button><button class="btn btn-primary">+ Novo</button></div></div>
  <div class="filter-bar"><span class="filter-chip active">Todos clientes</span><span class="filter-chip">7 dias</span><span class="filter-chip active">30 dias</span><span class="filter-chip">YTD</span><span style="margin-left:auto" class="text-xs text-3">🤖 Gerado automaticamente</span></div>
  <div class="stat-grid">${statCard('Alcance','—','conecte redes','M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Engajamento','—','conecte redes','M22 11.08V12a10 10 0 1 1-5.93-9.14')}${statCard('Leads','0','sem dados','M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2')}${statCard('Conversões','0','sem dados','M9 11l3 3L22 4')}${statCard('ROI','—','sem dados','M3 3v18h18')}${statCard('Seguidores','—','conecte redes','M16 21v-2')}</div>
  <div class="grid-2"><div class="card"><div class="card-header"><div class="card-title">Crescimento de seguidores</div></div><div class="chart-box"><canvas id="growChart"></canvas></div></div><div class="card"><div class="card-header"><div class="card-title">Performance por plataforma</div></div><div class="chart-box"><canvas id="platChart"></canvas></div></div></div>
  <div class="grid-3"><div class="card"><div class="card-header"><div class="card-title">🏆 Top conteúdos</div></div><div class="empty-state"><div class="ico">📊</div><div class="ttl">Sem dados</div><div class="desc">Conecte suas redes sociais para ver métricas.</div></div></div>
  <div class="card"><div class="card-header"><div class="card-title">💰 ROI por cliente</div></div><div class="empty-state"><div class="ico">💰</div><div class="ttl">Sem dados</div><div class="desc">ROI aparecerá quando houver dados.</div></div></div>
  <div class="card"><div class="card-header"><div class="card-title">📑 Prontos</div></div>${[['Mensal abril','PDF','3.2 MB'],['Q1 2026','PDF','5.8 MB'],['Concorrência','PDF','2.1 MB'],['Tráfego','Excel','1.4 MB']].map(r=>`<div class="list-item"><div class="list-icon">📄</div><div class="list-content"><div class="list-title">${r[0]}</div><div class="list-meta">${r[1]} · ${r[2]}</div></div><div class="list-right"><button class="btn btn-sm" onclick="toast('Baixando…','info')">Baixar</button></div></div>`).join('')}</div></div>
  </div>`;
  drawGrowChart();drawPlatChart();
}
function drawGrowChart(){const ctx=document.getElementById('growChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';new Chart(ctx,{type:'line',data:{labels:['S1','S2','S3','S4','S5','S6','S7','S8','S9','S10','S11','S12'],datasets:[{label:'Instagram',data:[2100,2400,2900,3200,3800,4100,4600,5200,5800,6400,7100,8400],borderColor:isDark?'#f5f5f7':'#1d1d1f',backgroundColor:isDark?'rgba(245,245,247,.1)':'rgba(29,29,31,.06)',fill:true,tension:.4,borderWidth:2,pointRadius:0},{label:'TikTok',data:[800,1100,1500,2000,2400,2900,3200,3600,4000,4500,4900,5400],borderColor:'#7c3aed',tension:.4,borderWidth:2,pointRadius:0,borderDash:[4,4]},{label:'LinkedIn',data:[300,400,450,520,580,640,710,780,840,920,1010,1100],borderColor:'#0ea5e9',tension:.4,borderWidth:2,pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:8}}},scales:{x:{grid:{display:false},ticks:{color:txtCol}},y:{grid:{color:gridCol},ticks:{color:txtCol}}}}});}
function drawPlatChart(){const ctx=document.getElementById('platChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';new Chart(ctx,{type:'bar',data:{labels:['Instagram','Reels','Stories','TikTok','LinkedIn','YouTube'],datasets:[{data:[420,380,180,220,40,80],backgroundColor:isDark?'#f5f5f7':'#1d1d1f',borderRadius:5}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:gridCol},ticks:{color:txtCol}},y:{grid:{display:false},ticks:{color:txtCol}}}}});}

