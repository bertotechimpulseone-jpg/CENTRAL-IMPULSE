// ============ TOAST ============
function toast(msg,type='success'){
  const wrap = document.getElementById('toastWrap');
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<span>${type==='success'?'✓':type==='info'?'ℹ':'!'}</span><span>${msg}</span>`;
  wrap.appendChild(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transform='translateY(10px)';setTimeout(()=>t.remove(),250)},2400);
}

// =========== Filtro DOM genérico para todas as páginas ===========
function pageFilter(input, selector){
  const q = (input.value||'').toLowerCase();
  const container = document.querySelector(selector);
  if(!container) return;
  let shown = 0, total = 0;
  container.querySelectorAll('[data-search]').forEach(el=>{
    total++;
    const match = el.dataset.search.toLowerCase().includes(q);
    el.style.display = match ? '' : 'none';
    if(match) shown++;
  });
  const emptyId = container.id+'_empty';
  let empty = document.getElementById(emptyId);
  if(!empty && total>0){
    empty = document.createElement('div');
    empty.id = emptyId;
    empty.className = 'empty-state';
    empty.innerHTML = '<div class="ico">🔍</div><div class="ttl">Nada encontrado</div><div class="desc">Ajuste o termo de busca.</div>';
    container.parentNode.insertBefore(empty, container.nextSibling);
  }
  if(empty) empty.style.display = shown===0&&q?'':'none';
}
function searchBar(placeholder, selector){
  return `<div class="page-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder="${placeholder}" oninput="pageFilter(this,'${selector}')"/></div>`;
}

function copy(txt,label='Copiado'){navigator.clipboard.writeText(txt);toast(`${label}: ${txt}`)}
function openLink(url){
  if(!url){ toast('Link vazio','info'); return; }
  // Detecta data URL (base64) — converte pra Blob URL pra abrir corretamente
  if(typeof url === 'string' && url.startsWith('data:')){
    return openDataUrlAsBlob(url);
  }
  window.open(url,'_blank');
  toast('Abrindo em nova aba…','info');
}

// Converte um data URL em Blob URL e abre numa nova aba (resolve limite de tamanho da URL)
function openDataUrlAsBlob(dataUrl, nomeArquivo){
  try {
    const match = dataUrl.match(/^data:([^;]+);base64,(.*)$/);
    if(!match){
      window.open(dataUrl, '_blank');
      return;
    }
    const mime = match[1];
    const base64 = match[2];
    const binary = atob(base64);
    const bytes = new Uint8Array(binary.length);
    for(let i=0;i<binary.length;i++) bytes[i] = binary.charCodeAt(i);
    const blob = new Blob([bytes], {type: mime});
    const blobUrl = URL.createObjectURL(blob);
    // Abre em nova aba
    const w = window.open(blobUrl, '_blank');
    if(!w){
      // Popup bloqueado — força download
      const a = document.createElement('a');
      a.href = blobUrl;
      a.download = nomeArquivo || ('anexo.' + (mime.split('/')[1] || 'bin'));
      document.body.appendChild(a);
      a.click();
      a.remove();
      toast('Bloqueado pelo navegador — baixando arquivo','info');
    } else {
      toast('Abrindo anexo…','info');
    }
    // Limpa o Blob URL depois de 60s
    setTimeout(()=>URL.revokeObjectURL(blobUrl), 60000);
  } catch(e){
    console.error('[openDataUrlAsBlob]', e);
    toast('Erro ao abrir anexo: '+e.message,'info');
  }
}
function whatsApp(phone,name){const clean=(phone||'').replace(/\D/g,'');if(!clean){toast('Telefone invalido','info');return;}openLink(`https://wa.me/${clean}`)}



