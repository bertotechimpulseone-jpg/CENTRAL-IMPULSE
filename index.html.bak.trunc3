      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:space-between">
        <button class="btn" onclick="excluirUsuario('${p.id}','${p.full_name.replace(/'/g,"\\'")}')" style="color:var(--danger)">🗑 Excluir usuário</button>
        <div style="display:flex;gap:8px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn btn-primary" onclick="salvarEditUsuario('${p.id}')">Salvar alterações</button></div>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function salvarEditUsuario(id){
  const role = document.getElementById('euRole').value;
  const enabled = document.getElementById('euEnabled').value === 'true';
  const perms = Array.from(document.querySelectorAll('.eperm-chk:checked')).map(x=>x.value);
  await _supa.from('profiles').update({role, permissions: perms, enabled}).eq('id', id);
  toast('✓ Permissões atualizadas','success');
  closeModal();
  renderUsuarios(document.getElementById('content'));
}





async function updateStoredPwd(profileId, value){
  if(!_supa) return;
  await _supa.from('profiles').update({stored_password_hint: value}).eq('id', profileId);
  toast('📝 Anotação salva (a senha REAL não muda — use "Editar → Enviar reset" pra trocar de verdade)','info');
}

// Abre a página de Authentication/Users do projeto no Supabase
function abrirSupabaseUsuarios(emailFiltro){
  const projetoRef = 'pzqxceqtnsmpsiaejhjw'; // ref do seu projeto
  const url = `https://supabase.com/dashboard/project/${projetoRef}/auth/users`;
  window.open(url, '_blank');
  if(emailFiltro){
    setTimeout(()=>{
      navigator.clipboard.writeText(emailFiltro);
      toast('Email "'+emailFiltro+'" copiado — cole na busca do Supabase','info');
    }, 200);
  }
}

// NOVO: troca a senha DIRETAMENTE via função SQL admin (sem email)
// Funciona desde que você tenha rodado o SQL 20-admin-trocar-senha.sql
async function trocarSenhaDireta(profileId, emailAlvo){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  if(!emailAlvo || !emailAlvo.includes('@')){ toast('Email do usuário inválido','info'); return; }
  // Pega o input ou pede via prompt
  let novaSenha = '';
  const inp = document.getElementById('euNovaSenha');
  if(inp && inp.value && inp.value.length >= 6){
    novaSenha = inp.value.trim();
  } else {
    novaSenha = prompt('Nova senha pra '+emailAlvo+' (mínimo 6 caracteres):', 'impulse2026') || '';
  }
  if(!novaSenha || novaSenha.length < 6){ toast('Senha precisa ter no mínimo 6 caracteres','info'); return; }
  try {
    const { data, error } = await _supa.rpc('admin_set_password', {
      target_email: emailAlvo,
      new_password: novaSenha
    });
    if(error){
      // Função pode não existir ainda
      if(error.message && error.message.toLowerCase().includes('does not exist')){
        alert('⚠ A função do banco ainda não existe.\n\nVai no Supabase → SQL Editor → cola o conteúdo do arquivo:\nsql/20-admin-trocar-senha.sql\n\nDepois roda e tenta novamente aqui.');
        return;
      }
      toast('Erro: '+error.message,'info');
      console.error('[adminSetPwd]', error);
      return;
    }
    if(typeof data === 'string' && data.startsWith('erro:')){
      toast(data, 'info');
      alert('❌ '+data+'\n\nVerifique se:\n- Você está logado como admin (vini@...)\n- O email '+emailAlvo+' existe no Authentication\n- A função SQL foi criada (rode 20-admin-trocar-senha.sql)');
      return;
    }
    toast('✓ Senha trocada com sucesso!','success');
    alert('✅ SENHA ALTERADA\n\nUsuário: ' + emailAlvo + '\nNova senha: ' + novaSenha + '\n\nO usuário já pode fazer login com a nova senha.');
    // Re-renderiza pra atualizar o hint
    renderUsuarios(document.getElementById('content'));
  } catch(e){
    toast('Erro: '+e.message,'info');
    console.error(e);
  }
}

// MÉTODO POR EMAIL (mantido como backup, mas só funciona se o email for real)
async function trocarSenhaUsuario(profileId, novaEmail){
  return trocarSenhaDireta(profileId, novaEmail);
}

// Define nova senha DIRETO no Supabase (só funciona se a senha do USUÁRIO ATUAL — você logado)
// Útil quando você quer trocar SUA PRÓPRIA senha sem email
async function trocarMinhaSenha(){
  if(!_supa){ toast('Supabase necessario','info'); return; }
  const novaSenha = prompt('Sua nova senha (mínimo 6 caracteres):');
  if(!novaSenha || novaSenha.length < 6){ toast('Senha inválida','info'); return; }
  try {
    const { error } = await _supa.auth.updateUser({password: novaSenha});
    if(error){ toast('Erro: '+error.message,'info'); return; }
    toast('✓ Sua senha foi alterada','success');
    // Salva como hint no próprio profile
    if(_currentProfile && _currentProfile.id){
      await _supa.from('profiles').update({stored_password_hint: novaSenha}).eq('id', _currentProfile.id);
    }
  } catch(e){
    toast('Erro: '+e.message,'info');
  }
}

// Atualiza a anotação de senha (NÃO troca a senha real — só pra você lembrar)
async function salvarAnotacaoSenha(profileId, novaSenha){
  if(!_supa){ toast('Supabase necessario','info'); return; }
  if(!novaSenha){ toast('Digite uma senha','info'); return; }
  try {
    const { error } = await _supa.from('profiles').update({stored_password_hint: novaSenha}).eq('id', profileId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
    toast('✓ Anotação atualizada (a senha REAL não mudou)','success');
  } catch(e){ toast('Erro: '+e.message,'info'); }
}



async function criarLoginRapido(profileId, nomeCompleto){
  if(!_supa){toast('Supabase necessario','info');return}
  console.log('[CRIAR LOGIN] iniciando para:', nomeCompleto, 'profileId:', profileId);
  
  // Gera email do nome
  const firstName = nomeCompleto.split(' ')[0].toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/[^a-z]/g,'');
  let email = firstName + '@impulseone.com.br';
  const senhaPadrao = 'impulse2026';
  
  toast('Criando login para ' + nomeCompleto + '...', 'info');
  
  // Tenta criar conta no Auth
  try {
    console.log('[CRIAR LOGIN] tentando signUp:', email);
    let { data, error } = await _supa.auth.signUp({email, password: senhaPadrao});
    console.log('[CRIAR LOGIN] resposta signUp:', {data, error});
    
    if(error){
      if(error.message && error.message.includes('already')){
        // Email ja existe. Tenta com sufixo
        const altEmail = firstName + '.' + nomeCompleto.split(' ').slice(-1)[0].toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
          .replace(/[^a-z]/g,'') + '@impulseone.com.br';
        console.log('[CRIAR LOGIN] email duplicado, tentando alternativo:', altEmail);
        const r2 = await _supa.auth.signUp({email: altEmail, password: senhaPadrao});
        if(r2.error){
          alert('❌ ERRO 1: ' + error.message + '\n❌ ERRO 2 (com email alternativo): ' + r2.error.message + '\n\nSugestão: vai no Supabase → Authentication → Users → busca por "' + firstName + '" → DELETA o usuario existente → tenta de novo aqui.');
          return;
        }
        email = altEmail;
        data = r2.data;
      } else if(error.message && error.message.includes('confirm')){
        alert('⚠ Email Confirmation ainda ativo no Supabase!\n\nVai em: Supabase → Authentication → Sign In / Providers → Email → DESLIGA "Confirm email" → Save.\n\nDepois tenta de novo aqui.');
        return;
      } else {
        alert('❌ ERRO: ' + error.message + '\n\nCole esse erro no chat pra ajuda.');
        return;
      }
    }
    
    if(!data || !data.user){
      alert('Resposta vazia do Supabase. Verifique no console (F12).');
      console.error('[CRIAR LOGIN] data vazio:', data);
      return;
    }
    
    // Atualiza profile com email + dados
    console.log('[CRIAR LOGIN] atualizando profile com email:', email);
    const { error: updErr } = await _supa.from('profiles').update({
      email,
      auth_user_id: data.user.id,
      stored_password_hint: senhaPadrao
    }).eq('id', profileId);
    
    if(updErr){
      alert('Login criado mas erro ao salvar email no profile: ' + updErr.message);
      console.error('[CRIAR LOGIN] erro update profile:', updErr);
      return;
    }
    
    alert('✅ LOGIN CRIADO!\n\nEmail: ' + email + '\nSenha: ' + senhaPadrao + '\n\n⚠ IMPORTANTE: Se o login nao funcionar, va no Supabase:\nAuthentication → Settings → DESMARQUE "Enable email confirmations"\n\nOu confirme manualmente: Authentication → Users → 3 pontinhos do usuario → Confirm user');
    renderUsuarios(document.getElementById('content'));
  } catch(e){
    console.error('[CRIAR LOGIN] exception:', e);
    alert('❌ EXCEPTION: ' + e.message + '\n\nCole esse erro no chat.');
  }
}


async function excluirUsuario(id, name){
  if(!(await confirmDelete('usuário: ' + name, {aviso:'Isso vai apagar o perfil e os dados relacionados.'}))) return;
  await _supa.from('profiles').delete().eq('id', id);
  toast(`Usuário "${name}" excluído`,'success');
  closeModal();
  renderUsuarios(document.getElementById('content'));
}


// Retorna a primeira página que o usuário logado tem acesso
function getFirstAccessiblePage(){
  // Admin ou gestor: vai pro dashboard direto
  if(isAdmin() || isGestor()) return 'dashboard';
  // Sem profile carregado: dashboard como fallback
  if(!_currentProfile) return 'dashboard';
  // Tenta dashboard primeiro (se tiver permissão)
  if(canAccess('dashboard')) return 'dashboard';
  // Senão, busca a primeira aba acessível na ordem do menu
  for(const group of navItems){
    for(const item of group.items){
      if(item.adminOnly && !isAdmin()) continue;
      if(item.gestorOnly && !isGestor()) continue;
      // Pagamentos: aberto pra qualquer colaborador autenticado (admin fin ve geral, resto so o proprio)
      if(canAccess(item.id)) return item.id;
    }
  }
  return 'dashboard'; // fallback
}

// ============ PAGAMENTOS (planilha por colaborador) ============
let _pagamentos = [];
let _pagamentosCarregados = false;  // evita loop infinito
let _pagFilterCollab = 'all'; // dbId ou 'all'
let _pagFilterStatus = 'all'; // 'all' | 'pago' | 'pendente'
let _pagFilterAno = new Date().getFullYear();
let _pagFilterMes = 'all'; // 'all' | '01' a '12'
let _pagamentosFixos = [];
let _colaboradorPagamentos = [];

async function loadColaboradorPagamentos(){
  if(!_supa){ _colaboradorPagamentos = []; return []; }
  try {
    const { data, error } = await _supa.from('colaborador_pagamentos').select('*').order('mes_ref', {ascending: false}).order('created_at', {ascending: false});
    if(error){
      console.warn('[loadColaboradorPagamentos]', error);
      _colaboradorPagamentos = [];
      return [];
    }
    _colaboradorPagamentos = data || [];
    console.log('[loadColaboradorPagamentos] ' + _colaboradorPagamentos.length + ' registro(s)');
    return _colaboradorPagamentos;
  } catch(e){ console.error('[loadColaboradorPagamentos]', e); _colaboradorPagamentos = []; return []; }
}
let _pagFixosCarregados = false;

async function loadPagamentosFixos(){
  _pagFixosCarregados = true;
  if(!_supa) return [];
  try {
    const { data, error } = await _supa.from('pagamentos_fixos').select('*').order('ordem', {ascending:true}).order('nome', {ascending:true});
    if(error){ console.warn('[loadPagamentosFixos]', error); _pagamentosFixos = []; return []; }
    _pagamentosFixos = data || [];
    return _pagamentosFixos;
  } catch(e){ console.error(e); return []; }
}

async function addPagamentoFixo(){
  if(!_supa){ toast('Supabase necessário','info'); return; }
  if(!isGestor()){ toast('🔒 Apenas admin/gestor pode adicionar','info'); return; }
  const novo = {nome: 'Novo pagamento fixo', valor: 0, ativo: true};
  const { data, error } = await _supa.from('pagamentos_fixos').insert(novo).select().single();
  if(error){ toast('Erro: '+error.message,'info'); return; }
  _pagamentosFixos.push(data);
  toast('✓ Adicionado','success');
  renderPagamentos(document.getElementById('content'));
}

async function updatePagamentoFixo(id, campo, valor){
  if(!isGestor()){ toast('🔒 Apenas admin/gestor pode editar','info'); return; }
  const p = _pagamentosFixos.find(x => x.id === id);
  if(!p) return;
  p[campo] = valor;
  if(_supa){
    const { error } = await _supa.from('pagamentos_fixos').update({[campo]: valor, updated_at: new Date().toISOString()}).eq('id', id);
    if(error){ console.warn(error); toast('Erro: '+error.message,'info'); return; }
  }
  // Re-renderizar pra atualizar o total geral
  if(campo === 'valor' || campo === 'ativo'){
    renderPagamentos(document.getElementById('content'));
  }
}

async function excluirPagamentoFixo(id){
  if(!isGestor()){ toast('🔒 Apenas admin/gestor pode excluir','info'); return; }
  if(!(await confirmDelete('pagamento fixo'))) return;
  if(_supa){
    const { error } = await _supa.from('pagamentos_fixos').delete().eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  _pagamentosFixos = _pagamentosFixos.filter(p => p.id !== id);
  renderPagamentos(document.getElementById('content'));
  toast('Pagamento fixo excluido','success');
}

// ============ LEMBRETES (widget flutuante) ============
if(typeof _lembretes === 'undefined') var _lembretes = [];

async function loadLembretes(){
  if(!_supa) return;
  try {
    // PRIVACIDADE: cada colaborador ve SOMENTE os proprios lembretes
    const meuId = (typeof _currentProfile !== 'undefined' && _currentProfile && _currentProfile.id) ? _currentProfile.id : null;
    if(!meuId){
      // Sem profile carregado ainda — nao carrega nada (evita vazamento)
      _lembretes = [];
      const badge0 = document.getElementById('lembretesBadge');
      if(badge0) badge0.style.display = 'none';
      renderLembretesList();
      return;
    }
    const { data, error } = await _supa.from('lembretes')
      .select('*')
      .eq('profile_id', meuId)
      .order('data_hora',{ascending:true});
    if(error){ console.warn('[loadLembretes]', error); _lembretes = []; renderLembretesList(); return; }
    if(data){
      _lembretes = data;
      const pendentes = _lembretes.filter(l => !l.done).length;
      const badge = document.getElementById('lembretesBadge');
      const subtitle = document.getElementById('lembretesSubtitle');
      if(badge){ badge.textContent = pendentes; badge.style.display = pendentes>0 ? 'inline-flex' : 'none'; }
      if(subtitle) subtitle.textContent = pendentes + ' pendente' + (pendentes!==1 ? 's' : '');
      renderLembretesList();
    }
  } catch(e){ console.warn('[loadLembretes]', e); }
}

function renderLembretesList(){
  const wrap = document.getElementById('lembretesList');
  if(!wrap) return;
  const pendentes = _lembretes.filter(l => !l.done).sort((a,b) => (a.data_hora||'').localeCompare(b.data_hora||''));
  if(pendentes.length === 0){
    wrap.innerHTML = '<div style="padding:30px 14px;text-align:center;color:var(--text-3);font-size:13px">🎉 Nenhum lembrete pendente</div>';
    return;
  }
  const hojeISO = new Date().toISOString().slice(0,10);
  const agoraMs = Date.now();
  wrap.innerHTML = pendentes.map(l => {
    const dt = l.data_hora ? new Date(l.data_hora) : null;
    const dataFmt = dt ? dt.toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : '';
    // Status temporal: atrasado / hoje / futuro
    let badge = '';
    let cor = 'var(--text-3)';
    if(dt){
      const diff = dt.getTime() - agoraMs;
      const diffDias = Math.floor(diff / 86400000);
      const isHoje = dt.toISOString().slice(0,10) === hojeISO;
      if(diff < 0){ badge = '<span style="color:var(--danger);font-weight:600">⚠ Atrasado</span> · '; cor = 'var(--danger)'; }
      else if(isHoje){ badge = '<span style="color:#f59e0b;font-weight:600">🔥 Hoje</span> · '; cor = '#f59e0b'; }
      else if(diffDias <= 1){ badge = '<span style="color:#f59e0b;font-weight:600">Amanhã</span> · '; }
      else if(diffDias <= 7){ badge = '<span style="color:#0ea5e9;font-weight:600">em ' + (diffDias+1) + 'd</span> · '; }
    }
    return '<div style="display:flex;align-items:flex-start;gap:10px;padding:10px 8px;border-bottom:1px solid var(--border);transition:.15s" onmouseover="this.style.background=\'var(--surface-2)\'" onmouseout="this.style.background=\'\'">' +
      '<input type="checkbox" onchange="toggleLembrete(\'' + l.id + '\')" style="margin-top:3px;cursor:pointer" title="Marcar como concluido" />' +
      '<div style="flex:1;cursor:pointer" onclick="addLembrete(\'' + l.id + '\')" title="Clique pra editar">' +
        '<div style="font-size:13px;font-weight:500">' + escapeHtml(l.texto||'') + '</div>' +
        '<div class="text-xs" style="margin-top:3px;color:' + cor + '">' + badge + '⏰ ' + dataFmt + '</div>' +
      '</div>' +
      '<button class="icon-btn" onclick="event.stopPropagation();excluirLembrete(\'' + l.id + '\')" title="Excluir" style="width:24px;height:24px;font-size:13px;color:var(--danger)">×</button>' +
      '</div>';
  }).join('');
}

function openLembretesWidget(){
  const w = document.getElementById('lembretesWidget');
  if(!w) return;
  const isOpen = w.style.display && w.style.display !== 'none';
  w.style.display = isOpen ? 'none' : 'flex';
  if(!isOpen) renderLembretesList();
}

function closeLembretesWidget(){
  const w = document.getElementById('lembretesWidget');
  if(w) w.style.display = 'none';
}

// Abre modal de criar/editar lembrete
function addLembrete(lembreteId){
  const l = lembreteId ? (_lembretes||[]).find(x => x.id === lembreteId) : null;
  let modal = document.getElementById('lembreteModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'lembreteModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (e) => { if(e.target === modal) modal.remove(); };

  // Pre-preencher data/hora
  let dataInit = '', horaInit = '';
  if(l && l.data_hora){
    const dt = new Date(l.data_hora);
    dataInit = dt.toISOString().slice(0,10);
    horaInit = dt.toTimeString().slice(0,5);
  } else {
    // Default: amanha 09:00
    const amanha = new Date(); amanha.setDate(amanha.getDate()+1);
    dataInit = amanha.toISOString().slice(0,10);
    horaInit = '09:00';
  }

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:480px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:36px;height:36px;border-radius:9px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:17px">🔔</div>' +
        '<div style="flex:1"><div style="font-size:15px;font-weight:700">' + (l ? 'Editar lembrete' : 'Novo lembrete') + '</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'lembreteModal\').remove()" style="width:30px;height:30px;font-size:18px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px;display:flex;flex-direction:column;gap:14px">' +
        '<input type="hidden" id="lbId" value="' + (l ? l.id : '') + '" />' +
        '<div>' +
          '<div class="info-label" style="margin-bottom:6px">Descrição do lembrete *</div>' +
          '<textarea id="lbTexto" class="login-input" rows="3" placeholder="ex: Ligar pro cliente X · enviar proposta · revisar contrato" style="background:var(--surface-2);resize:vertical;font-family:inherit;font-size:13.5px;min-height:72px">' + (l ? (l.texto || '').replace(/</g,'&lt;') : '') + '</textarea>' +
        '</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Data do prazo *</div>' +
            '<input type="date" id="lbData" class="login-input" value="' + dataInit + '" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Hora</div>' +
            '<input type="time" id="lbHora" class="login-input" value="' + horaInit + '" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        (l ? '<label style="display:flex;gap:8px;align-items:center;font-size:13px;padding:8px 10px;background:var(--surface-2);border-radius:8px;cursor:pointer"><input type="checkbox" id="lbDone" ' + (l.done?'checked':'') + ' /> Marcar como concluído</label>' : '') +
        '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:6px">' +
          (l ? '<button class="btn" onclick="excluirLembrete(\'' + l.id + '\');document.getElementById(\'lembreteModal\').remove()" style="color:var(--danger);border-color:var(--danger);margin-right:auto">🗑 Excluir</button>' : '') +
          '<button class="btn" onclick="document.getElementById(\'lembreteModal\').remove()">Cancelar</button>' +
          '<button class="btn btn-primary" id="lbSave" onclick="salvarLembrete()">' + (l ? 'Salvar' : '+ Criar lembrete') + '</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
  setTimeout(() => { const t = document.getElementById('lbTexto'); if(t) t.focus(); }, 80);
}
window.addLembrete = addLembrete;

async function salvarLembrete(){
  const btn = document.getElementById('lbSave');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Salvando...'; }
  try {
    const id = document.getElementById('lbId').value || null;
    const texto = (document.getElementById('lbTexto').value || '').trim();
    const data = document.getElementById('lbData').value;
    const hora = document.getElementById('lbHora').value || '09:00';
    if(!texto){ toast('Informe a descricao','info'); if(btn){btn.disabled=false;btn.textContent='+ Criar lembrete';} return; }
    if(!data){ toast('Informe a data','info'); if(btn){btn.disabled=false;btn.textContent='+ Criar lembrete';} return; }
    const data_hora = new Date(data + 'T' + hora + ':00').toISOString();
    const doneEl = document.getElementById('lbDone');
    const done = doneEl ? doneEl.checked : false;

    if(_supa && _currentProfile){
      if(id){
        const { error } = await _supa.from('lembretes').update({texto, data_hora, done}).eq('id', id);
        if(error) throw error;
      } else {
        const { error } = await _supa.from('lembretes').insert({texto, data_hora, profile_id: _currentProfile.id, done: false});
        if(error) throw error;
      }
    } else {
      // Fallback local (sem supabase)
      if(id){
        const l = (_lembretes||[]).find(x => x.id === id);
        if(l){ l.texto = texto; l.data_hora = data_hora; l.done = done; }
      } else {
        _lembretes.push({id: 'tmp-'+Date.now(), texto, data_hora, done: false});
      }
    }
    document.getElementById('lembreteModal').remove();
    await loadLembretes();
    toast(id ? '✓ Lembrete atualizado' : '✓ Lembrete criado', 'success');
  } catch(e){
    console.error('[salvarLembrete]', e);
    toast('Erro: ' + (e.message||e), 'info');
    if(btn){ btn.disabled = false; btn.textContent = '+ Criar lembrete'; }
  }
}
window.salvarLembrete = salvarLembrete;

async function toggleLembrete(id){
  const l = _lembretes.find(x => x.id === id);
  if(!l) return;
  l.done = !l.done;
  if(_supa) await _supa.from('lembretes').update({done: l.done}).eq('id', id);
  await loadLembretes();
}

async function excluirLembrete(id){
  if(!(await confirmDelete('lembrete'))) return;
  if(_supa) await _supa.from('lembretes').delete().eq('id', id);
  _lembretes = _lembretes.filter(l => l.id !== id);
  await loadLembretes();
}

// ============ EVENTOS DO CALENDARIO ============
if(typeof _eventosCalendario === 'undefined') var _eventosCalendario = [];

function tipoEventoInfo(tipo){
  const map = {
    reuniao:{icon:'📹',label:'Reunião',cor:'#0ea5e9'},
    evento:{icon:'📌',label:'Evento',cor:'#8b5cf6'},
    treinamento:{icon:'🎓',label:'Treinamento',cor:'#22c55e'},
    prazo:{icon:'⚠',label:'Prazo',cor:'#ef4444'},
    tarefa:{icon:'✅',label:'Tarefa',cor:'#f59e0b'},
    outro:{icon:'📅',label:'Outro',cor:'#6b7280'}
  };
  return map[tipo] || map.outro;
}

async function loadEventosCalendario(){
  if(!_supa) return;
  try {
    const { data, error } = await _supa.from('eventos_calendario').select('*').order('data_inicio',{ascending:true});
    if(!error && data) _eventosCalendario = data;
  } catch(e){ console.warn('[loadEventosCalendario]', e); }
}

function openEventoModal(id){
  const e = id ? _eventosCalendario.find(x => x.id === id) : null;
  if(id && !e){ toast('Evento nao encontrado','info'); return; }
  const data = e || {};
  const tipo = data.tipo || 'evento';
  const cor = data.cor || tipoEventoInfo(tipo).cor;

  let modal = document.getElementById('eventoModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'eventoModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  const tipos = ['reuniao','evento','treinamento','prazo','tarefa','outro'];
  const esc = (v) => (v||'').toString().replace(/"/g,'&quot;');

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:560px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:38px;height:38px;border-radius:9px;background:' + cor + ';color:#fff;display:grid;place-items:center;font-size:18px">' + tipoEventoInfo(tipo).icon + '</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">' + (id?'Editar evento':'Novo evento') + '</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'eventoModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px;display:flex;flex-direction:column;gap:12px">' +
        '<div><div class="info-label" style="margin-bottom:5px">Título *</div><input id="evTitulo" class="login-input" value="' + esc(data.titulo) + '" style="background:var(--surface-2)" /></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Data *</div><input id="evData" class="login-input" type="date" value="' + (data.data_inicio||'') + '" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Hora</div><input id="evHora" class="login-input" type="time" value="' + (data.hora||'') + '" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Tipo</div><div style="display:flex;gap:6px;flex-wrap:wrap">' +
          tipos.map(t => '<label style="display:flex;align-items:center;gap:4px;padding:6px 10px;background:var(--surface-2);border-radius:7px;cursor:pointer;font-size:12px;border:1px solid var(--border)"><input type="radio" name="evTipo" value="' + t + '" ' + (tipo===t?'checked':'') + ' /> ' + tipoEventoInfo(t).icon + ' ' + tipoEventoInfo(t).label + '</label>').join('') +
        '</div></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Cor</div><input id="evCor" class="login-input" type="color" value="' + cor + '" style="height:36px;padding:2px;background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Cliente</div><select id="evCliente" class="login-input" style="background:var(--surface-2)"><option value="">— Nenhum —</option>' + clients.map(c => '<option value="' + c._dbId + '" ' + (data.client_id===c._dbId?'selected':'') + '>' + c.name + '</option>').join('') + '</select></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Local</div><input id="evLocal" class="login-input" value="' + esc(data.local) + '" placeholder="Sala / Endereço / Meet" style="background:var(--surface-2)" /></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Link</div><input id="evLink" class="login-input" value="' + esc(data.link) + '" placeholder="https://meet.google.com/..." style="background:var(--surface-2)" /></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Descrição</div><textarea id="evDesc" class="login-input" rows="2" style="background:var(--surface-2);resize:vertical;min-height:50px">' + (data.descricao||'') + '</textarea></div>' +
        '<label style="display:flex;gap:8px;align-items:center;font-size:12.5px"><input type="checkbox" id="evNotificar" ' + (data.notificar!==false?'checked':'') + ' /> Criar lembrete automático no dia do evento</label>' +
      '</div>' +
      '<div style="padding:16px 24px 22px;display:flex;gap:8px;justify-content:' + (id?'space-between':'flex-end') + ';align-items:center;border-top:1px solid var(--border)">' +
        (id ? '<button class="btn" onclick="excluirEvento(\'' + id + '\')" style="color:var(--danger);border-color:var(--danger)">🗑 Excluir</button>' : '') +
        '<div style="display:flex;gap:8px">' +
          '<button class="btn" onclick="document.getElementById(\'eventoModal\').remove()">Cancelar</button>' +
          '<button class="btn btn-primary" onclick="salvarEvento(' + (id ? "'" + id + "'" : 'null') + ')">💾 Salvar</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function salvarEvento(id){
  const titulo = (document.getElementById('evTitulo').value||'').trim();
  if(!titulo){ toast('Informe o titulo','info'); return; }
  const data_inicio = document.getElementById('evData').value;
  if(!data_inicio){ toast('Informe a data','info'); return; }
  const hora = document.getElementById('evHora').value || null;
  const tipoEl = document.querySelector('input[name="evTipo"]:checked');
  const tipo = tipoEl ? tipoEl.value : 'evento';
  const cor = document.getElementById('evCor').value;
  const local = (document.getElementById('evLocal').value||'').trim() || null;
  const link = (document.getElementById('evLink').value||'').trim() || null;
  const client_id = document.getElementById('evCliente').value || null;
  const descricao = (document.getElementById('evDesc').value||'').trim() || null;
  const notificar = document.getElementById('evNotificar').checked;
  const payload = {titulo, data_inicio, hora, tipo, cor, local, link, client_id, descricao, notificar, updated_at: new Date().toISOString()};
  if(typeof _currentProfile !== 'undefined' && _currentProfile && _currentProfile.id) payload.profile_id = _currentProfile.id;

  if(id){
    if(_supa){
      const { error } = await _supa.from('eventos_calendario').update(payload).eq('id', id);
      if(error){ toast('Erro: '+error.message,'info'); return; }
    }
    const idx = _eventosCalendario.findIndex(x => x.id === id);
    if(idx >= 0) Object.assign(_eventosCalendario[idx], payload);
  } else {
    if(_supa){
      const { data, error } = await _supa.from('eventos_calendario').insert(payload).select().single();
      if(error){ toast('Erro: '+error.message,'info'); return; }
      _eventosCalendario.push(data);
    } else {
      _eventosCalendario.push(Object.assign({}, payload, {id: 'tmp-'+Date.now()}));
    }
  }
  const m = document.getElementById('eventoModal'); if(m) m.remove();
  toast('Evento salvo','success');
  if(typeof currentPage !== 'undefined' && currentPage === 'calendario' && typeof renderCalendario === 'function') renderCalendario(document.getElementById('content'));
}

async function excluirEvento(id){
  if(!(await confirmDelete('evento'))) return;
  if(_supa){
    const { error } = await _supa.from('eventos_calendario').delete().eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  _eventosCalendario = _eventosCalendario.filter(e => e.id !== id);
  const m = document.getElementById('eventoModal'); if(m) m.remove();
  toast('Evento excluido','success');
  if(typeof currentPage !== 'undefined' && currentPage === 'calendario' && typeof renderCalendario === 'function') renderCalendario(document.getElementById('content'));
}

// ============ TRAFEGO PAGO ============
if(typeof _campanhas === 'undefined') var _campanhas = [];

async function loadCampanhas(){
  if(!_supa){ _campanhas = _campanhas || []; return; }
  try {
    const { data, error } = await _supa.from('trafego_campanhas').select('*').order('data_ref',{ascending:false});
    if(error){ console.warn('[loadCampanhas] erro:', error); _campanhas = []; return; }
    _campanhas = data || [];
    console.log('[loadCampanhas] ' + _campanhas.length + ' campanhas carregadas');
  } catch(e){ console.warn('[loadCampanhas]', e); _campanhas = []; }
}

// Agrupa campanhas por chave unica (nome + plataforma + objetivo) e retorna apenas
// a entrada mais recente de cada grupo. Evita somatorio quando o user atualiza
// semanalmente com valores ACUMULADOS (Meta Ads / Google Ads ja retornam acumulado).
function ultimaPorCampanha(camps){
  const map = {};
  (camps||[]).forEach(c => {
    const key = (c.campanha_nome||'') + '|' + (c.plataforma||'') + '|' + (c.objetivo||'');
    const ant = map[key];
    if(!ant || (c.data_ref||'') > (ant.data_ref||'')) map[key] = c;
  });
  return Object.values(map);
}

// Formata data ISO (yyyy-mm-dd) pra "dd/mm/yyyy" pt-BR. Retorna '-' se vazio.
function fmtDataPt(d){
  if(!d) return '-';
  const m = String(d).match(/^(\d{4})-(\d{2})-(\d{2})/);
  return m ? m[3]+'/'+m[2]+'/'+m[1] : d;
}

// Agrega campanhas por periodo (semanal / mensal / semestral). Como os valores sao
// ACUMULADOS, usa o ULTIMO valor de cada grupo (nao soma).
// Retorna array ordenado: [{label, gasto, resultado, dataRef}]
function agregaPorPeriodo(camps, periodo){
  const sorted = (camps||[]).slice().filter(c => c.data_ref).sort((a,b) => (a.data_ref||'').localeCompare(b.data_ref||''));
  if(periodo === 'semanal' || !periodo){
    return sorted.map(c => ({
      label: fmtDataPt(c.data_ref),
      dataRef: c.data_ref,
      gasto: parseFloat(c.gasto_total)||0,
      resultado: parseInt(c.resultado)||0
    }));
  }
  const groups = {};
  const keysOrder = [];
  sorted.forEach(c => {
    const m = (c.data_ref||'').match(/^(\d{4})-(\d{2})/);
    if(!m) return;
    let key, label;
    if(periodo === 'mensal'){
      key = m[1]+'-'+m[2];
      const nomesMes = ['','Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
      label = nomesMes[parseInt(m[2])] + '/' + m[1].slice(2);
    } else if(periodo === 'semestral'){
      const sem = parseInt(m[2]) <= 6 ? '1' : '2';
      key = m[1]+'-S'+sem;
      label = sem+'º sem/' + m[1].slice(2);
    } else { return; }
    if(!(key in groups)) keysOrder.push(key);
    groups[key] = {label, dataRef: c.data_ref, c};
  });
  return keysOrder.map(k => ({
    label: groups[k].label,
    dataRef: groups[k].dataRef,
    gasto: parseFloat(groups[k].c.gasto_total)||0,
    resultado: parseInt(groups[k].c.resultado)||0
  }));
}

// Storage por idx do chart pra permitir trocar periodo sem re-render geral
if(typeof window._trafChartData === 'undefined') window._trafChartData = {};
if(typeof window._trafCharts === 'undefined') window._trafCharts = {};

window.mudarPeriodoTrafego = function(idx, periodo){
  const dados = window._trafChartData[idx];
  if(!dados) return;
  const agreg = agregaPorPeriodo(dados.camps, periodo);
  const chart = window._trafCharts[idx];
  if(chart){
    chart.data.labels = agreg.map(a => a.label);
    chart.data.datasets[0].data = agreg.map(a => a.gasto);
    chart.data.datasets[1].data = agreg.map(a => a.resultado);
    chart.update();
  }
  // Resumo = ultimo ponto do periodo (valor ACUMULADO mais recente)
  const ultimo = agreg.length ? agreg[agreg.length-1] : {gasto:0,resultado:0,label:'-'};
  const cpa = ultimo.resultado > 0 ? (ultimo.gasto/ultimo.resultado).toFixed(2) : '0';
  const elG = document.getElementById('trafResGasto_'+idx);
  const elR = document.getElementById('trafResRes_'+idx);
  const elC = document.getElementById('trafResCpa_'+idx);
  const elL = document.getElementById('trafResLabel_'+idx);
  if(elG) elG.textContent = 'R$ ' + ultimo.gasto.toFixed(2);
  if(elR) elR.textContent = ultimo.resultado;
  if(elC) elC.textContent = 'R$ ' + cpa;
  if(elL) elL.textContent = ultimo.label;
  // Toggle visual das tabs
  document.querySelectorAll('[data-traftab="'+idx+'"]').forEach(b => {
    const ativo = b.dataset.periodo === periodo;
    b.style.background = ativo ? 'var(--accent)' : 'transparent';
    b.style.color = ativo ? '#fff' : 'var(--text-2)';
    b.style.fontWeight = ativo ? '700' : '500';
  });
};

function renderTrafegoPago(c){
  try {
    if(typeof _campanhas === 'undefined' || !Array.isArray(_campanhas)) _campanhas = [];
    if(typeof clients === 'undefined' || !Array.isArray(clients)){
      c.innerHTML = '<div class="page-head"><div class="page-title">📊 Tráfego Pago</div></div><div class="card"><div class="text-mu">Aguardando carregar dados...</div></div>';
      return;
    }

    const clientesComCampanha = clients.filter(cli => _campanhas.some(camp => camp.client_id === cli._dbId));
    const ultimasGlobais = ultimaPorCampanha(_campanhas);
    const totalGlobalGasto = ultimasGlobais.reduce((s,c) => s + (parseFloat(c.gasto_total)||0), 0);
    const totalGlobalRes = ultimasGlobais.reduce((s,c) => s + (parseInt(c.resultado)||0), 0);
    const campAtivas = _campanhas.filter(c => (c.status||'') === 'Ativa').length;

    const anoAtualStr = new Date().getFullYear() + '';
    const variavelAnoTotal = (_colaboradorPagamentos||[]).filter(p => p.mes_ref && p.mes_ref.startsWith(anoAtualStr)).reduce((s,p) => s+(parseFloat(p.valor)||0), 0);

    c.innerHTML =
      '<div class="page-head"><div><div class="page-title">📊 Tráfego Pago</div>' +
      '<div class="page-sub">Acompanhamento de campanhas por cliente — ' + _campanhas.length + ' campanha(s) cadastrada(s)</div></div>' +
      '<button class="btn btn-primary" onclick="novaCampanhaModal()">+ Nova campanha</button></div>' +

      '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:16px">' +
        '<div class="stat-card"><div class="stat-value">R$ ' + totalGlobalGasto.toFixed(2) + '</div><div class="stat-label">Gasto acumulado atual</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + totalGlobalRes + '</div><div class="stat-label">Resultados acumulados</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + campAtivas + '</div><div class="stat-label">Campanhas ativas</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + clientesComCampanha.length + '</div><div class="stat-label">Clientes ativos</div></div>' +
      '</div>' +

      (clientesComCampanha.length === 0
        ? '<div class="empty-state" style="padding:60px 20px"><div class="ico">📊</div><div class="ttl">Nenhuma campanha cadastrada</div><div class="desc">Clique em "+ Nova campanha" pra começar.</div></div>'
        : '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:14px">' +
            clientesComCampanha.map(cli => {
              const cliCamps = _campanhas.filter(camp => camp.client_id === cli._dbId);
              const ultimas = ultimaPorCampanha(cliCamps);
              const totalGasto = ultimas.reduce((s,c) => s + (parseFloat(c.gasto_total)||0), 0);
              const totalRes = ultimas.reduce((s,c) => s + (parseInt(c.resultado)||0), 0);
              const ativas = ultimas.filter(c => (c.status||'') === 'Ativa').length;
              const plataformas = Array.from(new Set(cliCamps.map(c => c.plataforma).filter(Boolean))).join(', ');
              const ultimaData = cliCamps.reduce((m,c) => (c.data_ref||'') > m ? (c.data_ref||'') : m, '');
              return '<div class="card" onclick="renderTrafegoPagoCli(' + cli.id + ')" style="cursor:pointer;transition:.15s" onmouseover="this.style.transform=\'translateY(-2px)\';this.style.boxShadow=\'0 8px 20px rgba(0,0,0,.08)\'" onmouseout="this.style.transform=\'\';this.style.boxShadow=\'\'">' +
                '<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">' +
                  '<div class="cron-cli-logo" style="background:' + (cli.color||'#888') + ';width:38px;height:38px;font-size:13px">' + (cli.init||'') + '</div>' +
                  '<div style="flex:1"><div style="font-size:14.5px;font-weight:700">' + (cli.name||'(sem nome)') + '</div>' +
                  '<div class="text-xs text-3">' + ultimas.length + ' campanha(s) · ' + ativas + ' ativa(s) · ' + cliCamps.length + ' atualizaç' + (cliCamps.length===1?'ão':'ões') + '</div></div>' +
                '</div>' +
                '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;margin-bottom:8px">' +
                  '<div><div class="text-xs text-3">Gasto atual</div><div style="font-weight:700">R$ ' + totalGasto.toFixed(2) + '</div></div>' +
                  '<div><div class="text-xs text-3">Resultados</div><div style="font-weight:700">' + totalRes + '</div></div>' +
                '</div>' +
                (ultimaData ? '<div class="text-xs text-3" style="margin-bottom:4px">🗓 Última atualização: <b>' + fmtDataPt(ultimaData) + '</b></div>' : '') +
                (plataformas ? '<div class="text-xs text-3" style="border-top:1px solid var(--border);padding-top:8px;margin-top:8px">📍 ' + escapeHtml(plataformas) + '</div>' : '') +
              '</div>';
            }).join('') +
          '</div>');
  } catch(e){
    console.error('[renderTrafegoPago]', e);
    c.innerHTML = '<div class="page-head"><div class="page-title">📊 Tráfego Pago</div></div><div class="card" style="border-left:3px solid var(--danger)"><div style="color:var(--danger);font-weight:600">Erro ao carregar: ' + (e.message||e) + '</div><div class="text-xs text-3 mt-2">Veja o console (F12) pra mais detalhes</div></div>';
  }
}

function renderTrafegoPagoCli(cliId){
  try {
    const cli = clients.find(c => c.id === cliId);
    if(!cli){ toast('Cliente nao encontrado','info'); return; }
    const cliCamps = (_campanhas||[]).filter(c => c.client_id === cli._dbId).sort((a,b) => (b.data_ref||'').localeCompare(a.data_ref||''));
    // Para gasto/resultado/CPA: pega apenas a entrada mais recente de cada campanha
    // unica (nao soma atualizacoes semanais — valores ja vem ACUMULADOS do Meta/Google)
    const ultimasCli = ultimaPorCampanha(cliCamps);
    const totalGasto = ultimasCli.reduce((s,c) => s + (parseFloat(c.gasto_total)||0), 0);
    const totalRes = ultimasCli.reduce((s,c) => s + (parseInt(c.resultado)||0), 0);
    const cpa = totalRes > 0 ? (totalGasto / totalRes).toFixed(2) : '0';
    const ultimaDataRef = cliCamps.length ? (cliCamps[0].data_ref || '') : '';

    const c = document.getElementById('content');
    const anoAtualStr = new Date().getFullYear() + '';
    const variavelAnoTotal = (_colaboradorPagamentos||[]).filter(p => p.mes_ref && p.mes_ref.startsWith(anoAtualStr)).reduce((s,p) => s+(parseFloat(p.valor)||0), 0);

    c.innerHTML =
      '<div class="page-head"><div><a onclick="goTo(\'trafego\')" style="cursor:pointer;color:var(--accent);font-size:13px">← Voltar pra lista</a>' +
      '<div class="page-title" style="display:flex;align-items:center;gap:10px"><div class="cron-cli-logo" style="background:' + (cli.color||'#888') + ';width:34px;height:34px;font-size:12px">' + (cli.init||'') + '</div>' + cli.name + ' — Tráfego</div></div>' +
      '<button class="btn btn-primary" onclick="novaCampanhaModal(' + cli.id + ')">+ Nova campanha</button></div>' +

      '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin-bottom:8px">' +
        '<div class="stat-card"><div class="stat-value">R$ ' + totalGasto.toFixed(2) + '</div><div class="stat-label">Gasto acumulado</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + totalRes + '</div><div class="stat-label">Resultados</div></div>' +
        '<div class="stat-card"><div class="stat-value">R$ ' + cpa + '</div><div class="stat-label">CPA atual</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + ultimasCli.length + '</div><div class="stat-label">Campanhas únicas</div></div>' +
      '</div>' +
      (ultimaDataRef
        ? '<div class="text-xs text-3" style="margin:0 0 14px 4px">🗓 Última atualização: <b>' + fmtDataPt(ultimaDataRef) + '</b> · ' + cliCamps.length + ' registro(s) semanais no total</div>'
        : '') +

      (() => {
        // Agrupa campanhas por plataforma (Meta Ads, Google Ads, etc)
        const porPlataforma = {};
        cliCamps.forEach(camp => {
          const plat = camp.plataforma || 'Outros';
          if(!porPlataforma[plat]) porPlataforma[plat] = [];
          porPlataforma[plat].push(camp);
        });
        const plataformasComDados = Object.keys(porPlataforma).filter(p => porPlataforma[p].length > 1);
        if(plataformasComDados.length === 0) return '';
        // Cor por plataforma
        const corPlat = (p) => {
          const pn = (p||'').toLowerCase();
          if(pn.includes('meta') || pn.includes('facebook') || pn.includes('instagram')) return {gasto:'#1877f2', res:'#22c55e', icone:'📘'};
          if(pn.includes('google') || pn.includes('youtube')) return {gasto:'#ea4335', res:'#22c55e', icone:'🔴'};
          if(pn.includes('tiktok')) return {gasto:'#000000', res:'#22c55e', icone:'🎵'};
          if(pn.includes('linkedin')) return {gasto:'#0a66c2', res:'#22c55e', icone:'💼'};
          return {gasto:'#0ea5e9', res:'#22c55e', icone:'📊'};
        };
        // Um card+canvas pra cada plataforma
        return plataformasComDados.map((plat, idx) => {
          const cor = corPlat(plat);
          const lista = porPlataforma[plat];
          // Resumo inicial = ultimo ponto semanal (valor ACUMULADO mais recente)
          const aggSem = agregaPorPeriodo(lista, 'semanal');
          const ult = aggSem.length ? aggSem[aggSem.length-1] : {gasto:0,resultado:0,label:'-'};
          const cpaUlt = ult.resultado > 0 ? (ult.gasto/ult.resultado).toFixed(2) : '0';
          const tabStyle = 'padding:5px 12px;font-size:12px;border:0;border-radius:6px;cursor:pointer;transition:all .15s';
          return '<div class="card" style="margin-bottom:14px;border-left:3px solid ' + cor.gasto + '">' +
            '<div class="card-header" style="flex-wrap:wrap;gap:10px">' +
              '<div class="card-title">' + cor.icone + ' ' + plat + ' — Gasto × Resultados</div>' +
              '<div style="display:flex;gap:2px;background:var(--surface-2);border-radius:8px;padding:3px">' +
                '<button data-traftab="' + idx + '" data-periodo="semanal" onclick="mudarPeriodoTrafego(' + idx + ',\'semanal\')" style="' + tabStyle + ';background:var(--accent);color:#fff;font-weight:700">📅 Semanal</button>' +
                '<button data-traftab="' + idx + '" data-periodo="mensal" onclick="mudarPeriodoTrafego(' + idx + ',\'mensal\')" style="' + tabStyle + ';background:transparent;color:var(--text-2)">🗓 Mensal</button>' +
                '<button data-traftab="' + idx + '" data-periodo="semestral" onclick="mudarPeriodoTrafego(' + idx + ',\'semestral\')" style="' + tabStyle + ';background:transparent;color:var(--text-2)">📊 Semestral</button>' +
              '</div>' +
            '</div>' +
            '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;padding:0 14px 14px;font-size:12.5px">' +
              '<div style="text-align:center;background:var(--surface-2);border-radius:8px;padding:10px"><div class="text-xs text-3" style="margin-bottom:2px">Gasto no período</div><div id="trafResGasto_' + idx + '" style="font-weight:700;color:' + cor.gasto + ';font-size:15px">R$ ' + ult.gasto.toFixed(2) + '</div></div>' +
              '<div style="text-align:center;background:var(--surface-2);border-radius:8px;padding:10px"><div class="text-xs text-3" style="margin-bottom:2px">Resultados</div><div id="trafResRes_' + idx + '" style="font-weight:700;color:#22c55e;font-size:15px">' + ult.resultado + '</div></div>' +
              '<div style="text-align:center;background:var(--surface-2);border-radius:8px;padding:10px"><div class="text-xs text-3" style="margin-bottom:2px">CPA</div><div id="trafResCpa_' + idx + '" style="font-weight:700;font-size:15px">R$ ' + cpaUlt + '</div></div>' +
              '<div style="text-align:center;background:var(--surface-2);border-radius:8px;padding:10px"><div class="text-xs text-3" style="margin-bottom:2px">Último ponto</div><div id="trafResLabel_' + idx + '" style="font-weight:700;font-size:14px">' + ult.label + '</div></div>' +
            '</div>' +
            '<canvas id="chartTrafego_' + idx + '" style="max-height:260px;padding:0 14px 14px"></canvas>' +
            '</div>';
        }).join('');
      })() +

      '<div class="card"><div class="card-header"><div class="card-title">Histórico semanal (' + cliCamps.length + ' registro' + (cliCamps.length===1?'':'s') + ')</div>' +
      '<span class="text-xs text-3">Adicione uma entrada por semana com os valores ACUMULADOS — não somamos atualizações</span></div>' +
      (cliCamps.length === 0
        ? '<div class="empty-state" style="padding:30px"><div class="ttl">Nenhuma campanha</div><div class="desc">Clique em "+ Nova campanha" pra adicionar</div></div>'
        : '<div style="overflow-x:auto"><table style="width:100%;font-size:12.5px;min-width:840px"><thead><tr>' +
          '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Data</th>' +
          '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Campanha</th>' +
          '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Plataforma</th>' +
          '<th style="text-align:left;padding:8px;border-bottom:1px solid var(--border)">Objetivo</th>' +
          '<th style="text-align:center;padding:8px;border-bottom:1px solid var(--border)">Status</th>' +
          '<th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">Gasto acum.</th>' +
          '<th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">Resultado</th>' +
          '<th style="text-align:right;padding:8px;border-bottom:1px solid var(--border)">CPA</th>' +
          '<th style="padding:8px;border-bottom:1px solid var(--border)"></th></tr></thead><tbody>' +
          cliCamps.map((camp, idx) => {
            const cpaInd = (camp.resultado && camp.gasto_total) ? (camp.gasto_total/camp.resultado).toFixed(2) : '0';
            const statusBg = {Ativa:'b-success',Pausada:'b-warning',Encerrada:'b-default',Planejada:'b-info'}[camp.status||'Ativa'] || 'b-default';
            const isUltima = idx === 0;
            return '<tr' + (isUltima ? ' style="background:rgba(34,197,94,.06)"' : '') + '>' +
              '<td style="padding:8px;white-space:nowrap">' + fmtDataPt(camp.data_ref) + (isUltima ? ' <span class="badge b-success" style="font-size:10px;padding:1px 6px">atual</span>' : '') + '</td>' +
              '<td style="padding:8px">' + (camp.campanha_nome || '<span class="text-3">—</span>') + '</td>' +
              '<td style="padding:8px">' + (camp.plataforma||'-') + '</td>' +
              '<td style="padding:8px">' + (camp.objetivo||'-') + '</td>' +
              '<td style="padding:8px;text-align:center"><span class="badge ' + statusBg + '">' + (camp.status||'-') + '</span></td>' +
              '<td style="padding:8px;text-align:right">R$ ' + (parseFloat(camp.gasto_total)||0).toFixed(2) + '</td>' +
              '<td style="padding:8px;text-align:right;font-weight:600">' + (camp.resultado||0) + '</td>' +
              '<td style="padding:8px;text-align:right">R$ ' + cpaInd + '</td>' +
              '<td style="padding:8px;text-align:right"><button class="icon-btn" onclick="excluirCampanha(\'' + camp.id + '\',' + cli.id + ')" style="color:var(--danger);width:26px;height:26px">×</button></td>' +
            '</tr>';
          }).join('') +
        '</tbody></table></div>') +
      '</div>';

    // ===== Cria um Chart por plataforma =====
    if(typeof Chart !== 'undefined'){
      setTimeout(() => {
        const porPlataforma = {};
        cliCamps.forEach(camp => {
          const plat = camp.plataforma || 'Outros';
          if(!porPlataforma[plat]) porPlataforma[plat] = [];
          porPlataforma[plat].push(camp);
        });
        const plataformasComDados = Object.keys(porPlataforma).filter(p => porPlataforma[p].length > 1);
        const corPlat = (p) => {
          const pn = (p||'').toLowerCase();
          if(pn.includes('meta') || pn.includes('facebook') || pn.includes('instagram')) return {gasto:'#1877f2', gastoBg:'rgba(24,119,242,.15)'};
          if(pn.includes('google') || pn.includes('youtube')) return {gasto:'#ea4335', gastoBg:'rgba(234,67,53,.15)'};
          if(pn.includes('tiktok')) return {gasto:'#000000', gastoBg:'rgba(0,0,0,.12)'};
          if(pn.includes('linkedin')) return {gasto:'#0a66c2', gastoBg:'rgba(10,102,194,.15)'};
          return {gasto:'#0ea5e9', gastoBg:'rgba(14,165,233,.15)'};
        };
        plataformasComDados.forEach((plat, idx) => {
          const ctx = document.getElementById('chartTrafego_' + idx);
          if(!ctx) return;
          const lista = porPlataforma[plat];
          const cor = corPlat(plat);
          // Armazena dados pra troca de periodo via tabs
          window._trafChartData[idx] = {camps: lista, plat, cor};
          // Inicia em semanal
          const agreg = agregaPorPeriodo(lista, 'semanal');
          // Destroi chart anterior se existir (re-render do mesmo cliente)
          if(window._trafCharts[idx]){ try{ window._trafCharts[idx].destroy(); }catch(e){} }
          window._trafCharts[idx] = new Chart(ctx, {
            type: 'line',
            data: {
              labels: agreg.map(a => a.label),
              datasets: [
                {label: 'Gasto acumulado (R$)', data: agreg.map(a => a.gasto), borderColor: cor.gasto, backgroundColor: cor.gastoBg, yAxisID: 'y', tension: .3, fill: true, pointRadius: 4, pointHoverRadius: 6},
                {label: 'Resultados acumulados', data: agreg.map(a => a.resultado), borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,.12)', yAxisID: 'y1', tension: .3, fill: true, pointRadius: 4, pointHoverRadius: 6}
              ]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              interaction: {mode:'index', intersect:false},
              scales: {
                y: {type:'linear', position:'left', title:{display:true, text:'R$ Gasto'}, beginAtZero:true},
                y1: {type:'linear', position:'right', title:{display:true, text:'Resultados'}, grid:{drawOnChartArea:false}, beginAtZero:true}
              },
              plugins: {
                legend:{position:'top'},
                title:{display:false},
                tooltip: {
                  callbacks: {
                    label: function(ctx){
                      const v = ctx.parsed.y;
                      return ctx.dataset.label + ': ' + (ctx.datasetIndex === 0 ? 'R$ '+v.toFixed(2) : v);
                    }
                  }
                }
              }
            }
          });
        });
      }, 100);
    }
  } catch(e){
    console.error('[renderTrafegoPagoCli]', e);
    document.getElementById('content').innerHTML = '<div class="card" style="border-left:3px solid var(--danger)"><div style="color:var(--danger)">Erro: ' + (e.message||e) + '</div></div>';
  }
}

function novaCampanhaModal(presetCliId){
  let modal = document.getElementById('trfModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'trfModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  const hoje = new Date().toISOString().split('T')[0];
  const plataformas = ['Meta Ads','Google Ads','TikTok Ads','LinkedIn Ads','YouTube Ads','Outros'];
  const objetivos = ['Leads','Vendas','Conversas','Engajamento','Seguidores','Reconhecimento','Trafego','Vendas no Site','Outros'];
  const statuses = ['Ativa','Pausada','Encerrada','Planejada'];

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:600px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:38px;height:38px;border-radius:9px;background:#0ea5e9;color:#fff;display:grid;place-items:center;font-size:18px">📊</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">Nova atualização semanal</div>' +
        '<div class="text-xs text-3" style="margin-top:2px">Coloque os valores ACUMULADOS da semana (como vêm do Meta / Google Ads)</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'trfModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px;display:flex;flex-direction:column;gap:12px">' +
        '<div style="background:rgba(14,165,233,.08);border-left:3px solid #0ea5e9;border-radius:8px;padding:10px 12px;font-size:12.5px;color:var(--text-2);line-height:1.5">' +
          '💡 <b>Como funciona:</b> toda semana você abre o painel do Meta/Google e copia os valores <b>ACUMULADOS</b> da campanha aqui. O sistema mostra a última entrada como "valor atual" — nunca soma as semanas, só registra histórico.' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Cliente *</div><select id="trfCliente" class="login-input" style="background:var(--surface-2)">' +
          '<option value="">— Selecione —</option>' +
          sortAlfa(clients, 'name').map(c => '<option value="' + c._dbId + '" ' + (presetCliId && clients.find(x=>x.id===presetCliId) && clients.find(x=>x.id===presetCliId)._dbId === c._dbId ?'selected':'') + '>' + c.name + '</option>').join('') +
        '</select></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Data da atualização *</div><input id="trfData" class="login-input" type="date" value="' + hoje + '" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Status</div><select id="trfStatus" class="login-input" style="background:var(--surface-2)">' + statuses.map(s => '<option ' + (s==='Ativa'?'selected':'') + '>' + s + '</option>').join('') + '</select></div>' +
        '</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Plataforma</div><select id="trfPlataforma" class="login-input" style="background:var(--surface-2)">' + plataformas.map(p => '<option>' + p + '</option>').join('') + '</select></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Objetivo</div><select id="trfObjetivo" class="login-input" style="background:var(--surface-2)">' + objetivos.map(o => '<option>' + o + '</option>').join('') + '</select></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Nome da campanha <span class="text-xs text-3">(use o MESMO nome em toda atualização semanal)</span></div><input id="trfNome" class="login-input" placeholder="Ex: Vendas Verão 2026" style="background:var(--surface-2)" /></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Orçamento total</div><input id="trfOrcTotal" class="login-input" type="number" step="0.01" value="0" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Orçamento diário</div><input id="trfOrcDia" class="login-input" type="number" step="0.01" value="0" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Gasto acumulado</div><input id="trfGasto" class="login-input" type="number" step="0.01" value="0" style="background:var(--surface-2)" placeholder="Total até hoje" /></div>' +
        '</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Resultado acumulado</div><input id="trfResultado" class="login-input" type="number" value="0" style="background:var(--surface-2)" placeholder="Leads/vendas até hoje" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Campanhas</div><input id="trfQtdCamp" class="login-input" type="number" value="1" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Conjuntos</div><input id="trfQtdConj" class="login-input" type="number" value="1" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Observações</div><textarea id="trfObs" class="login-input" rows="2" style="background:var(--surface-2);resize:vertical;min-height:50px"></textarea></div>' +
      '</div>' +
      '<div style="padding:16px 24px 22px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid var(--border)">' +
        '<button class="btn" onclick="document.getElementById(\'trfModal\').remove()">Cancelar</button>' +
        '<button class="btn btn-primary" onclick="salvarCampanha(' + (presetCliId || 'null') + ')">💾 Salvar</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function salvarCampanha(presetCliId){
  const client_id = document.getElementById('trfCliente').value;
  if(!client_id){ toast('Selecione o cliente','info'); return; }
  const data_ref = document.getElementById('trfData').value;
  if(!data_ref){ toast('Informe o mes','info'); return; }
  const gasto_total = parseFloat(document.getElementById('trfGasto').value)||0;
  const resultado = parseInt(document.getElementById('trfResultado').value)||0;
  const cpa = resultado > 0 ? gasto_total/resultado : 0;

  const cliObj = clients.find(c => c._dbId === client_id);
  const payload = {
    client_id,
    client_name: cliObj ? cliObj.name : null,
    data_ref,
    plataforma: document.getElementById('trfPlataforma').value,
    objetivo: document.getElementById('trfObjetivo').value,
    status: document.getElementById('trfStatus').value,
    campanha_nome: document.getElementById('trfNome').value.trim() || null,
    campanhas_qtd: parseInt(document.getElementById('trfQtdCamp').value)||0,
    conjuntos_qtd: parseInt(document.getElementById('trfQtdConj').value)||0,
    orcamento_total: parseFloat(document.getElementById('trfOrcTotal').value)||0,
    orcamento_diario: parseFloat(document.getElementById('trfOrcDia').value)||0,
    gasto_total,
    resultado,
    cpa,
    observacoes: document.getElementById('trfObs').value.trim() || null
  };
  if(_supa){
    const { data, error } = await _supa.from('trafego_campanhas').insert(payload).select().single();
    if(error){ toast('Erro: '+error.message,'info'); return; }
    _campanhas.unshift(data);
  } else {
    _campanhas.unshift(Object.assign({}, payload, {id:'tmp-'+Date.now()}));
  }
  document.getElementById('trfModal').remove();
  toast('✓ Campanha salva','success');
  if(presetCliId) renderTrafegoPagoCli(presetCliId);
  else if(currentPage === 'trafego') renderTrafegoPago(document.getElementById('content'));
}

async function excluirCampanha(id, cliId){
  if(!(await confirmDelete('campanha'))) return;
  if(_supa) await _supa.from('trafego_campanhas').delete().eq('id', id);
  _campanhas = _campanhas.filter(c => c.id !== id);
  toast('Campanha excluida','success');
  if(cliId) renderTrafegoPagoCli(cliId);
  else if(currentPage === 'trafego') renderTrafegoPago(document.getElementById('content'));
}

// ============ RELACIONAMENTO COM CLIENTES (CRM) ============
if(typeof _relacionamentos === 'undefined') var _relacionamentos = [];

async function loadRelacionamentos(){
  if(!_supa) return;
  try {
    const { data, error } = await _supa.from('client_relationships').select('*').order('created_at',{ascending:false});
    if(error){ console.warn('[loadRelacionamentos] erro:', error); return; }
    if(data){
      _relacionamentos = data;
      console.log('[loadRelacionamentos] ' + data.length + ' registros. Amostra:', data.slice(0,2));
    }
  } catch(e){ console.warn('[loadRelacionamentos]', e); }
}

// ============ PARCERIAS ============
if(typeof _parcerias === 'undefined') var _parcerias = [];
if(typeof _parceriasResultados === 'undefined') var _parceriasResultados = [];
if(typeof _parcFiltroStatus === 'undefined') var _parcFiltroStatus = 'todas';

async function loadParcerias(){
  if(!_supa){ _parcerias = []; _parceriasResultados = []; return; }
  try {
    const [r1, r2] = await Promise.all([
      _supa.from('parcerias').select('*').order('created_at',{ascending:false}),
      _supa.from('parcerias_resultados').select('*').order('data',{ascending:false})
    ]);
    if(r1.error){
      if(r1.error.code === '42P01' || (r1.error.message||'').includes('does not exist')){
        toast('⚠ Rode o SQL 46-parcerias.sql no Supabase pra ativar essa aba','info');
        return;
      }
      console.warn('[loadParcerias]', r1.error);
    } else {
      _parcerias = r1.data || [];
    }
    if(!r2.error) _parceriasResultados = r2.data || [];
    console.log('[loadParcerias] ' + _parcerias.length + ' parcerias, ' + _parceriasResultados.length + ' resultados');
  } catch(e){ console.error('[loadParcerias]', e); }
}

const PARC_TIPOS = {
  'referral': {icon:'🎯', label:'Referral (indica clientes)'},
  'co-marketing': {icon:'🤝', label:'Co-marketing'},
  'fornecedor': {icon:'📦', label:'Fornecedor'},
  'cliente-compartilhado': {icon:'👥', label:'Cliente compartilhado'},
  'indicador': {icon:'📢', label:'Indicador'},
  'outro': {icon:'⭐', label:'Outro'}
};
const PARC_STATUS = {
  'ativa': {label:'Ativa', cor:'var(--success)', bg:'b-success'},
  'negociacao': {label:'Em negociação', cor:'var(--info)', bg:'b-info'},
  'pausada': {label:'Pausada', cor:'var(--warning)', bg:'b-warning'},
  'encerrada': {label:'Encerrada', cor:'var(--danger)', bg:'b-danger'}
};

// Retorno efetivo: usa o manual se >0, senao soma os resultados
function _calcRetornoParceria(parceria, resultadosDela){
  const manual = parseFloat(parceria.valor_retorno)||0;
  if(manual > 0) return manual;
  return (resultadosDela||[]).reduce((s,r) => s + (parseFloat(r.valor)||0), 0);
}

function _calcROI(investido, retorno){
  if(!investido || investido <= 0) return null;
  return ((retorno - investido) / investido) * 100;
}

function _formatROI(roi){
  if(roi === null) return '—';
  const sinal = roi >= 0 ? '+' : '';
  return sinal + roi.toFixed(1) + '%';
}

function _calcTempoParceria(dataInicio){
  if(!dataInicio) return '—';
  try {
    const di = new Date(dataInicio+'T00:00:00');
    if(isNaN(di.getTime())) return '—';
    const hoje = new Date();
    const dias = Math.floor((hoje - di) / 86400000);
    if(dias < 0) return 'futura (em '+Math.abs(dias)+'d)';
    if(dias < 30) return dias + ' dia(s)';
    const meses = Math.floor(dias / 30);
    if(meses < 12) return meses + ' mes(es)';
    const anos = Math.floor(meses / 12);
    const restMes = meses % 12;
    return anos + ' ano(s)' + (restMes>0?' e '+restMes+'m':'');
  } catch(e){ return '—'; }
}

function renderParcerias(c){
  try {
    const parcerias = _parcerias || [];
    const resultados = _parceriasResultados || [];

    // Stats
    const ativas = parcerias.filter(p => p.status === 'ativa').length;
    // Total retorno: soma do (manual se >0 OU soma dos resultados) de cada parceria
    const totalValor = parcerias.reduce((s,p) => {
      const resP = resultados.filter(r => r.parceria_id === p.id);
      return s + _calcRetornoParceria(p, resP);
    }, 0);
    const totalInvestido = parcerias.reduce((s,p) => s + (parseFloat(p.valor_investido)||0), 0);
    const saldoGlobal = totalValor - totalInvestido;
    const roiGlobal = _calcROI(totalInvestido, totalValor);
    const totalLeads = resultados.filter(r => r.tipo === 'lead').length;
    const totalVendas = resultados.filter(r => r.tipo === 'venda').length;
    const ultimoMes = new Date(); ultimoMes.setMonth(ultimoMes.getMonth()-1);
    const resultadosMes = resultados.filter(r => r.data && new Date(r.data+'T00:00:00') >= ultimoMes);

    // Filtros
    let filtradas = parcerias.slice();
    if(_parcFiltroStatus !== 'todas') filtradas = filtradas.filter(p => p.status === _parcFiltroStatus);
    filtradas = sortAlfa(filtradas, 'nome');

    c.innerHTML =
      '<div class="page-head"><div><div class="page-title">🤝 Parcerias</div>' +
      '<div class="page-sub">Controle e mensuração das parcerias estratégicas</div></div>' +
      '<button class="btn btn-primary" onclick="openParceriaModal()">+ Nova parceria</button></div>' +

      // Stats
      '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:16px">' +
        '<div class="stat-card"><div class="stat-value">' + parcerias.length + '</div><div class="stat-label">Parcerias totais</div></div>' +
        '<div class="stat-card" style="border-left:3px solid var(--success)"><div class="stat-value">' + ativas + '</div><div class="stat-label">Ativas</div></div>' +
        '<div class="stat-card" style="border-left:3px solid var(--warning)"><div class="stat-value" style="color:var(--warning-text)">R$ ' + totalInvestido.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</div><div class="stat-label">💸 Investido total</div></div>' +
        '<div class="stat-card" style="border-left:3px solid var(--info, var(--accent))"><div class="stat-value">R$ ' + totalValor.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</div><div class="stat-label">📈 Retorno gerado</div></div>' +
        '<div class="stat-card" style="border-left:3px solid ' + (saldoGlobal>=0?'var(--success)':'var(--danger)') + '"><div class="stat-value" style="color:' + (saldoGlobal>=0?'var(--success-text)':'var(--danger)') + '">R$ ' + saldoGlobal.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '</div><div class="stat-label">Saldo (ret−inv)</div></div>' +
        '<div class="stat-card"><div class="stat-value" style="color:' + (roiGlobal===null?'var(--text-3)':roiGlobal>=0?'var(--success-text)':'var(--danger)') + '">' + _formatROI(roiGlobal) + '</div><div class="stat-label">ROI global</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + totalLeads + '</div><div class="stat-label">Leads</div></div>' +
        '<div class="stat-card"><div class="stat-value">' + totalVendas + '</div><div class="stat-label">Vendas</div></div>' +
      '</div>' +

      // Filtros status
      '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">' +
        ['todas','ativa','negociacao','pausada','encerrada'].map(s => {
          const lbl = s === 'todas' ? 'Todas' : (PARC_STATUS[s] ? PARC_STATUS[s].label : s);
          const cnt = s === 'todas' ? parcerias.length : parcerias.filter(p => p.status === s).length;
          return '<button class="filter-chip ' + (_parcFiltroStatus===s?'active':'') + '" onclick="window._parcFiltroStatus=\'' + s + '\';renderParcerias(document.getElementById(\'content\'))">' + lbl + ' · ' + cnt + '</button>';
        }).join('') +
      '</div>' +

      // Lista de parcerias
      (filtradas.length === 0
        ? '<div class="empty-state" style="padding:60px 20px"><div class="ico">🤝</div><div class="ttl">Nenhuma parceria</div><div class="desc">Clique em "+ Nova parceria" pra começar.</div></div>'
        : '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px">' +
            filtradas.map(p => {
              const resDela = resultados.filter(r => r.parceria_id === p.id);
              const valorTotal = _calcRetornoParceria(p, resDela);
              const tipo = PARC_TIPOS[p.tipo] || PARC_TIPOS.outro;
              const statusInfo = PARC_STATUS[p.status] || PARC_STATUS.ativa;
              const tempo = _calcTempoParceria(p.data_inicio);
              const investidoP = parseFloat(p.valor_investido)||0;
              const saldoP = valorTotal - investidoP;
              const roiP = _calcROI(investidoP, valorTotal);
              return '<div class="card" style="cursor:pointer;border-left:3px solid ' + statusInfo.cor + '" onclick="abrirParceriaDetalhe(\'' + p.id + '\')">' +
                '<div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:10px">' +
                  '<div style="width:42px;height:42px;border-radius:10px;background:var(--surface-2);display:grid;place-items:center;font-size:18px">' + tipo.icon + '</div>' +
                  '<div style="flex:1;min-width:0">' +
                    '<div style="font-size:14.5px;font-weight:700;letter-spacing:-.01em">' + escapeHtml(p.nome||'(sem nome)') + '</div>' +
                    '<div class="text-xs text-3" style="margin-top:2px">' + tipo.label + ' · ' + tempo + '</div>' +
                  '</div>' +
                  '<span class="badge ' + statusInfo.bg + '">' + statusInfo.label + '</span>' +
                '</div>' +
                '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;font-size:11.5px">' +
                  '<div style="padding:6px 8px;background:var(--warning-soft);border-radius:6px"><div class="text-xs text-3" style="font-size:10px">💸 Investido</div><div style="font-weight:700">R$ ' + investidoP.toFixed(2) + '</div></div>' +
                  '<div style="padding:6px 8px;background:var(--success-soft);border-radius:6px"><div class="text-xs text-3" style="font-size:10px">📈 Retorno</div><div style="font-weight:700">R$ ' + valorTotal.toFixed(2) + '</div></div>' +
                '</div>' +
                '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-top:1px solid var(--border);font-size:11.5px">' +
                  '<span class="text-xs text-3">' + resDela.length + ' resultado(s)</span>' +
                  '<span style="font-weight:700;color:' + (roiP===null?'var(--text-3)':roiP>=0?'var(--success-text)':'var(--danger)') + '">ROI: ' + _formatROI(roiP) + '</span>' +
                '</div>' +
                (p.proxima_reuniao ? '<div class="text-xs" style="color:var(--warning-text);padding-top:6px;margin-top:4px;border-top:1px solid var(--border)">📅 Próxima: ' + p.proxima_reuniao + '</div>' : '') +
              '</div>';
            }).join('') +
          '</div>');
  } catch(e){
    console.error('[renderParcerias]', e);
    c.innerHTML = '<div class="page-head"><div class="page-title">🤝 Parcerias</div></div><div class="card" style="border-left:3px solid var(--danger);padding:20px"><div style="color:var(--danger);font-weight:600">Erro: ' + (e.message||e) + '</div><div class="text-xs text-3 mt-2">Rode o SQL 46-parcerias.sql se ainda não rodou</div></div>';
  }
}

function openParceriaModal(parceriaId){
  const p = parceriaId ? (_parcerias||[]).find(x => x.id === parceriaId) : {};
  if(parceriaId && !p){ toast('Parceria nao encontrada','info'); return; }
  const dados = p || {};
  const isEdit = !!parceriaId;

  let modal = document.getElementById('parceriaModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'parceriaModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };
  const esc = (v) => (v||'').toString().replace(/"/g,'&quot;');

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:640px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:40px;height:40px;border-radius:9px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:18px">🤝</div>' +
        '<div style="flex:1"><div style="font-size:16px;font-weight:700">' + (isEdit?'Editar parceria':'Nova parceria') + '</div></div>' +
        '<button class="icon-btn" onclick="document.getElementById(\'parceriaModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px;display:flex;flex-direction:column;gap:12px">' +
        '<div><div class="info-label" style="margin-bottom:5px">Nome do parceiro *</div><input id="pcNome" class="login-input" value="' + esc(dados.nome) + '" placeholder="Ex: Estúdio XYZ" style="background:var(--surface-2)" /></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Tipo</div><select id="pcTipo" class="login-input" style="background:var(--surface-2)">' +
            Object.keys(PARC_TIPOS).map(k => '<option value="' + k + '" ' + (dados.tipo===k?'selected':'') + '>' + PARC_TIPOS[k].icon + ' ' + PARC_TIPOS[k].label + '</option>').join('') +
          '</select></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Status</div><select id="pcStatus" class="login-input" style="background:var(--surface-2)">' +
            Object.keys(PARC_STATUS).map(k => '<option value="' + k + '" ' + ((dados.status||'ativa')===k?'selected':'') + '>' + PARC_STATUS[k].label + '</option>').join('') +
          '</select></div>' +
        '</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Data de início</div><input id="pcDataInicio" type="date" class="login-input" value="' + (dados.data_inicio||'') + '" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Próxima reunião</div><input id="pcProxReu" type="date" class="login-input" value="' + (dados.proxima_reuniao||'') + '" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        '<div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Contato (nome)</div><input id="pcContNome" class="login-input" value="' + esc(dados.contato_nome) + '" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Email</div><input id="pcContEmail" type="email" class="login-input" value="' + esc(dados.contato_email) + '" style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Telefone</div><input id="pcContTel" class="login-input" value="' + esc(dados.contato_telefone) + '" style="background:var(--surface-2)" /></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">📋 Combinados / Acordos</div><textarea id="pcCombinados" class="login-input" rows="3" placeholder="O que foi acordado, responsabilidades de cada lado, escopo da parceria..." style="background:var(--surface-2);resize:vertical;min-height:80px">' + (dados.combinados||'') + '</textarea></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">💰 Condições financeiras</div><input id="pcCondFin" class="login-input" value="' + esc(dados.condicoes_financeiras) + '" placeholder="Ex: 10% por venda fechada / R$ 500 fixo mensal / Sem custo" style="background:var(--surface-2)" /></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">💸 Investido (R$)</div><input id="pcInvestido" type="number" step="0.01" class="login-input" value="' + (parseFloat(dados.valor_investido)||0) + '" placeholder="0" style="background:var(--surface-2);text-align:right" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">📈 Retorno consolidado (R$)</div><input id="pcRetorno" type="number" step="0.01" class="login-input" value="' + (parseFloat(dados.valor_retorno)||0) + '" placeholder="0 = usa soma dos resultados" style="background:var(--surface-2);text-align:right" /></div>' +
        '</div>' +
        '<div class="text-xs text-3" style="background:var(--surface-2);padding:8px 12px;border-radius:7px">💡 Se deixar o retorno em 0, o sistema soma automaticamente os valores dos resultados adicionados. Preencha aqui se quiser um valor consolidado manual.</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
          '<div><div class="info-label" style="margin-bottom:5px">Link do contrato (opcional)</div><input id="pcLink" class="login-input" value="' + esc(dados.link_contrato) + '" placeholder="https://drive..." style="background:var(--surface-2)" /></div>' +
          '<div><div class="info-label" style="margin-bottom:5px">Prioridade</div><select id="pcPrio" class="login-input" style="background:var(--surface-2)"><option value="alta" ' + (dados.prioridade==='alta'?'selected':'') + '>🔴 Alta</option><option value="media" ' + ((dados.prioridade||'media')==='media'?'selected':'') + '>🟡 Média</option><option value="baixa" ' + (dados.prioridade==='baixa'?'selected':'') + '>⚪ Baixa</option></select></div>' +
        '</div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Tags</div><input id="pcTags" class="login-input" value="' + esc(dados.tags) + '" placeholder="design, sp, video... (separe por virgula)" style="background:var(--surface-2)" /></div>' +
        '<div><div class="info-label" style="margin-bottom:5px">Observações</div><textarea id="pcObs" class="login-input" rows="2" style="background:var(--surface-2);resize:vertical">' + (dados.observacoes||'') + '</textarea></div>' +
      '</div>' +
      '<div style="padding:14px 22px 18px;display:flex;gap:8px;justify-content:' + (isEdit?'space-between':'flex-end') + ';align-items:center;border-top:1px solid var(--border)">' +
        (isEdit ? '<button class="btn" onclick="excluirParceria(\'' + parceriaId + '\')" style="color:var(--danger);border-color:var(--danger)">🗑 Excluir</button>' : '') +
        '<div style="display:flex;gap:8px">' +
          '<button class="btn" onclick="document.getElementById(\'parceriaModal\').remove()">Cancelar</button>' +
          '<button class="btn btn-primary" onclick="salvarParceria(' + (isEdit?"'"+parceriaId+"'":'null') + ')">💾 Salvar</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

async function salvarParceria(id){
  const nome = (document.getElementById('pcNome').value||'').trim();
  if(!nome){ toast('Informe o nome do parceiro','info'); return; }
  const payload = {
    nome,
    tipo: document.getElementById('pcTipo').value,
    status: document.getElementById('pcStatus').value,
    data_inicio: document.getElementById('pcDataInicio').value || null,
    proxima_reuniao: document.getElementById('pcProxReu').value || null,
    contato_nome: document.getElementById('pcContNome').value.trim() || null,
    contato_email: document.getElementById('pcContEmail').value.trim() || null,
    contato_telefone: document.getElementById('pcContTel').value.trim() || null,
    combinados: document.getElementById('pcCombinados').value.trim() || null,
    condicoes_financeiras: document.getElementById('pcCondFin').value.trim() || null,
    valor_investido: parseFloat(document.getElementById('pcInvestido')?.value) || 0,
    valor_retorno: parseFloat(document.getElementById('pcRetorno')?.value) || 0,
    link_contrato: document.getElementById('pcLink').value.trim() || null,
    prioridade: document.getElementById('pcPrio').value,
    tags: document.getElementById('pcTags').value.trim() || null,
    observacoes: document.getElementById('pcObs').value.trim() || null,
    updated_at: new Date().toISOString()
  };
  if(!_supa){ toast('Banco nao conectado','info'); return; }
  if(id){
    const { error } = await _supa.from('parcerias').update(payload).eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
    const idx = _parcerias.findIndex(p => p.id === id);
    if(idx >= 0) Object.assign(_parcerias[idx], payload);
    toast('✓ Parceria atualizada','success');
  } else {
    const { data, error } = await _supa.from('parcerias').insert(payload).select().single();
    if(error){
      if(error.code === '42P01' || (error.message||'').includes('does not exist')){
        toast('⚠ Rode o SQL 46-parcerias.sql','info');
      } else {
        toast('Erro: '+error.message,'info');
      }
      return;
    }
    _parcerias.unshift(data);
    toast('✓ Parceria criada','success');
  }
  document.getElementById('parceriaModal').remove();
  if(currentPage === 'parcerias') renderParcerias(document.getElementById('content'));
}

async function excluirParceria(id){
  if(!(await confirmDelete('parceria Todos os resultados vinculados também serão apagados.'))) return;
  if(_supa){
    const { error } = await _supa.from('parcerias').delete().eq('id', id);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  _parcerias = _parcerias.filter(p => p.id !== id);
  _parceriasResultados = _parceriasResultados.filter(r => r.parceria_id !== id);
  const modal = document.getElementById('parceriaModal') || document.getElementById('parceriaDetModal');
  if(modal) modal.remove();
  toast('Parceria excluida','success');
  if(currentPage === 'parcerias') renderParcerias(document.getElementById('content'));
}

function abrirParceriaDetalhe(parceriaId){
  const p = (_parcerias||[]).find(x => x.id === parceriaId);
  if(!p){ toast('Parceria nao encontrada','info'); return; }
  const resultados = (_parceriasResultados||[]).filter(r => r.parceria_id === parceriaId).sort((a,b) => (b.data||'').localeCompare(a.data||''));
  const valorTotal = _calcRetornoParceria(p, resultados);
  const tipo = PARC_TIPOS[p.tipo] || PARC_TIPOS.outro;
  const statusInfo = PARC_STATUS[p.status] || PARC_STATUS.ativa;
  const tempo = _calcTempoParceria(p.data_inicio);
  const tiposRes = {lead:'🎯 Lead', venda:'💰 Venda', evento:'📅 Evento', conteudo:'📝 Conteúdo', reuniao:'🤝 Reunião', outro:'⭐ Outro'};

  let modal = document.getElementById('parceriaDetModal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'parceriaDetModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.onclick = (ev) => { if(ev.target === modal) modal.remove(); };

  modal.innerHTML =
    '<div style="background:var(--surface);border-radius:14px;max-width:720px;width:100%;max-height:92vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.3)">' +
      '<div style="padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">' +
        '<div style="width:46px;height:46px;border-radius:11px;background:var(--surface-2);display:grid;place-items:center;font-size:22px">' + tipo.icon + '</div>' +
        '<div style="flex:1"><div style="font-size:17px;font-weight:700">' + escapeHtml(p.nome) + '</div>' +
        '<div class="text-xs text-3" style="margin-top:2px">' + tipo.label + ' · <span class="badge ' + statusInfo.bg + '">' + statusInfo.label + '</span> · há ' + tempo + '</div></div>' +
        '<button class="btn btn-sm" onclick="openParceriaModal(\'' + p.id + '\');document.getElementById(\'parceriaDetModal\').remove()">✏️ Editar</button>' +
        '<button class="icon-btn" onclick="document.getElementById(\'parceriaDetModal\').remove()" style="width:30px;height:30px">×</button>' +
      '</div>' +
      '<div style="padding:18px 22px">' +
        // Stats do parceiro
        (function(){
          const investidoP = parseFloat(p.valor_investido)||0;
          const saldoP = valorTotal - investidoP;
          const roiP = _calcROI(investidoP, valorTotal);
          return '<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr));margin-bottom:14px">' +
            '<div class="stat-card" style="border-left:3px solid var(--warning)"><div class="stat-value" style="color:var(--warning-text)">R$ ' + investidoP.toFixed(2) + '</div><div class="stat-label">💸 Investido</div></div>' +
            '<div class="stat-card" style="border-left:3px solid var(--success)"><div class="stat-value" style="color:var(--success-text)">R$ ' + valorTotal.toFixed(2) + '</div><div class="stat-label">📈 Retorno</div></div>' +
            '<div class="stat-card" style="border-left:3px solid ' + (saldoP>=0?'var(--success)':'var(--danger)') + '"><div class="stat-value" style="color:' + (saldoP>=0?'var(--success-text)':'var(--danger)') + '">R$ ' + saldoP.toFixed(2) + '</div><div class="stat-label">Saldo</div></div>' +
            '<div class="stat-card"><div class="stat-value" style="color:' + (roiP===null?'var(--text-3)':roiP>=0?'var(--success-text)':'var(--danger)') + '">' + _formatROI(roiP) + '</div><div class="stat-label">ROI</div></div>' +
            '<div class="stat-card"><div class="stat-value">' + resultados.length + '</div><div class="stat-label">Resultados</div></div>' +
            '<div class="stat-card"><div class="stat-value">' + resultados.filter(r => r.tipo === 'lead').length + '/' + resultados.filter(r => r.tipo === 'venda').length + '</div><div class="stat-label">Leads/Vendas</div></div>' +
          '</div>';
        })() +

        // Info detalhada
        '<div class="info-grid" style="margin-bottom:14px">' +
          (p.data_inicio ? '<div class="info-item"><div class="info-label">Início</div><div class="info-value">' + p.data_inicio + '</div></div>' : '') +
          (p.proxima_reuniao ? '<div class="info-item"><div class="info-label">Próxima reunião</div><div class="info-value">' + p.proxima_reuniao + '</div></div>' : '') +
          (p.contato_nome ? '<div class="info-item"><div class="info-label">Contato</div><div class="info-value">' + escapeHtml(p.contato_nome) + '</div></div>' : '') +
          (p.contato_email ? '<div class="info-item"><div class="info-label">Email</div><div class="info-value">' + escapeHtml(p.contato_email) + '</div></div>' : '') +
          (p.contato_telefone ? '<div class="info-item"><div class="info-label">Telefone</div><div class="info-value">' + escapeHtml(p.contato_telefone) + '</div></div>' : '') +
          (p.condicoes_financeiras ? '<div class="info-item"><div class="info-label">Condições financeiras</div><div class="info-value">' + escapeHtml(p.condicoes_financeiras) + '</div></div>' : '') +
        '</div>' +

        (p.combinados ? '<div class="card mb-3" style="background:var(--surface-2);padding:12px"><div class="info-label" style="margin-bottom:6px">📋 Combinados</div><div style="font-size:13px;white-space:pre-wrap">' + escapeHtml(p.combinados) + '</div></div>' : '') +
        (p.observacoes ? '<div class="card mb-3" style="background:var(--surface-2);padding:12px"><div class="info-label" style="margin-bottom:6px">📝 Observações</div><div style="font-size:13px;white-space:pre-wrap">' + escapeHtml(p.observacoes) + '</div></div>' : '') +

        // Resultados (timeline)
        '<div class="card-header" style="margin-top:14px"><div class="card-title">📊 Resultados</div>' +
          '<button class="btn btn-primary btn-sm" onclick="addResultadoParceria(\'' + p.id + '\')">+ Adicionar resultado</button></div>' +
        (resultados.length === 0
          ? '<div class="text-mu text-sm" style="padding:14px;background:var(--surface-2);border-radius:8px">Nenhum resultado registrado ainda. Clique em "+ Adicionar resultado" pra começar a mensurar.</div>'
          : '<div style="display:flex;flex-direction:column;gap:6px">' +
              resultados.map(r => {
                const tipoLbl = tiposRes[r.tipo] || r.tipo;
                return '<div style="display:flex;align-items:flex-start;gap:10px;padding:10px 12px;background:var(--surface-2);border-radius:8px;border-left:3px solid var(--accent)">' +
                  '<div style="flex:1">' +
                    '<div style="display:flex;align-items:center;gap:8px;margin-bottom:3px"><strong style="font-size:13px">' + tipoLbl + '</strong>' + (r.valor>0?' · <strong style="color:var(--success-text)">R$ ' + parseFloat(r.valor).toFixed(2) + '</strong>':'') + '</div>' +
                    '<div style="font-size:12.5px">' + escapeHtml(r.descricao||'') + '</div>' +
                    '<div class="text-xs text-3" style="margin-top:3px">' + (r.data||'') + (r.contato_cliente?' · '+escapeHtml(r.contato_cliente):'') + '</div>' +
                  '</div>' +
                  '<button class="icon-btn" onclick="excluirResultadoParceria(\'' + r.id + '\',\'' + p.id + '\')" style="color:var(--danger);width:26px;height:26px;font-size:13px">×</button>' +
                '</div>';
              }).join('') +
            '</div>') +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

function addResultadoParceria(parceriaId){
  const tipo = prompt('Tipo de resultado:\n- lead\n- venda\n- evento\n- conteudo\n- reuniao\n- outro', 'lead');
  if(!tipo) return;
  const descricao = prompt('Descrição do resultado:');
  if(!descricao) return;
  const valor = parseFloat(prompt('Valor R$ (deixe 0 se nao aplicavel):','0')) || 0;
  const dataStr = prompt('Data (YYYY-MM-DD):', new Date().toISOString().split('T')[0]);
  if(!dataStr) return;
  const contato = prompt('Nome do cliente/lead (opcional):','') || null;

  (async () => {
    const payload = {parceria_id: parceriaId, tipo, descricao: descricao.trim(), valor, data: dataStr, contato_cliente: contato};
    if(_supa){
      const { data, error } = await _supa.from('parcerias_resultados').insert(payload).select().single();
      if(error){ toast('Erro: '+error.message,'info'); return; }
      _parceriasResultados.unshift(data);
    }
    toast('✓ Resultado adicionado','success');
    document.getElementById('parceriaDetModal').remove();
    abrirParceriaDetalhe(parceriaId);
  })();
}

async function excluirResultadoParceria(resId, parceriaId){
  if(!(await confirmDelete('resultado'))) return;
  if(_supa){
    const { error } = await _supa.from('parcerias_resultados').delete().eq('id', resId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  _parceriasResultados = _parceriasResultados.filter(r => r.id !== resId);
  toast('Resultado excluido','success');
  document.getElementById('parceriaDetModal').remove();
  abrirParceriaDetalhe(parceriaId);
}

async function debugRelacionamentosCRM(){
  let info = '<div style="font-family:monospace;font-size:11.5px;line-height:1.6">';
  info += '<strong>Versao do app:</strong> v3.63 (relatorio)<br>';
  info += '<strong>_relacionamentos.length:</strong> ' + (_relacionamentos||[]).length + '<br><br>';
  if(_supa){
    try {
      const r = await _supa.from('client_relationships').select('*').limit(3);
      info += '<strong>Banco retornou ' + ((r.data||[]).length) + ' registros (amostra):</strong><br>';
      if(r.error) info += '<span style="color:red">ERRO: ' + r.error.message + '</span><br>';
      (r.data||[]).forEach((reg, i) => {
        info += '<br><strong>Registro ' + (i+1) + ':</strong><br>';
        Object.keys(reg).sort().forEach(k => {
          info += '&nbsp;&nbsp;' + k + ' = ' + JSON.stringify(reg[k]) + '<br>';
        });
      });
    } catch(e){
      info += '<span style="color:red">EXCECAO: ' + e.message + '</span>';
    }
  } else {
    info += '<span style="color:red">_supa nao definido</span>';
  }
  info += '</div>';
  // Modal
  let m = document.getElementById('crmDbgModal');
  if(m) m.remove();
  m = document.createElement('div');
  m.id = 'crmDbgModal';
  m.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:18px';
  m.onclick = (e) => { if(e.target===m) m.remove(); };
  m.innerHTML = '<div style="background:var(--surface);border-radius:12px;padding:22px;max-width:680px;width:100%;max-height:85vh;overflow:auto"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px"><div style="font-size:15px;font-weight:700">🐛 Debug CRM</div><button class="icon-btn" onclick="document.getElementById(\'crmDbgModal\').remove()" style="font-size:18px">×</button></div>' + info + '</div>';
  document.body.appendChild(m);
}
window.debugRelacionamentosCRM = debugRelacionamentosCRM;

function renderRelacionamento(c){
  if(typeof _crmFiltroCli === 'undefined') window._crmFiltroCli = '';
  if(typeof _crmFiltroTipo === 'undefined') window._crmFiltroTipo = '';

  const relacs = (_relacionamentos || []).slice();
  const tiposIco = {whatsapp:'💚',ligacao:'📞',reuniao:'📹',email:'📧',presencial:'🤝',feedback:'⭐',suporte:'🔧',aprovacao:'✓'};
  const tiposLabel = {whatsapp:'WhatsApp',ligacao:'Ligação',reuniao:'Reunião',email:'Email',presencial:'Presencial',feedback:'Feedback',suporte:'Suporte',aprovacao:'Aprovação'};
  const hoje = new Date(); hoje.setHours(0,0,0,0);

  // === Saude por cliente ===
  const saudePorCliente = {};
  (clients||[]).forEach(cli => {
    const cliRels = relacs.filter(r => r.client_id === cli._dbId);
    let diasSemContato = null, ultimoContato = null;
    if(cliRels.length > 0){
      ultimoContato = cliRels.map(r => (r.data_contato||'').toString().slice(0,10) || (r.created_at||'').slice(0,10)).filter(Boolean).sort().reverse()[0];
      if(ultimoContato){ diasSemContato = Math.round((hoje - new Date(ultimoContato+'T00:00:00')) / 86400000); }
    }
    saudePorCliente[cli._dbId] = {total: cliRels.length, dias: diasSemContato};
  });

  // Demandas
  const demandas = relacs.filter(r => r.proxima_acao && r.proxima_data).map(r => {
    const d = new Date(r.proxima_data+'T00:00:00');
    return Object.assign({}, r, {diff: Math.round((d-hoje)/86400000)});
  }).sort((a,b) => a.diff - b.diff);
  const demUrgentes = demandas.filter(d => d.diff <= 7);

  // Stats
  const semContato30 = (clients||[]).filter(cli => {
    const s = saudePorCliente[cli._dbId];
    return !s || s.total === 0 || (s.dias && s.dias > 30);
  }).length;

  // Timeline filtrada
  let timeline = relacs.slice();
  if(_crmFiltroCli) timeline = timeline.filter(r => r.client_id === _crmFiltroCli);
  if(_crmFiltroTipo) timeline = timeline.filter(r => r.tipo === _crmFiltroTipo);
  timeline.sort((a,b) => {
    const ad = (a.data_contato||'').toString().slice(0,10) || (a.created_at||'').slice(0,10);
    const bd = (b.data_contato||'').toString().slice(0,10) || (b.created_at||'').slice(0,10);
    return (bd||'').localeCompare(ad||'');
  });

  // Ordena saude pra mostrar primeiro os criticos
  const clientesOrd = (clients||[]).slice().sort((a,b) => {
    const sa = saudePorCliente[a._dbId];
    const sb = saudePorCliente[b._dbId];
    const da = sa && sa.dias != null ? sa.dias : 999;
    const db = sb && sb.dias != null ? sb.dias : 999;
    return db - da;
  });

  const cliSelecionado = _crmFiltroCli ? clients.find(c => c._dbId === _crmFiltroCli) : null;

  c.innerHTML =
    '<style>' +
    '.crm-grid{display:grid;grid-template-columns:280px 1fr;gap:14px;align-items:flex-start}' +
    '@media (max-width:900px){.crm-grid{grid-template-columns:1fr}}' +
    '.crm-cli-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:7px;cursor:pointer;transition:.12s;border:1px solid transparent}' +
    '.crm-cli-item:hover{background:var(--surface-2)}' +
    '.crm-cli-item.active{background:var(--accent);color:#fff;border-color:var(--accent)}' +
    '.crm-cli-item.active .text-xs.text-3{color:rgba(255,255,255,.85) !important}' +
    '.crm-cli-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}' +
    '.crm-tl-item{position:relative;padding-left:30px;padding-bottom:18px;border-left:2px solid var(--border)}' +
    '.crm-tl-item:last-child{border-left:2px solid transparent}' +
    '.crm-tl-dot{position:absolute;left:-9px;top:0;width:16px;height:16px;border-radius:50%;background:var(--accent);border:3px solid var(--surface)}' +
    '.crm-tl-card{background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:11px 14px;position:relative}' +
    '.crm-tl-data{font-size:11px;color:var(--text-3);font-weight:600;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}' +
    '.crm-tl-tipo{display:inline-block;font-size:10.5px;padding:2px 7px;border-radius:5px;background:var(--surface);border:1px solid var(--border);margin-bottom:6px;font-weight:600}' +
    '.crm-mini-btn{padding:7px 12px;border:1.5px dashed var(--border-strong);background:transparent;color:var(--accent);border-radius:8px;cursor:pointer;font-weight:600;font-size:12px;width:100%;display:flex;align-items:center;gap:6px;justify-content:center}' +
    '.crm-mini-btn:hover{background:var(--accent);color:#fff;border-style:solid}' +
    '</style>' +

    '<div class="page-head"><div><div class="page-title">💬 Relacionamento</div>' +
    '<div class="page-sub">' + relacs.length + ' contato(s) · ' + demUrgentes.length + ' demanda(s) próxima(s) · ' + semContato30 + ' cliente(s) sem contato 30d+</div></div>' +
    '<button class="btn btn-primary" onclick="openNovoRelacionamentoModal(_crmFiltroCli||null)">+ Novo contato</button></div>' +

    // === DEMANDAS URGENTES no topo (so se houver) ===
    (demUrgentes.length > 0 ? (
      '<div class="card" style="margin-bottom:12px;background:linear-gradient(90deg,var(--warning-soft),var(--surface));border-left:4px solid var(--warning)">' +
      '<div style="display:flex;align-items:center;gap:10px;padding:10px 14px">' +
        '<div style="font-size:22px">📌</div>' +
        '<div style="flex:1;font-size:13px"><strong>' + demUrgentes.length + ' demanda(s) nos próximos 7 dias:</strong> ' +
          demUrgentes.slice(0,3).map(d => {
            const cli = clients.find(c => c._dbId === d.client_id);
            return (cli?cli.name:'') + ' (' + (d.diff<0?Math.abs(d.diff)+'d atras.':d.diff===0?'hoje':d.diff+'d') + ')';
          }).join(' · ') + (demUrgentes.length>3?' +'+(demUrgentes.length-3):'') +
        '</div>' +
      '</div></div>'
    ) : '') +

    '<div class="crm-grid">' +

      // === SIDEBAR ESQUERDA: clientes ===
      '<div class="card" style="padding:12px;position:sticky;top:14px">' +
        '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">' +
          '<div style="font-size:13px;font-weight:700">Clientes</div>' +
          (_crmFiltroCli ? '<button onclick="window._crmFiltroCli=\'\';renderRelacionamento(document.getElementById(\'content\'))" class="text-xs text-3" style="background:none;border:none;cursor:pointer;color:var(--text-3)">× limpar</button>' : '<span class="text-xs text-3">clique pra focar</span>') +
        '</div>' +
        '<div class="crm-cli-item ' + (!_crmFiltroCli?'active':'') + '" onclick="window._crmFiltroCli=\'\';renderRelacionamento(document.getElementById(\'content\'))">' +
          '<div class="crm-cli-dot" style="background:var(--text-3)"></div>' +
          '<div style="flex:1"><div style="font-size:12.5px;font-weight:600">Todos</div>' +
          '<div class="text-xs text-3">' + relacs.length + ' contato(s)</div></div>' +
        '</div>' +
        '<div style="display:flex;flex-direction:column;gap:2px;max-height:480px;overflow-y:auto;margin-top:4px">' +
          clientesOrd.map(cli => {
            const s = saudePorCliente[cli._dbId];
            const dias = s ? s.dias : null;
            const cor = dias === null || dias > 60 ? '#ef4444' : dias > 30 ? '#f59e0b' : dias > 14 ? '#0ea5e9' : '#22c55e';
            const subtxt = dias === null ? 'sem contato' : dias === 0 ? 'hoje' : dias + 'd';
            return '<div class="crm-cli-item ' + (_crmFiltroCli===cli._dbId?'active':'') + '" onclick="window._crmFiltroCli=\'' + cli._dbId + '\';renderRelacionamento(document.getElementById(\'content\'))">' +
              '<div class="crm-cli-dot" style="background:' + cor + '"></div>' +
              '<div style="flex:1;min-width:0"><div style="font-size:12.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + cli.name + '</div>' +
              '<div class="text-xs text-3">' + subtxt + ' · ' + (s?s.total:0) + ' cont.</div></div>' +
            '</div>';
          }).join('') +
        '</div>' +
      '</div>' +

      // === CONTEUDO PRINCIPAL: timeline ===
      '<div>' +
        // Cabecalho do cliente selecionado
        (cliSelecionado ? (() => {
          // Pega a proxima acao mais proxima desse cliente (ainda nao concluida)
          const proxDoCli = relacs.filter(r => r.client_id === cliSelecionado._dbId && r.proxima_acao && r.proxima_data)
            .map(r => { const d = new Date(r.proxima_data+'T00:00:00'); return Object.assign({}, r, {diff: Math.round((d-hoje)/86400000)}); })
            .sort((a,b) => a.diff - b.diff)[0];
          const cabecalho =
            '<div class="card" style="padding:14px 18px;margin-bottom:12px;display:flex;align-items:center;gap:14px">' +
              '<div class="cron-cli-logo" style="background:' + cliSelecionado.color + ';width:48px;height:48px;font-size:16px">' + cliSelecionado.init + '</div>' +
              '<div style="flex:1">' +
                '<div style="font-size:16px;font-weight:700">' + cliSelecionado.name + '</div>' +
                '<div class="text-xs text-3" style="margin-top:2px">' +
                  (saudePorCliente[cliSelecionado._dbId].total) + ' contato(s) registrado(s)' +
                  (saudePorCliente[cliSelecionado._dbId].dias !== null ? ' · último há ' + saudePorCliente[cliSelecionado._dbId].dias + ' dias' : ' · nunca contatado') +
                '</div>' +
              '</div>' +
              '<button class="btn btn-primary" onclick="openNovoRelacionamentoModal(\'' + cliSelecionado._dbId + '\')">+ Novo contato</button>' +
            '</div>';
          // Card de proximo contato programado / atalho pra agendar
          const labelDiff = proxDoCli ? (proxDoCli.diff < 0 ? Math.abs(proxDoCli.diff)+' dia(s) atrasada' : proxDoCli.diff === 0 ? 'HOJE' : 'em '+proxDoCli.diff+' dia(s)') : '';
          const corDiff = proxDoCli ? (proxDoCli.diff <= 0 ? 'var(--danger)' : proxDoCli.diff <= 7 ? 'var(--warning)' : 'var(--accent)') : 'var(--accent)';
          const bgDiff = proxDoCli ? (proxDoCli.diff <= 0 ? 'var(--danger-soft)' : proxDoCli.diff <= 7 ? 'var(--warning-soft)' : 'var(--surface-2)') : 'var(--surface-2)';
          const proxBox =
            '<div class="card" style="padding:14px 18px;margin-bottom:12px;background:' + bgDiff + ';border:1px solid var(--border);border-left:4px solid ' + corDiff + '">' +
              '<div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap">' +
                '<div style="flex:1;min-width:240px">' +
                  '<div class="text-xs text-3" style="text-transform:uppercase;letter-spacing:.06em;font-weight:700;margin-bottom:4px">📌 Próximo contato programado</div>' +
                  (proxDoCli ? (
                    '<div style="font-size:14.5px;font-weight:700">' + escapeHtml(proxDoCli.proxima_acao||'') + '</div>' +
                    '<div class="text-xs text-3" style="margin-top:2px">📅 ' + (proxDoCli.proxima_data||'') + ' · ' + labelDiff + '</div>'
                  ) : '<div style="font-size:13.5px;color:var(--text-3)">Nenhuma ação programada — defina prazo / lembrete abaixo</div>') +
                '</div>' +
                (proxDoCli ? '<button class="btn btn-sm" onclick="concluirDemanda(\'' + proxDoCli.id + '\')" style="padding:6px 12px;font-size:11px">✓ Concluir</button>' : '') +
              '</div>' +
              // Form rapido pra criar lembrete/proxima acao
              '<div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap;align-items:end">' +
                '<div style="flex:2;min-width:200px"><label style="font-size:10.5px;font-weight:700;color:var(--text-3);text-transform:uppercase;display:block;margin-bottom:3px">' + (proxDoCli ? 'Nova próxima ação (substitui)' : 'Próxima ação / lembrete') + '</label>' +
                  '<input id="quickProxAcao" placeholder="Ex: Ligar pra renovação, enviar proposta..." class="login-input" style="background:var(--surface);padding:8px 10px;font-size:12.5px" /></div>' +
                '<div style="flex:1;min-width:130px"><label style="font-size:10.5px;font-weight:700;color:var(--text-3);text-transform:uppercase;display:block;margin-bottom:3px">Prazo</label>' +
                  '<input id="quickProxData" type="date" class="login-input" style="background:var(--surface);padding:8px 10px;font-size:12.5px" /></div>' +
                '<button class="btn btn-primary" onclick="salvarProxAcaoRapido(\'' + cliSelecionado._dbId + '\')" style="font-size:12px;padding:8px 14px">' + (proxDoCli ? 'Atualizar' : '+ Agendar') + '</button>' +
              '</div>' +
              // Atalhos de prazo
              '<div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:8px;align-items:center">' +
                '<span class="text-xs text-3" style="font-size:10.5px">Atalho:</span>' +
                ['7 dias','15 dias','30 dias','3 meses','6 meses','1 ano'].map(label => {
                  const dias = label === '7 dias' ? 7 : label === '15 dias' ? 15 : label === '30 dias' ? 30 : label === '3 meses' ? 90 : label === '6 meses' ? 180 : 365;
                  return '<button onclick="document.getElementById(\'quickProxData\').value = new Date(Date.now()+' + dias + '*86400000).toISOString().split(\'T\')[0]" class="filter-chip" style="font-size:10.5px;padding:3px 8px">' + label + '</button>';
                }).join('') +
              '</div>' +
            '</div>';
          return cabecalho + proxBox;
        })() : '') +

        // Quick filter de tipo
        '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">' +
          '<button onclick="window._crmFiltroTipo=\'\';renderRelacionamento(document.getElementById(\'content\'))" class="filter-chip ' + (!_crmFiltroTipo?'active':'') + '">Todos</button>' +
          Object.keys(tiposIco).map(t =>
            '<button onclick="window._crmFiltroTipo=\'' + t + '\';renderRelacionamento(document.getElementById(\'content\'))" class="filter-chip ' + (_crmFiltroTipo===t?'active':'') + '">' + tiposIco[t] + ' ' + tiposLabel[t] + '</button>'
          ).join('') +
        '</div>' +

        // Timeline vertical
        (timeline.length === 0
          ? '<div class="empty-state" style="padding:50px 20px"><div class="ico">💬</div><div class="ttl">Nenhum contato</div><div class="desc">' + (cliSelecionado ? 'Registre o primeiro contato com ' + cliSelecionado.name : 'Selecione um cliente ou registre um contato') + '</div></div>'
          : '<div style="padding-left:8px">' +
              timeline.map((r,idx) => {
                const cli = clients.find(c => c._dbId === r.client_id);
                const cor = cli ? cli.color : '#888';
                const ico = tiposIco[r.tipo] || '📌';
                // Fallback: data_contato OU created_at OU updated_at
                // IMPORTANTE: data_contato pode vir como timestamp ("2026-05-26T00:00:00+00:00"),
                // entao SEMPRE pega apenas os primeiros 10 chars (YYYY-MM-DD)
                let dataStrR = (r.data_contato || '').toString().slice(0, 10);
                if(!dataStrR && r.created_at){ dataStrR = (r.created_at + '').slice(0, 10); }
                if(!dataStrR && r.updated_at){ dataStrR = (r.updated_at + '').slice(0, 10); }
                const dataObj = dataStrR ? new Date(dataStrR+'T12:00:00') : null;
                const dataFmt = (dataObj && !isNaN(dataObj.getTime())) ? dataObj.toLocaleDateString('pt-BR',{day:'2-digit',month:'short',year:'numeric',weekday:'short'}) : 'sem data';
                return '<div class="crm-tl-item">' +
                  '<div class="crm-tl-dot" style="background:' + cor + '">' +
                    '<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:9px">' + ico + '</div>' +
                  '</div>' +
                  '<div class="crm-tl-card">' +
                    '<div class="crm-tl-data">' + dataFmt + (r.responsavel_nome ? ' · por ' + escapeHtml(r.responsavel_nome) : '') + '</div>' +
                    (!cliSelecionado && cli ? '<div style="font-size:13px;font-weight:700;margin-bottom:4px">' + cli.name + '</div>' : '') +
                    '<span class="crm-tl-tipo">' + ico + ' ' + tiposLabel[r.tipo] + '</span>' +
                    '<div style="font-size:13px;line-height:1.5">' + escapeHtml(r.resumo||'') + '</div>' +
                    (r.proxima_acao ? '<div style="margin-top:8px;padding:7px 10px;background:var(--warning-soft);border-radius:6px;border-left:2px solid var(--warning);font-size:11.5px"><strong>📌 Próxima ação:</strong> ' + escapeHtml(r.proxima_acao) + (r.proxima_data?' <span style="color:var(--text-3)">(' + r.proxima_data + ')</span>':'') + '</div>' : '') +
                    '<button class="icon-btn" onclick="excluirRelacionamento(\'' + r.id + '\')" title="Excluir" style="position:absolute;top:8px;right:8px;width:22px;height:22px;color:var(--danger);font-size:14px;opacity:.6">×</button>' +
                  '</div>' +
                '</div>';
              }).join('') +
            '</div>') +
      '</div>' +

    '</div>';
}

// Conclui demanda: limpa proxima_acao do relacionamento
async function salvarProxAcaoRapido(clientDbId){
  const acao = (document.getElementById('quickProxAcao').value||'').trim();
  const data = document.getElementById('quickProxData').value;
  if(!acao){ toast('Escreva a próxima ação','info'); return; }
  if(!data){ toast('Defina o prazo','info'); return; }
  if(!clientDbId){ toast('Cliente nao identificado','info'); return; }

  // Procura se ja existe uma proxima acao pra esse cliente — se sim, atualiza
  const existente = (_relacionamentos||[]).filter(r => r.client_id === clientDbId && r.proxima_acao && r.proxima_data)
    .sort((a,b) => (a.proxima_data||'').localeCompare(b.proxima_data||''))[0];

  if(existente){
    if(_supa){
      const { error } = await _supa.from('client_relationships').update({proxima_acao: acao, proxima_data: data}).eq('id', existente.id);
      if(error){ toast('Erro: '+error.message,'info'); return; }
    }
    existente.proxima_acao = acao;
    existente.proxima_data = data;
    toast('✓ Próxima ação atualizada','success');
  } else {
    // Cria um registro novo "ancora" pra essa proxima acao (sem contato passado)
    const hojeStr = new Date().toISOString().split('T')[0];
    const payload = {
      client_id: clientDbId,
      tipo: 'whatsapp',
      data_contato: hojeStr,
      responsavel_nome: (_currentProfile && _currentProfile.name) || null,
      resumo: '(lembrete agendado)',
      proxima_acao: acao,
      proxima_data: data
    };
    if(_currentProfile && _currentProfile.id) payload.profile_id = _currentProfile.id;
    if(_supa){
      const { data: row, error } = await _supa.from('client_relationships').insert(payload).select().single();
      if(error){ toast('Erro: '+error.message,'info'); return; }
      _relacionamentos.unshift(row);
    } else {
      _relacionamentos.unshift(Object.assign({}, payload, {id:'tmp-'+Date.now()}));
    }
    toast('✓ Próxima ação agendada','success');
  }
  renderRelacionamento(document.getElementById('content'));
}

async function concluirDemanda(relacId){
  const r = (_relacionamentos||[]).find(x => x.id === relacId);
  if(!r){ toast('Demanda nao encontrada','info'); return; }
  if(!confirm('Concluir essa demanda?\n\n"' + (r.proxima_acao||'') + '"')) return;
  if(_supa){
    const { error } = await _supa.from('client_relationships').update({proxima_acao: null, proxima_data: null}).eq('id', relacId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  r.proxima_acao = null;
  r.proxima_data = null;
  toast('✓ Demanda concluida','success');
  if(currentPage === 'relacionamento') renderRelacionamento(document.getElementById('content'));
  if(currentPage === 'dashboard' && typeof renderDashboard === 'function') renderDashboard(document.getElementById('content'));
}

