// Salva um campo simples do antes_impulse
async function salvarAntesField(clienteId, campo, valor){
  const cli = clients.find(c => c.id === clienteId);
  if(!cli) return;
  if(!cli.antes_impulse) cli.antes_impulse = {};
  cli.antes_impulse[campo] = valor;
  if(_supa && cli._dbId){
    const { error } = await _supa.from('clients').update({antes_impulse: cli.antes_impulse}).eq('id', cli._dbId);
    if(error){ toast('Erro: '+error.message,'info'); console.warn(error); return; }
  }
  if(campo === 'print_url'){
    // re-render pra atualizar o preview
    openClient(clienteId);
  }
  if(typeof toast === 'function') toast('✓ Salvo','success');
}

// Salva um campo de seguidores
async function salvarAntesSeguidor(clienteId, rede, valor){
  const cli = clients.find(c => c.id === clienteId);
  if(!cli) return;
  if(!cli.antes_impulse) cli.antes_impulse = {};
  if(!cli.antes_impulse.seguidores) cli.antes_impulse.seguidores = {};
  cli.antes_impulse.seguidores[rede] = parseInt(valor)||0;
  if(_supa && cli._dbId){
    const { error } = await _supa.from('clients').update({antes_impulse: cli.antes_impulse}).eq('id', cli._dbId);
    if(error){ toast('Erro: '+error.message,'info'); return; }
  }
  if(typeof toast === 'function') toast('✓ Salvo','success');
}

// Upload do print (compressao simples + base64)
async function uploadAntesPrint(clienteId, input){
  const f = input.files && input.files[0];
  if(!f) return;
  if(f.size > 5*1024*1024){ toast('Imagem muito grande (max 5MB)','info'); return; }
  toast('Carregando imagem...','info');
  // Tenta Storage primeiro
  const cli = clients.find(c => c.id === clienteId);
  let url = null;
  if(_supa && cli && cli._dbId){
    try {
      const path = 'clientes/'+cli._dbId+'/antes-'+Date.now()+'.'+(f.name.split('.').pop()||'png');
      const { data, error } = await _supa.storage.from('uploads').upload(path, f);
      if(!error){
        const { data: pub } = _supa.storage.from('uploads').getPublicUrl(path);
        url = pub.publicUrl;
      }
    } catch(e){ console.warn('[storage]', e); }
  }
  if(!url){
    // Fallback base64
    url = await new Promise((res) => { const fr = new FileReader(); fr.onload = () => res(fr.result); fr.readAsDataURL(f); });
  }
  await salvarAntesField(clienteId, 'print_url', url);
}

