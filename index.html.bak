  return `
    <div class="modal-pane" data-pane="briefing">
      <div class="info-grid">
        <div class="info-item"><div class="info-label">História da marca</div><div class="info-value">${cli.name} foi fundada com o propósito de transformar...</div></div>
        <div class="info-item"><div class="info-label">Diferenciais</div><div class="info-value">Qualidade, atendimento próximo, expertise técnica</div></div>
        <div class="info-item"><div class="info-label">Valores</div><div class="info-value">Confiança, inovação, transparência</div></div>
        <div class="info-item"><div class="info-label">Objetivos</div><div class="info-value">Expandir presença digital · +30% receita</div></div>
        <div class="info-item"><div class="info-label">Público-alvo</div><div class="info-value">B2B · decisores · 30-55 anos</div></div>
        <div class="info-item"><div class="info-label">Dores do público</div><div class="info-value">Falta de tempo, complexidade técnica</div></div>
        <div class="info-item"><div class="info-label">Tom de comunicação</div><div class="info-value">Profissional, próximo, didático</div></div>
        <div class="info-item"><div class="info-label">Posicionamento</div><div class="info-value">Premium acessível</div></div>
        <div class="info-item"><div class="info-label">Concorrentes</div><div class="info-value">3 monitorados</div></div>
        <div class="info-item"><div class="info-label">Datas importantes</div><div class="info-value">Aniversário 22/mai · Feira setor 12/ago</div></div>
        <div class="info-item"><div class="info-label">Redes sociais</div><div class="info-value">IG · FB · LinkedIn</div></div>
        <div class="info-item"><div class="info-label">Metas</div><div class="info-value">+50% seguidores · 30 leads/mês</div></div>
      </div>
      <div class="section-title">Arquivos anexados</div>
      <div class="file-grid">
        ${['Briefing inicial.pdf','Manual da marca.pdf','Referências.zip','Gravação kickoff.mp4'].map((f,i)=>{
          const ic=['📄','📕','📦','🎬'][i];
          return `<div class="file"><div class="file-icon">${ic}</div><div class="file-name">${f}</div><div class="file-meta">${Math.floor(Math.random()*8+1)} MB</div></div>`;
        }).join('')}
      </div>
    </div>
  `;
}

function paneConteudo(cli){
  return `
    <div class="modal-pane" data-pane="conteudo">
      <div class="text-mu text-sm mb-4">Calendário editorial — Maio/2026</div>
      ${['Instagram','Reels','Stories','TikTok'].map(p=>`
        <div class="card mb-3">
          <div class="card-header"><div class="card-title">${p}</div><span class="badge b-default">${Math.floor(Math.random()*8+3)} posts</span></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            ${Array.from({length:5}).map((_,i)=>{
              const st=['Aprovado','Aprovado','Em produção','Aguardando','Publicado'][i];
              const co=['b-success','b-success','b-warning','b-info','b-purple'][i];
