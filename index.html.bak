// ============ CLIENTES (grid de botões 4 por linha) ============
function renderClientes(c){
  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Clientes</div>
          <div class="page-subtitle">${clients.length} clientes · ${clients.filter(x=>x.status==='active').length} ativos · ordem alfabética</div>
        </div>
        <div class="page-actions">
          <div class="page-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder="Buscar cliente, segmento, owner..." oninput="filterClientes(this.value)"/></div>
          <button class="btn" onclick="toast('Filtros avançados','info')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M6 12h12M10 18h4"/></svg>Filtros</button>
          <button class="btn btn-primary" onclick="openNovoClienteModal()">+ Adicionar</button>
        </div>
      </div>

      <div class="filter-bar">
        <span class="filter-chip active" onclick="cliFilterStatus('all',this)">Todos · ${clients.length}</span>
        <span class="filter-chip" onclick="cliFilterStatus('active',this)">Ativos · ${clients.filter(x=>x.status==='active').length}</span>
        <span class="filter-chip" onclick="cliFilterStatus('onboarding',this)">Onboarding · ${clients.filter(x=>x.status==='onboarding').length}</span>
        <span class="filter-chip" onclick="cliFilterStatus('paused',this)">Pausados · ${clients.filter(x=>x.status==='paused').length}</span>
        <span class="filter-chip" onclick="cliFilterStatus('late',this)">Atrasados · ${clients.filter(x=>x.status==='late').length}</span>
      </div>

      <div class="cli-grid-btn" id="cliList">
        ${clients.map(cli=>{
          const plan = planoCliente(cli.id);
          const searchKey = `${cli.name} ${cli.segment} ${cli.owner} ${plan.name}`.toLowerCase();
          return `
            <button class="cli-btn" data-search="${searchKey}" data-status="${cli.status}" onclick="openClient(${cli.id})">
              <div class="cli-btn-logo" style="background:${cli.color}">${cli.init}</div>
              <div class="cli-btn-name">${cli.name}</div>
            </button>
          `;
        }).join('')}
      </div>

      <div class="empty-state" id="cliEmpty" style="display:none">
        <div class="ico">🔍</div>
        <div class="ttl">Nenhum cliente encontrado</div>
        <div class="desc">Tente outro termo de busca ou filtro.</div>
      </div>
    </div>
  `;
}
function filterClientes(q){
  const list = document.getElementById('cliList');
  const empty = document.getElementById('cliEmpty');
  if(!list) return;
  const v = (q||'').toLowerCase();
  let shown = 0;
  list.querySelectorAll('.cli-btn').forEach(row=>{
    const matchSearch = row.dataset.search.includes(v);
    const activeStatus = list.dataset.status || 'all';
    const matchStatus = activeStatus==='all' || row.dataset.status===activeStatus;
    const show = matchSearch && matchStatus;
    row.style.display = show?'':'none';
    if(show) shown++;
  });
  if(empty) empty.style.display = shown===0?'':'none';
}
function cliFilterStatus(status,el){
  el.parentNode.querySelectorAll('.filter-chip').forEach(s=>s.classList.toggle('active',s===el));
  const list = document.getElementById('cliList');
  if(list){list.dataset.status = status;}
  const inp = document.querySelector('.page-search input');
  filterClientes(inp?inp.value:'');
}


// ============ MODAL: NOVO CLIENTE ============
function openNovoClienteModal(){
  const mod = document.getElementById('clientModal');
  const colors = ['#0ea5e9','#7c3aed','#ec4899','#f59e0b','#10b981','#ef4444','#06b6d4','#a855f7','#f97316','#3b82f6','#84cc16','#14b8a6','#f43f5e','#22c55e','#ea580c','#eab308'];
  const randColor = colors[Math.floor(Math.random()*colors.length)];
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:${randColor};color:#fff;display:grid;place-items:center;font-weight:700">+</div>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;letter-spacing:-.02em">Novo cliente</div>
        <div class="text-xs text-3" style="margin-top:3px">Preencha os dados basicos - voce pode editar depois</div>
      </div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><div class="info-label" style="margin-bottom:5px">Nome da empresa *</div><input id="ncName" class="login-input" placeholder="Ex: Acme Corp" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Segmento</div><input id="ncSeg" class="login-input" placeholder="Ex: Tecnologia" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">WhatsApp</div><input id="ncPhone" class="login-input" placeholder="11999999999" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Email</div><input id="ncEmail" class="login-input" type="email" placeholder="contato@empresa.com" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Instagram</div><input id="ncIg" class="login-input" placeholder="@empresa" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Site</div><input id="ncSite" class="login-input" placeholder="empresa.com.br" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Plano</div>
          <select id="ncPlan" class="login-input" style="background:var(--surface-2)">
            <option value="Essencial">Essencial (R$ 1.800/mes)</option>
            <option value="Crescimento">Crescimento (R$ 3.200/mes)</option>
            <option value="Premium">Premium (R$ 5.500/mes)</option>
            <option value="Enterprise">Enterprise (R$ 8.900/mes)</option>
          </select>
        </div>
        <div><div class="info-label" style="margin-bottom:5px">Status</div>
          <select id="ncStatus" class="login-input" style="background:var(--surface-2)">
            <option value="onboarding">Onboarding</option>
            <option value="active">Ativo</option>
            <option value="paused">Pausado</option>
          </select>
        </div>
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Cor de identidade</div>
          <div style="display:flex;gap:6px;flex-wrap:wrap">
            ${colors.map(col=>`<button type="button" onclick="document.getElementById('ncColorVal').value='${col}';document.querySelectorAll('.color-pick').forEach(x=>x.style.transform='scale(1)');this.style.transform='scale(1.3)'" class="color-pick" style="width:28px;height:28px;border-radius:7px;background:${col};border:2px solid var(--border);cursor:pointer;transition:.15s;${col===randColor?'transform:scale(1.3)':''}"></button>`).join('')}
          </div>
          <input type="hidden" id="ncColorVal" value="${randColor}" />
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovoCliente()" id="ncSaveBtn">Criar cliente</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
  setTimeout(()=>document.getElementById('ncName').focus(), 100);
}

async function salvarNovoCliente(){
  const name = document.getElementById('ncName').value.trim();
  if(!name){toast('Nome obrigatorio','info');document.getElementById('ncName').focus();return}
  const plan = document.getElementById('ncPlan').value;
  const planVals = {Essencial:1800,Crescimento:3200,Premium:5500,Enterprise:8900};
  const btn = document.getElementById('ncSaveBtn');
  btn.disabled = true; btn.textContent = 'Salvando...';
  const data = {
    name,
    segment: document.getElementById('ncSeg').value.trim(),
    phone: document.getElementById('ncPhone').value.trim().replace(/\D/g,''),
    email: document.getElementById('ncEmail').value.trim(),
    instagram: document.getElementById('ncIg').value.trim(),
    website: document.getElementById('ncSite').value.trim(),
    plan_name: plan,
    plan_value: planVals[plan],
    mrr: planVals[plan],
    status: document.getElementById('ncStatus').value,
    color: document.getElementById('ncColorVal').value,
    initials: name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase()
  };
  const created = await createClientInSupabase(data);
  if(created){
    closeModal();
    renderClientes(document.getElementById('content'));
  } else {
    btn.disabled = false; btn.textContent = 'Criar cliente';
  }
}

async function confirmarExcluirCliente(id){
  const cli = clients.find(c=>c.id===id);
  if(!cli) return;
  if(!cli._dbId){toast('Cliente nao esta no banco (modo demo)','info');return}
  if(!confirm(`Excluir o cliente "${cli.name}"?\n\nEsta acao NAO pode ser desfeita. Todos os dados relacionados (captacoes, cronograma, etc.) tambem serao apagados.`)) return;
  const ok = await deleteClientFromSupabase(cli._dbId, cli.name);
  if(ok){
    closeModal();
    renderClientes(document.getElementById('content'));
  }
}


// ============ CLIENT MODAL ============
function openClient(id){
  const cli = clients.find(x=>x.id===id);if(!cli)return;
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div class="client-logo" style="background:${cli.color};width:48px;height:48px;font-size:16px">${cli.init}</div>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;letter-spacing:-.02em">${cli.name}</div>
        <div class="text-xs text-3" style="margin-top:3px">${cli.segment} · Owner: ${cli.owner} · MRR R$ ${cli.mrr.toLocaleString('pt-BR')}</div>
      </div>
      ${statBadge(cli.status)}
      <button class="icon-btn" title="Excluir cliente" onclick="confirmarExcluirCliente(${cli.id})" style="color:var(--danger);margin-right:4px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg></button>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-tabs">
      <div class="modal-tab active" onclick="cliTab(this,'visao')">Visão geral</div>
      <div class="modal-tab" onclick="cliTab(this,'acessos')">🔐 Acessos</div>
      <div class="modal-tab" onclick="cliTab(this,'jornada')">Jornada</div>
      <div class="modal-tab" onclick="cliTab(this,'briefing')">Briefing</div>
      <div class="modal-tab" onclick="cliTab(this,'conteudo')">Conteúdo</div>
      <div class="modal-tab" onclick="cliTab(this,'plano')">Plano & Serviços</div>
      <div class="modal-tab" onclick="cliTab(this,'arquivos')">Arquivos</div>
      <div class="modal-tab" onclick="cliTab(this,'historico')">Histórico</div>
    </div>
    <div class="modal-body">
      ${paneVisao(cli)}
      ${paneAcessos(cli)}
      ${paneJornada(cli)}
      ${paneBriefing(cli)}
      ${paneConteudo(cli)}
      ${paneFinanceiro(cli)}
      ${paneArquivos(cli)}
      ${paneHistorico(cli)}
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}
function cliTab(el,pane){
  el.parentNode.querySelectorAll('.modal-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.modal-pane').forEach(p=>p.classList.toggle('active',p.dataset.pane===pane));
}

