      <div class="file-grid">
        ${[['📁','Criativos maio','42 arquivos'],['📁','Identidade visual','18 arquivos'],['📁','Vídeos','7 arquivos'],['📄','Contrato 2026.pdf','1.2 MB'],['📊','Relatório abril.pdf','3.4 MB'],['🖼','Logo final.png','280 KB'],['🎬','Reels 17mai.mp4','24 MB'],['📕','Manual da marca.pdf','8.1 MB']].map(f=>`<div class="file" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')"><div class="file-icon">${f[0]}</div><div class="file-name">${f[1]}</div><div class="file-meta">${f[2]}</div></div>`).join('')}
