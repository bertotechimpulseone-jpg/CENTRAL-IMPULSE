        <div><div class="info-label" style="margin-bottom:5px">Prioridade</div><select id="ntkPrio" class="login-input" style="background:var(--surface-2)"><option value="urgent">Urgente</option><option value="high">Alta</option><option value="med" selected>Média</option><option value="low">Baixa</option></select></div>
