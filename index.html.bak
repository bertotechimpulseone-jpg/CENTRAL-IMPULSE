      <div class="qa-grid">
        <button class="qa" onclick="whatsApp('${cli.phone}','${cli.name}')"><span class="qa-icon">💬</span><span><div style="font-weight:600">WhatsApp</div><div class="text-xs text-3">Abrir conversa</div></span></button>
        <button class="qa" onclick="openLinksManager('client-'+${cli.id}+'-instagram', '📷 Instagram - ${cli.name}', 'https://instagram.com/'+'${cli.ig}'.replace('@',''))"><span class="qa-icon">📷</span><span><div style="font-weight:600">Instagram</div><div class="text-xs text-3">${cli.ig}</div></span></button>
        <button class="qa" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')"><span class="qa-icon">📁</span><span><div style="font-weight:600">Google Drive</div><div class="text-xs text-3">Pasta do cliente</div></span></button>
        <button class="qa" onclick="openLinksManager('dashboard-meet','📹 Google Meet','https://meet.google.com/new')"><span class="qa-icon">📹</span><span><div style="font-weight:600">Google Meet</div><div class="text-xs text-3">Iniciar reunião</div></span></button>
        <button class="qa" onclick="openLinksManager('dashboard-mlabs','📅 MLABS','https://app.mlabs.com.br')"><span class="qa-icon">📅</span><span><div style="font-weight:600">MLABS</div><div class="text-xs text-3">Agendar posts</div></span></button>
        <button class="qa" onclick="openLinksManager('client-'+${cli.id}+'-site', '🌐 Site - ${cli.name}', 'https://${cli.site}')"><span class="qa-icon">🌐</span><span><div style="font-weight:600">Site</div><div class="text-xs text-3">${cli.site}</div></span></button>
        <button class="qa" onclick="openLinksManager('client-'+${cli.id}+'-contrato', '📄 Contrato - ${cli.name}', '')"><span class="qa-icon">📄</span><span><div style="font-weight:600">Contrato</div><div class="text-xs text-3">PDF</div></span></button>
        <button class="qa" onclick="openLinksManager('client-'+${cli.id}+'-criativos', '🎨 Criativos - ${cli.name}', '')"><span class="qa-icon">🎨</span><span><div style="font-weight:600">Criativos</div><div class="text-xs text-3">42 arquivos</div></span></button>
        <button class="qa" onclick="openLinksManager('client-'+${cli.id}+'-relatorios', '📊 Relatórios - ${cli.name}', '')"><span class="qa-icon">📊</span><span><div style="font-weight:600">Relatórios</div><div class="text-xs text-3">Mensal</div></span></button>
        <button class="qa" onclick="copy('https://app.novastudio.com.br/c/${cli.id}','Link do cliente')"><span class="qa-icon">🔗</span><span><div style="font-weight:600">Copiar link</div><div class="text-xs text-3">Compartilhar</div></span></button>
      </div>

      <div class="card mb-4">
        <div class="card-header"><div class="card-title">⚡ Mensagens prontas — WhatsApp</div></div>
        <div class="qa-grid" style="grid-template-columns:repeat(auto-fit,minmax(110px,1fr))">
          ${[
            ['💰','Cobrança',`Olá ${cli.name}! Tudo bem? Passando para lembrar do vencimento da mensalidade. Qualquer dúvida estamos à disposição.`],
            ['✅','Aprovação','Olá! Os conteúdos da semana estão prontos para aprovação. Pode dar uma olhada quando puder?'],
            ['📅','Reunião','Olá! Vamos marcar nossa reunião mensal? Tenho disponibilidade nos seguintes horários...'],
            ['📦','Material','Olá! Enviamos o material novo no Drive. Qualquer ajuste é só avisar!'],
            ['🔁','Follow-up','Olá! Passando para saber se conseguiu analisar nossa proposta. Estou à disposição!'],
            ['🎂','Aniversário',`Feliz aniversário, ${cli.name}! Que seu ano seja repleto de conquistas. Toda a equipe Nova torce por vocês!`],
            ['📝','Pós-reunião','Obrigado pela reunião de hoje! Em anexo o resumo dos próximos passos discutidos.'],
          ].map(t=>`<button class="qa" onclick="copy(\`${t[2].replace(/'/g,"\\'")}\`,'Mensagem');whatsApp('${cli.phone}','${cli.name}')"><span class="qa-icon">${t[0]}</span><span style="font-weight:600">${t[1]}</span></button>`).join('')}
