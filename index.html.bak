    <div class="section-title">✓ Próximos passos</div>
    ${[['Trazer 3 referências de criadores','Julia · 22 mai',false],['Atualizar calendário junho','Éllen · 18 mai',true],['Roteiro vídeo "Segurança em 3 passos"','Vinicius · 24 mai',false],['Aumentar verba tráfego em 20%','Letícia · 20 mai',false]].map(p=>`<label style="display:flex;gap:8px;align-items:center;padding:7px 0;font-size:12.5px;cursor:pointer"><div class="check-box ${p[2]?'checked':''}" onclick="this.classList.toggle('checked')"></div><span>${p[0]} <span class="text-xs text-3">· ${p[1]}</span></span></label>`).join('')}
