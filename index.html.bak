            </div>
            <div class="info-item">
              <div class="info-label">Cargo</div>
              <input class="login-input" value="${m.role||''}" onblur="editProfileField(perfilId,'position',this.value);m.role=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">WhatsApp</div>
              <input class="login-input" value="${m.phone||''}" onblur="editProfileField(perfilId,'phone',this.value);m.phone=this.value" placeholder="(11) 99999-9999" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">E-mail corporativo</div>
              <input class="login-input" value="${m.email||(m.name.split(' ')[0].toLowerCase()+'@impulseone.com.br')}" onblur="editProfileField(perfilId,'email',this.value);m.email=this.value" placeholder="email@impulseone.com.br" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Endereço</div>
              <input class="login-input" value="${m.address||''}" onblur="editProfileField(perfilId,'address',this.value);m.address=this.value" placeholder="Rua, número, cidade/UF" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Tipo de contrato</div>
              <select onchange="editProfileField(perfilId,'contract_type',this.value);m.contract_type=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500;color:var(--text);font-family:inherit">
                <option value="CLT" ${(m.contract_type||'CLT')==='CLT'?'selected':''}>CLT</option>
                <option value="PJ" ${m.contract_type==='PJ'?'selected':''}>PJ</option>
                <option value="MEI" ${m.contract_type==='MEI'?'selected':''}>MEI</option>
                <option value="Estágio" ${m.contract_type==='Estágio'?'selected':''}>Estágio</option>
                <option value="Freelance" ${m.contract_type==='Freelance'?'selected':''}>Freelance</option>
              </select>
            </div>
            <div class="info-item">
              <div class="info-label">Data de admissão</div>
              <input class="login-input" type="date" value="${m.since||since.toISOString().split('T')[0]}" onblur="editProfileField(perfilId,'contract_start',this.value);m.since=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Salário (R$)</div>
              <input class="login-input" type="number" step="0.01" value="${m.salary||0}" onblur="editProfileField(perfilId,'salary',parseFloat(this.value)||0);m.salary=parseFloat(this.value)||0" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Banco / Conta</div>
              <input class="login-input" value="${m.bank||''}" onblur="editProfileField(perfilId,'bank',this.value);m.bank=this.value" placeholder="Nubank · ag 0001 · cc 12345" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">🏖 Controle de férias</div><span class="badge ${m.vacationDays-m.vacationUsed<10?'b-warning':'b-success'}">${m.vacationDays-m.vacationUsed} dias disponíveis</span></div>
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Início do período aquisitivo</div>
              <input class="login-input" type="date" value="${m.since||since.toISOString().split('T')[0]}" onblur="editProfileField(perfilId,'contract_start',this.value);m.since=this.value;renderEquipe(document.getElementById('content'))" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Fim do período aquisitivo</div>
              <input class="login-input" type="date" value="${m.vacation_period_end||new Date(since.getTime()+365*24*60*60*1000).toISOString().split('T')[0]}" onblur="editProfileField(perfilId,'vacation_period_end',this.value);m.vacation_period_end=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Dias totais</div>
              <input class="login-input" type="number" min="0" value="${m.vacationDays}" onblur="editProfileField(perfilId,'vacation_total',parseInt(this.value)||30);m.vacationDays=parseInt(this.value)||30;renderEquipe(document.getElementById('content'))" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Já utilizados</div>
              <input class="login-input" type="number" min="0" value="${m.vacationUsed}" onblur="editProfileField(perfilId,'vacation_used',parseInt(this.value)||0);m.vacationUsed=parseInt(this.value)||0;renderEquipe(document.getElementById('content'))" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Saldo (auto)</div>
              <div class="info-value"><strong style="color:var(--success-text)">${m.vacationDays-m.vacationUsed} dias</strong> <span class="text-xs text-3">(calculado)</span></div>
            </div>
            <div class="info-item">
              <div class="info-label">Prazo legal (limite)</div>
              <input class="login-input" type="date" value="${m.vacation_legal_deadline||new Date(since.getTime()+2*365*24*60*60*1000).toISOString().split('T')[0]}" onblur="editProfileField(perfilId,'vacation_legal_deadline',this.value);m.vacation_legal_deadline=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Última saída</div>
              <input class="login-input" value="${m.lastVacation||(m.vacationUsed>0?'15 dez 2024 — 15 dias':'Nunca')}" onblur="editProfileField(perfilId,'last_vacation',this.value);m.lastVacation=this.value" placeholder="Ex: 15 dez 2024 — 15 dias" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
          </div>
          ${months>10 && m.vacationUsed===0?`<div style="margin-top:12px;padding:11px;background:var(--warning-soft);border-radius:8px;color:var(--warning-text);font-size:12px;font-weight:500">⚠ Férias próximas — programe nos próximos 60 dias</div>`:''}
          <div style="margin-top:12px;display:flex;gap:6px"><button class="btn btn-sm btn-primary">📅 Programar férias</button><button class="btn btn-sm">📜 Histórico</button></div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">⏰ Jornada de trabalho</div><span class="badge b-info">Calculo automatico</span></div>
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Hora de entrada</div>
              <input class="login-input" type="time" value="${m.work_start_time||'09:00'}" onblur="editProfileField(perfilId,'work_start_time',this.value);m.work_start_time=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Hora de saída</div>
              <input class="login-input" type="time" value="${m.work_end_time||'18:00'}" onblur="editProfileField(perfilId,'work_end_time',this.value);m.work_end_time=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Intervalo (min)</div>
              <input class="login-input" type="number" min="0" max="240" value="${m.lunch_duration_min||60}" onblur="editProfileField(perfilId,'lunch_duration_min',parseInt(this.value)||60);m.lunch_duration_min=parseInt(this.value)||60" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Tolerância atraso (min)</div>
              <input class="login-input" type="number" min="0" max="60" value="${m.tolerance_min!==undefined?m.tolerance_min:15}" onblur="editProfileField(perfilId,'tolerance_min',parseInt(this.value)||0);m.tolerance_min=parseInt(this.value)||0" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item" style="grid-column:span 2">
              <div class="info-label">Dias de trabalho</div>
              <div style="display:flex;gap:6px;margin-top:4px">
                ${[['1','Seg'],['2','Ter'],['3','Qua'],['4','Qui'],['5','Sex'],['6','Sáb'],['0','Dom']].map(d => {
                  const days = (m.work_days||'1,2,3,4,5').split(',');
                  const checked = days.includes(d[0]);
                  return `<label style="display:flex;align-items:center;gap:4px;padding:6px 10px;background:${checked?'var(--accent)':'var(--surface-2)'};color:${checked?'var(--surface)':'var(--text)'};border-radius:6px;cursor:pointer;font-size:11.5px;font-weight:600"><input type="checkbox" ${checked?'checked':''} onchange="toggleWorkDay(perfilId,'${d[0]}',this.checked)" style="display:none" />${d[1]}</label>`;
                }).join('')}
              </div>
            </div>
          </div>
          <div style="background:var(--surface-2);padding:11px;border-radius:8px;margin-top:12px;font-size:12px;color:var(--text-2)">
            📊 <strong>Carga diária esperada:</strong> ${calcularCargaDiaria(m)}h por dia<br/>
            📅 <strong>Carga mensal estimada:</strong> ${(calcularCargaDiaria(m) * calcularDiasUteisMes(m)).toFixed(0)}h em ${calcularDiasUteisMes(m)} dias úteis
          </div>
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">📎 Documentos</div><button class="btn btn-sm" onclick="abrirUploadDocModal(perfilId)">+ Adicionar documento</button></div>
          <div class="file-grid" id="profile-docs-grid">
            <div class="text-mu text-sm center" style="grid-column:span 4;padding:20px">Carregando documentos...</div>
          </div>
        </div>
      </div>

      <div>
        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📊 Desempenho</div></div>
          <div class="stat-grid" style="grid-template-columns:1fr 1fr;margin-bottom:14px">
            <div class="stat">
              <div class="stat-head"><div class="stat-label">Produtividade</div><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div></div>
              <input class="login-input" type="number" min="0" max="100" value="${m.prod}" onblur="editProfileField(perfilId,'productivity',parseInt(this.value)||0);m.prod=parseInt(this.value)||0" style="background:transparent;border:none;font-size:22px;font-weight:700;letter-spacing:-.03em;padding:0;width:100%" />
              <div class="stat-sub">últimos 30d (em %)</div>
            </div>
            <div class="stat">
              <div class="stat-head"><div class="stat-label">Tarefas/semana</div><div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/></svg></div></div>
              <input class="login-input" type="number" min="0" value="${m.tasks||0}" onblur="editProfileField(perfilId,'weekly_tasks',parseInt(this.value)||0);m.tasks=parseInt(this.value)||0" style="background:transparent;border:none;font-size:22px;font-weight:700;letter-spacing:-.03em;padding:0;width:100%" />
              <div class="stat-sub">média</div>
            </div>
          </div>
          <div class="text-xs text-mu mb-2">Evolução nos últimos 6 meses</div>
          ${[78,82,85,87,m.prod-2,m.prod].map((p,i)=>{
            const lbl = ['Dez','Jan','Fev','Mar','Abr','Mai'][i];
            return `<div style="display:flex;align-items:center;gap:10px;padding:5px 0">
              <span class="text-xs text-mu" style="width:32px">${lbl}</span>
              <div class="meter" style="flex:1"><div class="meter-fill" style="width:${p}%"></div></div>
              <span class="text-xs font-semi" style="width:32px;text-align:right">${p}%</span>
            </div>`;
          }).join('')}
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">🎯 Jornada & Evolução</div><span class="badge b-info">Timeline</span></div>
          <div class="timeline">
            <div class="tl-item success"><div class="tl-date">${since.toLocaleDateString('pt-BR')}</div><div class="tl-title">Admissão na Nova</div><div class="tl-desc">Início como ${m.role}</div></div>
            ${m.vacationUsed>0?`<div class="tl-item"><div class="tl-date">DEZ 2024</div><div class="tl-title">Primeiro período de férias</div><div class="tl-desc">${m.vacationUsed} dias de descanso</div></div>`:''}
            <div class="tl-item"><div class="tl-date">MAR 2025</div><div class="tl-title">Avaliação semestral — Nota 9.0</div><div class="tl-desc">Desempenho acima da média</div></div>
            <div class="tl-item"><div class="tl-date">SET 2025</div><div class="tl-title">Aumento salarial — +12%</div><div class="tl-desc">Reconhecimento de evolução</div></div>
            <div class="tl-item"><div class="tl-date">FEV 2026</div><div class="tl-title">Avaliação trimestral — Nota 9.4</div><div class="tl-desc">Liderança em projetos</div></div>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📈 Revisão de crescimento</div><button class="btn btn-sm btn-primary">+ Nova revisão</button></div>
          <div class="text-xs text-mu mb-3">Próxima revisão: <strong>15 jun 2026</strong></div>
          <div class="info-grid">
            <div class="info-item">
              <div class="info-label">Possível promoção</div>
              <input class="login-input" value="${m.promotion_eval||(m.prod>90?'Sim — Sênior':'Em avaliação')}" onblur="editProfileField(perfilId,'promotion_eval',this.value);m.promotion_eval=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Possível aumento</div>
              <input class="login-input" value="${m.raise_eval||(m.prod>88?'+8% sugerido':'Próx. ciclo')}" onblur="editProfileField(perfilId,'raise_eval',this.value);m.raise_eval=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Áreas a desenvolver</div>
              <input class="login-input" value="${m.areas_develop||'Gestão de equipe'}" onblur="editProfileField(perfilId,'areas_develop',this.value);m.areas_develop=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
            <div class="info-item">
              <div class="info-label">Pontos fortes</div>
              <input class="login-input" value="${m.strengths||'Criatividade, prazo'}" onblur="editProfileField(perfilId,'strengths',this.value);m.strengths=this.value" style="background:transparent;border:none;font-size:13px;padding:3px 0;width:100%;font-weight:500" />
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">💬 Feedbacks recentes</div></div>
          ${[{d:'há 3 dias',t:'Excelente trabalho na campanha Marmitina',by:'Heidy'},{d:'há 2 sem',t:'Pontualidade impecável',by:'Éllen'},{d:'há 1 mês',t:'Iniciativa em melhorar processo',by:'Ederson'}].map(f=>`<div class="list-item"><div class="list-icon">💬</div><div class="list-content"><div class="list-title">${f.t}</div><div class="list-meta">${f.by}</div></div><div class="list-right text-xs">${f.d}</div></div>`).join('')}
        </div>
      </div>
    </div>
  `;
}

// ============ FOLHA PONTO ============
function renderPonto(){
  const now=new Date();
  const opts={timeZone:'America/Sao_Paulo',hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'};
  const time=now.toLocaleTimeString('pt-BR',opts);
  const dateStr=now.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo',weekday:'long',day:'numeric',month:'long',year:'numeric'});
  if(!pontoAuth){
    return `<div style="max-width:440px;margin:40px auto"><div class="card">
      <div class="ponto-clock" style="border:none;padding:0;margin-bottom:20px">
        <div class="ponto-time" id="liveClock">${time}</div>
        <div class="ponto-date">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)}</div>
        <div class="text-xs text-3" style="margin-top:6px">🇧🇷 Horário oficial de Brasília</div>
      </div>
      <div class="section-title" style="margin-top:0">Identifique-se para bater o ponto</div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div><div class="info-label" style="margin-bottom:5px">Colaborador</div>
        <select id="pontoSelect" style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13px">
          <option value="">Selecione...</option>
          ${team.map(t=>`<option value="${t.name}">${t.name}</option>`).join('')}
        </select></div>
        <div><div class="info-label" style="margin-bottom:5px">Senha individual</div>
        <input type="password" id="pontoPwd" placeholder="••••" style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13px"/></div>
        <button class="btn btn-primary" style="justify-content:center;padding:11px" onclick="pontoLogin()">🔐 Entrar para bater ponto</button>
      </div>
      <div class="text-xs text-3 center mt-4">🔒 Registro seguro · Logs auditáveis · Senha pessoal e intransferível</div>
    </div></div>`;
  }
  return `<div class="grid-2e"><div>
    <div class="ponto-clock">
      <div style="font-size:13px;color:var(--text-2);margin-bottom:8px">Olá, <strong style="color:var(--text)">${pontoUser}</strong></div>
      <div class="ponto-time" id="liveClock">${time}</div>
      <div class="ponto-date">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)}</div>
      <div class="text-xs text-3" style="margin-top:6px">🇧🇷 Horário oficial de Brasília</div>
      <div class="ponto-actions">
        <button class="ponto-btn ${pontoToday.entrada?'done':''}" onclick="batePonto('entrada')"><span class="icon">🌅</span><span>Entrada</span><span class="text-xs text-3">${pontoToday.entrada||'—'}</span></button>
        <button class="ponto-btn ${pontoToday.intervaloIn?'done':''}" onclick="batePonto('intervaloIn')"><span class="icon">🍽</span><span>Início intervalo</span><span class="text-xs text-3">${pontoToday.intervaloIn||'—'}</span></button>
        <button class="ponto-btn ${pontoToday.intervaloOut?'done':''}" onclick="batePonto('intervaloOut')"><span class="icon">☕</span><span>Fim intervalo</span><span class="text-xs text-3">${pontoToday.intervaloOut||'—'}</span></button>
        <button class="ponto-btn ${pontoToday.saida?'done':''}" onclick="batePonto('saida')"><span class="icon">🌙</span><span>Saída</span><span class="text-xs text-3">${pontoToday.saida||'—'}</span></button>
      </div>
      <div style="margin-top:16px;display:flex;gap:8px;justify-content:center"><button class="btn btn-sm" onclick="pontoAuth=false;pontoUser=null;renderEquipe(document.getElementById('content'))">Trocar usuário</button></div>
    </div>
    <div class="card mt-4">
      <div class="card-header"><div class="card-title">📊 Resumo do mês — maio/2026</div></div>
      <div class="stat-grid" style="grid-template-columns:repeat(3,1fr)">
        ${statCard('Horas trabalhadas','156h','de 176h','M12 8v4l3 3')}
        ${statCard('Banco de horas','+8h','crédito','M12 1v22')}
        ${statCard('Atrasos','2','total','M12 9v4')}
      </div>
    </div>
  </div>
  <div>
    <div class="card mb-3">
      <div class="card-header"><div class="card-title">📅 Histórico mensal</div><div style="display:flex;gap:6px"><button class="btn btn-sm">PDF</button><button class="btn btn-sm">Excel</button></div></div>
      <table class="table"><thead><tr><th>Dia</th><th>Entrada</th><th>Intervalo</th><th>Saída</th><th>Total</th></tr></thead><tbody>
        ${Array.from({length:10}).map((_,i)=>{const d=18-i;if(d<1)return '';return `<tr><td><strong>${d.toString().padStart(2,'0')}/05</strong></td><td>09:0${Math.floor(Math.random()*9)}</td><td>12:0${Math.floor(Math.random()*9)} → 13:0${Math.floor(Math.random()*9)}</td><td>18:0${Math.floor(Math.random()*9)}</td><td><strong>8h 0${Math.floor(Math.random()*9)}min</strong></td></tr>`}).join('')}
      </tbody></table>
    </div>
    <div class="card">
      <div class="card-header"><div class="card-title">🏖 Saldo de férias</div></div>
      <div class="text-xs text-mu mb-2">Período aquisitivo atual</div>
      <div class="meter mb-3"><div class="meter-fill" style="width:60%"></div></div>
      <div style="display:flex;justify-content:space-between;font-size:12px"><span>18 dias acumulados</span><span class="font-semi">de 30 dias</span></div>
    </div>
  </div></div>`;
}

function pontoLogin(){
  const sel=document.getElementById('pontoSelect').value;
  const pwd=document.getElementById('pontoPwd').value;
  if(!sel){toast('Selecione o colaborador','info');return}
  if(!pwd){toast('Digite a senha','info');return}
  pontoAuth=true;pontoUser=sel;
  toast(`Bem-vindo(a), ${sel}!`);
  renderPontoPage(document.getElementById('content'));
}
async function batePonto(tipo){
  const now=new Date();
  const t=now.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'});
  if(pontoToday[tipo]){toast('Já registrado anteriormente','info');return}
  pontoToday[tipo]=t;
  await savePontoBate(pontoUser, tipo, t);  // persiste no banco
  toast(`✓ Ponto registrado às ${t}`);
  renderPontoPage(document.getElementById('content'));
}
setInterval(()=>{
  const el=document.getElementById('liveClock');
  if(el){const now=new Date();el.textContent=now.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'})}
},1000);

// ============ FÉRIAS ============
function renderFerias(){
  return `<div class="stat-grid">
    ${statCard('Em férias agora','0','colaborador','M20 12V8H6a2 2 0 0 1 0-4h12v4')}
    ${statCard('Programadas','2','próx. 60 dias','M3 12h18')}
    ${statCard('Saldo médio','22','dias/pessoa','M12 1v22')}
    ${statCard('Alertas','1','prazo próximo','M12 9v4',null,'warning')}
  </div>
  <div class="section-title" style="margin-top:0">Controle por colaborador</div>
  <div class="card" style="padding:0">
    <table class="table"><thead><tr><th>Colaborador</th><th>Admissão</th><th>Período</th><th>Usados</th><th>Saldo</th><th>Prazo legal</th><th>Status</th></tr></thead><tbody>
    ${team.map((m,i)=>{const since=new Date(m.since);const limit=new Date(since.getTime()+2*365*24*60*60*1000);const months=Math.floor((Date.now()-since)/(1000*60*60*24*30));const saldo=m.vacationDays-m.vacationUsed;const isClose=months>10&&m.vacationUsed===0;return `<tr style="cursor:pointer" onclick="perfilId=${i};equipeView='perfil';renderEquipe(document.getElementById('content'))"><td><div style="display:flex;align-items:center;gap:10px"><div class="avatar" style="background:${m.color}">${m.init}</div><div><strong>${m.name}</strong><div class="text-xs text-3">${m.role}</div></div></div></td><td>${since.toLocaleDateString('pt-BR')}</td><td class="text-mu">${months} meses</td><td>${m.vacationUsed} dias</td><td><strong>${saldo} dias</strong></td><td class="text-mu">${limit.toLocaleDateString('pt-BR')}</td><td>${isClose?'<span class="badge b-warning">⚠ Programar</span>':saldo<=15?'<span class="badge b-success">Em dia</span>':'<span class="badge b-info">Saldo alto</span>'}</td></tr>`}).join('')}
    </tbody></table>
  </div>
  <div class="card mt-4" style="border-left:3px solid var(--warning)">
    <div class="card-header"><div class="card-title">⚠ Alertas automáticos</div></div>
    ${team.filter(m=>{const months=Math.floor((Date.now()-new Date(m.since))/(1000*60*60*24*30));return months>10&&m.vacationUsed===0}).map(m=>`<div class="list-item"><div class="avatar" style="background:${m.color}">${m.init}</div><div class="list-content"><div class="list-title">${m.name} — programar férias nos próximos 60 dias</div><div class="list-meta">Prazo legal próximo</div></div><button class="btn btn-sm btn-primary">📅 Programar</button></div>`).join('')||'<div class="text-mu text-sm">Nenhum alerta no momento.</div>'}
  </div>`;
}

// ============ CARREIRA ============
function renderCarreira(){
  return `<div class="stat-grid">
    ${statCard('Revisões trimestrais','9','programadas','M3 3v18h18')}
    ${statCard('Promoções pendentes','3','para revisão','M22 12h-4l-3 9L9 3l-3 9H2')}
    ${statCard('Aumentos sugeridos','5','este trimestre','M12 1v22')}
    ${statCard('NPS interno','9.2','+0.4','M22 11.08V12a10 10 0 1 1-5.93-9.14')}
  </div>
  <div class="section-title" style="margin-top:0">Jornada de carreira por colaborador</div>
  <div class="grid-2e">
    ${team.map((m,i)=>{const sP=m.prod>90;const sA=m.prod>88;return `<div class="card card-hover" style="cursor:pointer" onclick="perfilId=${i};equipeView='perfil';renderEquipe(document.getElementById('content'))"><div style="display:flex;align-items:center;gap:12px;margin-bottom:14px"><div class="avatar" style="background:${m.color};width:42px;height:42px;font-size:16px">${m.init}</div><div style="flex:1"><div style="font-size:14px;font-weight:700">${m.name}</div><div class="text-xs text-3">${m.role}</div></div><div style="text-align:right"><div style="font-size:18px;font-weight:700">${m.prod}%</div><div class="text-xs text-3">desempenho</div></div></div><div style="display:flex;gap:6px;flex-wrap:wrap">${sP?'<span class="badge b-success">↑ Sugerir promoção</span>':''}${sA?'<span class="badge b-info">↑ Sugerir aumento</span>':''}<span class="badge b-default">Próx. revisão: 15 jun</span></div></div>`}).join('')}
  </div>
  <div class="card mt-4">
    <div class="card-header"><div class="card-title">🔔 Lembretes automáticos</div></div>
    ${[['Revisão trimestral — todos','15 jun 2026','b-info'],['Revisão semestral — Éllen, Gabi, Heidy','01 ago 2026','b-purple'],['Revisão anual — Henrique','05 jun 2026','b-warning'],['Avaliação experiência — Haisa','12 jul 2026','b-default']].map(r=>`<div class="list-item"><div class="list-icon">🔔</div><div class="list-content"><div class="list-title">${r[0]}</div><div class="list-meta">${r[1]}</div></div><div class="list-right"><span class="badge ${r[2]}">Programado</span></div></div>`).join('')}
  </div>`;
}


async function loadTransactions(){
  if(!_supa) return [];
  const { data } = await _supa.from('transactions').select('*').order('date',{ascending:false}).limit(50);
  return data || [];
}

// ============ FINANCEIRO ============
function renderFinanceiro(c){
  const totalMrr=clients.reduce((s,c)=>s+c.mrr,0);
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Financeiro</div><div class="page-subtitle">Visão consolidada · maio/2026</div></div><div class="page-actions">${searchBar('Buscar transação...','.card table')}<button class="btn" onclick="openNovaTransacaoModal('out')">💸 Nova despesa</button><button class="btn">💸 Nova despesa</button><button class="btn btn-primary" onclick="openNovaTransacaoModal('in')">+ Nova cobrança</button></div></div>
  <div class="stat-grid">${statCard('Faturamento mês','R$ '+totalMrr.toLocaleString('pt-BR'),'+12% vs abr','M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Despesas mês','R$ 24.560','+3% vs abr','M5 12h14',null,'warning')}${statCard('Lucro líquido','R$ '+Math.round((totalMrr-24560)*0.85).toLocaleString('pt-BR'),'margem 43%','M12 1v22')}${statCard('A receber','R$ 12.800','5 cobranças','M12 8v4l3 3')}${statCard('Inadimplência','R$ 5.500','Steel Desk','M12 9v4',null,'warning')}${statCard('MRR total','R$ '+totalMrr.toLocaleString('pt-BR'),'21 contratos','M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0')}</div>
  <div class="grid-2"><div class="card"><div class="card-header"><div class="card-title">Fluxo de caixa — 12 meses</div></div><div class="chart-box"><canvas id="cashChart"></canvas></div></div><div class="card"><div class="card-header"><div class="card-title">Categorias de despesa</div></div><div class="chart-box"><canvas id="expChart"></canvas></div></div></div>
  <div class="grid-2"><div class="card"><div class="card-header"><div class="card-title">DRE simplificado</div></div><table class="table"><tbody>
    <tr><td>Receita bruta</td><td style="text-align:right"><strong>R$ ${totalMrr.toLocaleString('pt-BR')}</strong></td></tr>
    <tr><td class="text-mu">(–) Impostos (Simples 6%)</td><td style="text-align:right;color:var(--danger-text)">R$ ${Math.round(totalMrr*.06).toLocaleString('pt-BR')}</td></tr>
    <tr><td><strong>Receita líquida</strong></td><td style="text-align:right"><strong>R$ ${Math.round(totalMrr*.94).toLocaleString('pt-BR')}</strong></td></tr>
    <tr><td class="text-mu">(–) Salários e PJs</td><td style="text-align:right;color:var(--danger-text)">R$ 16.200</td></tr>
    <tr><td class="text-mu">(–) Ferramentas/SaaS</td><td style="text-align:right;color:var(--danger-text)">R$ 1.860</td></tr>
    <tr><td class="text-mu">(–) Tráfego pago</td><td style="text-align:right;color:var(--danger-text)">R$ 4.500</td></tr>
    <tr><td class="text-mu">(–) Outras despesas</td><td style="text-align:right;color:var(--danger-text)">R$ 2.000</td></tr>
    <tr style="background:var(--surface-2)"><td><strong>Lucro líquido</strong></td><td style="text-align:right;color:var(--success-text)"><strong>R$ ${Math.round((totalMrr-24560)*0.85).toLocaleString('pt-BR')}</strong></td></tr>
  </tbody></table></div>
  <div class="card"><div class="card-header"><div class="card-title">Próximos vencimentos</div></div>${clients.slice(0,7).map(cli=>`<div class="list-item"><div class="list-icon" style="background:${cli.color}1a;color:${cli.color}">${cli.init}</div><div class="list-content"><div class="list-title">${cli.name}</div><div class="list-meta">Vence em ${20+Math.floor(Math.random()*10)} mai</div></div><div class="list-right"><strong>R$ ${cli.mrr.toLocaleString('pt-BR')}</strong><div>${cli.status==='late'?'<span class="badge b-danger">Atrasado</span>':'<span class="badge b-warning">Pendente</span>'}</div></div></div>`).join('')}</div></div>
  </div>`;
  drawCashChart();drawExpChart();
}

function drawCashChart(){const ctx=document.getElementById('cashChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';new Chart(ctx,{type:'bar',data:{labels:['Jun','Jul','Ago','Set','Out','Nov','Dez','Jan','Fev','Mar','Abr','Mai'],datasets:[{label:'Entradas',data:[58,62,66,60,70,76,84,78,82,88,92,87],backgroundColor:isDark?'#f5f5f7':'#1d1d1f',borderRadius:4,barPercentage:.6},{label:'Saídas',data:[28,29,30,29,31,32,34,32,33,34,35,24.5],backgroundColor:isDark?'#3a3a44':'#d2d2d7',borderRadius:4,barPercentage:.6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:8}}},scales:{x:{grid:{display:false},ticks:{color:txtCol}},y:{grid:{color:gridCol},ticks:{color:txtCol,callback:v=>'R$ '+v+'k'}}}}});}
function drawExpChart(){const ctx=document.getElementById('expChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';new Chart(ctx,{type:'doughnut',data:{labels:['Equipe','Tráfego','Ferramentas','Impostos','Outras'],datasets:[{data:[16200,4500,1860,5220,2000],backgroundColor:['#1d1d1f','#7c3aed','#0ea5e9','#f59e0b','#a1a1a6'],borderColor:isDark?'#141417':'#fff',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'68%',plugins:{legend:{position:'right',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:10}}}}});}

// ============ AUTOMAÇÃO ============
function renderAutomacao(c){
  const autos=[{name:'Onboarding automático',desc:'Cliente fechou → Cria pastas, envia contrato, agenda kickoff',on:true,trig:'Cliente fechado',act:'Workspace + email'},{name:'Cobrança 3 dias antes',desc:'Lembrete WhatsApp antes do vencimento',on:true,trig:'D-3 vencimento',act:'WhatsApp'},{name:'Aniversário do cliente',desc:'Mensagem personalizada',on:true,trig:'Aniversário',act:'WhatsApp'},{name:'Conteúdo aprovado → Agendar',desc:'Quando cliente aprova, agenda no MLABS',on:true,trig:'Aprovação',act:'Agendar MLABS'},{name:'Aviso de atraso',desc:'Notifica responsável e gerente',on:true,trig:'Tarefa atrasada',act:'Email + Slack'},{name:'Relatório mensal',desc:'Gera e envia no dia 1',on:true,trig:'Dia 1 do mês',act:'PDF + envio'},{name:'Follow-up proposta',desc:'D+3 após envio',on:false,trig:'Proposta enviada',act:'WhatsApp'},{name:'Checklist diário',desc:'Gera tarefas diárias por colaborador',on:true,trig:'06:00 todo dia',act:'Criar checklist'}];
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Automação</div><div class="page-subtitle">${autos.filter(a=>a.on).length} ativas · 248 execuções no mês</div></div><div class="page-actions">${searchBar('Buscar automação...','#content')}<button class="btn" onclick="toast('Integrações','info')">🔗 Integrações</button><button class="btn btn-primary">+ Nova automação</button></div></div>
  <div class="stat-grid">${statCard('Ativas',autos.filter(a=>a.on).length,'rodando','M13 2 3 14h9l-1 8 10-12h-9l1-8z')}${statCard('Execuções','248','+44% mês','M22 11.08V12a10 10 0 1 1-5.93-9.14')}${statCard('Tempo economizado','42h','este mês','M12 8v4l3 3')}${statCard('Taxa sucesso','98,4%','últimos 30d','M9 11l3 3L22 4')}</div>
  <div class="section-title" style="margin-top:0">Integrações conectadas</div>
  <div class="grid-4 mb-4">${[['WhatsApp','💬','on'],['Gmail','📧','on'],['Google Agenda','📅','on'],['Slack','💼','on'],['Notion','📝','off'],['MLABS','📱','on'],['ClickUp','✅','on'],['Meta Business','📘','on']].map(i=>`<div class="card" style="padding:13px;display:flex;align-items:center;gap:11px"><div style="width:34px;height:34px;border-radius:8px;background:var(--surface-2);display:grid;place-items:center;font-size:16px">${i[1]}</div><div style="flex:1"><div class="text-sm font-semi">${i[0]}</div><div class="text-xs text-3">${i[2]==='on'?'Conectado':'Desconectado'}</div></div><div class="toggle ${i[2]==='on'?'on':''}" onclick="this.classList.toggle('on');toast(this.classList.contains('on')?'Conectado':'Desconectado')"></div></div>`).join('')}</div>
  <div class="section-title">Automações ativas</div>
  ${autos.map(a=>`<div class="card mb-3" style="display:flex;align-items:center;gap:14px;padding:14px"><div style="width:38px;height:38px;border-radius:9px;background:var(--surface-2);display:grid;place-items:center;font-size:16px">⚡</div><div style="flex:1"><div style="font-size:13.5px;font-weight:600;margin-bottom:4px">${a.name}</div><div style="display:flex;gap:8px;align-items:center;font-size:11.5px;flex-wrap:wrap"><span class="text-xs text-3">QUANDO</span><span class="badge b-default">${a.trig}</span><span class="text-xs text-3">→</span><span class="text-xs text-3">ENTÃO</span><span class="badge b-default">${a.act}</span></div><div class="text-xs text-3" style="margin-top:5px">${a.desc}</div></div><div class="toggle ${a.on?'on':''}" onclick="this.classList.toggle('on');const _on=this.classList.contains('on');toast(_on?'Ativada':'Desativada');saveAutomationToggle(${autos.indexOf(a)}, _on)"></div></div>`).join('')}
  </div>`;
}

// ============ RELATÓRIOS ============
function renderRelatorios(c){
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Relatórios</div><div class="page-subtitle">Performance consolidada · maio/2026</div></div><div class="page-actions">${searchBar('Buscar...','.grid-3, .grid-2')}${searchBar('Buscar colaborador...','.card')}<button class="btn" onclick="toast('Exportando PDF…','info')">📤 PDF</button><button class="btn" onclick="toast('Exportando Excel…','info')">📊 Excel</button><button class="btn btn-primary">+ Novo</button></div></div>
  <div class="filter-bar"><span class="filter-chip active">Todos clientes</span><span class="filter-chip">7 dias</span><span class="filter-chip active">30 dias</span><span class="filter-chip">YTD</span><span style="margin-left:auto" class="text-xs text-3">🤖 Gerado automaticamente</span></div>
  <div class="stat-grid">${statCard('Alcance','1.24M','+38%','M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Engajamento','89.2k','+24%','M22 11.08V12a10 10 0 1 1-5.93-9.14')}${statCard('Leads','428','+52%','M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2')}${statCard('Conversões','94','+31%','M9 11l3 3L22 4')}${statCard('ROI','3.8x','+0.4','M3 3v18h18')}${statCard('Seguidores','+8.4k','+18%','M16 21v-2')}</div>
  <div class="grid-2"><div class="card"><div class="card-header"><div class="card-title">Crescimento de seguidores</div></div><div class="chart-box"><canvas id="growChart"></canvas></div></div><div class="card"><div class="card-header"><div class="card-title">Performance por plataforma</div></div><div class="chart-box"><canvas id="platChart"></canvas></div></div></div>
  <div class="grid-3"><div class="card"><div class="card-header"><div class="card-title">🏆 Top conteúdos</div></div>${[['Reels Marmitina','Marmitina','48.2k'],['Carrossel Ergonomia','Steel Desk','32.1k'],['Post Top Sports','Top Sports','28.7k'],['Reels Aquassafe','Aquassafe','24.4k']].map(t=>`<div class="list-item"><div class="list-icon">📊</div><div class="list-content"><div class="list-title">${t[0]}</div><div class="list-meta">${t[1]}</div></div><div class="list-right"><strong>${t[2]}</strong></div></div>`).join('')}</div>
  <div class="card"><div class="card-header"><div class="card-title">💰 ROI por cliente</div></div>${[['Aquassafe','4.8x','b-success'],['Marmitina','4.2x','b-success'],['Top Sports','3.9x','b-success'],['Steel Desk','3.4x','b-warning'],['Franci','1.8x','b-danger']].map(r=>`<div class="list-item"><div class="list-icon">💰</div><div class="list-content"><div class="list-title">${r[0]}</div></div><div class="list-right"><span class="badge ${r[2]}">${r[1]}</span></div></div>`).join('')}</div>
  <div class="card"><div class="card-header"><div class="card-title">📑 Prontos</div></div>${[['Mensal abril','PDF','3.2 MB'],['Q1 2026','PDF','5.8 MB'],['Concorrência','PDF','2.1 MB'],['Tráfego','Excel','1.4 MB']].map(r=>`<div class="list-item"><div class="list-icon">📄</div><div class="list-content"><div class="list-title">${r[0]}</div><div class="list-meta">${r[1]} · ${r[2]}</div></div><div class="list-right"><button class="btn btn-sm" onclick="toast('Baixando…','info')">Baixar</button></div></div>`).join('')}</div></div>
  </div>`;
  drawGrowChart();drawPlatChart();
}
function drawGrowChart(){const ctx=document.getElementById('growChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';new Chart(ctx,{type:'line',data:{labels:['S1','S2','S3','S4','S5','S6','S7','S8','S9','S10','S11','S12'],datasets:[{label:'Instagram',data:[2100,2400,2900,3200,3800,4100,4600,5200,5800,6400,7100,8400],borderColor:isDark?'#f5f5f7':'#1d1d1f',backgroundColor:isDark?'rgba(245,245,247,.1)':'rgba(29,29,31,.06)',fill:true,tension:.4,borderWidth:2,pointRadius:0},{label:'TikTok',data:[800,1100,1500,2000,2400,2900,3200,3600,4000,4500,4900,5400],borderColor:'#7c3aed',tension:.4,borderWidth:2,pointRadius:0,borderDash:[4,4]},{label:'LinkedIn',data:[300,400,450,520,580,640,710,780,840,920,1010,1100],borderColor:'#0ea5e9',tension:.4,borderWidth:2,pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:8}}},scales:{x:{grid:{display:false},ticks:{color:txtCol}},y:{grid:{color:gridCol},ticks:{color:txtCol}}}}});}
function drawPlatChart(){const ctx=document.getElementById('platChart');if(!ctx)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';new Chart(ctx,{type:'bar',data:{labels:['Instagram','Reels','Stories','TikTok','LinkedIn','YouTube'],datasets:[{data:[420,380,180,220,40,80],backgroundColor:isDark?'#f5f5f7':'#1d1d1f',borderRadius:5}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:gridCol},ticks:{color:txtCol}},y:{grid:{display:false},ticks:{color:txtCol}}}}});}

// ============ ARQUIVOS ============
function renderArquivos(c){
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Arquivos</div><div class="page-subtitle">Central integrada · Drive + Dropbox + OneDrive</div></div><div class="page-actions">${searchBar('Buscar arquivo, cliente...','.file-grid, .card table tbody')}<button class="btn" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')">🔗 Abrir Drive</button><button class="btn btn-primary">⬆ Upload</button></div></div>
  <div class="filter-bar"><span class="filter-chip active">Todos</span><span class="filter-chip">Recentes</span><span class="filter-chip">Imagens</span><span class="filter-chip">Vídeos</span><span class="filter-chip">Documentos</span></div>
  <div class="section-title" style="margin-top:0">Pastas por cliente</div>
  <div class="file-grid mb-4">${clients.slice(0,12).map(cli=>`<div class="file" onclick="openClient(${cli.id})"><div class="file-icon" style="background:${cli.color}1a;color:${cli.color};font-size:22px">📁</div><div class="file-name">${cli.name}</div><div class="file-meta">${Math.floor(Math.random()*80+20)} arquivos</div></div>`).join('')}</div>
  <div class="section-title">Arquivos recentes</div>
  <div class="card"><table class="table"><thead><tr><th>Nome</th><th>Cliente</th><th>Tipo</th><th>Tamanho</th><th>Modificado</th></tr></thead><tbody>${[['🎬','Reels Aquassafe.mp4','Aquassafe','Vídeo','42 MB','há 12min'],['🖼','Carrossel Marmitina.psd','Marmitina','Design','18 MB','há 28min'],['📄','Briefing Concept.pdf','Concept','PDF','2.3 MB','há 1h'],['📊','Relatório Steel Desk.pdf','Steel Desk','Relatório','3.4 MB','há 3h'],['🖼','Identidade Banca v3.zip','Banca de Síndicos','Branding','86 MB','há 4h'],['🎬','Vídeo institucional Dener.mp4','Dener','Vídeo','124 MB','ontem']].map(f=>`<tr style="cursor:pointer" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')"><td><span style="font-size:16px;margin-right:8px">${f[0]}</span><strong>${f[1]}</strong></td><td class="text-mu">${f[2]}</td><td>${f[3]}</td><td class="text-mu">${f[4]}</td><td class="text-mu">${f[5]}</td></tr>`).join('')}</tbody></table></div>
  </div>`;
}

// ============ CONFIG ============
function renderConfig(c){
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Configurações</div><div class="page-subtitle">Personalize o sistema</div></div></div>
  <div class="grid-2e">
    <div>
      <div class="card mb-3"><div class="card-header"><div class="card-title">🏢 Empresa</div></div><div class="info-grid"><div class="info-item"><div class="info-label">Agência</div><div class="info-value">Impulse One</div></div><div class="info-item"><div class="info-label">CNPJ</div><div class="info-value">12.345.678/0001-90</div></div><div class="info-item"><div class="info-label">Plano</div><div class="info-value">Agência Pro · R$ 297/mês</div></div><div class="info-item"><div class="info-label">Próx. cobrança</div><div class="info-value">22 mai 2026</div></div></div></div>
      <div class="card mb-3"><div class="card-header"><div class="card-title">🎨 Identidade visual</div></div><div class="info-grid"><div class="info-item"><div class="info-label">Logo</div><div class="info-value">impulse-one.svg</div></div><div class="info-item"><div class="info-label">Cor primária</div><div class="info-value">Preto · #1d1d1f</div></div><div class="info-item"><div class="info-label">Domínio</div><div class="info-value">app.impulseone.com.br</div></div><div class="info-item"><div class="info-label">E-mail</div><div class="info-value">contato@impulseone.com.br</div></div></div></div>
      <div class="card"><div class="card-header"><div class="card-title">🔔 Notificações</div></div>${['Pagamentos atrasados','Aprovações pendentes','Tarefas atrasadas','Reuniões em 30min','Aniversários','Captação 2 dias antes','Captação no dia','Sugestões de upsell'].map((n,i)=>`<div style="display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--border)"><span class="text-sm">${n}</span><div class="toggle on" onclick="this.classList.toggle('on')"></div></div>`).join('')}</div>
    </div>
    <div>
      <div class="card mb-3"><div class="card-header"><div class="card-title">🛡 Segurança</div></div>${[['Autenticação 2 fatores','Via app autenticador',true],['SSO Google','Login com Google',true],['Logs de atividade','Registrar todas as ações',true],['Backup automático','Diário às 3h',true]].map(s=>`<div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)"><div><div class="text-sm font-semi">${s[0]}</div><div class="text-xs text-3">${s[1]}</div></div><div class="toggle ${s[2]?'on':''}" onclick="this.classList.toggle('on')"></div></div>`).join('')}</div>
      <div class="card mb-3"><div class="card-header"><div class="card-title">💳 Gateways</div></div>${[['Stripe',true],['Asaas',true],['Mercado Pago',false],['PIX direto',true],['Boleto',true]].map(p=>`<div style="display:flex;align-items:center;gap:11px;padding:10px 0;border-bottom:1px solid var(--border)"><span class="text-sm font-semi" style="flex:1">${p[0]}</span><div class="toggle ${p[1]?'on':''}" onclick="this.classList.toggle('on')"></div></div>`).join('')}</div>
      <div class="card"><div class="card-header"><div class="card-title">⚡ Atalhos</div></div>${[['⌘K','Pesquisa global'],['⌘N','Novo cliente'],['⌘T','Nova tarefa'],['⌘M','Nova mensagem'],['⌘/','Ajuda'],['⌘D','Dashboard']].map(s=>`<div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--border);font-size:12.5px"><span>${s[1]}</span><kbd style="background:var(--surface-2);border:1px solid var(--border);padding:1px 7px;border-radius:4px;font-size:10.5px;color:var(--text-2);font-family:inherit">${s[0]}</kbd></div>`).join('')}</div>
    </div>
  </div></div>`;
}

// ============ CAPTAÇÃO (calendário grande + ícones clicáveis) ============
let capFilter = 'all';
let capQuery = '';
let capOpenGroups = {};

function renderCaptacao(c){
  const monthStart = 5; // 1/mai/2026 = sex (idx 5)
  const daysInMonth = 31;
  const dayMap = {};
  captacoes.forEach(cap=>{
    const day = parseInt(cap.date.split('-')[2]);
    if(!dayMap[day]) dayMap[day]=[];
    dayMap[day].push(cap);
  });

  const filt = captacoes.filter(cap=>{
    if(capFilter!=='all' && cap.status!==capFilter) return false;
    if(capQuery){
      const q = capQuery.toLowerCase();
      const hay = (cap.client+' '+cap.type+' '+cap.resp+' '+cap.addr+' '+cap.status).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });

  const byClient = {};
  filt.forEach(cap=>{
    if(!byClient[cap.client]) byClient[cap.client] = {color:cap.color,init:cap.init,items:[]};
    byClient[cap.client].items.push(cap);
  });
  const clientNamesSorted = Object.keys(byClient).sort((a,b)=>a.localeCompare(b,'pt-BR'));

  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div><div class="page-title">Captação</div><div class="page-subtitle">${captacoes.length} captações · ${clientNamesSorted.length} cliente(s) com produções</div></div>
        <div class="page-actions">
          <div class="page-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder="Buscar cliente, tipo, responsável..." oninput="capQuery=this.value;renderCaptacao(document.getElementById('content'))" value="${capQuery}"/></div>
          <button class="btn" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')">📁 Drive</button>
          <button class="btn btn-primary" onclick="openNovaCaptacaoModal()">+ Nova captação</button>
        </div>
      </div>

      <div class="stat-grid">
        ${statCard('Agendadas',captacoes.filter(x=>x.status==='agendada').length,'aguardando confirmação','M3 12h18')}
        ${statCard('Confirmadas',captacoes.filter(x=>x.status==='confirmada').length,'prontas para captar','M9 11l3 3L22 4')}
        ${statCard('Em andamento',captacoes.filter(x=>x.status==='em andamento').length,'acontecendo agora','M3 3v18h18',null,'warning')}
        ${statCard('Finalizadas',captacoes.filter(x=>x.status==='finalizada').length,'no mês','M9 12l2 2 4-4')}
      </div>

      <div class="section-title" style="margin-top:0;display:flex;align-items:center;justify-content:space-between">
        <span>📅 Maio 2026 — Captações em destaque</span>
        <span class="text-xs text-3" style="text-transform:none;letter-spacing:0;font-weight:500">Clique no ícone do cliente em qualquer dia para abrir os detalhes</span>
      </div>

      <div class="cap-cal">
        ${['DOM','SEG','TER','QUA','QUI','SEX','SÁB'].map(d=>`<div class="cc-head">${d}</div>`).join('')}
        ${(()=>{
          let h='';
          for(let i=0;i<42;i++){
            const dn = i - monthStart + 1;
            const isC = dn>=1 && dn<=daysInMonth;
            const isT = dn===18;
            const list = dayMap[dn]||[];
            const cls = `cc-day ${isC?'':'other'} ${isT?'today':''} ${list.length?'has':''}`;
            const disp = isC?dn:(dn<1?30+dn:dn-daysInMonth);
            h += `<div class="${cls}">
              <div class="cc-num">${disp}</div>
              ${list.length?`<div class="cc-items">${list.map(cap=>`<div class="cc-item" style="background:${cap.color}" title="${cap.client} — ${cap.type} · ${cap.time}" onclick="event.stopPropagation();openCaptacaoDetail(${cap.id})">${cap.init}</div>`).join('')}</div>`:''}
            </div>`;
          }
          return h;
        })()}
      </div>

      <div class="cap-legend">
        <div class="cap-legend-item"><span class="cap-legend-dot" style="background:var(--accent-soft);border:1.5px solid var(--accent)"></span>Dia com captação</div>
        <div class="cap-legend-item"><span class="cap-legend-dot" style="background:var(--accent)"></span>Hoje</div>
        <div class="cap-legend-item">🎬 Passe o mouse no ícone para ver detalhes · clique para abrir</div>
      </div>

      <div class="grid-2e mt-4">
        <div>
          <div class="section-title" style="margin-top:0">Filtros rápidos</div>
          <div class="filter-bar">
            <span class="filter-chip ${capFilter==='all'?'active':''}" onclick="capFilter='all';renderCaptacao(document.getElementById('content'))">Todas</span>
            <span class="filter-chip ${capFilter==='agendada'?'active':''}" onclick="capFilter='agendada';renderCaptacao(document.getElementById('content'))">Agendadas</span>
            <span class="filter-chip ${capFilter==='confirmada'?'active':''}" onclick="capFilter='confirmada';renderCaptacao(document.getElementById('content'))">Confirmadas</span>
            <span class="filter-chip ${capFilter==='em andamento'?'active':''}" onclick="capFilter='em andamento';renderCaptacao(document.getElementById('content'))">Em andamento</span>
            <span class="filter-chip ${capFilter==='finalizada'?'active':''}" onclick="capFilter='finalizada';renderCaptacao(document.getElementById('content'))">Finalizadas</span>
          </div>

          <div class="card mt-4" style="border-left:3px solid var(--info)">
            <div class="card-header"><div class="card-title">🤖 Automações ativas</div></div>
            <div class="text-xs text-mu" style="line-height:1.6">
              <strong>2 dias antes:</strong> notifica equipe + destaque no dashboard + botão WhatsApp em evidência<br/>
              <strong>No dia:</strong> alerta urgente + confirmação da equipe<br/>
              <strong>Confirmar Captação:</strong> WhatsApp com mensagem pronta preenchida automaticamente
            </div>
          </div>

          <div class="card mt-4">
            <div class="card-header"><div class="card-title">📊 Captações por status</div></div>
            ${['agendada','confirmada','em andamento','finalizada','cancelada'].map(st=>{
              const cnt = captacoes.filter(x=>x.status===st).length;
              const map = {agendada:['b-default','#9595a0'],confirmada:['b-info','#0ea5e9'],'em andamento':['b-warning','#f59e0b'],finalizada:['b-success','#28a745'],cancelada:['b-danger','#ef4444']};
              return `<div style="display:flex;align-items:center;gap:10px;padding:6px 0"><span class="cap-legend-dot" style="background:${map[st][1]}"></span><span class="text-sm" style="flex:1;text-transform:capitalize">${st}</span><strong>${cnt}</strong></div>`;
            }).join('')}
          </div>
        </div>

        <div>
          <div class="section-title" style="margin-top:0">Captações por cliente</div>
          ${clientNamesSorted.length===0?'<div class="empty-state"><div class="ico">🎬</div><div class="ttl">Nenhuma captação</div><div class="desc">Ajuste os filtros ou crie uma nova.</div></div>':clientNamesSorted.map(name=>{
            const g = byClient[name];
            const isOpen = capOpenGroups[name]!==false;
            const safeName = name.replace(/'/g,"\\'");
            return `
              <div class="cap-group ${isOpen?'open':''}" data-client="${name}">
                <div class="cap-group-head" onclick="toggleCapGroup('${safeName}')">
                  <div class="clist-logo" style="background:${g.color};width:32px;height:32px;font-size:11px">${g.init}</div>
                  <div class="cap-group-name">${name}</div>
                  <span class="cap-group-count">${g.items.length}</span>
                  <span class="cap-group-chev">›</span>
                </div>
                <div class="cap-group-body">
                  ${g.items.map(cap=>{
                    const dateObj=new Date(cap.date+'T'+cap.time);
                    const day=dateObj.getDate();
                    const month=dateObj.toLocaleDateString('pt-BR',{month:'short'}).replace('.','');
                    const daysUntil=Math.ceil((dateObj-Date.now())/86400000);
                    const statusColor={agendada:'b-default',confirmada:'b-info','em andamento':'b-warning',finalizada:'b-success',cancelada:'b-danger'}[cap.status];
                    return `
                      <div class="cap-row" onclick="openCaptacaoDetail(${cap.id})">
                        <div class="cap-row-date"><div class="cap-row-day">${day}</div><div class="cap-row-month">${month}</div></div>
                        <div class="cap-row-info">
                          <div class="cap-row-title">${cap.type}</div>
                          <div class="cap-row-meta"><span>🕒 ${cap.time}</span><span>👤 ${cap.resp}</span><span>📍 ${cap.addr.split('—')[0].trim()}</span></div>
                        </div>
                        <span class="badge ${statusColor}"><span class="dot"></span>${cap.status}</span>
                        ${prioBadge(cap.priority)}
                        ${daysUntil>=0&&daysUntil<=2&&['agendada','confirmada'].includes(cap.status)?`<span class="badge b-warning">⚠ ${daysUntil===0?'HOJE':daysUntil===1?'amanhã':daysUntil+'d'}</span>`:''}
                      </div>
                    `;
                  }).join('')}
                </div>
              </div>
            `;
          }).join('')}
        </div>
      </div>
    </div>
  `;
}

function toggleCapGroup(name){
  capOpenGroups[name] = capOpenGroups[name]===false;
  document.querySelectorAll(`.cap-group[data-client="${name}"]`).forEach(el=>el.classList.toggle('open'));
}

function openCaptacaoDetail(id){
  const cap = captacoes.find(x=>x.id===id); if(!cap) return;
  const dateObj=new Date(cap.date+'T'+cap.time);
  const dateStr=dateObj.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'});
  const daysUntil=Math.ceil((dateObj-Date.now())/86400000);
  const statusColor={agendada:'b-default',confirmada:'b-info','em andamento':'b-warning',finalizada:'b-success',cancelada:'b-danger'}[cap.status];

  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div class="client-logo" style="background:${cap.color};width:48px;height:48px;font-size:16px">${cap.init}</div>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;letter-spacing:-.02em">🎬 ${cap.type}</div>
        <div class="text-xs text-3" style="margin-top:3px">${cap.client} · ${dateStr} · ${cap.time}</div>
      </div>
      <span class="badge ${statusColor}"><span class="dot"></span>${cap.status}</span>
      ${prioBadge(cap.priority)}
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      ${daysUntil>=0&&daysUntil<=2&&['agendada','confirmada'].includes(cap.status)?`<div class="card mb-4" style="background:var(--warning-soft);border:1px solid var(--warning);color:var(--warning-text)"><strong>⚠ Captação em ${daysUntil===0?'HOJE':daysUntil===1?'1 dia':daysUntil+' dias'}</strong> — confirme com a equipe e o cliente.</div>`:''}

      <div class="info-grid mb-4">
        <div class="info-item"><div class="info-label">Cliente</div><div class="info-value">${cap.client}</div></div>
        <div class="info-item"><div class="info-label">Responsável</div><div class="info-value">${cap.resp}</div></div>
        <div class="info-item"><div class="info-label">Data</div><div class="info-value">${dateStr}</div></div>
        <div class="info-item"><div class="info-label">Horário</div><div class="info-value">${cap.time}</div></div>
        <div class="info-item" style="grid-column:span 2"><div class="info-label">Endereço</div><div class="info-value">${cap.addr}</div></div>
      </div>

      <div class="qa-grid mb-4">
        <button class="qa" onclick="confirmarCaptacao(${cap.id})"><span class="qa-icon">💬</span><span><div style="font-weight:600">Confirmar Captação</div><div class="text-xs text-3">WhatsApp pronto</div></span></button>
        <button class="qa" onclick="whatsApp('${cap.phone}','${cap.client}')"><span class="qa-icon">📱</span><span><div style="font-weight:600">WhatsApp livre</div><div class="text-xs text-3">Abrir conversa</div></span></button>
        <button class="qa" onclick="openLinksManager('captacao-'+${cap.id}+'-drive', '📁 Pasta da Captação - ${cap.client}', '${cap.drive}')"><span class="qa-icon">📁</span><span><div style="font-weight:600">Pasta no Drive</div><div class="text-xs text-3">Materiais</div></span></button>
        <button class="qa" onclick="openLinksManager('captacao-'+${cap.id}+'-maps', '📍 Localização - ${cap.client}', 'https://maps.google.com/?q=${encodeURIComponent(cap.addr)}')"><span class="qa-icon">📍</span><span><div style="font-weight:600">Ver no Maps</div><div class="text-xs text-3">Rota</div></span></button>
        <button class="qa" onclick="toast('Roteiro PDF aberto','info')"><span class="qa-icon">📄</span><span><div style="font-weight:600">Roteiro PDF</div><div class="text-xs text-3">Briefing</div></span></button>
        <button class="qa" onclick="toast('Referências abertas','info')"><span class="qa-icon">🎨</span><span><div style="font-weight:600">Referências</div><div class="text-xs text-3">Moodboard</div></span></button>
      </div>

      <div class="section-title">Briefing rápido</div>
      <div class="text-sm text-mu" style="line-height:1.6;padding:13px;background:var(--surface-2);border-radius:9px;border:1px solid var(--border)">${cap.brief}</div>

      <div class="section-title">Materiais necessários</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
        ${cap.materials.map(m=>`<span class="badge b-default" style="padding:5px 10px">📦 ${m}</span>`).join('')}
      </div>

      <div class="section-title">Checklist da equipe</div>
      <div style="display:flex;flex-direction:column;gap:5px">
        ${['Equipe confirmada','Equipamentos separados','Roteiro impresso','Endereço confirmado','Cliente avisado','Backup de bateria','Cartões SD vazios'].map((t,i)=>`<label style="display:flex;gap:10px;align-items:center;padding:8px 11px;background:var(--surface-2);border-radius:8px;font-size:12.5px;cursor:pointer"><div class="check-box ${i<2?'checked':''}" onclick="this.classList.toggle('checked')"></div><span style="${i<2?'text-decoration:line-through;color:var(--text-3)':''}">${t}</span></label>`).join('')}
      </div>

      <div class="section-title">Atualizar status</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        ${['agendada','confirmada','em andamento','finalizada','cancelada'].map(s=>`<span class="filter-chip ${cap.status===s?'active':''}" onclick="updateCapStatus(${cap.id},'${s}');setTimeout(()=>openCaptacaoDetail(${cap.id}),200)">${s}</span>`).join('')}
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

function confirmarCaptacao(id){
  const cap=captacoes.find(c=>c.id===id);if(!cap)return;
  const dateObj=new Date(cap.date+'T'+cap.time);
  const dateStr=dateObj.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'});
  const msg=`Olá! Passando para confirmar nossa captação agendada.\n\nCliente: ${cap.client}\nData: ${dateStr}\nHorário: ${cap.time}\nEndereço: ${cap.addr}\n\nQualquer ajuste nos avise 😊`;
  window.open(`https://wa.me/${cap.phone.replace(/\D/g,'')}?text=${encodeURIComponent(msg)}`,'_blank');
  toast('WhatsApp aberto com mensagem de confirmação','success');
}
async function updateCapStatus(id,status){
  const cap=captacoes.find(c=>c.id===id);
  if(cap){
    cap.status=status;
    await saveCaptacaoStatus(id, status);  // persiste
    toast(`Status: ${status}`);
    renderCaptacao(document.getElementById('content'));
  }
}

// ============ COMERCIAL ============
let comTab = 'pipeline';
let orcamento = {
  id: null,
  numero: 'ORC-' + String(Date.now()).slice(-6),
  data: new Date().toISOString().split('T')[0],
  validade: new Date(Date.now() + 30*86400000).toISOString().split('T')[0],
  cliente: {nome:'', cnpj:'', endereco:'', email:'', telefone:'', logo:''},
  itens: [],
  desconto: 0,
  descontoTipo: 'valor',
  formaPagamento: 'PIX à vista ou 2x no cartão sem juros',
  prazoEntrega: '30 dias após aprovação',
  observacoes: 'Orçamento válido por 30 dias.',
  termos: ''
};
let orcamentosSalvos = [];

function renderComercial(c){
  c.innerHTML=`<div class="page active"><div class="page-header"><div><div class="page-title">Comercial</div><div class="page-subtitle">Funil, pipeline e oportunidades de upsell</div></div><div class=\"page-actions\">${searchBar('Buscar lead, cliente...','#content .kanban, #content .grid-2e')}<button class=\"btn\" onclick=\"comTab='orcamento';renderComercial(document.getElementById('content'))">📄 Orçamento</button><button class="btn btn-primary" onclick="openNovoLeadModal()">+ Novo lead</button></div></div>
  <div class="filter-bar">
    <span class="filter-chip ${comTab==='pipeline'?'active':''}" onclick="comTab='pipeline';renderComercial(document.getElementById('content'))">Pipeline</span>
    <span class="filter-chip ${comTab==='upsell'?'active':''}" onclick="comTab='upsell';renderComercial(document.getElementById('content'))">Upsell & Projeções</span>
    <span class="filter-chip ${comTab==='orcamento'?'active':''}" onclick="comTab='orcamento';renderComercial(document.getElementById('content'))">Orçamento</span>
    <span class="filter-chip ${comTab==='historico'?'active':''}" onclick="comTab='historico';renderComercial(document.getElementById('content'))">📊 Histórico</span>
  </div>
  ${comTab==='pipeline'?renderPipelineCom():comTab==='upsell'?renderUpsellCom():comTab==='historico'?renderHistoricoOrcamentos():renderOrcamentoCom()}
  </div>`;
}

async function renderPipelineCom(){
  const { data } = _supa ? await _supa.from('leads').select('*').order('created_at',{ascending:false}) : {data:null};
  const leads = data ? data.map(l=>({n:l.name,v:parseFloat(l.value)||0,stage:l.stage==='lead'?'Lead':l.stage==='contato'?'Contato inicial':l.stage==='diagnostico'?'Diagnóstico':l.stage==='proposta'?'Proposta enviada':l.stage==='fechamento'?'Fechamento':l.stage,resp:'Equipe',p:l.priority||'med'})) : [{n:'Construtora Aurora',v:8900,stage:'Lead',resp:'Éllen',p:'med'},{n:'Clínica Inovar',v:5200,stage:'Contato inicial',resp:'Éllen',p:'high'},{n:'Tech Solutions',v:6700,stage:'Diagnóstico',resp:'Gabi',p:'high'},{n:'Restaurante Sole',v:3800,stage:'Proposta enviada',resp:'Gabi',p:'urgent'},{n:'Estúdio Forma',v:4200,stage:'Fechamento',resp:'Éllen',p:'urgent'}];
  const stages=['Lead','Contato inicial','Diagnóstico','Proposta enviada','Fechamento','Fechado'];
  return `<div class="stat-grid">${statCard('Leads ativos','5','no funil','M16 21v-2')}${statCard('Propostas','2','enviadas','M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Em fechamento','1','quente','M3 3v18h18',null,'warning')}${statCard('Projeção mês','R$ 28.800','5 contratos','M12 1v22')}</div>
  <div class="kanban">${stages.map(s=>{const list=leads.filter(l=>l.stage===s);return `<div class="kanban-col"><div class="kanban-head"><div class="kanban-title">${s} <span class="kanban-count">${list.length}</span></div></div><div class="kanban-cards">${list.map(l=>`<div class="kanban-card">${prioBadge(l.p)}<div class="kanban-card-title" style="margin-top:6px">${l.n}</div><div class="text-xs text-3" style="margin-bottom:7px">R$ ${l.v.toLocaleString('pt-BR')}/mês</div><div class="kanban-card-foot"><span>👤 ${l.resp}</span><div class="avatar" style="background:${team.find(t=>t.name.startsWith(l.resp))?.color||'#999'}">${l.resp[0]}</div></div></div>`).join('')}<div class="kanban-add">+ Adicionar lead</div></div></div>`}).join('')}</div>`;
}

function renderUpsellCom(){
  const opps=clients.slice(0,8).map((c,i)=>{
    const plan=planoCliente(c.id);
    const planNames=['Essencial','Crescimento','Premium','Enterprise'];
    const planVals=[1800,3200,5500,8900];
    const nextIdx=Math.min(planNames.indexOf(plan.name)+1,3);
    return {cli:c,plan,suggestedPlan:planNames[nextIdx],suggestedVal:planVals[nextIdx],months:6+i*2,growth:[40,65,80,95,55,30,72,88][i],reason:['Crescimento +40% em 3 meses','Cliente expandindo equipe','Aumento da demanda','Solicitou novos serviços','Renovação próxima','Performance positiva','Resultados acima da meta','Solicitou estratégia anual'][i]};
  });
  return `<div class="stat-grid">${statCard('Oportunidades','8','sugeridas pela IA','M22 12h-4l-3 9L9 3l-3 9H2')}${statCard('Potencial mensal','+R$ 14.800','aumento','M12 1v22')}${statCard('Renovações','5','próx. 30 dias','M3 12h18',null,'warning')}${statCard('Mudança plano','3','sugeridas','M9 11l3 3L22 4')}</div>
  <div class="card mt-4" style="border-left:3px solid var(--purple)"><div class="card-header"><div class="card-title">🤖 Sugestões automáticas — atualizadas a cada 3 meses</div><span class="badge b-purple">IA</span></div><div class="text-sm text-mu">A IA analisa <strong>tempo de contrato</strong>, <strong>crescimento</strong> e <strong>serviços atuais</strong> para sugerir upgrades e novos pacotes (tráfego, branding, produção, campanhas).</div></div>
  <div class="section-title">Clientes com oportunidade de upsell</div>
  ${opps.map(o=>`<div class="card mb-3" style="display:flex;gap:14px;align-items:center;padding:16px"><div class="client-logo" style="background:${o.cli.color}">${o.cli.init}</div><div style="flex:1"><div style="display:flex;align-items:center;gap:8px;margin-bottom:3px"><strong>${o.cli.name}</strong><span class="badge b-default">${o.months} meses</span><span class="badge b-success">+${o.growth}% crescimento</span></div><div class="text-xs text-3" style="margin-bottom:8px">Atual: <strong style="color:var(--text)">${o.plan.name} · R$ ${o.plan.value.toLocaleString('pt-BR')}/mês</strong> · ${o.reason}</div><div style="display:flex;gap:10px;align-items:center"><span class="badge b-purple">↑ Sugerir: ${o.suggestedPlan}</span><span class="text-xs text-mu">R$ ${o.plan.value.toLocaleString('pt-BR')} → <strong style="color:var(--success-text)">R$ ${o.suggestedVal.toLocaleString('pt-BR')}</strong> (+R$ ${(o.suggestedVal-o.plan.value).toLocaleString('pt-BR')}/mês)</span></div></div><div style="display:flex;flex-direction:column;gap:5px"><button class="btn btn-sm btn-primary" onclick="openClient(${o.cli.id})">Ver cliente</button><button class="btn btn-sm" onclick="comTab='orcamento';renderComercial(document.getElementById('content'))">📄 Orçamento</button></div></div>`).join('')}
  <div class="card mt-4" style="border-left:3px solid var(--warning)"><div class="card-header"><div class="card-title">⏰ Mudança de plano — alertas (1 mês antes)</div></div>
  ${[{c:'Aquassafe',from:'Premium',to:'Enterprise',date:'15 jun',diff:3400},{c:'Marmitina',from:'Crescimento',to:'Premium',date:'22 jun',diff:2300},{c:'Steel Desk',from:'Premium',to:'Enterprise',date:'30 jun',diff:3400}].map(m=>`<div class="list-item"><div class="list-icon">📈</div><div class="list-content"><div class="list-title">${m.c} — ${m.from} → ${m.to}</div><div class="list-meta">Previsto ${m.date}</div></div><div class="list-right"><strong style="color:var(--success-text)">+R$ ${m.diff.toLocaleString('pt-BR')}</strong><div><button class="btn btn-sm">Comparar</button></div></div></div>`).join('')}
  </div>`;
}

function renderOrcamentoCom(){
  // Carrega tudo em background
  setTimeout(()=>{loadOrcamentosSalvos();loadBudgetServices();loadBudgetClients()}, 50);
  const serv = _budgetServices.length ? _budgetServices : [
    {id:'m1',name:'Gestão de rede social',value:1800},{id:'m2',name:'Design fixo',value:1200},
    {id:'m3',name:'Tráfego pago',value:2200},{id:'m4',name:'Vídeos',value:1800},
    {id:'m5',name:'Captação',value:2500},{id:'m6',name:'Branding',value:4500},
    {id:'m7',name:'Campanhas',value:3200},{id:'m8',name:'Consultoria',value:1500}
  ];
  const subtotal = orcamento.itens.reduce((s,x)=>s+(x.qtd||1)*x.valor,0);
  const descontoVal = orcamento.descontoTipo==='percentual' ? subtotal*(orcamento.desconto/100) : orcamento.desconto;
  const total = Math.max(0, subtotal - descontoVal);
  const cliNome = orcamento.cliente?.nome || '';

  return `<div class="grid-2">
    <div>
      <div class="card mb-3">
        <div class="card-header"><div class="card-title">📄 ${orcamento.id?'Editando orçamento':'Novo orçamento'}</div><div style="display:flex;gap:6px"><button class="btn btn-sm btn-primary" onclick="limparOrcamento()">+ Novo orçamento</button><button class="btn btn-sm" onclick="abrirGerenciarClientes()">👤 Clientes</button></div></div>
        <div class="info-label">CLIENTE</div>
        <div style="display:flex;gap:6px;margin-top:5px">
          <select id="orcCliSelect" onchange="selecionarClienteOrc(this.value)" style="flex:1;padding:9px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:12.5px;color:var(--text);font-family:inherit">
            <option value="">— Selecione um cliente —</option>
            <option value="__manual__">✏️ Inserir dados manualmente</option>
            <option value="__novo__">➕ Cadastrar novo cliente exclusivo</option>
            <optgroup label="━━━ Clientes do CRM ━━━">
              ${(clients||[]).map(c=>`<option value="crm:${c.id}" ${cliNome===c.name?'selected':''}>🏢 ${c.name}</option>`).join('')}
            </optgroup>
            ${(_budgetClients||[]).length?`<optgroup label="━━━ Clientes exclusivos ━━━">${_budgetClients.map(c=>`<option value="bg:${c.id}" ${cliNome===c.name?'selected':''}>💼 ${c.name}</option>`).join('')}</optgroup>`:''}
          </select>
          <button class="btn btn-sm" onclick="renderComercial(document.getElementById('content'))" title="Atualizar lista">🔄</button>
        </div>
        ${!clients||clients.length===0?'<div class="text-xs text-3 mt-3">⏳ Carregando lista de clientes... Aguarde alguns segundos e clique no botão 🔄</div>':`<div class="text-xs text-3 mt-3">${clients.length} clientes do CRM + ${(_budgetClients||[]).length} exclusivos disponíveis</div>`}
        ${orcamento.cliente?.nome ? `
        <div style="margin-top:10px;padding:10px;background:var(--surface-2);border-radius:8px">
          <input class="login-input" value="${orcamento.cliente.nome}" oninput="orcamento.cliente.nome=this.value" placeholder="Nome / Razão Social" style="background:var(--surface);margin-bottom:6px;font-weight:600" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px">
            <input class="login-input" value="${orcamento.cliente.cnpj||''}" oninput="orcamento.cliente.cnpj=this.value" placeholder="CNPJ/CPF" style="background:var(--surface)" />
            <input class="login-input" value="${orcamento.cliente.telefone||''}" oninput="orcamento.cliente.telefone=this.value" placeholder="Telefone" style="background:var(--surface)" />
          </div>
          <input class="login-input" value="${orcamento.cliente.email||''}" oninput="orcamento.cliente.email=this.value" placeholder="Email" style="background:var(--surface);margin-bottom:6px" />
          <input class="login-input" value="${orcamento.cliente.endereco||''}" oninput="orcamento.cliente.endereco=this.value" placeholder="Endereço" style="background:var(--surface)" />
        </div>` : ''}

        <div class="section-title" style="display:flex;justify-content:space-between;align-items:center">
          <span>SERVIÇOS PADRÃO</span>
          <button class="btn btn-sm" onclick="abrirGerenciarServicos()">⚙️ Editar valores / Adicionar</button>
        </div>
        ${serv.map((s,i)=>{
          const checked = orcamento.itens.some(x=>x.desc===s.name && !x.custom);
          return `<label style="display:flex;align-items:center;gap:10px;padding:9px;background:var(--surface-2);border-radius:8px;margin-bottom:5px;cursor:pointer">
            <div class="check-box ${checked?'checked':''}" onclick="toggleOrcServ('${s.id}')"></div>
            <span style="flex:1;font-size:12.5px">${s.name}</span>
            <strong style="font-size:12.5px">R$ ${parseFloat(s.value).toLocaleString('pt-BR',{minimumFractionDigits:2})}</strong>
          </label>`;
        }).join('')}

        <button class="btn btn-primary" style="width:100%;margin-top:6px" onclick="addServicoPersonalizado()">+ Adicionar serviço personalizado</button>

        ${orcamento.itens.length > 0 ? `
        <div class="section-title">ITENS DO ORÇAMENTO (editáveis)</div>
        <div style="display:flex;flex-direction:column;gap:6px">
          ${orcamento.itens.map((it,i)=>`
            <div style="display:grid;grid-template-columns:1fr 60px 110px auto;gap:6px;align-items:center;padding:8px;background:var(--surface-2);border-radius:7px">
              <input class="cron-obs-input" value="${(it.desc||'').replace(/"/g,'&quot;')}" oninput="orcamento.itens[${i}].desc=this.value" placeholder="Descrição" style="background:var(--surface);font-size:12px;padding:6px 8px" />
              <input class="cron-obs-input" type="number" min="1" value="${it.qtd||1}" oninput="orcamento.itens[${i}].qtd=parseFloat(this.value)||1;updateOrcTotals()" style="background:var(--surface);font-size:12px;padding:6px;text-align:center" />
              <input class="cron-obs-input" type="number" step="0.01" value="${it.valor}" oninput="orcamento.itens[${i}].valor=parseFloat(this.value)||0;updateOrcTotals()" style="background:var(--surface);font-size:12px;padding:6px 8px" />
              <button class="icon-btn" style="color:var(--danger);width:28px;height:28px" onclick="orcamento.itens.splice(${i},1);renderComercial(document.getElementById('content'))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>
            </div>
          `).join('')}
        </div>` : ''}

        <div class="section-title">💰 DESCONTO</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:end">
          <div><div class="info-label" style="margin-bottom:4px">Tipo</div><select class="login-input" onchange="orcamento.descontoTipo=this.value;updateOrcTotals()" style="background:var(--surface-2);font-size:12px"><option value="valor" ${orcamento.descontoTipo==='valor'?'selected':''}>Valor fixo (R$)</option><option value="percentual" ${orcamento.descontoTipo==='percentual'?'selected':''}>Percentual (%)</option></select></div>
          <div><div class="info-label" style="margin-bottom:4px">Valor</div><input class="login-input" type="number" step="0.01" value="${orcamento.desconto||0}" oninput="orcamento.desconto=parseFloat(this.value)||0;updateOrcTotals()" placeholder="0" style="background:var(--surface-2);font-size:12px" /></div>
        </div>

        <div class="section-title">PRAZO & CONDIÇÕES</div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Prazo</div><input class="login-input" value="${orcamento.prazoEntrega||'30 dias'}" oninput="orcamento.prazoEntrega=this.value" style="background:var(--surface);font-size:12px;padding:7px 9px;border:none" /></div>
          <div class="info-item"><div class="info-label">Condições</div><input class="login-input" value="${orcamento.formaPagamento||'PIX à vista ou 2x no cartão'}" oninput="orcamento.formaPagamento=this.value" style="background:var(--surface);font-size:12px;padding:7px 9px;border:none" /></div>
        </div>

        <div class="section-title">OBSERVAÇÕES</div>
        <textarea oninput="orcamento.observacoes=this.value" placeholder="Observações..." style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);font-size:12.5px;color:var(--text);font-family:inherit;min-height:70px;resize:vertical">${orcamento.observacoes||''}</textarea>
      </div>

      ${orcamentosSalvos.length>0?`
      <div class="card mb-3">
        <div class="card-header"><div class="card-title">📜 Histórico salvo</div><span class="badge b-default">${orcamentosSalvos.length}</span></div>
        ${orcamentosSalvos.slice(0,8).map(b=>`
          <div class="list-item">
            <div class="list-icon">📄</div>
            <div class="list-content"><div class="list-title">${b.numero||'ORC-'+b.id.slice(0,6)} · ${b.client_data?.nome||'Sem cliente'}</div><div class="list-meta">R$ ${parseFloat(b.total||0).toLocaleString('pt-BR',{minimumFractionDigits:2})} · ${new Date(b.created_at).toLocaleDateString('pt-BR')}</div></div>
            <div class="list-right"><button class="btn btn-sm" onclick="carregarOrcSalvo('${b.id}')">Carregar</button><button class="btn btn-sm" onclick="excluirOrcSalvo('${b.id}')" style="color:var(--danger)">🗑</button></div>
          </div>
        `).join('')}
      </div>`:''}
    </div>

    <div>
      <div class="card" style="position:sticky;top:0">
        <div class="card-header"><div class="card-title">Preview & Total</div><span class="badge b-default">PDF</span></div>
        <div style="background:var(--surface-2);padding:18px;border-radius:10px;border:1px solid var(--border)">
          <div style="display:flex;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--border)">
            <div class="brand-logo">i1</div>
            <div><div style="font-weight:700">IMPULSE ONE</div><div class="text-xs text-3">Orçamento — ${new Date(orcamento.data||Date.now()).toLocaleDateString('pt-BR')}</div></div>
          </div>
          <div style="margin:14px 0"><div class="info-label">Cliente</div><div style="font-size:14px;font-weight:600">${cliNome||'Selecione o cliente'}</div></div>
          <div class="info-label">Itens</div>
          ${orcamento.itens.length===0?'<div class="text-mu text-sm">Nenhum item adicionado</div>':orcamento.itens.map(s=>`<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:12.5px"><span>${(s.qtd||1)>1?(s.qtd+'x '):''}${s.desc}</span><strong>R$ ${((s.valor||0)*(s.qtd||1)).toLocaleString('pt-BR',{minimumFractionDigits:2})}</strong></div>`).join('')}
          <div id="orcTotalsBox">
            <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:13px"><span>Subtotal</span><span>R$ ${subtotal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
            ${descontoVal>0?`<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:13px;color:var(--danger-text)"><span>Desconto</span><span>− R$ ${descontoVal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>`:''}
            <div style="display:flex;justify-content:space-between;padding:10px 0 0;border-top:1px solid var(--border);margin-top:5px;font-size:16px;font-weight:700"><span>Total</span><span style="color:var(--success-text)">R$ ${total.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
          </div>
          <div class="text-xs text-3 mt-3">Prazo: ${orcamento.prazoEntrega||'30 dias'} · ${orcamento.formaPagamento||'PIX à vista'}</div>
          ${orcamento.observacoes?`<div class="text-xs text-mu mt-3" style="padding:10px;background:var(--surface);border-radius:6px"><strong>Obs:</strong> ${orcamento.observacoes}</div>`:''}
        </div>
        <div style="display:flex;gap:7px;margin-top:14px;flex-direction:column">
          <button class="btn btn-primary" onclick="gerarPDFOrcamento()">📄 Gerar PDF</button>
          <button class="btn" onclick="salvarOrcamento()">💾 Salvar</button>
          <button class="btn" onclick="enviarOrcWhats()">💬 Enviar no WhatsApp</button>
          <button class="btn" onclick="if(confirm('Limpar orçamento?')){limparOrcamento()}">🗑 Limpar</button>
        </div>
      </div>
    </div>
  </div>`;
}

function updateOrcTotals(){
  // Re-renderiza só o preview (mantém foco nos inputs)
  const subtotal = orcamento.itens.reduce((s,x)=>s+(x.qtd||1)*x.valor,0);
  const descontoVal = orcamento.descontoTipo==='percentual' ? subtotal*(orcamento.desconto/100) : orcamento.desconto;
  const total = Math.max(0, subtotal - descontoVal);
  const box = document.getElementById('orcTotalsBox');
  if(box){
    box.innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:13px"><span>Subtotal</span><span>R$ ${subtotal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
      ${descontoVal>0?`<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:13px;color:var(--danger-text)"><span>Desconto</span><span>− R$ ${descontoVal.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>`:''}
      <div style="display:flex;justify-content:space-between;padding:10px 0 0;border-top:1px solid var(--border);margin-top:5px;font-size:16px;font-weight:700"><span>Total</span><span style="color:var(--success-text)">R$ ${total.toLocaleString('pt-BR',{minimumFractionDigits:2})}</span></div>
    `;
  }
}

function addServicoPersonalizado(){
  orcamento.itens.push({desc:'Serviço personalizado', qtd:1, valor:0, custom:true});
  renderComercial(document.getElementById('content'));
}

function toggleOrcServ(id){
  const item = _budgetServices.find(s=>s.id===id);
  if(!item){
    // fallback mock
    const fallback = [{id:'m1',name:'Gestão de rede social',value:1800},{id:'m2',name:'Design fixo',value:1200},{id:'m3',name:'Tráfego pago',value:2200},{id:'m4',name:'Vídeos',value:1800},{id:'m5',name:'Captação',value:2500},{id:'m6',name:'Branding',value:4500},{id:'m7',name:'Campanhas',value:3200},{id:'m8',name:'Consultoria',value:1500}];
    const f = fallback.find(s=>s.id===id);
    if(!f) return;
    item = f;
  }
  const realItem = item;
  const idx = orcamento.itens.findIndex(x=>x.desc===realItem.name && !x.custom);
  if(idx>=0) orcamento.itens.splice(idx,1);
  else orcamento.itens.push({desc:realItem.name, qtd:1, valor:parseFloat(realItem.value)});
  renderComercial(document.getElementById('content'));
}

function selecionarClienteOrc(val){
  console.log('[ORC] cliente selecionado:', val);
  if(!val || val === ''){
    orcamento.cliente = {nome:'', cnpj:'', endereco:'', email:'', telefone:'', logo:''};
  } else if(val === '__manual__'){
    orcamento.cliente = {nome:'Novo cliente (editar)', cnpj:'', endereco:'', email:'', telefone:'', logo:''};
  } else if(val === '__novo__'){
    abrirGerenciarClientes();
    return;
  } else if(val.startsWith('crm:')){
    const id = parseInt(val.slice(4));
    const cli = (clients||[]).find(c=>c.id===id);
    if(cli){
      orcamento.cliente = {nome: cli.name, cnpj:'', endereco:'', email: cli.email||'', telefone: cli.phone||'', logo:''};
      console.log('[ORC] cliente CRM importado:', cli.name);
    } else {
      toast('Cliente nao encontrado','info');
    }
  } else if(val.startsWith('bg:')){
    const id = val.slice(3);
    const cli = (_budgetClients||[]).find(c=>c.id===id);
    if(cli) orcamento.cliente = {nome: cli.name, cnpj: cli.cnpj||'', endereco: cli.address||'', email: cli.email||'', telefone: cli.phone||'', logo:''};
  }
  renderComercial(document.getElementById('content'));
}

function abrirGerenciarServicos(){
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700">⚙️</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">Serviços padrão</div><div class="text-xs text-3" style="margin-top:3px">Edite valores, adicione novos serviços ou desative os antigos</div></div>
      <button class="modal-close" onclick="closeModal();renderComercial(document.getElementById('content'))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div id="servListMgr">
        ${_budgetServices.map(s=>`
          <div class="card mb-2" style="padding:11px;display:grid;grid-template-columns:2fr 1fr auto;gap:8px;align-items:center" id="servrow-${s.id}">
            <input class="cron-obs-input" value="${s.name}" onblur="updateBudgetServ('${s.id}','name',this.value)" placeholder="Nome do serviço" style="background:var(--surface-2);font-size:13px;padding:6px 8px" />
            <input class="cron-obs-input" type="number" step="0.01" value="${s.value}" onblur="updateBudgetServ('${s.id}','value',parseFloat(this.value)||0)" placeholder="Valor" style="background:var(--surface-2);font-size:13px;padding:6px 8px" />
            <button class="icon-btn" style="color:var(--danger);width:30px;height:30px" onclick="deleteBudgetServ('${s.id}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>
          </div>
        `).join('')}
      </div>
      <div class="card mt-3" style="background:var(--surface-2);padding:14px">
        <div class="card-title" style="margin-bottom:10px">+ Adicionar novo serviço</div>
        <div style="display:grid;grid-template-columns:2fr 1fr auto;gap:8px">
          <input id="newServName" class="login-input" placeholder="Nome (ex: Edição de vídeos)" style="background:var(--surface)" />
          <input id="newServValue" class="login-input" type="number" step="0.01" placeholder="Valor (R$)" style="background:var(--surface)" />
          <button class="btn btn-primary" onclick="addBudgetServ()">+ Adicionar</button>
        </div>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function updateBudgetServ(id, field, value){
  if(!_supa) return;
  await _supa.from('budget_services').update({[field]:value}).eq('id', id);
  const s = _budgetServices.find(x=>x.id===id);
  if(s) s[field] = value;
  toast('✓ Salvo','success');
}

async function deleteBudgetServ(id){
  if(!confirm('Excluir este serviço da lista padrão?')) return;
  if(_supa) await _supa.from('budget_services').delete().eq('id', id);
  _budgetServices = _budgetServices.filter(x=>x.id!==id);
  document.getElementById('servrow-'+id)?.remove();
  toast('Serviço excluído','success');
}

async function addBudgetServ(){
  const name = document.getElementById('newServName').value.trim();
  const value = parseFloat(document.getElementById('newServValue').value) || 0;
  if(!name){toast('Informe o nome','info');return}
  if(!_supa){toast('Banco necessário','info');return}
  const { data } = await _supa.from('budget_services').insert({name, value, position: _budgetServices.length+1}).select().single();
  if(data){
    _budgetServices.push(data);
    toast('✓ Serviço adicionado','success');
    abrirGerenciarServicos();
  }
}

function abrirGerenciarClientes(){
