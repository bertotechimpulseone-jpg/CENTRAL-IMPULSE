const allPages = [
  {id:'dashboard',label:'Dashboard'},
  {id:'clientes',label:'Clientes'},
  {id:'comercial',label:'Comercial'},
  {id:'captacao',label:'Captação'},
  {id:'cronograma',label:'Cronograma'},
  {id:'operacional',label:'Checklist'},
  {id:'calendario',label:'Calendário'},
  {id:'reunioes',label:'Reuniões'},
  {id:'conteudo',label:'Materiais'},
  {id:'automacao',label:'Automação'},
  {id:'relatorios',label:'Relatórios'},
  {id:'equipe',label:'Equipe'},
  {id:'feedback',label:'Feedback'},
  {id:'ponto',label:'Ponto'},
  {id:'financeiro',label:'Financeiro'},
  {id:'arquivos',label:'Arquivos'},
  {id:'config',label:'Configurações'},
];

let _allProfiles = [];

async function renderUsuarios(c){
  c.innerHTML = '<div class="empty-state"><div class="ico">⏳</div><div class="ttl">Carregando usuários...</div></div>';
  if(!_supa){
    c.innerHTML = '<div class="empty-state"><div class="ico">⚠</div><div class="ttl">Supabase não configurado</div></div>';
    return;
  }
  const { data } = await _supa.from('profiles').select('*').order('full_name');
  _allProfiles = data || [];

  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Usuários & Permissões</div>
          <div class="page-subtitle">${_allProfiles.length} usuários · só você (admin) acessa esta área</div>
        </div>
        <div class="page-actions">
          <button class="btn" onclick="criarLoginsEmMassa()" title="Cria logins automaticos pra todos os colaboradores da equipe">⚡ Criar logins em massa</button>
          <button class="btn btn-primary" onclick="openNovoUsuarioModal()">+ Novo usuário</button>
        </div>
      </div>

      <div class="card" style="padding:0">
        <table class="table">
          <thead><tr><th>Nome</th><th>Email</th><th>Cargo</th><th>Permissões</th><th>Status</th><th></th></tr></thead>
          <tbody>
            ${_allProfiles.map(p=>`
              <tr>
                <td><div style="display:flex;align-items:center;gap:10px"><div class="avatar" style="background:${p.avatar_color||'#1d1d1f'}">${p.initials||p.full_name[0]}</div><strong>${p.full_name}</strong></div></td>
                <td class="text-mu">${p.email||'—'}</td>
                <td><span class="badge ${p.role==='admin'?'b-purple':p.role==='gestor'?'b-info':'b-default'}">${p.role||'colaborador'}</span></td>
                <td><span class="text-xs text-3">${(p.permissions||[]).length} áreas</span>${p.stored_password_hint?'<div style="font-size:11px;color:var(--text-2);margin-top:2px"><strong>🔑</strong> <input type="text" value="'+p.stored_password_hint+'" onblur="updateStoredPwd(\''+p.id+'\',this.value)" style="background:transparent;border:none;font-family:monospace;color:var(--text-2);padding:0;font-size:11px;width:120px" /></div>':''}</td>
                <td>${p.enabled!==false?'<span class="badge b-success"><span class="dot"></span>Ativo</span>':'<span class="badge b-default">Inativo</span>'}</td>
                <td style="text-align:right">
                  ${!p.email?`<button class="btn btn-sm btn-primary" onclick="criarLoginRapido('${p.id}','${p.full_name.replace(/'/g,"\\'")}')" style="margin-right:5px">✨ Criar login</button>`:''}
                  <button class="btn btn-sm" onclick="openEditUsuario('${p.id}')">Editar</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>

      <div class="card mt-4" style="border-left:3px solid var(--info)">
        <div class="card-header"><div class="card-title">ℹ Como funciona</div></div>
        <div class="text-sm text-mu" style="line-height:1.6">
          <strong>Admin</strong> acessa tudo. <strong>Gestor</strong> e <strong>Colaborador</strong> acessam apenas as áreas que você marcar.<br/>
          Ao criar um novo usuário, ele recebe email/senha temporários. No primeiro acesso pode trocar a senha em Configurações.<br/>
          Para desativar acesso sem deletar, marque como "Inativo" na edição.
        </div>
      </div>
    </div>
  `;
}

function openNovoUsuarioModal(){
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700">+</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">Novo usuário</div><div class="text-xs text-3" style="margin-top:3px">Cria conta de login + define permissões</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><div class="info-label" style="margin-bottom:5px">Nome completo *</div><input id="nuName" class="login-input" placeholder="Ex: Maria Silva" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Email * <span class="text-xs text-3" style="cursor:pointer;text-decoration:underline" onclick="document.getElementById('nuEmail').value=document.getElementById('nuName').value.split(' ')[0].toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z]/g,'')+'@impulseone.com.br'">📧 gerar do nome</span></div><input id="nuEmail" class="login-input" type="email" placeholder="maria@impulseone.com.br" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Senha temporária *</div><input id="nuPwd" class="login-input" type="text" placeholder="Mínimo 6 caracteres" value="impulse2026" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Cargo</div>
          <select id="nuRole" class="login-input" style="background:var(--surface-2)" onchange="if(this.value==='admin') document.querySelectorAll('.perm-chk').forEach(x=>x.checked=true)">
            <option value="colaborador">Colaborador</option>
            <option value="gestor">Gestor</option>
            <option value="admin">Admin (acesso total)</option>
          </select>
        </div>
      </div>
      <div class="section-title">Permissões de acesso</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px">
        ${allPages.map(p=>`<label style="display:flex;gap:8px;align-items:center;padding:8px 11px;background:var(--surface-2);border-radius:8px;cursor:pointer;font-size:12.5px"><input type="checkbox" class="perm-chk" value="${p.id}" ${['dashboard','clientes','cronograma'].includes(p.id)?'checked':''} /> ${p.label}</label>`).join('')}
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovoUsuario()" id="nuSaveBtn">Criar usuário</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
  setTimeout(()=>document.getElementById('nuName').focus(), 100);
}

async function salvarNovoUsuario(){
  const name = document.getElementById('nuName').value.trim();
  const email = document.getElementById('nuEmail').value.trim();
  const pwd = document.getElementById('nuPwd').value;
  if(!name || !email || pwd.length<6){toast('Preencha nome, email e senha (min 6)','info');return}
  const role = document.getElementById('nuRole').value;
  const perms = Array.from(document.querySelectorAll('.perm-chk:checked')).map(x=>x.value);
  const btn = document.getElementById('nuSaveBtn');
  btn.disabled = true; btn.textContent = 'Criando...';
  try {
    const { data, error } = await _supa.auth.signUp({email, password: pwd});
    if(error) throw error;
    await _supa.from('profiles').insert({
      auth_user_id: data.user.id,
      full_name: name, email, role,
      permissions: perms, enabled: true,
      avatar_color: '#'+Math.floor(Math.random()*16777215).toString(16).padStart(6,'0'),
      initials: name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase()
    });
    toast(`✓ ${name} criado · senha temporária: ${pwd}`,'success');
    closeModal();
    renderUsuarios(document.getElementById('content'));
  } catch(e) {
    toast('Erro: '+e.message,'info');
    btn.disabled = false; btn.textContent = 'Criar usuário';
  }
}

async function openEditUsuario(id){
  const p = _allProfiles.find(x=>x.id===id);
  if(!p) return;
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div class="avatar" style="background:${p.avatar_color||'#1d1d1f'};width:40px;height:40px;font-size:14px">${p.initials||p.full_name[0]}</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">${p.full_name}</div><div class="text-xs text-3">${p.email||'sem email/login'}</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="card mb-3" style="background:${p.email?'var(--success-soft)':'var(--warning-soft)'};border:1px solid ${p.email?'var(--success)':'var(--warning)'}">
        <div style="display:flex;align-items:center;gap:11px">
          <div style="font-size:24px">${p.email?'✅':'⚠️'}</div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:600">${p.email?'Login configurado':'SEM LOGIN — usuário não consegue acessar o sistema'}</div>
            <div class="text-xs text-mu" style="margin-top:3px">${p.email?'Email: '+p.email+(p.stored_password_hint?' · Senha: '+p.stored_password_hint:''):'Defina email e senha abaixo pra criar login'}</div>
          </div>
        </div>
      </div>

      <div class="section-title" style="margin-top:0">🔐 Login / Acesso</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div>
          <div class="info-label" style="margin-bottom:5px">Email do login *</div>
          <input id="euEmail" class="login-input" type="email" value="${p.email||''}" placeholder="ex: gabi@impulseone.com.br" style="background:var(--surface-2)" />
        </div>
        <div>
          <div class="info-label" style="margin-bottom:5px">Senha ${p.email?'(nova - opcional)':'*'}</div>
          <div style="position:relative">
            <input id="euPwd" class="login-input" type="text" value="${p.stored_password_hint||''}" placeholder="${p.email?(p.stored_password_hint?'(senha visivel)':'Deixe vazio pra manter atual'):'Mínimo 6 caracteres'}" style="background:var(--surface-2);padding-right:36px" />
            <button onclick="copy(document.getElementById('euPwd').value,'Senha')" style="position:absolute;right:5px;top:50%;transform:translateY(-50%);background:transparent;border:none;cursor:pointer;color:var(--text-2);padding:6px" title="Copiar senha">📋</button>
          </div>
          ${p.stored_password_hint?'<div class="text-xs text-3 mt-3">🔒 Senha salva no perfil. Apenas admin vê.</div>':''}
        </div>
      </div>
      <button class="btn btn-primary" style="width:100%;margin-top:10px" onclick="criarOuAtualizarLogin('${p.id}', ${p.email?'true':'false'})">🔐 ${p.email?'Salvar nova anotação':'Criar conta de login'}</button>
      ${p.email?`<button class="btn" style="width:100%;margin-top:6px" onclick="trocarSenhaUsuario('${p.id}','${p.email}')">🔄 Trocar senha de fato (recriar conta)</button>`:''}

      <div class="section-title">👤 Configurações</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><div class="info-label" style="margin-bottom:5px">Cargo</div>
          <select id="euRole" class="login-input" style="background:var(--surface-2)">
            <option value="colaborador" ${p.role==='colaborador'?'selected':''}>Colaborador</option>
            <option value="gestor" ${p.role==='gestor'?'selected':''}>Gestor</option>
            <option value="admin" ${p.role==='admin'?'selected':''}>Admin (acesso total)</option>
          </select>
        </div>
        <div><div class="info-label" style="margin-bottom:5px">Status</div>
          <select id="euEnabled" class="login-input" style="background:var(--surface-2)">
            <option value="true" ${p.enabled!==false?'selected':''}>Ativo</option>
            <option value="false" ${p.enabled===false?'selected':''}>Inativo (bloqueado)</option>
          </select>
        </div>
      </div>
      <div class="section-title">Permissões de acesso</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px">
        ${allPages.map(pg=>`<label style="display:flex;gap:8px;align-items:center;padding:8px 11px;background:var(--surface-2);border-radius:8px;cursor:pointer;font-size:12.5px"><input type="checkbox" class="eperm-chk" value="${pg.id}" ${(p.permissions||[]).includes(pg.id)?'checked':''} /> ${pg.label}</label>`).join('')}
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:space-between">
        <button class="btn" onclick="excluirUsuario('${p.id}','${p.full_name.replace(/'/g,"\\'")}')" style="color:var(--danger)">🗑 Excluir usuário</button>
        <div style="display:flex;gap:8px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn btn-primary" onclick="salvarEditUsuario('${p.id}')">Salvar alterações</button></div>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function salvarEditUsuario(id){
  const role = document.getElementById('euRole').value;
  const enabled = document.getElementById('euEnabled').value === 'true';
  const perms = Array.from(document.querySelectorAll('.eperm-chk:checked')).map(x=>x.value);
  await _supa.from('profiles').update({role, permissions: perms, enabled}).eq('id', id);
  toast('✓ Permissões atualizadas','success');
  closeModal();
  renderUsuarios(document.getElementById('content'));
}





async function updateStoredPwd(profileId, value){
  if(!_supa) return;
  await _supa.from('profiles').update({stored_password_hint: value}).eq('id', profileId);
  toast('Senha anotada atualizada','success');
}

async function trocarSenhaUsuario(profileId, novaEmail){
  if(!_supa){toast('Supabase necessario','info');return}
  const novaSenha = prompt('Nova senha (mínimo 6 caracteres):\n\nIMPORTANTE: O Supabase NÃO permite trocar senha de usuario existente via SDK anon. A unica forma confiavel é deletar e recriar.\n\nDigite a senha:');
  if(!novaSenha || novaSenha.length < 6){toast('Senha invalida','info');return}
  // Salva como hint
  await _supa.from('profiles').update({stored_password_hint: novaSenha}).eq('id', profileId);
  // Tenta criar nova conta (vai dar erro se email ja existe)
  try {
    const { data, error } = await _supa.auth.signUp({email: novaEmail, password: novaSenha});
    if(error){
      if(error.message.includes('already')){
        alert('⚠ Para trocar a senha de um usuario que ja existe:\n\n1. Vai no Supabase → Authentication → Users\n2. Encontra o usuario ' + novaEmail + '\n3. Clica nos 3 pontinhos → Delete user\n4. Cria de novo: Add user → Create new user\n5. Email: ' + novaEmail + '\n6. Password: ' + novaSenha + '\n7. MARCA Auto Confirm User\n8. Create\n\nA senha foi salva como anotacao no perfil pra voce nao esquecer.');
      } else {
        alert('Erro: ' + error.message);
      }
    } else {
      await _supa.from('profiles').update({auth_user_id: data.user.id}).eq('id', profileId);
      toast('✓ Conta criada com nova senha','success');
    }
  } catch(e){ toast('Erro: '+e.message,'info') }
  renderUsuarios(document.getElementById('content'));
}



async function criarLoginRapido(profileId, nomeCompleto){
  if(!_supa){toast('Supabase necessario','info');return}
  console.log('[CRIAR LOGIN] iniciando para:', nomeCompleto, 'profileId:', profileId);
  
  // Gera email do nome
  const firstName = nomeCompleto.split(' ')[0].toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/[^a-z]/g,'');
  let email = firstName + '@impulseone.com.br';
  const senhaPadrao = 'impulse2026';
  
  toast('Criando login para ' + nomeCompleto + '...', 'info');
  
  // Tenta criar con