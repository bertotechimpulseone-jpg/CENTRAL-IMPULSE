// Função utilitária para obter plano do cliente
function planoCliente(id){
  const cli = clients.find(c=>c.id===id);
  if(!cli) return null;
  const planLevels = ['Essencial','Crescimento','Premium','Enterprise'];
  const lv = cli.origIdx%4;
  return {
    name:planLevels[lv],
    value:[1800,3200,5500,8900][lv],
    designer:['Henrique','Henrique','Heidy','Heidy'][lv],
    services:[
      ['Gestão de rede social','Design fixo'],
      ['Gestão de rede social','Design fixo','Tráfego pago'],
      ['Gestão de rede social','Design fixo','Tráfego pago','Vídeos','Captação'],
      ['Gestão de rede social','Design fixo','Tráfego pago','Vídeos','Captação','Branding','Campanhas','Consultoria']
    ][lv]
  };
}

