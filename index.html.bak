// Cronograma anual — gera dados determinísticos por cliente x mês
const cronograma = {};
clients.forEach((cli,ci)=>{
  cronograma[cli.id] = {};
  for(let m=1;m<=12;m++){
    const seed = (cli.id*7 + m*13) % 11;
    const target = [8,12,16,20][ci%4];
    const produced = Math.max(0,target - (m===5?Math.floor(seed/2):seed));
    const hasTraffic = (ci%2===0);
    const designerList = ['Henrique','Heidy','Henrique','Heidy'];
    const trafficList = ['Letícia','Letícia','Carlos','Letícia'];
    const dia = 15 + ((ci*3+m)%14);
    let status = 'em-andamento';
    if(m<5) status = 'concluido';
    else if(m===5){
      if(produced>=target*0.9) status='em-dia';
      else if(produced<target*0.5) status='atrasado';
      else status='em-andamento';
    } else status='planejado';
    cronograma[cli.id][m] = {
      produced, target, hasTraffic,
      trafficManager: trafficList[ci%4],
      designer: designerList[ci%4],
      status,
      deadline:`2026-${m.toString().padStart(2,'0')}-${dia.toString().padStart(2,'0')}`,
      obs:''
    };
  }
});

function getDeadlineAlerts(){
  const today = new Date('2026-05-18');
  today.setHours(0,0,0,0);
  const alerts = [];
  clients.forEach(cli=>{
    Object.entries(cronograma[cli.id]).forEach(([m,d])=>{
      const dl = new Date(d.deadline);
      const diff = Math.round((dl-today)/86400000);
      if((diff===0||diff===1) && d.status!=='concluido'){
        alerts.push({client:cli,month:parseInt(m),data:d,diff});
      }
    });
  });
  return alerts;
}


// ============ THEME ============
function toggleTheme(){
  const r = document.documentElement;
  const next = r.getAttribute('data-theme')==='light'?'dark':'light';
  r.setAttribute('data-theme',next);
  localStorage.setItem('theme',next);
  updateThemeIcon();
  // Redraw current charts after theme change
  setTimeout(()=>renderPage(currentPage),50);
}
function updateThemeIcon(){
  const t = document.documentElement.getAttribute('data-theme');
  const ic = document.getElementById('themeIcon');
  if(!ic) return;
  if(t==='dark'){
    ic.innerHTML = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  } else {
    ic.innerHTML = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>';
  }
}
(function(){const s=localStorage.getItem('theme');if(s)document.documentElement.setAttribute('data-theme',s);})();

// ============ TOAST ============
function toast(msg,type='success'){
  const wrap = document.getElementById('toastWrap');
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<span>${type==='success'?'✓':type==='info'?'ℹ':'!'}</span><span>${msg}</span>`;
  wrap.appendChild(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transform='translateY(10px)';setTimeout(()=>t.remove(),250)},2400);
}

// =========== Filtro DOM genérico para todas as páginas ===========
function pageFilter(input, selector){
  const q = (input.value||'').toLowerCase();
  const container = document.querySelector(selector);
  if(!container) return;
  let shown = 0, total = 0;
  container.querySelectorAll('[data-search]').forEach(el=>{
    total++;
    const match = el.dataset.search.toLowerCase().includes(q);
    el.style.display = match ? '' : 'none';
    if(match) shown++;
  });
  const emptyId = container.id+'_empty';
  let empty = document.getElementById(emptyId);
  if(!empty && total>0){
    empty = document.createElement('div');
    empty.id = emptyId;
    empty.className = 'empty-state';
    empty.innerHTML = '<div class="ico">🔍</div><div class="ttl">Nada encontrado</div><div class="desc">Ajuste o termo de busca.</div>';
    container.parentNode.insertBefore(empty, container.nextSibling);
  }
  if(empty) empty.style.display = shown===0&&q?'':'none';
}
function searchBar(placeholder, selector){
  return `<div class="page-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder="${placeholder}" oninput="pageFilter(this,'${selector}')"/></div>`;
}

function copy(txt,label='Copiado'){navigator.clipboard.writeText(txt);toast(`${label}: ${txt}`)}
function openLink(url){window.open(url,'_blank');toast('Abrindo em nova aba…','info')}
function whatsApp(phone,name){const clean=phone.replace(/\D/g,'');openLink(`https://wa.me/${clean}?text=${encodeURIComponent('Olá '+(name||''))}`)}

// ============ NAV ============
let currentPage = 'dashboard';
function renderNav(){
  const nav = document.getElementById('nav');
  if(!nav){ console.warn('[NAV] elemento #nav nao encontrado'); return; }
  // Se nao temos profile carregado, mostra TUDO pra nao deixar tela vazia
  const isAdminUser = isAdmin();
  const hasProfile = !!_currentProfile;
  console.log('[NAV] Renderizando · admin:', isAdminUser, '· profile:', hasProfile);
  nav.innerHTML = navItems.map(g=>{
    const visibleItems = g.items.filter(it=>{
      if(it.adminOnly && !isAdminUser) return false;
      // Se nao tem profile carregado, mostra tudo (fail open)
      if(!hasProfile) return true;
      if(isAdminUser) return true;
      return canAccess(it.id);
    });
    if(visibleItems.length===0) return '';
    return `<div class="nav-group"><div class="nav-label">${g.group}</div>${visibleItems.map(it=>`<div class="nav-item ${it.id===currentPage?'active':''}" data-page="${it.id}" onclick="goTo('${it.id}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">${it.icon}</svg><span>${it.label}</span>${it.badge?`<span class="nav-badge">${it.badge}</span>`:''}</div>`).join('')}</div>`;
  }).join('');
}
function goTo(page){
  currentPage = page;
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active', n.dataset.page===page));
  renderPage(page);
  // Fecha sidebar no mobile ao navegar
  closeSidebar();
  // Scroll pro topo no mobile
  try{ document.getElementById('content').scrollTop = 0; }catch(e){}
}

// ============ MOBILE SIDEBAR ============
function toggleSidebar(){
  const sb = document.getElementById('sidebar');
  const ov = document.getElementById('sidebarOverlay');
  if(!sb) return;
  const isOpen = sb.classList.contains('open');
  if(isOpen){ closeSidebar(); } else { openSidebar(); }
}
function openSidebar(){
  const sb = document.getElementById('sidebar');
  const ov = document.getElementById('sidebarOverlay');
  if(sb) sb.classList.add('open');
  if(ov) ov.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeSidebar(){
  const sb = document.getElementById('sidebar');
  const ov = document.getElementById('sidebarOverlay');
  if(sb) sb.classList.remove('open');
  if(ov) ov.classList.remove('open');
  document.body.style.overflow = '';
}
// Fecha sidebar com ESC
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape'){ closeSidebar(); }
});
// Fecha automaticamente se redimensionar pra desktop
window.addEventListener('resize', function(){
  if(window.innerWidth > 768){ closeSidebar(); }
});
function renderPage(page){
  const c = document.getElementById('content');
  const r = {
    dashboard:renderDashboard,clientes:renderClientes,financeiro:renderFinanceiro,
    operacional:renderOperacional,calendario:renderCalendario,conteudo:renderConteudo,
    reunioes:renderReunioes,equipe:renderEquipe,automacao:renderAutomacao,
    relatorios:renderRelatorios,arquivos:renderArquivos,config:renderConfig,
    captacao:renderCaptacao,comercial:renderComercial,ponto:renderPontoPage,
    cronograma:renderCronograma,
    usuarios:renderUsuarios,
    feedback:renderFeedback,
  };
  c.innerHTML='';c.scrollTop=0;
  (r[page]||renderDashboard)(c);
}
function toggleNotif(){document.getElementById('notifPop').classList.toggle('open')}
document.addEventListener('click',e=>{if(!e.target.closest('.notif-pop')&&!e.target.closest('[title="Notificações"]'))document.getElementById('notifPop').classList.remove('open')});
function closeModal(){document.getElementById('modalBg').classList.remove('open')}

function statBadge(s){
  const m={active:['b-success','Ativo'],onboarding:['b-info','Onboarding'],paused:['b-default','Pausado'],late:['b-danger','Atrasado']};
  const [c,l]=m[s]||m.active;
  return `<span class="badge ${c}"><span class="dot"></span>${l}</span>`;
}
function prioBadge(p){const m={urgent:'Urgente',high:'Alta',med:'Média',low:'Baixa'};return `<span class="prio prio-${p}">${m[p]}</span>`}

// ============ DASHBOARD ============
let dashFilter = {prio:'all',collab:'all',client:'all'};

function renderDashboard(c){
  const date = new Date();
  const greeting = date.getHours()<12?'Bom dia':date.getHours()<18?'Boa tarde':'Boa noite';
  const dateStr = date.toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});

  c.innerHTML = `
    <div class="page active">
      ${renderDeadlineBanner()}
      <div class="page-header">
        <div>
          <div class="page-title">${greeting}, Ederson</div>
