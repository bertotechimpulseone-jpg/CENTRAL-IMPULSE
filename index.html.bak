    <div class="modal-pane" data-pane="arquivos">
      <div class="filter-bar">
        <span class="filter-chip active">Todas</span>
        <span class="filter-chip">Criativos</span>
        <span class="filter-chip">Contratos</span>
        <span class="filter-chip">Vídeos</span>
        <span class="filter-chip">Relatórios</span>
