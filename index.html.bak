function openNovaReuniaoModal(){
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700">📹</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">Nova reunião</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Título *</div><input id="nmTitle" class="login-input" placeholder="Ex: Diagnóstico - ITD" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Cliente</div><select id="nmCli" class="login-input" style="background:var(--surface-2)"><option value="">Sem cliente (interno)</option>${clients.map(c=>`<option value="${c.id}">${c.name}</option>`).join('')}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Tipo</div><select id="nmType" class="login-input" style="background:var(--surface-2)"><option>Diagnóstico</option><option>Estratégia</option><option>Recorrente</option><option>Criativa</option><option>Renovação</option></select></div>
        <div><div class="info-label" style="margin-bottom:5px">Data *</div><input id="nmDate" class="login-input" type="date" value="2026-05-22" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Horário *</div><input id="nmTime" class="login-input" type="time" value="10:00" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Plataforma</div><select id="nmPlat" class="login-input" style="background:var(--surface-2)"><option>Google Meet</option><option>Zoom</option><option>Presencial</option><option>Microsoft Teams</option></select></div>
        <div><div class="info-label" style="margin-bottom:5px">Duração (min)</div><input id="nmDur" class="login-input" type="number" value="60" style="background:var(--surface-2)" /></div>
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Pauta / observações</div><textarea id="nmAgenda" class="login-input" style="background:var(--surface-2);min-height:70px"></textarea></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovaReuniao()" id="nmBtn">Agendar reunião</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function salvarNovaReuniao(){
  const title = document.getElementById('nmTitle').value.trim();
  if(!title){toast('Informe o título','info');return}
  const cliId = document.getElementById('nmCli').value;
  const cli = cliId ? clients.find(c=>c.id===parseInt(cliId)) : null;
  const d = document.getElementById('nmDate').value;
  const t = document.getElementById('nmTime').value;
  const scheduledAt = new Date(`${d}T${t}:00`).toISOString();
  const btn = document.getElementById('nmBtn'); btn.disabled = true; btn.textContent = 'Salvando...';
  const r = await dbCreate('meetings', {
    title, client_id: cli?cli._dbId:null,
    scheduled_at: scheduledAt,
    duration_min: parseInt(document.getElementById('nmDur').value) || 60,
    type: document.getElementById('nmType').value,
    platform: document.getElementById('nmPlat').value,
    agenda: document.getElementById('nmAgenda').value.trim(),
    meet_url: 'https://meet.google.com/new'
  });
  if(r){
    toast('✓ Reunião agendada','success');
    closeModal();
    await loadDataFromSupabase();
    renderReunioes(document.getElementById('content'));
  } else { btn.disabled=false; btn.textContent='Agendar reunião' }
}

// ============ MODAL: NOVA TRANSAÇÃO FINANCEIRA ============
function openNovaTransacaoModal(type){
  const mod = document.getElementById('clientModal');
  const isIn = type==='in';
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:${isIn?'var(--success)':'var(--danger)'};color:#fff;display:grid;place-items:center;font-weight:700;font-size:18px">${isIn?'+':'-'}</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">${isIn?'Nova cobrança / entrada':'Nova despesa'}</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Descrição *</div><input id="ntDesc" class="login-input" placeholder="${isIn?'Ex: Mensalidade maio - ITD':'Ex: Aluguel da sede'}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Valor *</div><input id="ntAmt" class="login-input" type="number" step="0.01" placeholder="0,00" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Data *</div><input id="ntDate" class="login-input" type="date" value="${new Date().toISOString().split('T')[0]}" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Categoria</div><select id="ntCat" class="login-input" style="background:var(--surface-2)">${isIn?'<option>recorrente</option><option>projeto</option><option>extra</option>':'<option>aluguel</option><option>salarios</option><option>ferramentas</option><option>trafego</option><option>impostos</option><option>outras</option>'}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Status</div><select id="ntStatus" class="login-input" style="background:var(--surface-2)"><option value="paid" selected>Pago</option><option value="pending">Pendente</option><option value="late">Atrasado</option></select></div>
        ${isIn?`<div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Cliente</div><select id="ntCli" class="login-input" style="background:var(--surface-2)"><option value="">—</option>${clients.map(c=>`<option value="${c.id}">${c.name}</option>`).join('')}</select></div>`:`<div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Fornecedor</div><input id="ntSup" class="login-input" placeholder="Ex: Adobe, INSS" style="background:var(--surface-2)" /></div>`}
        <div><div class="info-label" style="margin-bottom:5px">Forma pagamento</div><select id="ntMethod" class="login-input" style="background:var(--surface-2)"><option>pix</option><option>boleto</option><option>cartao</option><option>transferencia</option></select></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovaTransacao('${type}')" id="ntBtn">Salvar</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function salvarNovaTransacao(type){
  const desc = document.getElementById('ntDesc').value.trim();
  const amt = parseFloat(document.getElementById('ntAmt').value);
  if(!desc || !amt){toast('Preencha descrição e valor','info');return}
  const isIn = type==='in';
  const data = {
    type, description: desc, amount: amt,
    date: document.getElementById('ntDate').value,
    category: document.getElementById('ntCat').value,
    status: document.getElementById('ntStatus').value,
    payment_method: document.getElementById('ntMethod').value
  };
  if(isIn){
    const cliId = document.getElementById('ntCli').value;
    if(cliId){ const c = clients.find(x=>x.id===parseInt(cliId)); if(c) data.client_id = c._dbId; }
  } else {
    data.supplier = document.getElementById('ntSup').value.trim();
  }
  const btn = document.getElementById('ntBtn'); btn.disabled=true; btn.textContent='Salvando...';
  const r = await dbCreate('transactions', data);
  if(r){ toast('✓ Transação registrada','success'); closeModal(); renderFinanceiro(document.getElementById('content')); }
  else { btn.disabled=false; btn.textContent='Salvar' }
}

