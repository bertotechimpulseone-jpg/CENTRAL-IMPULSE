async function salvarNovoLead(){
  const name = document.getElementById('nlName').value.trim();
  if(!name){toast('Informe o nome da empresa','info');return}
  const data = {
    name, contact_name: document.getElementById('nlContact').value.trim(),
    phone: document.getElementById('nlPhone').value.replace(/\D/g,''),
    email: document.getElementById('nlEmail').value.trim(),
    segment: document.getElementById('nlSeg').value.trim(),
    value: parseFloat(document.getElementById('nlValue').value)||0,
    stage: document.getElementById('nlStage').value,
    priority: document.getElementById('nlPrio').value
  };
  const btn = document.getElementById('nlBtn'); btn.disabled=true; btn.textContent='Salvando...';
  const r = await dbCreate('leads', data);
  if(r){ toast('✓ Lead adicionado ao pipeline','success'); closeModal(); renderComercial(document.getElementById('content')); }
  else { btn.disabled=false; btn.textContent='Criar lead' }
}

