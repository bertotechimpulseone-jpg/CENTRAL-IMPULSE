}



// ============ HEALTH CHECK & AUTO-FIX ============
async function checkDbHealth(){
  if(!_supa) return {ok: false, msg: 'Sem Supabase'};
  const issues = [];
  // 1. Verificar se consegue ler profiles
  try {
    const { data: profs, error: e1 } = await _supa.from('profiles').select('id, full_name, salary, vacation_total, vacation_used').limit(1);
    if(e1){
      issues.push('READ profiles: ' + e1.message);
    } else if(!profs || profs.length === 0){
      issues.push('Tabela profiles vazia. Rode supabase-seed.sql ou crie usuarios.');
    } else {
      console.log('[HEALTH] ✅ READ profiles OK, exemplo:', profs[0]);
      // 2. Verificar se consegue UPDATE (teste de RLS)
      const testProfile = profs[0];
      const testVal = testProfile.salary || 0;
      const { data: upData, error: upErr } = await _supa.from('profiles').update({salary: testVal}).eq('id', testProfile.id).select();
      if(upErr){
        issues.push('UPDATE profiles BLOQUEADO (RLS): ' + upErr.message);
      } else if(!upData || upData.length === 0){
        issues.push('UPDATE retornou vazio - RLS pode estar bloqueando SELECT pos-update');
      } else {
        console.log('[HEALTH] ✅ UPDATE profiles OK');
      }
    }
  } catch(e){ issues.push('Exception: ' + e.message) }
  return {ok: issues.length === 0, issues, msg: issues.join(' | ')};
}

async function autoFixRLS(){
  toast('Tentando aplicar fix de RLS...','info');
  // Nao podemos rodar DDL do front. So mostra instrucao.
  alert('PARA HABILITAR SALVAMENTO\n\nCole este SQL no Supabase → SQL Editor → Run:\n\n' +
        '-- Libera UPDATE em todas as tabelas pra autenticados\n' +
        'drop policy if exists "auth all" on profiles;\n' +
        'create policy "auth all" on profiles for all to authenticated, anon using (true) with check (true);\n\n' +
        'drop policy if exists "auth all" on clients;\n' +
        'create policy "auth all" on clients for all to authenticated, anon using (true) with check (true);\n\n' +
        'drop policy if exists "auth all" on budgets;\n' +
        'create policy "auth all" on budgets for all to authenticated, anon using (true) with check (true);\n\n' +
        'drop policy if exists "auth all" on custom_links;\n' +
        'create policy "auth all" on custom_links for all to authenticated, anon using (true) with check (true);');
}

// Roda health check apos login
setTimeout(async ()=>{
  if(_supa && _currentUser){
    const h = await checkDbHealth();
    if(!h.ok){
      console.error('[HEALTH] ❌ Problemas:', h.issues);
      // Mostra banner discreto sugerindo fix
      const banner = document.createElement('div');
      banner.id = 'healthBanner';
      banner.style.cssText = 'position:fixed;top:64px;left:50%;transform:translateX(-50%);background:var(--warning-soft);color:var(--warning-text);padding:11px 18px;border-radius:9px;box-shadow:var(--shadow-lg);z-index:300;cursor:pointer;font-size:12.5px;border:1px solid var(--warning);font-weight:500';
      banner.innerHTML = '⚠ Problema de permissão detectado · <strong>clique aqui</strong> pra ver como resolver';
      banner.onclick = autoFixRLS;
      document.body.appendChild(banner);
      setTimeout(()=>{if(banner.parentNode)banner.style.opacity='0.5'}, 8000);
    } else {
      console.log('[HEALTH] ✅ Banco OK pra salvar');
    }
  }
}, 4000);


// ============ AUTO-SYNC UNIVERSAL ============
// Toda alteracao salva sozinha. Se falhar, tenta de novo silenciosamente.
// Se coluna nao existe, ignora sem encher o usuario.

const _syncQueue = [];
let _syncInProgress = false;
let _silentMode = true; // toasts discretos

async function autoSyncField(table, recordId, field, value){
  if(!_supa || !recordId){
    console.error('[SYNC] FALHA: supa=',!!_supa,'recordId=',recordId);
    return false;
  }
  console.log('[SYNC] >>>', table, recordId, field, '=', JSON.stringify(value), 'tipo:', typeof value);
  try {
    const { data, error } = await _supa.from(table).update({[field]: value}).eq('id', recordId).select();
    if(error){
      console.error('[SYNC] ❌ ERRO:', error.message, error);
      if(error.message && error.message.includes('column')){
        toast('⚠ Coluna "'+field+'" não existe no banco. Rode o SQL.','info');
        console.warn('Rode no Supabase: alter table '+table+' add column if not exists '+field+' text;');
      } else if(error.message && (error.message.includes('policy') || error.message.includes('RLS') || error.message.includes('permission'))){
        toast('⚠ Sem permissão pra editar. RLS bloqueando.','info');
        alert('PROBLEMA DE PERMISSAO (RLS)\n\nO Supabase está bloqueando o UPDATE.\n\nRode no SQL Editor:\n\ndrop policy if exists "auth all" on '+table+';\ncreate policy "auth all" on '+table+' for all to authenticated using (true) with check (true);');
      } else {
        toast('⚠ Erro ao salvar: '+error.message,'info');
      }
      return false;
    }
    // Confirma com read após write
    console.log('[SYNC] ✓ Update retornou:', data);
    if(!data || data.length === 0){
      console.error('[SYNC] ⚠ UPDATE retornou vazio - registro nao encontrado ou RLS bloqueando SELECT');
      toast('⚠ Save retornou vazio. Verifique RLS.','info');
      return false;
    }
    // Read após write pra confirmar persistencia
    const { data: confirm } = await _supa.from(table).select(field).eq('id', recordId).single();
    if(confirm && confirm[field] === value){
      console.log('[SYNC] ✅ CONFIRMADO no banco:', field, '=', confirm[field]);
      return true;
    } else {
      console.error('[SYNC] ❌ READ AFTER WRITE FALHOU. Esperava:', value, 'Achou:', confirm?.[field]);
      toast('⚠ Save nao persistiu. Verifique RLS.','info');
      return false;
    }
  } catch(e){
    console.error('[SYNC] EXCEPTION:', e);
    toast('⚠ Exception: '+e.message,'info');
    return false;
  }
}

// Versao com feedback visual sutil
async function autoSyncFieldUI(table, recordId, field, value, label){
  const ok = await autoSyncField(table, recordId, field, value);
  if(ok){
    // Toast minimalista verde
    const toastWrap = document.getElementById('toastWrap');
    if(toastWrap){
      const t = document.createElement('div');
      t.className = 'toast success';
      t.innerHTML = '<span>✓</span><span>' + (label||field) + ' atualizado</span>';
      t.style.minWidth = '180px';
      t.style.opacity = '0.9';
      toastWrap.appendChild(t);
      setTimeout(()=>{t.style.opacity='0';t.style.transform='translateY(10px)';setTimeout(()=>t.remove(),250)},1500);
    }
  }
  return ok;
}

// Reload silencioso de uma tabela (atualiza array global)
async function silentReload(table){
  if(!_supa) return;
  try {
    if(table === 'clients'){
      await loadDataFromSupabase();
    } else if(table === 'budgets'){
      const { data } = await _supa.from('budgets').select('*').order('created_at',{ascending:false}).limit(200);
      if(data) orcamentosSalvos = data;
    } else if(table === 'profiles'){
      const { data } = await _supa.from('profiles').select('*').order('full_name');
      if(data){
        data.forEach(p => {
          const found = team.find(t => (t._dbId === p.id) || (t.name && t.name.toLowerCase() === (p.full_name||'').toLowerCase()));
          if(found){
            found._dbId = p.id;
            ['cpf','phone','email','address','contract_type','bank','vacation_period_end','vacation_legal_deadline','promotion_eval','raise_eval','areas_develop','strengths','next_review'].forEach(f => {
              if(p[f] !== null && p[f] !== undefined) found[f] = p[f];
            });
            if(p.contract_start) found.since = p.contract_start;
            if(p.full_name) found.name = p.full_name;
            if(p.position) found.role = p.position;
            if(p.vacation_total !== null && p.vacation_total !== undefined) found.vacationDays = p.vacation_total;
            if(p.vacation_used !== null && p.vacation_used !== undefined) found.vacationUsed = p.vacation_used;
            if(p.last_vacation !== null && p.last_vacation !== undefined) found.lastVacation = p.last_vacation;
            if(p.productivity !== null && p.productivity !== undefined) found.prod = p.productivity;
            if(p.weekly_tasks !== null && p.weekly_tasks !== undefined) found.tasks = p.weekly_tasks;
            if(p.salary !== null && p.salary !== undefined) found.salary = parseFloat(p.salary);
            if(p.avatar_color) found.color = p.avatar_color;
            if(p.initials) found.init = p.initials;
          }
        });
      }
    }
  } catch(e){ console.warn('[SYNC] reload', table, e.message) }
}



// ============ SUPABASE REALTIME (sync entre usuarios) ============
let _realtimeChannel = null;

function startRealtimeSync(){
  if(!_supa || _realtimeChannel) return;
  try {
    _realtimeChannel = _supa.channel('global-sync')
      .on('postgres_changes', {event: '*', schema: 'public', table: 'clients'}, ()=>{
        console.log('[RT] clients mudou');
        silentReload('clients').then(()=>{
          if(currentPage === 'clientes' || currentPage === 'dashboard') renderPage(currentPage);
        });
      })
      .on('postgres_changes', {event: '*', schema: 'public', table: 'profiles'}, ()=>{
        console.log('[RT] profiles mudou');
        silentReload('profiles');
      })
      .on('postgres_changes', {event: '*', schema: 'public', table: 'budgets'}, ()=>{
        console.log('[RT] budgets mudou');
        silentReload('budgets').then(()=>{
          if(currentPage === 'comercial') renderComercial(document.getElementById('content'));
        });
      })
      .subscribe((status)=>{
        console.log('[RT] status:', status);
      });
  } catch(e){ console.warn('[RT] erro:', e); }
}

// Iniciar realtime quando app carrega
setTimeout(()=>{
  if(_supa && !_realtimeChannel) startRealtimeSync();
}, 3000);


// ============ EDITAR CAMPOS DO COLABORADOR ============
async function editProfileField(profileIdx, field, value){
  if(!_supa) return; // silencioso se sem banco
  const member = team[profileIdx];
  if(!member) return;
  const dbId = await ensureProfileInDB(member);
  if(!dbId) return;
  // Atualiza local imediatamente (resposta instantanea)
  member[field === 'full_name' ? 'name' : (field === 'position' ? 'role' : field)] = value;
  // Salva no banco em background (silencioso)
  autoSyncFieldUI('profiles', dbId, field, value, field);
}

async function addProfileDocument(profileIdx, name, url){
  if(!_supa) return;
  const member = team[profileIdx];
  if(!member){toast('Colaborador nao encontrado','info');return}
  const dbId = await ensureProfileInDB(member);
  if(!dbId){toast('Erro ao garantir registro','info');return}
  // Salva como link customizado vinculado ao profile
  try {
    await _supa.from('custom_links').insert({
      link_key: 'profile-' + dbId + '-doc-' + Date.now(),
      group_key: 'profile-' + dbId + '-docs',
      label: name,
      url: url
    });
    toast('✓ Documento adicionado','success');
    if(typeof openEquipePerfil === 'function') openEquipePerfil(profileIdx);
    else renderPage('equipe');
  } catch(e){ toast('Erro: '+e.message,'info') }
}

async function loadProfileDocuments(dbId){
  if(!_supa) return [];
  try {
    const { data } = await _supa.from('custom_links').select('*').eq('group_key', 'profile-' + dbId + '-docs').order('created_at',{ascending:false});
    return data || [];
  } catch(e){ return [] }
}

function abrirAddDocModal(profileIdx){
  const member = team[profileIdx];
  const name = prompt('Nome do documento (ex: Contrato CLT, RG, Comprovante de endereço):');
  if(!name) return;
  const url = prompt('Cole a URL do documento (Google Drive, link público, etc):\n\nExemplo: https://drive.google.com/file/d/...');
  if(!url || !url.startsWith('http')){toast('URL inválida','info');return}
  addProfileDocument(profileIdx, name, url);
}

async function removeProfileDoc(linkId){
  if(!confirm('Remover este documento?')) return;
  if(_supa) await _supa.from('custom_links').delete().eq('id', linkId);
  toast('Documento removido','success');
  renderPage('equipe');
}


