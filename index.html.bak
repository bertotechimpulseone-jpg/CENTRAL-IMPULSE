        <div class="info-item"><div class="info-label">Responsável</div><div class="info-value">Roberto Silva <button class="copy-btn" onclick="copy('Roberto Silva','Nome')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div></div>
        <div class="info-item"><div class="info-label">Cargo</div><div class="info-value">Diretor</div></div>
        <div class="info-item"><div class="info-label">WhatsApp</div><div class="info-value">+55 ${cli.phone.slice(2,4)} ${cli.phone.slice(4,9)}-${cli.phone.slice(9)} <button class="copy-btn" onclick="copy('${cli.phone}','Telefone')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div></div>
        <div class="info-item"><div class="info-label">E-mail</div><div class="info-value">${cli.email} <button class="copy-btn" onclick="copy('${cli.email}','E-mail')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div></div>
        <div class="info-item"><div class="info-label">Instagram</div><div class="info-value">${cli.ig} <button class="copy-btn" onclick="copy('${cli.ig}','Handle')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div></div>
        <div class="info-item"><div class="info-label">Site</div><div class="info-value">${cli.site} <button class="copy-btn" onclick="openLinksManager('client-'+${cli.id}+'-site', '🌐 Site - ${cli.name}', 'https://${cli.site}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14L21 3M21 3v7M21 3h-7"/></svg></button></div></div>
        <div class="info-item"><div class="info-label">Segmento</div><div class="info-value">${cli.segment}</div></div>
