async function renderProfileDocs(profileIdx){
  const member = team[profileIdx];
  if(!member) return;
  const grid = document.getElementById('profile-docs-grid');
  if(!grid) return;
  if(!member._dbId){
    grid.innerHTML = '<div class="text-mu text-sm center" style="grid-column:span 4;padding:20px">Salve o colaborador no banco primeiro</div>';
    return;
  }
  const docs = await loadProfileDocuments(member._dbId);
  if(docs.length === 0){
    grid.innerHTML = '<div class="text-mu text-sm center" style="grid-column:span 4;padding:20px">📂 Nenhum documento ainda. Clique em <strong>+ Adicionar documento</strong> acima</div>';
    return;
  }
  grid.innerHTML = docs.map(d => `
    <div class="file" style="position:relative">
      <div class="file-icon">📄</div>
      <div class="file-name" style="cursor:pointer" onclick="window.open('${(d.url||'').replace(/'/g,"\\'")}','_blank')" title="Abrir">${d.label||'(sem nome)'}</div>
      <div class="file-meta">${new Date(d.created_at).toLocaleDateString('pt-BR')}</div>
      <button class="icon-btn" onclick="removeProfileDocAndRefresh('${d.id}',${profileIdx})" style="position:absolute;top:5px;right:5px;width:22px;height:22px;color:var(--danger);background:var(--surface-2);border-radius:5px" title="Remover">×</button>
    </div>
  `).join('');
}

async function removeProfileDocAndRefresh(linkId, profileIdx){
  if(!confirm('Remover este documento?')) return;
  if(_supa) await _supa.from('custom_links').delete().eq('id', linkId);
  toast('✓ Documento removido','success');
  renderProfileDocs(profileIdx);
}

async function uploadProfileDoc(profileIdx, file, customName){
  const member = team[profileIdx];
  if(!member){toast('Colaborador nao encontrado','info');return}
  if(!_supa){toast('Supabase necessario','info');return}
  const dbId = await ensureProfileInDB(member);
  if(!dbId){toast('Erro ao garantir registro','info');return}
  try {
    toast('Enviando arquivo...','info');
    const ext = file.name.split('.').pop();
    const fileName = 'profile-' + dbId + '/' + Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9.-]/g,'_');
    const { data: upData, error: upErr } = await _supa.storage.from('team-documents').upload(fileName, file);
    if(upErr){
      // Bucket pode não existir
      if(upErr.message && upErr.message.includes('not found')){
        toast('Bucket "team-documents" nao existe. Crie no Supabase Storage','info');
        alert('Crie o bucket no Supabase:\n\n1. Supabase → Storage\n2. New bucket → Nome: "team-documents" → PRIVATE → Create\n3. Tente novamente');
        return;
      }
      throw upErr;
    }
    // Pega URL publica/assinada
    const { data: urlData } = _supa.storage.from('team-documents').getPublicUrl(fileName);
    const publicUrl = urlData.publicUrl;
    // Salva como link
    await _supa.from('custom_links').insert({
      link_key: 'profile-' + dbId + '-doc-' + Date.now(),
      group_key: 'profile-' + dbId + '-docs',
      label: customName || file.name,
      url: publicUrl
    });
    toast('✓ Documento enviado','success');
    renderProfileDocs(profileIdx);
  } catch(e){
    console.error('[upload] erro:', e);
    toast('Erro: '+e.message,'info');
  }
}

function abrirUploadDocModal(profileIdx){
  const member = team[profileIdx];
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700">📎</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">Adicionar documento</div><div class="text-xs text-3">${member.name}</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:flex;gap:8px;margin-bottom:18px;background:var(--surface-2);padding:4px;border-radius:9px">
        <button class="btn btn-primary" style="flex:1" onclick="document.getElementById('docMethodUpload').style.display='block';document.getElementById('docMethodLink').style.display='none'">📎 Anexar arquivo</button>
        <button class="btn" style="flex:1" onclick="document.getElementById('docMethodUpload').style.display='none';document.getElementById('docMethodLink').style.display='block'">🔗 Adicionar link</button>
      </div>

      <div id="docMethodUpload">
        <div class="info-label" style="margin-bottom:5px">Nome do documento (opcional)</div>
        <input id="docName" class="login-input" placeholder="Ex: Contrato CLT 2026" style="background:var(--surface-2);margin-bottom:12px" />
        <div class="info-label" style="margin-bottom:5px">Selecione o arquivo</div>
        <input id="docFile" type="file" accept="*/*" style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13px;cursor:pointer" />
        <div class="text-xs text-3 mt-3">⚠ Antes do primeiro upload, crie um bucket "team-documents" no Supabase Storage (privado)</div>
        <button class="btn btn-primary" style="width:100%;margin-top:14px" onclick="doUploadDoc(${profileIdx})">📎 Enviar documento</button>
      </div>

      <div id="docMethodLink" style="display:none">
        <div class="info-label" style="margin-bottom:5px">Nome do documento</div>
        <input id="docLinkName" class="login-input" placeholder="Ex: Contrato CLT" style="background:var(--surface-2);margin-bottom:12px" />
        <div class="info-label" style="margin-bottom:5px">URL do documento</div>
        <input id="docLinkUrl" class="login-input" placeholder="https://drive.google.com/file/d/..." style="background:var(--surface-2)" />
        <div class="text-xs text-3 mt-3">💡 Cole link do Google Drive, Dropbox, OneDrive ou qualquer URL pública</div>
        <button class="btn btn-primary" style="width:100%;margin-top:14px" onclick="doAddDocLink(${profileIdx})">🔗 Adicionar link</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function doUploadDoc(profileIdx){
  const fileInput = document.getElementById('docFile');
  const name = document.getElementById('docName').value.trim();
  if(!fileInput.files || fileInput.files.length === 0){toast('Selecione um arquivo','info');return}
  const file = fileInput.files[0];
  closeModal();
  await uploadProfileDoc(profileIdx, file, name);
}

async function doAddDocLink(profileIdx){
  const name = document.getElementById('docLinkName').value.trim();
  const url = document.getElementById('docLinkUrl').value.trim();
  if(!name || !url){toast('Preencha nome e URL','info');return}
  if(!url.startsWith('http')){toast('URL deve começar com http','info');return}
  closeModal();
  await addProfileDocument(profileIdx, name, url);
  renderProfileDocs(profileIdx);
}



async function salvarTudoProfile(profileIdx){
  const member = team[profileIdx];
  if(!member){toast('Colaborador nao encontrado','info');return}
  if(!_supa){toast('Supabase nao conectado','info');return}
  toast('Verificando registro no banco...','info');
  const dbId = await ensureProfileInDB(member);
  if(!dbId){toast('Erro ao criar/achar registro','info');return}
  if(!_supa){toast('Supabase não conectado','info');return}
  toast('Salvando todas as informações...','info');
  try {
    // Pega todos os inputs editaveis do perfil e força save
    const fields = {
      full_name: member.name,
      cpf: member.cpf,
      position: member.role,
      phone: member.phone,
      email: member.email,
      address: member.address,
      contract_type: member.contract_type || 'CLT',
      contract_start: member.since,
      salary: parseFloat(member.salary)||0,
      bank: member.bank,
      vacation_total: parseInt(member.vacationDays)||30,
      vacation_used: parseInt(member.vacationUsed)||0,
      vacation_period_end: member.vacation_period_end,
      vacation_legal_deadline: member.vacation_legal_deadline,
      last_vacation: member.lastVacation,
      productivity: parseInt(member.prod)||0,
      weekly_tasks: parseInt(member.tasks)||0,
      promotion_eval: member.promotion_eval,
      raise_eval: member.raise_eval,
      areas_develop: member.areas_develop,
      strengths: member.strengths,
      next_review: member.next_review
    };
    // Remove undefined
    Object.keys(fields).forEach(k => { if(fields[k]===undefined || fields[k]==='') delete fields[k]; });
    await _supa.from('profiles').update(fields).eq('id', dbId);
    toast('✓ Todas as informações foram salvas e sincronizadas','success');
    // Recarrega profile do banco
    const { data } = await _supa.from('profiles').select('*').eq('id', dbId).single();
    if(data){
      Object.assign(member, {
        name: data.full_name, role: data.position, cpf: data.cpf,
        phone: data.phone, email: data.email, address: data.address,
        contract_type: data.contract_type, since: data.contract_start,
        salary: data.salary, bank: data.bank,
        vacationDays: data.vacation_total, vacationUsed: data.vacation_used,
        vacation_period_end: data.vacation_period_end,
        vacation_legal_deadline: data.vacation_legal_deadline,
        lastVacation: data.last_vacation, prod: data.productivity,
        tasks: data.weekly_tasks, promotion_eval: data.promotion_eval,
        raise_eval: data.raise_eval, areas_develop: data.areas_develop,
        strengths: data.strengths, next_review: data.next_review
      });
    }
    renderEquipe(document.getElementById('content'));
  } catch(e){
    toast('Erro: '+e.message,'info');
  }
}



async function ensureProfileInDB(member){
  if(!_supa){console.error('[ENSURE] sem supa');return null}
  if(member._dbId){console.log('[ENSURE] ja tem dbId:', member._dbId);return member._dbId}
  // Tenta achar no banco por nome
  try {
    const { data: found } = await _supa.from('profiles').select('id').ilike('full_name', member.name).maybeSingle();
    if(found && found.id){
      member._dbId = found.id;
      console.log('[ENSURE] Profile achado:', found.id);
      return found.id;
    }
    // Não existe - cria novo profile
    const { data: created, error } = await _supa.from('profiles').insert({
      full_name: member.name,
      position: member.role || '',
      cpf: member.cpf || '',
      phone: member.phone || '',
      email: member.email || '',
      avatar_color: member.color || '#1d1d1f',
      initials: member.init || (member.name?.[0]||'?').toUpperCase(),
      salary: parseFloat(member.salary)||0,
      contract_start: member.since || null,
      vacation_total: parseInt(member.vacationDays)||30,
      vacation_used: parseInt(member.vacationUsed)||0,
      productivity: parseInt(member.prod)||85
    }).select().single();
    if(error){ console.error('[ENSURE] erro criar:', error); return null; }
    member._dbId = created.id;
    console.log('[ENSURE] Profile criado novo:', created.id);
    return created.id;
  } catch(e){ console.error('[ENSURE] exception:', e); return null; }
}




async function forcarReloadProfile(){
  if(!_supa){toast('Supabase nao conectado','info');return}
  toast('Recarregando do banco...','info');
  await silentReload('profiles');
  console.log('[RELOAD] team atualizado:', team[perfilId]);
  toast('✓ Recarregado · veja console (F12)','success');
  renderEquipe(document.getElementById('content'));
}

