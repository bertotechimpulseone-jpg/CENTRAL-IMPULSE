        </div>
        <div class="page-actions">
          <div class="search" style="max-width:260px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder="Busca inteligente..." /></div>
          <button class="btn" onclick="goTo('relatorios')">📊 Relatórios</button>
        </div>
      </div>

      <div class="quick-row">
        <div class="quick" onclick="openLinksManager('dashboard-mlabs','📅 MLABS','https://app.mlabs.com.br')"><div class="quick-icon" style="background:#fef4e0;color:#9a6500">📅</div><div><div class="quick-title">MLABS</div><div class="quick-sub">Agendamento</div></div></div>
        <div class="quick" onclick="openLinksManager('dashboard-drive','📁 Google Drive','https://drive.google.com')"><div class="quick-icon" style="background:#e4f4fc;color:#0369a1">📁</div><div><div class="quick-title">Google Drive</div><div class="quick-sub">Arquivos</div></div></div>
        <div class="quick" onclick="goTo('financeiro')"><div class="quick-icon" style="background:#e6f7ec;color:#1a7335">💰</div><div><div class="quick-title">Financeiro</div><div class="quick-sub">Agência</div></div></div>
        <div class="quick" onclick="goTo('captacao')"><div class="quick-icon" style="background:#f1ebfd;color:#5b21b6">🎬</div><div><div class="quick-title">Captação</div><div class="quick-sub">${captacoes.filter(c=>['agendada','confirmada','em andamento'].includes(c.status)).length} próximas</div></div></div>
        <div class="quick" onclick="openLinksManager('dashboard-whatsapp','💬 WhatsApp','https://web.whatsapp.com')"><div class="quick-icon" style="background:#dcf8e3;color:#15803d">💬</div><div><div class="quick-title">WhatsApp Web</div><div class="quick-sub">Mensagens</div></div></div>
      </div>

      <div class="stat-grid">
        ${statCard('Clientes ativos','19','21 total','M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2')}
        ${statCard('Tarefas pendentes','12','4 urgentes','M9 11l3 3L22 4',null,'warning')}
        ${statCard('Reuniões hoje','3','próxima 10:30','M23 7l-7 5 7 5z')}
        ${statCard('Aprovações','7','pendentes','M9 12l2 2 4-4',null,'warning')}
        ${statCard('Captações','3','próx. 7 dias','M14 6l-4 4 4 4',null,'pink')}
        ${statCard('Vencimentos internos','5','próx. 7 dias','M12 8v4l3 3')}
      </div>

      <div class="filter-bar" style="background:var(--surface);padding:11px;border-radius:10px;border:1px solid var(--border)">
        <span class="text-xs text-mu" style="font-weight:600;margin-right:6px">FILTRAR POR:</span>
        <span class="text-xs text-3">Prioridade:</span>
        <span class="filter-chip ${dashFilter.prio==='all'?'active':''}" onclick="dashFilter.prio='all';renderDashboard(document.getElementById('content'))">Todas</span>
        <span class="filter-chip ${dashFilter.prio==='urgent'?'active':''}" onclick="dashFilter.prio='urgent';renderDashboard(document.getElementById('content'))">🔴 Urgente</span>
        <span class="filter-chip ${dashFilter.prio==='high'?'active':''}" onclick="dashFilter.prio='high';renderDashboard(document.getElementById('content'))">🟠 Alta</span>
        <span class="filter-chip ${dashFilter.prio==='med'?'active':''}" onclick="dashFilter.prio='med';renderDashboard(document.getElementById('content'))">🔵 Média</span>
        <span class="filter-chip ${dashFilter.prio==='low'?'active':''}" onclick="dashFilter.prio='low';renderDashboard(document.getElementById('content'))">⚪ Baixa</span>
        <span style="border-left:1px solid var(--border);height:18px;margin:0 4px"></span>
        <span class="text-xs text-3">Colaborador:</span>
        <select onchange="dashFilter.collab=this.value;renderDashboard(document.getElementById('content'))" style="padding:5px 10px;border-radius:6px;border:1px solid var(--border);background:var(--surface-2);font-size:11.5px;color:var(--text);font-family:inherit">
