async function salvarNovaTarefa(){
  const title = document.getElementById('ntkTitle').value.trim();
  if(!title){toast('Informe o título','info');return}
  const data = {
    title, assigned_to: document.getElementById('ntkAss').value || null,
    client_id: document.getElementById('ntkCli').value || null,
    priority: document.getElementById('ntkPrio').value,
    scheduled_time: document.getElementById('ntkTime').value,
    due_date: document.getElementById('ntkDate').value,
    tag: document.getElementById('ntkTag').value.trim(),
    is_daily: document.getElementById('ntkDaily').checked,
    status: 'todo'
  };
  const btn = document.getElementById('ntkBtn'); btn.disabled=true; btn.textContent='Salvando...';
  const r = await dbCreate('tasks', data);
  if(r){ toast('✓ Tarefa criada','success'); closeModal(); await loadDataFromSupabase(); renderOperacional(document.getElementById('content')); }
  else { btn.disabled=false; btn.textContent='Criar tarefa' }
}

// ============ EDIÇÃO INLINE NO CLIENTE ============
async function saveClienteField(clientId, field, value){
  const cli = clients.find(c=>c.id===clientId);
  if(!cli || !cli._dbId) return;
  const map = {name:'name',segment:'segment',phone:'phone',email:'email',instagram:'instagram',website:'website',status:'status'};
  const dbField = map[field];
  if(!dbField) return;
  await dbUpdate('clients', cli._dbId, {[dbField]: value});
  cli[field === 'instagram' ? 'ig' : field === 'website' ? 'site' : field] = value;
  toast('✓ Atualizado','success');
}


