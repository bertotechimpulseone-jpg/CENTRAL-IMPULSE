                <div class="text-xs text-3">${17+i} mai · 19h</div>
                <div class="text-sm font-semi">Post #${i+1}</div>
                <span class="badge ${co}" style="margin-top:5px">${st}</span>
              </div>`;
            }).join('')}
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

function paneFinanceiro(cli){
  const plan = planoCliente(cli.id);
  const allServices = ['Gestão de rede social','Tráfego pago','Design fixo','Branding','Vídeos','Captação','Campanhas','Consultoria'];
  return `
    <div class="modal-pane" data-pane="plano">
      <div class="card mb-4" style="background:linear-gradient(135deg,var(--surface-2),var(--surface));border:1px solid var(--border-strong)">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap">
          <div>
            <div class="text-xs text-3" style="text-transform:uppercase;letter-spacing:.08em;font-weight:600">Plano atual</div>
            <div style="font-size:22px;font-weight:700;letter-spacing:-.02em;margin-top:4px">${plan.name}</div>
            <div class="text-sm text-mu" style="margin-top:3px">Recorrente · ${plan.services.length} serviços inclusos</div>
          </div>
          <div style="text-align:right">
            <div style="font-size:28px;font-weight:700;letter-spacing:-.02em">R$ ${plan.value.toLocaleString('pt-BR')}<span style="font-size:14px;color:var(--text-3);font-weight:500">/mês</span></div>
            <div class="text-xs text-3">Valor interno</div>
          </div>
        </div>
      </div>
      <div class="info-grid mb-4">
        <div class="info-item"><div class="info-label">Owner (Gerente)</div><div class="info-value">${cli.owner}</div></div>
        <div class="info-item"><div class="info-label">Designer responsável</div><div class="info-value">${plan.designer}</div></div>
        <div class="info-item"><div class="info-label">Cliente desde</div><div class="info-value">jan/2025</div></div>
        <div class="info-item"><div class="info-label">Renovação</div><div class="info-value">30 mai 2026</div></div>
      </div>
      <div class="section-title" style="margin-top:0">Serviços contratados</div>
      <div style="display:flex;flex-direction:column;gap:6px">
        ${allServices.map(s=>{
          const has = plan.services.includes(s);
          return `<div style="display:flex;align-items:center;gap:10px;padding:11px 13px;background:${has?'var(--surface-2)':'var(--surface)'};border:1px solid var(--border);border-radius:9px">
            <div style="width:20px;height:20px;border-radius:5px;display:grid;place-items:center;background:${has?'var(--success)':'var(--surface-3)'};color:${has?'#fff':'var(--text-3)'};font-size:12px;font-weight:700">${has?'✓':'—'}</div>
            <span style="flex:1;font-size:13px;${has?'':'color:var(--text-3)'}">${s}</span>
            ${has?'<span class="badge b-success">Incluso</span>':'<button class="btn btn-sm" onclick="goTo(\'comercial\');closeModal()">+ Adicionar</button>'}
          </div>`;
        }).join('')}
      </div>
      <div class="card mt-4" style="border-left:3px solid var(--purple)">
        <div class="card-header"><div class="card-title">📈 Projeção & sugestão de upgrade</div><span class="badge b-purple">IA</span></div>
        <div class="text-sm text-mu" style="line-height:1.6">Com base no tempo de contrato e crescimento, sugerimos avançar para o próximo plano. <button class="btn btn-sm btn-primary" onclick="goTo('comercial');closeModal()" style="margin-left:8px">Ver oportunidade comercial</button></div>
      </div>
    </div>
  `;
}

