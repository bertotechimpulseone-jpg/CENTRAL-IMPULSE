          {t:'Edição vídeo Dener',o:'Haisa',c:'Dener',p:'high',tag:'Vídeo'},
          {t:'Meta Ads — Weco',o:'Letícia',c:'Weco',p:'high',tag:'Tráfego'},
          {t:'Identidade Banca de Síndicos v3',o:'Henrique',c:'Banca de Síndicos',p:'high',tag:'Design'},
          {t:'Cronograma Rentalsul — junho',o:'Fran',c:'Rentalsul',p:'med',tag:'Planejamento'},
          {t:'Roteiro Eucassel',o:'Gabi',c:'Eucassel',p:'low',tag:'Estratégia'},
        ])}
        ${dashListCard('Aprovações','✓','clientes',[
          {t:'3 carrosséis + 5 stories',o:'',c:'Marmitina',p:'urgent',tag:'Conteúdo'},
          {t:'Reels — campanha junho',o:'',c:'Pro4saúde',p:'high',tag:'Vídeo'},
          {t:'Identidade visual v3',o:'',c:'Banca de Síndicos',p:'high',tag:'Branding'},
          {t:'Apresentação institucional',o:'',c:'Natacenter',p:'med',tag:'Design'},
          {t:'Look book outono',o:'',c:'Franci',p:'med',tag:'Conteúdo'},
        ])}
      </div>

      <div class="grid-2e">
        ${dashListCard('Reuniões','📹','reunioes',[
          {t:'Diagnóstico — Concept',o:'Éllen, Gabi',c:'Concept',p:'high',tag:'10:30 · Google Meet'},
          {t:'Apresentação — Eucassel',o:'Éllen, Gabi',c:'Eucassel',p:'high',tag:'14:30 · Zoom'},
          {t:'Alinhamento — Aquassafe',o:'Éllen, Julia',c:'Aquassafe',p:'med',tag:'amanhã 10:00'},
          {t:'Brainstorm — Marmitina',o:'Gabi, Heidy',c:'Marmitina',p:'med',tag:'20/mai 15:00'},
          {t:'Fechamento — Steel Desk',o:'Éllen, Letícia',c:'Steel Desk',p:'high',tag:'22/mai 11:00'},
        ])}
        ${dashListCard('Captações','🎬','captacao',captacoes.filter(c=>['agendada','confirmada','em andamento'].includes(c.status)).map(cap=>({
          t:cap.type,o:cap.resp,c:cap.client,p:cap.priority,tag:`${cap.date.split('-').reverse().slice(0,2).join('/')} · ${cap.time}`
        })))}
      </div>

      <div class="grid-3">
        <div class="card">
          <div class="card-header"><div class="card-title">📅 Vencimentos internos</div><span class="card-link" onclick="goTo('financeiro')">Financeiro</span></div>
          ${[
            {t:'Aluguel da sede',d:'20 mai',v:4500,p:'high'},
            {t:'Salários — folha mai',d:'25 mai',v:48700,p:'urgent'},
            {t:'Adobe Creative Cloud',d:'27 mai',v:520,p:'low'},
            {t:'Pró-labore sócios',d:'30 mai',v:18000,p:'high'},
            {t:'Impostos (Simples)',d:'05 jun',v:3500,p:'med'},
          ].map(v=>`
            <div class="list-item">
              ${prioBadge(v.p)}
              <div class="list-content" style="margin-left:4px"><div class="list-title">${v.t}</div><div class="list-meta">Vence em ${v.d}</div></div>
              <div class="list-right"><strong>R$ ${v.v.toLocaleString('pt-BR')}</strong></div>
            </div>
          `).join('')}
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">🏖 Férias</div><span class="card-link" onclick="goTo('equipe')">Ver tudo</span></div>
          ${team.filter(m=>{const months=Math.floor((Date.now()-new Date(m.since))/(1000*60*60*24*30));return months>10&&m.vacationUsed===0}).slice(0,3).map(m=>`
            <div class="list-item">
              <div class="avatar" style="background:${m.color}">${m.init}</div>
              <div class="list-content"><div class="list-title">${m.name}</div><div class="list-meta">Programar nos próximos 60 dias</div></div>
              <div class="list-right"><span class="badge b-warning">⚠ Programar</span></div>
            </div>
          `).join('')}
          <div class="list-item">
            <div class="list-icon">📅</div>
            <div class="list-content"><div class="list-title">Letícia agendou férias</div><div class="list-meta">15 jul → 30 jul · 15 dias</div></div>
            <div class="list-right"><span class="badge b-info">Programada</span></div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">🎂 Aniversários</div></div>
          ${[
            {n:'Natacenter',d:'19 mai',t:'Cliente'},
            {n:'Henrique Lima',d:'20 mai',t:'Equipe'},
            {n:'Steel Desk',d:'22 mai',t:'Aniv. contrato'},
            {n:'Julia Ferreira',d:'24 mai',t:'Equipe'},
            {n:'Aquassafe',d:'28 mai',t:'Aniv. contrato'},
          ].map(a=>`
            <div class="list-item">
              <div class="list-icon">🎂</div>
              <div class="list-content"><div class="list-title">${a.n}</div><div class="list-meta">${a.t}</div></div>
              <div class="list-right"><span class="badge b-pink">${a.d}</span></div>
            </div>
          `).join('')}
        </div>
      </div>

      <div class="grid-2e">
        <div class="card">
          <div class="card-header"><div class="card-title">⚠ Pendências operacionais</div></div>
          ${[
            {t:'Steel Desk — pagamento atrasado 3 dias',p:'urgent',tag:'Financeiro'},
            {t:'4 conteúdos Marmitina sem aprovação há 5 dias',p:'high',tag:'Conteúdo'},
            {t:'Contrato Concept vence em 12 dias',p:'high',tag:'Comercial'},
            {t:'Auto Veloz pausado há 18 dias',p:'med',tag:'Cliente'},
            {t:'3 tarefas atrasadas — Henrique',p:'med',tag:'Operacional'},
          ].map(p=>`
            <div class="list-item">
              ${prioBadge(p.p)}
              <div class="list-content" style="margin-left:4px"><div class="list-title">${p.t}</div></div>
              <div class="list-right"><span class="badge b-default">${p.tag}</span></div>
            </div>
          `).join('')}
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">🔔 Notificações & alertas</div><span class="card-link" onclick="goTo('automacao')">Automações</span></div>
          ${[
            {t:'🎬 Captação Aquassafe em 2 dias — confirmar',p:'urgent',tag:'Captação'},
            {t:'📈 Sugestão de upsell — Aquassafe (3 meses no plano)',p:'high',tag:'Comercial'},
            {t:'📜 Renovação contrato Aquassafe em 30 dias',p:'med',tag:'Comercial'},
            {t:'👥 Revisão trimestral da equipe — 15 jun',p:'med',tag:'RH'},
            {t:'💾 Backup automático realizado às 03:00',p:'low',tag:'Sistema'},
          ].map(a=>`
            <div class="list-item">
              ${prioBadge(a.p)}
              <div class="list-content" style="margin-left:4px"><div class="list-title">${a.t}</div></div>
              <div class="list-right"><span class="badge b-default">${a.tag}</span></div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
  `;
}

function dashListCard(title,icon,pageId,items){
  const filtered = items.filter(it=>{
    if(dashFilter.prio!=='all' && it.p!==dashFilter.prio) return false;
    if(dashFilter.collab!=='all' && it.o && !it.o.includes(dashFilter.collab)) return false;
    if(dashFilter.client!=='all' && it.c!==dashFilter.client) return false;
    return true;
  });
  return `
    <div class="card">
      <div class="card-header"><div class="card-title">${icon} ${title} <span class="badge b-default" style="margin-left:6px">${filtered.length}</span></div><span class="card-link" onclick="goTo('${pageId}')">Ver tudo</span></div>
      ${filtered.length===0?'<div class="text-mu text-sm">Nenhum item nos filtros atuais.</div>':filtered.map(it=>`
        <div class="list-item">
          ${prioBadge(it.p)}
          <div class="list-content" style="margin-left:4px">
            <div class="list-title">${it.t}</div>
            <div class="list-meta">${it.c}${it.o?' · '+it.o:''}</div>
          </div>
          <div class="list-right"><span class="badge b-default">${it.tag}</span></div>
        </div>
      `).join('')}
    </div>
  `;
}

function statCard(label,value,sub,iconPath,extra,color){
  const colorClass = color==='warning'?'style="background:var(--warning-soft);color:var(--warning-text)"':color==='pink'?'style="background:var(--pink-soft);color:var(--pink-text)"':'';
  return `
    <div class="stat">
      <div class="stat-head">
        <div class="stat-label">${label}</div>
        <div class="stat-icon" ${colorClass}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${iconPath}"/></svg></div>
      </div>
      <div class="stat-value">${value}</div>
      <div class="stat-sub">${sub}</div>
      ${extra?`<div class="mt-3">${extra}</div>`:''}
    </div>
  `;
}
function progress(done,total){
  const pct = Math.round(done/total*100);
  return `<div class="meter"><div class="meter-fill" style="width:${pct}%"></div></div><div class="text-xs text-3" style="margin-top:4px">${pct}% concluído</div>`;
}

