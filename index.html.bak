}

function paneAcessos(cli){
  const acessos = getAcessos(cli.name);
  return `
    <div class="modal-pane" data-pane="acessos">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
        <div>
          <div style="font-size:14px;font-weight:600">🔐 Acessos & credenciais</div>
          <div class="text-xs text-3" style="margin-top:3px">Todos os dados são criptografados e auditados</div>
        </div>
        <div style="display:flex;gap:7px">
          <button class="btn btn-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4M12 1l9 4v6c0 5.55-3.84 10.74-9 12-5.16-1.26-9-6.45-9-12V5l9-4z"/></svg>Permissões</button>
          <button class="btn btn-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Histórico</button>
          <button class="btn btn-primary btn-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>Adicionar</button>
        </div>
      </div>

      ${acessos.map(grp=>`
        <div class="section-title" style="margin-top:14px">${grp.cat}</div>
        ${grp.items.map(a=>`
          <div class="acesso-card">
            <div class="acesso-platform">${a.icon}</div>
            <div class="acesso-info">
              <div class="acesso-name">${a.plat}</div>
              <div class="acesso-login">${a.login}</div>
            </div>
            <div class="acesso-pwd" id="pwd-${cli.id}-${grp.cat.replace(/\s/g,'')}-${a.plat.replace(/\s/g,'')}" data-real="senha_${a.plat.toLowerCase().replace(/\s/g,'')}_2026!">
              ${a.pwd}
            </div>
            <div class="acesso-actions">
              <button class="icon-btn" title="Mostrar/ocultar senha" onclick="togglePwd('pwd-${cli.id}-${grp.cat.replace(/\s/g,'')}-${a.plat.replace(/\s/g,'')}',this)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
              <button class="icon-btn" title="Copiar senha" onclick="copyPwd('pwd-${cli.id}-${grp.cat.replace(/\s/g,'')}-${a.plat.replace(/\s/g,'')}')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
              <button class="icon-btn" title="Copiar login" onclick="copy('${a.login}','Login')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 12H8M12 16V8"/><circle cx="12" cy="12" r="10"/></svg>
              </button>
              <button class="icon-btn" title="Abrir plataforma" onclick="openLink('https://${a.plat.toLowerCase().replace(/[^a-z]/g,'')}.com')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14L21 3M21 3v7M21 3h-7M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
              </button>
            </div>
          </div>
        `).join('')}
      `).join('')}

      <div class="card mt-4" style="border-left:3px solid var(--info)">
        <div class="card-header" style="margin-bottom:8px"><div class="card-title">📜 Histórico de alterações</div></div>
        <div class="text-xs text-mu">Última alteração de senha: <strong>há 12 dias</strong> · Próxima rotação sugerida: <strong>em 78 dias</strong></div>
      </div>
    </div>
  `;
}

function togglePwd(id,btn){
  const el = document.getElementById(id);
  if(el.dataset.shown==='1'){
    el.textContent='••••••••••';
    el.dataset.shown='0';
  } else {
    el.textContent = el.dataset.real;
    el.dataset.shown='1';
  }
}
function copyPwd(id){
  const el = document.getElementById(id);
  copy(el.dataset.real,'Senha');
}

function paneJornada(cli){
  const stage = Math.floor(Math.random()*8)+10;
  return `
    <div class="modal-pane" data-pane="jornada">
      <div class="text-mu text-sm mb-4">Cliente na etapa <strong style="color:var(--text)">${stage} — ${journey[stage-1]}</strong></div>
      <div style="display:flex;gap:5px;overflow-x:auto;padding:6px 0;margin-bottom:18px">
        ${journey.map((s,i)=>{
          const cls = i+1<stage?'b-success':i+1===stage?'b-info':'b-default';
          return `<div class="badge ${cls}" style="white-space:nowrap;padding:6px 11px;min-width:130px;justify-content:center">${i+1<stage?'✓ ':''}${s}</div>`;
        }).join('')}
      </div>

      <div class="card mb-4">
        <div class="card-header"><div class="card-title">Etapa atual — ${journey[stage-1]}</div><span class="badge b-info">Em andamento</span></div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Responsável</div><div class="info-value">${cli.owner}</div></div>
          <div class="info-item"><div class="info-label">Prazo</div><div class="info-value">22 mai 2026</div></div>
          <div class="info-item"><div class="info-label">Status</div><div class="info-value">No prazo</div></div>
          <div class="info-item"><div class="info-label">Anexos</div><div class="info-value">3 arquivos</div></div>
        </div>
        <div class="section-title">Checklist</div>
        ${['Reunião de alinhamento agendada','Briefing inicial preenchido','Acessos recebidos','Aprovação de identidade','Calendário do mês definido'].map((t,i)=>`
          <label style="display:flex;gap:10px;align-items:center;padding:8px 0;font-size:13px;cursor:pointer">
            <div class="check-box ${i<3?'checked':''}" onclick="this.classList.toggle('checked')"></div>
            <span style="${i<3?'text-decoration:line-through;color:var(--text-3)':''}">${t}</span>
          </label>
        `).join('')}
      </div>
    </div>
  `;
}

