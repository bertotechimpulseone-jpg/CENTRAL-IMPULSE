      <div style="flex:1"><div style="font-size:17px;font-weight:700">Clientes exclusivos de orçamento</div><div class="text-xs text-3" style="margin-top:3px">Leads ou prospects que não são clientes do CRM ainda</div></div>
      <button class="modal-close" onclick="closeModal();renderComercial(document.getElementById('content'))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div id="bgcliList">
        ${_budgetClients.length===0?'<div class="empty-state"><div class="ico">👤</div><div class="ttl">Nenhum cliente exclusivo</div><div class="desc">Use o form abaixo pra adicionar</div></div>':_budgetClients.map(c=>`
          <div class="card mb-2" style="padding:11px;display:flex;align-items:center;gap:10px" id="bgclirow-${c.id}">
            <div style="width:32px;height:32px;border-radius:50%;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700;font-size:12px">${(c.name[0]||'?').toUpperCase()}</div>
            <div style="flex:1">
              <div style="font-size:13px;font-weight:600">${c.name}</div>
              <div class="text-xs text-3">${c.email||'sem email'} · ${c.phone||'sem telefone'}</div>
            </div>
            <button class="icon-btn" style="color:var(--danger)" onclick="deleteBgCli('${c.id}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>
          </div>
        `).join('')}
      </div>
      <div class="card mt-3" style="background:var(--surface-2);padding:14px">
        <div class="card-title" style="margin-bottom:10px">+ Novo cliente exclusivo</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
          <input id="bgcliName" class="login-input" placeholder="Nome / Razão Social *" style="background:var(--surface);grid-column:span 2" />
          <input id="bgcliCnpj" class="login-input" placeholder="CNPJ/CPF" style="background:var(--surface)" />
          <input id="bgcliPhone" class="login-input" placeholder="Telefone" style="background:var(--surface)" />
          <input id="bgcliEmail" class="login-input" placeholder="Email" style="background:var(--surface)" />
          <input id="bgcliAddr" class="login-input" placeholder="Endereço" style="background:var(--surface)" />
        </div>
        <button class="btn btn-primary" style="margin-top:10px;width:100%" onclick="addBgCli()">+ Adicionar cliente</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

function abrirNovoClienteOrc(){
  abrirGerenciarClientes();
}

async function addBgCli(){
  const name = document.getElementById('bgcliName').value.trim();
  if(!name){toast('Informe o nome','info');return}
  const payload = {
    name,
    cnpj: document.getElementById('bgcliCnpj').value.trim(),
    phone: document.getElementById('bgcliPhone').value.trim(),
    email: document.getElementById('bgcliEmail').value.trim(),
    address: document.getElementById('bgcliAddr').value.trim()
  };
  if(!_supa){toast('Banco necessário','info');return}
  const { data } = await _supa.from('budget_clients').insert(payload).select().single();
  if(data){
    _budgetClients.push(data);
    toast('✓ Cliente adicionado','success');
    abrirGerenciarClientes();
  }
}

async function deleteBgCli(id){
  if(!confirm('Excluir este cliente?')) return;
  if(_supa) await _supa.from('budget_clients').delete().eq('id', id);
  _budgetClients = _budgetClients.filter(x=>x.id!==id);
  document.getElementById('bgclirow-'+id)?.remove();
  toast('Excluído','success');
}





let _budgetServices = [];  // lista de servicos padrao (do banco)
let _budgetClients = [];   // clientes exclusivos de orcamento

async function loadBudgetServices(){
  if(!_supa){
    _budgetServices = [
      {id:'mock1',name:'Gestão de rede social',value:1800,position:1},
      {id:'mock2',name:'Design fixo',value:1200,position:2},
      {id:'mock3',name:'Tráfego pago',value:2200,position:3},
      {id:'mock4',name:'Vídeos',value:1800,position:4},
      {id:'mock5',name:'Captação',value:2500,position:5},
      {id:'mock6',name:'Branding',value:4500,position:6},
      {id:'mock7',name:'Campanhas',value:3200,position:7},
      {id:'mock8',name:'Consultoria',value:1500,position:8}
    ];
    return;
  }
  try {
    const { data } = await _supa.from('budget_services').select('*').eq('active', true).order('position');
    _budgetServices = data || [];
  } catch(e){ console.warn('[Serv] load:', e) }
}

async function loadBudgetClients(){
  if(!_supa) return;
  try {
    const { data } = await _supa.from('budget_clients').select('*').order('name');
    _budgetClients = data || [];
  } catch(e){ console.warn('[BCli] load:', e) }
}


async function loadOrcamentosSalvos(){
  if(!_supa) return;
  try {
    const { data } = await _supa.from('budgets').select('*').order('created_at',{ascending:false}).limit(50);
    if(data){
      const prev = orcamentosSalvos.length;
      orcamentosSalvos = data;
      // Re-renderiza se a quantidade mudou (evita loop infinito)
      if(data.length !== prev && comTab === 'orcamento'){
        renderComercial(document.getElementById('content'));
      }
    }
  } catch(e){ console.warn('[Orc] load:', e) }
}


function addItemOrc(desc, valor){
  orcamento.itens.push({desc: desc||'', qtd: 1, valor: valor||0});
  renderComercial(document.getElementById('content'));
}

function carregarClienteOrc(){
  const opt = clients.map(c=>c.name).join('|');
  const escolhido = prompt('Digite o nome exato do cliente (ou parte dele):\n\n'+clients.map(c=>'• '+c.name).join('\n'));
  if(!escolhido) return;
  const cli = clients.find(c => c.name.toLowerCase().includes(escolhido.toLowerCase()));
  if(!cli){toast('Cliente não encontrado','info');return}
  orcamento.cliente.nome = cli.name;
  orcamento.cliente.email = cli.email||'';
  orcamento.cliente.telefone = cli.phone||'';
  toast(`Dados de ${cli.name} importados`,'success');
  renderComercial(document.getElementById('content'));
}

function limparOrcamento(){
  orcamento = {
    id: null,
    numero: 'ORC-' + String(Date.now()).slice(-6),
    data: new Date().toISOString().split('T')[0],
    validade: new Date(Date.now() + 30*86400000).toISOString().split('T')[0],
    cliente: {nome:'', cnpj:'', endereco:'', email:'', telefone:'', logo:''},
    itens: [], desconto: 0, descontoTipo: 'valor',
    formaPagamento: 'PIX à vista ou 2x no cartão sem juros',
    prazoEntrega: '30 dias após aprovação',
    observacoes: 'Orçamento válido por 30 dias.', termos: ''
  };
  renderComercial(document.getElementById('content'));
  toast('Orçamento limpo','success');
}

async function salvarOrcamento(statusOverride){
  console.log('[ORC SAVE] Iniciando salvamento...');
  if(!orcamento.cliente.nome){toast('Informe o nome do cliente','info');console.warn('[ORC SAVE] sem nome cliente');return}
  if(orcamento.itens.length===0){toast('Adicione pelo menos um item','info');console.warn('[ORC SAVE] sem itens');return}
  if(!_supa){toast('Supabase não conectado','info');console.error('[ORC SAVE] _supa null');return}

  const subtotal = orcamento.itens.reduce((s,i)=>s+(i.qtd||1)*i.valor,0);
  const descontoVal = orcamento.descontoTipo==='percentual' ? subtotal*(orcamento.desconto/100) : (orcamento.desconto||0);
  const total = Math.max(0, subtotal - descontoVal);

  // Payload completo
  let payload = {
    numero: orcamento.numero || 'ORC-' + Date.now(),
    services: orcamento.itens,
    total: total,
    deadline: orcamento.prazoEntrega || '30 dias',
    conditions: orcamento.formaPagamento || '',
    client_data: orcamento.cliente,
    discount: orcamento.desconto || 0,
    payment_method: orcamento.formaPagamento || '',
    delivery_time: orcamento.prazoEntrega || '',
    observations: orcamento.observacoes || '',
    valid_until: orcamento.validade || null,
    status: statusOverride || 'enviado'
  };
  console.log('[ORC SAVE] Payload:', payload);

  try {
    let result;
    if(orcamento.id){
      console.log('[ORC SAVE] UPDATE id:', orcamento.id);
      result = await _supa.from('budgets').update(payload).eq('id', orcamento.id).select();
    } else {
      console.log('[ORC SAVE] INSERT novo');
      result = await _supa.from('budgets').insert(payload).select().single();
    }
    if(result.error){
      console.error('[ORC SAVE] ERRO Supabase:', result.error);
      // Se erro for coluna inexistente, tenta payload minimo
      if(result.error.message && result.error.message.includes('column')){
        console.warn('[ORC SAVE] Tentando payload minimo (algumas colunas nao existem)');
        const minPayload = {
          services: orcamento.itens,
          total: total,
          deadline: payload.deadline,
          conditions: 'CLIENTE: ' + (orcamento.cliente.nome||'sem nome') + ' | ' + (payload.conditions||'')
        };
        const result2 = await _supa.from('budgets').insert(minPayload).select().single();
        if(result2.error){
          toast('Erro ao salvar: ' + result2.error.message, 'info');
          console.error('[ORC SAVE] Erro 2:', result2.error);
          alert('FALHA AO SALVAR\n\nErro do banco: ' + result2.error.message + '\n\nProvavelmente faltam colunas. Rode o SQL "10-orcamento.sql" no Supabase.');
          return;
        }
        if(result2.data){
          toast('✓ Salvo (modo simplificado - rode 10-orcamento.sql pra completar)','success');
          orcamento.id = null;
          orcamento.numero = 'ORC-' + String(Date.now()).slice(-6);
        }
      } else {
        toast('Erro ao salvar: ' + result.error.message, 'info');
        alert('FALHA AO SALVAR\n\nErro: ' + result.error.message + '\n\nCole esse erro no chat pra eu ajudar.');
        return;
      }
    } else {
      const data = result.data;
      if(data && data.id){
        const savedId = data.id;
        console.log('[ORC SAVE] SUCESSO id:', savedId);
        toast('✓ Orçamento salvo (próximo clique em Salvar cria NOVO)','success');
        // RESETA id pra próximo save criar novo orçamento
        orcamento.id = null;
        // Gera novo numero pra próximo
        orcamento.numero = 'ORC-' + String(Date.now()).slice(-6);
      } else if(data){
        // update retorna array
        console.log('[ORC SAVE] update retornou:', data);
        toast('✓ Orçamento atualizado','success');
      }
    }
    await loadOrcamentosSalvos();
    console.log('[ORC SAVE] Total no banco agora:', orcamentosSalvos.length);
  } catch(e){
    console.error('[ORC SAVE] Exception:', e);
    toast('Erro: ' + e.message, 'info');
    alert('EXCEÇÃO AO SALVAR\n\n' + e.message);
  }
}

async function carregarOrcSalvo(id){
  const b = orcamentosSalvos.find(x=>x.id===id);
  if(!b) return;
  // Tentar extrair cliente de varias fontes
  let cliente = b.client_data;
  if(!cliente || !cliente.nome){
    const cliFromConditions = b.conditions && b.conditions.startsWith('CLIENTE:') ? b.conditions.split('|')[0].replace('CLIENTE:','').trim() : '';
    cliente = {nome: cliFromConditions, cnpj:'', endereco:'', email:'', telefone:'', logo:''};
  }
  orcamento = {
    id: b.id,
    numero: b.numero || 'ORC-'+id.slice(0,6),
    data: b.created_at.split('T')[0],
    validade: b.valid_until || new Date(Date.now()+30*86400000).toISOString().split('T')[0],
    cliente: cliente,
    itens: b.services || [],
    desconto: parseFloat(b.discount)||0,
    descontoTipo: 'valor',
    formaPagamento: b.payment_method || b.conditions || '',
    prazoEntrega: b.delivery_time || b.deadline || '',
    observacoes: b.observations || '',
    termos: ''
  };
  toast('Orçamento carregado','success');
  renderComercial(document.getElementById('content'));
}

async function excluirOrcSalvo(id){
  if(!confirm('Excluir este orçamento?')) return;
  await _supa.from('budgets').delete().eq('id', id);
  toast('Orçamento excluído','success');
  renderComercial(document.getElementById('content'));
}

function gerarPDFOrcamento(){
  if(!orcamento.cliente.nome){toast('Informe o nome do cliente antes de gerar o PDF','info');return}
  if(orcamento.itens.length===0){toast('Adicione pelo menos um item','info');return}
  if(!window.jspdf){toast('Biblioteca PDF não carregou. Recarregue a página.','info');return}
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();
  let y = 20;
  // Cabeçalho - logo IMPULSE ONE
  doc.setFillColor(29, 29, 31);
  doc.rect(15, 15, 12, 12, 'F');
  doc.setTextColor(255,255,255);
  doc.setFontSize(8);
  doc.setFont('helvetica','bold');
  doc.text('i1', 21, 22, {align:'center'});
  doc.setTextColor(29, 29, 31);
  doc.setFontSize(20);
  doc.text('IMPULSE ONE', 32, 23);
  doc.setFontSize(9);
  doc.setFont('helvetica','normal');
  doc.setTextColor(110,110,115);
  doc.text('Central da Agência · contato@impulseone.com.br', 32, 28);
  // Título orçamento
  y = 45;
  doc.setTextColor(29,29,31);
  doc.setFontSize(16);
  doc.setFont('helvetica','bold');
  doc.text('ORÇAMENTO ' + orcamento.numero, 15, y);
  doc.setFont('helvetica','normal');
  doc.setFontSize(10);
  doc.text('Emitido em: ' + new Date(orcamento.data).toLocaleDateString('pt-BR'), 15, y+7);
  doc.text('Válido até: ' + new Date(orcamento.validade).toLocaleDateString('pt-BR'), 15, y+12);
  // Cliente
  y = 70;
  doc.setFillColor(245,245,247);
  doc.rect(15, y, 180, 30, 'F');
  doc.setFont('helvetica','bold');
  doc.setFontSize(10);
  doc.text('CLIENTE', 20, y+6);
  doc.setFont('helvetica','normal');
  doc.setFontSize(11);
  doc.text(orcamento.cliente.nome, 20, y+13);
  doc.setFontSize(9);
  doc.setTextColor(110,110,115);
  let cliInfo = [];
  if(orcamento.cliente.cnpj) cliInfo.push('CNPJ/CPF: '+orcamento.cliente.cnpj);
  if(orcamento.cliente.email) cliInfo.push('Email: '+orcamento.cliente.email);
  if(orcamento.cliente.telefone) cliInfo.push('Tel: '+orcamento.cliente.telefone);
  if(orcamento.cliente.endereco) cliInfo.push(orcamento.cliente.endereco);
  doc.text(cliInfo.join(' · '), 20, y+19);
  // Itens - tabela
  y = 110;
  doc.setTextColor(29,29,31);
  doc.setFont('helvetica','bold');
  doc.setFontSize(10);
  doc.setFillColor(29,29,31);
  doc.rect(15, y-5, 180, 8, 'F');
  doc.setTextColor(255,255,255);
  doc.text('Descrição', 17, y);
  doc.text('Qtd', 130, y);
  doc.text('Valor unit.', 145, y);
  doc.text('Subtotal', 175, y);
  doc.setTextColor(29,29,31);
  doc.setFont('helvetica','normal');
  y += 8;
  orcamento.itens.forEach((it, idx) => {
    const sub = it.qtd * it.valor;
    if(idx % 2 === 0){
      doc.setFillColor(250,250,250);
      doc.rect(15, y-4, 180, 7, 'F');
    }
    doc.setFontSize(9);
    const descLines = doc.splitTextToSize(it.desc||'(sem descrição)', 105);
    doc.text(descLines, 17, y);
    doc.text(String(it.qtd), 130, y);
    doc.text('R$ ' + it.valor.toLocaleString('pt-BR',{minimumFractionDigits:2}), 145, y);
    doc.text('R$ ' + sub.toLocaleString('pt-BR',{minimumFractionDigits:2}), 175, y);
    y += 7 * Math.max(descLines.length, 1);
  });
  // Totais
  y += 10;
  const totalBruto = orcamento.itens.reduce((s,i)=>s+(i.qtd*i.valor),0);
  const descontoVal = orcamento.descontoTipo==='percentual' ? totalBruto*(orcamento.desconto/100) : orcamento.desconto;
  const total = totalBruto - descontoVal;
  doc.setFontSize(10);
  doc.text('Subtotal:', 140, y);
  doc.text('R$ ' + totalBruto.toLocaleString('pt-BR',{minimumFractionDigits:2}), 195, y, {align:'right'});
  if(descontoVal > 0){
    y += 6;
    doc.setTextColor(180,40,40);
    doc.text('Desconto:', 140, y);
    doc.text('− R$ ' + descontoVal.toLocaleString('pt-BR',{minimumFractionDigits:2}), 195, y, {align:'right'});
    doc.setTextColor(29,29,31);
  }
  y += 8;
  doc.setFont('helvetica','bold');
  doc.setFontSize(13);
  doc.setFillColor(29,29,31);
  doc.rect(135, y-5, 60, 9, 'F');
  doc.setTextColor(255,255,255);
  doc.text('TOTAL: R$ ' + total.toLocaleString('pt-BR',{minimumFractionDigits:2}), 192, y, {align:'right'});
  doc.setTextColor(29,29,31);
  doc.setFont('helvetica','normal');
  // Condições
  y += 18;
  doc.setFontSize(9);
  doc.setFont('helvetica','bold');
  doc.text('CONDIÇÕES', 15, y);
  doc.setFont('helvetica','normal');
  y += 5;
  doc.setTextColor(110,110,115);
  if(orcamento.formaPagamento){ doc.text('Forma de pagamento: ' + orcamento.formaPagamento, 15, y); y += 5; }
  if(orcamento.prazoEntrega){ doc.text('Prazo de entrega: ' + orcamento.prazoEntrega, 15, y); y += 5; }
  if(orcamento.observacoes){
    y += 3;
    const obsLines = doc.splitTextToSize('Observações: '+orcamento.observacoes, 180);
    doc.text(obsLines, 15, y);
  }
  // Rodapé
  doc.setFontSize(8);
  doc.setTextColor(160,160,165);
  doc.text('IMPULSE ONE · Central da Agência', 15, 285);
  doc.text('Gerado em ' + new Date().toLocaleDateString('pt-BR') + ' ' + new Date().toLocaleTimeString('pt-BR'), 195, 285, {align:'right'});
  // Salvar
  const fileName = 'orcamento-' + orcamento.numero + '-' + orcamento.cliente.nome.replace(/[^a-zA-Z0-9]/g,'_') + '.pdf';
  doc.save(fileName);
  toast('✓ PDF gerado: '+fileName, 'success');
  // Auto-salvar no banco com status enviado
  setTimeout(()=>salvarOrcamento('enviado'), 200);
}



// ============ HISTORICO DE ORÇAMENTOS ============
let _histFilters = {ano: new Date().getFullYear(), mes: 'all', status: 'all', cliente: 'all'};
let _histChart = null;

function renderHistoricoOrcamentos(){
  // Carrega em background e re-renderiza
  setTimeout(()=>loadOrcamentosSalvos(), 50);

  // Filtros aplicados
  const filtered = orcamentosSalvos.filter(b => {
    const d = new Date(b.created_at);
    if(_histFilters.ano !== 'all' && d.getFullYear() !== parseInt(_histFilters.ano)) return false;
    if(_histFilters.mes !== 'all' && d.getMonth() !== parseInt(_histFilters.mes)) return false;
    if(_histFilters.status !== 'all' && b.status !== _histFilters.status) return false;
    if(_histFilters.cliente !== 'all' && (b.client_data?.nome||'') !== _histFilters.cliente) return false;
    return true;
  });

  // Estatísticas
  const totalEnv = filtered.length;
  const aprovados = filtered.filter(b => b.status === 'aprovado').length;
  const recusados = filtered.filter(b => b.status === 'recusado').length;
  const pendentes = filtered.filter(b => !b.status || b.status === 'enviado' || b.status === 'rascunho').length;
  const valorTotal = filtered.reduce((s,b) => s + parseFloat(b.total||0), 0);
  const valorAprovado = filtered.filter(b => b.status === 'aprovado').reduce((s,b) => s + parseFloat(b.total||0), 0);
  const taxaConv = totalEnv > 0 ? (aprovados / totalEnv * 100).toFixed(1) : '0';

  // Anos disponíveis
  const anosDisponiveis = [...new Set(orcamentosSalvos.map(b => new Date(b.created_at).getFullYear()))].sort().reverse();
  if(anosDisponiveis.length === 0) anosDisponiveis.push(new Date().getFullYear());
  // Clientes únicos
  const clientesUnicos = [...new Set(orcamentosSalvos.map(b => b.client_data?.nome||'').filter(n=>n))].sort();

  setTimeout(() => desenharGraficoHistorico(filtered), 100);

  return `
    <div class="stat-grid">
      ${statCard('Enviados', totalEnv, _histFilters.ano + (_histFilters.mes!=='all' ? ' · ' + ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'][parseInt(_histFilters.mes)] : ''), 'M22 12h-4l-3 9L9 3l-3 9H2')}
      ${statCard('Aprovados', aprovados, 'fecharam contrato', 'M9 11l3 3L22 4')}
      ${statCard('Recusados', recusados, 'não fecharam', 'M5 12h14', null, 'warning')}
      ${statCard('Taxa conversão', taxaConv + '%', aprovados + ' de ' + totalEnv, 'M22 12h-4l-3 9L9 3l-3 9H2')}
      ${statCard('Valor total', 'R$ ' + valorTotal.toLocaleString('pt-BR',{maximumFractionDigits:0}), 'em propostas', 'M12 1v22')}
      ${statCard('Valor aprovado', 'R$ ' + valorAprovado.toLocaleString('pt-BR',{maximumFractionDigits:0}), 'fechado', 'M22 12h-4l-3 9L9 3l-3 9H2')}
    </div>

    <div class="card mb-3">
      <div class="card-header"><div class="card-title">🔍 Filtros</div><div style="display:flex;gap:6px"><button class="btn btn-sm" onclick="refreshHistorico()">🔄 Atualizar do banco</button><button class="btn btn-sm" onclick="_histFilters={ano:new Date().getFullYear(),mes:'all',status:'all',cliente:'all'};renderComercial(document.getElementById('content'))">Limpar filtros</button></div></div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px">
        <div>
          <div class="info-label" style="margin-bottom:4px">Ano</div>
          <select class="login-input" style="background:var(--surface-2)" onchange="_histFilters.ano=this.value==='all'?'all':parseInt(this.value);renderComercial(document.getElementById('content'))">
            <option value="all" ${_histFilters.ano==='all'?'selected':''}>Todos os anos</option>
            ${anosDisponiveis.map(a=>`<option value="${a}" ${_histFilters.ano==a?'selected':''}>${a}</option>`).join('')}
          </select>
        </div>
        <div>
          <div class="info-label" style="margin-bottom:4px">Mês</div>
          <select class="login-input" style="background:var(--surface-2)" onchange="_histFilters.mes=this.value;renderComercial(document.getElementById('content'))">
            <option value="all" ${_histFilters.mes==='all'?'selected':''}>Todos os meses</option>
            ${['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'].map((m,i)=>`<option value="${i}" ${_histFilters.mes==i?'selected':''}>${m}</option>`).join('')}
          </select>
        </div>
        <div>
          <div class="info-label" style="margin-bottom:4px">Status</div>
          <select class="login-input" style="background:var(--surface-2)" onchange="_histFilters.status=this.value;renderComercial(document.getElementById('content'))">
            <option value="all" ${_histFilters.status==='all'?'selected':''}>Todos os status</option>
            <option value="rascunho" ${_histFilters.status==='rascunho'?'selected':''}>📝 Rascunho</option>
            <option value="enviado" ${_histFilters.status==='enviado'?'selected':''}>📤 Enviado</option>
            <option value="aprovado" ${_histFilters.status==='aprovado'?'selected':''}>✅ Aprovado</option>
            <option value="recusado" ${_histFilters.status==='recusado'?'selected':''}>❌ Recusado</option>
            <option value="expirado" ${_histFilters.status==='expirado'?'selected':''}>⏰ Expirado</option>
          </select>
        </div>
        <div>
          <div class="info-label" style="margin-bottom:4px">Cliente</div>
          <select class="login-input" style="background:var(--surface-2)" onchange="_histFilters.cliente=this.value;renderComercial(document.getElementById('content'))">
            <option value="all" ${_histFilters.cliente==='all'?'selected':''}>Todos os clientes</option>
            ${clientesUnicos.map(c=>`<option value="${c}" ${_histFilters.cliente===c?'selected':''}>${c}</option>`).join('')}
          </select>
        </div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><div class="card-title">📊 Orçamentos por mês — ${_histFilters.ano}</div></div>
      <div class="chart-box" style="height:280px"><canvas id="histChart"></canvas></div>
    </div>

    <div class="card">
      <div class="card-header"><div class="card-title">📋 Lista de orçamentos</div><span class="badge b-default">${filtered.length} registros</span></div>
      ${filtered.length === 0 ? `<div class="empty-state"><div class="ico">📭</div><div class="ttl">Nenhum orçamento encontrado</div><div class="desc">${orcamentosSalvos.length===0?'Crie um orçamento na aba Orçamento — ele aparece aqui automaticamente':'Ajuste os filtros — você tem '+orcamentosSalvos.length+' orçamento(s) no total'}</div><button class="btn btn-primary mt-3" onclick="refreshHistorico()" style="margin-top:14px">🔄 Recarregar do banco</button></div>` : `
        <div style="overflow-x:auto"><table class="table">
          <thead><tr><th>Data</th><th>Número</th><th>Cliente</th><th>Itens</th><th>Total</th><th>Status</th><th>Ações</th></tr></thead>
          <tbody>
            ${filtered.sort((a,b)=>new Date(b.created_at)-new Date(a.created_at)).map(b => {
              const d = new Date(b.created_at);
              const dataStr = d.toLocaleDateString('pt-BR');
              const cli = b.client_data?.nome || (b.conditions && b.conditions.startsWith('CLIENTE:') ? b.conditions.split('|')[0].replace('CLIENTE:','').trim() : '(sem cliente)');
              const itens = b.services?.length || 0;
              const total = parseFloat(b.total||0).toLocaleString('pt-BR', {minimumFractionDigits:2});
              const st = b.status || 'enviado';
              const stMap = {rascunho:['b-default','📝 Rascunho'],enviado:['b-info','📤 Enviado'],aprovado:['b-success','✅ Aprovado'],recusado:['b-danger','❌ Recusado'],expirado:['b-warning','⏰ Expirado']};
              const [stCls, stLabel] = stMap[st] || ['b-default', st];
              return `<tr>
                <td>${dataStr}</td>
                <td><strong>${b.numero || 'ORC-'+b.id.slice(0,6)}</strong></td>
                <td>${cli}</td>
                <td>${itens}</td>
                <td><strong>R$ ${total}</strong></td>
                <td><span class="badge ${stCls}">${stLabel}</span></td>
                <td>
                  <div style="display:flex;gap:4px">
                    <button class="btn btn-sm" onclick="carregarOrcSalvo('${b.id}');comTab='orcamento';renderComercial(document.getElementById('content'))" title="Editar">✏️</button>
                    <button class="btn btn-sm" onclick="marcarOrcStatus('${b.id}','aprovado')" title="Marcar como aprovado" style="color:var(--success-text)">✅</button>
                    <button class="btn btn-sm" onclick="marcarOrcStatus('${b.id}','recusado')" title="Marcar como recusado" style="color:var(--danger-text)">❌</button>
                    <button class="btn btn-sm" onclick="excluirOrcSalvo('${b.id}');renderComercial(document.getElementById('content'))" title="Excluir" style="color:var(--danger-text)">🗑</button>
                  </div>
                </td>
              </tr>`;
            }).join('')}
          </tbody>
        </table></div>
      `}
    </div>
  `;
}


async function refreshHistorico(){
  toast('Atualizando...','info');
  if(!_supa){toast('Supabase não conectado','info');return}
  try {
    const { data, error } = await _supa.from('budgets').select('*').order('created_at',{ascending:false}).limit(200);
    if(error) throw error;
    console.log('[Hist] Carregados', data?.length||0, 'orçamentos:', data);
    orcamentosSalvos = data || [];
    if(orcamentosSalvos.length === 0){
      toast('Nenhum orçamento no banco. Crie um na aba Orçamento.','info');
    } else {
      toast('✓ ' + orcamentosSalvos.length + ' orçamentos carregados','success');
    }
    renderComercial(document.getElementById('content'));
  } catch(e){
    console.error('[Hist] Erro:', e);
    toast('Erro: ' + e.message, 'info');
  }
}


async function marcarOrcStatus(id, status){
  if(!_supa) return;
  try {
    await _supa.from('budgets').update({status}).eq('id', id);
    const b = orcamentosSalvos.find(x => x.id === id);
    if(b) b.status = status;
    toast('✓ Status atualizado: ' + status, 'success');
    renderComercial(document.getElementById('content'));
  } catch(e){ toast('Erro: ' + e.message, 'info') }
}

function desenharGraficoHistorico(filtered){
  const canvas = document.getElementById('histChart');
  if(!canvas) return;
  // Destruir gráfico anterior
  if(_histChart){ try { _histChart.destroy(); } catch(e){} }
  // Agrupar por mês (do ano filtrado)
  const meses = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const totals = new Array(12).fill(0);
  const aprovados = new Array(12).fill(0);
  const recusados = new Array(12).fill(0);
  const pendentes = new Array(12).fill(0);
  filtered.forEach(b => {
    const m = new Date(b.created_at).getMonth();
    totals[m]++;
    if(b.status === 'aprovado') aprovados[m]++;
    else if(b.status === 'recusado') recusados[m]++;
    else pendentes[m]++;
  });
  const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
  const txtCol = isDark ? '#9595a0' : '#6e6e73';
  const gridCol = isDark ? '#23232a' : '#e8e8ed';
  _histChart = new Chart(canvas, {
    type: 'bar',
    data: {
      labels: meses,
      datasets: [
        {label: '✅ Aprovados', data: aprovados, backgroundColor: '#22c55e', borderRadius: 4},
        {label: '📤 Pendentes', data: pendentes, backgroundColor: '#0ea5e9', borderRadius: 4},
        {label: '❌ Recusados', data: recusados, backgroundColor: '#ef4444', borderRadius: 4}
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {position: 'bottom', labels: {color: txtCol, font: {family: 'Inter', size: 11}, usePointStyle: true, boxWidth: 8}},
        tooltip: {backgroundColor: isDark ? '#1a1a1f' : '#1d1d1f', titleColor: '#fff', bodyColor: '#ccc'}
      },
      scales: {
        x: {stacked: true, grid: {display: false}, ticks: {color: txtCol}},
        y: {stacked: true, grid: {color: gridCol}, ticks: {color: txtCol, stepSize: 1, precision: 0}}
      }
    }
  });
}


async function enviarOrcWhats(){
  if(!orcamento.cliente || !orcamento.cliente.nome){toast('Informe o cliente','info');return}
  if(orcamento.itens.length===0){toast('Adicione itens','info');return}
  const phone = orcamento.cliente.telefone ? orcamento.cliente.telefone.replace(/\D/g,'') : '5511999999999';
  const totalBruto = orcamento.itens.reduce((s,i)=>s+(i.qtd*i.valor),0);
  const descontoVal = orcamento.descontoTipo==='percentual' ? totalBruto*(orcamento.desconto/100) : orcamento.desconto;
  const total = totalBruto - descontoVal;
  const msg = 'Olá ' + orcamento.cliente.nome.split(' ')[0] + '! 😊\n\nSegue o orçamento ' + orcamento.numero + ':\n\n' + orcamento.itens.map(i=>'• '+i.desc+' ('+i.qtd+'x R$ '+i.valor.toLocaleString('pt-BR')+')').join('\n') + '\n\n*Total: R$ ' + total.toLocaleString('pt-BR',{minimumFractionDigits:2}) + '*\n\nForma de pagamento: ' + orcamento.formaPagamento + '\nPrazo: ' + orcamento.prazoEntrega + '\n\nQualquer dúvida estamos à disposição!\n— Equipe Impulse One';
  await salvarOrcamento('enviado');
  toast('Abrindo WhatsApp...','success');
  window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(msg),'_blank');
}

// ============ PONTO (página top-level separada) ============
let _pontoView = 'hoje'; // 'hoje' | 'semana' | 'mes' | 'historico'
let _pontoLogs = [];


let _pontoFilterCollab = 'all';
let _pontoFilterMes = new Date().getMonth();
let _pontoFilterAno = new Date().getFullYear();

function applyPontoFilters(items, getDateFn){
  return items.filter(it => {
    if(_pontoFilterCollab !== 'all'){
      const memberId = typeof it === 'object' && it.profile_id ? it.profile_id : (it.member?._dbId || it._dbId);
      if(memberId !== _pontoFilterCollab) return false;
    }
    if(getDateFn){
      const d = new Date(getDateFn(it));
      if(d.getMonth() !== _pontoFilterMes || d.getFullYear() !== _pontoFilterAno) return false;
    }
    return true;
  });
}

function renderPontoFilters(){
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const anos = [];
  const anoAtual = new Date().getFullYear();
  for(let a = anoAtual - 2; a <= anoAtual + 1; a++) anos.push(a);
  return `<div class="card mb-3" style="padding:13px;background:var(--surface-2)">
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:10px;align-items:end">
      <div>
        <div class="info-label" style="margin-bottom:4px">Colaborador</div>
        <select onchange="_pontoFilterCollab=this.value;renderPontoPage(document.getElementById('content'))" style="width:100%;padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);font-size:12.5px;color:var(--text);font-family:inherit">
          <option value="all" ${_pontoFilterCollab==='all'?'selected':''}>Todos os colaboradores</option>
          ${team.filter(t=>t._dbId).map(t=>`<option value="${t._dbId}" ${_pontoFilterCollab===t._dbId?'selected':''}>${t.name}</option>`).join('')}
        </select>
      </div>
      <div>
        <div class="info-label" style="margin-bottom:4px">Mês</div>
        <select onchange="_pontoFilterMes=parseInt(this.value);renderPontoPage(document.getElementById('content'))" style="width:100%;padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);font-size:12.5px;color:var(--text);font-family:inherit">
          ${meses.map((m,i)=>`<option value="${i}" ${_pontoFilterMes===i?'selected':''}>${m}</option>`).join('')}
        </select>
      </div>
      <div>
        <div class="info-label" style="margin-bottom:4px">Ano</div>
        <select onchange="_pontoFilterAno=parseInt(this.value);renderPontoPage(document.getElementById('content'))" style="width:100%;padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);font-size:12.5px;color:var(--text);font-family:inherit">
          ${anos.map(a=>`<option value="${a}" ${_pontoFilterAno===a?'selected':''}>${a}</option>`).join('')}
        </select>
      </div>
      <button class="btn btn-sm" onclick="_pontoFilterCollab='all';_pontoFilterMes=new Date().getMonth();_pontoFilterAno=new Date().getFullYear();renderPontoPage(document.getElementById('content'))" title="Limpar filtros">🔄</button>
    </div>
  </div>`;
}



function calcularCargaDiaria(member){
  const start = (member.work_start_time || '09:00').substring(0,5);
  const end = (member.work_end_time || '18:00').substring(0,5);
  const lunch = parseInt(member.lunch_duration_min) || 60;
  const [sh, sm] = start.split(':').map(Number);
  const [eh, em] = end.split(':').map(Number);
  let mins = (eh*60 + em) - (sh*60 + sm) - lunch;
  return (mins / 60).toFixed(1);
}

function calcularDiasUteisMes(member){
  const workDays = (member.work_days || '1,2,3,4,5').split(',').map(Number);
  const now = new Date();
  const ano = now.getFullYear();
  const mes = now.getMonth();
  const diasNoMes = new Date(ano, mes+1, 0).getDate();
  let count = 0;
  for(let d = 1; d <= diasNoMes; d++){
    const dow = new Date(ano, mes, d).getDay();
    if(workDays.includes(dow)) count++;
  }
  return count;
}

async function toggleWorkDay(profileIdx, day, checked){
  const member = team[profileIdx];
  if(!member) return;
  let days = (member.work_days || '1,2,3,4,5').split(',').filter(d=>d);
  if(checked && !days.includes(day)) days.push(day);
  else if(!checked) days = days.filter(d => d !== day);
  days.sort();
  member.work_days = days.join(',');
  await editProfileField(profileIdx, 'work_days', days.join(','));
  renderEquipe(document.getElementById('content'));
}

// Substituir a função de cálculo de status do ponto usando dados de jornada
function isLateForMember(log, member){
  if(!log || !log.entrada || !member) return false;
  const tolerance = parseInt(member.tolerance_min) || 15;
  const workStart = (member.work_start_time || '09:00').substring(0,5);
  const [wh, wm] = workStart.split(':').map(Number);
  const limitMin = wh*60 + wm + tolerance;
  const ent = new Date(log.entrada);
  const entMin = ent.getHours()*60 + ent.getMinutes();
  return entMin > limitMin;
}

function isFaltaForMember(log, member, dateStr){
  // dia útil mas sem log de entrada
  if(log && log.entrada) return false;
  const workDays = (member.work_days || '1,2,3,4,5').split(',').map(Number);
  const d = new Date(dateStr + 'T12:00:00');
  return workDays.includes(d.getDay());
}

function calcExtraHoursForMember(log, member){
  if(!log || !log.entrada || !log.saida) return 0;
  const horas = calcularHoras(log);
  const carga = parseFloat(calcularCargaDiaria(member));
  return Math.max(0, horas - carga);
}


async function loadPontoLogs(){
  if(!_supa) return;
  try {
    // Carrega logs dos ultimos 60 dias
    const since = new Date(Date.now() - 60*86400000).toISOString().split('T')[0];
    const { data } = await _supa.from('time_clock').select('*').gte('work_date', since).order('work_date', {ascending:false});
    _pontoLogs = data || [];
    console.log('[PONTO] carregados', _pontoLogs.length, 'logs');
  } catch(e){ console.warn('[PONTO] load:', e) }
}

function calcularHoras(log){
  if(!log.entrada || !log.saida) return 0;
  const ent = new Date(log.entrada);
  const sai = new Date(log.saida);
  let ms = sai - ent;
  if(log.intervalo_inicio && log.intervalo_fim){
    const ii = new Date(log.intervalo_inicio);
    const If = new Date(log.intervalo_fim);
    ms -= (If - ii);
  }
  return Math.max(0, ms / 3600000); // horas
}

function getLogsByDateRange(profileId, dateStart, dateEnd){
  return _pontoLogs.filter(l => 
    l.profile_id === profileId &&
    l.work_date >= dateStart &&
    l.work_date <= dateEnd
  );
}

function renderPontoPage(c){
  // Carrega logs em background
  setTimeout(()=>loadPontoLogs().then(()=>renderPontoPage(c)), _pontoLogs.length === 0 ? 100 : 999999);
  
  const now = new Date();
  const opts = {timeZone:'America/Sao_Paulo',hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'};
  const time = now.toLocaleTimeString('pt-BR', opts);
  const dateStr = now.toLocaleDateString('pt-BR', {timeZone:'America/Sao_Paulo',weekday:'long',day:'numeric',month:'long',year:'numeric'});
  const today = now.toISOString().split('T')[0];
  
  // Cálculos por colaborador
  const startWeek = new Date(now);
  startWeek.setDate(now.getDate() - now.getDay()); // domingo
  const startWeekStr = startWeek.toISOString().split('T')[0];
  
  const startMonth = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0];
  
  const stats = team.map(t => {
    if(!t._dbId) return {member:t, horasHoje:0, horasSemana:0, horasMes:0, logsHoje:null, totalDias:0};
    const logsAll = _pontoLogs.filter(l => l.profile_id === t._dbId);
    const logHoje = logsAll.find(l => l.work_date === today);
    const horasHoje = logHoje ? calcularHoras(logHoje) : 0;
    const logsSemana = logsAll.filter(l => l.work_date >= startWeekStr && l.work_date <= today);
    const horasSemana = logsSemana.reduce((s,l) => s + calcularHoras(l), 0);
    const logsMes = logsAll.filter(l => l.work_date >= startMonth && l.work_date <= today);
    const horasMes = logsMes.reduce((s,l) => s + calcularHoras(l), 0);
    return {member:t, horasHoje, horasSemana, horasMes, logsHoje: logHoje, totalDias: logsMes.length};
  });
  
  const ativos = stats.filter(s => s.logsHoje && s.logsHoje.entrada).length;
  const atrasos = stats.filter(s => {
    if(!s.logsHoje || !s.logsHoje.entrada) return false;
    return isLateForMember(s.logsHoje, s.member);
  }).length;
  const faltas = stats.filter(s => {
    if(!s.member._dbId) return false;
    return isFaltaForMember(s.logsHoje, s.member, today);
  }).length;
  const horasExtras = stats.reduce((acc, x) => {
    const cargaDiaria = parseFloat(calcularCargaDiaria(x.member));
    const diasUteis = calcularDiasUteisMes(x.member);
    const meta = cargaDiaria * diasUteis;
    return acc + Math.max(0, x.horasMes - meta);
  }, 0);
  
  c.innerHTML = `<div class="page active">
    <div class="page-header">
      <div><div class="page-title">Ponto</div><div class="page-subtitle">Folha eletrônica — horário oficial de Brasília</div></div>
      <div class="page-actions">
        <button class="btn" onclick="loadPontoLogs().then(()=>renderPontoPage(document.getElementById('content')));toast('Atualizando...','info')">🔄 Atualizar</button>
        <button class="btn" onclick="exportPontoPDF()">📤 PDF</button>
        <button class="btn" onclick="exportPontoExcel()">📊 Excel</button>
      </div>
    </div>
    
    <div class="stat-grid">
      ${statCard('Ativos hoje', ativos+'/'+team.length, 'bateram ponto', 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2')}
      ${statCard('Atrasos hoje', atrasos, '> 9:15', 'M12 9v4', null, 'warning')}
      ${statCard('Faltas hoje', faltas, 'sem registro', 'M5 12h14', null, 'warning')}
      ${statCard('Horas extras', '+'+horasExtras.toFixed(0)+'h', 'banco do mês', 'M12 1v22')}
    </div>

    <div class="filter-bar">
      <span class="filter-chip ${_pontoView==='hoje'?'active':''}" onclick="_pontoView='hoje';renderPontoPage(document.getElementById('content'))">📅 Hoje</span>
      <span class="filter-chip ${_pontoView==='semana'?'active':''}" onclick="_pontoView='semana';renderPontoPage(document.getElementById('content'))">📆 Esta semana</span>
      <span class="filter-chip ${_pontoView==='mes'?'active':''}" onclick="_pontoView='mes';renderPontoPage(document.getElementById('content'))">🗓 Este mês</span>
      <span class="filter-chip ${_pontoView==='historico'?'active':''}" onclick="_pontoView='historico';renderPontoPage(document.getElementById('content'))">📜 Histórico (60 dias)</span>
      <span class="filter-chip ${_pontoView==='planilha'?'active':''}" onclick="_pontoView='planilha';renderPontoPage(document.getElementById('content'))">📊 Planilha individual</span>
    </div>

    <div class="grid-2e">
      <div>
        ${pontoAuth ? renderPontoAuth(time, dateStr) : renderPontoLogin(time, dateStr)}
      </div>
      <div>
        ${_pontoView === 'hoje' ? renderPontoHoje(stats) : ''}
        ${_pontoView === 'semana' ? renderPontoSemana(stats) : ''}
        ${_pontoView === 'mes' ? renderPontoMes(stats) : ''}
        ${_pontoView === 'historico' ? renderPontoHistorico() : ''}
        ${_pontoView === 'planilha' ? renderPontoPlanilha() : ''}
      </div>
    </div>
  </div>`;
}

function renderPontoLogin(time, dateStr){
  return `<div class="card">
    <div class="ponto-clock" style="border:none;padding:0;margin-bottom:18px">
      <div class="ponto-time" id="liveClock">${time}</div>
      <div class="ponto-date">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)}</div>
      <div class="text-xs text-3" style="margin-top:6px">🇧🇷 Horário oficial de Brasília</div>
    </div>
    <div class="section-title" style="margin-top:0">Identifique-se</div>
    <div style="display:flex;flex-direction:column;gap:10px">
      <div><div class="info-label" style="margin-bottom:5px">Colaborador</div>
      <select id="pontoSelect" style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13px">
        <option value="">Selecione...</option>
        ${team.map(t=>`<option value="${t.name}">${t.name}</option>`).join('')}
      </select></div>
      <div><div class="info-label" style="margin-bottom:5px">Senha individual</div>
      <input type="password" id="pontoPwd" placeholder="••••" style="width:100%;padding:11px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);font-family:inherit;font-size:13px"/></div>
      <button class="btn btn-primary" style="justify-content:center;padding:11px" onclick="pontoLogin()">🔐 Entrar para bater ponto</button>
    </div>
    <div class="text-xs text-3 center mt-4">🔒 Registro seguro · Logs auditáveis</div>
  </div>`;
}

function renderPontoAuth(time, dateStr){
  return `<div class="ponto-clock">
    <div style="font-size:13px;color:var(--text-2);margin-bottom:8px">Olá, <strong style="color:var(--text)">${pontoUser}</strong></div>
    <div class="ponto-time" id="liveClock">${time}</div>
    <div class="ponto-date">${dateStr.charAt(0).toUpperCase()+dateStr.slice(1)}</div>
    <div class="ponto-actions">
      <button class="ponto-btn ${pontoToday.entrada?'done':''}" onclick="batePonto('entrada')"><span class="icon">🌅</span><span>Entrada</span><span class="text-xs text-3">${pontoToday.entrada||'—'}</span></button>
      <button class="ponto-btn ${pontoToday.intervaloIn?'done':''}" onclick="batePonto('intervaloIn')"><span class="icon">🍽</span><span>Início intervalo</span><span class="text-xs text-3">${pontoToday.intervaloIn||'—'}</span></button>
      <button class="ponto-btn ${pontoToday.intervaloOut?'done':''}" onclick="batePonto('intervaloOut')"><span class="icon">☕</span><span>Fim intervalo</span><span class="text-xs text-3">${pontoToday.intervaloOut||'—'}</span></button>
      <button class="ponto-btn ${pontoToday.saida?'done':''}" onclick="batePonto('saida')"><span class="icon">🌙</span><span>Saída</span><span class="text-xs text-3">${pontoToday.saida||'—'}</span></button>
    </div>
    <div style="margin-top:14px"><button class="btn btn-sm" onclick="pontoAuth=false;pontoUser=null;renderPontoPage(document.getElementById('content'))">Trocar usuário</button></div>
  </div>`;
}

function renderPontoHoje(stats){
  const filtered = _pontoFilterCollab === 'all' ? stats : stats.filter(s => s.member._dbId === _pontoFilterCollab);
  return renderPontoFilters() + `<div class="card">
    <div class="card-header"><div class="card-title">📋 Quem bateu ponto hoje</div><span class="badge b-default">${filtered.length}</span></div>
    ${filtered.length===0?'<div class="empty-state"><div class="ico">📭</div><div class="ttl">Nenhum registro</div></div>':filtered.map(s => {
      const log = s.logsHoje;
      const ent = log?.entrada ? new Date(log.entrada).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : null;
      const sai = log?.saida ? new Date(log.saida).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : null;
      return `<div class="list-item">
        <div class="avatar" style="background:${s.member.color||'#999'}">${s.member.init||s.member.name[0]}</div>
        <div class="list-content">
          <div class="list-title">${s.member.name}</div>
          <div class="list-meta">${ent?'Entrada: '+ent:'Ainda não registrou'}${sai?' · Saída: '+sai:ent?' · Trabalhando há '+s.horasHoje.toFixed(1)+'h':''}</div>
        </div>
        <div class="list-right">
          ${log?.entrada ? '<strong>'+s.horasHoje.toFixed(1)+'h</strong>' : '<span class="badge b-default">—</span>'}
        </div>
      </div>`;
    }).join('')}
  </div>`;
}

function renderPontoSemana(stats){
  const dias = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  const today = new Date();
  const startWeek = new Date(today);
  startWeek.setDate(today.getDate() - today.getDay());
  const filtered = _pontoFilterCollab === 'all' ? stats : stats.filter(s => s.member._dbId === _pontoFilterCollab);
  return renderPontoFilters() + `<div class="card">
    <div class="card-header"><div class="card-title">📆 Esta semana — horas trabalhadas</div></div>
    ${filtered.map(s => {
      const totalSem = s.horasSemana;
      const meta = 40;
      const pct = Math.min(100, (totalSem/meta)*100);
      return `<div style="padding:11px 0;border-bottom:1px solid var(--border)">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
          <div class="avatar" style="background:${s.member.color||'#999'}">${s.member.init||s.member.name[0]}</div>
          <div style="flex:1"><strong>${s.member.name}</strong></div>
          <strong>${totalSem.toFixed(1)}h <span class="text-xs text-3">/ ${meta}h</span></strong>
        </div>
        <div class="meter"><div class="meter-fill" style="width:${pct}%;background:${pct>=100?'var(--success)':pct>=75?'var(--accent)':'var(--warning)'}"></div></div>
      </div>`;
    }).join('')}
  </div>`;
}

function renderPontoMes(stats){
  const filtered = _pontoFilterCollab === 'all' ? stats : stats.filter(s => s.member._dbId === _pontoFilterCollab);
  return renderPontoFilters() + `<div class="card">
    <div class="card-header"><div class="card-title">🗓 Este mês — resumo</div></div>
    <table class="table">
      <thead><tr><th>Colaborador</th><th>Dias</th><th>Total</th><th>Média/dia</th><th>Status</th></tr></thead>
      <tbody>
        ${filtered.map(s => {
          const media = s.totalDias > 0 ? s.horasMes/s.totalDias : 0;
          const meta = 176;
          const cls = s.horasMes >= meta ? 'b-success' : s.horasMes >= meta*0.8 ? 'b-info' : 'b-warning';
          const lbl = s.horasMes >= meta ? 'Meta atingida' : s.horasMes >= meta*0.8 ? 'No caminho' : 'Abaixo';
          return `<tr>
            <td><div style="display:flex;align-items:center;gap:8px"><div class="avatar" style="background:${s.member.color}">${s.member.init}</div><strong>${s.member.name}</strong></div></td>
            <td>${s.totalDias}</td>
            <td><strong>${s.horasMes.toFixed(1)}h</strong> <span class="text-xs text-3">/ ${meta}h</span></td>
            <td>${media.toFixed(1)}h</td>
            <td><span class="badge ${cls}">${lbl}</span></td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>
  </div>`;
}

function renderPontoHistorico(){
  // Aplica filtros
  const filtered = _pontoLogs.filter(l => {
    if(_pontoFilterCollab !== 'all' && l.profile_id !== _pontoFilterCollab) return false;
    const d = new Date(l.work_date + 'T12:00:00');
    if(d.getMonth() !== _pontoFilterMes || d.getFullYear() !== _pontoFilterAno) return false;
    return true;
  });
  return renderPontoFilters() + `<div class="card">
    <div class="card-header"><div class="card-title">📜 Histórico filtrado</div><span class="badge b-default">${filtered.length} de ${_pontoLogs.length} registros</span></div>
    ${filtered.length === 0 ? '<div class="empty-state"><div class="ico">📂</div><div class="ttl">Nenhum registro nos filtros</div><div class="desc">Mude os filtros ou bata ponto pra criar</div></div>' : `
    <div style="max-height:500px;overflow-y:auto">
    <table class="table">
      <thead><tr><th>Data</th><th>Colaborador</th><th>Entrada</th><th>Intervalo</th><th>Saída</th><th>Total</th></tr></thead>
      <tbody>
        ${filtered.slice(0, 200).map(l => {
          const member = team.find(t => t._dbId === l.profile_id) || {name: '?', color: '#999', init: '?'};
          const ent = l.entrada ? new Date(l.entrada).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : '—';
          const ii = l.intervalo_inicio ? new Date(l.intervalo_inicio).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : '—';
          const If = l.intervalo_fim ? new Date(l.intervalo_fim).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : '—';
          const sai = l.saida ? new Date(l.saida).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : '—';
          const total = calcularHoras(l);
          const dateFmt = new Date(l.work_date+'T12:00:00').toLocaleDateString('pt-BR', {day:'2-digit',month:'short',weekday:'short'});
          return `<tr>
            <td><strong>${dateFmt}</strong></td>
            <td><span style="display:inline-flex;align-items:center;gap:6px"><span class="avatar" style="background:${member.color};width:22px;height:22px;font-size:10px">${member.init}</span>${member.name}</span></td>
            <td>${ent}</td>
            <td>${ii} → ${If}</td>
            <td>${sai}</td>
            <td><strong>${total > 0 ? total.toFixed(1)+'h' : '—'}</strong></td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>
    </div>`}
  </div>`;
}


let _planilhaProfileId = null;
let _planilhaMes = new Date().getMonth();
let _planilhaAno = new Date().getFullYear();

function renderPontoPlanilha(){
  // Profile selecionado (default = primeiro com _dbId)
  if(!_planilhaProfileId && team.length > 0){
    const first = team.find(t => t._dbId);
    if(first) _planilhaProfileId = first._dbId;
  }
  
  const selectedMember = team.find(t => t._dbId === _planilhaProfileId);
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  
  // Gerar dias do mês selecionado
  const diasNoMes = new Date(_planilhaAno, _planilhaMes + 1, 0).getDate();
  const hoje = new Date().toISOString().split('T')[0];
  
  // Carregar logs do mês
  const inicioMes = `${_planilhaAno}-${String(_planilhaMes+1).padStart(2,'0')}-01`;
  const fimMes = `${_planilhaAno}-${String(_planilhaMes+1).padStart(2,'0')}-${String(diasNoMes).padStart(2,'0')}`;
  const logsDoMes = _pontoLogs.filter(l => 
    l.profile_id === _planilhaProfileId && 
    l.work_date >= inicioMes && 
    l.work_date <= fimMes
  );
  
  // Calcular estatísticas
  let totalHoras = 0, diasTrabalhados = 0, atrasos = 0, faltas = 0;
  const workDays = ((selectedMember && selectedMember.work_days) || '1,2,3,4,5').split(',').map(Number);
  const cargaDiaria = selectedMember ? parseFloat(calcularCargaDiaria(selectedMember)) : 8;
  const diasUteis = [];
  for(let dia = 1; dia <= diasNoMes; dia++){
    const data = new Date(_planilhaAno, _planilhaMes, dia);
    const dow = data.getDay();
    if(workDays.includes(dow)){
      diasUteis.push(dia);
    }
  }
  const metaHorasMes = diasUteis.length * cargaDiaria;
  
  // Anos disponíveis
  const anos = [];
  const anoAtual = new Date().getFullYear();
  for(let a = anoAtual - 2; a <= anoAtual + 1; a++) anos.push(a);
  
  // Construir tabela
  const linhas = [];
  for(let dia = 1; dia <= diasNoMes; dia++){
    const dataStr = `${_planilhaAno}-${String(_planilhaMes+1).padStart(2,'0')}-${String(dia).padStart(2,'0')}`;
    const data = new Date(_planilhaAno, _planilhaMes, dia);
    const dow = data.getDay();
    const isWeekend = !workDays.includes(dow);
    const isFuture = dataStr > hoje;
    const log = logsDoMes.find(l => l.work_date === dataStr);
    
    const fmtHora = (iso) => iso ? new Date(iso).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : '—';
    const ent = log ? fmtHora(log.entrada) : '—';
    const ii = log ? fmtHora(log.intervalo_inicio) : '—';
    const If = log ? fmtHora(log.intervalo_fim) : '—';
    const sai = log ? fmtHora(log.saida) : '—';
    const horas = log ? calcularHoras(log) : 0;
    
    // Determinar status
    let statusBadge = '';
    if(isWeekend){
      statusBadge = '<span class="badge b-default" style="font-size:9.5px">Final de semana</span>';
    } else if(isFuture){
      statusBadge = '<span class="badge b-default" style="font-size:9.5px">—</span>';
    } else if(!log){
      statusBadge = '<span class="badge b-danger" style="font-size:9.5px">⚠ Falta</span>';
      faltas++;
    } else if(log.entrada){
      const entHora = new Date(log.entrada);
      const entMin = entHora.getHours() * 60 + entHora.getMinutes();
      if(entMin > 9*60 + 15){
        statusBadge = '<span class="badge b-warning" style="font-size:9.5px">⏰ Atraso</span>';
        atrasos++;
      } else {
        statusBadge = '<span class="badge b-success" style="font-size:9.5px">✓ Em dia</span>';
      }
      if(log.entrada && log.saida){
        totalHoras += horas;
        diasTrabalhados++;
      }
    }
    
    const diaSemana = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'][dow];
    const rowStyle = isWeekend ? 'background:var(--surface-2);opacity:0.6' : (isFuture ? 'opacity:0.4' : '');
    
    linhas.push(`<tr style="${rowStyle}">
      <td style="font-weight:600;white-space:nowrap">${String(dia).padStart(2,'0')}/${String(_planilhaMes+1).padStart(2,'0')} <span class="text-xs text-3">(${diaSemana})</span></td>
      <td>${ent}</td>
      <td>${ii}</td>
      <td>${If}</td>
      <td>${sai}</td>
      <td><strong>${horas > 0 ? horas.toFixed(1)+'h' : '—'}</strong></td>
      <td>${statusBadge}</td>
    </tr>`);
  }
  
  const saldoHoras = totalHoras - metaHorasMes;
  
  return `<div class="card">
    <div class="card-header">
      <div class="card-title">📊 Planilha individual de ponto</div>
      <button class="btn btn-sm" onclick="exportPlanilhaCSV()">📊 Baixar Excel</button>
    </div>
    
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px;margin-bottom:16px">
      <div>
        <div class="info-label" style="margin-bottom:4px">Colaborador</div>
        <select id="planilhaSelect" onchange="_planilhaProfileId=this.value;renderPontoPage(document.getElementById('content'))" style="width:100%;padding:9px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:12.5px;color:var(--text);font-family:inherit">
          ${team.filter(t=>t._dbId).map(t=>`<option value="${t._dbId}" ${_planilhaProfileId===t._dbId?'selected':''}>${t.name}</option>`).join('')}
        </select>
      </div>
      <div>
        <div class="info-label" style="margin-bottom:4px">Mês</div>
        <select onchange="_planilhaMes=parseInt(this.value);renderPontoPage(document.getElementById('content'))" style="width:100%;padding:9px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:12.5px;color:var(--text);font-family:inherit">
          ${meses.map((m,i)=>`<option value="${i}" ${_planilhaMes===i?'selected':''}>${m}</option>`).join('')}
        </select>
      </div>
      <div>
        <div class="info-label" style="margin-bottom:4px">Ano</div>
        <select onchange="_planilhaAno=parseInt(this.value);renderPontoPage(document.getElementById('content'))" style="width:100%;padding:9px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:12.5px;color:var(--text);font-family:inherit">
          ${anos.map(a=>`<option value="${a}" ${_planilhaAno===a?'selected':''}>${a}</option>`).join('')}
        </select>
      </div>
    </div>
    
    ${selectedMember ? `
    <div style="background:var(--surface-2);padding:14px;border-radius:10px;margin-bottom:14px;display:flex;align-items:center;gap:14px">
      <div class="profile-avatar" style="background:${selectedMember.color};width:48px;height:48px;font-size:18px">${selectedMember.init||selectedMember.name[0]}</div>
      <div style="flex:1">
        <div style="font-size:16px;font-weight:700">${selectedMember.name}</div>
        <div class="text-xs text-3">${selectedMember.role||''} · ${meses[_planilhaMes]}/${_planilhaAno}</div>
      </div>
    </div>` : ''}
    
    <div class="stat-grid" style="grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px">
      <div class="stat" style="padding:13px">
        <div class="stat-label">Dias trabalhados</div>
        <div class="stat-value" style="font-size:18px">${diasTrabalhados}<span class="text-xs text-3">/${diasUteis.length}</span></div>
      </div>
      <div class="stat" style="padding:13px">
        <div class="stat-label">Total horas</div>
        <div class="stat-value" style="font-size:18px">${totalHoras.toFixed(1)}h</div>
        <div class="text-xs text-3">meta ${metaHorasMes}h</div>
      </div>
      <div class="stat" style="padding:13px">
        <div class="stat-label">Saldo</div>
        <div class="stat-value" style="font-size:18px;color:${saldoHoras>=0?'var(--success-text)':'var(--danger-text)'}">${saldoHoras>=0?'+':''}${saldoHoras.toFixed(1)}h</div>
      </div>
      <div class="stat" style="padding:13px">
        <div class="stat-label">Atrasos / Faltas</div>
        <div class="stat-value" style="font-size:18px">${atrasos} / ${faltas}</div>
      </div>
    </div>
    
    <div style="max-height:600px;overflow-y:auto;border:1px solid var(--border);border-radius:9px">
      <table class="table" style="width:100%">
        <thead style="position:sticky;top:0;background:var(--surface);z-index:2">
          <tr>
            <th>Data</th>
            <th>Entrada</th>
            <th>Início interv.</th>
            <th>Fim interv.</th>
            <th>Saída</th>
            <th>Total</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          ${linhas.join('')}
        </tbody>
      </table>
    </div>
    
    <div class="text-xs text-3 mt-3">
      🟢 <strong>Em dia</strong>: entrada até 9:15 · 
      🟡 <strong>Atraso</strong>: após 9:15 · 
      🔴 <strong>Falta</strong>: sem registro em dia útil · 
      ⚪ <strong>Final de semana</strong>: não conta
    </div>
  </div>`;
}

function exportPlanilhaCSV(){
  const selectedMember = team.find(t => t._dbId === _planilhaProfileId);
  if(!selectedMember){toast('Selecione um colaborador','info');return}
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const diasNoMes = new Date(_planilhaAno, _planilhaMes + 1, 0).getDate();
  
  let csv = 'PLANILHA DE PONTO\n';
  csv += 'Colaborador,' + selectedMember.name + '\n';
  csv += 'Periodo,' + meses[_planilhaMes] + '/' + _planilhaAno + '\n\n';
  csv += 'Data,Dia,Entrada,Inicio Intervalo,Fim Intervalo,Saida,Total Horas,Status\n';
  
  let totalH = 0, diasT = 0;
  for(let dia = 1; dia <= diasNoMes; dia++){
    const dataStr = `${_planilhaAno}-${String(_planilhaMes+1).padStart(2,'0')}-${String(dia).padStart(2,'0')}`;
    const data = new Date(_planilhaAno, _planilhaMes, dia);
    const dow = data.getDay();
    const diaSemana = ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'][dow];
    const log = _pontoLogs.find(l => l.profile_id === _planilhaProfileId && l.work_date === dataStr);
    
    const fmtHora = (iso) => iso ? new Date(iso).toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) : '';
    const horas = log ? calcularHoras(log) : 0;
    if(horas > 0){ totalH += horas; diasT++; }
    
    let status = '';
    if(dow === 0 || dow === 6) status = 'Final de semana';
    else if(!log) status = 'Falta';
    else status = 'OK';
    
    csv += [
      dataStr,
      diaSemana,
      fmtHora(log?.entrada),
      fmtHora(log?.intervalo_inicio),
      fmtHora(log?.intervalo_fim),
      fmtHora(log?.saida),
      horas > 0 ? horas.toFixed(2).replace('.',',') : '',
      status
    ].join(',') + '\n';
  }
  
  csv += '\nTotal de horas,' + totalH.toFixed(2).replace('.',',') + '\n';
  csv += 'Dias trabalhados,' + diasT + '\n';
  
  const blob = new Blob(['\ufeff' + csv], {type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'ponto-' + selectedMember.name.replace(/\s/g,'-') + '-' + meses[_planilhaMes] + '-' + _planilhaAno + '.csv';
  a.click();
  toast('✓ Planilha exportada','success');
}


function exportPontoPDF(){toast('Exportação PDF — em desenvolvimento','info')}
function exportPontoExcel(){
  // Gerar CSV simples (que abre no Excel)
  let csv = 'Data,Colaborador,Entrada,Intervalo Inicio,Intervalo Fim,Saida,Total Horas\n';
  _pontoLogs.forEach(l => {
    const member = team.find(t => t._dbId === l.profile_id) || {name: '?'};
    const ent = l.entrada ? new Date(l.entrada).toLocaleString('pt-BR') : '';
    const ii = l.intervalo_inicio ? new Date(l.intervalo_inicio).toLocaleString('pt-BR') : '';
    const If = l.intervalo_fim ? new Date(l.intervalo_fim).toLocaleString('pt-BR') : '';
    const sai = l.saida ? new Date(l.saida).toLocaleString('pt-BR') : '';
    csv += [l.work_date, member.name, ent, ii, If, sai, calcularHoras(l).toFixed(2)].join(',')+'\n';
  });
  const blob = new Blob([csv], {type:'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'ponto-historico-'+new Date().toISOString().split('T')[0]+'.csv';
  a.click();
  toast('CSV gerado','success');
}

// =========== Menu Novo ===========
function toggleNovoMenu(e){
  e.stopPropagation();
  document.getElementById('novoMenu').classList.toggle('open');
}
function closeNovo(){document.getElementById('novoMenu').classList.remove('open')}

// =========== Busca global ===========
const searchablePages = [
  {label:'Dashboard',page:'dashboard',keys:['dashboard','inicio','início','home']},
  {label:'Clientes',page:'clientes',keys:['clientes','crm']},
  {label:'Captação',page:'captacao',keys:['captacao','captação','gravação','foto','video','vídeo']},
  {label:'Comercial',page:'comercial',keys:['comercial','funil','pipeline','orcamento','orçamento','lead','upsell']},
  {label:'Operacional',page:'operacional',keys:['operacional','kanban','checklist','tarefa']},
  {label:'Calendário',page:'calendario',keys:['calendario','calendário','agenda','evento']},
  {label:'Reuniões',page:'reunioes',keys:['reuniao','reunião','meet','ata']},
  {label:'Conteúdo',page:'conteudo',keys:['conteudo','conteúdo','mlabs','drive','canva']},
  {label:'Equipe',page:'equipe',keys:['equipe','rh','time','colaborador']},
  {label:'Ponto',page:'ponto',keys:['ponto','folha','horário','horario']},
  {label:'Automação',page:'automacao',keys:['automacao','automação','workflow']},
  {label:'Relatórios',page:'relatorios',keys:['relatorios','relatórios','report']},
  {label:'Financeiro',page:'financeiro',keys:['financeiro','dre','caixa','despesa']},
  {label:'Arquivos',page:'arquivos',keys:['arquivos','arquivo','drive','pasta']},
  {label:'Configurações',page:'config',keys:['config','configuração','settings','ajuste']},
];

function globalSearch(q){
  const res = document.getElementById('searchResults');
  if(!res) return;
  q = (q||'').trim().toLowerCase();
  if(!q){res.classList.remove('open');return}
  const matches = {clients:[],captacoes:[],team:[],pages:[]};
  matches.clients = clients.filter(c=>c.name.toLowerCase().includes(q)||c.segment.toLowerCase().includes(q)).slice(0,5);
  matches.captacoes = captacoes.filter(c=>c.client.toLowerCase().includes(q)||c.type.toLowerCase().includes(q)).slice(0,3);
  matches.team = team.filter(t=>t.name.toLowerCase().includes(q)||t.role.toLowerCase().includes(q)).slice(0,3);
  matches.pages = searchablePages.filter(p=>p.label.toLowerCase().includes(q)||p.keys.some(k=>k.includes(q))).slice(0,4);
  const total = matches.clients.length+matches.captacoes.length+matches.team.length+matches.pages.length;
  if(total===0){
    res.innerHTML = `<div class="search-empty">Nenhum resultado para "<strong>${q}</strong>"</div>`;
    res.classList.add('open');return;
  }
  let html = '';
  if(matches.clients.length){
    html += '<div class="search-section">Clientes</div>';
    matches.clients.forEach(cli=>{
      html += `<div class="search-result" onclick="closeSearch();openClient(${cli.id})">
        <div class="client-logo" style="background:${cli.color};width:26px;height:26px;font-size:10px">${cli.init}</div>
        <div><strong>${cli.name}</strong><div class="text-xs text-3">${cli.segment}</div></div>
      </div>`;
    });
  }
  if(matches.captacoes.length){
    html += '<div class="search-section">Captações</div>';
    matches.captacoes.forEach(cap=>{
      html += `<div class="search-result" onclick="closeSearch();goTo('captacao')">
        <div style="width:26px;height:26px;border-radius:6px;background:${cap.color};color:#fff;display:grid;place-items:center;font-weight:700;font-size:10px">${cap.init}</div>
        <div><strong>${cap.client}</strong><div class="text-xs text-3">${cap.type} · ${cap.date}</div></div>
      </div>`;
    });
  }
  if(matches.team.length){
    html += '<div class="search-section">Equipe</div>';
    matches.team.forEach(t=>{
      const i = team.indexOf(t);
      html += `<div class="search-result" onclick="closeSearch();perfilId=${i};equipeView='perfil';goTo('equipe')">
        <div class="avatar" style="background:${t.color};width:26px;height:26px;font-size:11px">${t.init}</div>
        <div><strong>${t.name}</strong><div class="text-xs text-3">${t.role}</div></div>
      </div>`;
    });
  }
  if(matches.pages.length){
    html += '<div class="search-section">Páginas</div>';
    matches.pages.forEach(p=>{
      html += `<div class="search-result" onclick="closeSearch();goTo('${p.page}')">
        <div style="width:26px;height:26px;border-radius:6px;background:var(--surface-3);display:grid;place-items:center">→</div>
        <div><strong>${p.label}</strong><div class="text-xs text-3">Abrir página</div></div>
      </div>`;
    });
  }
  res.innerHTML = html;
  res.classList.add('open');
}
function closeSearch(){
  const res = document.getElementById('searchResults');
  if(res) res.classList.remove('open');
  const inp = document.getElementById('globalSearch');
  if(inp) inp.value = '';
}

// =========== Click externo fecha popups ===========
document.addEventListener('click',e=>{
  if(!e.target.closest('#novoMenu')&&!e.target.closest('.btn-primary')){
    document.getElementById('novoMenu')?.classList.remove('open');
  }
  if(!e.target.closest('.search')){
    document.getElementById('searchResults')?.classList.remove('open');
  }
});

// =========== Atalhos de teclado ===========
document.addEventListener('keydown',e=>{
  // ⌘K / Ctrl+K → focus search
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){
    e.preventDefault();
    document.getElementById('globalSearch')?.focus();
    return;
  }
  // Esc → close modal/popups
  if(e.key==='Escape'){
    closeModal();
    closeNovo();
    closeSearch();
    return;
  }
  // ⌘N → novo
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='n'){
    e.preventDefault();
    document.getElementById('novoMenu')?.classList.add('open');
    return;
  }
  // ⌘D → dashboard
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='d'&&e.shiftKey){
    e.preventDefault();
    goTo('dashboard');
    return;
  }
});

// =========== Back to top ===========
const _content = document.getElementById('content');
const _backTop = document.createElement('div');
_backTop.className = 'back-top';
_backTop.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 15l-6-6-6 6"/></svg>';
_backTop.onclick = ()=>_content.scrollTo({top:0,behavior:'smooth'});
document.body.appendChild(_backTop);
_content.addEventListener('scroll',()=>{
  _backTop.classList.toggle('show', _content.scrollTop>320);
});

// =========== Safety net: ações de clique para todo o sistema ===========
// Captura cliques em elementos comuns sem handler explícito e exibe feedback claro
document.addEventListener('click',e=>{
  // .filter-chip sem onclick: ativar dentro do mesmo .filter-bar
  const chip = e.target.closest('.filter-chip');
  if(chip && !chip.getAttribute('onclick')){
    const bar = chip.closest('.filter-bar') || chip.parentElement;
    if(bar) bar.querySelectorAll('.filter-chip').forEach(s=>s.classList.toggle('active',s===chip));
    return;
  }
  // .check-box sem onclick: toggle
  const cb = e.target.closest('.check-box');
  if(cb && !cb.getAttribute('onclick')){cb.classList.toggle('checked');return}
  // .toggle sem onclick: toggle
  const tg = e.target.closest('.toggle');
  if(tg && !tg.getAttribute('onclick')){tg.classList.toggle('on');return}
  // botão "+ Adicionar" tipo kanban-add
  const ka = e.target.closest('.kanban-add');
  if(ka && !ka.getAttribute('onclick')){toast('Funcionalidade de criar item — disponível na versão completa','info');return}
  // <button> sem onclick → toast com o nome
  const btn = e.target.closest('button:not(.modal-close):not(.icon-btn):not(.copy-btn):not(.check-box):not(.toggle)');
  if(btn && !btn.getAttribute('onclick') && !btn.hasAttribute('data-handled')){
    const txt = btn.textContent.trim().slice(0,40);
    if(txt) toast('Ação: '+txt,'info');
    return;
  }
  // .icon-btn sem onclick
  const ib = e.target.closest('.icon-btn');
  if(ib && !ib.getAttribute('onclick') && !ib.hasAttribute('title')){
    toast('Ação executada','info');
    return;
  }
});

// =========== Loading indicator on page navigation ===========
const _origRenderPage = renderPage;
renderPage = function(page){
  const lb = document.querySelector('.load-bar') || (()=>{const d=document.createElement('div');d.className='load-bar';document.body.appendChild(d);return d})();
  lb.style.width = '0%';
  requestAnimationFrame(()=>{lb.style.width='70%'});
  _origRenderPage(page);
  setTimeout(()=>{lb.style.width='100%';setTimeout(()=>lb.style.width='0%',180)},80);
};


// ============ CRONOGRAMA ============
let cronMonth = 5; // mês atual = maio
let cronQuery = '';
let cronStatusFilter = 'all';
const monthNames = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
const monthNamesLong = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

function renderCronograma(c){
  const monthDeadlineCounts = {};
  for(let m=1;m<=12;m++){
    monthDeadlineCounts[m] = 0;
    clients.forEach(cli=>{
      const d = cronograma[cli.id][m];
      const dl = new Date(d.deadline);
      const today = new Date('2026-05-18');
      const diff = Math.round((dl-today)/86400000);
      if((diff===0||diff===1) && d.status!=='concluido') monthDeadlineCounts[m]++;
    });
  }

  const rows = clients.filter(cli=>{
    const d = cronograma[cli.id][cronMonth];
    if(cronStatusFilter!=='all' && d.status!==cronStatusFilter) return false;
    if(cronQuery){
      const q = cronQuery.toLowerCase();
      const hay = (cli.name+' '+cli.segment+' '+d.designer+' '+d.trafficManager).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });

  const totalProd = rows.reduce((s,r)=>s+cronograma[r.id][cronMonth].produced,0);
  const totalTarget = rows.reduce((s,r)=>s+cronograma[r.id][cronMonth].target,0);
  const atrasados = rows.filter(r=>cronograma[r.id][cronMonth].status==='atrasado').length;
  const proxPrazo = rows.filter(r=>{
    const dl = new Date(cronograma[r.id][cronMonth].deadline);
    const diff = Math.round((dl-new Date('2026-05-18'))/86400000);
    return diff>=0 && diff<=3 && cronograma[r.id][cronMonth].status!=='concluido';
  }).length;

  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Cronograma — ${monthNamesLong[cronMonth-1]} 2026</div>
          <div class="page-subtitle">${rows.length} cliente(s) · ${totalProd}/${totalTarget} conteúdos produzidos · ${atrasados} atrasado(s)</div>
        </div>
        <div class="page-actions">
          <div class="page-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder="Buscar cliente, designer, gestor..." oninput="cronQuery=this.value;renderCronograma(document.getElementById('content'))" value="${cronQuery}"/></div>
          <button class="btn" onclick="toast('Exportando cronograma…','info')">📤 Exportar</button>
          <button class="btn btn-primary" onclick="toast('Adicionar novo item ao cronograma','info')">+ Novo</button>
        </div>
      </div>

      ${renderDeadlineBanner()}

      <div class="stat-grid">
        ${statCard('Conteúdos do mês',totalProd+'/'+totalTarget, Math.round(totalProd/Math.max(totalTarget,1)*100)+'% concluído','M9 11l3 3L22 4')}
        ${statCard('Atrasados',atrasados,'precisam atenção','M12 9v4',null,'warning')}
        ${statCard('Prazos próximos',proxPrazo,'D-3 a hoje','M12 8v4l3 3',null,'warning')}
        ${statCard('Em produção',rows.filter(r=>cronograma[r.id][cronMonth].status==='em-andamento').length,'fluindo','M3 3v18h18')}
      </div>

      <div class="cron-months">
        ${monthNames.map((m,i)=>{
          const idx=i+1;
          const cnt=monthDeadlineCounts[idx];
          const isCurrent = idx===5; // mai
          return `<button class="cron-month-tab ${cronMonth===idx?'active':''} ${isCurrent?'current':''}" onclick="cronMonth=${idx};renderCronograma(document.getElementById('content'))">${m}${cnt>0?`<span class="badge-mini">${cnt}</span>`:''}</button>`;
        }).join('')}
      </div>

      <div class="filter-bar">
        <span class="filter-chip ${cronStatusFilter==='all'?'active':''}" onclick="cronStatusFilter='all';renderCronograma(document.getElementById('content'))">Todos</span>
        <span class="filter-chip ${cronStatusFilter==='em-dia'?'active':''}" onclick="cronStatusFilter='em-dia';renderCronograma(document.getElementById('content'))">Em dia</span>
        <span class="filter-chip ${cronStatusFilter==='em-andamento'?'active':''}" onclick="cronStatusFilter='em-andamento';renderCronograma(document.getElementById('content'))">Em andamento</span>
        <span class="filter-chip ${cronStatusFilter==='atrasado'?'active':''}" onclick="cronStatusFilter='atrasado';renderCronograma(document.getElementById('content'))">Atrasados</span>
        <span class="filter-chip ${cronStatusFilter==='concluido'?'active':''}" onclick="cronStatusFilter='concluido';renderCronograma(document.getElementById('content'))">Concluídos</span>
        <span class="filter-chip ${cronStatusFilter==='planejado'?'active':''}" onclick="cronStatusFilter='planejado';renderCronograma(document.getElementById('content'))">Planejados</span>
      </div>

      <div class="cron-table-wrap">
        <div class="cron-scroll">
          <table class="cron-table">
            <thead>
              <tr>
                <th>Cliente</th>
                <th>Conteúdos</th>
                <th>Tráfego</th>
                <th>Designer</th>
                <th>Status</th>
                <th>Prazo</th>
                <th>Observações</th>
              </tr>
            </thead>
            <tbody>
              ${rows.length===0?'<tr><td colspan="7"><div class="empty-state"><div class="ico">📅</div><div class="ttl">Nenhum item nesta visão</div><div class="desc">Ajuste filtros ou mês.</div></div></td></tr>':rows.map(cli=>{
                const d = cronograma[cli.id][cronMonth];
                const pct = Math.round(d.produced/Math.max(d.target,1)*100);
                const pctCls = pct>=90?'success':pct>=50?'':pct>=25?'warning':'danger';
                const dl = new Date(d.deadline);
                const today = new Date('2026-05-18');
                const diff = Math.round((dl-today)/86400000);
                const dlCls = diff<0?'urgent':diff<=1?'urgent':diff<=3?'soon':'';
                const dlLabel = dl.toLocaleDateString('pt-BR',{day:'2-digit',month:'short'});
                const dlSub = diff===0?'HOJE':diff===1?'amanhã':diff<0?`atrasado ${Math.abs(diff)}d`:`em ${diff}d`;
                const statusMap = {'em-dia':['b-success','Em dia'],'em-andamento':['b-info','Em produção'],'atrasado':['b-danger','Atrasado'],'concluido':['b-default','Concluído'],'planejado':['b-default','Planejado']};
                const [stCls,stLabel] = statusMap[d.status]||['b-default',d.status];
                const designer = team.find(t=>t.name.startsWith(d.designer))||{init:'?',color:'#999'};
                const traffic = team.find(t=>t.name.startsWith(d.trafficManager))||{init:'?',color:'#999'};
                return `
                  <tr data-cli="${cli.id}" id="cron-row-${cli.id}">
                    <td><div class="cron-cli">
                      <div class="cron-cli-logo" style="background:${cli.color}">${cli.init}</div>
                      <div><div class="cron-cli-name">${cli.name}</div><div class="text-xs text-3">${cli.segment}</div></div>
                    </div></td>
                    <td>
                      <div class="text-sm font-semi">${d.produced}<span class="text-3">/${d.target}</span></div>
                      <div class="cron-progress"><div class="cron-progress-bar ${pctCls}" style="width:${Math.min(pct,100)}%"></div></div>
                    </td>
                    <td>${d.hasTraffic?`<span class="cron-pill" style="background:var(--surface-2)"><span class="av" style="background:${traffic.color}">${traffic.init}</span>${d.trafficManager}</span>`:'<span class="text-3 text-xs">— sem tráfego</span>'}</td>
                    <td><span class="cron-pill" style="background:var(--surface-2)"><span class="av" style="background:${designer.color}">${designer.init}</span>${d.designer}</span></td>
                    <td><span class="cron-status badge ${stCls}"><span class="dot"></span>${stLabel}</span></td>
                    <td><div class="cron-deadline ${dlCls}">${dlLabel}</div><div class="text-xs text-3">${dlSub}</div></td>
                    <td><input class="cron-obs-input" placeholder="Anotar observação…" value="${d.obs||''}" oninput="cronograma[${cli.id}][${cronMonth}].obs=this.value;debouncedSaveCron(${cli.id},${cronMonth},this.value)" /></td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
      </div>

      <div class="card mt-4" style="border-left:3px solid var(--info)">
        <div class="card-header"><div class="card-title">🔔 Sistema de notificações</div><span class="badge b-info">Automático</span></div>
        <div class="text-sm text-mu" style="line-height:1.7">
          <strong>D-1:</strong> alerta no topo do sistema + toast persistente · <strong>No dia:</strong> alerta urgente + banner em todas as páginas · clique no banner abre o cronograma direto na linha do cliente
        </div>
      </div>
    </div>
  `;
}

function renderDeadlineBanner(){
  const alerts = getDeadlineAlerts();
  if(alerts.length===0) return '';
  const urgent = alerts.filter(a=>a.diff===0);
  const tomorrow = alerts.filter(a=>a.diff===1);
  return `${urgent.length?`<div class="deadline-banner urgent" onclick="goToCronCli(${urgent[0].client.id},${urgent[0].month})"><span class="db-ico">🚨</span><div class="db-text"><strong>${urgent.length} prazo(s) HOJE</strong> — ${urgent.map(a=>a.client.name).slice(0,2).join(', ')}${urgent.length>2?` +${urgent.length-2}`:''}</div><span class="db-go">Ver →</span></div>`:''}
  ${tomorrow.length?`<div class="deadline-banner" onclick="goToCronCli(${tomorrow[0].client.id},${tomorrow[0].month})"><span class="db-ico">⏰</span><div class="db-text"><strong>${tomorrow.length} prazo(s) amanhã</strong> — ${tomorrow.map(a=>a.client.name).slice(0,2).join(', ')}${tomorrow.length>2?` +${tomorrow.length-2}`:''}</div><span class="db-go">Ver →</span></div>`:''}`;
}

function goToCronCli(clientId, month){
  cronMonth = month;
  goTo('cronograma');
  setTimeout(()=>{
    const row = document.getElementById('cron-row-'+clientId);
    if(row){
      row.scrollIntoView({behavior:'smooth',block:'center'});
      row.style.transition='background .4s';
      row.style.background='var(--warning-soft)';
      setTimeout(()=>row.style.background='',1400);
    }
  },200);
}

// Sistema de notificação geral — modal central que aparece ao abrir o sistema
function showDeadlineAlerts(){
  const alerts = getDeadlineAlerts();
  if(alerts.length===0) return;
  const urgent = alerts.filter(a=>a.diff===0);
  const tomorrow = alerts.filter(a=>a.diff===1);
  const isUrgent = urgent.length>0;
  const total = alerts.length;
  let html = `<div class="alert-modal open" id="alertModal" onclick="if(event.target===this)closeAlertModal()">
    <div class="alert-modal-box">
      <div class="alert-modal-head">
        <div class="alert-modal-ico ${isUrgent?'urgent':''}">${isUrgent?'🚨':'⏰'}</div>
        <div style="flex:1">
          <div style="font-size:15px;font-weight:700;letter-spacing:-.01em">${isUrgent?'Prazos vencendo HOJE':'Prazos próximos'}</div>
          <div class="text-xs text-3">${total} prazo(s) precisam de atenção</div>
        </div>
        <button class="modal-close" onclick="closeAlertModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="alert-modal-body">
        ${alerts.map(a=>`<div class="alert-item" onclick="closeAlertModal();goToCronCli(${a.client.id},${a.month})">
          <div class="cron-cli-logo" style="background:${a.client.color};width:36px;height:36px;font-size:12px">${a.client.init}</div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:600">${a.client.name}</div>
            <div class="text-xs text-3">${a.data.produced}/${a.data.target} conteúdos · Designer: ${a.data.designer}</div>
          </div>
          <span class="badge ${a.diff===0?'b-danger':'b-warning'}">${a.diff===0?'HOJE':'amanhã'}</span>
        </div>`).join('')}
      </div>
      <div class="alert-modal-foot">
        <button class="btn" onclick="closeAlertModal()">Mais tarde</button>
        <button class="btn btn-primary" onclick="closeAlertModal();goTo('cronograma')">Ver cronograma</button>
      </div>
    </div>
  </div>`;
  // Avoid duplicate
  const old = document.getElementById('alertModal');
  if(old) old.remove();
  document.body.insertAdjacentHTML('beforeend', html);
}

function closeAlertModal(){
  const m = document.getElementById('alertModal');
  if(m) m.remove();
}



// ============ FEEDBACK ============
// Dados de feedback por colaborador
const feedbackTypes = {positive:['✓','Positivo','success'],concern:['⚠','Atenção','warning'],development:['📈','Desenvolvimento','info']};
const feedbackData = {};
team.forEach((t,idx)=>{
  const samples = [
    {type:'positive',author:'Ederson (Founder)',date:'2026-02-10',period:'Q1 2026',score:9.2,text:'Excelente performance no trimestre. Demonstrou proatividade exemplar em todos os projetos, com entregas no prazo e qualidade acima da média. Liderou iniciativas de melhoria interna e teve ótima comunicação com clientes e equipe. Recomendo considerar promoção no próximo ciclo.'},
    {type:'development',author:'Heidy (Coord.)',date:'2026-03-15',period:'Q1 2026',score:8.0,text:'Pode desenvolver mais as habilidades técnicas avançadas. Sugiro curso de aprimoramento na área e treinar liderança de equipe. Tem potencial enorme para crescer e evoluir profissionalmente.'},
    {type:'positive',author:'Éllen (Gerente)',date:'2026-04-22',period:'Q2 2026',score:9.0,text:'Trabalho impecável no projeto recente. Mostrou organização, dedicação e capacidade de superar prazos apertados com qualidade. Iniciativa em propor melhorias no processo da equipe foi muito positiva.'},
    {type:'concern',author:'Ederson (Founder)',date:'2026-04-05',period:'Q2 2026',score:7.0,text:'Notei alguns atrasos pontuais nas entregas recentes. Precisa melhorar o planejamento de tempo e comunicar com antecedência quando há dificuldade. Vamos agendar 1:1 para alinhar próximos passos.'},
    {type:'positive',author:'Heidy (Coord.)',date:'2026-05-12',period:'Q2 2026',score:9.4,text:'Performance excelente este mês. Criatividade nas peças, liderança em projetos estratégicos e ótima colaboração com toda equipe. Manteve qualidade alta mesmo com volume maior de demandas.'},
  ];
  // Dar 3-5 feedbacks aleatórios por colaborador
  const list = [];
  for(let i=0;i<3+(idx%3);i++){
    const s = samples[(idx*2+i)%samples.length];
    list.push({...s, id:idx*100+i});
  }
  feedbackData[t.name] = list;
});

// Análise automática (sem IA real)
function analyzeFeedback(text){
  if(!text||!text.trim()) return null;
  const tx = text.toLowerCase();
  const positive = ['excelente','ótimo','otimo','bom','positivo','impecável','impecavel','iniciativa','proativo','dedicado','dedicação','prazo','qualidade','liderança','lideranca','crescimento','melhoria','superou','exemplar','colaborativo','organizado','criativ','potencial','destaque','elogi','reconhe'];
  const negative = ['atraso','atrasado','dificuldade','falta','problema','reclamação','reclamacao','baixa','queda','precisa melhorar','não cumpriu','sem','deficiência','deficiencia','lento','desorganiz','pouca'];
  const development = ['desenvolver','aprender','aprimorar','treinar','curso','capacitação','capacitacao','melhoria','crescer','evoluir','plano','mentoria','feedback'];
  let posCount=0,negCount=0,devCount=0;
  positive.forEach(w=>{if(tx.includes(w))posCount++});
  negative.forEach(w=>{if(tx.includes(w))negCount++});
  development.forEach(w=>{if(tx.includes(w))devCount++});

  let sentiment, sentimentColor;
  if(posCount > negCount+1){sentiment='Positivo';sentimentColor='success-text'}
  else if(negCount > posCount+1){sentiment='Preocupação';sentimentColor='danger-text'}
  else if(devCount > Math.max(posCount,negCount)){sentiment='Desenvolvimento';sentimentColor='info-text'}
  else {sentiment='Equilibrado';sentimentColor='text-2'}

  const topics = [];
  if(tx.includes('prazo')||tx.includes('entrega'))topics.push('Prazos & entregas');
  if(tx.includes('comunic'))topics.push('Comunicação');
  if(tx.includes('cliente'))topics.push('Relacionamento com cliente');
  if(tx.includes('lideran'))topics.push('Liderança');
  if(tx.includes('técnic')||tx.includes('tecnic')||tx.includes('skill'))topics.push('Habilidades técnicas');
  if(tx.includes('proativ')||tx.includes('iniciativa'))topics.push('Proatividade');
  if(tx.includes('criativ'))topics.push('Criatividade');
  if(tx.includes('equipe')||tx.includes('colabor'))topics.push('Trabalho em equipe');
  if(tx.includes('qualidade'))topics.push('Qualidade técnica');
  if(tx.includes('organiz')||tx.includes('planejamento'))topics.push('Organização');
  if(topics.length===0)topics.push('Análise geral');

  const recs = [];
  if(devCount>0||(negCount>0&&posCount>0))recs.push('📚 Programar plano de desenvolvimento');
  if(negCount>posCount)recs.push('💬 Agendar 1:1 para alinhamento');
  if(sentiment==='Positivo'&&posCount>3)recs.push('🏆 Considerar reconhecimento ou bônus');
  if(posCount>=5)recs.push('⭐ Avaliar promoção no próximo ciclo');
  if(tx.includes('prazo')&&negCount>0)recs.push('⏰ Revisar planejamento de capacidade');
  if(recs.length===0)recs.push('📌 Manter acompanhamento regular');

  const score = Math.max(1, Math.min(10, 7 + posCount*0.4 - negCount*0.5));
  const words = text.split(/\s+/).filter(w=>w).length;
  return {sentiment, sentimentColor, posCount, negCount, devCount, topics, recs, score:score.toFixed(1), words};
}

// Skills mockadas por colaborador (5 dimensões)
function getSkills(name){
  const seed = name.length;
  return [
    {name:'Técnica',val:Math.min(95, 70+seed%25)},
    {name:'Comunicação',val:Math.min(95, 75+(seed*3)%20)},
    {name:'Proatividade',val:Math.min(95, 65+(seed*7)%30)},
    {name:'Pontualidade',val:Math.min(95, 80+(seed*5)%18)},
    {name:'Criatividade',val:Math.min(95, 70+(seed*11)%25)},
    {name:'Liderança',val:Math.min(95, 60+(seed*13)%35)},
  ];
}

let currentFb = team[0].name;
let fbDraft = {type:'positive',score:8.5,text:''};
let fbAnalysis = null;

function renderFeedback(c){
  const tm = team.find(t=>t.name===currentFb)||team[0];
  const list = feedbackData[tm.name]||[];
  const avgScore = list.length?(list.reduce((s,f)=>s+f.score,0)/list.length).toFixed(1):'—';
  const totalAll = Object.values(feedbackData).reduce((s,l)=>s+l.length,0);
  const globalAvg = (Object.values(feedbackData).flat().reduce((s,f)=>s+f.score,0)/Math.max(totalAll,1)).toFixed(1);
  const pendingReviews = team.filter(t=>(feedbackData[t.name]||[]).length<3).length;

  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Feedback</div>
          <div class="page-subtitle">${totalAll} feedbacks registrados · média global ${globalAvg} · análise automática por IA</div>
        </div>
        <div class="page-actions">
          <button class="btn" onclick="toast('Exportando histórico…','info')">📤 Exportar</button>
          <button class="btn btn-primary" onclick="document.getElementById('fbTextarea')?.focus()">+ Novo feedback</button>
        </div>
      </div>

      <div class="stat-grid">
        ${statCard('Feedbacks totais',totalAll,'no histórico','M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z')}
        ${statCard('Nota média global',globalAvg,'de 10','M22 12h-4l-3 9L9 3l-3 9H2')}
        ${statCard('Revisões pendentes',pendingReviews,'colaboradores < 3 fb','M12 8v4l3 3',null,'warning')}
        ${statCard('Top performer',Object.entries(feedbackData).map(([n,l])=>({n,avg:l.reduce((s,f)=>s+f.score,0)/Math.max(l.length,1)})).sort((a,b)=>b.avg-a.avg)[0]?.n.split(' ')[0]||'—','melhor média','M9 11l3 3L22 4')}
      </div>

      <div class="fb-layout">
        <div class="fb-sidebar">
          <div class="info-label" style="padding:6px 11px 4px">Colaboradores</div>
          ${team.map(t=>{
            const l=feedbackData[t.name]||[];
            const avg = l.length?(l.reduce((s,f)=>s+f.score,0)/l.length).toFixed(1):'—';
            return `<div class="fb-collab ${t.name===currentFb?'active':''}" onclick="selectFbCollab('${t.name.replace(/'/g,"\\'")}')"><div class="av" style="background:${t.color}">${t.init}</div><div class="fb-collab-info"><div class="fb-collab-name">${t.name}</div><div class="fb-collab-meta">${l.length} fb · ${t.role}</div></div><div class="fb-collab-score">${avg}</div></div>`;
          }).join('')}
        </div>

        <div>
          <!-- Header colaborador selecionado -->
          <div class="fb-card" style="display:flex;align-items:center;gap:16px">
            <div class="av" style="width:54px;height:54px;border-radius:50%;background:${tm.color};color:#fff;display:grid;place-items:center;font-weight:700;font-size:20px">${tm.init}</div>
            <div style="flex:1">
              <div style="font-size:18px;font-weight:700;letter-spacing:-.02em">${tm.name}</div>
              <div class="text-xs text-3" style="margin-top:3px">${tm.role} · ${list.length} feedback(s) · média ${avgScore}/10</div>
            </div>
            <div style="text-align:right">
              <div style="font-size:24px;font-weight:700;letter-spacing:-.02em">${avgScore}</div>
              <div class="text-xs text-3">nota média</div>
            </div>
            <button class="btn btn-sm" onclick="perfilId=${team.indexOf(tm)};equipeView='perfil';goTo('equipe')">Ver perfil →</button>
          </div>

          <!-- Form novo feedback -->
          <div class="fb-card">
            <div class="card-header" style="margin-bottom:11px"><div class="card-title">📝 Adicionar feedback</div><span class="badge b-default">IA analisa em tempo real</span></div>
            <div class="info-label" style="margin-bottom:6px">Tipo</div>
            <div class="fb-types">
              <button class="fb-type positive ${fbDraft.type==='positive'?'active':''}" onclick="fbDraft.type='positive';renderFeedback(document.getElementById('content'))">✓ Positivo</button>
              <button class="fb-type concern ${fbDraft.type==='concern'?'active':''}" onclick="fbDraft.type='concern';renderFeedback(document.getElementById('content'))">⚠ Atenção</button>
              <button class="fb-type development ${fbDraft.type==='development'?'active':''}" onclick="fbDraft.type='development';renderFeedback(document.getElementById('content'))">📈 Desenvolvimento</button>
            </div>

            <div class="info-label" style="margin:14px 0 6px">Relatório / texto do feedback</div>
            <textarea id="fbTextarea" class="fb-textarea" placeholder="Descreva o desempenho, comportamentos observados, situações específicas, pontos fortes, áreas de melhoria, próximos passos…" oninput="fbDraft.text=this.value;fbAnalysis=analyzeFeedback(this.value);updateFbAnalysis()">${fbDraft.text}</textarea>

            <div class="info-label" style="margin:14px 0 6px">Nota geral</div>
            <div class="fb-score-slider">
              <input type="range" min="1" max="10" step="0.5" value="${fbDraft.score}" class="fb-score-input" oninput="fbDraft.score=parseFloat(this.value);document.getElementById('fbScoreVal').textContent=this.value">
              <div class="fb-score-val" id="fbScoreVal">${fbDraft.score}</div>
            </div>

            <div style="display:flex;gap:7px;margin-top:14px;justify-content:flex-end">
              <button class="btn" onclick="fbDraft={type:'positive',score:8.5,text:''};fbAnalysis=null;renderFeedback(document.getElementById('content'))">Limpar</button>
              <button class="btn btn-primary" onclick="saveFb()">💾 Salvar feedback</button>
            </div>
          </div>

          <!-- Análise IA em tempo real -->
          <div id="fbAnalysisBox">${renderFbAnalysis()}</div>

          <!-- Gráficos de evolução -->
          <div class="grid-2e" style="margin-top:14px">
            <div class="fb-card">
              <div class="card-header" style="margin-bottom:11px"><div class="card-title">📈 Evolução da nota</div></div>
              <div class="chart-box" style="height:220px"><canvas id="fbEvoChart"></canvas></div>
            </div>
            <div class="fb-card">
              <div class="card-header" style="margin-bottom:11px"><div class="card-title">🎯 Radar de habilidades</div></div>
              <div class="chart-box" style="height:220px"><canvas id="fbRadarChart"></canvas></div>
            </div>
          </div>

          <div class="grid-2e" style="margin-top:14px">
            <div class="fb-card">
              <div class="card-header" style="margin-bottom:11px"><div class="card-title">💪 Habilidades atuais</div></div>
              <div class="fb-skills">
                ${getSkills(tm.name).map(s=>`<div class="fb-skill"><span>${s.name}</span><div class="fb-skill-bar"><div class="fb-skill-fill" style="width:${s.val}%;background:${s.val>=85?'var(--success)':s.val>=70?'var(--accent)':'var(--warning)'}"></div></div><div class="fb-skill-val">${s.val}</div></div>`).join('')}
              </div>
            </div>
            <div class="fb-card">
              <div class="card-header" style="margin-bottom:11px"><div class="card-title">📊 Distribuição de feedbacks</div></div>
              <div class="chart-box" style="height:220px"><canvas id="fbDistChart"></canvas></div>
            </div>
          </div>

          <!-- Plano de desenvolvimento -->
          <div class="fb-card">
            <div class="card-header"><div class="card-title">🎯 Plano de desenvolvimento</div><button class="btn btn-sm">+ Nova meta</button></div>
            ${[
              {t:'Concluir curso avançado da área até 30/06',p:60,st:'Em andamento'},
              {t:'Liderar 1 projeto estratégico no Q2',p:80,st:'Quase lá'},
              {t:'Mentoria semanal com sênior por 3 meses',p:33,st:'Início'},
              {t:'Apresentar 2 melhorias de processo',p:50,st:'Em andamento'},
            ].map(g=>`<div style="padding:11px;background:var(--surface-2);border-radius:9px;margin-bottom:7px"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><span class="text-sm font-semi">${g.t}</span><span class="badge b-info">${g.st}</span></div><div class="meter"><div class="meter-fill" style="width:${g.p}%"></div></div><div class="text-xs text-3" style="margin-top:4px">${g.p}% concluído</div></div>`).join('')}
          </div>

          <!-- Histórico de feedbacks -->
          <div class="fb-card">
            <div class="card-header"><div class="card-title">📜 Histórico de feedbacks (${list.length})</div><span class="card-link" onclick="toast('Filtros avançados','info')">Filtrar</span></div>
            ${list.length===0?'<div class="empty-state"><div class="ico">📭</div><div class="ttl">Nenhum feedback ainda</div><div class="desc">Use o formulário acima para adicionar o primeiro.</div></div>':list.slice().reverse().map(f=>{
              const ico = feedbackTypes[f.type][0];
              return `<div class="fb-entry ${f.type}"><div class="fb-entry-ico">${ico}</div><div class="fb-entry-body"><div class="fb-entry-head"><strong style="color:var(--text);font-size:11.5px">${f.author}</strong><span>·</span><span>${new Date(f.date).toLocaleDateString('pt-BR')}</span><span>·</span><span class="badge b-default">${f.period}</span><span style="margin-left:auto;font-weight:700;color:var(--text);font-size:13px">${f.score}</span></div><div class="fb-entry-text">${f.text}</div></div></div>`;
            }).join('')}
          </div>

          <!-- Reconhecimentos e conquistas -->
          <div class="fb-card">
            <div class="card-header"><div class="card-title">🏆 Reconhecimentos & conquistas</div></div>
            ${[
              {ico:'🥇',t:'Top performer Q1/2026',d:'Maior média de nota do trimestre'},
              {ico:'⭐',t:'Iniciativa do mês',d:'Propôs melhoria no fluxo de aprovação'},
              {ico:'🎖',t:'1 ano na agência',d:'Aniversário de contrato em mar/2026'},
            ].map(r=>`<div class="list-item"><div class="list-icon" style="font-size:18px;background:var(--warning-soft)">${r.ico}</div><div class="list-content"><div class="list-title">${r.t}</div><div class="list-meta">${r.d}</div></div></div>`).join('')}
          </div>
        </div>
      </div>
    </div>
  `;

  // Desenhar gráficos
  setTimeout(()=>{drawFbCharts(tm)},50);
}

function renderFbAnalysis(){
  if(!fbAnalysis) return `<div class="fb-card" style="text-align:center;padding:20px"><div class="text-3 text-sm">✨ Comece a digitar o feedback acima — a análise automática aparece aqui em tempo real</div></div>`;
  const a = fbAnalysis;
  return `
    <div class="fb-ai">
      <div class="fb-ai-head">
        <div class="fb-ai-ico">🤖</div>
        <div class="fb-ai-title">Análise automática</div>
        <span class="badge b-purple" style="margin-left:auto">IA · em tempo real</span>
      </div>
      <div class="fb-ai-row">
        <div class="fb-ai-metric"><div class="fb-ai-metric-val" style="color:var(--${a.sentimentColor})">${a.sentiment}</div><div class="fb-ai-metric-lbl">Sentimento geral</div></div>
        <div class="fb-ai-metric"><div class="fb-ai-metric-val">${a.score}<span class="text-3" style="font-size:13px">/10</span></div><div class="fb-ai-metric-lbl">Score sugerido</div></div>
        <div class="fb-ai-metric"><div class="fb-ai-metric-val">${a.words}</div><div class="fb-ai-metric-lbl">Palavras</div></div>
        <div class="fb-ai-metric"><div class="fb-ai-metric-val" style="color:var(--success-text)">+${a.posCount}</div><div class="fb-ai-metric-lbl">Sinais positivos</div></div>
        <div class="fb-ai-metric"><div class="fb-ai-metric-val" style="color:var(--warning-text)">${a.negCount}</div><div class="fb-ai-metric-lbl">Pontos de atenção</div></div>
        <div class="fb-ai-metric"><div class="fb-ai-metric-val" style="color:var(--info-text)">${a.devCount}</div><div class="fb-ai-metric-lbl">Sinais de desenvolvimento</div></div>
      </div>
      <div style="margin-bottom:11px">
        <div class="info-label" style="margin-bottom:6px">Temas identificados</div>
        ${a.topics.map(t=>`<span class="fb-tag">${t}</span>`).join('')}
      </div>
      <div>
        <div class="info-label" style="margin-bottom:6px">Recomendações</div>
        ${a.recs.map(r=>`<div class="text-sm" style="padding:7px 11px;background:var(--surface);border-radius:7px;margin-bottom:5px">${r}</div>`).join('')}
      </div>
    </div>
  `;
}

function updateFbAnalysis(){
  const box = document.getElementById('fbAnalysisBox');
  if(box) box.innerHTML = renderFbAnalysis();
}

function selectFbCollab(name){
  currentFb = name;
  fbDraft = {type:'positive',score:8.5,text:''};
  fbAnalysis = null;
  renderFeedback(document.getElementById('content'));
}

async function saveFb(){
  if(!fbDraft.text.trim()){toast('Escreva o feedback antes de salvar','info');return}
  const fb = {
    type: fbDraft.type,
    period: 'Q2 2026',
    score: fbDraft.score,
    text: fbDraft.text
  };
  // Salva no banco
  const saved = await saveFeedbackDb(currentFb, fb);
  // Adiciona localmente
  const list = feedbackData[currentFb] || (feedbackData[currentFb]=[]);
  list.unshift({
    id: saved?saved.id:Date.now(),
    _dbId: saved?saved.id:null,
    type: fb.type, author: 'Ederson (Founder)',
    date: new Date().toISOString().split('T')[0],
    period: fb.period, score: fb.score, text: fb.text
  });
  toast(saved?`✓ Feedback salvo no banco para ${currentFb.split(' ')[0]}`:`Feedback adicionado (modo local)`,'success');
  fbDraft = {type:'positive',score:8.5,text:''};
  fbAnalysis = null;
  renderFeedback(document.getElementById('content'));
}

function drawFbCharts(tm){
  const isDark = document.documentElement.getAttribute('data-theme')==='dark';
  const txtCol = isDark?'#9595a0':'#6e6e73';
  const gridCol = isDark?'#23232a':'#e8e8ed';
  const accentCol = isDark?'#f5f5f7':'#1d1d1f';

  // Evolução de nota
  const evoCtx = document.getElementById('fbEvoChart');
  if(evoCtx){
    const list = (feedbackData[tm.name]||[]).slice().sort((a,b)=>a.date.localeCompare(b.date));
    const labels = list.length?list.map(f=>new Date(f.date).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'})):['—'];
    const data = list.length?list.map(f=>f.score):[0];
    new Chart(evoCtx,{type:'line',data:{labels,datasets:[{label:'Nota',data,borderColor:accentCol,backgroundColor:isDark?'rgba(245,245,247,.15)':'rgba(29,29,31,.08)',fill:true,tension:.4,borderWidth:2.5,pointRadius:5,pointBackgroundColor:accentCol,pointBorderColor:isDark?'#141417':'#fff',pointBorderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{backgroundColor:isDark?'#1a1a1f':'#1d1d1f',titleColor:'#fff',bodyColor:'#ccc'}},scales:{x:{grid:{display:false},ticks:{color:txtCol,font:{family:'Inter',size:10}}},y:{min:0,max:10,grid:{color:gridCol},ticks:{color:txtCol,font:{family:'Inter',size:10}}}}}});
  }

  // Radar
  const radarCtx = document.getElementById('fbRadarChart');
  if(radarCtx){
    const skills = getSkills(tm.name);
    new Chart(radarCtx,{type:'radar',data:{labels:skills.map(s=>s.name),datasets:[{label:tm.name.split(' ')[0],data:skills.map(s=>s.val),backgroundColor:isDark?'rgba(245,245,247,.18)':'rgba(29,29,31,.12)',borderColor:accentCol,borderWidth:2,pointBackgroundColor:accentCol,pointRadius:3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{r:{min:0,max:100,grid:{color:gridCol},angleLines:{color:gridCol},pointLabels:{color:txtCol,font:{family:'Inter',size:11}},ticks:{display:false}}}}});
  }

  // Distribuição (doughnut por tipo)
  const distCtx = document.getElementById('fbDistChart');
  if(distCtx){
    const list = feedbackData[tm.name]||[];
    const counts = {positive:0,concern:0,development:0};
    list.forEach(f=>counts[f.type]++);
    new Chart(distCtx,{type:'doughnut',data:{labels:['Positivos','Atenção','Desenvolvimento'],datasets:[{data:[counts.positive,counts.concern,counts.development],backgroundColor:['#28a745','#f59e0b','#0ea5e9'],borderColor:isDark?'#141417':'#fff',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,boxWidth:8,padding:9}}}}});
  }
}




async function openNovaCaptacaoModal(){
  const mod = document.getElementById('clientModal');
  mod.innerHTML = `
    <div class="modal-head">
      <div style="width:40px;height:40px;border-radius:10px;background:var(--accent);color:var(--surface);display:grid;place-items:center;font-weight:700">🎬</div>
      <div style="flex:1"><div style="font-size:17px;font-weight:700">Nova captação</div></div>
      <button class="modal-close" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div><div class="info-label" style="margin-bottom:5px">Cliente *</div><select id="ncpCli" class="login-input" style="background:var(--surface-2)">${clients.map(c=>`<option value="${c.id}">${c.name}</option>`).join('')}</select></div>
        <div><div class="info-label" style="margin-bottom:5px">Tipo *</div><input id="ncpType" class="login-input" placeholder="Ex: Vídeo institucional" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Data *</div><input id="ncpDate" class="login-input" type="date" value="2026-05-22" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Horário *</div><input id="ncpTime" class="login-input" type="time" value="10:00" style="background:var(--surface-2)" /></div>
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Endereço</div><input id="ncpAddr" class="login-input" placeholder="Ex: Av. Paulista 1234" style="background:var(--surface-2)" /></div>
        <div><div class="info-label" style="margin-bottom:5px">Prioridade</div><select id="ncpPrio" class="login-input" style="background:var(--surface-2)"><option value="urgent">Urgente</option><option value="high" selected>Alta</option><option value="med">Média</option><option value="low">Baixa</option></select></div>
        <div><div class="info-label" style="margin-bottom:5px">Status</div><select id="ncpStatus" class="login-input" style="background:var(--surface-2)"><option value="agendada" selected>Agendada</option><option value="confirmada">Confirmada</option></select></div>
        <div style="grid-column:span 2"><div class="info-label" style="margin-bottom:5px">Briefing</div><textarea id="ncpBrief" class="login-input" style="background:var(--surface-2);min-height:80px;resize:vertical" placeholder="Detalhes da captação..."></textarea></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="salvarNovaCaptacao()" id="ncpBtn">Criar captação</button>
      </div>
    </div>
  `;
  document.getElementById('modalBg').classList.add('open');
}

async function salvarNovaCaptacao(){
  const cliId = parseInt(document.getElementById('ncpCli').value);
  const type = document.getElementById('ncpType').value.trim();
  if(!type){toast('Informe o tipo','info');return}
  const cli = clients.find(c=>c.id===cliId);
  if(!cli||!cli._dbId){toast('Cliente invalido','info');return}
  const data = {
    client_id: cli._dbId,
    type, address: document.getElementById('ncpAddr').value.trim(),
    scheduled_date: document.getElementById('ncpDate').value,
    scheduled_time: document.getElementById('ncpTime').value,
    priority: document.getElementById('ncpPrio').value,
    status: document.getElementById('ncpStatus').value,
    briefing: document.getElementById('ncpBrief').value.trim(),
    materials: ['Câmera','Microfone']
  };
  const btn = document.getElementById('ncpBtn');
  btn.disabled = true; btn.textContent = 'Salvando...';
  const r = await dbCreate('captacoes', data);
  if(r){
    toast('✓ Captação criada no banco','success');
    closeModal();
    await loadDataFromSupabase();
    renderCaptacao(document.getElementById('content'));
  } else { btn.disabled = false; btn.textContent = 'Criar captação' }
}



