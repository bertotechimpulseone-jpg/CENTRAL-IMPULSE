function paneHistorico(cli){
  return `
    <div class="modal-pane" data-pane="historico">
      ${[
        {d:'Hoje · 10:23',t:'Conteúdo aprovado',m:'Reels promoção foi aprovado pelo cliente'},
        {d:'Hoje · 09:00',t:'Reunião realizada',m:'Alinhamento mensal — 42min'},
        {d:'Ontem · 16:40',t:'Pagamento recebido',m:'R$ '+cli.mrr.toLocaleString('pt-BR')+' via PIX'},
        {d:'14 mai',t:'Briefing atualizado',m:cli.owner+' atualizou campos do briefing'},
        {d:'10 mai',t:'Avançou de etapa',m:'Cliente passou para "Aprovação"'},
        {d:'02 mai',t:'Relatório mensal enviado',m:'Relatório de abril foi entregue'},
      ].map(h=>`
        <div class="list-item">
          <div class="list-icon">•</div>
          <div class="list-content"><div class="list-title">${h.t}</div><div class="list-meta">${h.m}</div></div>
          <div class="list-right text-xs">${h.d}</div>
        </div>
      `).join('')}
    </div>
  `;
}

async function loadTransactions(){
  if(!_supa) return [];
  const { data } = await _supa.from('transactions').select('*').order('date',{ascending:false}).limit(50);
  return data || [];
}

// ============ FINANCEIRO ============
function renderFinanceiro(c){
  const totalMrr = clients.reduce((s,c)=>s+c.mrr,0);
  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div><div class="page-title">Financeiro</div><div class="page-subtitle">Visão consolidada · maio/2026</div></div>
        <div class="page-actions">
          ${searchBar('Buscar transação...','.card table')}<button class="btn" onclick="openNovaTransacaoModal('out')">💸 Nova despesa</button>
          <button class="btn">💸 Nova despesa</button>
          <button class="btn btn-primary" onclick="openNovaTransacaoModal('in')">+ Nova cobrança</button>
        </div>
      </div>
      <div class="stat-grid">
        ${statCard('Faturamento mês','R$ '+totalMrr.toLocaleString('pt-BR'),'+12% vs abr','M22 12h-4l-3 9L9 3l-3 9H2')}
        ${statCard('Despesas mês','R$ 24.560','+3% vs abr','M5 12h14',null,'warning')}
        ${statCard('Lucro líquido','R$ '+Math.round((totalMrr-24560)*0.85).toLocaleString('pt-BR'),'margem 43%','M12 1v22')}
        ${statCard('A receber','R$ 12.800','5 cobranças','M12 8v4l3 3')}
        ${statCard('Inadimplência','R$ 5.500','Steel Desk','M12 9v4',null,'warning')}
        ${statCard('MRR total','R$ '+totalMrr.toLocaleString('pt-BR'),'21 contratos','M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0')}
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-header"><div class="card-title">Fluxo de caixa — 12 meses</div></div>
          <div class="chart-box"><canvas id="cashChart"></canvas></div>
        </div>
        <div class="card">
          <div class="card-header"><div class="card-title">Categorias de despesa</div></div>
          <div class="chart-box"><canvas id="expChart"></canvas></div>
        </div>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-header"><div class="card-title">DRE simplificado</div></div>
          <table class="table">
            <tbody>
              <tr><td>Receita bruta</td><td style="text-align:right"><strong>R$ ${totalMrr.toLocaleString('pt-BR')}</strong></td></tr>
              <tr><td class="text-mu">(–) Impostos (Simples 6%)</td><td style="text-align:right;color:var(--danger-text)">R$ ${Math.round(totalMrr*.06).toLocaleString('pt-BR')}</td></tr>
              <tr><td><strong>Receita líquida</strong></td><td style="text-align:right"><strong>R$ ${Math.round(totalMrr*.94).toLocaleString('pt-BR')}</strong></td></tr>
              <tr><td class="text-mu">(–) Salários e PJs</td><td style="text-align:right;color:var(--danger-text)">R$ 16.200</td></tr>
              <tr><td class="text-mu">(–) Ferramentas/SaaS</td><td style="text-align:right;color:var(--danger-text)">R$ 1.860</td></tr>
              <tr><td class="text-mu">(–) Tráfego pago</td><td style="text-align:right;color:var(--danger-text)">R$ 4.500</td></tr>
              <tr><td class="text-mu">(–) Outras despesas</td><td style="text-align:right;color:var(--danger-text)">R$ 2.000</td></tr>
              <tr style="background:var(--surface-2)"><td><strong>Lucro líquido</strong></td><td style="text-align:right;color:var(--success-text)"><strong>R$ ${Math.round((totalMrr-24560)*0.85).toLocaleString('pt-BR')}</strong></td></tr>
            </tbody>
          </table>
        </div>
        <div class="card">
          <div class="card-header"><div class="card-title">Próximos vencimentos</div></div>
          ${clients.slice(0,7).map(cli=>`
            <div class="list-item">
              <div class="list-icon" style="background:${cli.color}1a;color:${cli.color}">${cli.init}</div>
              <div class="list-content"><div class="list-title">${cli.name}</div><div class="list-meta">Vence em ${20+Math.floor(Math.random()*10)} mai</div></div>
              <div class="list-right"><strong>R$ ${cli.mrr.toLocaleString('pt-BR')}</strong><div>${cli.status==='late'?'<span class="badge b-danger">Atrasado</span>':'<span class="badge b-warning">Pendente</span>'}</div></div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
  `;
  drawCashChart();drawExpChart();
}
function drawCashChart(){
  const ctx=document.getElementById('cashChart');if(!ctx)return;
  const isDark=document.documentElement.getAttribute('data-theme')==='dark';
  const txtCol=isDark?'#9595a0':'#6e6e73';const gridCol=isDark?'#23232a':'#e8e8ed';
  new Chart(ctx,{type:'bar',
    data:{labels:['Jun','Jul','Ago','Set','Out','Nov','Dez','Jan','Fev','Mar','Abr','Mai'],
      datasets:[
        {label:'Entradas',data:[58,62,66,60,70,76,84,78,82,88,92,87],backgroundColor:isDark?'#f5f5f7':'#1d1d1f',borderRadius:4,barPercentage:.6},
        {label:'Saídas',data:[28,29,30,29,31,32,34,32,33,34,35,24.5],backgroundColor:isDark?'#3a3a44':'#d2d2d7',borderRadius:4,barPercentage:.6},
      ]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:8}}},
      scales:{x:{grid:{display:false},ticks:{color:txtCol}},y:{grid:{color:gridCol},ticks:{color:txtCol,callback:v=>'R$ '+v+'k'}}}}
  });
}
function drawExpChart(){
  const ctx=document.getElementById('expChart');if(!ctx)return;
  const isDark=document.documentElement.getAttribute('data-theme')==='dark';
  const txtCol=isDark?'#9595a0':'#6e6e73';
  new Chart(ctx,{type:'doughnut',
    data:{labels:['Equipe','Tráfego','Ferramentas','Impostos','Outras'],
      datasets:[{data:[16200,4500,1860,5220,2000],backgroundColor:['#1d1d1f','#7c3aed','#0ea5e9','#f59e0b','#a1a1a6'],borderColor:isDark?'#141417':'#fff',borderWidth:3}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'68%',
      plugins:{legend:{position:'right',labels:{color:txtCol,font:{family:'Inter',size:11},usePointStyle:true,pointStyle:'circle',boxWidth:10}}}}
  });
}
// ============ OPERACIONAL ============
let currentCollab = 'Éllen';
let opView = 'checklist'; // 'checklist' | 'kanban'

function renderOperacional(c){
  const totalTasks = Object.values(dailyChecklists).flat().length;
  const doneTasks = Object.values(dailyChecklists).flat().filter(t=>t.done).length;
  c.innerHTML = `
    <div class="page active">
      <div class="page-header">
        <div>
          <div class="page-title">Checklist</div>
          <div class="page-subtitle">${totalTasks} tarefas · ${doneTasks} concluídas · ${totalTasks-doneTasks} pendentes</div>
        </div>
        <div class="page-actions">
          <div style="display:flex;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:3px">
            <button class="btn ${opView==='checklist'?'btn-primary':''}" style="border:none;padding:5px 11px" onclick="opView='checklist';renderOperacional(document.getElementById('content'))">Checklists</button>
            <button class="btn ${opView==='kanban'?'btn-primary':''}" style="border:none;padding:5px 11px" onclick="opView='kanban';renderOperacional(document.getElementById('content'))">Kanban</button>
          </div>
          ${searchBar('Buscar tarefa, cliente, colaborador...','.kanban, .grid-2e')}<button class="btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>Histórico</button>
          <button class="btn btn-primary" onclick="openNovaTarefaModal()">+ Nova tarefa</button>
        </div>
      </div>

      ${opView==='checklist'?renderChecklistView():renderKanbanView()}
    </div>
  `;
}

function renderChecklistView(){
  const today = new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'});
  const collabList = Object.keys(dailyChecklists);
  const currentList = dailyChecklists[currentCollab]||[];
  const doneCount = currentList.filter(t=>t.done).length;
  const pct = currentList.length?Math.round(doneCount/currentList.length*100):0;
  const member = team.find(t=>t.name.startsWith(currentCollab))||team[0];

  return `
    <div class="text-xs text-3 mb-3">📅 ${today.charAt(0).toUpperCase()+today.slice(1)} · Checklists gerados automaticamente às 06:00</div>

    <div class="collab-tabs">
      ${collabList.map(name=>{
        const m = team.find(t=>t.name.startsWith(name))||{init:name[0],color:'#999'};
        const list = dailyChecklists[name]||[];
        const done = list.filter(t=>t.done).length;
        return `
          <div class="collab-tab ${name===currentCollab?'active':''}" onclick="currentCollab='${name}';renderOperacional(document.getElementById('content'))">
            <div class="avatar" style="background:${m.color};color:#fff">${m.init}</div>
            <span>${name}</span>
            <span style="font-size:10px;opacity:.7">${done}/${list.length}</span>
          </div>
        `;
      }).join('')}
    </div>

    <div class="filter-bar">
      <span class="filter-chip active">Hoje</span>
      <span class="filter-chip">Esta semana</span>
      <span class="filter-chip">Este mês</span>
      <span class="filter-chip">Histórico</span>
      <span style="margin-left:auto"></span>
      <span class="filter-chip">Todas</span>
      <span class="filter-chip">Urgentes</span>
      <span class="filter-chip">Pendentes</span>
      <span class="filter-chip">Concluídas</span>
    </div>

    <div class="grid-2e">
      <div>
        <div class="profile-head" style="padding:16px;margin-bottom:14px">
          <div class="profile-avatar" style="background:${member.color};width:54px;height:54px;font-size:20px">${member.init}</div>
          <div style="flex:1">
            <div style="font-size:16px;font-weight:700">${member.name||currentCollab}</div>
            <div class="text-xs text-3">${member.role||''}</div>
            <div style="margin-top:8px"><div class="meter"><div class="meter-fill" style="width:${pct}%"></div></div></div>
            <div class="text-xs text-3" style="margin-top:5px">${doneCount} de ${currentList.length} concluídas · ${pct}%</div>
          </div>
        </div>

        <div class="section-title" style="margin-top:0">Tarefas de hoje</div>
        ${currentList.length===0?'<div class="card text-mu text-sm">Nenhuma tarefa para este colaborador.</div>':currentList.map((t,i)=>`
          <div class="check-item ${t.done?'done':''}">
            <div class="check-box ${t.done?'checked':''}" onclick="toggleCheck('${currentCollab}',${i})"></div>
            <div class="check-body">
              <div class="check-title">${t.t}</div>
              <div class="check-meta">
                ${prioBadge(t.p)}
                <span>🕐 ${t.time}</span>
                <span>📌 ${t.client}</span>
                <span style="cursor:pointer" onclick="toast('Comentários da tarefa','info')">💬 ${Math.floor(Math.random()*3)+1}</span>
                <span style="cursor:pointer" onclick="toast('Anexar arquivo','info')">📎 ${Math.floor(Math.random()*2)}</span>
              </div>
            </div>
          </div>
        `).join('')}

        <div class="kanban-add" style="margin-top:8px">+ Adicionar tarefa para ${currentCollab}</div>
      </div>

      <div>
        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📊 Resumo do dia</div></div>
          <div class="stat-grid" style="grid-template-columns:1fr 1fr">
            ${statCard('Concluídas',doneCount,'de '+currentList.length,'M9 11l3 3L22 4')}
            ${statCard('Restantes',currentList.length-doneCount,'pendentes','M12 8v4l3 3')}
          </div>
          <div style="margin-top:14px">
            <div class="text-xs text-mu mb-2">Distribuição por prioridade</div>
            ${['urgent','high','med','low'].map(p=>{
              const cnt = currentList.filter(t=>t.p===p).length;
              if(!cnt) return '';
              return `<div style="display:flex;justify-content:space-between;padding:5px 0;font-size:12px"><span>${prioBadge(p)}</span><strong>${cnt}</strong></div>`;
            }).join('')}
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><div class="card-title">📅 Esta semana</div></div>
          ${['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'].map((d,i)=>{
            const t = Math.floor(Math.random()*8)+2;
            const done = Math.floor(Math.random()*t);
            const pct = Math.round(done/t*100);
            return `<div style="display:flex;align-items:center;gap:10px;padding:6px 0">
              <span class="text-xs text-mu" style="width:30px">${d}</span>
              <div class="meter" style="flex:1"><div class="meter-fill" style="width:${pct}%"></div></div>
              <span class="text-xs text-mu" style="width:40px;text-align:right">${done}/${t}</span>
            </div>`;
          }).join('')}
        </div>

        <div class="card">
          <div class="card-header"><div class="card-title">📋 Salvamento automático</div></div>
          <div class="text-xs text-mu">Todas as alterações são salvas automaticamente. Última sincronização: <strong>agora</strong></div>
          <div class="text-xs text-3 mt-3">📂 Histórico mensal disponível em Histórico → Operacional</div>
        </div>
      </div>
    </div>
  `;
}

function toggleCheck(collab,idx){
  dailyChecklists[collab][idx].done = !dailyChecklists[collab][idx].done;
  const done = dailyChecklists[collab][idx].done;
  saveTaskDone(collab, idx, done);  // persiste no banco
  renderOperacional(document.getElementById('content'));
  toast(done?'Tarefa concluída ✓':'Tarefa reaberta','success');
}

function renderKanbanView(){
  const cols = [
    {id:'backlog',title:'Backlog',color:'var(--text-3)'},
    {id:'todo',title:'A fazer',color:'var(--info)'},
    {id:'doing',title:'Em andamento',color:'var(--purple)'},
    {id:'review',title:'Em revisão',color:'var(--warning)'},
    {id:'approval',title:'Aprovação cliente',color:'var(--pink)'},
    {id:'done',title:'Concluído',color:'var(--success)'},
  ];
  // Build cards from dailyChecklists distributed across columns
  const all = [];
  Object.entries(dailyChecklists).forEach(([col,list])=>{
    list.forEach(t=>all.push({...t,owner:col}));
  });
  // Random distribution
  const buckets = {backlog:[],todo:[],doing:[],review:[],approval:[],done:[]};
  all.forEach((t,i)=>{
    if(t.done) buckets.done.push(t);
    else {
      const target = ['backlog','todo','doing','review','approval'][i%5];
      buckets[target].push(t);
    }
  });

  return `
    <div class="filter-bar">
      <span class="filter-chip active">Todos</span>
      <span class="filter-chip">Meus</span>
      <span class="filter-chip">Urgentes</span>
      <span class="filter-chip">Atrasadas</span>
      <span class="filter-chip">Por cliente</span>
      <span class="filter-chip">Por colaborador</span>
    </div>

    <div class="kanban">
      ${cols.map(col=>`
        <div class="kanban-col" data-col="${col.id}" ondragover="event.preventDefault()" ondrop="dropCard(event,'${col.id}')">
          <div class="kanban-head">
            <div class="kanban-title">
              <span style="width:7px;height:7px;border-radius:50%;background:${col.color}"></span>
              ${col.title}
              <span class="kanban-count">${buckets[col.id].length}</span>
            </div>
          </div>
          <div class="kanban-cards">
            ${buckets[col.id].map((t,i)=>{
              const m = team.find(x=>x.name.startsWith(t.owner))||{init:'?',color:'#999'};
              return `
                <div class="kanban-card" draggable="true" ondragstart="dragStart(event,'${col.id}',${i})">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
                    ${prioBadge(t.p)}
                    <span class="text-xs text-3">🕐 ${t.time}</span>
                  </div>
                  <div class="kanban-card-title">${t.t}</div>
                  <div class="text-xs text-3" style="margin-bottom:7px">📌 ${t.client}</div>
                  <div class="kanban-card-foot">
                    <div style="display:flex;gap:8px"><span>💬 ${Math.floor(Math.random()*4)+1}</span><span>📎 ${Math.floor(Math.random()*2)}</span></div>
                    <div class="avatar" style="background:${m.color}">${m.init}</div>
                  </div>
                </div>
              `;
            }).join('')}
            <div class="kanban-add">+ Adicionar tarefa</div>
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

let dragData = null;
function dragStart(e,col,idx){dragData={col,idx};e.target.classList.add('dragging');setTimeout(()=>e.target.classList.remove('dragging'),0)}
function dropCard(e,toCol){if(!dragData||dragData.col===toCol)return;toast('Card movido para '+toCol);dragData=null}
// ============ CALENDÁRIO (centralizado, com datas BR + RS) ============
function renderCalendario(c){
  const events={
    1:[{t:'🎉 Dia do Trabalho',c:'b-purple'}],
    2:[{t:'🎂 Aniv. Natacenter',c:'b-pink'}],
    5:[{t:'Reunião — Aquassafe',c:'b-info'}],
    8:[{t:'Post IG — Marmitina',c:'b-warning'}],
    10:[{t:'Reunião — Dener',c:'b-info'}],
    12:[{t:'❤️ Dia das Mães',c:'b-pink'},{t:'Campanha verão',c:'b-pink'}],
    15:[{t:'⚠ Vencimento — Steel Desk',c:'b-danger'}],
    18:[{t:'Diagnóstico Concept',c:'b-info'},{t:'Estratégica Eucassel',c:'b-purple'},{t:'Captação Banca Síndicos',c:'b-warning'}],
    19:[{t:'🎬 Captação Aquassafe',c:'b-warning'},{t:'🎂 Natacenter',c:'b-pink'}],
    20:[{t:'🎬 Captação Marmitina',c:'b-warning'},{t:'Brainstorm Marmitina',c:'b-warning'}],
    22:[{t:'Fechamento Steel Desk',c:'b-success'},{t:'🎂 Julia',c:'b-pink'}],
    25:[{t:'🎬 Captação Top Sports',c:'b-warning'},{t:'Entrega Dener',c:'b-info'}],
    28:[{t:'Banco imagens Franci',c:'b-pink'}],
    30:[{t:'Cobrança recorrente',c:'b-success'}],
  };
  const days=['DOM','SEG','TER','QUA','QUI','SEX','SÁB'];const monthStart=5,daysInMonth=31;
  let html=`<div class="page active"><div class="page-header"><div><div class="page-title">Calendário</div><div class="page-subtitle">Maio 2026 · Tudo centralizado: reuniões, captações, férias, aniversários, tarefas, campanhas, feriados</div></div><div class="page-actions"><button class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button>${searchBar('Buscar evento...','.cal-grid')}<button class="btn" onclick="toast('Voltou para hoje','info')">Hoje</button><button class="icon-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button><button class="btn btn-primary">+ Evento</button></div></div>
  <div class="filter-bar">
    <span class="filter-chip active">Mês</span><span class="filter-chip">Semana</span><span class="filter-chip">Ano</span>
    <span style="border-left:1px solid var(--border);height:18px;margin:0 6px"></span>
    <span class="text-xs text-3">Tipo:</span>
    <span class="badge b-info"><span class="dot"></span>Reuniões</span>
    <span class="badge b-warning"><span class="dot"></span>Captações</span>
    <span class="badge b-purple"><span class="dot"></span>Campanhas</span>
    <span class="badge b-pink"><span class="dot"></span>Aniv. & feriados</span>
    <span class="badge b-success"><span class="dot"></span>Financeiro</span>
    <span class="badge b-danger"><span class="dot"></span>Vencimentos</span>
  </div>
  <div class="cal-grid">${days.map(d=>`<div class="cal-head">${d}</div>`).join('')}`;
  for(let i=0;i<42;i++){const dn=i-monthStart+1;const isC=dn>=1&&dn<=daysInMonth;const isT=dn===18;const evs=events[dn]||[];const disp=isC?dn:(dn<1?30+dn:dn-daysInMonth);html+=`<div class="cal-day ${isC?'':'other'} ${isT?'today':''}"><div class="cal-num">${disp}</div>${evs.map(e=>`<div class="cal-event badge ${e.c}">${e.t}</div>`).join('')}</div>`}
  html+=`</div>
  <div class="grid-3 mt-4">
    <div class="card"><div class="card-header"><div class="card-title">🇧🇷 Datas comemorativas — Brasil</div></div>
      ${[['01 mai','Dia do Trabalho'],['12 mai','Dia das Mães'],['12 jun','Dia dos Namorados'],['20 jul','Dia do Amigo'],['07 set','Independência'],['12 out','Crianças'],['15 nov','Proclamação da República']].map(d=>`<div class="list-item"><div class="list-icon">🇧🇷</div><div class="list-content"><div class="list-title">${d[1]}</div></div><div class="list-right text-xs">${d[0]}</div></div>`).join('')}
    </div>
    <div class="card"><div class="card-header"><div class="card-title">🌵 Datas — Rio Grande do Sul</div></div>
      ${[['20 set','Revolução Farroupilha (feriado RS)'],['25 jul','Dia do Colono'],['12 abr','Dia da Tradição Gaúcha'],['14 set','Início Semana Farroupilha'],['25 abr','Dia do Pelotense'],['30 set','São Jerônimo (padroeiro RS)'],['11 nov','Dia do Gaúcho']].map(d=>`<div class="list-item"><div class="list-icon">🌵</div><div class="list-content"><div class="list-title">${d[1]}</div></div><div class="list-right text-xs">${d[0]}</div></div>`).join('')}
    </div>
    <div class="card"><div class="card-header"><div class="card-title">🔔 Alertas automáticos</div></div>
      ${[['30 dias antes','Aviso de evento estratégico','b-info'],['7 dias antes','Lembrete via Slack/Email','b-warning'],['2 dias antes','Push notification na equipe','b-warning'],['1 dia antes','Alerta urgente no dashboard','b-danger'],['No dia','Confirmação e destaque','b-success']].map(a=>`<div class="list-item"><div class="list-icon">🔔</div><div class="list-content"><div class="list-title">${a[1]}</div><div class="list-meta">${a[0]}</div></div><div class="list-right"><span class="badge ${a[2]}">Ativo</span></div></div>`).join('')}
    </div>
  </div>
  <div class="card mt-4"><div class="card-header"><div class="card-title">🔍 Filtros avançados</div></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <span class="text-xs text-mu">Filtrar por:</span>
      <select style="padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--surface-2);font-size:12px;color:var(--text);font-family:inherit"><option>Colaborador: todos</option>${team.map(t=>`<option>${t.name.split(' ')[0]}</option>`).join('')}</select>
      <select style="padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--surface-2);font-size:12px;color:var(--text);font-family:inherit"><option>Cliente: todos</option>${clients.map(c=>`<option>${c.name}</option>`).join('')}</select>
      <select style="padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--surface-2);font-size:12px;color:var(--text);font-family:inherit"><option>Tipo: todos</option><option>Reuniões</option><option>Captações</option><option>Tarefas</option><option>Campanhas</option><option>Aniversários</option></select>
      <select style="padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--surface-2);font-size:12px;color:var(--text);font-family:inherit"><option>Prioridade: todas</option><option>Urgente</option><option>Alta</option><option>Média</option><option>Baixa</option></select>
    </div>
  </div>
  </div>`;
  c.innerHTML=html;
}

